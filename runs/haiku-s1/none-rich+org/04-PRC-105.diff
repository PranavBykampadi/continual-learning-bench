diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/test_refunds.py b/tests/test_refunds.py
--- a/tests/test_refunds.py	1969-12-31 19:00:00
+++ b/tests/test_refunds.py	2026-11-10 14:11:34
@@ -0,0 +1,62 @@
+import pytest
+
+from parcelo import audit, clock, customers, invoices, refunds, shipments, store
+from parcelo.errors import DomainError
+from parcelo.money import Money
+
+
+def _paid_invoice():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 2, "local")
+    inv = invoices.issue_invoice(s.id)
+    invoices.mark_paid(inv.id)
+    return inv
+
+
+def test_create_refund_on_paid_invoice():
+    inv = _paid_invoice()
+    refund = refunds.create_refund(inv.id, 3.5)
+    assert refund.invoice_id == inv.id
+    assert refund.amount == Money(350)
+    assert refund.created_at is not None
+    assert store.db.refunds[refund.id] is refund
+    assert any(e["action"] == "refund.created" and e["entity_id"] == refund.id for e in audit.LOG)
+
+
+def test_created_at_uses_clock():
+    inv = _paid_invoice()
+    moment = clock.now().replace(year=2020)
+    clock.set_fixed(moment)
+    assert refunds.create_refund(inv.id, 1).created_at == moment
+
+
+def test_unknown_invoice_fails():
+    with pytest.raises(DomainError) as exc:
+        refunds.create_refund("INV-nope", 1)
+    assert exc.value.code == "E_NOT_FOUND"
+    assert store.db.refunds == {}
+
+
+def test_unpaid_invoice_fails():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 2, "local")
+    inv = invoices.issue_invoice(s.id)
+    with pytest.raises(DomainError) as exc:
+        refunds.create_refund(inv.id, 1)
+    assert exc.value.code == "E_BAD_STATE"
+    assert store.db.refunds == {}
+
+
+def test_non_positive_amount_fails():
+    inv = _paid_invoice()
+    with pytest.raises(DomainError) as exc:
+        refunds.create_refund(inv.id, 0)
+    assert exc.value.code == "E_BAD_INPUT"
+    assert store.db.refunds == {}
+
+
+def test_store_reset_clears_refunds():
+    inv = _paid_invoice()
+    refunds.create_refund(inv.id, 1)
+    store.reset()
+    assert store.db.refunds == {}
