diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/parcelo/claims.py b/parcelo/claims.py
--- a/parcelo/claims.py	1969-12-31 19:00:00
+++ b/parcelo/claims.py	2026-11-10 14:15:47
@@ -0,0 +1,39 @@
+from parcelo import audit, clock, ids
+from parcelo.errors import DomainError
+from parcelo.models import Claim
+from parcelo.store import db
+
+
+def file_claim(shipment_id: str, amount: float, reason: str) -> Claim:
+    """File a claim against a delivered shipment.
+
+    Args:
+        shipment_id: ID of the delivered shipment the claim is about.
+        amount: Amount being claimed, in dollars. Must be positive.
+        reason: Free-text reason for the claim.
+
+    Returns:
+        The stored Claim.
+
+    Raises:
+        DomainError: E_NOT_FOUND if the shipment does not exist, E_BAD_INPUT
+            if the amount is not a positive number, E_BAD_STATE if the
+            shipment has not been delivered.
+    """
+    if shipment_id not in db.shipments:
+        raise DomainError("E_NOT_FOUND", shipment_id)
+    shipment = db.shipments[shipment_id]
+    if shipment.status != "delivered":
+        raise DomainError("E_BAD_STATE", f"{shipment_id} is {shipment.status}")
+    if isinstance(amount, bool) or not isinstance(amount, (int, float)) or not amount > 0:
+        raise DomainError("E_BAD_INPUT", f"amount {amount!r}")
+    claim = Claim(
+        id=ids.new_id("clm"),
+        shipment_id=shipment_id,
+        amount=amount,
+        reason=reason,
+        filed_at=clock.now(),
+    )
+    db.claims[claim.id] = claim
+    audit.record("claim.filed", claim.id, shipment_id=shipment_id, amount=amount)
+    return claim
