diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/parcelo/shipments.py b/parcelo/shipments.py
--- a/parcelo/shipments.py	2026-11-10 12:17:53
+++ b/parcelo/shipments.py	2026-11-10 14:08:54
@@ -28,3 +28,13 @@
     if shipment_id not in db.shipments:
         raise DomainError("E_NOT_FOUND", shipment_id)
     return db.shipments[shipment_id]
+
+
+def cancel_shipment(shipment_id, reason):
+    shipment = get_shipment(shipment_id)
+    if shipment.status in ("cancelled", "delivered"):
+        raise DomainError("E_BAD_STATE", f"{shipment_id} is {shipment.status}")
+    shipment.status = "cancelled"
+    shipment.notes.append(reason)
+    audit.record("shipment.cancelled", shipment.id, reason=reason)
+    return shipment
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_shipments.py b/tests/unit/test_shipments.py
--- a/tests/unit/test_shipments.py	2026-11-10 12:17:53
+++ b/tests/unit/test_shipments.py	2026-11-10 14:08:58
@@ -15,3 +15,40 @@
     with pytest.raises(DomainError) as err:
         shipments.create_shipment("nope", 1, "local")
     assert err.value.code == "E_UNKNOWN_CUSTOMER"
+
+
+def test_cancel_shipment():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 1, "local")
+    result = shipments.cancel_shipment(s.id, "customer request")
+    assert result is s
+    assert s.status == "cancelled"
+    assert s.notes == ["customer request"]
+    assert audit.LOG[-1]["action"] == "shipment.cancelled"
+
+
+def test_cancel_unknown_shipment():
+    with pytest.raises(DomainError) as err:
+        shipments.cancel_shipment("shp_missing", "reason")
+    assert err.value.code == "E_NOT_FOUND"
+
+
+def test_cancel_already_cancelled():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 1, "local")
+    shipments.cancel_shipment(s.id, "first")
+    with pytest.raises(DomainError) as err:
+        shipments.cancel_shipment(s.id, "second")
+    assert err.value.code == "E_BAD_STATE"
+    assert s.notes == ["first"]
+
+
+def test_cancel_delivered_shipment():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 1, "local")
+    s.status = "delivered"
+    with pytest.raises(DomainError) as err:
+        shipments.cancel_shipment(s.id, "too late")
+    assert err.value.code == "E_BAD_STATE"
+    assert s.status == "delivered"
+    assert s.notes == []
