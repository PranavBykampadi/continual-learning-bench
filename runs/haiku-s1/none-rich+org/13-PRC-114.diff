diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/test_reports.py b/tests/test_reports.py
--- a/tests/test_reports.py	1969-12-31 19:00:00
+++ b/tests/test_reports.py	2026-11-10 14:16:53
@@ -0,0 +1,39 @@
+from datetime import datetime, timedelta, timezone
+
+from parcelo import clock, reports
+from parcelo.models import Invoice
+from parcelo.store import db
+
+
+def _add(inv_id, amount, days_old, status="open", now=None):
+    issued = now - timedelta(days=days_old)
+    db.invoices[inv_id] = Invoice(
+        id=inv_id, shipment_id="S", amount=amount, status=status, issued_at=issued
+    )
+
+
+def test_aging_buckets_and_paid_excluded():
+    now = datetime(2026, 11, 10, 12, 0, tzinfo=timezone.utc)
+    clock.set_fixed(now)
+    _add("a", 10.0, 0, now=now)
+    _add("b", 20.0, 30, now=now)
+    _add("c", 1.0, 31, now=now)
+    _add("d", 2.0, 60, now=now)
+    _add("e", 4.0, 61, now=now)
+    _add("f", 8.0, 400, now=now)
+    _add("g", 100.0, 5, status="paid", now=now)
+    assert reports.aging_report() == {"0-30": 30.0, "31-60": 3.0, "60+": 12.0}
+
+
+def test_empty_buckets_are_zero():
+    clock.set_fixed(datetime(2026, 11, 10, tzinfo=timezone.utc))
+    assert reports.aging_report() == {"0-30": 0.0, "31-60": 0.0, "60+": 0.0}
+
+
+def test_naive_utc_issued_at_is_accepted():
+    now = datetime(2026, 11, 10, 12, 0, tzinfo=timezone.utc)
+    clock.set_fixed(now)
+    db.invoices["n"] = Invoice(
+        id="n", shipment_id="S", amount=5.0, issued_at=datetime(2026, 10, 1, 12, 0)
+    )
+    assert reports.aging_report() == {"0-30": 0.0, "31-60": 5.0, "60+": 0.0}
