@@ -1,9 +1,40 @@
-from parcelo import customers, invoices, shipments
+from datetime import datetime, timedelta, timezone
 
+import pytest
 
+from parcelo import clock, customers, invoices, shipments
+from parcelo.errors import DomainError
+
+
 def test_issue_and_pay():
     c = customers.add_customer("Acme")
     s = shipments.create_shipment(c.id, 2, "local")
     inv = invoices.issue_invoice(s.id)
     assert inv.amount == 7.0
     assert invoices.mark_paid(inv.id).status == "paid"
+
+
+def _issued_invoice(issued_at):
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 2, "local")
+    inv = invoices.issue_invoice(s.id)
+    inv.issued_at = issued_at
+    return inv
+
+
+def test_late_fee_zero_before_30_days():
+    inv = _issued_invoice(datetime(2026, 1, 1))
+    clock.set_fixed(datetime(2026, 1, 30, tzinfo=timezone.utc))
+    assert invoices.late_fee_for(inv.id) == 0.0
+
+
+def test_late_fee_accrues_per_day_after_30():
+    inv = _issued_invoice(datetime(2026, 1, 1))
+    clock.set_fixed(datetime(2026, 1, 1, tzinfo=timezone.utc) + timedelta(days=35))
+    assert invoices.late_fee_for(inv.id) == round(7.0 * 0.015 * 5, 2)
+
+
+def test_late_fee_unknown_invoice_raises():
+    with pytest.raises(DomainError) as exc:
+        invoices.late_fee_for("INV-missing")
+    assert exc.value.code == "E_NOT_FOUND"
