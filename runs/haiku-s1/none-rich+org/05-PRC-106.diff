@@ -32,3 +37,23 @@
 
 def open_invoices():
     return [i for i in db.invoices.values() if i.status == "open"]
+
+
+def late_fee_for(invoice_id):
+    """Late fee accrued on an invoice as of now.
+
+    An invoice is late 30 days after it was issued. From then on the fee is
+    1.5% of the invoice amount for each full day past those 30 days.
+    """
+    if invoice_id not in db.invoices:
+        raise DomainError("E_NOT_FOUND", f"invoice {invoice_id} not found")
+    invoice = db.invoices[invoice_id]
+    now = clock.now()
+    issued = invoice.issued_at
+    # issue_invoice stores naive UTC; clock.now() is timezone-aware UTC.
+    if issued.tzinfo is None:
+        now = now.replace(tzinfo=None)
+    elif now.tzinfo is None:
+        now = now.replace(tzinfo=issued.tzinfo)
+    days_past = (now - issued - LATE_AFTER).days
+    return _late_fee(invoice.amount, max(days_past, 0))
