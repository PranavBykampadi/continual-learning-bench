+from decimal import Decimal
+
+from parcelo.money import Money
+
 ZONE_BASE = {"local": 4.5, "national": 9.0, "international": 24.0}
 PER_KG = 1.25
 
+# Share of the regular quote that is charged, keyed by tier name.
+TIER_FACTOR = {"standard": Decimal("1"), "gold": Decimal("0.9")}
 
+
 def base_rate(zone):
     if zone not in ZONE_BASE:
         raise ValueError("unknown zone: %s" % zone)
@@ -12,3 +19,27 @@
     if weight_kg <= 0:
         raise ValueError("weight must be positive")
     return round(base_rate(zone) + PER_KG * weight_kg, 2)
+
+
+def discounted_quote(weight_kg: float, zone: str, tier: str) -> float:
+    """Return the shipping quote with the discount for the customer's tier applied.
+
+    Gold customers get 10% off. Standard customers pay the regular quote.
+    The discount is computed with Money and rounds half up to the cent.
+
+    Args:
+        weight_kg: Parcel weight in kilograms. Must be positive.
+        zone: Shipping zone, one of the keys of ZONE_BASE.
+        tier: Customer tier, either "standard" or "gold".
+
+    Returns:
+        The discounted quote in dollars, rounded to the cent.
+
+    Raises:
+        ValueError: If the tier is unknown, or if the weight or zone is invalid.
+    """
+    if tier not in TIER_FACTOR:
+        raise ValueError("unknown tier: %s" % tier)
+    regular = Money.parse(quote(weight_kg, zone))
+    discounted = regular.scale(TIER_FACTOR[tier])
+    return discounted.cents / 100
