     with pytest.raises(ValueError):
         rates.base_rate("moon")
+
+
+def test_discounted_quote_gold_is_ten_percent_off():
+    # regular quote for 2 kg local is 7.00
+    assert rates.discounted_quote(2, "local", "gold") == 6.3
+
+
+def test_discounted_quote_standard_is_regular_quote():
+    assert rates.discounted_quote(2, "local", "standard") == rates.quote(2, "local")
+
+
+def test_discounted_quote_rounds_half_up_to_cent():
+    # local 1 kg: regular 5.75, 10% off is 5.175 -> 5.18 (half up)
+    assert rates.discounted_quote(1, "local", "gold") == 5.18
+
+
+def test_discounted_quote_unknown_tier():
+    with pytest.raises(ValueError):
+        rates.discounted_quote(2, "local", "platinum")
+
+
+def test_discounted_quote_unknown_zone():
