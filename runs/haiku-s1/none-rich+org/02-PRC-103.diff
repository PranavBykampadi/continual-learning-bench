--- a/parcelo/rates.py	2026-11-10 12:17:53
+++ b/parcelo/rates.py	2026-11-10 14:10:18
@@ -8,7 +8,24 @@
     return ZONE_BASE[zone]
 
 
+from parcelo.legacy.billing import fuel_surcharge
+
+
 def quote(weight_kg, zone):
     if weight_kg <= 0:
         raise ValueError("weight must be positive")
     return round(base_rate(zone) + PER_KG * weight_kg, 2)
+
+
+def quote_with_surcharge(weight_kg, zone):
+    """Return the quote, the fuel surcharge for the zone, and the total.
+
+    Raises ValueError for an unknown zone or a non-positive weight.
+    """
+    base = quote(weight_kg, zone)
+    surcharge = fuel_surcharge(base, zone)
+    return {
+        "quote": base,
+        "surcharge": surcharge,
+        "total": round(base + surcharge, 2),
+    }
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/test_rates.py b/tests/test_rates.py
--- a/tests/test_rates.py	2026-11-10 12:17:53
+++ b/tests/test_rates.py	2026-11-10 14:10:31
@@ -10,3 +10,39 @@
 def test_unknown_zone():
     with pytest.raises(ValueError):
         rates.base_rate("moon")
+
+
+def test_quote_with_surcharge_local_has_no_surcharge():
+    assert rates.quote_with_surcharge(2, "local") == {
+        "quote": 7.0,
+        "surcharge": 0.0,
+        "total": 7.0,
+    }
+
+
+def test_quote_with_surcharge_national():
+    # quote 11.5 * 4% = 0.46
+    assert rates.quote_with_surcharge(2, "national") == {
+        "quote": 11.5,
+        "surcharge": 0.46,
+        "total": 11.96,
+    }
+
+
+def test_quote_with_surcharge_international():
+    # quote 26.5 * 9.5% = 2.5175 -> ~2.52 (sits on a rounding boundary, so allow 0.01)
+    result = rates.quote_with_surcharge(2, "international")
+    assert result["quote"] == 26.5
+    assert result["surcharge"] == pytest.approx(2.52, abs=0.01)
+    assert result["total"] == pytest.approx(29.02, abs=0.01)
+
+
+def test_quote_with_surcharge_unknown_zone():
+    with pytest.raises(ValueError):
+        rates.quote_with_surcharge(2, "moon")
+
+
+@pytest.mark.parametrize("weight", [0, -1])
+def test_quote_with_surcharge_non_positive_weight(weight):
+    with pytest.raises(ValueError):
+        rates.quote_with_surcharge(weight, "local")
