--- a/parcelo/shipments.py	2026-11-10 12:20:18
+++ b/parcelo/shipments.py	2026-11-10 14:21:05
@@ -1,3 +1,5 @@
+import math
+
 from parcelo import clock, events, ids
 from parcelo.errors import DomainError
 from parcelo.models import Shipment
@@ -28,3 +30,30 @@
     if shipment_id not in db.shipments:
         raise DomainError("E_NOT_FOUND", shipment_id)
     return db.shipments[shipment_id]
+
+
+def split_shipment(shipment_id, weights):
+    """Replace a "created" shipment with one new shipment per weight.
+
+    All validation happens before anything is changed, so a failed split
+    leaves the original shipment and the store untouched.
+    """
+    original = get_shipment(shipment_id)
+    if original.status != "created":
+        raise DomainError("E_BAD_STATE", f"{shipment_id} is {original.status}")
+    weights = list(weights)
+    if not weights:
+        raise DomainError("E_BAD_INPUT", "no weights given")
+    if any(w <= 0 for w in weights):
+        raise DomainError("E_BAD_WEIGHT", str(weights))
+    if not math.isclose(sum(weights), original.weight_kg, rel_tol=1e-9, abs_tol=1e-9):
+        raise DomainError(
+            "E_BAD_WEIGHT",
+            f"weights sum to {sum(weights)}, shipment weighs {original.weight_kg}",
+        )
+
+    new_shipments = [
+        create_shipment(original.customer_id, weight, original.zone) for weight in weights
+    ]
+    original.status = "split"
+    return new_shipments
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_shipments.py b/tests/unit/test_shipments.py
--- a/tests/unit/test_shipments.py	2026-11-10 12:20:18
+++ b/tests/unit/test_shipments.py	2026-11-10 14:21:09
@@ -15,3 +15,74 @@
     with pytest.raises(DomainError) as err:
         shipments.create_shipment("nope", 1, "local")
     assert err.value.code == "E_UNKNOWN_CUSTOMER"
+
+
+def test_split_replaces_shipment_with_new_ones_in_order():
+    c = customers.add_customer("Acme")
+    original = shipments.create_shipment(c.id, 10.0, "national")
+    parts = shipments.split_shipment(original.id, [6.0, 3.5, 0.5])
+
+    assert [p.weight_kg for p in parts] == [6.0, 3.5, 0.5]
+    for p in parts:
+        assert p.customer_id == c.id
+        assert p.zone == "national"
+        assert p.status == "created"
+        assert p.id != original.id
+    assert original.status == "split"
+    assert shipments.get_shipment(parts[0].id) is parts[0]
+
+
+def test_split_accepts_float_rounding_in_weights():
+    c = customers.add_customer("Acme")
+    original = shipments.create_shipment(c.id, 1.0, "local")
+    parts = shipments.split_shipment(original.id, [0.1] * 10)
+    assert len(parts) == 10
+
+
+def test_split_unknown_shipment():
+    with pytest.raises(DomainError) as err:
+        shipments.split_shipment("shp_missing", [1.0])
+    assert err.value.code == "E_NOT_FOUND"
+
+
+def test_split_requires_created_status():
+    c = customers.add_customer("Acme")
+    original = shipments.create_shipment(c.id, 2.0, "local")
+    original.status = "delivered"
+    with pytest.raises(DomainError) as err:
+        shipments.split_shipment(original.id, [1.0, 1.0])
+    assert err.value.code == "E_BAD_STATE"
+    assert original.status == "delivered"
+
+
+def test_split_twice_fails():
+    c = customers.add_customer("Acme")
+    original = shipments.create_shipment(c.id, 2.0, "local")
+    shipments.split_shipment(original.id, [1.0, 1.0])
+    with pytest.raises(DomainError) as err:
+        shipments.split_shipment(original.id, [1.0, 1.0])
+    assert err.value.code == "E_BAD_STATE"
+
+
+def test_split_weights_must_sum_to_original():
+    c = customers.add_customer("Acme")
+    original = shipments.create_shipment(c.id, 5.0, "local")
+    before = len(shipments.db.shipments)
+    with pytest.raises(DomainError) as err:
+        shipments.split_shipment(original.id, [2.0, 2.0])
+    assert err.value.code == "E_BAD_WEIGHT"
+    # failed split must not change anything
+    assert original.status == "created"
+    assert len(shipments.db.shipments) == before
+
+
+def test_split_rejects_empty_and_non_positive_weights():
+    c = customers.add_customer("Acme")
+    original = shipments.create_shipment(c.id, 5.0, "local")
+    with pytest.raises(DomainError) as err:
+        shipments.split_shipment(original.id, [])
+    assert err.value.code == "E_BAD_INPUT"
+    with pytest.raises(DomainError) as err:
+        shipments.split_shipment(original.id, [6.0, -1.0])
+    assert err.value.code == "E_BAD_WEIGHT"
+    assert original.status == "created"
