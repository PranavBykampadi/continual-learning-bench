diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_customers.py b/tests/unit/test_customers.py
--- a/tests/unit/test_customers.py	1969-12-31 19:00:00
+++ b/tests/unit/test_customers.py	2026-11-10 14:19:16
@@ -0,0 +1,25 @@
+import pytest
+
+from parcelo import customers, store
+from parcelo.errors import DomainError
+
+
+def test_upgrade_standard_to_gold_keeps_customer():
+    c = customers.add_customer("Acme")
+    upgraded = customers.upgrade_tier(c.id)
+    assert upgraded is c
+    assert upgraded.tier == "gold"
+    assert store.db.customers[c.id].tier == "gold"
+
+
+def test_upgrade_unknown_customer_fails():
+    with pytest.raises(DomainError) as err:
+        customers.upgrade_tier("C000000")
+    assert err.value.code == "E_UNKNOWN_CUSTOMER"
+
+
+def test_upgrade_already_gold_fails():
+    c = customers.add_customer("Acme", tier="gold")
+    with pytest.raises(DomainError) as err:
+        customers.upgrade_tier(c.id)
+    assert err.value.code == "E_BAD_STATE"
