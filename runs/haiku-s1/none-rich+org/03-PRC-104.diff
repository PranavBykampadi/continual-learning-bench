diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/test_customers.py b/tests/test_customers.py
--- a/tests/test_customers.py	1969-12-31 19:00:00
+++ b/tests/test_customers.py	2026-11-10 14:10:55
@@ -0,0 +1,26 @@
+import pytest
+
+from parcelo import audit, customers
+from parcelo.errors import DomainError
+
+
+def test_deactivate_customer_sets_inactive_and_returns_it():
+    c = customers.add_customer("Acme")
+    result = customers.deactivate_customer(c.id)
+    assert result is c
+    assert c.active is False
+    assert audit.LOG[-1]["action"] == "customer.deactivated"
+
+
+def test_deactivate_unknown_customer_fails():
+    with pytest.raises(DomainError) as exc:
+        customers.deactivate_customer("C000000")
+    assert exc.value.code == "E_UNKNOWN_CUSTOMER"
+
+
+def test_deactivate_already_inactive_customer_fails():
+    c = customers.add_customer("Acme")
+    customers.deactivate_customer(c.id)
+    with pytest.raises(DomainError) as exc:
+        customers.deactivate_customer(c.id)
+    assert exc.value.code == "E_BAD_STATE"
