diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/test_disputes.py b/tests/test_disputes.py
--- a/tests/test_disputes.py	1969-12-31 19:00:00
+++ b/tests/test_disputes.py	2026-11-10 14:20:33
@@ -0,0 +1,42 @@
+import pytest
+
+from parcelo import clock, disputes
+from parcelo.errors import DomainError
+from parcelo.models import Invoice
+from parcelo.store import db
+
+
+def _add_invoice(invoice_id="INV-1"):
+    invoice = Invoice(id=invoice_id, shipment_id="shp_000001", amount=10.0)
+    db.invoices[invoice.id] = invoice
+    return invoice
+
+
+def test_open_dispute_saves_and_returns_dispute():
+    _add_invoice("INV-1")
+    moment = clock.now()
+    clock.set_fixed(moment)
+
+    dispute = disputes.open_dispute("INV-1", "wrong weight")
+
+    assert dispute.invoice_id == "INV-1"
+    assert dispute.reason == "wrong weight"
+    assert dispute.opened_at == moment
+    assert dispute.id
+    assert db.disputes[dispute.id] is dispute
+
+
+def test_open_dispute_unknown_invoice_fails():
+    with pytest.raises(DomainError) as exc:
+        disputes.open_dispute("INV-missing", "wrong weight")
+    assert exc.value.code == "E_NOT_FOUND"
+    assert db.disputes == {}
+
+
+@pytest.mark.parametrize("reason", ["", "   ", None])
+def test_open_dispute_empty_reason_fails(reason):
+    _add_invoice("INV-1")
+    with pytest.raises(DomainError) as exc:
+        disputes.open_dispute("INV-1", reason)
+    assert exc.value.code == "E_BAD_INPUT"
+    assert db.disputes == {}
