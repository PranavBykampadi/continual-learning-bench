diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/test_reports.py b/tests/test_reports.py
--- a/tests/test_reports.py	1969-12-31 19:00:00
+++ b/tests/test_reports.py	2026-11-10 14:13:17
@@ -0,0 +1,22 @@
+from parcelo import reports, store
+from parcelo.models import Customer, Invoice, Shipment
+
+
+def _add(cust_id, ship_id, inv_id, amount, status):
+    store.db.customers.setdefault(cust_id, Customer(id=cust_id, name=cust_id))
+    store.db.shipments[ship_id] = Shipment(id=ship_id, customer_id=cust_id, weight_kg=1, zone="local")
+    store.db.invoices[inv_id] = Invoice(id=inv_id, shipment_id=ship_id, amount=amount, status=status)
+
+
+def test_outstanding_by_customer_counts_only_open_invoices():
+    _add("C1", "S1", "I1", 10.25, "open")
+    _add("C1", "S2", "I2", 4.5, "open")
+    _add("C1", "S3", "I3", 99.0, "paid")
+    _add("C2", "S4", "I4", 7.0, "void")
+    _add("C2", "S5", "I5", 3.1, "open")
+    _add("C3", "S6", "I6", 50.0, "paid")
+    assert reports.outstanding_by_customer() == {"C1": 14.75, "C2": 3.1, "C3": 0.0}
+
+
+def test_outstanding_by_customer_empty():
+    assert reports.outstanding_by_customer() == {}
