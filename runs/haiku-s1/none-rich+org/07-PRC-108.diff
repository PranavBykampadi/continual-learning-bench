+def outstanding_by_customer():
+    """Map each customer id to the total of their open invoices.
+
+    Invoices link to customers through their shipment. Only invoices with
+    status "open" count; paid and void invoices are ignored. Every known
+    customer appears in the result, with 0.0 if they owe nothing.
+    """
+    totals = {customer_id: 0.0 for customer_id in db.customers}
+    for invoice in db.invoices.values():
+        if invoice.status != "open":
+            continue
+        shipment = db.shipments[invoice.shipment_id]
+        totals[shipment.customer_id] = totals.get(shipment.customer_id, 0.0) + invoice.amount
+    return {customer_id: round(total, 2) for customer_id, total in totals.items()}
+
