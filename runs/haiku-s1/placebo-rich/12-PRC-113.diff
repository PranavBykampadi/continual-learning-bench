 def open_invoices():
     return [i for i in db.invoices.values() if i.status == "open"]
+
+
+def apply_credit(invoice_id, amount):
+    """Reduce an open invoice by a credit and return the remaining amount.
+
+    The invoice amount is reduced in place, so reports (revenue) and the
+    customer's outstanding balance reflect the net amount.
+    """
+    if invoice_id not in db.invoices:
+        raise DomainError("E_NOT_FOUND", invoice_id)
+    invoice = db.invoices[invoice_id]
+    if invoice.status != "open":
+        raise DomainError("E_BAD_STATE", f"{invoice_id} is {invoice.status}")
+    if amount <= 0:
+        raise DomainError("E_BAD_INPUT", str(amount))
+    if round(amount, 2) > round(invoice.amount, 2):
+        raise DomainError("E_BAD_INPUT", f"credit {amount} exceeds {invoice.amount}")
+    invoice.amount = round(invoice.amount - amount, 2)
+    audit.record("invoice.credit_applied", invoice_id, credit=amount, remaining=invoice.amount)
+    return invoice.amount
