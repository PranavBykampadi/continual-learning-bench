@@ -1,9 +1,44 @@
-from parcelo import customers, invoices, shipments
+from datetime import datetime, timedelta, timezone
 
+import pytest
 
+from parcelo import clock, customers, invoices, shipments
+from parcelo.errors import DomainError
+
+
 def test_issue_and_pay():
     c = customers.add_customer("Acme")
     s = shipments.create_shipment(c.id, 2, "local")
     inv = invoices.issue_invoice(s.id)
     assert inv.amount == 7.0
     assert invoices.mark_paid(inv.id).status == "paid"
+
+
+def _invoice_issued_days_ago(days):
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 2, "local")
+    inv = invoices.issue_invoice(s.id)
+    inv.issued_at = datetime(2026, 1, 1)
+    clock.set_fixed(datetime(2026, 1, 1, tzinfo=timezone.utc) + timedelta(days=days))
+    return inv
+
+
+def test_late_fee_zero_before_thirty_days():
+    inv = _invoice_issued_days_ago(29)
+    assert invoices.late_fee_for(inv.id) == 0.0
+
+
+def test_late_fee_zero_exactly_thirty_days():
+    inv = _invoice_issued_days_ago(30)
+    assert invoices.late_fee_for(inv.id) == 0.0
+
+
+def test_late_fee_accrues_per_day_past_thirty():
+    inv = _invoice_issued_days_ago(40)
+    assert invoices.late_fee_for(inv.id) == round(inv.amount * 0.015 * 10, 2)
+
+
+def test_late_fee_unknown_invoice_fails():
+    with pytest.raises(DomainError) as err:
+        invoices.late_fee_for("INV-missing")
+    assert err.value.code == "E_NOT_FOUND"
