diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/test_claims.py b/tests/test_claims.py
--- a/tests/test_claims.py	1969-12-31 19:00:00
+++ b/tests/test_claims.py	2026-11-10 12:34:17
@@ -0,0 +1,48 @@
+import pytest
+
+from parcelo import claims
+from parcelo.errors import DomainError
+from parcelo.models import Customer, Shipment
+from parcelo.store import db
+
+
+def _delivered_shipment(shipment_id="shp_1", status="delivered"):
+    db.customers["cus_1"] = Customer(id="cus_1", name="Test")
+    shipment = Shipment(
+        id=shipment_id, customer_id="cus_1", weight_kg=2.0, zone="local", status=status
+    )
+    db.shipments[shipment_id] = shipment
+    return shipment
+
+
+def test_file_claim_on_delivered_shipment_stores_and_returns_claim():
+    _delivered_shipment()
+    claim = claims.file_claim("shp_1", 25.0, "damaged")
+    assert claim.shipment_id == "shp_1"
+    assert claim.amount == 25.0
+    assert claim.reason == "damaged"
+    assert claim.filed_at is not None
+    assert db.claims[claim.id] is claim
+
+
+def test_file_claim_rejects_undelivered_shipment():
+    _delivered_shipment(status="created")
+    with pytest.raises(DomainError) as exc:
+        claims.file_claim("shp_1", 25.0, "lost")
+    assert exc.value.code == "E_BAD_STATE"
+    assert db.claims == {}
+
+
+def test_file_claim_rejects_unknown_shipment():
+    with pytest.raises(DomainError) as exc:
+        claims.file_claim("shp_missing", 25.0, "lost")
+    assert exc.value.code == "E_NOT_FOUND"
+
+
+@pytest.mark.parametrize("amount", [0, -5.0])
+def test_file_claim_rejects_non_positive_amount(amount):
+    _delivered_shipment()
+    with pytest.raises(DomainError) as exc:
+        claims.file_claim("shp_1", amount, "damaged")
+    assert exc.value.code == "E_BAD_INPUT"
+    assert db.claims == {}
