+def aging_report():
+    # Invoice.issued_at is naive UTC (see invoices.issue_invoice), so compare
+    # against a naive UTC "now" to avoid mixing aware and naive datetimes.
+    now = clock.now().replace(tzinfo=None)
+    buckets = {"0-30": 0.0, "31-60": 0.0, "60+": 0.0}
+    for invoice in db.invoices.values():
+        if invoice.status == "paid":
+            continue
+        age = days_between(invoice.issued_at, end=now)
+        if age <= 30:
+            key = "0-30"
+        elif age <= 60:
+            key = "31-60"
+        else:
+            key = "60+"
+        buckets[key] += invoice.amount
+    return {key: round(total, 2) for key, total in buckets.items()}
 
 
