     assert audit.LOG[-1]["action"] == "shipment.created"
 
 
+def test_add_note_timestamps_text():
+    from datetime import datetime, timezone
+
+    from parcelo import clock
+
+    moment = datetime(2026, 1, 2, 3, 4, 5, tzinfo=timezone.utc)
+    clock.set_fixed(moment)
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 1.5, "national")
+    out = shipments.add_note(s.id, "left at door")
+    assert out is s
+    assert s.notes == [{"text": "left at door", "at": moment}]
+
+
+def test_add_note_unknown_shipment():
+    with pytest.raises(DomainError) as err:
+        shipments.add_note("shp_missing", "hi")
+    assert err.value.code == "E_NOT_FOUND"
+
+
+def test_add_note_empty_text():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 1.5, "national")
+    for bad in ["", "   "]:
+        with pytest.raises(DomainError) as err:
+            shipments.add_note(s.id, bad)
+        assert err.value.code == "E_BAD_INPUT"
+    assert s.notes == []
+
+
