diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_customers_upgrade.py b/tests/unit/test_customers_upgrade.py
--- a/tests/unit/test_customers_upgrade.py	1969-12-31 19:00:00
+++ b/tests/unit/test_customers_upgrade.py	2026-11-10 12:39:08
@@ -0,0 +1,45 @@
+import pytest
+
+from parcelo import customers, events
+from parcelo.errors import DomainError
+
+
+def test_upgrade_standard_to_gold_returns_same_customer():
+    c = customers.add_customer("Acme")
+    assert c.tier == "standard"
+
+    upgraded = customers.upgrade_tier(c.id)
+
+    assert upgraded is c
+    assert customers.get_customer(c.id).tier == "gold"
+
+
+def test_upgrade_emits_event():
+    c = customers.add_customer("Acme")
+    events.OUTBOX.clear()
+
+    customers.upgrade_tier(c.id)
+
+    assert len(events.OUTBOX) == 1
+    event = events.OUTBOX[-1]
+    assert event["name"] == "customer.tier_upgraded"
+    assert event["entity_id"] == c.id
+    assert event["payload"] == {"from_tier": "standard", "to_tier": "gold"}
+
+
+def test_upgrade_unknown_customer_fails():
+    with pytest.raises(DomainError) as err:
+        customers.upgrade_tier("C_missing")
+    assert err.value.code == "E_NOT_FOUND"
+    assert events.OUTBOX == []
+
+
+def test_upgrade_already_gold_fails():
+    c = customers.add_customer("Acme", tier="gold")
+    events.OUTBOX.clear()
+
+    with pytest.raises(DomainError) as err:
+        customers.upgrade_tier(c.id)
+    assert err.value.code == "E_BAD_STATE"
+    assert customers.get_customer(c.id).tier == "gold"
+    assert events.OUTBOX == []
