diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_aging_report.py b/tests/unit/test_aging_report.py
--- a/tests/unit/test_aging_report.py	1969-12-31 19:00:00
+++ b/tests/unit/test_aging_report.py	2026-11-10 12:36:41
@@ -0,0 +1,70 @@
+from datetime import datetime, timedelta, timezone
+
+from parcelo import clock, reports
+from parcelo.models import Invoice
+from parcelo.money import Money
+from parcelo.store import db
+
+NOW = datetime(2026, 11, 10, 12, 0, tzinfo=timezone.utc)
+
+
+def _invoice(inv_id, amount, days_old, status="open", naive=False):
+    issued = NOW - timedelta(days=days_old)
+    if naive:
+        issued = issued.replace(tzinfo=None)
+    db.invoices[inv_id] = Invoice(
+        id=inv_id, shipment_id="shp", amount=amount, status=status, issued_at=issued
+    )
+
+
+def setup_function():
+    clock.set_fixed(NOW)
+
+
+def teardown_function():
+    clock.clear_fixed()
+
+
+def test_empty_report_is_all_zero():
+    report = reports.aging_report()
+    assert report == {"0-30": Money.zero(), "31-60": Money.zero(), "60+": Money.zero()}
+
+
+def test_buckets_and_boundaries():
+    _invoice("a", 10.00, 0)
+    _invoice("b", 1.50, 30)
+    _invoice("c", 2.25, 31)
+    _invoice("d", 3.00, 60)
+    _invoice("e", 4.00, 61)
+    report = reports.aging_report()
+    assert report["0-30"] == Money.parse(11.50)
+    assert report["31-60"] == Money.parse(5.25)
+    assert report["60+"] == Money.parse(4.00)
+
+
+def test_paid_invoices_are_excluded():
+    _invoice("a", 10.00, 5)
+    _invoice("b", 99.00, 90, status="paid")
+    report = reports.aging_report()
+    assert report["0-30"] == Money.parse(10.00)
+    assert report["60+"] == Money.zero()
+
+
+def test_age_is_whole_days_from_partial_day():
+    # 30 days and 23 hours old is still 30 whole days -> 0-30 bucket.
+    issued = NOW - timedelta(days=30, hours=23)
+    db.invoices["x"] = Invoice(id="x", shipment_id="s", amount=7.00, issued_at=issued)
+    assert reports.aging_report()["0-30"] == Money.parse(7.00)
+
+
+def test_naive_issued_at_from_invoice_service_is_handled():
+    _invoice("n", 12.34, 45, naive=True)
+    assert reports.aging_report()["31-60"] == Money.parse(12.34)
+
+
+def test_values_are_money_not_float():
+    _invoice("a", 0.1, 1)
+    _invoice("b", 0.2, 1)
+    report = reports.aging_report()
+    assert all(isinstance(v, Money) for v in report.values())
+    assert report["0-30"].cents == 30
