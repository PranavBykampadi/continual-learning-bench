+from datetime import datetime, timezone
 
+from parcelo import clock
+from parcelo.money import Money
 from parcelo.store import db
+
+
+def _as_utc(moment):
+    # invoices.issue_invoice stores naive UTC datetimes; clock.now() is aware.
+    if moment.tzinfo is None:
+        return moment.replace(tzinfo=timezone.utc)
+    return moment
+
+
+def aging_report():
+    """Total open invoices by age in whole days since issue, as Money."""
+    now = _as_utc(clock.now())
+    buckets = {"0-30": Money.zero(), "31-60": Money.zero(), "60+": Money.zero()}
+    for invoice in db.invoices.values():
+        if invoice.status != "open":
+            continue
+        age_days = (now - _as_utc(invoice.issued_at)).days
+        if age_days <= 30:
+            key = "0-30"
+        elif age_days <= 60:
+            key = "31-60"
+        else:
+            key = "60+"
+        buckets[key] = buckets[key] + Money.parse(invoice.amount)
+    return buckets
 
 
