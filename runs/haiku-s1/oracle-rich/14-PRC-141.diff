     if shipment_id not in db.shipments:
         raise DomainError("E_NOT_FOUND", shipment_id)
     return db.shipments[shipment_id]
+
+
+def reassign_shipment(shipment_id, new_customer_id):
+    if shipment_id not in db.shipments:
+        raise DomainError("E_NOT_FOUND", shipment_id)
+    if new_customer_id not in db.customers:
+        raise DomainError("E_UNKNOWN_CUSTOMER", new_customer_id)
+    shipment = db.shipments[shipment_id]
+    if shipment.status == "delivered" or shipment.delivered_at is not None:
+        raise DomainError("E_BAD_STATE", f"{shipment_id} already delivered")
+    old_customer_id = shipment.customer_id
+    shipment.customer_id = new_customer_id
+    events.emit(
+        "shipment.reassigned",
+        shipment.id,
+        from_customer=old_customer_id,
+        to_customer=new_customer_id,
+    )
+    return shipment
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_shipment_reassign.py b/tests/unit/test_shipment_reassign.py
--- a/tests/unit/test_shipment_reassign.py	1969-12-31 19:00:00
+++ b/tests/unit/test_shipment_reassign.py	2026-11-10 12:37:10
@@ -0,0 +1,69 @@
+import pytest
+
+from parcelo import clock, customers, events, shipments
+from parcelo.errors import DomainError
+from parcelo.store import db
+
+
+def _shipment(customer_id):
+    return shipments.create_shipment(customer_id, 2.0, "national")
+
+
+def test_reassign_changes_customer_and_returns_shipment():
+    a = customers.add_customer("Acme")
+    b = customers.add_customer("Globex")
+    s = _shipment(a.id)
+    result = shipments.reassign_shipment(s.id, b.id)
+    assert result is s
+    assert s.customer_id == b.id
+    assert db.shipments[s.id].customer_id == b.id
+
+
+def test_reassign_emits_event():
+    a = customers.add_customer("Acme")
+    b = customers.add_customer("Globex")
+    s = _shipment(a.id)
+    shipments.reassign_shipment(s.id, b.id)
+    event = events.OUTBOX[-1]
+    assert event["name"] == "shipment.reassigned"
+    assert event["entity_id"] == s.id
+    assert event["payload"] == {"from_customer": a.id, "to_customer": b.id}
+
+
+def test_reassign_unknown_shipment_fails():
+    b = customers.add_customer("Globex")
+    with pytest.raises(DomainError) as err:
+        shipments.reassign_shipment("shp_999999", b.id)
+    assert err.value.code == "E_NOT_FOUND"
+
+
+def test_reassign_to_unknown_customer_fails():
+    a = customers.add_customer("Acme")
+    s = _shipment(a.id)
+    with pytest.raises(DomainError) as err:
+        shipments.reassign_shipment(s.id, "C_nope")
+    assert err.value.code == "E_UNKNOWN_CUSTOMER"
+    assert s.customer_id == a.id
+
+
+def test_reassign_delivered_shipment_fails():
+    a = customers.add_customer("Acme")
+    b = customers.add_customer("Globex")
+    s = _shipment(a.id)
+    s.status = "delivered"
+    s.delivered_at = clock.now()
+    with pytest.raises(DomainError) as err:
+        shipments.reassign_shipment(s.id, b.id)
+    assert err.value.code == "E_BAD_STATE"
+    assert s.customer_id == a.id
+
+
+def test_reassign_shipment_with_delivered_timestamp_fails():
+    a = customers.add_customer("Acme")
+    b = customers.add_customer("Globex")
+    s = _shipment(a.id)
+    s.delivered_at = clock.now()
+    with pytest.raises(DomainError) as err:
+        shipments.reassign_shipment(s.id, b.id)
+    assert err.value.code == "E_BAD_STATE"
+    assert s.customer_id == a.id
