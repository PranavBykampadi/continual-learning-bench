+def outstanding_by_customer():
+    """Map every customer id to the total Money of their open invoices.
+
+    Invoices are linked to customers through their shipment. Paid and void
+    invoices are ignored; customers owing nothing map to Money.zero().
+    """
+    totals = {customer_id: Money.zero() for customer_id in db.customers}
+    for invoice in db.invoices.values():
+        if invoice.status != "open":
+            continue
+        shipment = db.shipments[invoice.shipment_id]
+        current = totals.get(shipment.customer_id, Money.zero())
+        totals[shipment.customer_id] = current + Money.parse(invoice.amount)
+    return totals
 
 
