+++ b/tests/unit/test_outstanding_balances.py	2026-11-10 12:33:32
@@ -0,0 +1,57 @@
+from parcelo import customers, invoices, reports, shipments
+from parcelo.money import Money
+from parcelo.store import db
+
+
+def _invoice_for(customer, weight, zone="local"):
+    s = shipments.create_shipment(customer.id, weight, zone)
+    return invoices.issue_invoice(s.id)
+
+
+def test_sums_open_invoices_per_customer():
+    acme = customers.add_customer("Acme")
+    globex = customers.add_customer("Globex")
+    _invoice_for(acme, 2, "local")  # 7.0
+    _invoice_for(acme, 2, "local")  # 7.0
+    _invoice_for(globex, 2, "local")
+
+    result = reports.outstanding_by_customer()
+
+    assert result[acme.id] == Money.parse(14.0)
+    assert result[globex.id] == Money.parse(7.0)
+
+
+def test_paid_and_void_invoices_are_excluded():
+    acme = customers.add_customer("Acme")
+    paid = _invoice_for(acme, 2, "local")
+    voided = _invoice_for(acme, 2, "local")
+    _invoice_for(acme, 2, "local")  # stays open
+    invoices.mark_paid(paid.id)
+    db.invoices[voided.id].status = "void"
+
+    result = reports.outstanding_by_customer()
+
+    assert result[acme.id] == Money.parse(7.0)
+
+
+def test_customer_without_open_invoices_maps_to_zero():
+    acme = customers.add_customer("Acme")
+    inv = _invoice_for(acme, 2, "local")
+    invoices.mark_paid(inv.id)
+    idle = customers.add_customer("Idle")
+
+    result = reports.outstanding_by_customer()
+
+    assert result[acme.id] == Money.zero()
+    assert result[idle.id] == Money.zero()
+    assert set(result) == {acme.id, idle.id}
+
+
+def test_values_are_money_not_float():
+    acme = customers.add_customer("Acme")
+    _invoice_for(acme, 2, "local")
+
+    result = reports.outstanding_by_customer()
+
+    assert isinstance(result[acme.id], Money)
+    assert result[acme.id].cents == 700
