diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_void_invoice.py b/tests/unit/test_void_invoice.py
--- a/tests/unit/test_void_invoice.py	1969-12-31 19:00:00
+++ b/tests/unit/test_void_invoice.py	2026-11-10 12:30:08
@@ -0,0 +1,54 @@
+import pytest
+
+from parcelo import audit, clock, invoices
+from parcelo.errors import DomainError
+from parcelo.models import Invoice
+from parcelo.store import db
+
+
+def _open_invoice(invoice_id="INV-TEST0001", status="open"):
+    inv = Invoice(id=invoice_id, shipment_id="shp_x", amount=10.0, status=status)
+    db.invoices[inv.id] = inv
+    return inv
+
+
+def test_void_open_invoice_sets_status_and_time():
+    moment = clock.now()
+    clock.set_fixed(moment)
+    try:
+        _open_invoice()
+        inv = invoices.void_invoice("INV-TEST0001")
+    finally:
+        clock.clear_fixed()
+    assert inv.status == "void"
+    assert inv.voided_at == moment
+    assert db.invoices["INV-TEST0001"] is inv
+
+
+def test_void_records_audit():
+    _open_invoice()
+    invoices.void_invoice("INV-TEST0001")
+    assert audit.LOG[-1]["action"] == "invoice.voided"
+    assert audit.LOG[-1]["entity_id"] == "INV-TEST0001"
+
+
+def test_void_unknown_invoice_fails():
+    with pytest.raises(DomainError) as err:
+        invoices.void_invoice("INV-MISSING")
+    assert err.value.code == "E_NOT_FOUND"
+
+
+def test_void_paid_invoice_fails():
+    _open_invoice(status="paid")
+    with pytest.raises(DomainError) as err:
+        invoices.void_invoice("INV-TEST0001")
+    assert err.value.code == "E_BAD_STATE"
+    assert db.invoices["INV-TEST0001"].status == "paid"
+
+
+def test_void_already_void_invoice_fails():
+    _open_invoice()
+    invoices.void_invoice("INV-TEST0001")
+    with pytest.raises(DomainError) as err:
+        invoices.void_invoice("INV-TEST0001")
+    assert err.value.code == "E_BAD_STATE"
