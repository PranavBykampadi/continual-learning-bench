 def open_invoices():
     return [i for i in db.invoices.values() if i.status == "open"]
+
+
+def apply_credit(invoice_id, amount):
+    """Reduce an open invoice by a credit and return the remaining Money amount."""
+    if invoice_id not in db.invoices:
+        raise DomainError("E_NOT_FOUND", f"invoice {invoice_id}")
+    invoice = db.invoices[invoice_id]
+    if invoice.status != "open":
+        raise DomainError("E_BAD_STATE", f"invoice {invoice_id} is not open")
+    try:
+        credit = Money.parse(amount)
+    except (ArithmeticError, ValueError, TypeError):
+        raise DomainError("E_BAD_INPUT", f"bad credit amount: {amount!r}")
+    if credit.cents <= 0:
+        raise DomainError("E_BAD_INPUT", "credit must be positive")
+    current = Money.parse(invoice.amount)
+    if current < credit:
+        raise DomainError("E_BAD_INPUT", "credit is larger than the invoice amount")
+    remaining = current - credit
+    # Invoice.amount stays a float in dollars: reports and customer balances sum it.
+    invoice.amount = remaining.cents / 100
+    audit.record(
+        "invoice.credit_applied",
+        invoice.id,
+        credit=str(credit),
+        remaining=str(remaining),
+    )
+    return remaining
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_invoice_credit.py b/tests/unit/test_invoice_credit.py
--- a/tests/unit/test_invoice_credit.py	1969-12-31 19:00:00
+++ b/tests/unit/test_invoice_credit.py	2026-11-10 12:36:12
@@ -0,0 +1,80 @@
+import pytest
+
+from parcelo import audit, customers, invoices, reports, shipments
+from parcelo.errors import DomainError
+from parcelo.models import Invoice
+from parcelo.money import Money
+from parcelo.store import db
+
+
+def _open_invoice(amount=7.0):
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 2, "local")
+    inv = invoices.issue_invoice(s.id)
+    inv.amount = amount
+    return c, inv
+
+
+def test_credit_reduces_open_invoice_and_returns_money():
+    _, inv = _open_invoice(7.0)
+    remaining = invoices.apply_credit(inv.id, 2.5)
+    assert remaining == Money(450)
+    assert db.invoices[inv.id].amount == 4.5
+    assert db.invoices[inv.id].status == "open"
+
+
+def test_credit_accepts_money_and_records_audit():
+    _, inv = _open_invoice(7.0)
+    invoices.apply_credit(inv.id, Money(100))
+    assert db.invoices[inv.id].amount == 6.0
+    assert audit.LOG[-1]["action"] == "invoice.credit_applied"
+    assert audit.LOG[-1]["entity_id"] == inv.id
+
+
+def test_credit_keeps_reports_and_balance_working():
+    c, inv = _open_invoice(7.0)
+    invoices.apply_credit(inv.id, 2.0)
+    assert isinstance(db.invoices[inv.id].amount, float)
+    assert customers.outstanding_balance(c.id) == 5.0
+    assert reports.revenue_total() == 0.0
+    invoices.mark_paid(inv.id)
+    assert reports.revenue_total() == 5.0
+
+
+def test_unknown_invoice_fails():
+    with pytest.raises(DomainError) as err:
+        invoices.apply_credit("INV-missing", 1)
+    assert err.value.code == "E_NOT_FOUND"
+
+
+def test_paid_invoice_fails():
+    _, inv = _open_invoice(7.0)
+    invoices.mark_paid(inv.id)
+    with pytest.raises(DomainError) as err:
+        invoices.apply_credit(inv.id, 1)
+    assert err.value.code == "E_BAD_STATE"
+    assert db.invoices[inv.id].amount == 7.0
+
+
+def test_credit_larger_than_amount_fails():
+    _, inv = _open_invoice(7.0)
+    with pytest.raises(DomainError) as err:
+        invoices.apply_credit(inv.id, 7.01)
+    assert err.value.code == "E_BAD_INPUT"
+    assert db.invoices[inv.id].amount == 7.0
+
+
+def test_non_positive_credit_fails():
+    _, inv = _open_invoice(7.0)
+    for bad in (0, -1):
+        with pytest.raises(DomainError) as err:
+            invoices.apply_credit(inv.id, bad)
+        assert err.value.code == "E_BAD_INPUT"
+    assert db.invoices[inv.id].amount == 7.0
+
+
+def test_unparseable_credit_fails():
+    _, inv = _open_invoice(7.0)
+    with pytest.raises(DomainError) as err:
+        invoices.apply_credit(inv.id, "lots")
+    assert err.value.code == "E_BAD_INPUT"
