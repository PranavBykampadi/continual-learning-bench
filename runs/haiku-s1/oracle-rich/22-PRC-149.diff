+def split_shipment(shipment_id, weights):
+    """Replace a shipment in status "created" with one new shipment per weight.
+
+    The original is marked "split". New shipments keep the original customer and
+    zone and are returned in the same order as ``weights``. All checks run before
+    anything is changed.
+    """
+    original = get_shipment(shipment_id)
+    if original.status != "created":
+        raise DomainError("E_BAD_STATE", f"{shipment_id} is {original.status}")
+    weights = list(weights)
+    if not weights:
+        raise DomainError("E_BAD_INPUT", "no weights given")
+    for w in weights:
+        if w <= 0:
+            raise DomainError("E_BAD_WEIGHT", str(w))
+    if not math.isclose(sum(weights), original.weight_kg, rel_tol=1e-9, abs_tol=1e-9):
+        raise DomainError(
+            "E_BAD_INPUT",
+            f"weights sum to {sum(weights)}, expected {original.weight_kg}",
+        )
+
+    now = clock.now()
+    new_shipments = []
+    for w in weights:
+        shipment = Shipment(
+            id=ids.new_id("shp"),
+            customer_id=original.customer_id,
+            weight_kg=w,
+            zone=original.zone,
+            created_at=now,
+        )
+        db.shipments[shipment.id] = shipment
+        new_shipments.append(shipment)
+
+    original.status = "split"
+    events.emit("shipment.split", original.id, new_ids=[s.id for s in new_shipments])
+    for shipment in new_shipments:
+        events.emit("shipment.created", shipment.id, zone=shipment.zone)
+    return new_shipments
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_split_shipment.py b/tests/unit/test_split_shipment.py
--- a/tests/unit/test_split_shipment.py	1969-12-31 19:00:00
+++ b/tests/unit/test_split_shipment.py	2026-11-10 12:41:13
@@ -0,0 +1,84 @@
+import pytest
+
+from parcelo import customers, events, shipments
+from parcelo.errors import DomainError
+from parcelo.store import db
+
+
+def _make(weight=10.0, zone="national"):
+    c = customers.add_customer("Acme")
+    return shipments.create_shipment(c.id, weight, zone)
+
+
+def test_split_creates_one_shipment_per_weight_in_order():
+    s = _make(10.0, "national")
+    new = shipments.split_shipment(s.id, [4.0, 6.0])
+    assert [n.weight_kg for n in new] == [4.0, 6.0]
+    for n in new:
+        assert n.id.startswith("shp_")
+        assert n.customer_id == s.customer_id
+        assert n.zone == "national"
+        assert n.status == "created"
+        assert db.shipments[n.id] is n
+
+
+def test_original_marked_split():
+    s = _make(10.0)
+    shipments.split_shipment(s.id, [5.0, 5.0])
+    assert db.shipments[s.id].status == "split"
+
+
+def test_split_emits_events():
+    s = _make(3.0)
+    events.OUTBOX.clear()
+    new = shipments.split_shipment(s.id, [1.0, 2.0])
+    names = [e["name"] for e in events.OUTBOX]
+    assert names[0] == "shipment.split"
+    assert names[1:] == ["shipment.created", "shipment.created"]
+    assert events.OUTBOX[0]["payload"]["new_ids"] == [n.id for n in new]
+
+
+def test_float_weights_summing_with_rounding_accepted():
+    s = _make(0.3)
+    new = shipments.split_shipment(s.id, [0.1, 0.2])
+    assert len(new) == 2
+
+
+def test_unknown_shipment_fails():
+    with pytest.raises(DomainError) as err:
+        shipments.split_shipment("shp_missing", [1.0])
+    assert err.value.code == "E_NOT_FOUND"
+
+
+def test_non_created_shipment_fails():
+    s = _make(10.0)
+    shipments.split_shipment(s.id, [5.0, 5.0])
+    with pytest.raises(DomainError) as err:
+        shipments.split_shipment(s.id, [5.0, 5.0])
+    assert err.value.code == "E_BAD_STATE"
+
+
+def test_weights_must_sum_to_original():
+    s = _make(10.0)
+    before = len(db.shipments)
+    with pytest.raises(DomainError) as err:
+        shipments.split_shipment(s.id, [4.0, 5.0])
+    assert err.value.code == "E_BAD_INPUT"
+    # nothing changed on failure
+    assert len(db.shipments) == before
+    assert db.shipments[s.id].status == "created"
+
+
+def test_empty_weights_fails():
+    s = _make(10.0)
+    with pytest.raises(DomainError) as err:
+        shipments.split_shipment(s.id, [])
+    assert err.value.code == "E_BAD_INPUT"
+
+
+def test_non_positive_weight_fails():
+    s = _make(10.0)
+    with pytest.raises(DomainError) as err:
+        shipments.split_shipment(s.id, [12.0, -2.0])
+    assert err.value.code == "E_BAD_WEIGHT"
+    assert db.shipments[s.id].status == "created"
