+def _volume_label(shipment_count):
+    # Same thresholds as legacy billing.volume_tier; reimplemented because
+    # parcelo.legacy is being deleted and must not be imported from new code.
+    if shipment_count >= 50:
+        return "bulk"
+    if shipment_count >= 10:
+        return "regular"
+    return "starter"
+
+
+def volume_report():
+    """Per-customer shipment count and volume tier, keyed by customer id.
+
+    Every customer appears, including those with no shipments.
+    """
+    counts = {customer_id: 0 for customer_id in db.customers}
+    for shipment in db.shipments.values():
+        if shipment.customer_id in counts:
+            counts[shipment.customer_id] += 1
+    return {
+        customer_id: {"shipments": count, "tier": _volume_label(count)}
+        for customer_id, count in counts.items()
+    }
+
+
