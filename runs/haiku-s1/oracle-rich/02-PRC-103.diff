+@dataclass(frozen=True)
+class SurchargedQuote:
+    base: Money
+    surcharge: Money
+    total: Money
+
+
+def quote_with_surcharge(weight_kg, zone):
+    """Return the base quote plus the zone's fuel surcharge, as Money."""
+    if zone not in ZONE_BASE:
+        raise DomainError("E_BAD_ZONE", "unknown zone: %s" % zone)
+    if weight_kg <= 0:
+        raise DomainError("E_BAD_WEIGHT", "weight must be positive")
+    base = Money.parse(quote(weight_kg, zone))
+    surcharge = base.scale(FUEL_SURCHARGE[zone])
+    return SurchargedQuote(base=base, surcharge=surcharge, total=base + surcharge)
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_rates_surcharge.py b/tests/unit/test_rates_surcharge.py
--- a/tests/unit/test_rates_surcharge.py	1969-12-31 19:00:00
+++ b/tests/unit/test_rates_surcharge.py	2026-11-10 12:30:47
@@ -0,0 +1,48 @@
+import pytest
+
+from parcelo import rates
+from parcelo.errors import DomainError
+from parcelo.money import Money
+
+
+def test_local_has_no_surcharge():
+    q = rates.quote_with_surcharge(2, "local")
+    assert q.base == Money(700)
+    assert q.surcharge == Money(0)
+    assert q.total == Money(700)
+
+
+def test_national_surcharge_is_four_percent():
+    # base 9.00 + 1.25 * 2 = 11.50; 4% = 0.46
+    q = rates.quote_with_surcharge(2, "national")
+    assert q.base == Money(1150)
+    assert q.surcharge == Money(46)
+    assert q.total == Money(1196)
+
+
+def test_international_surcharge_is_nine_point_five_percent():
+    # base 24.00 + 1.25 * 4 = 29.00; 9.5% = 2.755 -> 2.76 (half up)
+    q = rates.quote_with_surcharge(4, "international")
+    assert q.base == Money(2900)
+    assert q.surcharge == Money(276)
+    assert q.total == Money(3176)
+
+
+def test_returns_money_not_float():
+    q = rates.quote_with_surcharge(1.5, "national")
+    assert isinstance(q.base, Money)
+    assert isinstance(q.surcharge, Money)
+    assert isinstance(q.total, Money)
+
+
+def test_unknown_zone_raises_domain_error():
+    with pytest.raises(DomainError) as err:
+        rates.quote_with_surcharge(1, "moon")
+    assert err.value.code == "E_BAD_ZONE"
+
+
+@pytest.mark.parametrize("weight", [0, -1, -0.5])
+def test_non_positive_weight_raises_domain_error(weight):
+    with pytest.raises(DomainError) as err:
+        rates.quote_with_surcharge(weight, "local")
+    assert err.value.code == "E_BAD_WEIGHT"
