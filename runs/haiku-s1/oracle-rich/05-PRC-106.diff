 def open_invoices():
     return [i for i in db.invoices.values() if i.status == "open"]
+
+
+def late_fee_for(invoice_id):
+    """Late fee picked up by an invoice so far, as Money.
+
+    The invoice is late 30 days after it was issued. From then on the fee is
+    1.5% of the invoice amount for each whole day past those 30 days.
+    """
+    if invoice_id not in db.invoices:
+        raise DomainError("E_NOT_FOUND", invoice_id)
+    invoice = db.invoices[invoice_id]
+    if invoice.issued_at is None:
+        raise DomainError("E_BAD_STATE", f"{invoice_id} has no issue date")
+
+    issued = invoice.issued_at
+    if issued.tzinfo is None:
+        # issue_invoice stores naive UTC timestamps; treat them as UTC.
+        issued = issued.replace(tzinfo=timezone.utc)
+
+    elapsed = clock.now() - issued
+    if elapsed < LATE_AFTER:
+        return Money.zero()
+    days_late = (elapsed - LATE_AFTER).days
+    amount = Money.parse(invoice.amount)
+    return amount.scale(LATE_FEE_PER_DAY * days_late)
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_late_fee.py b/tests/unit/test_late_fee.py
--- a/tests/unit/test_late_fee.py	1969-12-31 19:00:00
+++ b/tests/unit/test_late_fee.py	2026-11-10 12:32:23
@@ -0,0 +1,76 @@
+from datetime import datetime, timedelta, timezone
+
+import pytest
+
+from parcelo import clock, invoices
+from parcelo.errors import DomainError
+from parcelo.models import Invoice
+from parcelo.money import Money
+from parcelo.store import db
+
+ISSUED = datetime(2026, 1, 1, tzinfo=timezone.utc)
+
+
+def _invoice(amount=100.0, issued_at=ISSUED):
+    inv = Invoice(id="INV-TEST", shipment_id="shp_x", amount=amount, issued_at=issued_at)
+    db.invoices[inv.id] = inv
+    return inv
+
+
+def _at(days, hours=0):
+    clock.set_fixed(ISSUED + timedelta(days=days, hours=hours))
+
+
+def test_not_late_before_30_days():
+    _invoice()
+    _at(29)
+    assert invoices.late_fee_for("INV-TEST") == Money.zero()
+
+
+def test_exactly_30_days_has_no_fee():
+    _invoice()
+    _at(30)
+    assert invoices.late_fee_for("INV-TEST") == Money.zero()
+
+
+def test_partial_day_past_30_has_no_fee():
+    _invoice()
+    _at(30, hours=23)
+    assert invoices.late_fee_for("INV-TEST") == Money.zero()
+
+
+def test_one_day_late_is_1_5_percent():
+    _invoice(amount=100.0)
+    _at(31)
+    assert invoices.late_fee_for("INV-TEST") == Money(150)
+
+
+def test_fee_grows_per_day():
+    _invoice(amount=100.0)
+    _at(40)
+    assert invoices.late_fee_for("INV-TEST") == Money(1500)
+
+
+def test_fee_rounds_to_cents():
+    _invoice(amount=33.33)
+    _at(31)
+    # 3333 cents * 0.015 = 49.995 -> 50 cents, half-up
+    assert invoices.late_fee_for("INV-TEST").cents == 50
+
+
+def test_fee_is_money_not_float():
+    _invoice(amount=100.0)
+    _at(31)
+    assert isinstance(invoices.late_fee_for("INV-TEST"), Money)
+
+
+def test_naive_issue_time_is_treated_as_utc():
+    _invoice(issued_at=ISSUED.replace(tzinfo=None))
+    _at(31)
+    assert invoices.late_fee_for("INV-TEST") == Money(150)
+
+
+def test_unknown_invoice_fails():
+    with pytest.raises(DomainError) as err:
+        invoices.late_fee_for("INV-NOPE")
+    assert err.value.code == "E_NOT_FOUND"
