diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_refunds.py b/tests/unit/test_refunds.py
--- a/tests/unit/test_refunds.py	1969-12-31 19:00:00
+++ b/tests/unit/test_refunds.py	2026-11-10 12:31:44
@@ -0,0 +1,76 @@
+import pytest
+
+from parcelo import audit, clock, refunds
+from parcelo.errors import DomainError
+from parcelo.models import Invoice, Refund
+from parcelo.money import Money
+from parcelo.store import db
+
+
+def _add_invoice(invoice_id, status):
+    db.invoices[invoice_id] = Invoice(
+        id=invoice_id, shipment_id="shp_x", amount=20.0, status=status
+    )
+
+
+def test_refund_paid_invoice_is_stored_and_returned():
+    _add_invoice("inv_1", "paid")
+    r = refunds.create_refund("inv_1", 5.5)
+    assert isinstance(r, Refund)
+    assert r.id.startswith("ref_")
+    assert r.invoice_id == "inv_1"
+    assert r.amount == Money(550)
+    assert r.created_at is not None
+    assert db.refunds[r.id] is r
+
+
+def test_refund_uses_fixed_clock():
+    _add_invoice("inv_1", "paid")
+    moment = clock.now()
+    clock.set_fixed(moment)
+    try:
+        r = refunds.create_refund("inv_1", Money(100))
+    finally:
+        clock.clear_fixed()
+    assert r.created_at == moment
+    assert r.amount == Money(100)
+
+
+def test_refund_records_audit():
+    _add_invoice("inv_1", "paid")
+    r = refunds.create_refund("inv_1", 2)
+    assert audit.LOG[-1]["action"] == "refund.created"
+    assert audit.LOG[-1]["entity_id"] == r.id
+
+
+def test_unknown_invoice_fails():
+    with pytest.raises(DomainError) as err:
+        refunds.create_refund("nope", 1)
+    assert err.value.code == "E_NOT_FOUND"
+    assert db.refunds == {}
+
+
+@pytest.mark.parametrize("status", ["open", "void"])
+def test_unpaid_invoice_fails(status):
+    _add_invoice("inv_1", status)
+    with pytest.raises(DomainError) as err:
+        refunds.create_refund("inv_1", 1)
+    assert err.value.code == "E_BAD_STATE"
+    assert db.refunds == {}
+    assert audit.LOG == []
+
+
+@pytest.mark.parametrize("amount", [0, -1, "0", -2.5])
+def test_non_positive_amount_fails(amount):
+    _add_invoice("inv_1", "paid")
+    with pytest.raises(DomainError) as err:
+        refunds.create_refund("inv_1", amount)
+    assert err.value.code == "E_BAD_INPUT"
+    assert db.refunds == {}
+
+
+def test_unparseable_amount_fails():
+    _add_invoice("inv_1", "paid")
+    with pytest.raises(DomainError) as err:
+        refunds.create_refund("inv_1", "lots")
+    assert err.value.code == "E_BAD_INPUT"
