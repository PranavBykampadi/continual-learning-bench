diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/parcelo/refunds.py b/parcelo/refunds.py
--- a/parcelo/refunds.py	1969-12-31 19:00:00
+++ b/parcelo/refunds.py	2026-11-10 12:31:39
@@ -0,0 +1,37 @@
+from decimal import InvalidOperation
+
+from parcelo import audit, clock, ids
+from parcelo.errors import DomainError
+from parcelo.models import Refund
+from parcelo.money import Money
+from parcelo.store import db
+
+
+def create_refund(invoice_id, amount):
+    """Record a refund against a paid invoice.
+
+    `amount` is a Money or a dollar value (float, int, str, Decimal).
+    Raises DomainError: E_NOT_FOUND if the invoice does not exist,
+    E_BAD_STATE if it is not paid, E_BAD_INPUT if the amount is not a
+    positive number of dollars.
+    """
+    if invoice_id not in db.invoices:
+        raise DomainError("E_NOT_FOUND", invoice_id)
+    invoice = db.invoices[invoice_id]
+    if invoice.status != "paid":
+        raise DomainError("E_BAD_STATE", f"invoice {invoice_id} is {invoice.status}")
+    try:
+        money = Money.parse(amount)
+    except (InvalidOperation, TypeError, ValueError):
+        raise DomainError("E_BAD_INPUT", f"bad refund amount {amount!r}")
+    if money.cents <= 0:
+        raise DomainError("E_BAD_INPUT", f"refund amount must be positive, got {money}")
+    refund = Refund(
+        id=ids.new_id("ref"),
+        invoice_id=invoice_id,
+        amount=money,
+        created_at=clock.now(),
+    )
+    db.refunds[refund.id] = refund
+    audit.record("refund.created", refund.id, invoice_id=invoice_id, cents=money.cents)
+    return refund
