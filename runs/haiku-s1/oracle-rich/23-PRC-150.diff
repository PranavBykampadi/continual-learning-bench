+def set_credit_limit(customer_id, amount):
+    """Set a customer's credit limit and return the new limit as Money."""
+    if customer_id not in db.customers:
+        raise DomainError("E_UNKNOWN_CUSTOMER", f"no customer {customer_id}")
+    try:
+        limit = Money.parse(amount)
+    except (ArithmeticError, TypeError, ValueError):
+        raise DomainError("E_BAD_INPUT", "credit limit must be a number")
+    if limit.cents < 0:
+        raise DomainError("E_BAD_INPUT", "credit limit must not be negative")
+    db.customers[customer_id].credit_limit = limit
+    events.emit("customer.credit_limit_set", customer_id, cents=limit.cents)
+    return limit
 
 
