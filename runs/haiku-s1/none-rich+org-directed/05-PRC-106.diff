+import pytest
 
+from parcelo import clock, customers, invoices, shipments
+from parcelo.errors import DomainError
+
+
 def test_issue_and_pay():
     c = customers.add_customer("Acme")
     s = shipments.create_shipment(c.id, 2, "local")
     inv = invoices.issue_invoice(s.id)
     assert inv.amount == 7.0
     assert invoices.mark_paid(inv.id).status == "paid"
+
+
+def _issued_invoice():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 2, "local")
+    return invoices.issue_invoice(s.id)
+
+
+def _at(inv, days):
+    issued = inv.issued_at.replace(tzinfo=timezone.utc)
+    clock.set_fixed(issued + timedelta(days=days))
+
+
+def test_late_fee_zero_before_and_at_30_days():
+    inv = _issued_invoice()
+    _at(inv, 29)
+    assert invoices.late_fee_for(inv.id).cents == 0
+    _at(inv, 30)
+    assert invoices.late_fee_for(inv.id).cents == 0
+
+
+def test_late_fee_accrues_per_day_after_30():
+    inv = _issued_invoice()  # amount 7.00
+    _at(inv, 31)
+    assert invoices.late_fee_for(inv.id).cents == 11  # 1.5% of $7.00 = 10.5c, rounds half up
+    _at(inv, 32)
+    assert invoices.late_fee_for(inv.id).cents == 21  # 2 days: 3% of $7.00
+
+
+def test_late_fee_unknown_invoice_fails():
+    with pytest.raises(DomainError) as exc:
+        invoices.late_fee_for("INV-missing")
+    assert exc.value.code == "E_NOT_FOUND"
