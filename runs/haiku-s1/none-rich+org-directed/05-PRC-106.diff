 def open_invoices():
     return [i for i in db.invoices.values() if i.status == "open"]
+
+
+def late_fee_for(invoice_id: str) -> Money:
+    """Return the late fee an invoice has accrued as of now.
+
+    An invoice is late 30 whole days after it was issued. From then on it
+    accrues 1.5% of its amount for each further whole day.
+
+    Args:
+        invoice_id: ID of the invoice.
+
+    Returns:
+        The late fee as Money. Zero if the invoice is not late yet.
+
+    Raises:
+        DomainError: With code E_NOT_FOUND if no invoice has this ID.
+    """
+    if invoice_id not in db.invoices:
+        raise DomainError("E_NOT_FOUND", f"invoice {invoice_id}")
+    invoice = db.invoices[invoice_id]
+    issued = invoice.issued_at
+    if issued.tzinfo is None:
+        # issue_invoice still stores naive UTC datetimes; read them as UTC.
+        issued = issued.replace(tzinfo=timezone.utc)
+    days_late = (clock.now() - issued).days - LATE_AFTER_DAYS
+    if days_late <= 0:
+        return Money.zero()
+    amount = Money.parse(invoice.amount)
+    return amount.scale(LATE_FEE_PER_DAY * days_late)
