@@ -0,0 +1,36 @@
+from parcelo import clock, events, ids
+from parcelo.errors import DomainError
+from parcelo.models import Pickup
+from parcelo.shipments import get_shipment
+from parcelo.store import db
+
+
+def schedule_pickup(shipment_id, window_start):
+    """Book a pickup for a shipment that is ready to go.
+
+    Args:
+        shipment_id: ID of the shipment to pick up.
+        window_start: Start of the pickup window, as given by the caller.
+
+    Returns:
+        The newly created Pickup.
+
+    Raises:
+        DomainError: E_NOT_FOUND if the shipment does not exist, or
+            E_BAD_STATE if its status is not "created".
+    """
+    shipment = get_shipment(shipment_id)
+    if shipment.status != "created":
+        raise DomainError(
+            "E_BAD_STATE",
+            f"shipment {shipment_id} is {shipment.status}, expected created",
+        )
+    pickup = Pickup(
+        id=ids.new_id("pku"),
+        shipment_id=shipment_id,
+        window_start=window_start,
+        scheduled_at=clock.now(),
+    )
+    db.pickups[pickup.id] = pickup
+    events.emit("pickup.scheduled", pickup.id, shipment_id=shipment_id)
+    return pickup
