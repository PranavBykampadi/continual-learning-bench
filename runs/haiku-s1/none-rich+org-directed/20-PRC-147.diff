+def _volume_tier(shipment_count: int) -> str:
+    """Return the volume tier label for a shipment count.
+
+    Same thresholds as the legacy billing helper, reimplemented here so new
+    code does not depend on the scheduled-for-deletion `parcelo.legacy` package.
+
+    Args:
+        shipment_count: Number of shipments the customer has.
+
+    Returns:
+        "bulk" for 50 or more, "regular" for 10 or more, otherwise "starter".
+    """
+    if shipment_count >= 50:
+        return "bulk"
+    if shipment_count >= 10:
+        return "regular"
+    return "starter"
+
+
+def volume_report() -> dict:
+    """Return shipment count and volume tier for every customer.
+
+    Customers with no shipments are included with a count of 0.
+
+    Returns:
+        A dict keyed by customer id, each value being
+        {"shipments": <count>, "tier": <label>}.
+    """
+    counts = {customer_id: 0 for customer_id in db.customers}
+    for shipment in db.shipments.values():
+        if shipment.customer_id in counts:
+            counts[shipment.customer_id] += 1
+    return {
+        customer_id: {"shipments": count, "tier": _volume_tier(count)}
+        for customer_id, count in counts.items()
+    }
+
+
