diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/test_reports.py b/tests/test_reports.py
--- a/tests/test_reports.py	1969-12-31 19:00:00
+++ b/tests/test_reports.py	2026-11-10 14:26:13
@@ -0,0 +1,49 @@
+from parcelo import reports
+from parcelo.models import Customer, Shipment
+from parcelo.store import db, reset
+
+
+def _add_customer(customer_id):
+    db.customers[customer_id] = Customer(id=customer_id, name=customer_id)
+
+
+def _add_shipments(customer_id, count):
+    for i in range(count):
+        shipment_id = f"{customer_id}-{i}"
+        db.shipments[shipment_id] = Shipment(
+            id=shipment_id, customer_id=customer_id, weight_kg=1.0, zone="local"
+        )
+
+
+def setup_function():
+    reset()
+
+
+def test_volume_report_includes_customers_without_shipments():
+    _add_customer("C1")
+    _add_customer("C2")
+    _add_shipments("C1", 3)
+
+    assert reports.volume_report() == {
+        "C1": {"shipments": 3, "tier": "starter"},
+        "C2": {"shipments": 0, "tier": "starter"},
+    }
+
+
+def test_volume_report_tier_boundaries():
+    _add_customer("regular")
+    _add_customer("bulk")
+    _add_shipments("regular", 10)
+    _add_shipments("bulk", 50)
+
+    report = reports.volume_report()
+    assert report["regular"] == {"shipments": 10, "tier": "regular"}
+    assert report["bulk"] == {"shipments": 50, "tier": "bulk"}
+
+
+def test_volume_tier_thresholds():
+    assert reports._volume_tier(0) == "starter"
+    assert reports._volume_tier(9) == "starter"
+    assert reports._volume_tier(10) == "regular"
+    assert reports._volume_tier(49) == "regular"
+    assert reports._volume_tier(50) == "bulk"
