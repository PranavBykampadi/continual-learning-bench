+from parcelo.errors import DomainError
+from parcelo.legacy.billing import fuel_surcharge
+from parcelo.money import Money
+
 ZONE_BASE = {"local": 4.5, "national": 9.0, "international": 24.0}
 PER_KG = 1.25
 
@@ -12,3 +16,28 @@
     if weight_kg <= 0:
         raise ValueError("weight must be positive")
     return round(base_rate(zone) + PER_KG * weight_kg, 2)
+
+
+def quote_with_surcharge(weight_kg, zone):
+    """Return the quote for a shipment plus the zone's fuel surcharge.
+
+    Args:
+        weight_kg: Shipment weight in kilograms. Must be greater than zero.
+        zone: One of the zones in ZONE_BASE.
+
+    Returns:
+        A dict with Money values under "quote" (base price), "surcharge"
+        (fuel surcharge for the zone) and "total" (quote plus surcharge).
+
+    Raises:
+        DomainError: "E_BAD_ZONE" if the zone is unknown, or "E_BAD_WEIGHT"
+            if the weight is zero or negative.
+    """
+    if zone not in ZONE_BASE:
+        raise DomainError("E_BAD_ZONE", str(zone))
+    if weight_kg <= 0:
+        raise DomainError("E_BAD_WEIGHT", str(weight_kg))
+    base = Money.parse(quote(weight_kg, zone))
+    # fuel_surcharge is legacy float code; wrap its result as Money at the boundary.
+    surcharge = Money.parse(fuel_surcharge(float(base.cents) / 100, zone))
+    return {"quote": base, "surcharge": surcharge, "total": base + surcharge}
