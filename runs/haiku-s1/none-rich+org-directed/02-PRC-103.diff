+
+def test_quote_with_surcharge_local_has_no_surcharge():
+    result = rates.quote_with_surcharge(8, "local")
+    assert result["quote"] == Money(1450)
+    assert result["surcharge"] == Money(0)
+    assert result["total"] == Money(1450)
+
+
+def test_quote_with_surcharge_national():
+    result = rates.quote_with_surcharge(8, "national")
+    assert result["quote"] == Money(1900)
+    assert result["surcharge"] == Money(76)
+    assert result["total"] == Money(1976)
+
+
+def test_quote_with_surcharge_international():
+    result = rates.quote_with_surcharge(8, "international")
+    assert result["quote"] == Money(3400)
+    assert result["surcharge"] == Money(323)
+    assert result["total"] == Money(3723)
+
+
+def test_quote_with_surcharge_unknown_zone():
+    with pytest.raises(DomainError) as err:
+        rates.quote_with_surcharge(8, "moon")
+    assert err.value.code == "E_BAD_ZONE"
+
+
+@pytest.mark.parametrize("weight", [0, -1, -0.5])
+def test_quote_with_surcharge_bad_weight(weight):
+    with pytest.raises(DomainError) as err:
+        rates.quote_with_surcharge(weight, "national")
+    assert err.value.code == "E_BAD_WEIGHT"
