diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/test_disputes.py b/tests/test_disputes.py
--- a/tests/test_disputes.py	1969-12-31 19:00:00
+++ b/tests/test_disputes.py	2026-11-10 14:27:08
@@ -0,0 +1,55 @@
+from datetime import datetime, timezone
+
+import pytest
+
+from parcelo import clock, customers, disputes, events, invoices, shipments, store
+from parcelo.errors import DomainError
+
+
+def _invoice():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 2, "local")
+    return invoices.issue_invoice(s.id)
+
+
+def test_open_dispute_stores_and_returns_dispute():
+    inv = _invoice()
+    moment = datetime(2026, 11, 10, 12, 0, tzinfo=timezone.utc)
+    clock.set_fixed(moment)
+    d = disputes.open_dispute(inv.id, "wrong weight")
+    assert d.id.startswith("dsp_")
+    assert d.invoice_id == inv.id
+    assert d.reason == "wrong weight"
+    assert d.opened_at == moment
+    assert store.db.disputes[d.id] is d
+
+
+def test_open_dispute_emits_event():
+    inv = _invoice()
+    d = disputes.open_dispute(inv.id, "not received")
+    assert events.OUTBOX[-1]["name"] == "dispute.opened"
+    assert events.OUTBOX[-1]["entity_id"] == d.id
+    assert events.OUTBOX[-1]["payload"] == {"invoice_id": inv.id}
+
+
+def test_missing_invoice_fails():
+    with pytest.raises(DomainError) as exc:
+        disputes.open_dispute("INV-nope", "wrong weight")
+    assert exc.value.code == "E_NOT_FOUND"
+    assert store.db.disputes == {}
+
+
+@pytest.mark.parametrize("reason", ["", "   ", None])
+def test_empty_reason_fails(reason):
+    inv = _invoice()
+    with pytest.raises(DomainError) as exc:
+        disputes.open_dispute(inv.id, reason)
+    assert exc.value.code == "E_BAD_INPUT"
+    assert store.db.disputes == {}
+
+
+def test_reset_clears_disputes():
+    inv = _invoice()
+    disputes.open_dispute(inv.id, "wrong weight")
+    store.reset()
+    assert store.db.disputes == {}
