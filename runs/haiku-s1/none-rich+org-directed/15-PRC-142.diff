+from datetime import datetime, timezone
 
+import pytest
 
+from parcelo import clock, customers, invoices, shipments
+from parcelo.errors import DomainError
+
+
 def test_issue_and_pay():
     c = customers.add_customer("Acme")
     s = shipments.create_shipment(c.id, 2, "local")
     inv = invoices.issue_invoice(s.id)
     assert inv.amount == 7.0
     assert invoices.mark_paid(inv.id).status == "paid"
+
+
+@pytest.fixture
+def fixed_now():
+    moment = datetime(2026, 11, 10, 12, 0, tzinfo=timezone.utc)
+    clock.set_fixed(moment)
+    yield moment
+    clock.clear_fixed()
+
+
+def _new_invoice():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 2, "local")
+    return invoices.issue_invoice(s.id)
+
+
+def test_reopen_paid_invoice(fixed_now):
+    inv = _new_invoice()
+    invoices.mark_paid(inv.id)
+    reopened = invoices.reopen_invoice(inv.id)
+    assert reopened is inv
+    assert reopened.status == "open"
+    assert reopened.paid_at is None
+    assert reopened.reopened_at == fixed_now
+    assert inv in invoices.open_invoices()
+
+
+def test_reopen_missing_invoice_fails():
+    with pytest.raises(DomainError) as err:
+        invoices.reopen_invoice("INV-does-not-exist")
+    assert err.value.code == "E_NOT_FOUND"
+
+
+def test_reopen_unpaid_invoice_fails():
+    inv = _new_invoice()
+    with pytest.raises(DomainError) as err:
+        invoices.reopen_invoice(inv.id)
+    assert err.value.code == "E_BAD_STATE"
+    assert inv.status == "open"
+    assert inv.reopened_at is None
