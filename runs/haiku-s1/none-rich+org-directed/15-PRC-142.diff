+def reopen_invoice(invoice_id: str) -> Invoice:
+    """Set a paid invoice back to open, for example after it was marked paid by mistake.
+
+    Clears paid_at, records reopened_at, and writes an audit entry.
+
+    Args:
+        invoice_id: ID of the invoice to reopen.
+
+    Returns:
+        The reopened invoice.
+
+    Raises:
+        DomainError: "E_NOT_FOUND" if the invoice does not exist, or "E_BAD_STATE"
+            if it is not paid.
+    """
+    if invoice_id not in db.invoices:
+        raise DomainError("E_NOT_FOUND", invoice_id)
+    invoice = db.invoices[invoice_id]
+    if invoice.status != "paid":
+        raise DomainError("E_BAD_STATE", f"{invoice_id} is {invoice.status}, not paid")
+    invoice.status = "open"
+    invoice.paid_at = None
+    invoice.reopened_at = clock.now()
+    audit.record("invoice.reopened", invoice_id, reopened_at=invoice.reopened_at)
     return invoice
 
 
