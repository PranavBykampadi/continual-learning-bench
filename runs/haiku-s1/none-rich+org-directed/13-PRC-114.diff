+def _as_utc(moment):
+    # Some invoices carry naive UTC datetimes (see invoices.issue_invoice).
+    # Tag them so they can be compared with clock.now().
+    if moment.tzinfo is None:
+        return moment.replace(tzinfo=timezone.utc)
+    return moment
+
+
+def aging_report():
+    now = clock.now()
+    buckets = {"0-30": 0.0, "31-60": 0.0, "60+": 0.0}
+    for invoice in db.invoices.values():
+        if invoice.status != "open":
+            continue
+        age = days_between(_as_utc(invoice.issued_at), now)
+        if age <= 30:
+            key = "0-30"
+        elif age <= 60:
+            key = "31-60"
+        else:
+            key = "60+"
+        buckets[key] += invoice.amount
+    return {key: round(total, 2) for key, total in buckets.items()}
 
 
