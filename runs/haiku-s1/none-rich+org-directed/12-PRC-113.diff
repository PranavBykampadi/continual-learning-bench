 def open_invoices():
     return [i for i in db.invoices.values() if i.status == "open"]
+
+
+def apply_credit(invoice_id: str, amount) -> float:
+    """Reduce an open invoice's amount by a credit.
+
+    Arithmetic is done in `Money`; the result is stored back as a float
+    dollar amount so existing reports and balances keep working.
+
+    Args:
+        invoice_id: ID of the invoice to credit.
+        amount: Credit to apply, as a float, int, str, Decimal or Money.
+
+    Returns:
+        The remaining invoice amount in dollars.
+
+    Raises:
+        DomainError: E_NOT_FOUND if the invoice does not exist, E_BAD_STATE if
+            it is not open, E_BAD_INPUT if the credit is not positive or is
+            larger than the invoice amount.
+    """
+    if invoice_id not in db.invoices:
+        raise DomainError("E_NOT_FOUND", invoice_id)
+    invoice = db.invoices[invoice_id]
+    if invoice.status != "open":
+        raise DomainError("E_BAD_STATE", f"{invoice_id} is {invoice.status}")
+
+    credit = Money.parse(amount)
+    current = Money.parse(invoice.amount)
+    if credit.cents <= 0:
+        raise DomainError("E_BAD_INPUT", f"credit must be positive: {amount}")
+    if current < credit:
+        raise DomainError("E_BAD_INPUT", f"credit {credit} exceeds invoice {current}")
+
+    remaining = current - credit
+    invoice.amount = remaining.cents / 100
+    audit.record(
+        "invoice.credit_applied",
+        invoice_id,
+        credit=str(credit),
+        remaining=str(remaining),
+    )
+    return invoice.amount
