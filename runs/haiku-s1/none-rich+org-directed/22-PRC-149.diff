 from parcelo import clock, events, ids
 from parcelo.errors import DomainError
 from parcelo.models import Shipment
@@ -28,3 +30,38 @@
     if shipment_id not in db.shipments:
         raise DomainError("E_NOT_FOUND", shipment_id)
     return db.shipments[shipment_id]
+
+
+def split_shipment(shipment_id: str, weights: list[float]) -> list[Shipment]:
+    """Replace a shipment in status "created" with one new shipment per weight.
+
+    Args:
+        shipment_id: Id of the shipment to split.
+        weights: Weight in kg for each new shipment. Must sum to the original weight.
+
+    Returns:
+        The new shipments, in the same order as ``weights``.
+
+    Raises:
+        DomainError: E_NOT_FOUND if the shipment does not exist, E_BAD_STATE if it is
+            not in status "created", E_BAD_WEIGHT if any weight is not positive,
+            E_BAD_INPUT if ``weights`` is empty or does not add up to the original weight.
+    """
+    shipment = get_shipment(shipment_id)
+    if shipment.status != "created":
+        raise DomainError("E_BAD_STATE", shipment_id)
+    if not weights:
+        raise DomainError("E_BAD_INPUT", shipment_id)
+    for weight in weights:
+        if weight <= 0:
+            raise DomainError("E_BAD_WEIGHT", str(weight))
+    if not math.isclose(sum(weights), shipment.weight_kg):
+        total = sum(weights)
+        raise DomainError("E_BAD_INPUT", f"weights sum to {total}, expected {shipment.weight_kg}")
+
+    new_shipments = [
+        create_shipment(shipment.customer_id, weight, shipment.zone) for weight in weights
+    ]
+    shipment.status = "split"
+    events.emit("shipment.split", shipment.id, new_ids=[s.id for s in new_shipments])
+    return new_shipments
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_shipments.py b/tests/unit/test_shipments.py
--- a/tests/unit/test_shipments.py	2026-11-10 12:20:18
+++ b/tests/unit/test_shipments.py	2026-11-10 14:28:03
@@ -15,3 +15,49 @@
     with pytest.raises(DomainError) as err:
         shipments.create_shipment("nope", 1, "local")
     assert err.value.code == "E_UNKNOWN_CUSTOMER"
+
+
+def test_split_replaces_with_new_shipments():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 3.0, "national")
+    news = shipments.split_shipment(s.id, [1.0, 2.0])
+    assert [n.weight_kg for n in news] == [1.0, 2.0]
+    assert all(n.customer_id == c.id and n.zone == "national" for n in news)
+    assert all(n.status == "created" for n in news)
+    assert shipments.get_shipment(s.id).status == "split"
+    assert events.OUTBOX[-1]["name"] == "shipment.split"
+    assert events.OUTBOX[-1]["payload"]["new_ids"] == [n.id for n in news]
+
+
+def test_split_unknown_shipment():
+    with pytest.raises(DomainError) as err:
+        shipments.split_shipment("shp_missing", [1.0])
+    assert err.value.code == "E_NOT_FOUND"
+
+
+def test_split_requires_created_status():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 2.0, "local")
+    shipments.split_shipment(s.id, [1.0, 1.0])
+    with pytest.raises(DomainError) as err:
+        shipments.split_shipment(s.id, [1.0, 1.0])
+    assert err.value.code == "E_BAD_STATE"
+
+
+def test_split_weights_must_add_up():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 2.0, "local")
+    with pytest.raises(DomainError) as err:
+        shipments.split_shipment(s.id, [1.0, 0.5])
+    assert err.value.code == "E_BAD_INPUT"
+    assert shipments.get_shipment(s.id).status == "created"
+    assert len(shipments.db.shipments) == 1
+
+
+def test_split_rejects_non_positive_weight():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 2.0, "local")
+    with pytest.raises(DomainError) as err:
+        shipments.split_shipment(s.id, [3.0, -1.0])
+    assert err.value.code == "E_BAD_WEIGHT"
+    assert shipments.get_shipment(s.id).status == "created"
