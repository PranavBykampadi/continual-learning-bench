diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/test_refunds.py b/tests/test_refunds.py
--- a/tests/test_refunds.py	1969-12-31 19:00:00
+++ b/tests/test_refunds.py	2026-11-10 14:13:19
@@ -0,0 +1,76 @@
+import pytest
+
+from parcelo import audit, customers, invoices, refunds, shipments, store
+from parcelo.errors import DomainError
+from parcelo.models import Refund
+from parcelo.money import Money
+
+
+def _issue(weight_kg=2):
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, weight_kg, "local")
+    return invoices.issue_invoice(s.id)
+
+
+def test_refund_paid_invoice_is_stored_and_returned():
+    inv = _issue()
+    invoices.mark_paid(inv.id)
+
+    refund = refunds.create_refund(inv.id, "3.50")
+
+    assert isinstance(refund, Refund)
+    assert refund.id.startswith("rfd_")
+    assert refund.invoice_id == inv.id
+    assert refund.amount == Money(350)
+    assert refund.created_at is not None
+    assert store.db.refunds[refund.id] is refund
+
+
+def test_refund_accepts_float_and_money_amounts():
+    inv = _issue()
+    invoices.mark_paid(inv.id)
+
+    assert refunds.create_refund(inv.id, 1.25).amount == Money(125)
+    assert refunds.create_refund(inv.id, Money(75)).amount == Money(75)
+
+
+def test_refund_is_recorded_in_audit_log():
+    inv = _issue()
+    invoices.mark_paid(inv.id)
+
+    refund = refunds.create_refund(inv.id, 2)
+
+    entry = audit.LOG[-1]
+    assert entry["action"] == "refund.created"
+    assert entry["entity_id"] == refund.id
+    assert entry["details"]["invoice_id"] == inv.id
+
+
+def test_refund_unpaid_invoice_fails():
+    inv = _issue()
+
+    with pytest.raises(DomainError) as exc:
+        refunds.create_refund(inv.id, 1)
+
+    assert exc.value.code == "E_BAD_STATE"
+    assert store.db.refunds == {}
+
+
+def test_refund_missing_invoice_fails():
+    with pytest.raises(DomainError) as exc:
+        refunds.create_refund("INV-doesnotexist", 1)
+
+    assert exc.value.code == "E_NOT_FOUND"
+    assert store.db.refunds == {}
+
+
+@pytest.mark.parametrize("amount", [0, -1, "0"])
+def test_refund_non_positive_amount_fails(amount):
+    inv = _issue()
+    invoices.mark_paid(inv.id)
+
+    with pytest.raises(DomainError) as exc:
+        refunds.create_refund(inv.id, amount)
+
+    assert exc.value.code == "E_BAD_INPUT"
+    assert store.db.refunds == {}
