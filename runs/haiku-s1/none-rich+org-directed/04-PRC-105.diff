@@ -0,0 +1,45 @@
+from __future__ import annotations
+
+from decimal import Decimal
+
+from parcelo import audit, clock, ids
+from parcelo.errors import DomainError
+from parcelo.models import Refund
+from parcelo.money import Money
+from parcelo.store import db
+
+
+def create_refund(invoice_id: str, amount: Money | Decimal | float | int | str) -> Refund:
+    """Record a refund against a paid invoice.
+
+    Args:
+        invoice_id: Id of the invoice being refunded. It must exist and be paid.
+        amount: Refund amount in dollars (Money, Decimal, float, int or str).
+            Must be greater than zero.
+
+    Returns:
+        The stored Refund, with its amount as Money.
+
+    Raises:
+        DomainError: E_NOT_FOUND if the invoice does not exist, E_BAD_STATE if
+            it is not paid, or E_BAD_INPUT if the amount is not positive.
+    """
+    if invoice_id not in db.invoices:
+        raise DomainError("E_NOT_FOUND", invoice_id)
+    invoice = db.invoices[invoice_id]
+    if invoice.status != "paid":
+        raise DomainError("E_BAD_STATE", f"invoice {invoice_id} is {invoice.status}")
+
+    money = Money.parse(amount)
+    if money.cents <= 0:
+        raise DomainError("E_BAD_INPUT", f"refund amount must be positive, got {money}")
+
+    refund = Refund(
+        id=ids.new_id("rfd"),
+        invoice_id=invoice_id,
+        amount=money,
+        created_at=clock.now(),
+    )
+    db.refunds[refund.id] = refund
+    audit.record("refund.created", refund.id, invoice_id=invoice_id, cents=money.cents)
+    return refund
