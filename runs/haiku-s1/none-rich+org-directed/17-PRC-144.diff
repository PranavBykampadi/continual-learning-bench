+@pytest.mark.parametrize(
+    "zone, expected_cents",
+    [("local", 200), ("national", 600), ("international", 1150)],
+)
+def test_insurance_fee_by_zone(zone, expected_cents):
+    assert rates.insurance_fee(100, zone) == Money(expected_cents)
+
+
+def test_insurance_fee_accepts_string_and_money():
+    assert rates.insurance_fee("100.00", "national") == Money(600)
+    assert rates.insurance_fee(Money(10000), "national") == Money(600)
+
+
+def test_insurance_fee_rounds_half_up():
+    # 2% of 100.25 is 2.005, rounds up to 2.01
+    assert rates.insurance_fee(100.25, "local") == Money(201)
