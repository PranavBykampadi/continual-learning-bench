+def insurance_fee(declared_value: Union[Money, float, int, str, Decimal], zone: str) -> Money:
+    """Return the insurance fee for a shipment's declared value.
+
+    The fee is 2% of the declared value plus the zone's fuel surcharge
+    percentage of the declared value, rounded half up to the cent, with a
+    minimum fee of 1.00.
+
+    Args:
+        declared_value: Declared value in dollars. Floats, ints, strings,
+            Decimals and Money are accepted.
+        zone: One of "local", "national" or "international".
+
+    Returns:
+        The insurance fee as Money.
+
+    Raises:
+        DomainError: E_BAD_ZONE if the zone is unknown. E_BAD_INPUT if the
+            declared value is zero, negative or not a number.
+    """
+    if zone not in FUEL_SURCHARGE_PCT:
+        raise DomainError("E_BAD_ZONE", zone)
+    try:
+        value = Money.parse(declared_value)
+    except (ArithmeticError, TypeError, ValueError) as exc:
+        raise DomainError("E_BAD_INPUT", f"declared value: {declared_value}") from exc
+    if value.cents <= 0:
+        raise DomainError("E_BAD_INPUT", f"declared value must be positive: {declared_value}")
+    total_pct = INSURANCE_PCT + FUEL_SURCHARGE_PCT[zone]
+    fee = value.scale(total_pct / Decimal(100))
+    if fee < INSURANCE_MIN_FEE:
+        return INSURANCE_MIN_FEE
+    return fee
