@@ -0,0 +1,48 @@
+"""Claims filed by customers against delivered shipments."""
+from parcelo import audit, clock, ids
+from parcelo.errors import DomainError
+from parcelo.models import Claim
+from parcelo.money import Money
+from parcelo.shipments import get_shipment
+from parcelo.store import db
+
+DELIVERED = "delivered"
+
+
+def file_claim(shipment_id: str, amount, reason: str) -> Claim:
+    """File a claim against a delivered shipment.
+
+    Args:
+        shipment_id: Id of the shipment the claim is about.
+        amount: Amount claimed as a dollar value (float, int, str, Decimal or Money).
+        reason: Free-text reason for the claim.
+
+    Returns:
+        The stored Claim.
+
+    Raises:
+        DomainError: E_BAD_INPUT if the amount is invalid or not positive,
+            E_NOT_FOUND if the shipment does not exist, and E_BAD_STATE if the
+            shipment has not been delivered.
+    """
+    try:
+        money = Money.parse(amount)
+    except (ArithmeticError, TypeError, ValueError) as exc:
+        raise DomainError("E_BAD_INPUT", f"amount {amount!r}") from exc
+    if money.cents <= 0:
+        raise DomainError("E_BAD_INPUT", f"amount must be positive: {amount!r}")
+
+    shipment = get_shipment(shipment_id)
+    if shipment.status != DELIVERED:
+        raise DomainError("E_BAD_STATE", f"{shipment_id} is {shipment.status}")
+
+    claim = Claim(
+        id=ids.new_id("clm"),
+        shipment_id=shipment_id,
+        amount=money,
+        reason=reason,
+        filed_at=clock.now(),
+    )
+    db.claims[claim.id] = claim
+    audit.record("claim.filed", claim.id, shipment_id=shipment_id, cents=money.cents)
+    return claim
