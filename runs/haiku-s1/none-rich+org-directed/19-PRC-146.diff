+def write_off(invoice_id: str) -> float:
+    """Write off an open invoice that will never be collected.
+
+    Args:
+        invoice_id: ID of the invoice to write off.
+
+    Returns:
+        The amount that was written off.
+
+    Raises:
+        KeyError: If no invoice has the given ID.
+        ValueError: If the invoice is not open.
+    """
+    if invoice_id not in db.invoices:
+        raise KeyError(invoice_id)
+    invoice = db.invoices[invoice_id]
+    if invoice.status != "open":
+        raise ValueError(f"cannot write off invoice in status {invoice.status!r}")
+    invoice.status = "written_off"
+    invoice.written_off_at = clock.now()
+    events.emit("invoice.written_off", invoice.id, amount=invoice.amount)
+    return invoice.amount
 
 
