+from parcelo.money import Money
+
 ZONE_BASE = {"local": 4.5, "national": 9.0, "international": 24.0}
 PER_KG = 1.25
+TIER_FACTOR = {"standard": 1.0, "gold": 0.9}
 
 
 def base_rate(zone):
@@ -12,3 +15,23 @@
     if weight_kg <= 0:
         raise ValueError("weight must be positive")
     return round(base_rate(zone) + PER_KG * weight_kg, 2)
+
+
+def discounted_quote(weight_kg: float, zone: str, tier: str) -> Money:
+    """Return the shipping quote with the tier discount applied.
+
+    Args:
+        weight_kg: Parcel weight in kilograms. Must be positive.
+        zone: One of the known zones (see ZONE_BASE).
+        tier: "standard" (no discount) or "gold" (10% off).
+
+    Returns:
+        The discounted quote as Money, rounded half up to the cent.
+
+    Raises:
+        ValueError: If the zone, tier or weight is invalid.
+    """
+    if tier not in TIER_FACTOR:
+        raise ValueError("unknown tier: %s" % tier)
+    regular = Money.parse(quote(weight_kg, zone))
+    return regular.scale(TIER_FACTOR[tier])
