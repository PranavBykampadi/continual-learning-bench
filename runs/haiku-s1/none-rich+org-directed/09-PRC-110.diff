+
+
+def test_discounted_quote_standard_is_regular_quote():
+    assert rates.discounted_quote(2, "local", "standard").cents == 700
+
+
+def test_discounted_quote_gold_takes_10_percent_off():
+    # 7.00 * 0.9 = 6.30
+    assert rates.discounted_quote(2, "local", "gold").cents == 630
+
+
+def test_discounted_quote_gold_rounds_half_up():
+    # local, 1 kg: 5.75 * 0.9 = 5.175 -> 5.18 (half up, not banker's rounding)
+    assert rates.discounted_quote(1, "local", "gold").cents == 518
+
+
+def test_discounted_quote_unknown_zone():
+    with pytest.raises(ValueError):
+        rates.discounted_quote(2, "moon", "gold")
+
+
+def test_discounted_quote_unknown_tier():
+    with pytest.raises(ValueError):
