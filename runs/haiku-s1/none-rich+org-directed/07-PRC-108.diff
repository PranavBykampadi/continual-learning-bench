+from parcelo.money import Money
 from parcelo.store import db
+
+
+def outstanding_by_customer():
+    """Return the total open (unpaid, non-void) invoice amount per customer.
+
+    Amounts are summed as integer-cent `Money` values. Invoice amounts are
+    still stored as floats, so each one is wrapped with `Money.parse` on read.
+
+    Returns:
+        dict[str, Money]: Maps customer id to the sum of that customer's open
+        invoices. Customers with no open invoices are not included.
+    """
+    totals = {}
+    for invoice in db.invoices.values():
+        if invoice.status != "open":
+            continue
+        customer_id = db.shipments[invoice.shipment_id].customer_id
+        amount = Money.parse(invoice.amount)
+        totals[customer_id] = totals.get(customer_id, Money.zero()) + amount
+    return totals
 
 
