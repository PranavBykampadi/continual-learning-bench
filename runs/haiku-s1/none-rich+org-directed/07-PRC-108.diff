@@ -0,0 +1,30 @@
+from parcelo import reports
+from parcelo.models import Invoice, Shipment
+from parcelo.money import Money
+from parcelo.store import db
+
+
+def _invoice(inv_id, shipment_id, amount, status="open"):
+    db.invoices[inv_id] = Invoice(id=inv_id, shipment_id=shipment_id, amount=amount, status=status)
+
+
+def test_outstanding_by_customer_sums_open_invoices_only():
+    db.shipments["S1"] = Shipment(id="S1", customer_id="C1", weight_kg=1, zone="local")
+    db.shipments["S2"] = Shipment(id="S2", customer_id="C1", weight_kg=1, zone="local")
+    db.shipments["S3"] = Shipment(id="S3", customer_id="C2", weight_kg=1, zone="local")
+    _invoice("I1", "S1", 0.1)
+    _invoice("I2", "S1", 0.2)
+    _invoice("I3", "S2", 9.0, status="paid")
+    _invoice("I4", "S2", 4.0, status="void")
+    _invoice("I5", "S3", 3.5)
+
+    result = reports.outstanding_by_customer()
+
+    assert result == {"C1": Money(30), "C2": Money(350)}
+
+
+def test_outstanding_by_customer_empty_when_nothing_open():
+    db.shipments["S1"] = Shipment(id="S1", customer_id="C1", weight_kg=1, zone="local")
+    _invoice("I1", "S1", 5.0, status="paid")
+
+    assert reports.outstanding_by_customer() == {}
