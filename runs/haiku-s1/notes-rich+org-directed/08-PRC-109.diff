+++ b/tests/unit/test_addresses.py	2026-11-10 14:17:43
@@ -0,0 +1,49 @@
+import pytest
+
+from parcelo import audit, customers
+from parcelo.errors import DomainError
+from parcelo.models import Address
+from parcelo.store import db
+
+
+def test_add_address_stores_and_returns():
+    c = customers.add_customer("Acme")
+    a = customers.add_address(c.id, "12 High St", "Leeds")
+    assert isinstance(a, Address)
+    assert a.id.startswith("addr_")
+    assert a.customer_id == c.id
+    assert a.line == "12 High St"
+    assert a.city == "Leeds"
+    assert db.addresses[a.id] is a
+
+
+def test_add_address_records_audit():
+    c = customers.add_customer("Acme")
+    a = customers.add_address(c.id, "12 High St", "Leeds")
+    assert audit.LOG[-1]["action"] == "address.created"
+    assert audit.LOG[-1]["entity_id"] == a.id
+
+
+def test_unknown_customer():
+    with pytest.raises(DomainError) as err:
+        customers.add_address("nope", "12 High St", "Leeds")
+    assert err.value.code == "E_UNKNOWN_CUSTOMER"
+    assert db.addresses == {}
+
+
+@pytest.mark.parametrize("line", ["", "   "])
+def test_empty_line(line):
+    c = customers.add_customer("Acme")
+    with pytest.raises(DomainError) as err:
+        customers.add_address(c.id, line, "Leeds")
+    assert err.value.code == "E_BAD_INPUT"
+    assert db.addresses == {}
+
+
+@pytest.mark.parametrize("city", ["", "  "])
+def test_empty_city(city):
+    c = customers.add_customer("Acme")
+    with pytest.raises(DomainError) as err:
+        customers.add_address(c.id, "12 High St", city)
+    assert err.value.code == "E_BAD_INPUT"
+    assert db.addresses == {}
