+def split_shipment(shipment_id, weights):
+    """Split a created shipment into one new shipment per weight.
+
+    The original shipment is kept with status "split". Each new shipment has the
+    same customer and zone as the original.
+
+    Args:
+        shipment_id: Id of the shipment to split.
+        weights: Iterable of weights in kg, one per new shipment.
+
+    Returns:
+        list[Shipment]: The new shipments, in the same order as ``weights``.
+
+    Raises:
+        DomainError: E_NOT_FOUND if the shipment does not exist, E_BAD_STATE if it is
+            not in status "created", E_BAD_INPUT if no weights are given, and
+            E_BAD_WEIGHT if any weight is not positive or the weights do not add up
+            to the original weight. Nothing is changed when an error is raised.
+    """
+    shipment = get_shipment(shipment_id)
+    if shipment.status != "created":
+        raise DomainError("E_BAD_STATE", shipment.status)
+
+    weights = list(weights)
+    if not weights:
+        raise DomainError("E_BAD_INPUT", "weights must not be empty")
+    for weight in weights:
+        if weight <= 0:
+            raise DomainError("E_BAD_WEIGHT", str(weight))
+    # Compare via Decimal(str(...)) so float rounding in the inputs does not reject a valid split.
+    if sum(Decimal(str(w)) for w in weights) != Decimal(str(shipment.weight_kg)):
+        raise DomainError("E_BAD_WEIGHT", f"weights do not sum to {shipment.weight_kg}")
+
+    new_shipments = [
+        create_shipment(shipment.customer_id, weight, shipment.zone) for weight in weights
+    ]
+    shipment.status = "split"
+    events.emit("shipment.split", shipment.id, into=[s.id for s in new_shipments])
+    return new_shipments
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_split_shipment.py b/tests/unit/test_split_shipment.py
--- a/tests/unit/test_split_shipment.py	1969-12-31 19:00:00
+++ b/tests/unit/test_split_shipment.py	2026-11-10 14:42:35
@@ -0,0 +1,75 @@
+import pytest
+
+from parcelo import customers, events, shipments
+from parcelo.errors import DomainError
+from parcelo.store import db
+
+
+def _created(weight=10.0, zone="national"):
+    c = customers.add_customer("Acme")
+    return shipments.create_shipment(c.id, weight, zone)
+
+
+def test_split_creates_one_shipment_per_weight_in_order():
+    s = _created(10.0, "national")
+    new = shipments.split_shipment(s.id, [4.0, 6.0])
+    assert [n.weight_kg for n in new] == [4.0, 6.0]
+    assert all(n.id.startswith("shp_") for n in new)
+    assert all(n.customer_id == s.customer_id and n.zone == "national" for n in new)
+    assert all(n.status == "created" for n in new)
+    assert db.shipments[s.id].status == "split"
+
+
+def test_split_emits_events():
+    s = _created(10.0)
+    new = shipments.split_shipment(s.id, [5.0, 5.0])
+    assert events.OUTBOX[-1]["name"] == "shipment.split"
+    assert events.OUTBOX[-1]["entity_id"] == s.id
+    assert events.OUTBOX[-1]["payload"]["into"] == [n.id for n in new]
+
+
+def test_split_handles_float_weights_that_sum_exactly_in_decimal():
+    s = _created(3.3)
+    new = shipments.split_shipment(s.id, [1.1, 2.2])
+    assert len(new) == 2
+
+
+def test_split_unknown_shipment():
+    with pytest.raises(DomainError) as err:
+        shipments.split_shipment("shp_999999", [1.0])
+    assert err.value.code == "E_NOT_FOUND"
+
+
+@pytest.mark.parametrize("status", ["split", "delivered", "cancelled"])
+def test_split_requires_created_status(status):
+    s = _created(10.0)
+    s.status = status
+    before = len(db.shipments)
+    with pytest.raises(DomainError) as err:
+        shipments.split_shipment(s.id, [5.0, 5.0])
+    assert err.value.code == "E_BAD_STATE"
+    assert len(db.shipments) == before
+    assert s.status == status
+
+
+@pytest.mark.parametrize("weights", [[4.0, 5.0], [6.0, 6.0], [10.0, 1.0]])
+def test_split_weights_must_sum_to_original(weights):
+    s = _created(10.0)
+    before = len(db.shipments)
+    with pytest.raises(DomainError) as err:
+        shipments.split_shipment(s.id, weights)
+    assert err.value.code == "E_BAD_WEIGHT"
+    assert len(db.shipments) == before
+    assert db.shipments[s.id].status == "created"
+    assert all(e["name"] != "shipment.split" for e in events.OUTBOX)
+
+
+@pytest.mark.parametrize("weights", [[], [0.0, 10.0], [-5.0, 15.0]])
+def test_split_rejects_empty_or_non_positive_weights(weights):
+    s = _created(10.0)
+    before = len(db.shipments)
+    with pytest.raises(DomainError) as err:
+        shipments.split_shipment(s.id, weights)
+    assert err.value.code in {"E_BAD_INPUT", "E_BAD_WEIGHT"}
+    assert len(db.shipments) == before
+    assert db.shipments[s.id].status == "created"
