+def insurance_fee(declared_value, zone) -> Money:
+    """Return the insurance fee for a shipment's declared value.
+
+    The fee is 2% of the declared value plus the zone's fuel surcharge
+    percentage of the declared value, with a minimum fee of 1.00.
+
+    Args:
+        declared_value: Declared value in dollars (float, int, str or Decimal).
+        zone: Shipping zone; must be a known zone.
+
+    Returns:
+        The insurance fee as Money.
+
+    Raises:
+        DomainError: E_BAD_ZONE for an unknown zone, E_BAD_INPUT for a
+            declared value that is zero or negative.
+    """
+    if zone not in FUEL_SURCHARGE_PCT:
+        raise DomainError("E_BAD_ZONE", zone)
+    value = Money.parse(declared_value)
+    if value.cents <= 0:
+        raise DomainError("E_BAD_INPUT", f"declared value must be positive: {declared_value}")
+    pct = INSURANCE_RATE + FUEL_SURCHARGE_PCT[zone] / Decimal(100)
+    fee = value.scale(pct)
+    if fee < INSURANCE_MIN:
+        return INSURANCE_MIN
+    return fee
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_insurance_fee.py b/tests/unit/test_insurance_fee.py
--- a/tests/unit/test_insurance_fee.py	1969-12-31 19:00:00
+++ b/tests/unit/test_insurance_fee.py	2026-11-10 14:26:26
@@ -0,0 +1,42 @@
+import pytest
+
+from parcelo.errors import DomainError
+from parcelo.money import Money
+from parcelo.rates import insurance_fee
+
+
+def test_local_fee_is_two_percent():
+    assert insurance_fee(100, "local") == Money(200)
+
+
+def test_national_adds_fuel_surcharge():
+    assert insurance_fee(100, "national") == Money(600)
+
+
+def test_international_adds_fuel_surcharge():
+    assert insurance_fee(100, "international") == Money(1150)
+
+
+def test_minimum_fee_applies():
+    assert insurance_fee(10, "local") == Money(100)
+
+
+def test_returns_money():
+    assert isinstance(insurance_fee(50, "national"), Money)
+
+
+def test_accepts_float_input():
+    assert insurance_fee(99.99, "local") == Money(200)
+
+
+def test_unknown_zone_fails():
+    with pytest.raises(DomainError) as err:
+        insurance_fee(100, "moon")
+    assert err.value.code == "E_BAD_ZONE"
+
+
+@pytest.mark.parametrize("value", [0, -5, -0.01])
+def test_non_positive_value_fails(value):
+    with pytest.raises(DomainError) as err:
+        insurance_fee(value, "local")
+    assert err.value.code == "E_BAD_INPUT"
