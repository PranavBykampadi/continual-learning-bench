 ZONE_BASE = {"local": 4.5, "national": 9.0, "international": 24.0}
 PER_KG = 1.25
 
+INSURANCE_RATE = Decimal("0.02")
+INSURANCE_MIN = Money(100)
+# Fuel surcharge percentages per zone (same values as the legacy fuel_surcharge).
+FUEL_SURCHARGE_PCT = {
+    "local": Decimal("0.0"),
+    "national": Decimal("4.0"),
+    "international": Decimal("9.5"),
