diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_void_invoice.py b/tests/unit/test_void_invoice.py
--- a/tests/unit/test_void_invoice.py	1969-12-31 19:00:00
+++ b/tests/unit/test_void_invoice.py	2026-11-10 14:10:05
@@ -0,0 +1,54 @@
+from datetime import datetime, timezone
+
+import pytest
+
+from parcelo import audit, clock, customers, invoices, shipments
+from parcelo.errors import DomainError
+
+FIXED_NOW = datetime(2026, 11, 10, 12, 0, 0, tzinfo=timezone.utc)
+
+
+def _new_invoice():
+    customer = customers.add_customer("Acme")
+    shipment = shipments.create_shipment(customer.id, 2, "local")
+    return invoices.issue_invoice(shipment.id)
+
+
+def test_void_invoice_not_found():
+    with pytest.raises(DomainError) as exc:
+        invoices.void_invoice("INV-missing")
+    assert exc.value.code == "E_NOT_FOUND"
+
+
+def test_void_invoice_already_paid():
+    inv = _new_invoice()
+    invoices.mark_paid(inv.id)
+    with pytest.raises(DomainError) as exc:
+        invoices.void_invoice(inv.id)
+    assert exc.value.code == "E_BAD_STATE"
+    assert inv.status == "paid"
+    assert inv.voided_at is None
+
+
+def test_void_invoice_already_void():
+    inv = _new_invoice()
+    invoices.void_invoice(inv.id)
+    with pytest.raises(DomainError) as exc:
+        invoices.void_invoice(inv.id)
+    assert exc.value.code == "E_BAD_STATE"
+    assert inv.status == "void"
+
+
+def test_void_invoice_happy_path():
+    inv = _new_invoice()
+    clock.set_fixed(FIXED_NOW)
+    try:
+        result = invoices.void_invoice(inv.id)
+    finally:
+        clock.clear_fixed()
+
+    assert result is inv
+    assert result.status == "void"
+    assert result.voided_at == FIXED_NOW
+    assert audit.LOG[-1]["action"] == "invoice.voided"
+    assert audit.LOG[-1]["entity_id"] == inv.id
