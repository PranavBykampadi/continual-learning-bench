     if shipment_id not in db.shipments:
         raise DomainError("E_NOT_FOUND", shipment_id)
     return db.shipments[shipment_id]
+
+
+def reassign_shipment(shipment_id, new_customer_id):
+    shipment = get_shipment(shipment_id)
+    if shipment.status == "delivered":
+        raise DomainError("E_BAD_STATE", f"{shipment_id} is {shipment.status}")
+    if new_customer_id not in db.customers:
+        raise DomainError("E_UNKNOWN_CUSTOMER", new_customer_id)
+    old_customer_id = shipment.customer_id
+    shipment.customer_id = new_customer_id
+    events.emit(
+        "shipment.reassigned",
+        shipment.id,
+        from_customer_id=old_customer_id,
+        to_customer_id=new_customer_id,
+    )
+    return shipment
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_reassign_shipment.py b/tests/unit/test_reassign_shipment.py
--- a/tests/unit/test_reassign_shipment.py	1969-12-31 19:00:00
+++ b/tests/unit/test_reassign_shipment.py	2026-11-10 14:23:25
@@ -0,0 +1,65 @@
+import pytest
+
+from parcelo import customers, events, shipments
+from parcelo.errors import DomainError
+from parcelo.store import db
+
+
+def test_reassign_changes_customer_and_returns_shipment():
+    old = customers.add_customer("Acme")
+    new = customers.add_customer("Globex")
+    s = shipments.create_shipment(old.id, 2, "local")
+
+    result = shipments.reassign_shipment(s.id, new.id)
+
+    assert result is s
+    assert db.shipments[s.id].customer_id == new.id
+
+
+def test_reassign_emits_event():
+    old = customers.add_customer("Acme")
+    new = customers.add_customer("Globex")
+    s = shipments.create_shipment(old.id, 2, "local")
+
+    shipments.reassign_shipment(s.id, new.id)
+
+    event = events.OUTBOX[-1]
+    assert event["name"] == "shipment.reassigned"
+    assert event["entity_id"] == s.id
+    assert event["payload"] == {"from_customer_id": old.id, "to_customer_id": new.id}
+
+
+def test_reassign_unknown_shipment():
+    new = customers.add_customer("Globex")
+    with pytest.raises(DomainError) as err:
+        shipments.reassign_shipment("shp_missing", new.id)
+    assert err.value.code == "E_NOT_FOUND"
+
+
+def test_reassign_unknown_customer_leaves_shipment_unchanged():
+    old = customers.add_customer("Acme")
+    s = shipments.create_shipment(old.id, 2, "local")
+    count = len(events.OUTBOX)
+
+    with pytest.raises(DomainError) as err:
+        shipments.reassign_shipment(s.id, "C_nope")
+
+    assert err.value.code == "E_UNKNOWN_CUSTOMER"
+    assert db.shipments[s.id].customer_id == old.id
+    assert len(events.OUTBOX) == count
+
+
+def test_reassign_delivered_shipment_fails():
+    old = customers.add_customer("Acme")
+    new = customers.add_customer("Globex")
+    s = shipments.create_shipment(old.id, 2, "local")
+    db.shipments[s.id].status = "delivered"
+    count = len(events.OUTBOX)
+
+    with pytest.raises(DomainError) as err:
+        shipments.reassign_shipment(s.id, new.id)
+
+    assert err.value.code == "E_BAD_STATE"
+    assert err.value.message == f"{s.id} is delivered"
+    assert db.shipments[s.id].customer_id == old.id
+    assert len(events.OUTBOX) == count
