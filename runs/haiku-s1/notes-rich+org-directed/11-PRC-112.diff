--- a/parcelo/claims.py	1969-12-31 19:00:00
+++ b/parcelo/claims.py	2026-11-10 14:20:22
@@ -0,0 +1,44 @@
+"""Customer claims against delivered shipments."""
+
+from parcelo import audit, clock, ids
+from parcelo.errors import DomainError
+from parcelo.models import Claim
+from parcelo.money import Money
+from parcelo.shipments import get_shipment
+from parcelo.store import db
+
+
+def file_claim(shipment_id: str, amount, reason: str) -> Claim:
+    """File a claim for money back on a delivered shipment.
+
+    Args:
+        shipment_id: Id of the shipment being claimed against.
+        amount: Positive amount to claim, as a dollar value (float, int, str or Decimal).
+        reason: Why the customer is filing the claim.
+
+    Returns:
+        The stored Claim, with ``amount`` as a Money value.
+
+    Raises:
+        DomainError: E_NOT_FOUND if the shipment does not exist, E_BAD_INPUT if the
+            amount is not a positive number, E_BAD_STATE if the shipment is not delivered.
+    """
+    shipment = get_shipment(shipment_id)
+    try:
+        money = Money.parse(amount)
+    except (ArithmeticError, TypeError, ValueError):
+        raise DomainError("E_BAD_INPUT", str(amount)) from None
+    if money.cents <= 0:
+        raise DomainError("E_BAD_INPUT", str(amount))
+    if shipment.status != "delivered":
+        raise DomainError("E_BAD_STATE", f"{shipment_id} is {shipment.status}")
+    claim = Claim(
+        id=ids.new_id("clm"),
+        shipment_id=shipment_id,
+        amount=money,
+        reason=reason,
+        filed_at=clock.now(),
+    )
+    db.claims[claim.id] = claim
+    audit.record("claim.filed", claim.id, shipment_id=shipment_id)
+    return claim
