diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_claims.py b/tests/unit/test_claims.py
--- a/tests/unit/test_claims.py	1969-12-31 19:00:00
+++ b/tests/unit/test_claims.py	2026-11-10 14:20:27
@@ -0,0 +1,78 @@
+from datetime import datetime, timezone
+
+import pytest
+
+from parcelo import audit, claims, clock, customers, shipments, store
+from parcelo.errors import DomainError
+from parcelo.money import Money
+
+
+def _delivered_shipment():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 2.0, "national")
+    s.status = "delivered"
+    return s
+
+
+def test_file_claim_on_delivered_shipment():
+    s = _delivered_shipment()
+    claim = claims.file_claim(s.id, "12.50", "box arrived crushed")
+    assert claim.id.startswith("clm_")
+    assert claim.shipment_id == s.id
+    assert claim.amount == Money(1250)
+    assert claim.reason == "box arrived crushed"
+    assert store.db.claims[claim.id] is claim
+    assert audit.LOG[-1]["action"] == "claim.filed"
+    assert audit.LOG[-1]["entity_id"] == claim.id
+
+
+def test_filed_at_uses_clock():
+    s = _delivered_shipment()
+    moment = datetime(2026, 3, 1, 12, 0, tzinfo=timezone.utc)
+    clock.set_fixed(moment)
+    claim = claims.file_claim(s.id, 5, "late")
+    assert claim.filed_at == moment
+
+
+def test_amount_is_money_for_each_input_type():
+    from decimal import Decimal
+
+    s = _delivered_shipment()
+    for value in (3, 3.0, "3.00", Decimal("3")):
+        assert claims.file_claim(s.id, value, "x").amount == Money(300)
+
+
+def test_unknown_shipment_is_not_found():
+    with pytest.raises(DomainError) as err:
+        claims.file_claim("shp_missing", 5, "x")
+    assert err.value.code == "E_NOT_FOUND"
+    assert audit.LOG == []
+
+
+def test_shipment_not_delivered_is_bad_state():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 1.0, "local")
+    with pytest.raises(DomainError) as err:
+        claims.file_claim(s.id, 5, "x")
+    assert err.value.code == "E_BAD_STATE"
+    assert err.value.message == f"{s.id} is created"
+    assert store.db.claims == {}
+    assert audit.LOG[-1]["action"] == "shipment.created"
+
+
+@pytest.mark.parametrize("amount", [0, -1, "0", "-2.50", 0.0])
+def test_non_positive_amount_is_rejected(amount):
+    s = _delivered_shipment()
+    with pytest.raises(DomainError) as err:
+        claims.file_claim(s.id, amount, "x")
+    assert err.value.code == "E_BAD_INPUT"
+    assert store.db.claims == {}
+
+
+@pytest.mark.parametrize("amount", ["abc", None, "NaN"])
+def test_unparseable_amount_is_rejected(amount):
+    s = _delivered_shipment()
+    with pytest.raises(DomainError) as err:
+        claims.file_claim(s.id, amount, "x")
+    assert err.value.code == "E_BAD_INPUT"
+    assert store.db.claims == {}
