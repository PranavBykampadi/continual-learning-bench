diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_refunds.py b/tests/unit/test_refunds.py
--- a/tests/unit/test_refunds.py	1969-12-31 19:00:00
+++ b/tests/unit/test_refunds.py	2026-11-10 14:13:05
@@ -0,0 +1,68 @@
+from datetime import datetime, timezone
+
+import pytest
+
+from parcelo import audit, clock, customers, invoices, refunds, shipments
+from parcelo.errors import DomainError
+from parcelo.models import Refund
+from parcelo.money import Money
+from parcelo.store import db
+
+FIXED_NOW = datetime(2026, 11, 10, 12, 0, tzinfo=timezone.utc)
+
+
+def _new_open_invoice():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 1.5, "national")
+    return invoices.issue_invoice(s.id)
+
+
+def _new_paid_invoice():
+    inv = _new_open_invoice()
+    return invoices.mark_paid(inv.id)
+
+
+def test_create_refund_happy_path():
+    inv = _new_paid_invoice()
+    audit.LOG.clear()
+    clock.set_fixed(FIXED_NOW)
+    try:
+        r = refunds.create_refund(inv.id, "12.50")
+    finally:
+        clock.clear_fixed()
+
+    assert isinstance(r, Refund)
+    assert r.id.startswith("ref_")
+    assert r.invoice_id == inv.id
+    assert r.amount == Money(1250)
+    assert r.created_at == FIXED_NOW
+    assert db.refunds[r.id] is r
+    assert len(audit.LOG) == 1
+    assert audit.LOG[-1]["action"] == "refund.created"
+    assert audit.LOG[-1]["entity_id"] == r.id
+
+
+def test_create_refund_converts_float_amount_to_money():
+    inv = _new_paid_invoice()
+    r = refunds.create_refund(inv.id, 5.0)
+    assert r.amount == Money(500)
+
+
+def test_refund_unknown_invoice():
+    audit.LOG.clear()
+    with pytest.raises(DomainError) as err:
+        refunds.create_refund("INV-missing", "10.00")
+    assert err.value.code == "E_NOT_FOUND"
+    assert db.refunds == {}
+    assert audit.LOG == []
+
+
+def test_refund_unpaid_invoice_is_rejected():
+    inv = _new_open_invoice()
+    audit.LOG.clear()
+    with pytest.raises(DomainError) as err:
+        refunds.create_refund(inv.id, "10.00")
+    assert err.value.code == "E_BAD_STATE"
+    assert db.refunds == {}
+    assert audit.LOG == []
+    assert db.invoices[inv.id].status == "open"
