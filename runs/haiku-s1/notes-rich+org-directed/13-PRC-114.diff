diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_reports_aging.py b/tests/unit/test_reports_aging.py
--- a/tests/unit/test_reports_aging.py	1969-12-31 19:00:00
+++ b/tests/unit/test_reports_aging.py	2026-11-10 14:22:33
@@ -0,0 +1,56 @@
+from datetime import datetime, timedelta, timezone
+
+from parcelo import clock, customers, invoices, reports, shipments
+from parcelo.money import Money
+
+NOW = datetime(2026, 11, 10, 12, 0, tzinfo=timezone.utc)
+
+
+def _open_invoice(age_days, amount=10.0):
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 1, "local")
+    inv = invoices.issue_invoice(s.id)
+    inv.amount = amount
+    # issue_invoice stores naive UTC; mirror that here.
+    inv.issued_at = (NOW - timedelta(days=age_days)).replace(tzinfo=None)
+    return inv
+
+
+def test_empty_buckets_are_zero():
+    clock.set_fixed(NOW)
+    assert reports.aging_report() == {
+        "0-30": Money.zero(),
+        "31-60": Money.zero(),
+        "60+": Money.zero(),
+    }
+
+
+def test_bucket_edges():
+    clock.set_fixed(NOW)
+    _open_invoice(0, 1.0)
+    _open_invoice(30, 2.0)
+    _open_invoice(31, 4.0)
+    _open_invoice(60, 8.0)
+    _open_invoice(61, 16.0)
+    report = reports.aging_report()
+    assert report["0-30"] == Money.parse(3.0)
+    assert report["31-60"] == Money.parse(12.0)
+    assert report["60+"] == Money.parse(16.0)
+
+
+def test_paid_and_void_are_excluded():
+    clock.set_fixed(NOW)
+    paid = _open_invoice(5, 50.0)
+    invoices.mark_paid(paid.id)
+    voided = _open_invoice(5, 70.0)
+    voided.status = "void"
+    _open_invoice(5, 3.0)
+    assert reports.aging_report()["0-30"] == Money.parse(3.0)
+
+
+def test_days_use_whole_days_from_naive_utc_issue_time():
+    clock.set_fixed(NOW)
+    # 30 days and 23 hours old: still whole-day age 30.
+    inv = _open_invoice(0, 5.0)
+    inv.issued_at = (NOW - timedelta(days=30, hours=23)).replace(tzinfo=None)
+    assert reports.aging_report()["0-30"] == Money.parse(5.0)
