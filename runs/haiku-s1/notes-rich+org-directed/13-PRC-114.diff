-from datetime import datetime
+from datetime import datetime, timezone
 
+from parcelo import clock
+from parcelo.legacy.billing import days_between
+from parcelo.money import Money
 from parcelo.store import db
+
+
+def aging_report() -> dict[str, Money]:
+    """Total the open invoices by age in whole days since issue.
+
+    Age is measured against `clock.now()`. Paid and void invoices are left out.
+
+    Returns:
+        A dict with keys "0-30", "31-60" and "60+", each mapped to the Money
+        total of open invoices in that bucket. Empty buckets are Money.zero().
+    """
+    now = clock.now()
+    buckets = {"0-30": Money.zero(), "31-60": Money.zero(), "60+": Money.zero()}
+    for invoice in db.invoices.values():
+        if invoice.status != "open":
+            continue
+        issued = invoice.issued_at
+        if issued.tzinfo is None:
+            # issue_invoice stores naive UTC; make it aware before subtracting.
+            issued = issued.replace(tzinfo=timezone.utc)
+        age = days_between(issued, now)
+        if age <= 30:
+            key = "0-30"
+        elif age <= 60:
+            key = "31-60"
+        else:
+            key = "60+"
+        buckets[key] = buckets[key] + Money.parse(invoice.amount)
+    return buckets
 
 
