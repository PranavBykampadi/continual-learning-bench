@@ -0,0 +1,78 @@
+import pytest
+
+from parcelo import audit, customers, invoices, reports, shipments
+from parcelo.errors import DomainError
+from parcelo.money import Money
+
+
+def _open_invoice():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 2, "local")
+    return c, invoices.issue_invoice(s.id)
+
+
+def test_apply_credit_reduces_open_invoice():
+    _, inv = _open_invoice()
+    assert inv.amount == 7.0
+    remaining = invoices.apply_credit(inv.id, 2.5)
+    assert isinstance(remaining, Money)
+    assert remaining == Money.parse("4.5")
+    assert inv.amount == 4.5
+    assert inv.status == "open"
+
+
+def test_apply_credit_records_audit():
+    _, inv = _open_invoice()
+    invoices.apply_credit(inv.id, "1.25")
+    assert audit.LOG[-1]["action"] == "invoice.credit_applied"
+    assert audit.LOG[-1]["entity_id"] == inv.id
+
+
+def test_credit_equal_to_amount_leaves_zero():
+    _, inv = _open_invoice()
+    assert invoices.apply_credit(inv.id, 7).cents == 0
+    assert inv.amount == 0.0
+
+
+def test_missing_invoice_fails():
+    with pytest.raises(DomainError) as err:
+        invoices.apply_credit("INV-nope", 1)
+    assert err.value.code == "E_NOT_FOUND"
+    assert err.value.message == "INV-nope"
+
+
+@pytest.mark.parametrize("status", ["paid", "void"])
+def test_non_open_invoice_fails(status):
+    _, inv = _open_invoice()
+    inv.status = status
+    with pytest.raises(DomainError) as err:
+        invoices.apply_credit(inv.id, 1)
+    assert err.value.code == "E_BAD_STATE"
+    assert err.value.message == f"{inv.id} is {status}"
+    assert inv.amount == 7.0
+
+
+def test_credit_larger_than_amount_fails():
+    _, inv = _open_invoice()
+    with pytest.raises(DomainError) as err:
+        invoices.apply_credit(inv.id, 7.01)
+    assert err.value.code == "E_BAD_INPUT"
+    assert inv.amount == 7.0
+    assert audit.LOG == []
+
+
+@pytest.mark.parametrize("bad", [0, -1, "-0.50"])
+def test_non_positive_credit_fails(bad):
+    _, inv = _open_invoice()
+    with pytest.raises(DomainError) as err:
+        invoices.apply_credit(inv.id, bad)
+    assert err.value.code == "E_BAD_INPUT"
+    assert inv.amount == 7.0
+
+
+def test_outstanding_balance_and_revenue_after_credit():
+    c, inv = _open_invoice()
+    invoices.apply_credit(inv.id, 2.5)
+    assert customers.outstanding_balance(c.id) == 4.5
+    invoices.mark_paid(inv.id)
+    assert reports.revenue_total() == 4.5
