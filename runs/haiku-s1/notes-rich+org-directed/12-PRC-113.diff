+def apply_credit(invoice_id, amount):
+    """Reduce an open invoice by a credit and return what is left to pay.
+
+    Invoice.amount is still a float (old code), so it is read through Money.parse
+    and written back as dollars so reports and outstanding_balance keep working.
+
+    Args:
+        invoice_id: id of the invoice to credit.
+        amount: credit in dollars (float, int, str or Decimal). Must be positive.
+
+    Returns:
+        Money: the invoice amount remaining after the credit.
+
+    Raises:
+        DomainError: E_NOT_FOUND if the invoice does not exist, E_BAD_STATE if it is
+            not open, E_BAD_INPUT if the credit is not positive or is larger than
+            the invoice amount.
+    """
+    try:
+        invoice = db.invoices[invoice_id]
+    except KeyError:
+        raise DomainError("E_NOT_FOUND", invoice_id) from None
+    if invoice.status != "open":
+        raise DomainError("E_BAD_STATE", f"{invoice_id} is {invoice.status}")
+    credit = Money.parse(amount)
+    if credit.cents <= 0:
+        raise DomainError("E_BAD_INPUT", f"credit must be positive, got {credit}")
+    current = Money.parse(invoice.amount)
+    if current < credit:
+        raise DomainError("E_BAD_INPUT", f"credit {credit} is more than invoice {current}")
+    remaining = current - credit
+    invoice.amount = remaining.cents / 100
+    audit.record("invoice.credit_applied", invoice_id, credit_cents=credit.cents)
+    return remaining
