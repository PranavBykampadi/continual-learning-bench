+class QuoteWithSurcharge(NamedTuple):
+    """A quote split into base price, fuel surcharge and total."""
+
+    quote: Money
+    surcharge: Money
+    total: Money
+
+
+def quote_with_surcharge(weight_kg: float, zone: str) -> QuoteWithSurcharge:
+    """Quote a shipment and add the fuel surcharge for its zone.
+
+    Args:
+        weight_kg: Shipment weight in kilograms. Must be greater than zero.
+        zone: One of "local", "national" or "international".
+
+    Returns:
+        A QuoteWithSurcharge with the base quote, the fuel surcharge and their sum.
+
+    Raises:
+        DomainError: E_BAD_ZONE if the zone is unknown, E_BAD_WEIGHT if the
+            weight is zero or negative.
+    """
+    if zone not in ZONE_BASE:
+        raise DomainError("E_BAD_ZONE", zone)
+    if weight_kg <= 0:
+        raise DomainError("E_BAD_WEIGHT", str(weight_kg))
+    base = Money.parse(quote(weight_kg, zone))
+    surcharge = base.scale(FUEL_SURCHARGE_PCT[zone] / 100)
+    return QuoteWithSurcharge(quote=base, surcharge=surcharge, total=base + surcharge)
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_quote_with_surcharge.py b/tests/unit/test_quote_with_surcharge.py
--- a/tests/unit/test_quote_with_surcharge.py	1969-12-31 19:00:00
+++ b/tests/unit/test_quote_with_surcharge.py	2026-11-10 14:10:56
@@ -0,0 +1,41 @@
+import pytest
+
+from parcelo import rates
+from parcelo.errors import DomainError
+from parcelo.money import Money
+
+
+def test_local_has_no_surcharge():
+    result = rates.quote_with_surcharge(2, "local")
+    assert result.quote == Money(700)
+    assert result.surcharge == Money(0)
+    assert result.total == Money(700)
+
+
+def test_national_adds_four_percent():
+    # base 9.0 + 1.25 * 2 = 11.50; 4% of 11.50 = 0.46
+    result = rates.quote_with_surcharge(2, "national")
+    assert result.quote == Money(1150)
+    assert result.surcharge == Money(46)
+    assert result.total == Money(1196)
+
+
+def test_international_adds_nine_point_five_percent():
+    # base 24.0 + 1.25 * 2 = 26.50; 9.5% of 26.50 = 2.5175 -> 2.52 (half up)
+    result = rates.quote_with_surcharge(2, "international")
+    assert result.quote == Money(2650)
+    assert result.surcharge == Money(252)
+    assert result.total == Money(2902)
+
+
+def test_unknown_zone_raises_bad_zone():
+    with pytest.raises(DomainError) as err:
+        rates.quote_with_surcharge(2, "moon")
+    assert err.value.code == "E_BAD_ZONE"
+
+
+@pytest.mark.parametrize("weight", [0, -1, -0.5])
+def test_non_positive_weight_raises_bad_weight(weight):
+    with pytest.raises(DomainError) as err:
+        rates.quote_with_surcharge(weight, "national")
+    assert err.value.code == "E_BAD_WEIGHT"
