diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_reports_volume.py b/tests/unit/test_reports_volume.py
--- a/tests/unit/test_reports_volume.py	1969-12-31 19:00:00
+++ b/tests/unit/test_reports_volume.py	2026-11-10 14:40:21
@@ -0,0 +1,35 @@
+from parcelo import customers, reports, shipments
+from parcelo.models import Shipment
+from parcelo.store import db
+
+
+def test_customer_with_no_shipments_is_included():
+    c = customers.add_customer("Acme")
+    report = reports.volume_report()
+    assert report == {c.id: {"shipments": 0, "tier": "starter"}}
+
+
+def test_counts_shipments_per_customer():
+    a = customers.add_customer("Acme")
+    b = customers.add_customer("Beta")
+    shipments.create_shipment(a.id, 1, "local")
+    shipments.create_shipment(a.id, 2, "national")
+    report = reports.volume_report()
+    assert report[a.id] == {"shipments": 2, "tier": "starter"}
+    assert report[b.id] == {"shipments": 0, "tier": "starter"}
+
+
+def test_tier_thresholds_match_legacy_volume_tier():
+    c = customers.add_customer("Bulk")
+    for n in range(50):
+        db.shipments[f"s{n}"] = Shipment(
+            id=f"s{n}", customer_id=c.id, weight_kg=1, zone="local"
+        )
+    assert reports.volume_report()[c.id] == {"shipments": 50, "tier": "bulk"}
+
+    for n in range(10, 50):
+        del db.shipments[f"s{n}"]
+    assert reports.volume_report()[c.id] == {"shipments": 10, "tier": "regular"}
+
+    del db.shipments["s9"]
+    assert reports.volume_report()[c.id] == {"shipments": 9, "tier": "starter"}
