diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_customers_upgrade_tier.py b/tests/unit/test_customers_upgrade_tier.py
--- a/tests/unit/test_customers_upgrade_tier.py	1969-12-31 19:00:00
+++ b/tests/unit/test_customers_upgrade_tier.py	2026-11-10 14:27:09
@@ -0,0 +1,32 @@
+import pytest
+
+from parcelo import customers
+from parcelo.errors import DomainError
+from parcelo.models import Customer
+from parcelo.store import db
+
+
+def test_upgrade_standard_to_gold_returns_customer():
+    c = customers.add_customer("Acme")
+    assert c.tier == "standard"
+    result = customers.upgrade_tier(c.id)
+    assert result is c
+    assert result.tier == "gold"
+    assert db.customers[c.id].tier == "gold"
+
+
+def test_upgrade_unknown_customer_fails():
+    with pytest.raises(DomainError) as err:
+        customers.upgrade_tier("C_missing")
+    assert err.value.code == "E_NOT_FOUND"
+    assert err.value.message == "C_missing"
+    assert "C_missing" not in db.customers
+
+
+def test_upgrade_already_gold_fails_and_leaves_state_unchanged():
+    db.customers["C1"] = Customer(id="C1", name="Gold Co", tier="gold")
+    with pytest.raises(DomainError) as err:
+        customers.upgrade_tier("C1")
+    assert err.value.code == "E_BAD_STATE"
+    assert err.value.message == "C1 is gold"
+    assert db.customers["C1"].tier == "gold"
