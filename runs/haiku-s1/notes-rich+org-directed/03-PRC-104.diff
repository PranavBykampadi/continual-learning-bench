diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_deactivate_customer.py b/tests/unit/test_deactivate_customer.py
--- a/tests/unit/test_deactivate_customer.py	1969-12-31 19:00:00
+++ b/tests/unit/test_deactivate_customer.py	2026-11-10 14:11:56
@@ -0,0 +1,56 @@
+import pytest
+
+from parcelo import audit, customers
+from parcelo.errors import DomainError
+from parcelo.models import Customer
+
+
+def _new_customer():
+    return customers.add_customer("Acme")
+
+
+def test_deactivate_sets_inactive_and_returns_customer():
+    c = _new_customer()
+    assert c.active is True
+
+    result = customers.deactivate_customer(c.id)
+
+    assert isinstance(result, Customer)
+    assert result is c
+    assert result.active is False
+    assert customers.get_customer(c.id).active is False
+
+
+def test_deactivate_records_audit():
+    c = _new_customer()
+    audit.LOG.clear()
+
+    customers.deactivate_customer(c.id)
+
+    assert len(audit.LOG) == 1
+    assert audit.LOG[-1]["action"] == "customer.deactivated"
+    assert audit.LOG[-1]["entity_id"] == c.id
+
+
+def test_deactivate_unknown_customer_raises_not_found():
+    audit.LOG.clear()
+
+    with pytest.raises(DomainError) as err:
+        customers.deactivate_customer("C000000")
+
+    assert err.value.code == "E_NOT_FOUND"
+    assert audit.LOG == []
+
+
+def test_deactivate_already_inactive_raises_bad_state():
+    c = _new_customer()
+    customers.deactivate_customer(c.id)
+    audit.LOG.clear()
+
+    with pytest.raises(DomainError) as err:
+        customers.deactivate_customer(c.id)
+
+    assert err.value.code == "E_BAD_STATE"
+    # Left unchanged: still inactive, and no second audit entry.
+    assert customers.get_customer(c.id).active is False
+    assert audit.LOG == []
