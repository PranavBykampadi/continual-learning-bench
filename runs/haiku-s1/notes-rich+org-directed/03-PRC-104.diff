+
+
+def deactivate_customer(customer_id: str) -> Customer:
+    """Mark a customer as inactive.
+
+    Args:
+        customer_id: ID of the customer to deactivate.
+
+    Returns:
+        The updated customer.
+
+    Raises:
+        DomainError: E_NOT_FOUND if the customer does not exist, or
+            E_BAD_STATE if the customer is already inactive.
+    """
+    try:
+        customer = get_customer(customer_id)
+    except KeyError:
+        raise DomainError("E_NOT_FOUND", customer_id) from None
+    if not customer.active:
+        raise DomainError("E_BAD_STATE", customer_id)
+    customer.active = False
+    audit.record("customer.deactivated", customer.id)
+    return customer
 
 
