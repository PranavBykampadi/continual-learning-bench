diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_invoices_write_off.py b/tests/unit/test_invoices_write_off.py
--- a/tests/unit/test_invoices_write_off.py	1969-12-31 19:00:00
+++ b/tests/unit/test_invoices_write_off.py	2026-11-10 14:28:04
@@ -0,0 +1,57 @@
+import pytest
+
+from parcelo import customers, events, invoices, shipments
+from parcelo.errors import DomainError
+from parcelo.money import Money
+
+
+def _open_invoice():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 2, "local")
+    return invoices.issue_invoice(s.id)
+
+
+def test_write_off_open_invoice():
+    inv = _open_invoice()
+    amount = invoices.write_off(inv.id)
+    assert isinstance(amount, Money)
+    assert amount == Money.parse(inv.amount)
+    assert inv.status == "written_off"
+    assert inv.written_off_at is not None
+
+
+def test_write_off_emits_event():
+    inv = _open_invoice()
+    invoices.write_off(inv.id)
+    assert events.OUTBOX[-1]["name"] == "invoice.written_off"
+    assert events.OUTBOX[-1]["entity_id"] == inv.id
+
+
+def test_write_off_not_open_is_bad_state():
+    inv = _open_invoice()
+    invoices.mark_paid(inv.id)
+    events.OUTBOX.clear()
+    with pytest.raises(DomainError) as err:
+        invoices.write_off(inv.id)
+    assert err.value.code == "E_BAD_STATE"
+    assert err.value.message == f"{inv.id} is paid"
+    assert inv.status == "paid"
+    assert inv.written_off_at is None
+    assert events.OUTBOX == []
+
+
+def test_write_off_twice_is_bad_state():
+    inv = _open_invoice()
+    invoices.write_off(inv.id)
+    events.OUTBOX.clear()
+    with pytest.raises(DomainError) as err:
+        invoices.write_off(inv.id)
+    assert err.value.code == "E_BAD_STATE"
+    assert events.OUTBOX == []
+
+
+def test_write_off_unknown_invoice_is_not_found():
+    with pytest.raises(DomainError) as err:
+        invoices.write_off("INV-missing")
+    assert err.value.code == "E_NOT_FOUND"
+    assert err.value.message == "INV-missing"
