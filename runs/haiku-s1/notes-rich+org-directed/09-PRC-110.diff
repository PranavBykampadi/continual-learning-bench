+++ b/tests/unit/test_prc110_gold_quote.py	2026-11-10 14:18:38
@@ -0,0 +1,33 @@
+import pytest
+
+from parcelo import rates
+from parcelo.money import Money
+
+
+def test_gold_gets_ten_percent_off():
+    # regular quote for 2 kg local is 7.00 -> 6.30 for gold
+    result = rates.discounted_quote(2, "local", "gold")
+    assert isinstance(result, Money)
+    assert result == Money(630)
+
+
+def test_standard_has_no_discount():
+    result = rates.discounted_quote(2, "local", "standard")
+    assert isinstance(result, Money)
+    assert result == Money(700)
+
+
+def test_gold_rounds_half_up_to_cent():
+    # regular quote 4.50 + 1.25 * 1.0 = 5.75 -> 5.175 -> 5.18 (half up)
+    result = rates.discounted_quote(1, "local", "gold")
+    assert result == Money(518)
+
+
+def test_unknown_zone_fails():
+    with pytest.raises(ValueError):
+        rates.discounted_quote(2, "moon", "gold")
+
+
+def test_unknown_tier_fails():
+    with pytest.raises(ValueError):
+        rates.discounted_quote(2, "local", "platinum")
