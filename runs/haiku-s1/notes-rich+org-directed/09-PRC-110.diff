+from decimal import Decimal
+
+from parcelo.money import Money
+
 ZONE_BASE = {"local": 4.5, "national": 9.0, "international": 24.0}
+GOLD_DISCOUNT_PCT = Decimal("10")  # PRC-110: 10% off for gold tier
+TIERS = ("standard", "gold")
 PER_KG = 1.25
 
 
@@ -12,3 +18,16 @@
     if weight_kg <= 0:
         raise ValueError("weight must be positive")
     return round(base_rate(zone) + PER_KG * weight_kg, 2)
+
+
+def discounted_quote(weight_kg, zone, tier):
+    """Quote with the tier discount applied. Returns Money.
+
+    Unknown zones fail via quote(); unknown tiers raise ValueError.
+    """
+    if tier not in TIERS:
+        raise ValueError("unknown tier: %s" % tier)
+    regular = Money.parse(quote(weight_kg, zone))
+    if tier == "gold":
+        return regular.scale(1 - GOLD_DISCOUNT_PCT / 100)
+    return regular
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_prc110_gold_quote.py b/tests/unit/test_prc110_gold_quote.py
