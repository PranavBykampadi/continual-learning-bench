+def late_fee_for(invoice_id: str) -> Money:
+    """Return the late fee accrued on an invoice as of now.
+
+    The invoice becomes late 30 days after it was issued. From then on the fee is
+    1.5% of the invoice amount for each whole day past those 30 days.
+
+    Args:
+        invoice_id: Id of the invoice.
+
+    Returns:
+        The late fee as Money. Zero if the invoice is not late yet.
+
+    Raises:
+        DomainError: E_NOT_FOUND if no invoice has this id.
+    """
+    try:
+        invoice = db.invoices[invoice_id]
+    except KeyError:
+        raise DomainError("E_NOT_FOUND", invoice_id) from None
+    issued = invoice.issued_at
+    if issued.tzinfo is None:
+        # issue_invoice stores naive UTC times; clock.now() is aware UTC.
+        issued = issued.replace(tzinfo=timezone.utc)
+    days_late = (clock.now() - issued).days - LATE_AFTER_DAYS
+    if days_late <= 0:
+        return Money.zero()
+    amount = Money.parse(invoice.amount)
+    return amount.scale(LATE_FEE_RATE_PER_DAY * days_late)
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_late_fee_for.py b/tests/unit/test_late_fee_for.py
--- a/tests/unit/test_late_fee_for.py	1969-12-31 19:00:00
+++ b/tests/unit/test_late_fee_for.py	2026-11-10 14:14:29
@@ -0,0 +1,76 @@
+from datetime import timedelta, timezone
+
+import pytest
+
+from parcelo import audit, clock, customers, invoices, shipments, store
+from parcelo.errors import DomainError
+from parcelo.money import Money
+
+
+def _new_invoice():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 2, "local")
+    return invoices.issue_invoice(s.id)
+
+
+def _issued_utc(invoice):
+    # issue_invoice stores naive UTC; clock.now() is aware UTC.
+    return invoice.issued_at.replace(tzinfo=timezone.utc)
+
+
+def test_unknown_invoice_raises_not_found():
+    audit.LOG.clear()
+    with pytest.raises(DomainError) as err:
+        invoices.late_fee_for("INV-missing")
+    assert err.value.code == "E_NOT_FOUND"
+    assert err.value.message == "INV-missing"
+    assert audit.LOG == []
+
+
+@pytest.mark.parametrize("days_after_issue", [0, 1, 29, 30])
+def test_not_late_yet_has_zero_fee(days_after_issue):
+    inv = _new_invoice()
+    clock.set_fixed(_issued_utc(inv) + timedelta(days=days_after_issue))
+    try:
+        fee = invoices.late_fee_for(inv.id)
+    finally:
+        clock.clear_fixed()
+    assert isinstance(fee, Money)
+    assert fee == Money.zero()
+
+
+def test_ten_days_past_grace_is_fifteen_percent():
+    inv = _new_invoice()
+    assert inv.amount == 7.0
+    clock.set_fixed(_issued_utc(inv) + timedelta(days=40))
+    try:
+        fee = invoices.late_fee_for(inv.id)
+    finally:
+        clock.clear_fixed()
+    assert isinstance(fee, Money)
+    assert fee.cents == 105  # 7.00 * 1.5% * 10 days = 1.05
+    assert fee.currency == "USD"
+
+
+def test_partial_day_is_not_counted():
+    inv = _new_invoice()
+    clock.set_fixed(_issued_utc(inv) + timedelta(days=40, hours=23))
+    try:
+        fee = invoices.late_fee_for(inv.id)
+    finally:
+        clock.clear_fixed()
+    assert fee.cents == 105
+
+
+def test_fee_is_read_only():
+    inv = _new_invoice()
+    before = dict(store.db.invoices)
+    audit.LOG.clear()
+    clock.set_fixed(_issued_utc(inv) + timedelta(days=40))
+    try:
+        invoices.late_fee_for(inv.id)
+    finally:
+        clock.clear_fixed()
+    assert audit.LOG == []
+    assert store.db.invoices == before
+    assert inv.status == "open"
