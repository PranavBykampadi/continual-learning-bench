+def set_credit_limit(customer_id, amount):
+    """Set a customer's credit limit and return the new limit.
+
+    Args:
+        customer_id: Id of the customer to update.
+        amount: New limit in dollars, as a float, int, str, Decimal or Money.
+            Zero is allowed (no credit). Negative values are rejected.
+
+    Returns:
+        The new credit limit in dollars, as stored on the customer.
+
+    Raises:
+        DomainError: "E_UNKNOWN_CUSTOMER" if the customer does not exist.
+        DomainError: "E_BAD_INPUT" if the amount is not a number or is negative.
+    """
+    if customer_id not in db.customers:
+        raise DomainError("E_UNKNOWN_CUSTOMER", customer_id)
+    try:
+        limit = Money.parse(amount)
+    except (InvalidOperation, TypeError, ValueError):
+        raise DomainError("E_BAD_INPUT", f"credit limit: {amount!r}")
+    if limit < Money.zero():
+        raise DomainError("E_BAD_INPUT", f"credit limit must not be negative: {amount!r}")
+    customer = db.customers[customer_id]
+    # Customer.credit_limit is still a float field read by old code; wrap at the edge.
+    new_limit = limit.cents / 100
+    customer.credit_limit = new_limit
+    events.emit("customer.credit_limit_set", customer_id, credit_limit=new_limit)
+    return new_limit
 
 
