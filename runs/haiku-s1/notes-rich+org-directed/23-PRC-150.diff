@@ -0,0 +1,73 @@
+import pytest
+
+from parcelo import audit, clock, customers, events, ids, store
+from parcelo.errors import DomainError
+from parcelo.money import Money
+
+
+@pytest.fixture(autouse=True)
+def clean_state():
+    store.reset()
+    ids.reset()
+    audit.LOG.clear()
+    events.OUTBOX.clear()
+    clock.clear_fixed()
+    yield
+
+
+def test_set_credit_limit_updates_and_returns_new_limit():
+    c = customers.add_customer("Acme")
+    assert customers.set_credit_limit(c.id, 1250.5) == 1250.5
+    assert customers.get_customer(c.id).credit_limit == 1250.5
+
+
+def test_set_credit_limit_accepts_string_and_money():
+    c = customers.add_customer("Acme")
+    assert customers.set_credit_limit(c.id, "800.10") == 800.10
+    assert customers.set_credit_limit(c.id, Money(12345)) == 123.45
+
+
+def test_zero_limit_is_allowed():
+    c = customers.add_customer("Acme")
+    assert customers.set_credit_limit(c.id, 0) == 0
+    assert customers.get_customer(c.id).credit_limit == 0
+
+
+def test_set_credit_limit_emits_event():
+    c = customers.add_customer("Acme")
+    customers.set_credit_limit(c.id, 900)
+    assert events.OUTBOX[-1]["name"] == "customer.credit_limit_set"
+    assert events.OUTBOX[-1]["entity_id"] == c.id
+    assert events.OUTBOX[-1]["payload"]["credit_limit"] == 900
+
+
+def test_unknown_customer_fails():
+    before = len(events.OUTBOX)
+    with pytest.raises(DomainError) as err:
+        customers.set_credit_limit("cus_missing", 100)
+    assert err.value.code == "E_UNKNOWN_CUSTOMER"
+    assert len(events.OUTBOX) == before
+
+
+@pytest.mark.parametrize("amount", [-1, -0.01, "-5", Money(-1)])
+def test_negative_amount_fails_and_leaves_limit_unchanged(amount):
+    c = customers.add_customer("Acme")
+    before_limit = c.credit_limit
+    before_events = len(events.OUTBOX)
+    with pytest.raises(DomainError) as err:
+        customers.set_credit_limit(c.id, amount)
+    assert err.value.code == "E_BAD_INPUT"
+    assert customers.get_customer(c.id).credit_limit == before_limit
+    assert len(events.OUTBOX) == before_events
+
+
+@pytest.mark.parametrize("amount", [None, "", "abc", [], {}])
+def test_non_numeric_amount_fails_and_leaves_limit_unchanged(amount):
+    c = customers.add_customer("Acme")
+    before_limit = c.credit_limit
+    before_events = len(events.OUTBOX)
+    with pytest.raises(DomainError) as err:
+        customers.set_credit_limit(c.id, amount)
+    assert err.value.code == "E_BAD_INPUT"
+    assert customers.get_customer(c.id).credit_limit == before_limit
+    assert len(events.OUTBOX) == before_events
