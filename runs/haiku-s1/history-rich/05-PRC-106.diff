+def _as_utc(moment):
+    # issued_at is stored naive (utcnow); clock.now() is aware. Compare in UTC.
+    if moment.tzinfo is None:
+        return moment.replace(tzinfo=timezone.utc)
+    return moment.astimezone(timezone.utc)
+
+
+def late_fee_for(invoice_id):
+    """Late fee accrued so far on an invoice.
+
+    The invoice is late 30 days after issue. From then on the fee is 1.5% of
+    the invoice amount for each full day past those 30 days. Not late yet
+    means a zero fee.
+    """
+    if invoice_id not in db.invoices:
+        raise DomainError("E_NOT_FOUND", "invoice %s" % invoice_id)
+    invoice = db.invoices[invoice_id]
+    elapsed_days = (_as_utc(clock.now()) - _as_utc(invoice.issued_at)).days
+    days_late = elapsed_days - LATE_AFTER_DAYS
+    if days_late <= 0:
+        return Money.zero()
+    amount = Money.parse(invoice.amount)
+    return amount.scale(LATE_FEE_RATE_PER_DAY * days_late)
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_late_fee.py b/tests/unit/test_late_fee.py
--- a/tests/unit/test_late_fee.py	1969-12-31 19:00:00
+++ b/tests/unit/test_late_fee.py	2026-11-10 12:32:28
@@ -0,0 +1,68 @@
+from datetime import datetime, timedelta, timezone
+
+import pytest
+
+from parcelo import clock, invoices
+from parcelo.errors import DomainError
+from parcelo.models import Invoice
+from parcelo.store import db
+
+ISSUED = datetime(2026, 1, 1, 12, 0, 0)  # naive UTC, as issue_invoice stores it
+
+
+def _invoice(amount=100.0, issued_at=ISSUED):
+    inv = Invoice(id="INV-test", shipment_id="shp_x", amount=amount, issued_at=issued_at)
+    db.invoices[inv.id] = inv
+    return inv
+
+
+def _at(days_after_issue):
+    clock.set_fixed(
+        (ISSUED + timedelta(days=days_after_issue)).replace(tzinfo=timezone.utc)
+    )
+
+
+def test_not_late_before_thirty_days_is_zero():
+    _invoice()
+    _at(29)
+    assert invoices.late_fee_for("INV-test").cents == 0
+
+
+def test_exactly_thirty_days_is_zero():
+    _invoice()
+    _at(30)
+    assert invoices.late_fee_for("INV-test").cents == 0
+
+
+def test_one_day_past_thirty_is_one_and_a_half_percent():
+    _invoice(amount=100.0)
+    _at(31)
+    fee = invoices.late_fee_for("INV-test")
+    assert fee.cents == 150  # $1.50
+
+
+def test_fee_accumulates_per_day():
+    _invoice(amount=200.0)
+    _at(40)  # 10 days past the 30-day mark
+    fee = invoices.late_fee_for("INV-test")
+    assert fee.cents == 3000  # 1.5% * 10 days of $200 = $30.00
+
+
+def test_returns_money_not_float():
+    _invoice(amount=100.0)
+    _at(35)
+    fee = invoices.late_fee_for("INV-test")
+    assert not isinstance(fee, float)
+    assert fee.currency == "USD"
+
+
+def test_naive_clock_is_accepted():
+    _invoice(amount=100.0)
+    clock.set_fixed(ISSUED + timedelta(days=31))  # naive fixed moment
+    assert invoices.late_fee_for("INV-test").cents == 150
+
+
+def test_missing_invoice_raises_not_found():
+    with pytest.raises(DomainError) as err:
+        invoices.late_fee_for("INV-nope")
+    assert err.value.code == "E_NOT_FOUND"
