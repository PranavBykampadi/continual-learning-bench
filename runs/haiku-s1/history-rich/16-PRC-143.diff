diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_pickups.py b/tests/unit/test_pickups.py
--- a/tests/unit/test_pickups.py	1969-12-31 19:00:00
+++ b/tests/unit/test_pickups.py	2026-11-10 12:38:20
@@ -0,0 +1,45 @@
+import pytest
+
+from parcelo import customers, events, pickups, shipments, store
+from parcelo.errors import DomainError
+from parcelo.models import Pickup
+
+
+def _created_shipment():
+    c = customers.add_customer("Acme")
+    return shipments.create_shipment(c.id, 2.0, "national")
+
+
+def test_schedule_pickup_saves_and_returns_pickup():
+    s = _created_shipment()
+    window = "2026-11-11T09:00"
+    p = pickups.schedule_pickup(s.id, window)
+    assert isinstance(p, Pickup)
+    assert p.id.startswith("pkp_")
+    assert p.shipment_id == s.id
+    assert p.window_start == window
+    assert p.scheduled_at is not None
+    assert store.db.pickups[p.id] is p
+
+
+def test_schedule_pickup_emits_event():
+    s = _created_shipment()
+    p = pickups.schedule_pickup(s.id, "2026-11-11T09:00")
+    assert events.OUTBOX[-1]["name"] == "pickup.scheduled"
+    assert events.OUTBOX[-1]["entity_id"] == p.id
+
+
+def test_unknown_shipment_fails():
+    with pytest.raises(DomainError) as err:
+        pickups.schedule_pickup("shp_missing", "2026-11-11T09:00")
+    assert err.value.code == "E_NOT_FOUND"
+    assert store.db.pickups == {}
+
+
+def test_non_created_shipment_fails():
+    s = _created_shipment()
+    s.status = "delivered"
+    with pytest.raises(DomainError) as err:
+        pickups.schedule_pickup(s.id, "2026-11-11T09:00")
+    assert err.value.code == "E_BAD_STATE"
+    assert store.db.pickups == {}
