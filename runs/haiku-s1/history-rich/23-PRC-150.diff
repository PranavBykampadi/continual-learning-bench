diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_customers.py b/tests/unit/test_customers.py
--- a/tests/unit/test_customers.py	1969-12-31 19:00:00
+++ b/tests/unit/test_customers.py	2026-11-10 12:42:19
@@ -0,0 +1,35 @@
+import pytest
+
+from parcelo import customers, events
+from parcelo.errors import DomainError
+from parcelo.money import Money
+
+
+def test_set_credit_limit_updates_and_returns_limit():
+    c = customers.add_customer("Acme")
+    limit = customers.set_credit_limit(c.id, 1250.5)
+    assert limit == Money(125050)
+    assert customers.get_customer(c.id).credit_limit == Money(125050)
+
+
+def test_set_credit_limit_emits_event():
+    c = customers.add_customer("Acme")
+    customers.set_credit_limit(c.id, 100)
+    assert events.OUTBOX[-1]["name"] == "customer.credit_limit_set"
+    assert events.OUTBOX[-1]["entity_id"] == c.id
+
+
+def test_unknown_customer_fails():
+    with pytest.raises(DomainError) as err:
+        customers.set_credit_limit("nope", 100)
+    assert err.value.code == "E_UNKNOWN_CUSTOMER"
+
+
+def test_negative_amount_fails_and_changes_nothing():
+    c = customers.add_customer("Acme")
+    before = customers.get_customer(c.id).credit_limit
+    with pytest.raises(DomainError) as err:
+        customers.set_credit_limit(c.id, -1)
+    assert err.value.code == "E_BAD_INPUT"
+    assert customers.get_customer(c.id).credit_limit == before
+    assert events.OUTBOX == []
