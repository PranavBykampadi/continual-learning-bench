+def upgrade_tier(customer_id):
+    customer = db.customers.get(customer_id)
+    if customer is None:
+        raise DomainError("E_NOT_FOUND", f"customer {customer_id} not found")
+    if customer.tier == "gold":
+        raise DomainError("E_BAD_STATE", f"customer {customer_id} is already gold")
+    if customer.tier != "standard":
+        raise DomainError("E_BAD_STATE", f"customer {customer_id} cannot be upgraded from {customer.tier}")
+    previous = customer.tier
+    customer.tier = "gold"
+    events.emit("customer.tier_upgraded", customer_id, previous=previous, tier="gold")
+    return customer
 
 
