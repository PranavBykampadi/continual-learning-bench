+def reassign_shipment(shipment_id, new_customer_id):
+    shipment = get_shipment(shipment_id)
+    if new_customer_id not in db.customers:
+        raise DomainError("E_UNKNOWN_CUSTOMER", new_customer_id)
+    if shipment.status == "delivered":
+        raise DomainError("E_BAD_STATE", shipment_id)
+    old_customer_id = shipment.customer_id
+    shipment.customer_id = new_customer_id
+    audit.record(
+        "shipment.reassign",
+        shipment_id,
+        from_customer_id=old_customer_id,
+        to_customer_id=new_customer_id,
+    )
+    return shipment
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_reassign_shipment.py b/tests/unit/test_reassign_shipment.py
--- a/tests/unit/test_reassign_shipment.py	1969-12-31 19:00:00
+++ b/tests/unit/test_reassign_shipment.py	2026-11-10 12:37:18
@@ -0,0 +1,65 @@
+import pytest
+
+from parcelo import audit, customers, shipments
+from parcelo.errors import DomainError
+from parcelo.store import db
+
+
+def _setup():
+    old = customers.add_customer("Old Co")
+    new = customers.add_customer("New Co")
+    s = shipments.create_shipment(old.id, 2, "local")
+    return old, new, s
+
+
+def test_reassign_changes_customer_and_returns_shipment():
+    old, new, s = _setup()
+    result = shipments.reassign_shipment(s.id, new.id)
+    assert result is s
+    assert db.shipments[s.id].customer_id == new.id
+
+
+def test_reassign_writes_audit_entry_with_shipment_id():
+    old, new, s = _setup()
+    audit.LOG.clear()
+    shipments.reassign_shipment(s.id, new.id)
+    assert len(audit.LOG) == 1
+    entry = audit.LOG[-1]
+    assert entry["action"] == "shipment.reassign"
+    assert entry["entity_id"] == s.id
+    assert entry["details"] == {
+        "from_customer_id": old.id,
+        "to_customer_id": new.id,
+    }
+
+
+def test_reassign_unknown_shipment_fails():
+    _, new, _ = _setup()
+    with pytest.raises(DomainError) as err:
+        shipments.reassign_shipment("shp_missing", new.id)
+    assert err.value.code == "E_NOT_FOUND"
+
+
+def test_reassign_to_unknown_customer_fails():
+    _, _, s = _setup()
+    with pytest.raises(DomainError) as err:
+        shipments.reassign_shipment(s.id, "C_missing")
+    assert err.value.code == "E_UNKNOWN_CUSTOMER"
+    assert db.shipments[s.id].customer_id != "C_missing"
+
+
+def test_reassign_delivered_shipment_fails():
+    old, new, s = _setup()
+    db.shipments[s.id].status = "delivered"
+    with pytest.raises(DomainError) as err:
+        shipments.reassign_shipment(s.id, new.id)
+    assert err.value.code == "E_BAD_STATE"
+    assert db.shipments[s.id].customer_id == old.id
+
+
+def test_failed_reassign_writes_no_audit_entry():
+    _, _, s = _setup()
+    audit.LOG.clear()
+    with pytest.raises(DomainError):
+        shipments.reassign_shipment(s.id, "C_missing")
+    assert audit.LOG == []
