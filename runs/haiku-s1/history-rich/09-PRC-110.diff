         raise ValueError("weight must be positive")
     return round(base_rate(zone) + PER_KG * weight_kg, 2)
+
+
+def discounted_quote(weight_kg, zone, tier):
+    """Quote for a customer tier: 10% off for "gold", none for "standard".
+
+    Returns Money. Raises DomainError for an unknown tier, zone or weight.
+    """
+    if tier not in TIER_FACTOR:
+        raise DomainError("E_BAD_TIER", "unknown tier: %s" % tier)
+    if zone not in ZONE_BASE:
+        raise DomainError("E_BAD_ZONE", "unknown zone: %s" % zone)
+    if weight_kg <= 0:
+        raise DomainError("E_BAD_WEIGHT", "weight must be positive")
+    regular = Money.parse(quote(weight_kg, zone))
+    return regular.scale(TIER_FACTOR[tier])
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_rates_discounted.py b/tests/unit/test_rates_discounted.py
--- a/tests/unit/test_rates_discounted.py	1969-12-31 19:00:00
+++ b/tests/unit/test_rates_discounted.py	2026-11-10 12:34:30
@@ -0,0 +1,41 @@
+import pytest
+
+from parcelo import rates
+from parcelo.errors import DomainError
+from parcelo.money import Money
+
+
+def test_standard_tier_has_no_discount():
+    assert rates.discounted_quote(2, "local", "standard") == Money(700)
+
+
+def test_gold_tier_takes_10_percent_off():
+    assert rates.discounted_quote(2, "local", "gold") == Money(630)
+
+
+def test_gold_tier_national():
+    # regular quote 11.50 -> 10.35
+    assert rates.discounted_quote(2, "national", "gold") == Money(1035)
+
+
+def test_gold_tier_rounds_half_up_to_cents():
+    # regular quote 7.25 -> 6.525 -> 6.53
+    assert rates.discounted_quote(2.2, "local", "gold") == Money(653)
+
+
+def test_unknown_tier_fails():
+    with pytest.raises(DomainError) as err:
+        rates.discounted_quote(2, "local", "platinum")
+    assert err.value.code == "E_BAD_TIER"
+
+
+def test_unknown_zone_fails():
+    with pytest.raises(DomainError) as err:
+        rates.discounted_quote(2, "moon", "gold")
+    assert err.value.code == "E_BAD_ZONE"
+
+
+def test_non_positive_weight_fails():
+    with pytest.raises(DomainError) as err:
+        rates.discounted_quote(0, "local", "gold")
+    assert err.value.code == "E_BAD_WEIGHT"
