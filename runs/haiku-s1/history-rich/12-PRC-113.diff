 def open_invoices():
     return [i for i in db.invoices.values() if i.status == "open"]
+
+
+def apply_credit(invoice_id, amount):
+    """Reduce an open invoice's amount by a credit and return the remaining Money.
+
+    Invoice.amount is stored as a float dollar value because reports and
+    customer balances sum it directly; the arithmetic itself is done in Money.
+    """
+    if invoice_id not in db.invoices:
+        raise DomainError("E_NOT_FOUND", f"invoice {invoice_id}")
+    invoice = db.invoices[invoice_id]
+    if invoice.status != "open":
+        raise DomainError("E_BAD_STATE", f"invoice {invoice_id} is {invoice.status}")
+    credit = Money.parse(amount)
+    if credit.cents <= 0:
+        raise DomainError("E_BAD_INPUT", "credit must be positive")
+    current = Money.parse(invoice.amount)
+    if current < credit:
+        raise DomainError("E_BAD_INPUT", "credit exceeds invoice amount")
+    remaining = current - credit
+    invoice.amount = remaining.cents / 100
+    audit.record(
+        "invoice.credit_applied",
+        invoice_id,
+        credit_cents=credit.cents,
+        remaining_cents=remaining.cents,
+    )
+    return remaining
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_invoice_credit.py b/tests/unit/test_invoice_credit.py
--- a/tests/unit/test_invoice_credit.py	1969-12-31 19:00:00
+++ b/tests/unit/test_invoice_credit.py	2026-11-10 12:36:10
@@ -0,0 +1,74 @@
+import pytest
+
+from parcelo import audit, customers, invoices, reports, shipments
+from parcelo.customers import outstanding_balance
+from parcelo.errors import DomainError
+from parcelo.money import Money
+
+
+def _open_invoice():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 2, "local")
+    inv = invoices.issue_invoice(s.id)
+    return c, inv
+
+
+def test_partial_credit_reduces_amount_and_returns_remaining():
+    _, inv = _open_invoice()
+    remaining = invoices.apply_credit(inv.id, 2.5)
+    assert remaining == Money(450)
+    assert inv.amount == 4.5
+    assert inv.status == "open"
+
+
+def test_credit_records_audit_entry_for_invoice():
+    _, inv = _open_invoice()
+    invoices.apply_credit(inv.id, 1.0)
+    entry = audit.LOG[-1]
+    assert entry["action"] == "invoice.credit_applied"
+    assert entry["entity_id"] == inv.id
+    assert entry["details"] == {"credit_cents": 100, "remaining_cents": 600}
+
+
+def test_outstanding_balance_reflects_credit():
+    c, inv = _open_invoice()
+    invoices.apply_credit(inv.id, 2.0)
+    assert outstanding_balance(c.id) == 5.0
+
+
+def test_paid_credited_invoice_counts_in_revenue_at_reduced_amount():
+    _, inv = _open_invoice()
+    invoices.apply_credit(inv.id, 2.0)
+    invoices.mark_paid(inv.id)
+    assert reports.revenue_total() == 5.0
+
+
+def test_missing_invoice_raises_not_found():
+    with pytest.raises(DomainError) as err:
+        invoices.apply_credit("INV-nope", 1.0)
+    assert err.value.code == "E_NOT_FOUND"
+
+
+def test_paid_invoice_raises_bad_state():
+    _, inv = _open_invoice()
+    invoices.mark_paid(inv.id)
+    with pytest.raises(DomainError) as err:
+        invoices.apply_credit(inv.id, 1.0)
+    assert err.value.code == "E_BAD_STATE"
+    assert inv.amount == 7.0
+
+
+def test_credit_larger_than_amount_raises_bad_input():
+    _, inv = _open_invoice()
+    with pytest.raises(DomainError) as err:
+        invoices.apply_credit(inv.id, 7.01)
+    assert err.value.code == "E_BAD_INPUT"
+    assert inv.amount == 7.0
+
+
+def test_non_positive_credit_raises_bad_input():
+    _, inv = _open_invoice()
+    with pytest.raises(DomainError) as err:
+        invoices.apply_credit(inv.id, 0)
+    assert err.value.code == "E_BAD_INPUT"
+    assert inv.amount == 7.0
