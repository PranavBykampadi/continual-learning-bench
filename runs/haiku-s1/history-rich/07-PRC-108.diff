@@ -0,0 +1,41 @@
+from parcelo import customers, invoices, reports, shipments
+from parcelo.models import Invoice
+from parcelo.money import Money
+from parcelo.store import db
+
+
+def test_outstanding_sums_open_invoices_per_customer():
+    acme = customers.add_customer("Acme")
+    globex = customers.add_customer("Globex")
+    s1 = shipments.create_shipment(acme.id, 2, "local")
+    s2 = shipments.create_shipment(acme.id, 2, "local")
+    s3 = shipments.create_shipment(globex.id, 2, "local")
+    inv1 = invoices.issue_invoice(s1.id)
+    invoices.issue_invoice(s2.id)
+    invoices.issue_invoice(s3.id)
+    invoices.mark_paid(inv1.id)
+
+    result = reports.outstanding_by_customer()
+
+    assert result[acme.id] == Money.parse(7.0)
+    assert result[globex.id] == Money.parse(7.0)
+
+
+def test_paid_and_void_invoices_are_excluded():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 2, "local")
+    paid = invoices.issue_invoice(s.id)
+    invoices.mark_paid(paid.id)
+    db.invoices["INV-void"] = Invoice(
+        id="INV-void", shipment_id=s.id, amount=50.0, status="void"
+    )
+
+    result = reports.outstanding_by_customer()
+
+    assert result[c.id] == Money.zero()
+
+
+def test_customer_without_invoices_has_zero_balance():
+    c = customers.add_customer("Quiet")
+
+    assert reports.outstanding_by_customer() == {c.id: Money.zero()}
