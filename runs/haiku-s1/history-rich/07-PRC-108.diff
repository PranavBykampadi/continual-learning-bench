 def revenue_total():
     return round(sum(i.amount for i in db.invoices.values() if i.status == "paid"), 2)
+
+
+def outstanding_by_customer():
+    """Map each customer id to the total of their open invoices, as Money.
+
+    Invoices are linked to customers through their shipment. Customers with
+    nothing open map to a zero balance. Paid and void invoices are ignored.
+    """
+    totals = {customer_id: Money.zero() for customer_id in db.customers}
+    for invoice in db.invoices.values():
+        if invoice.status != "open":
+            continue
+        customer_id = db.shipments[invoice.shipment_id].customer_id
+        totals[customer_id] = totals.get(customer_id, Money.zero()) + Money.parse(
+            invoice.amount
+        )
+    return totals
 
 
