+def split_shipment(shipment_id, weights):
+    """Replace a "created" shipment with one new shipment per weight.
+
+    The new shipments keep the original customer and zone and are returned in
+    the order of ``weights``. The original is marked with status "split".
+    """
+    shipment = get_shipment(shipment_id)
+    if shipment.status != "created":
+        raise DomainError("E_BAD_STATE", f"{shipment_id} is {shipment.status}")
+    weights = list(weights)
+    if not weights:
+        raise DomainError("E_BAD_INPUT", "no weights given")
+    for w in weights:
+        if w <= 0:
+            raise DomainError("E_BAD_WEIGHT", str(w))
+    # Decimal(str(...)) keeps the comparison exact for values like 0.1 + 0.2.
+    total = sum(Decimal(str(w)) for w in weights)
+    if total != Decimal(str(shipment.weight_kg)):
+        raise DomainError(
+            "E_BAD_INPUT",
+            f"weights sum to {total}, expected {shipment.weight_kg}",
+        )
+
+    new_shipments = [
+        create_shipment(shipment.customer_id, w, shipment.zone) for w in weights
+    ]
+    shipment.status = "split"
+    events.emit(
+        "shipment.split",
+        shipment.id,
+        new_ids=[s.id for s in new_shipments],
+    )
+    return new_shipments
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_split_shipment.py b/tests/unit/test_split_shipment.py
--- a/tests/unit/test_split_shipment.py	1969-12-31 19:00:00
+++ b/tests/unit/test_split_shipment.py	2026-11-10 12:41:20
@@ -0,0 +1,65 @@
+import pytest
+
+from parcelo import audit, customers, events, shipments
+from parcelo.errors import DomainError
+
+
+def _created(weight=10.0):
+    c = customers.add_customer("Acme")
+    return shipments.create_shipment(c.id, weight, "national")
+
+
+def test_split_replaces_original_with_new_shipments_in_order():
+    s = _created(10.0)
+    new = shipments.split_shipment(s.id, [6.0, 4.0])
+    assert [n.weight_kg for n in new] == [6.0, 4.0]
+    assert all(n.id.startswith("shp_") for n in new)
+    assert all(n.customer_id == s.customer_id and n.zone == s.zone for n in new)
+    assert all(n.status == "created" for n in new)
+    assert s.status == "split"
+
+
+def test_split_emits_events_and_no_direct_audit():
+    s = _created(3.0)
+    audit.LOG.clear()
+    shipments.split_shipment(s.id, [1.0, 2.0])
+    names = [e["name"] for e in events.OUTBOX]
+    assert "shipment.split" in names
+    assert names.count("shipment.created") == 3  # original + two new
+    assert audit.LOG == []
+
+
+def test_split_exact_float_sum():
+    s = _created(0.3)
+    new = shipments.split_shipment(s.id, [0.1, 0.2])
+    assert len(new) == 2
+
+
+def test_split_unknown_shipment_fails():
+    with pytest.raises(DomainError) as err:
+        shipments.split_shipment("shp_999999", [1.0])
+    assert err.value.code == "E_NOT_FOUND"
+
+
+def test_split_non_created_shipment_fails():
+    s = _created(2.0)
+    shipments.split_shipment(s.id, [1.0, 1.0])
+    with pytest.raises(DomainError) as err:
+        shipments.split_shipment(s.id, [1.0, 1.0])
+    assert err.value.code == "E_BAD_STATE"
+
+
+def test_split_weights_must_sum_to_original():
+    s = _created(10.0)
+    with pytest.raises(DomainError) as err:
+        shipments.split_shipment(s.id, [6.0, 3.0])
+    assert err.value.code == "E_BAD_INPUT"
+    assert s.status == "created"
+
+
+def test_split_rejects_non_positive_weight():
+    s = _created(5.0)
+    with pytest.raises(DomainError) as err:
+        shipments.split_shipment(s.id, [5.0, 0.0])
+    assert err.value.code == "E_BAD_WEIGHT"
+    assert s.status == "created"
