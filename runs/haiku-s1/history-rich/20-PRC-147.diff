diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_reports.py b/tests/unit/test_reports.py
--- a/tests/unit/test_reports.py	1969-12-31 19:00:00
+++ b/tests/unit/test_reports.py	2026-11-10 12:40:13
@@ -0,0 +1,45 @@
+from parcelo import customers, reports, shipments
+from parcelo.store import db
+
+
+def _ship(customer_id, n):
+    for _ in range(n):
+        shipments.create_shipment(customer_id, 1.0, "local")
+
+
+def test_includes_customers_with_no_shipments():
+    a = customers.add_customer("Acme")
+    report = reports.volume_report()
+    assert report == {a.id: {"shipments": 0, "tier": "starter"}}
+
+
+def test_counts_shipments_per_customer():
+    a = customers.add_customer("Acme")
+    b = customers.add_customer("Beta")
+    _ship(a.id, 3)
+    _ship(b.id, 1)
+    report = reports.volume_report()
+    assert report[a.id]["shipments"] == 3
+    assert report[b.id]["shipments"] == 1
+    assert len(db.shipments) == 4
+
+
+def test_tier_thresholds():
+    starter = customers.add_customer("S")
+    regular = customers.add_customer("R")
+    bulk = customers.add_customer("B")
+    _ship(starter.id, 9)
+    _ship(regular.id, 10)
+    _ship(bulk.id, 50)
+    report = reports.volume_report()
+    assert report[starter.id]["tier"] == "starter"
+    assert report[regular.id]["tier"] == "regular"
+    assert report[bulk.id]["tier"] == "bulk"
+
+
+def test_report_is_read_only():
+    a = customers.add_customer("Acme")
+    _ship(a.id, 2)
+    before = len(db.shipments)
+    reports.volume_report()
+    assert len(db.shipments) == before
