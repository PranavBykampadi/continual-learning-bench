diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_invoice_write_off.py b/tests/unit/test_invoice_write_off.py
--- a/tests/unit/test_invoice_write_off.py	1969-12-31 19:00:00
+++ b/tests/unit/test_invoice_write_off.py	2026-11-10 12:39:49
@@ -0,0 +1,64 @@
+import pytest
+
+from parcelo import clock, customers, events, invoices, shipments
+from parcelo.errors import DomainError
+from parcelo.money import Money
+
+
+def _open_invoice(weight=2, zone="local"):
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, weight, zone)
+    return invoices.issue_invoice(s.id)
+
+
+def test_write_off_open_invoice_sets_status_and_timestamp():
+    clock.set_fixed(clock.now())
+    inv = _open_invoice()
+    moment = clock.now()
+
+    result = invoices.write_off(inv.id)
+
+    assert inv.status == "written_off"
+    assert inv.written_off_at == moment
+    assert isinstance(result, Money)
+    assert result == Money.parse(inv.amount)
+    assert result.cents == 700
+
+
+def test_write_off_emits_event_with_invoice_id():
+    inv = _open_invoice()
+    events.OUTBOX.clear()
+
+    invoices.write_off(inv.id)
+
+    assert len(events.OUTBOX) == 1
+    entry = events.OUTBOX[-1]
+    assert entry["name"] == "invoice.written_off"
+    assert entry["entity_id"] == inv.id
+    assert entry["payload"]["amount_cents"] == 700
+
+
+def test_write_off_twice_is_rejected():
+    inv = _open_invoice()
+    invoices.write_off(inv.id)
+
+    with pytest.raises(DomainError) as err:
+        invoices.write_off(inv.id)
+    assert err.value.code == "E_BAD_STATE"
+
+
+def test_write_off_paid_invoice_is_rejected():
+    inv = _open_invoice()
+    invoices.mark_paid(inv.id)
+
+    with pytest.raises(DomainError) as err:
+        invoices.write_off(inv.id)
+    assert err.value.code == "E_BAD_STATE"
+    assert inv.status == "paid"
+    assert inv.written_off_at is None
+
+
+def test_write_off_unknown_invoice_is_not_found():
+    with pytest.raises(DomainError) as err:
+        invoices.write_off("INV-missing")
+    assert err.value.code == "E_NOT_FOUND"
