diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_refunds.py b/tests/unit/test_refunds.py
--- a/tests/unit/test_refunds.py	1969-12-31 19:00:00
+++ b/tests/unit/test_refunds.py	2026-11-10 12:31:50
@@ -0,0 +1,50 @@
+import pytest
+
+from parcelo import audit, customers, invoices, refunds, shipments, store
+from parcelo.errors import DomainError
+from parcelo.money import Money
+
+
+def _paid_invoice():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 1.5, "national")
+    inv = invoices.issue_invoice(s.id)
+    invoices.mark_paid(inv.id)
+    return inv
+
+
+def test_create_refund_on_paid_invoice():
+    inv = _paid_invoice()
+    r = refunds.create_refund(inv.id, 10.5)
+    assert r.id.startswith("ref_")
+    assert r.invoice_id == inv.id
+    assert r.amount == Money(1050)
+    assert r.created_at is not None
+    assert store.db.refunds[r.id] is r
+    assert audit.LOG[-1]["action"] == "refund.created"
+    assert audit.LOG[-1]["entity_id"] == r.id
+
+
+def test_refund_unknown_invoice():
+    with pytest.raises(DomainError) as err:
+        refunds.create_refund("INV-missing", 5)
+    assert err.value.code == "E_NOT_FOUND"
+    assert store.db.refunds == {}
+
+
+def test_refund_unpaid_invoice():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 1.5, "national")
+    inv = invoices.issue_invoice(s.id)
+    with pytest.raises(DomainError) as err:
+        refunds.create_refund(inv.id, 5)
+    assert err.value.code == "E_BAD_STATE"
+    assert store.db.refunds == {}
+
+
+def test_refund_non_positive_amount():
+    inv = _paid_invoice()
+    with pytest.raises(DomainError) as err:
+        refunds.create_refund(inv.id, 0)
+    assert err.value.code == "E_BAD_INPUT"
+    assert store.db.refunds == {}
