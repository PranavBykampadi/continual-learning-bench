@@ -0,0 +1,74 @@
+from datetime import datetime, timedelta, timezone
+
+import pytest
+
+from parcelo import clock, reports
+from parcelo.errors import DomainError
+from parcelo.models import Invoice
+from parcelo.money import Money
+from parcelo.store import db
+
+NOW = datetime(2026, 11, 10, 12, 0, 0, tzinfo=timezone.utc)
+
+
+@pytest.fixture(autouse=True)
+def fixed_now():
+    clock.set_fixed(NOW)
+    yield
+
+
+def add_invoice(inv_id, amount, days_old, status="open"):
+    issued = (NOW - timedelta(days=days_old)).replace(tzinfo=None)
+    db.invoices[inv_id] = Invoice(
+        id=inv_id,
+        shipment_id="shp_x",
+        amount=amount,
+        status=status,
+        issued_at=issued,
+    )
+
+
+def test_empty_report_is_all_zero():
+    assert reports.aging_report() == {
+        "0-30": Money.zero(),
+        "31-60": Money.zero(),
+        "60+": Money.zero(),
+    }
+
+
+def test_bucket_boundaries():
+    add_invoice("a", 1.00, 0)
+    add_invoice("b", 2.00, 30)
+    add_invoice("c", 4.00, 31)
+    add_invoice("d", 8.00, 60)
+    add_invoice("e", 16.00, 61)
+    report = reports.aging_report()
+    assert report["0-30"] == Money.parse(3.00)
+    assert report["31-60"] == Money.parse(12.00)
+    assert report["60+"] == Money.parse(16.00)
+
+
+def test_paid_invoices_are_excluded():
+    add_invoice("open1", 10.00, 5)
+    add_invoice("paid1", 99.00, 5, status="paid")
+    add_invoice("paid2", 99.00, 90, status="paid")
+    report = reports.aging_report()
+    assert report["0-30"] == Money.parse(10.00)
+    assert report["60+"] == Money.zero()
+
+
+def test_accepts_timezone_aware_issue_dates():
+    db.invoices["aware"] = Invoice(
+        id="aware",
+        shipment_id="shp_x",
+        amount=5.50,
+        issued_at=NOW - timedelta(days=45),
+    )
+    assert reports.aging_report()["31-60"] == Money.parse(5.50)
+
+
+def test_open_invoice_without_issue_date_raises():
+    db.invoices["noday"] = Invoice(id="noday", shipment_id="shp_x", amount=1.0)
+    with pytest.raises(DomainError) as err:
+        reports.aging_report()
+    assert err.value.code == "E_BAD_STATE"
