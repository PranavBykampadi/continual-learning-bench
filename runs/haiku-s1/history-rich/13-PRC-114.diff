+
+def _as_naive_utc(moment):
+    """Return a naive UTC datetime; accepts naive or timezone-aware input."""
+    if moment.tzinfo is not None:
+        moment = moment.astimezone(timezone.utc).replace(tzinfo=None)
+    return moment
+
+
+def aging_report():
+    """Total open invoices by age in whole days since issue.
+
+    Buckets: "0-30" (0 to 30 days), "31-60" (31 to 60 days), "60+" (over 60 days).
+    Paid invoices are excluded. Ages are clamped to 0 for future issue dates.
+    """
+    now = _as_naive_utc(clock.now())
+    totals = {"0-30": Money.zero(), "31-60": Money.zero(), "60+": Money.zero()}
+    for invoice in db.invoices.values():
+        if invoice.status != "open":
+            continue
+        if invoice.issued_at is None:
+            raise DomainError("E_BAD_STATE", f"invoice {invoice.id} has no issue date")
+        age = max(0, (now - _as_naive_utc(invoice.issued_at)).days)
+        if age <= 30:
+            bucket = "0-30"
+        elif age <= 60:
+            bucket = "31-60"
+        else:
+            bucket = "60+"
+        totals[bucket] = totals[bucket] + Money.parse(invoice.amount)
+    return totals
 
 
