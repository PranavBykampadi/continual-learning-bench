diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_reopen_invoice.py b/tests/unit/test_reopen_invoice.py
--- a/tests/unit/test_reopen_invoice.py	1969-12-31 19:00:00
+++ b/tests/unit/test_reopen_invoice.py	2026-11-10 12:37:49
@@ -0,0 +1,56 @@
+import pytest
+
+from parcelo import clock, customers, events, invoices, shipments
+from parcelo.errors import DomainError
+
+
+def _paid_invoice():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 2, "local")
+    inv = invoices.issue_invoice(s.id)
+    return invoices.mark_paid(inv.id)
+
+
+def test_reopen_paid_invoice_sets_open_and_clears_paid_at():
+    inv = _paid_invoice()
+    result = invoices.reopen_invoice(inv.id)
+    assert result is inv
+    assert inv.status == "open"
+    assert inv.paid_at is None
+    assert inv.reopened_at is not None
+
+
+def test_reopen_records_reopened_at_from_clock():
+    moment = clock.now()
+    clock.set_fixed(moment)
+    try:
+        inv = _paid_invoice()
+        invoices.reopen_invoice(inv.id)
+        assert inv.reopened_at == moment
+    finally:
+        clock.clear_fixed()
+
+
+def test_reopen_emits_event():
+    inv = _paid_invoice()
+    events.OUTBOX.clear()
+    invoices.reopen_invoice(inv.id)
+    assert events.OUTBOX[-1]["name"] == "invoice.reopened"
+    assert events.OUTBOX[-1]["entity_id"] == inv.id
+
+
+def test_reopen_missing_invoice_fails():
+    with pytest.raises(DomainError) as err:
+        invoices.reopen_invoice("INV-nope")
+    assert err.value.code == "E_NOT_FOUND"
+
+
+def test_reopen_unpaid_invoice_fails():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 2, "local")
+    inv = invoices.issue_invoice(s.id)
+    with pytest.raises(DomainError) as err:
+        invoices.reopen_invoice(inv.id)
+    assert err.value.code == "E_BAD_STATE"
+    assert inv.status == "open"
+    assert inv.reopened_at is None
