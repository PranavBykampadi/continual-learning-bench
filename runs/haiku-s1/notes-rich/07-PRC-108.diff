+def outstanding_by_customer():
+    """Map every customer id to the total of their open invoices (Money).
+
+    Paid and void invoices are excluded. Customers with nothing open map to zero.
+    """
+    totals = {customer_id: Money.zero() for customer_id in db.customers}
+    for invoice in db.invoices.values():
+        if invoice.status != "open":
+            continue
+        shipment = db.shipments.get(invoice.shipment_id)
+        if shipment is None:
+            raise DomainError("E_NOT_FOUND", invoice.shipment_id)
+        try:
+            amount = Money.parse(invoice.amount)
+        except (ArithmeticError, ValueError, TypeError):
+            raise DomainError("E_BAD_INPUT", invoice.id)
+        customer_id = shipment.customer_id
+        totals[customer_id] = totals.get(customer_id, Money.zero()) + amount
+    return totals
 
 
