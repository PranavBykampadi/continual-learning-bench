@@ -0,0 +1,29 @@
+from parcelo import customers, invoices, reports, shipments
+from parcelo.money import Money
+
+
+def test_outstanding_by_customer_excludes_paid_and_void():
+    acme = customers.add_customer("Acme")
+    bolt = customers.add_customer("Bolt")
+    idle = customers.add_customer("Idle")
+
+    # Acme: one open invoice (7.00) and one paid invoice (7.00, excluded).
+    open_inv = invoices.issue_invoice(shipments.create_shipment(acme.id, 2, "local").id)
+    paid_inv = invoices.issue_invoice(shipments.create_shipment(acme.id, 2, "local").id)
+    invoices.mark_paid(paid_inv.id)
+
+    # Bolt: one open invoice (11.50) and one void invoice (7.00, excluded).
+    bolt_open = invoices.issue_invoice(shipments.create_shipment(bolt.id, 2, "national").id)
+    bolt_void = invoices.issue_invoice(shipments.create_shipment(bolt.id, 2, "local").id)
+    bolt_void.status = "void"
+
+    result = reports.outstanding_by_customer()
+
+    assert result[acme.id] == Money(700)
+    assert result[bolt.id] == Money(1150)
+    assert result[idle.id] == Money.zero()
+    assert open_inv.status == "open" and bolt_open.status == "open"
+
+
+def test_outstanding_by_customer_empty():
+    assert reports.outstanding_by_customer() == {}
