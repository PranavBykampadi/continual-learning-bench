diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_claims.py b/tests/unit/test_claims.py
--- a/tests/unit/test_claims.py	1969-12-31 19:00:00
+++ b/tests/unit/test_claims.py	2026-11-10 12:37:56
@@ -0,0 +1,72 @@
+from datetime import datetime, timezone
+
+import pytest
+
+from parcelo import audit, claims, clock, customers, shipments, store
+from parcelo.errors import DomainError
+from parcelo.money import Money
+from parcelo.store import db
+
+
+def _delivered_shipment():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 2.0, "national")
+    s.status = "delivered"
+    return s
+
+
+def test_file_claim_stores_and_audits():
+    clock.set_fixed(datetime(2026, 1, 2, 3, 4, 5, tzinfo=timezone.utc))
+    s = _delivered_shipment()
+    claim = claims.file_claim(s.id, 12.5, "broken box")
+    assert claim.id.startswith("clm_")
+    assert claim.shipment_id == s.id
+    assert claim.amount == Money(1250)
+    assert claim.reason == "broken box"
+    assert claim.filed_at == clock.now()
+    assert db.claims[claim.id] is claim
+    assert audit.LOG[-1]["action"] == "claim.filed"
+    assert audit.LOG[-1]["entity_id"] == claim.id
+
+
+def test_reset_clears_claims():
+    s = _delivered_shipment()
+    claims.file_claim(s.id, 1, "late")
+    store.reset()
+    assert db.claims == {}
+
+
+@pytest.mark.parametrize(
+    "amount", [0, -1, -0.01, "0", float("nan"), float("inf"), "abc", None]
+)
+def test_non_positive_or_invalid_amount(amount):
+    s = _delivered_shipment()
+    with pytest.raises(DomainError) as err:
+        claims.file_claim(s.id, amount, "damaged")
+    assert err.value.code == "E_BAD_INPUT"
+    assert db.claims == {}
+
+
+@pytest.mark.parametrize("reason", ["", "   ", None])
+def test_blank_reason_rejected(reason):
+    s = _delivered_shipment()
+    with pytest.raises(DomainError) as err:
+        claims.file_claim(s.id, 5, reason)
+    assert err.value.code == "E_BAD_INPUT"
+    assert db.claims == {}
+
+
+def test_unknown_shipment():
+    with pytest.raises(DomainError) as err:
+        claims.file_claim("shp_missing", 5, "lost")
+    assert err.value.code == "E_NOT_FOUND"
+
+
+@pytest.mark.parametrize("status", ["created", "in_transit", "lost"])
+def test_undelivered_shipment_rejected(status):
+    s = _delivered_shipment()
+    s.status = status
+    with pytest.raises(DomainError) as err:
+        claims.file_claim(s.id, 5, "late")
+    assert err.value.code == "E_BAD_STATE"
+    assert db.claims == {}
