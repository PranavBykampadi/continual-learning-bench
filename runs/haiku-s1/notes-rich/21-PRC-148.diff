diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_disputes.py b/tests/unit/test_disputes.py
--- a/tests/unit/test_disputes.py	1969-12-31 19:00:00
+++ b/tests/unit/test_disputes.py	2026-11-10 12:45:59
@@ -0,0 +1,73 @@
+import pytest
+
+from parcelo import clock, customers, disputes, events, ids, store
+from parcelo.errors import DomainError
+from parcelo.models import Invoice
+
+
+def _make_invoice():
+    customer = customers.add_customer("Acme")
+    invoice = Invoice(
+        id=ids.new_id("inv"),
+        shipment_id="shp_fixture",
+        amount=12.5,
+    )
+    store.db.invoices[invoice.id] = invoice
+    return customer, invoice
+
+
+def test_open_dispute_saves_and_returns_dispute():
+    _, invoice = _make_invoice()
+    events.OUTBOX.clear()
+    d = disputes.open_dispute(invoice.id, "Wrong weight")
+    assert d.id.startswith("dsp_")
+    assert d.invoice_id == invoice.id
+    assert d.reason == "Wrong weight"
+    assert d.opened_at is not None
+    assert store.db.disputes[d.id] is d
+
+
+def test_opened_at_uses_clock():
+    _, invoice = _make_invoice()
+    moment = clock.now()
+    clock.set_fixed(moment)
+    try:
+        d = disputes.open_dispute(invoice.id, "Duplicate charge")
+    finally:
+        clock.clear_fixed()
+    assert d.opened_at == moment
+
+
+def test_open_dispute_emits_event():
+    _, invoice = _make_invoice()
+    events.OUTBOX.clear()
+    d = disputes.open_dispute(invoice.id, "Damaged parcel")
+    assert events.OUTBOX[-1]["name"] == "dispute.opened"
+    assert events.OUTBOX[-1]["entity_id"] == d.id
+
+
+def test_unknown_invoice_fails():
+    events.OUTBOX.clear()
+    with pytest.raises(DomainError) as err:
+        disputes.open_dispute("inv_missing", "Wrong weight")
+    assert err.value.code == "E_NOT_FOUND"
+    assert store.db.disputes == {}
+    assert events.OUTBOX == []
+
+
+@pytest.mark.parametrize("reason", ["", "   ", None])
+def test_empty_reason_fails(reason):
+    _, invoice = _make_invoice()
+    events.OUTBOX.clear()
+    with pytest.raises(DomainError) as err:
+        disputes.open_dispute(invoice.id, reason)
+    assert err.value.code == "E_BAD_INPUT"
+    assert store.db.disputes == {}
+    assert events.OUTBOX == []
+
+
+def test_reset_clears_disputes():
+    _, invoice = _make_invoice()
+    disputes.open_dispute(invoice.id, "Wrong weight")
+    store.reset()
+    assert store.db.disputes == {}
