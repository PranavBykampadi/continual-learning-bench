+from decimal import Decimal
+
+from parcelo.errors import DomainError
+from parcelo.money import Money
+
 ZONE_BASE = {"local": 4.5, "national": 9.0, "international": 24.0}
 PER_KG = 1.25
 
+# Fuel surcharge percentages by zone (same values as legacy fuel_surcharge).
+# Reimplemented here on purpose: parcelo.legacy is scheduled for deletion.
+FUEL_SURCHARGE_PCT = {
+    "local": Decimal("0.0"),
+    "national": Decimal("4.0"),
+    "international": Decimal("9.5"),
+}
+INSURANCE_RATE = Decimal("0.02")
+INSURANCE_MIN_FEE = Money(100)  # 1.00 USD
 
+
 def base_rate(zone):
