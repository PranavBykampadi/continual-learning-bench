@@ -12,3 +27,27 @@
     if weight_kg <= 0:
         raise ValueError("weight must be positive")
     return round(base_rate(zone) + PER_KG * weight_kg, 2)
+
+
+def insurance_fee(declared_value, zone):
+    """Insurance fee for a shipment's declared value, as Money.
+
+    Fee = 2% of declared value + zone fuel surcharge % of declared value,
+    with a minimum fee of 1.00. Raises DomainError:
+      E_BAD_INPUT if declared_value is not a positive amount,
+      E_BAD_ZONE if zone is unknown.
+    """
+    try:
+        value = Money.parse(declared_value)
+    except (ArithmeticError, ValueError, TypeError):
+        raise DomainError("E_BAD_INPUT", "declared value must be a number")
+    if value.cents <= 0:
+        raise DomainError("E_BAD_INPUT", "declared value must be positive")
+    if zone not in FUEL_SURCHARGE_PCT:
+        raise DomainError("E_BAD_ZONE", "unknown zone: %s" % zone)
+
+    rate = INSURANCE_RATE + FUEL_SURCHARGE_PCT[zone] / Decimal("100")
+    fee = value.scale(rate)
+    if fee < INSURANCE_MIN_FEE:
+        return INSURANCE_MIN_FEE
+    return fee
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_insurance.py b/tests/unit/test_insurance.py
--- a/tests/unit/test_insurance.py	1969-12-31 19:00:00
+++ b/tests/unit/test_insurance.py	2026-11-10 12:42:52
@@ -0,0 +1,51 @@
+import pytest
+
+from parcelo import rates
+from parcelo.errors import DomainError
+from parcelo.money import Money
+
+
+def test_insurance_fee_local_is_two_percent():
+    fee = rates.insurance_fee(1000, "local")
+    assert isinstance(fee, Money)
+    assert fee == Money(2000)
+
+
+def test_insurance_fee_adds_fuel_surcharge():
+    # national: 2% + 4% = 6% of 500.00 = 30.00
+    assert rates.insurance_fee(500, "national") == Money(3000)
+    # international: 2% + 9.5% = 11.5% of 100.00 = 11.50
+    assert rates.insurance_fee(100, "international") == Money(1150)
+
+
+def test_insurance_fee_minimum_is_one_dollar():
+    # local, 10.00 declared: 2% = 0.20, bumped to the 1.00 minimum
+    assert rates.insurance_fee(10, "local") == Money(100)
+
+
+def test_insurance_fee_rounds_half_up_to_cent():
+    # national, 1000.25 declared: 6% = 60.015 -> 60.02 (half-up)
+    assert rates.insurance_fee("1000.25", "national") == Money(6002)
+
+
+def test_insurance_fee_accepts_float():
+    assert rates.insurance_fee(250.0, "local") == Money(500)
+
+
+def test_unknown_zone_raises():
+    with pytest.raises(DomainError) as err:
+        rates.insurance_fee(100, "moon")
+    assert err.value.code == "E_BAD_ZONE"
+
+
+@pytest.mark.parametrize("value", [0, -5, -0.01])
+def test_non_positive_value_raises(value):
+    with pytest.raises(DomainError) as err:
+        rates.insurance_fee(value, "local")
+    assert err.value.code == "E_BAD_INPUT"
+
+
+def test_non_numeric_value_raises():
+    with pytest.raises(DomainError) as err:
+        rates.insurance_fee("abc", "local")
+    assert err.value.code == "E_BAD_INPUT"
