diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_reports.py b/tests/unit/test_reports.py
--- a/tests/unit/test_reports.py	1969-12-31 19:00:00
+++ b/tests/unit/test_reports.py	2026-11-10 12:45:06
@@ -0,0 +1,40 @@
+from parcelo import customers, reports, store
+from parcelo.models import Shipment
+
+
+def _make_shipments(customer_id, n):
+    for _ in range(n):
+        sid = f"shp_{len(store.db.shipments) + 1:06d}"
+        store.db.shipments[sid] = Shipment(
+            id=sid,
+            customer_id=customer_id,
+            weight_kg=1.0,
+            zone="local",
+        )
+
+
+def test_volume_report_includes_customers_without_shipments():
+    c = customers.add_customer("Acme")
+    report = reports.volume_report()
+    assert report == {c.id: {"shipments": 0, "tier": "starter"}}
+
+
+def test_volume_report_counts_and_tiers():
+    small = customers.add_customer("Small")
+    mid = customers.add_customer("Mid")
+    big = customers.add_customer("Big")
+    _make_shipments(small.id, 3)
+    _make_shipments(mid.id, 10)
+    _make_shipments(big.id, 50)
+    report = reports.volume_report()
+    assert report[small.id] == {"shipments": 3, "tier": "starter"}
+    assert report[mid.id] == {"shipments": 10, "tier": "regular"}
+    assert report[big.id] == {"shipments": 50, "tier": "bulk"}
+
+
+def test_volume_tier_boundaries():
+    c = customers.add_customer("Edge")
+    _make_shipments(c.id, 9)
+    assert reports.volume_report()[c.id]["tier"] == "starter"
+    _make_shipments(c.id, 1)
+    assert reports.volume_report()[c.id]["tier"] == "regular"
