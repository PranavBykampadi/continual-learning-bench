diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/parcelo/pickups.py b/parcelo/pickups.py
--- a/parcelo/pickups.py	1969-12-31 19:00:00
+++ b/parcelo/pickups.py	2026-11-10 12:42:00
@@ -0,0 +1,22 @@
+from parcelo import clock, events, ids
+from parcelo.errors import DomainError
+from parcelo.models import Pickup
+from parcelo.shipments import get_shipment
+from parcelo.store import db
+
+
+def schedule_pickup(shipment_id, window_start):
+    if not shipment_id or window_start is None:
+        raise DomainError("E_BAD_INPUT", "shipment_id and window_start are required")
+    shipment = get_shipment(shipment_id)  # raises E_NOT_FOUND
+    if shipment.status != "created":
+        raise DomainError("E_BAD_STATE", f"shipment {shipment_id} is {shipment.status}")
+    pickup = Pickup(
+        id=ids.new_id("pkp"),
+        shipment_id=shipment_id,
+        window_start=window_start,
+        scheduled_at=clock.now(),
+    )
+    db.pickups[pickup.id] = pickup
+    events.emit("pickup.scheduled", pickup.id, shipment_id=shipment_id)
+    return pickup
