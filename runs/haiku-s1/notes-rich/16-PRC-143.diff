diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_pickups.py b/tests/unit/test_pickups.py
--- a/tests/unit/test_pickups.py	1969-12-31 19:00:00
+++ b/tests/unit/test_pickups.py	2026-11-10 12:42:02
@@ -0,0 +1,48 @@
+from datetime import datetime, timezone
+
+import pytest
+
+from parcelo import clock, customers, events, pickups, shipments
+from parcelo.errors import DomainError
+from parcelo.models import Pickup
+from parcelo.store import db
+
+WINDOW = datetime(2026, 11, 12, 9, 0, tzinfo=timezone.utc)
+
+
+def test_schedule_pickup_creates_and_emits():
+    clock.set_fixed(datetime(2026, 11, 10, 8, 0, tzinfo=timezone.utc))
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 1.5, "national")
+    p = pickups.schedule_pickup(s.id, WINDOW)
+    assert isinstance(p, Pickup)
+    assert p.id.startswith("pkp_")
+    assert p.shipment_id == s.id
+    assert p.window_start == WINDOW
+    assert p.scheduled_at == clock.now()
+    assert db.pickups[p.id] is p
+    assert events.OUTBOX[-1]["name"] == "pickup.scheduled"
+    assert events.OUTBOX[-1]["entity_id"] == p.id
+
+
+def test_unknown_shipment_fails():
+    with pytest.raises(DomainError) as err:
+        pickups.schedule_pickup("shp_missing", WINDOW)
+    assert err.value.code == "E_NOT_FOUND"
+    assert db.pickups == {}
+
+
+def test_non_created_shipment_fails():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 1.5, "national")
+    s.status = "delivered"
+    with pytest.raises(DomainError) as err:
+        pickups.schedule_pickup(s.id, WINDOW)
+    assert err.value.code == "E_BAD_STATE"
+    assert db.pickups == {}
+
+
+def test_blank_shipment_id_is_bad_input():
+    with pytest.raises(DomainError) as err:
+        pickups.schedule_pickup("", WINDOW)
+    assert err.value.code == "E_BAD_INPUT"
