diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_invoice_void.py b/tests/unit/test_invoice_void.py
--- a/tests/unit/test_invoice_void.py	1969-12-31 19:00:00
+++ b/tests/unit/test_invoice_void.py	2026-11-10 12:30:17
@@ -0,0 +1,38 @@
+import pytest
+
+from parcelo import audit, customers, invoices, shipments
+
+
+def _open_invoice():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 2, "local")
+    return invoices.issue_invoice(s.id)
+
+
+def test_void_open_invoice():
+    inv = _open_invoice()
+    result = invoices.void_invoice(inv.id)
+    assert result is inv
+    assert inv.status == "void"
+    assert inv.voided_at is not None
+    assert audit.LOG[-1]["action"] == "void_invoice"
+
+
+def test_void_unknown_invoice_fails():
+    with pytest.raises(KeyError):
+        invoices.void_invoice("INV-missing")
+
+
+def test_void_paid_invoice_fails():
+    inv = _open_invoice()
+    invoices.mark_paid(inv.id)
+    with pytest.raises(ValueError, match="already paid"):
+        invoices.void_invoice(inv.id)
+    assert inv.status == "paid"
+
+
+def test_void_already_void_invoice_fails():
+    inv = _open_invoice()
+    invoices.void_invoice(inv.id)
+    with pytest.raises(ValueError, match="already void"):
+        invoices.void_invoice(inv.id)
