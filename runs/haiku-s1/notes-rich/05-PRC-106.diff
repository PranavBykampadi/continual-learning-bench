+def _as_utc(moment):
+    # issue_invoice stores naive UTC datetimes; clock.now() is UTC-aware.
+    if moment.tzinfo is None:
+        return moment.replace(tzinfo=timezone.utc)
+    return moment
+
+
+def late_fee_for(invoice_id):
+    invoice = db.invoices.get(invoice_id)
+    if invoice is None:
+        raise DomainError("E_NOT_FOUND", invoice_id)
+    try:
+        amount = Money.parse(invoice.amount)
+    except (ArithmeticError, ValueError, TypeError) as err:
+        raise DomainError("E_BAD_INPUT", str(invoice.amount)) from err
+    days_outstanding = (clock.now() - _as_utc(invoice.issued_at)).days
+    days_late = days_outstanding - LATE_AFTER_DAYS
+    if days_late <= 0:
+        return Money.zero()
+    return amount.scale(LATE_FEE_RATE * days_late)
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_late_fee.py b/tests/unit/test_late_fee.py
--- a/tests/unit/test_late_fee.py	1969-12-31 19:00:00
+++ b/tests/unit/test_late_fee.py	2026-11-10 12:33:39
@@ -0,0 +1,64 @@
+from datetime import datetime, timedelta, timezone
+
+import pytest
+
+from parcelo import clock, invoices
+from parcelo.errors import DomainError
+from parcelo.models import Invoice
+from parcelo.money import Money
+from parcelo.store import db
+
+NOW = datetime(2026, 11, 10, 12, 0, tzinfo=timezone.utc)
+
+
+def _open_invoice(amount, issued_at, invoice_id="INV-late01"):
+    inv = Invoice(id=invoice_id, shipment_id="shp_x", amount=amount, issued_at=issued_at)
+    db.invoices[inv.id] = inv
+    return inv
+
+
+def test_not_late_before_30_days():
+    clock.set_fixed(NOW)
+    inv = _open_invoice(100.0, NOW - timedelta(days=29))
+    assert invoices.late_fee_for(inv.id) == Money.zero()
+
+
+def test_not_late_exactly_30_days():
+    clock.set_fixed(NOW)
+    inv = _open_invoice(100.0, NOW - timedelta(days=30))
+    assert invoices.late_fee_for(inv.id) == Money.zero()
+
+
+def test_one_day_past_30():
+    clock.set_fixed(NOW)
+    inv = _open_invoice(100.0, NOW - timedelta(days=31))
+    # 1.5% of $100.00 = $1.50
+    assert invoices.late_fee_for(inv.id) == Money(150)
+
+
+def test_ten_days_past_30():
+    clock.set_fixed(NOW)
+    inv = _open_invoice(100.0, NOW - timedelta(days=40))
+    # 10 * 1.5% of $100.00 = $15.00
+    assert invoices.late_fee_for(inv.id) == Money(1500)
+
+
+def test_partial_day_does_not_count():
+    clock.set_fixed(NOW)
+    inv = _open_invoice(100.0, NOW - timedelta(days=31, hours=23))
+    assert invoices.late_fee_for(inv.id) == Money(150)
+
+
+def test_naive_issued_at_is_treated_as_utc():
+    # issue_invoice stores naive UTC datetimes.
+    clock.set_fixed(NOW)
+    naive_issued = (NOW - timedelta(days=40)).replace(tzinfo=None)
+    inv = _open_invoice(100.0, naive_issued)
+    assert invoices.late_fee_for(inv.id) == Money(1500)
+
+
+def test_unknown_invoice_fails():
+    clock.set_fixed(NOW)
+    with pytest.raises(DomainError) as err:
+        invoices.late_fee_for("INV-missing")
+    assert err.value.code == "E_NOT_FOUND"
