+def reopen_invoice(invoice_id):
+    """Set a paid invoice back to open, clearing paid_at.
+
+    Records the reopen time in reopened_at (timezone-aware UTC) and emits
+    an invoice.reopened event. Raises E_BAD_INPUT for a blank id,
+    E_NOT_FOUND if the invoice does not exist, and E_BAD_STATE if it is
+    not currently paid.
+    """
+    if not invoice_id:
+        raise DomainError("E_BAD_INPUT", "invoice_id is required")
+    if invoice_id not in db.invoices:
+        raise DomainError("E_NOT_FOUND", invoice_id)
+    invoice = db.invoices[invoice_id]
+    if invoice.status != "paid":
+        raise DomainError("E_BAD_STATE", f"invoice {invoice_id} is {invoice.status}, not paid")
+    invoice.status = "open"
+    invoice.paid_at = None
+    invoice.reopened_at = clock.now()
+    events.emit("invoice.reopened", invoice.id, reopened_at=invoice.reopened_at)
     return invoice
 
 
