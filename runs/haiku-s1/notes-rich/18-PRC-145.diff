 def get_customer(customer_id):
     return db.customers[customer_id]
+
+
+def upgrade_tier(customer_id):
+    """Move a standard customer to the gold tier and return the customer.
+
+    Raises DomainError if the customer does not exist or is not standard
+    (for example, already gold).
+    """
+    if customer_id not in db.customers:
+        raise DomainError("E_UNKNOWN_CUSTOMER", customer_id)
+    customer = db.customers[customer_id]
+    if customer.tier != "standard":
+        raise DomainError("E_BAD_STATE", f"{customer_id} is {customer.tier}, not standard")
+    customer.tier = "gold"
+    events.emit("customer.tier_upgraded", customer.id, tier="gold")
+    return customer
 
 
