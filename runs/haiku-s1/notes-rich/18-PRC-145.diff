diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_upgrade_tier.py b/tests/unit/test_upgrade_tier.py
--- a/tests/unit/test_upgrade_tier.py	1969-12-31 19:00:00
+++ b/tests/unit/test_upgrade_tier.py	2026-11-10 12:43:36
@@ -0,0 +1,34 @@
+import pytest
+
+from parcelo import customers, events
+from parcelo.errors import DomainError
+
+
+def test_upgrade_standard_to_gold():
+    c = customers.add_customer("Acme")
+    result = customers.upgrade_tier(c.id)
+    assert result is c
+    assert customers.get_customer(c.id).tier == "gold"
+
+
+def test_upgrade_emits_event():
+    c = customers.add_customer("Acme")
+    customers.upgrade_tier(c.id)
+    assert events.OUTBOX[-1]["name"] == "customer.tier_upgraded"
+    assert events.OUTBOX[-1]["entity_id"] == c.id
+
+
+def test_upgrade_unknown_customer_fails():
+    with pytest.raises(DomainError) as err:
+        customers.upgrade_tier("C_missing")
+    assert err.value.code == "E_UNKNOWN_CUSTOMER"
+    assert events.OUTBOX == []
+
+
+def test_upgrade_already_gold_fails():
+    c = customers.add_customer("Acme", tier="gold")
+    with pytest.raises(DomainError) as err:
+        customers.upgrade_tier(c.id)
+    assert err.value.code == "E_BAD_STATE"
+    assert customers.get_customer(c.id).tier == "gold"
+    assert events.OUTBOX == []
