+def write_off(invoice_id):
+    """Write off an open invoice we will never collect.
+
+    Sets the status to "written_off", stamps ``written_off_at`` with the
+    current UTC time, and returns the written-off amount as ``Money``.
+    Only open invoices may be written off; anything else raises
+    ``DomainError`` and emits no event.
+    """
+    if invoice_id not in db.invoices:
+        raise DomainError("E_NOT_FOUND", invoice_id)
+    invoice = db.invoices[invoice_id]
+    if invoice.status != "open":
+        raise DomainError("E_BAD_STATE", f"{invoice_id} is {invoice.status}")
+    try:
+        amount = Money.parse(invoice.amount)
+    except (ArithmeticError, ValueError, TypeError) as exc:
+        raise DomainError("E_BAD_INPUT", f"bad amount on {invoice_id}") from exc
+    invoice.status = "written_off"
+    invoice.written_off_at = clock.now()
+    events.emit("invoice.written_off", invoice_id, amount_cents=amount.cents)
+    return amount
 
 
