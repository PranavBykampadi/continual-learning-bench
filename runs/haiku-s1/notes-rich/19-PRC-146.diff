@@ -0,0 +1,61 @@
+from datetime import datetime, timezone
+
+import pytest
+
+from parcelo import clock, customers, events, invoices, shipments
+from parcelo.errors import DomainError
+from parcelo.models import Invoice
+from parcelo.money import Money
+from parcelo.store import db
+
+
+def _open_invoice():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 2, "local")
+    return invoices.issue_invoice(s.id)
+
+
+def test_write_off_open_invoice():
+    moment = datetime(2026, 11, 10, 9, 30, tzinfo=timezone.utc)
+    clock.set_fixed(moment)
+    inv = _open_invoice()
+    events.OUTBOX.clear()
+
+    amount = invoices.write_off(inv.id)
+
+    assert isinstance(amount, Money)
+    assert amount == Money(700)
+    assert inv.status == "written_off"
+    assert inv.written_off_at == moment
+    assert events.OUTBOX[-1]["name"] == "invoice.written_off"
+    assert events.OUTBOX[-1]["entity_id"] == inv.id
+
+
+def test_write_off_rounds_half_up_to_cents():
+    inv = Invoice(id="INV-X", shipment_id="shp_x", amount=12.345)
+    db.invoices[inv.id] = inv
+    assert invoices.write_off(inv.id) == Money(1235)
+
+
+def test_write_off_unknown_invoice():
+    events.OUTBOX.clear()
+    with pytest.raises(DomainError) as err:
+        invoices.write_off("INV-missing")
+    assert err.value.code == "E_NOT_FOUND"
+    assert events.OUTBOX == []
+
+
+@pytest.mark.parametrize("status", ["paid", "written_off"])
+def test_write_off_rejects_non_open_invoice(status):
+    inv = _open_invoice()
+    if status == "paid":
+        invoices.mark_paid(inv.id)
+    else:
+        invoices.write_off(inv.id)
+    events.OUTBOX.clear()
+
+    with pytest.raises(DomainError) as err:
+        invoices.write_off(inv.id)
+    assert err.value.code == "E_BAD_STATE"
+    assert events.OUTBOX == []
+    assert inv.status == status
