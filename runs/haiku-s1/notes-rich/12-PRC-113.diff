+def apply_credit(invoice_id, amount):
+    """Reduce an open invoice by a credit and return the remaining amount.
+
+    The invoice amount is stored as a float (reports and customer balances
+    sum it directly), but the arithmetic is done in integer cents via Money.
+    """
+    if not invoice_id or not str(invoice_id).strip():
+        raise DomainError("E_BAD_INPUT", "invoice_id required")
+    try:
+        credit = Money.parse(amount)
+    except (ArithmeticError, ValueError, TypeError):
+        raise DomainError("E_BAD_INPUT", f"bad credit amount: {amount!r}")
+    if credit.cents <= 0:
+        raise DomainError("E_BAD_INPUT", f"credit must be positive: {amount!r}")
+    if invoice_id not in db.invoices:
+        raise DomainError("E_NOT_FOUND", invoice_id)
+    invoice = db.invoices[invoice_id]
+    if invoice.status != "open":
+        raise DomainError("E_BAD_STATE", f"invoice {invoice_id} is {invoice.status}")
+    current = Money.parse(invoice.amount)
+    if credit.cents > current.cents:
+        raise DomainError(
+            "E_BAD_INPUT", f"credit {credit} exceeds invoice amount {current}"
+        )
+    remaining = current - credit
+    invoice.amount = remaining.cents / 100
+    audit.record(
+        "invoice.credit_applied",
+        invoice_id,
+        credit_cents=credit.cents,
+        remaining_cents=remaining.cents,
+    )
+    return invoice.amount
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_apply_credit.py b/tests/unit/test_apply_credit.py
--- a/tests/unit/test_apply_credit.py	1969-12-31 19:00:00
+++ b/tests/unit/test_apply_credit.py	2026-11-10 12:39:11
@@ -0,0 +1,106 @@
+import pytest
+
+from parcelo import audit, customers, invoices, shipments
+from parcelo.errors import DomainError
+
+
+def _open_invoice(weight=2, zone="local"):
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, weight, zone)
+    inv = invoices.issue_invoice(s.id)
+    return c, inv
+
+
+def test_apply_credit_reduces_amount_and_returns_remaining():
+    _, inv = _open_invoice()
+    assert inv.amount == 7.0
+    remaining = invoices.apply_credit(inv.id, 2)
+    assert remaining == 5.0
+    assert inv.amount == 5.0
+    assert inv.status == "open"
+
+
+def test_apply_credit_records_audit():
+    _, inv = _open_invoice()
+    invoices.apply_credit(inv.id, 2)
+    entry = audit.LOG[-1]
+    assert entry["action"] == "invoice.credit_applied"
+    assert entry["entity_id"] == inv.id
+
+
+def test_credit_is_reflected_in_customer_balance():
+    c, inv = _open_invoice()
+    invoices.apply_credit(inv.id, 2.5)
+    assert customers.outstanding_balance(c.id) == 4.5
+
+
+def test_credit_is_reflected_in_revenue_after_payment():
+    from parcelo import reports
+
+    _, inv = _open_invoice()
+    invoices.apply_credit(inv.id, 2)
+    invoices.mark_paid(inv.id)
+    assert reports.revenue_total() == 5.0
+
+
+def test_credit_equal_to_amount_leaves_zero_balance():
+    c, inv = _open_invoice()
+    assert invoices.apply_credit(inv.id, 7.0) == 0.0
+    assert customers.outstanding_balance(c.id) == 0.0
+
+
+def test_unknown_invoice_fails():
+    with pytest.raises(DomainError) as err:
+        invoices.apply_credit("INV-nope", 1)
+    assert err.value.code == "E_NOT_FOUND"
+
+
+def test_paid_invoice_fails():
+    _, inv = _open_invoice()
+    invoices.mark_paid(inv.id)
+    with pytest.raises(DomainError) as err:
+        invoices.apply_credit(inv.id, 1)
+    assert err.value.code == "E_BAD_STATE"
+    assert inv.amount == 7.0
+
+
+def test_credit_larger_than_amount_fails():
+    _, inv = _open_invoice()
+    with pytest.raises(DomainError) as err:
+        invoices.apply_credit(inv.id, 7.01)
+    assert err.value.code == "E_BAD_INPUT"
+    assert inv.amount == 7.0
+    assert not [e for e in audit.LOG if e["action"] == "invoice.credit_applied"]
+
+
+@pytest.mark.parametrize("bad", [0, -1, -0.5])
+def test_non_positive_credit_fails(bad):
+    _, inv = _open_invoice()
+    with pytest.raises(DomainError) as err:
+        invoices.apply_credit(inv.id, bad)
+    assert err.value.code == "E_BAD_INPUT"
+    assert inv.amount == 7.0
+
+
+@pytest.mark.parametrize("bad", [None, "", "   ", "abc", float("nan")])
+def test_bad_credit_value_fails(bad):
+    _, inv = _open_invoice()
+    with pytest.raises(DomainError) as err:
+        invoices.apply_credit(inv.id, bad)
+    assert err.value.code == "E_BAD_INPUT"
+    assert inv.amount == 7.0
+
+
+@pytest.mark.parametrize("bad", [None, "", "   "])
+def test_blank_invoice_id_fails(bad):
+    with pytest.raises(DomainError) as err:
+        invoices.apply_credit(bad, 1)
+    assert err.value.code == "E_BAD_INPUT"
+
+
+def test_credit_uses_exact_cents():
+    _, inv = _open_invoice()
+    # 0.1 + 0.2 style float drift must not leak into the remaining amount.
+    invoices.apply_credit(inv.id, 0.1)
+    invoices.apply_credit(inv.id, 0.2)
+    assert inv.amount == 6.7
