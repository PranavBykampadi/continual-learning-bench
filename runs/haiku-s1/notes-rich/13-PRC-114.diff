+def _as_utc(moment):
+    """Attach UTC to naive datetimes (issue_invoice stores naive utcnow())."""
+    if moment.tzinfo is None:
+        return moment.replace(tzinfo=timezone.utc)
+    return moment
+
+
+def aging_report():
+    """Total open invoices by age in whole days since issued_at.
+
+    Buckets: "0-30", "31-60", "60+". Paid invoices are excluded.
+    Returns a dict of Money values; empty buckets are Money.zero().
+    """
+    now = clock.now()
+    buckets = {"0-30": Money.zero(), "31-60": Money.zero(), "60+": Money.zero()}
+    for invoice in db.invoices.values():
+        if invoice.status != "open":
+            continue
+        age = days_between(_as_utc(invoice.issued_at), now)
+        if age <= 30:
+            key = "0-30"
+        elif age <= 60:
+            key = "31-60"
+        else:
+            key = "60+"
+        buckets[key] = buckets[key] + Money.parse(invoice.amount)
+    return buckets
 
 
