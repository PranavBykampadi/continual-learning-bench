--- a/tests/unit/test_reports.py	1969-12-31 19:00:00
+++ b/tests/unit/test_reports.py	2026-11-10 12:39:53
@@ -0,0 +1,52 @@
+from datetime import datetime, timedelta, timezone
+
+from parcelo import clock
+from parcelo.models import Invoice
+from parcelo.money import Money
+from parcelo.reports import aging_report
+from parcelo.store import db
+
+NOW = datetime(2026, 11, 10, 12, 0, tzinfo=timezone.utc)
+
+
+def _add(inv_id, age_days, amount, status="open", naive=False):
+    issued = NOW - timedelta(days=age_days)
+    if naive:
+        issued = issued.replace(tzinfo=None)
+    db.invoices[inv_id] = Invoice(
+        id=inv_id, shipment_id="shp_x", amount=amount, status=status, issued_at=issued
+    )
+
+
+def test_buckets_and_boundaries():
+    clock.set_fixed(NOW)
+    _add("a", 0, 1.0)
+    _add("b", 30, 2.0)
+    _add("c", 31, 3.0)
+    _add("d", 60, 4.0)
+    _add("e", 61, 5.0)
+    assert aging_report() == {
+        "0-30": Money(300),
+        "31-60": Money(700),
+        "60+": Money(500),
+    }
+
+
+def test_paid_invoices_excluded():
+    clock.set_fixed(NOW)
+    _add("a", 5, 10.0)
+    _add("b", 5, 99.0, status="paid")
+    assert aging_report()["0-30"] == Money(1000)
+
+
+def test_empty_buckets_are_zero_money():
+    clock.set_fixed(NOW)
+    report = aging_report()
+    assert report == {"0-30": Money.zero(), "31-60": Money.zero(), "60+": Money.zero()}
+    assert all(isinstance(v, Money) for v in report.values())
+
+
+def test_naive_issued_at_is_treated_as_utc():
+    clock.set_fixed(NOW)
+    _add("a", 45, 2.5, naive=True)
+    assert aging_report()["31-60"] == Money(250)
