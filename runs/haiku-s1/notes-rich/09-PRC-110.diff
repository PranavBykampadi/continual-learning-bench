+++ b/tests/unit/test_gold_discount.py	2026-11-10 12:36:38
@@ -0,0 +1,32 @@
+import pytest
+
+from parcelo.errors import DomainError
+from parcelo.money import Money
+from parcelo.rates import discounted_quote
+
+
+def test_gold_is_ten_percent_off():
+    # local base 4.5 + 1.25 * 2 = 7.00 -> 700 cents -> 630 cents
+    assert discounted_quote(2, "local", "gold") == Money(630)
+
+
+def test_standard_is_full_price():
+    assert discounted_quote(2, "local", "standard") == Money(700)
+
+
+def test_gold_rounds_half_up_to_cent():
+    # local 4.5 + 1.25 * 0.2 = 4.75 -> 475 cents; 90% = 427.5 -> 428
+    assert discounted_quote(0.2, "local", "gold") == Money(428)
+
+
+def test_unknown_zone_fails():
+    with pytest.raises(DomainError) as err:
+        discounted_quote(2, "moon", "gold")
+    assert err.value.code == "E_BAD_ZONE"
+
+
+@pytest.mark.parametrize("tier", ["platinum", "", "Gold"])
+def test_unknown_tier_fails(tier):
+    with pytest.raises(DomainError) as err:
+        discounted_quote(2, "local", tier)
+    assert err.value.code == "E_BAD_INPUT"
