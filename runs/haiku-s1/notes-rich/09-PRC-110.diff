+from decimal import Decimal
+
+from parcelo.errors import DomainError
+from parcelo.money import Money
+
 ZONE_BASE = {"local": 4.5, "national": 9.0, "international": 24.0}
 PER_KG = 1.25
 
+# Fraction of the regular quote that each customer tier pays.
+TIER_FACTOR = {"standard": Decimal("1"), "gold": Decimal("0.90")}
 
+
 def base_rate(zone):
     if zone not in ZONE_BASE:
         raise ValueError("unknown zone: %s" % zone)
@@ -12,3 +20,17 @@
     if weight_kg <= 0:
         raise ValueError("weight must be positive")
     return round(base_rate(zone) + PER_KG * weight_kg, 2)
+
+
+def discounted_quote(weight_kg, zone, tier):
+    """Regular quote for weight and zone, scaled by the tier factor.
+
+    Returns Money. Gold is 10% off; standard is full price. Rounds half-up
+    to the cent via Money.scale.
+    """
+    if zone not in ZONE_BASE:
+        raise DomainError("E_BAD_ZONE", str(zone))
+    if tier not in TIER_FACTOR:
+        raise DomainError("E_BAD_INPUT", "unknown tier: %s" % (tier,))
+    regular = Money.parse(quote(weight_kg, zone))
+    return regular.scale(TIER_FACTOR[tier])
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_gold_discount.py b/tests/unit/test_gold_discount.py
