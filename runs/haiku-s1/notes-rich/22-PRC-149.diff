+def split_shipment(shipment_id, weights):
+    """Replace a "created" shipment with one new shipment per weight.
+
+    The original is marked "split". The weights must be positive numbers that
+    add up exactly to the original weight. Validation happens before any
+    mutation, so a failed split leaves the store and outbox untouched.
+    """
+    if shipment_id not in db.shipments:
+        raise DomainError("E_NOT_FOUND", shipment_id)
+    original = db.shipments[shipment_id]
+    if original.status != "created":
+        raise DomainError("E_BAD_STATE", f"{shipment_id} is {original.status}")
+
+    if not isinstance(weights, (list, tuple)) or len(weights) == 0:
+        raise DomainError("E_BAD_INPUT", "weights must be a non-empty list")
+    decimals = []
+    for w in weights:
+        if isinstance(w, bool) or not isinstance(w, (int, float, str, Decimal)):
+            raise DomainError("E_BAD_WEIGHT", repr(w))
+        try:
+            d = Decimal(str(w))
+        except (ArithmeticError, ValueError, TypeError):
+            raise DomainError("E_BAD_WEIGHT", repr(w))
+        if not d.is_finite() or d <= 0:
+            raise DomainError("E_BAD_WEIGHT", repr(w))
+        decimals.append(d)
+
+    if sum(decimals, Decimal(0)) != Decimal(str(original.weight_kg)):
+        raise DomainError(
+            "E_BAD_WEIGHT",
+            f"weights sum to {sum(decimals, Decimal(0))}, expected {original.weight_kg}",
+        )
+
+    new_shipments = [
+        create_shipment(original.customer_id, float(d), original.zone) for d in decimals
+    ]
+    original.status = "split"
+    events.emit(
+        "shipment.split",
+        shipment_id,
+        into=[s.id for s in new_shipments],
+    )
+    return new_shipments
