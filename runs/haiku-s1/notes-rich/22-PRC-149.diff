+import pytest
+
+from parcelo import customers, events, shipments
+from parcelo.errors import DomainError
+from parcelo.store import db
+
+
+def _created(weight=10.0, zone="national"):
+    c = customers.add_customer("Acme")
+    return shipments.create_shipment(c.id, weight, zone)
+
+
+def test_split_replaces_original_with_new_shipments_in_order():
+    s = _created(10.0, "national")
+    events.OUTBOX.clear()
+
+    result = shipments.split_shipment(s.id, [4.0, 6.0])
+
+    assert [r.weight_kg for r in result] == [4.0, 6.0]
+    assert all(r.customer_id == s.customer_id for r in result)
+    assert all(r.zone == "national" for r in result)
+    assert all(r.status == "created" for r in result)
+    assert db.shipments[s.id].status == "split"
+
+
+def test_split_emits_events():
+    s = _created(10.0)
+    events.OUTBOX.clear()
+
+    result = shipments.split_shipment(s.id, [3.0, 7.0])
+
+    names = [e["name"] for e in events.OUTBOX]
+    assert names == ["shipment.created", "shipment.created", "shipment.split"]
+    assert events.OUTBOX[-1]["entity_id"] == s.id
+    assert events.OUTBOX[-1]["payload"]["into"] == [r.id for r in result]
+
+
+def test_split_unknown_shipment_fails():
+    events.OUTBOX.clear()
+    with pytest.raises(DomainError) as err:
+        shipments.split_shipment("shp_missing", [1.0])
+    assert err.value.code == "E_NOT_FOUND"
+    assert events.OUTBOX == []
+
+
+def test_split_non_created_shipment_fails():
+    s = _created(10.0)
+    db.shipments[s.id].status = "delivered"
+    events.OUTBOX.clear()
+    with pytest.raises(DomainError) as err:
+        shipments.split_shipment(s.id, [5.0, 5.0])
+    assert err.value.code == "E_BAD_STATE"
+    assert db.shipments[s.id].status == "delivered"
+    assert events.OUTBOX == []
+
+
+def test_split_already_split_fails():
+    s = _created(10.0)
+    shipments.split_shipment(s.id, [5.0, 5.0])
+    with pytest.raises(DomainError) as err:
+        shipments.split_shipment(s.id, [5.0, 5.0])
+    assert err.value.code == "E_BAD_STATE"
+
+
+def test_split_weights_must_sum_to_original():
+    s = _created(10.0)
+    events.OUTBOX.clear()
+    with pytest.raises(DomainError) as err:
+        shipments.split_shipment(s.id, [4.0, 5.0])
+    assert err.value.code == "E_BAD_WEIGHT"
+    assert db.shipments[s.id].status == "created"
+    assert len(db.shipments) == 1
+    assert events.OUTBOX == []
+
+
+def test_split_rejects_non_positive_weight():
+    s = _created(10.0)
+    with pytest.raises(DomainError) as err:
+        shipments.split_shipment(s.id, [12.0, -2.0])
+    assert err.value.code == "E_BAD_WEIGHT"
+    assert db.shipments[s.id].status == "created"
+
+
+def test_split_rejects_empty_weights():
+    s = _created(10.0)
+    with pytest.raises(DomainError) as err:
+        shipments.split_shipment(s.id, [])
+    assert err.value.code == "E_BAD_INPUT"
+    assert db.shipments[s.id].status == "created"
+
+
