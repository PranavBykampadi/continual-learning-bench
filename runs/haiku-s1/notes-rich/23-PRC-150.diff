diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_customer_credit_limit.py b/tests/unit/test_customer_credit_limit.py
--- a/tests/unit/test_customer_credit_limit.py	1969-12-31 19:00:00
+++ b/tests/unit/test_customer_credit_limit.py	2026-11-10 12:47:50
@@ -0,0 +1,65 @@
+from decimal import Decimal
+
+import pytest
+
+from parcelo import customers, events
+from parcelo.errors import DomainError
+from parcelo.store import db
+
+
+def test_set_credit_limit_updates_and_returns_new_limit():
+    c = customers.add_customer("Acme")
+    events.OUTBOX.clear()
+
+    result = customers.set_credit_limit(c.id, 1250.5)
+
+    assert result == 1250.5
+    assert db.customers[c.id].credit_limit == 1250.5
+    assert events.OUTBOX[-1]["name"] == "customer.credit_limit_changed"
+    assert events.OUTBOX[-1]["entity_id"] == c.id
+    assert events.OUTBOX[-1]["payload"] == {"old": 500.0, "new": 1250.5}
+
+
+@pytest.mark.parametrize("amount", [0, "300.10", Decimal("42.07")])
+def test_set_credit_limit_accepts_numeric_forms(amount):
+    c = customers.add_customer("Acme")
+
+    result = customers.set_credit_limit(c.id, amount)
+
+    assert result == float(Decimal(str(amount)))
+    assert db.customers[c.id].credit_limit == result
+
+
+def test_set_credit_limit_unknown_customer_fails():
+    events.OUTBOX.clear()
+
+    with pytest.raises(DomainError) as err:
+        customers.set_credit_limit("C_missing", 100)
+
+    assert err.value.code == "E_NOT_FOUND"
+    assert events.OUTBOX == []
+
+
+def test_set_credit_limit_negative_fails_and_leaves_state_untouched():
+    c = customers.add_customer("Acme")
+    events.OUTBOX.clear()
+
+    with pytest.raises(DomainError) as err:
+        customers.set_credit_limit(c.id, -1)
+
+    assert err.value.code == "E_BAD_INPUT"
+    assert db.customers[c.id].credit_limit == 500.0
+    assert events.OUTBOX == []
+
+
+@pytest.mark.parametrize("amount", ["lots", None, True, [1], float("nan")])
+def test_set_credit_limit_rejects_non_numeric_input(amount):
+    c = customers.add_customer("Acme")
+    events.OUTBOX.clear()
+
+    with pytest.raises(DomainError) as err:
+        customers.set_credit_limit(c.id, amount)
+
+    assert err.value.code == "E_BAD_INPUT"
+    assert db.customers[c.id].credit_limit == 500.0
+    assert events.OUTBOX == []
