+def set_credit_limit(customer_id, amount):
+    """Set a customer's credit limit and return the new limit.
+
+    Validates everything before writing, so a failed call leaves the store
+    and the outbox untouched.
+    """
+    if customer_id not in db.customers:
+        raise DomainError("E_NOT_FOUND", customer_id)
+    if isinstance(amount, bool):
+        raise DomainError("E_BAD_INPUT", "credit limit must be a number")
+    try:
+        # Money.parse accepts int, float, str, or Decimal and rounds to cents.
+        # Invalid input raises decimal.InvalidOperation (an ArithmeticError),
+        # NaN/inf raise ValueError, and unsupported types raise TypeError.
+        limit = Money.parse(amount)
+    except (ArithmeticError, TypeError, ValueError):
+        raise DomainError("E_BAD_INPUT", f"credit limit must be a number: {amount!r}")
+    if limit.cents < 0:
+        raise DomainError("E_BAD_INPUT", "credit limit cannot be negative")
+
+    customer = db.customers[customer_id]
+    old = customer.credit_limit
+    new = limit.cents / 100
+    customer.credit_limit = new
+    events.emit("customer.credit_limit_changed", customer_id, old=old, new=new)
+    return new
 
 
