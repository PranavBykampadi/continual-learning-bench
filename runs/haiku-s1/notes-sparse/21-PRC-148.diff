diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_disputes.py b/tests/unit/test_disputes.py
--- a/tests/unit/test_disputes.py	1969-12-31 19:00:00
+++ b/tests/unit/test_disputes.py	2026-11-10 12:46:28
@@ -0,0 +1,51 @@
+from datetime import datetime, timezone
+
+import pytest
+
+from parcelo import audit, clock, customers, disputes, invoices, shipments, store
+from parcelo.errors import DomainError
+
+
+def _invoice():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 2, "local")
+    return invoices.issue_invoice(s.id)
+
+
+def test_open_dispute_saves_and_returns():
+    inv = _invoice()
+    moment = datetime(2026, 11, 10, 12, 0, tzinfo=timezone.utc)
+    clock.set_fixed(moment)
+    d = disputes.open_dispute(inv.id, "wrong weight")
+    assert d.id.startswith("dsp_")
+    assert d.invoice_id == inv.id
+    assert d.reason == "wrong weight"
+    assert d.opened_at == moment
+    assert store.db.disputes[d.id] is d
+
+
+def test_open_dispute_records_audit():
+    inv = _invoice()
+    d = disputes.open_dispute(inv.id, "wrong weight")
+    assert audit.LOG[-1]["action"] == "dispute.opened"
+    assert audit.LOG[-1]["entity_id"] == d.id
+    assert audit.LOG[-1]["details"] == {"invoice_id": inv.id}
+
+
+def test_unknown_invoice_rejected():
+    with pytest.raises(DomainError) as err:
+        disputes.open_dispute("INV-missing", "wrong weight")
+    assert err.value.code == "E_NOT_FOUND"
+    assert "INV-missing" in err.value.message
+    assert store.db.disputes == {}
+    assert audit.LOG == []
+
+
+@pytest.mark.parametrize("reason", ["", "   "])
+def test_empty_reason_rejected(reason):
+    inv = _invoice()
+    with pytest.raises(DomainError) as err:
+        disputes.open_dispute(inv.id, reason)
+    assert err.value.code == "E_BAD_INPUT"
+    assert store.db.disputes == {}
+    assert audit.LOG == []
