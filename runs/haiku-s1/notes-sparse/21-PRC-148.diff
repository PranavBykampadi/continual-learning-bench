@@ -0,0 +1,20 @@
+from parcelo import audit, clock, ids
+from parcelo.errors import DomainError
+from parcelo.models import Dispute
+from parcelo.store import db
+
+
+def open_dispute(invoice_id, reason):
+    if not reason or not reason.strip():
+        raise DomainError("E_BAD_INPUT", f"dispute reason must not be empty, got {reason!r}")
+    if invoice_id not in db.invoices:
+        raise DomainError("E_NOT_FOUND", f"unknown invoice: {invoice_id}")
+    dispute = Dispute(
+        id=ids.new_id("dsp"),
+        invoice_id=invoice_id,
+        reason=reason,
+        opened_at=clock.now(),
+    )
+    db.disputes[dispute.id] = dispute
+    audit.record("dispute.opened", dispute.id, invoice_id=invoice_id)
+    return dispute
