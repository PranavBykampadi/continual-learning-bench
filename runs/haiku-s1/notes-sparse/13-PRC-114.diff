+from datetime import datetime, timezone
 
+from parcelo import clock
+from parcelo.invoices import open_invoices
+from parcelo.legacy.billing import days_between
+from parcelo.money import Money
 from parcelo.store import db
+
+AGING_BUCKETS = ("0-30", "31-60", "60+")
+
+
+def _as_naive_utc(moment):
+    """Invoices store naive UTC timestamps; clock.now() is tz-aware. Normalize to naive UTC."""
+    if moment.tzinfo is not None:
+        moment = moment.astimezone(timezone.utc).replace(tzinfo=None)
+    return moment
+
+
+def _aging_bucket(age_days):
+    if age_days <= 30:
+        return "0-30"
+    if age_days <= 60:
+        return "31-60"
+    return "60+"
+
+
+def aging_report():
+    """Total open invoice amounts per age bucket, by whole days since issue."""
+    now = _as_naive_utc(clock.now())
+    totals = {bucket: Money.zero() for bucket in AGING_BUCKETS}
+    for invoice in open_invoices():
+        age = days_between(_as_naive_utc(invoice.issued_at), now)
+        bucket = _aging_bucket(age)
+        totals[bucket] = totals[bucket] + Money.parse(invoice.amount)
+    return {bucket: total.cents / 100 for bucket, total in totals.items()}
 
 
