--- a/tests/test_reports.py	1969-12-31 19:00:00
+++ b/tests/test_reports.py	2026-11-10 12:39:39
@@ -0,0 +1,49 @@
+from datetime import datetime, timedelta, timezone
+
+from parcelo import clock, customers, invoices, shipments
+from parcelo.reports import aging_report
+
+NOW = datetime(2026, 11, 10, tzinfo=timezone.utc)
+
+
+def _issued_invoice(issued_at):
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 2, "local")
+    inv = invoices.issue_invoice(s.id)  # local, 2 kg -> 7.0
+    inv.issued_at = issued_at
+    return inv
+
+
+def _report_at(moment):
+    clock.set_fixed(moment)
+    try:
+        return aging_report()
+    finally:
+        clock.clear_fixed()
+
+
+def test_aging_report_empty():
+    assert _report_at(NOW) == {"0-30": 0.0, "31-60": 0.0, "60+": 0.0}
+
+
+def test_aging_report_bucket_boundaries():
+    naive_now = NOW.replace(tzinfo=None)
+    _issued_invoice(naive_now - timedelta(days=0))   # age 0  -> 0-30
+    _issued_invoice(naive_now - timedelta(days=30))  # age 30 -> 0-30
+    _issued_invoice(naive_now - timedelta(days=31))  # age 31 -> 31-60
+    _issued_invoice(naive_now - timedelta(days=60))  # age 60 -> 31-60
+    _issued_invoice(naive_now - timedelta(days=61))  # age 61 -> 60+
+    assert _report_at(NOW) == {"0-30": 14.0, "31-60": 14.0, "60+": 7.0}
+
+
+def test_aging_report_excludes_paid():
+    naive_now = NOW.replace(tzinfo=None)
+    inv = _issued_invoice(naive_now - timedelta(days=5))
+    _issued_invoice(naive_now - timedelta(days=90))
+    invoices.mark_paid(inv.id)
+    assert _report_at(NOW) == {"0-30": 0.0, "31-60": 0.0, "60+": 7.0}
+
+
+def test_aging_report_accepts_tz_aware_issued_at():
+    _issued_invoice(datetime(2026, 10, 1, 12, 0, tzinfo=timezone.utc))  # age 40
+    assert _report_at(NOW) == {"0-30": 0.0, "31-60": 7.0, "60+": 0.0}
