diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_customers.py b/tests/unit/test_customers.py
--- a/tests/unit/test_customers.py	1969-12-31 19:00:00
+++ b/tests/unit/test_customers.py	2026-11-10 12:35:43
@@ -0,0 +1,53 @@
+import pytest
+
+from parcelo import audit, customers
+from parcelo.errors import DomainError
+from parcelo.models import Address
+from parcelo.store import db
+
+
+def _customer():
+    return customers.add_customer("Acme")
+
+
+def test_add_address_stores_and_returns_address():
+    c = _customer()
+    addr = customers.add_address(c.id, "1 Main St", "Springfield")
+    assert isinstance(addr, Address)
+    assert addr.id.startswith("adr_")
+    assert addr.customer_id == c.id
+    assert addr.line == "1 Main St"
+    assert addr.city == "Springfield"
+    assert db.addresses[addr.id] is addr
+
+
+def test_add_address_records_audit():
+    c = _customer()
+    addr = customers.add_address(c.id, "1 Main St", "Springfield")
+    assert audit.LOG[-1]["action"] == "address.added"
+    assert audit.LOG[-1]["entity_id"] == addr.id
+
+
+def test_add_address_unknown_customer():
+    with pytest.raises(DomainError) as err:
+        customers.add_address("nope", "1 Main St", "Springfield")
+    assert err.value.code == "E_UNKNOWN_CUSTOMER"
+    assert db.addresses == {}
+
+
+@pytest.mark.parametrize("line", ["", "   "])
+def test_add_address_empty_line(line):
+    c = _customer()
+    with pytest.raises(DomainError) as err:
+        customers.add_address(c.id, line, "Springfield")
+    assert err.value.code == "E_BAD_INPUT"
+    assert db.addresses == {}
+
+
+@pytest.mark.parametrize("city", ["", "  "])
+def test_add_address_empty_city(city):
+    c = _customer()
+    with pytest.raises(DomainError) as err:
+        customers.add_address(c.id, "1 Main St", city)
+    assert err.value.code == "E_BAD_INPUT"
+    assert db.addresses == {}
