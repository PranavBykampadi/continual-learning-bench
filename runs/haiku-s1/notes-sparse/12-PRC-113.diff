@@ -1,9 +1,73 @@
-from parcelo import customers, invoices, shipments
+import pytest
 
+from parcelo import audit, customers, invoices, reports, shipments
+from parcelo.errors import DomainError
 
+
+def _helper():
+    """Open invoice for 2 kg local shipment (7.0)."""
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 2, "local")
+    return c, invoices.issue_invoice(s.id)
+
+
 def test_issue_and_pay():
     c = customers.add_customer("Acme")
     s = shipments.create_shipment(c.id, 2, "local")
     inv = invoices.issue_invoice(s.id)
     assert inv.amount == 7.0
     assert invoices.mark_paid(inv.id).status == "paid"
+
+
+def test_apply_credit_partial_updates_balance_and_audits():
+    c, inv = _helper()
+    assert invoices.apply_credit(inv.id, 2.0) == 5.0
+    assert inv.amount == 5.0
+    assert inv.status == "open"
+    assert customers.outstanding_balance(c.id) == 5.0
+    assert audit.LOG[-1]["action"] == "invoice.credit_applied"
+
+
+def test_apply_credit_then_pay_flows_into_revenue():
+    _, inv = _helper()
+    invoices.apply_credit(inv.id, 2.25)
+    invoices.mark_paid(inv.id)
+    assert reports.revenue_total() == 4.75
+
+
+def test_apply_credit_equal_to_amount_leaves_zero():
+    _, inv = _helper()
+    assert invoices.apply_credit(inv.id, 7.0) == 0.0
+    assert inv.amount == 0.0
+
+
+def test_apply_credit_unknown_invoice():
+    with pytest.raises(DomainError) as err:
+        invoices.apply_credit("INV-missing", 1.0)
+    assert err.value.code == "E_NOT_FOUND"
+
+
+def test_apply_credit_to_paid_invoice_fails():
+    _, inv = _helper()
+    invoices.mark_paid(inv.id)
+    with pytest.raises(DomainError) as err:
+        invoices.apply_credit(inv.id, 1.0)
+    assert err.value.code == "E_BAD_STATE"
+    assert inv.amount == 7.0
+
+
+def test_apply_credit_larger_than_amount_fails():
+    _, inv = _helper()
+    with pytest.raises(DomainError) as err:
+        invoices.apply_credit(inv.id, 7.01)
+    assert err.value.code == "E_BAD_INPUT"
+    assert inv.amount == 7.0
+
+
+@pytest.mark.parametrize("bad", [0, -1.0])
+def test_apply_credit_non_positive_fails(bad):
+    _, inv = _helper()
+    with pytest.raises(DomainError) as err:
+        invoices.apply_credit(inv.id, bad)
+    assert err.value.code == "E_BAD_INPUT"
+    assert inv.amount == 7.0
