diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_reports.py b/tests/unit/test_reports.py
--- a/tests/unit/test_reports.py	1969-12-31 19:00:00
+++ b/tests/unit/test_reports.py	2026-11-10 12:45:25
@@ -0,0 +1,35 @@
+from parcelo import customers, reports, shipments
+
+
+def test_volume_report_includes_customers_without_shipments():
+    c = customers.add_customer("Acme")
+    assert reports.volume_report() == {
+        c.id: {"shipments": 0, "tier": "starter"},
+    }
+
+
+def test_volume_report_counts_shipments_per_customer():
+    a = customers.add_customer("Acme")
+    b = customers.add_customer("Globex")
+    for _ in range(3):
+        shipments.create_shipment(a.id, 1.0, "local")
+    shipments.create_shipment(b.id, 2.0, "national")
+    report = reports.volume_report()
+    assert report[a.id] == {"shipments": 3, "tier": "starter"}
+    assert report[b.id] == {"shipments": 1, "tier": "starter"}
+
+
+def test_volume_report_tier_boundaries():
+    regular = customers.add_customer("Regular")
+    bulk = customers.add_customer("Bulk")
+    for _ in range(10):
+        shipments.create_shipment(regular.id, 1.0, "local")
+    for _ in range(50):
+        shipments.create_shipment(bulk.id, 1.0, "local")
+    report = reports.volume_report()
+    assert report[regular.id] == {"shipments": 10, "tier": "regular"}
+    assert report[bulk.id] == {"shipments": 50, "tier": "bulk"}
+
+
+def test_volume_report_empty():
+    assert reports.volume_report() == {}
