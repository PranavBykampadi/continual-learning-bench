diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_claims.py b/tests/unit/test_claims.py
--- a/tests/unit/test_claims.py	1969-12-31 19:00:00
+++ b/tests/unit/test_claims.py	2026-11-10 12:37:41
@@ -0,0 +1,63 @@
+from datetime import datetime, timezone
+
+import pytest
+
+from parcelo import audit, claims, clock, customers, shipments
+from parcelo.errors import DomainError
+from parcelo.store import db
+
+
+def _delivered_shipment():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 1.5, "national")
+    s.status = "delivered"
+    return s
+
+
+def test_file_claim_on_delivered_shipment():
+    clock.set_fixed(datetime(2026, 11, 10, 12, 0, tzinfo=timezone.utc))
+    try:
+        s = _delivered_shipment()
+        claim = claims.file_claim(s.id, 25.0, "box damaged")
+    finally:
+        clock.clear_fixed()
+    assert claim.id.startswith("clm_")
+    assert claim.shipment_id == s.id
+    assert claim.amount == 25.0
+    assert claim.reason == "box damaged"
+    assert claim.filed_at == datetime(2026, 11, 10, 12, 0, tzinfo=timezone.utc)
+    assert db.claims[claim.id] is claim
+    assert audit.LOG[-1]["action"] == "claim.filed"
+
+
+@pytest.mark.parametrize("amount", [0, -5, 0.0, True, None, "10", float("nan")])
+def test_bad_amount(amount):
+    s = _delivered_shipment()
+    with pytest.raises(DomainError) as err:
+        claims.file_claim(s.id, amount, "late")
+    assert err.value.code == "E_BAD_INPUT"
+    assert db.claims == {}
+
+
+@pytest.mark.parametrize("reason", ["", "   ", None])
+def test_bad_reason(reason):
+    s = _delivered_shipment()
+    with pytest.raises(DomainError) as err:
+        claims.file_claim(s.id, 10, reason)
+    assert err.value.code == "E_BAD_INPUT"
+    assert db.claims == {}
+
+
+def test_missing_shipment():
+    with pytest.raises(DomainError) as err:
+        claims.file_claim("shp_missing", 10, "lost")
+    assert err.value.code == "E_NOT_FOUND"
+
+
+def test_undelivered_shipment_rejected():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 1.5, "national")
+    with pytest.raises(DomainError) as err:
+        claims.file_claim(s.id, 10, "lost")
+    assert err.value.code == "E_BAD_STATE"
+    assert db.claims == {}
