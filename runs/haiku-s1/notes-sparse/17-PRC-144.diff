@@ -1,5 +1,10 @@
+from parcelo.errors import DomainError
+from parcelo.legacy.billing import FUEL_SURCHARGE_PCT
+
 ZONE_BASE = {"local": 4.5, "national": 9.0, "international": 24.0}
 PER_KG = 1.25
+INSURANCE_RATE_PCT = 2.0
+MIN_INSURANCE_FEE = 1.00
 
 
 def base_rate(zone):
@@ -12,3 +17,15 @@
     if weight_kg <= 0:
         raise ValueError("weight must be positive")
     return round(base_rate(zone) + PER_KG * weight_kg, 2)
+
+
+def insurance_fee(declared_value, zone):
+    """Insurance fee: 2% of declared value plus the zone's fuel surcharge
+    percentage of declared value, with a minimum fee of MIN_INSURANCE_FEE."""
+    if zone not in FUEL_SURCHARGE_PCT:
+        raise DomainError("E_BAD_ZONE", zone)
+    if declared_value <= 0:
+        raise DomainError("E_BAD_INPUT", "declared value must be positive: %s" % declared_value)
+    pct = INSURANCE_RATE_PCT + FUEL_SURCHARGE_PCT[zone]
+    fee = declared_value * pct / 100.0
+    return round(max(fee, MIN_INSURANCE_FEE), 2)
