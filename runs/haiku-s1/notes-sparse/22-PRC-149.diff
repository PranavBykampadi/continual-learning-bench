+
+
+def test_split_creates_one_shipment_per_weight():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 3.0, "national")
+    parts = shipments.split_shipment(s.id, [1.0, 2.0])
+    assert [p.weight_kg for p in parts] == [1.0, 2.0]
+    for p in parts:
+        assert p.customer_id == c.id
+        assert p.zone == "national"
+        assert p.status == "created"
+    assert shipments.get_shipment(s.id).status == "split"
+
+
+def test_split_emits_created_events():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 3.0, "national")
+    events.OUTBOX.clear()
+    parts = shipments.split_shipment(s.id, [1.0, 2.0])
+    created = [e["entity_id"] for e in events.OUTBOX if e["name"] == "shipment.created"]
+    assert created == [p.id for p in parts]
+
+
+def test_split_records_audit():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 3.0, "national")
+    parts = shipments.split_shipment(s.id, [1.0, 2.0])
+    entry = audit.LOG[-1]
+    assert entry["action"] == "shipment.split"
+    assert entry["entity_id"] == s.id
+    assert entry["details"] == {"new_ids": [p.id for p in parts]}
+
+
