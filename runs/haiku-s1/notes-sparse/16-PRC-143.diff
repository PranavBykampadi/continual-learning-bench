     assert err.value.code == "E_UNKNOWN_CUSTOMER"
+
+
+def test_schedule_pickup_saves_and_audits():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 1.5, "national")
+    window = datetime(2026, 11, 12, 9, 0, tzinfo=timezone.utc)
+    booked = datetime(2026, 11, 10, 8, 30, tzinfo=timezone.utc)
+    clock.set_fixed(booked)
+    try:
+        p = pickups.schedule_pickup(s.id, window)
+    finally:
+        clock.clear_fixed()
+    assert p.id.startswith("pck_")
+    assert p.shipment_id == s.id
+    assert p.window_start == window
+    assert p.scheduled_at == booked
+    assert store.db.pickups[p.id] is p
+    assert audit.LOG[-1]["action"] == "pickup.scheduled"
+    assert audit.LOG[-1]["entity_id"] == p.id
+
+
+def test_schedule_pickup_unknown_shipment():
+    window = datetime(2026, 11, 12, 9, 0, tzinfo=timezone.utc)
+    with pytest.raises(DomainError) as err:
+        pickups.schedule_pickup("shp_missing", window)
+    assert err.value.code == "E_NOT_FOUND"
+    assert store.db.pickups == {}
+
+
+def test_schedule_pickup_requires_created_status():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 1.5, "national")
+    # No status transition exists in shipments.py yet, so set it directly.
+    s.status = "delivered"
+    window = datetime(2026, 11, 12, 9, 0, tzinfo=timezone.utc)
+    with pytest.raises(DomainError) as err:
+        pickups.schedule_pickup(s.id, window)
+    assert err.value.code == "E_BAD_STATE"
+    assert store.db.pickups == {}
