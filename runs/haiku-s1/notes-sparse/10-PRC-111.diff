+from parcelo import audit, clock, customers, shipments
 from parcelo.errors import DomainError
+
+
+def _shipment():
+    c = customers.add_customer("Acme")
+    return shipments.create_shipment(c.id, 1.5, "national")
+
+
+def test_add_note_appends_timestamped_entry():
+    s = _shipment()
+    moment = datetime(2026, 11, 10, 12, 0, 0, tzinfo=timezone.utc)
+    clock.set_fixed(moment)
+    result = shipments.add_note(s.id, "left at door")
+    assert result is s
+    assert s.notes == [{"text": "left at door", "at": moment}]
+
+
+def test_add_note_keeps_order_and_times():
+    s = _shipment()
+    first = datetime(2026, 11, 10, 12, 0, 0, tzinfo=timezone.utc)
+    second = datetime(2026, 11, 10, 13, 0, 0, tzinfo=timezone.utc)
+    clock.set_fixed(first)
+    shipments.add_note(s.id, "one")
+    clock.set_fixed(second)
+    shipments.add_note(s.id, "two")
+    assert [n["text"] for n in s.notes] == ["one", "two"]
+    assert [n["at"] for n in s.notes] == [first, second]
+
+
+def test_add_note_unknown_shipment():
+    with pytest.raises(DomainError) as err:
+        shipments.add_note("shp_missing", "hi")
+    assert err.value.code == "E_NOT_FOUND"
+
+
+@pytest.mark.parametrize("text", ["", "   ", None])
+def test_add_note_rejects_empty_text(text):
+    s = _shipment()
+    with pytest.raises(DomainError) as err:
+        shipments.add_note(s.id, text)
+    assert err.value.code == "E_BAD_INPUT"
+    assert s.notes == []
 
 
