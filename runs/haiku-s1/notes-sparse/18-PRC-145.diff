+def upgrade_tier(customer_id):
+    if customer_id not in db.customers:
+        raise DomainError("E_NOT_FOUND", f"unknown customer: {customer_id}")
+    customer = db.customers[customer_id]
+    if customer.tier != "standard":
+        raise DomainError(
+            "E_BAD_STATE",
+            f"customer {customer_id} is tier {customer.tier}, not standard",
+        )
+    customer.tier = "gold"
+    audit.record(
+        "customer.upgraded", customer_id, from_tier="standard", to_tier="gold"
+    )
+    return customer
 
 
