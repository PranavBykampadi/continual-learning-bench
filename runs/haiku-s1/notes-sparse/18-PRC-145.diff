diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_customers.py b/tests/unit/test_customers.py
--- a/tests/unit/test_customers.py	1969-12-31 19:00:00
+++ b/tests/unit/test_customers.py	2026-11-10 12:43:25
@@ -0,0 +1,34 @@
+import pytest
+
+from parcelo import audit, customers
+from parcelo.errors import DomainError
+
+
+def test_upgrade_standard_to_gold():
+    c = customers.add_customer("Acme")
+    upgraded = customers.upgrade_tier(c.id)
+    assert upgraded is c
+    assert c.tier == "gold"
+
+
+def test_upgrade_records_audit():
+    c = customers.add_customer("Acme")
+    customers.upgrade_tier(c.id)
+    assert audit.LOG[-1]["action"] == "customer.upgraded"
+    assert audit.LOG[-1]["entity_id"] == c.id
+
+
+def test_upgrade_unknown_customer():
+    with pytest.raises(DomainError) as err:
+        customers.upgrade_tier("nope")
+    assert err.value.code == "E_NOT_FOUND"
+    assert "nope" in err.value.message
+
+
+def test_upgrade_already_gold():
+    c = customers.add_customer("Acme", tier="gold")
+    with pytest.raises(DomainError) as err:
+        customers.upgrade_tier(c.id)
+    assert err.value.code == "E_BAD_STATE"
+    assert c.tier == "gold"
+    assert audit.LOG == []
