+
+
+def test_discounted_quote_gold_takes_10_percent_off():
+    # regular quote 7.0 -> 6.3 after 10% off
+    assert rates.discounted_quote(2, "local", "gold") == 6.3
+
+
+def test_discounted_quote_standard_is_regular_quote():
+    assert rates.discounted_quote(2, "local", "standard") == 7.0
+
+
+def test_discounted_quote_unknown_tier():
+    with pytest.raises(DomainError) as exc:
+        rates.discounted_quote(2, "local", "platinum")
+    assert exc.value.code == "E_BAD_INPUT"
+
+
+def test_discounted_quote_unknown_zone():
+    with pytest.raises(DomainError) as exc:
+        rates.discounted_quote(2, "moon", "gold")
+    assert exc.value.code == "E_BAD_ZONE"
+
+
+def test_discounted_quote_non_positive_weight():
+    with pytest.raises(DomainError) as exc:
+        rates.discounted_quote(0, "local", "gold")
+    assert exc.value.code == "E_BAD_WEIGHT"
