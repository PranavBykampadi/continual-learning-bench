+from parcelo.errors import DomainError
+
 ZONE_BASE = {"local": 4.5, "national": 9.0, "international": 24.0}
 PER_KG = 1.25
+# Percent off the regular quote, by customer tier.
+TIER_DISCOUNT_PCT = {"standard": 0.0, "gold": 10.0}
 
 
 def base_rate(zone):
@@ -12,3 +16,20 @@
     if weight_kg <= 0:
         raise ValueError("weight must be positive")
     return round(base_rate(zone) + PER_KG * weight_kg, 2)
+
+
+def discounted_quote(weight_kg, zone, tier):
+    """Quote for weight and zone with the percentage discount for ``tier``.
+
+    Uses the same percentage math as ``legacy.billing.apply_discount``:
+    ``round(amount * (1 - pct / 100.0), 2)``.
+    """
+    if tier not in TIER_DISCOUNT_PCT:
+        raise DomainError("E_BAD_INPUT", "unknown tier: %s" % (tier,))
+    if zone not in ZONE_BASE:
+        raise DomainError("E_BAD_ZONE", "unknown zone: %s" % (zone,))
+    if weight_kg <= 0:
+        raise DomainError("E_BAD_WEIGHT", "weight must be positive")
+    amount = quote(weight_kg, zone)
+    pct = TIER_DISCOUNT_PCT[tier]
+    return round(amount * (1 - pct / 100.0), 2)
