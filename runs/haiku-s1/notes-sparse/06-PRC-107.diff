@@ -1,9 +1,14 @@
 import pytest
 
-from parcelo import audit, customers, shipments
+from parcelo import audit, clock, customers, shipments, store
 from parcelo.errors import DomainError
 
 
+def _helper():
+    c = customers.add_customer("Acme")
+    return shipments.create_shipment(c.id, 1.5, "national")
+
+
 def test_create_records_audit():
     c = customers.add_customer("Acme")
     s = shipments.create_shipment(c.id, 1.5, "national")
@@ -15,3 +20,47 @@
     with pytest.raises(DomainError) as err:
         shipments.create_shipment("nope", 1, "local")
     assert err.value.code == "E_UNKNOWN_CUSTOMER"
+
+
+def test_mark_delivered_sets_status_and_time():
+    s = _helper()
+    moment = clock.now()
+    clock.set_fixed(moment)
+    result = shipments.mark_delivered(s.id)
+    assert result is s
+    assert s.status == "delivered"
+    assert s.delivered_at == moment
+    assert audit.LOG[-1]["action"] == "shipment.delivered"
+    assert audit.LOG[-1]["entity_id"] == s.id
+
+
+def test_mark_delivered_unknown_shipment():
+    with pytest.raises(DomainError) as err:
+        shipments.mark_delivered("shp_missing")
+    assert err.value.code == "E_NOT_FOUND"
+
+
+def test_mark_delivered_cancelled_fails_without_state_change():
+    s = _helper()
+    s.status = "cancelled"
+    audit.LOG.clear()
+    with pytest.raises(DomainError) as err:
+        shipments.mark_delivered(s.id)
+    assert err.value.code == "E_BAD_STATE"
+    assert store.db.shipments[s.id].status == "cancelled"
+    assert s.delivered_at is None
+    assert audit.LOG == []
+
+
+def test_mark_delivered_twice_fails_without_state_change():
+    s = _helper()
+    first = clock.now()
+    clock.set_fixed(first)
+    shipments.mark_delivered(s.id)
+    audit.LOG.clear()
+    clock.set_fixed(first.replace(year=first.year + 1))
+    with pytest.raises(DomainError) as err:
+        shipments.mark_delivered(s.id)
+    assert err.value.code == "E_BAD_STATE"
+    assert s.delivered_at == first
+    assert audit.LOG == []
