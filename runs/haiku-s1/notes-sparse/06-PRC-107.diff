diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/parcelo/shipments.py b/parcelo/shipments.py
--- a/parcelo/shipments.py	2026-11-10 12:17:53
+++ b/parcelo/shipments.py	2026-11-10 12:34:11
@@ -28,3 +28,13 @@
     if shipment_id not in db.shipments:
         raise DomainError("E_NOT_FOUND", shipment_id)
     return db.shipments[shipment_id]
+
+
+def mark_delivered(shipment_id):
+    shipment = get_shipment(shipment_id)
+    if shipment.status in ("cancelled", "delivered"):
+        raise DomainError("E_BAD_STATE", f"{shipment_id} is {shipment.status}")
+    shipment.status = "delivered"
+    shipment.delivered_at = clock.now()
+    audit.record("shipment.delivered", shipment.id)
+    return shipment
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_shipments.py b/tests/unit/test_shipments.py
