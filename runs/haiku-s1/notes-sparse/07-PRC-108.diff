diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/test_reports.py b/tests/test_reports.py
--- a/tests/test_reports.py	1969-12-31 19:00:00
+++ b/tests/test_reports.py	2026-11-10 12:34:57
@@ -0,0 +1,36 @@
+from parcelo import customers, invoices, reports, shipments
+
+
+def _helper():
+    return customers.add_customer("Acme"), customers.add_customer("Globex")
+
+
+def test_outstanding_counts_only_open_invoices():
+    acme, globex = _helper()
+    s1 = shipments.create_shipment(acme.id, 2, "local")
+    s2 = shipments.create_shipment(acme.id, 2, "local")
+    s3 = shipments.create_shipment(globex.id, 2, "local")
+    inv1 = invoices.issue_invoice(s1.id)
+    invoices.issue_invoice(s2.id)
+    invoices.issue_invoice(s3.id)
+    invoices.mark_paid(inv1.id)
+
+    result = reports.outstanding_by_customer()
+
+    assert result[acme.id] == 7.0
+    assert result[globex.id] == 7.0
+
+
+def test_customer_with_no_open_invoices_maps_to_zero():
+    acme, globex = _helper()
+    s1 = shipments.create_shipment(acme.id, 2, "local")
+    inv = invoices.issue_invoice(s1.id)
+    invoices.mark_paid(inv.id)
+
+    result = reports.outstanding_by_customer()
+
+    assert result == {acme.id: 0.0, globex.id: 0.0}
+
+
+def test_empty_store_returns_empty_dict():
+    assert reports.outstanding_by_customer() == {}
