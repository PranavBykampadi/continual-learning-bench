-from parcelo import customers, invoices, shipments
+from datetime import datetime, timezone
 
+import pytest
 
+from parcelo import audit, clock, customers, invoices, shipments
+from parcelo.errors import DomainError
+from parcelo.store import db
+
+
 def test_issue_and_pay():
     c = customers.add_customer("Acme")
     s = shipments.create_shipment(c.id, 2, "local")
     inv = invoices.issue_invoice(s.id)
     assert inv.amount == 7.0
     assert invoices.mark_paid(inv.id).status == "paid"
+
+
+def _open_invoice():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 2, "local")
+    return invoices.issue_invoice(s.id)
+
+
+def test_write_off_open_invoice_returns_amount():
+    inv = _open_invoice()
+    assert invoices.write_off(inv.id) == 7.0
+    assert db.invoices[inv.id].status == "written_off"
+
+
+def test_write_off_sets_timestamp():
+    moment = datetime(2026, 11, 10, 9, 30, tzinfo=timezone.utc)
+    clock.set_fixed(moment)
+    inv = _open_invoice()
+    invoices.write_off(inv.id)
+    assert inv.written_off_at == moment
+
+
+def test_write_off_records_audit():
+    inv = _open_invoice()
+    invoices.write_off(inv.id)
+    entry = audit.LOG[-1]
+    assert entry["action"] == "invoice.written_off"
+    assert entry["entity_id"] == inv.id
+    assert entry["details"] == {"amount": 7.0}
+
+
+def test_write_off_paid_invoice_rejected():
+    inv = _open_invoice()
+    invoices.mark_paid(inv.id)
+    with pytest.raises(DomainError) as err:
+        invoices.write_off(inv.id)
+    assert err.value.code == "E_BAD_STATE"
+    assert db.invoices[inv.id].status == "paid"
+    assert audit.LOG == []
+
+
+def test_write_off_twice_rejected():
+    inv = _open_invoice()
+    invoices.write_off(inv.id)
+    with pytest.raises(DomainError) as err:
+        invoices.write_off(inv.id)
+    assert err.value.code == "E_BAD_STATE"
+
+
+def test_write_off_unknown_invoice():
+    with pytest.raises(DomainError) as err:
+        invoices.write_off("INV-missing")
+    assert err.value.code == "E_NOT_FOUND"
