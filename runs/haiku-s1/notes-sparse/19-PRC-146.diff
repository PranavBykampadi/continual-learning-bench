+def write_off(invoice_id):
+    if invoice_id not in db.invoices:
+        raise DomainError("E_NOT_FOUND", f"unknown invoice: {invoice_id}")
+    invoice = db.invoices[invoice_id]
+    if invoice.status != "open":
+        raise DomainError(
+            "E_BAD_STATE",
+            f"invoice {invoice_id} is {invoice.status}, only open invoices can be written off",
+        )
+    invoice.status = "written_off"
+    invoice.written_off_at = clock.now()
+    audit.record("invoice.written_off", invoice_id, amount=invoice.amount)
+    return invoice.amount
 
 
