+def set_credit_limit(customer_id, amount):
+    if amount < 0:
+        raise DomainError(
+            "E_BAD_INPUT", f"credit limit must not be negative, got {amount}"
+        )
+    if customer_id not in db.customers:
+        raise DomainError("E_NOT_FOUND", f"unknown customer: {customer_id}")
+    customer = db.customers[customer_id]
+    customer.credit_limit = amount
+    audit.record("customer.credit_limit_set", customer_id, amount=amount)
