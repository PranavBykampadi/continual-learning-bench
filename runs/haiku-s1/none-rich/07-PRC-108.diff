diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/test_reports.py b/tests/test_reports.py
--- a/tests/test_reports.py	1969-12-31 19:00:00
+++ b/tests/test_reports.py	2026-11-10 12:33:40
@@ -0,0 +1,23 @@
+from parcelo import customers, invoices, reports, shipments
+
+
+def test_outstanding_by_customer_counts_only_open_invoices():
+    acme = customers.add_customer("Acme")
+    globex = customers.add_customer("Globex")
+    idle = customers.add_customer("Idle")
+
+    s1 = shipments.create_shipment(acme.id, 2, "local")  # 7.0
+    s2 = shipments.create_shipment(acme.id, 2, "local")  # 7.0, will be paid
+    s3 = shipments.create_shipment(globex.id, 2, "local")  # 7.0
+
+    open_inv = invoices.issue_invoice(s1.id)
+    paid_inv = invoices.issue_invoice(s2.id)
+    invoices.issue_invoice(s3.id)
+    invoices.mark_paid(paid_inv.id)
+
+    result = reports.outstanding_by_customer()
+
+    assert result[acme.id] == open_inv.amount
+    assert result[globex.id] == 7.0
+    assert result[idle.id] == 0.0
+    assert set(result) == {acme.id, globex.id, idle.id}
