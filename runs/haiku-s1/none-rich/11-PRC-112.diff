+++ b/parcelo/claims.py	2026-11-10 12:35:39
@@ -0,0 +1,38 @@
+import math
+from decimal import Decimal
+
+from parcelo import audit, clock, ids
+from parcelo.errors import DomainError
+from parcelo.models import Claim
+from parcelo.shipments import get_shipment
+from parcelo.store import db
+
+DELIVERED = "delivered"
+
+
+def _valid_amount(amount):
+    if isinstance(amount, bool) or not isinstance(amount, (int, float, Decimal)):
+        return False
+    if isinstance(amount, float) and not math.isfinite(amount):
+        return False
+    return amount > 0
+
+
+def file_claim(shipment_id, amount, reason):
+    shipment = get_shipment(shipment_id)  # raises E_NOT_FOUND if missing
+    if shipment.status != DELIVERED:
+        raise DomainError(
+            "E_BAD_STATE", f"{shipment_id} is {shipment.status}, not {DELIVERED}"
+        )
+    if not _valid_amount(amount):
+        raise DomainError("E_BAD_INPUT", f"amount must be positive, got {amount!r}")
+    claim = Claim(
+        id=ids.new_id("clm"),
+        shipment_id=shipment_id,
+        amount=amount,
+        reason=reason,
+        filed_at=clock.now(),
+    )
+    db.claims[claim.id] = claim
+    audit.record("claim.filed", claim.id, shipment_id=shipment_id)
+    return claim
