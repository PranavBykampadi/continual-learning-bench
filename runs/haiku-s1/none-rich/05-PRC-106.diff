+from datetime import datetime, timedelta
 
+import pytest
 
+from parcelo import clock, customers, invoices, shipments
+from parcelo.errors import DomainError
+from parcelo.models import Invoice
+from parcelo.store import db
+
+
 def test_issue_and_pay():
     c = customers.add_customer("Acme")
     s = shipments.create_shipment(c.id, 2, "local")
     inv = invoices.issue_invoice(s.id)
     assert inv.amount == 7.0
     assert invoices.mark_paid(inv.id).status == "paid"
+
+
+def _invoice_issued_days_ago(days):
+    issued = datetime(2026, 1, 1, 12, 0, 0)
+    db.invoices["INV-T"] = Invoice(id="INV-T", shipment_id="S", amount=100.0, issued_at=issued)
+    clock.set_fixed(issued + timedelta(days=days))
+
+
+def test_late_fee_zero_before_30_days():
+    _invoice_issued_days_ago(29)
+    assert invoices.late_fee_for("INV-T") == 0.0
+
+
+def test_late_fee_zero_at_exactly_30_days():
+    _invoice_issued_days_ago(30)
+    assert invoices.late_fee_for("INV-T") == 0.0
+
+
+def test_late_fee_accrues_per_day_after_30():
+    _invoice_issued_days_ago(40)
+    assert invoices.late_fee_for("INV-T") == 15.0  # 10 days * 1.5% of 100
+
+
+def test_late_fee_unknown_invoice_raises():
+    with pytest.raises(DomainError):
+        invoices.late_fee_for("INV-NOPE")
