 def open_invoices():
     return [i for i in db.invoices.values() if i.status == "open"]
+
+
+def late_fee_for(invoice_id):
+    """Late fee accrued so far on an invoice.
+
+    The invoice is late 30 days after issue; from then on the fee is 1.5% of
+    the invoice amount for each full day past those 30 days. Zero if not late.
+    Raises DomainError(E_NOT_FOUND) if the invoice does not exist.
+    """
+    if invoice_id not in db.invoices:
+        raise DomainError("E_NOT_FOUND", invoice_id)
+    invoice = db.invoices[invoice_id]
+    elapsed = _as_naive_utc(clock.now()) - _as_naive_utc(invoice.issued_at)
+    days_late = max(0, (elapsed - LATE_AFTER).days)
+    return _legacy_late_fee(invoice.amount, days_late)
