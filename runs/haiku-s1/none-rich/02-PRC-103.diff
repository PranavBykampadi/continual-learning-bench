@@ -1,3 +1,5 @@
+from parcelo.legacy.billing import fuel_surcharge
+
 ZONE_BASE = {"local": 4.5, "national": 9.0, "international": 24.0}
 PER_KG = 1.25
 
@@ -12,3 +14,23 @@
     if weight_kg <= 0:
         raise ValueError("weight must be positive")
     return round(base_rate(zone) + PER_KG * weight_kg, 2)
+
+
+def quote_with_surcharge(weight_kg, zone):
+    """Return the quote for weight and zone plus the zone's fuel surcharge.
+
+    Returns a dict with keys:
+      - "quote": the base quote from ``quote``
+      - "surcharge": the fuel surcharge on that quote, using the same
+        percentages as ``parcelo.legacy.billing.fuel_surcharge``
+      - "total": quote + surcharge, rounded to 2 places
+
+    Raises ValueError for an unknown zone or a weight <= 0.
+    """
+    base = quote(weight_kg, zone)  # validates weight and zone
+    surcharge = fuel_surcharge(base, zone)
+    return {
+        "quote": base,
+        "surcharge": surcharge,
+        "total": round(base + surcharge, 2),
+    }
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/test_rates.py b/tests/test_rates.py
--- a/tests/test_rates.py	2026-11-10 12:17:53
+++ b/tests/test_rates.py	2026-11-10 12:30:50
@@ -10,3 +10,35 @@
 def test_unknown_zone():
     with pytest.raises(ValueError):
         rates.base_rate("moon")
+
+
+def test_quote_with_surcharge_local_has_no_surcharge():
+    result = rates.quote_with_surcharge(2, "local")
+    assert result == {"quote": 7.0, "surcharge": 0.0, "total": 7.0}
+
+
+def test_quote_with_surcharge_national():
+    # quote 9.0 + 2*1.25 = 11.5; 4% surcharge = 0.46
+    result = rates.quote_with_surcharge(2, "national")
+    assert result["quote"] == 11.5
+    assert result["surcharge"] == 0.46
+    assert result["total"] == 11.96
+
+
+def test_quote_with_surcharge_international():
+    # quote 24.0 + 2*1.25 = 26.5; 9.5% surcharge = 2.5175 -> ~2.52
+    result = rates.quote_with_surcharge(2, "international")
+    assert result["quote"] == 26.5
+    assert result["surcharge"] == pytest.approx(2.52, abs=0.01)
+    assert result["total"] == pytest.approx(29.02, abs=0.01)
+
+
+def test_quote_with_surcharge_unknown_zone():
+    with pytest.raises(ValueError):
+        rates.quote_with_surcharge(2, "moon")
+
+
+@pytest.mark.parametrize("weight", [0, -1, -0.5])
+def test_quote_with_surcharge_nonpositive_weight(weight):
+    with pytest.raises(ValueError):
+        rates.quote_with_surcharge(weight, "national")
