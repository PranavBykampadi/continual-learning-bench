diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/test_reports.py b/tests/test_reports.py
--- a/tests/test_reports.py	1969-12-31 19:00:00
+++ b/tests/test_reports.py	2026-11-10 12:39:43
@@ -0,0 +1,38 @@
+from parcelo import reports
+from parcelo.models import Customer, Shipment
+from parcelo.store import db
+
+
+def _add_shipments(customer_id, n):
+    for i in range(n):
+        sid = customer_id + "-s" + str(i)
+        db.shipments[sid] = Shipment(
+            id=sid, customer_id=customer_id, weight_kg=1.0, zone="local"
+        )
+
+
+def test_volume_report_includes_all_customers_and_tiers():
+    db.customers["A"] = Customer(id="A", name="Alpha")
+    db.customers["B"] = Customer(id="B", name="Beta")
+    db.customers["C"] = Customer(id="C", name="Gamma")
+    _add_shipments("A", 0)
+    _add_shipments("B", 10)
+    _add_shipments("C", 50)
+
+    assert reports.volume_report() == {
+        "A": {"shipments": 0, "tier": "starter"},
+        "B": {"shipments": 10, "tier": "regular"},
+        "C": {"shipments": 50, "tier": "bulk"},
+    }
+
+
+def test_volume_report_empty():
+    assert reports.volume_report() == {}
+
+
+def test_volume_report_ignores_unknown_customer_shipments():
+    db.customers["A"] = Customer(id="A", name="Alpha")
+    _add_shipments("A", 3)
+    _add_shipments("ghost", 2)
+
+    assert reports.volume_report() == {"A": {"shipments": 3, "tier": "starter"}}
