+"""Business thresholds, limits and rates."""
+from decimal import Decimal
+
+# Volume rebate (PRC-161): share of paid invoices, by shipment count.
+REBATE_REGULAR_MIN_SHIPMENTS = 10
+REBATE_BULK_MIN_SHIPMENTS = 50
+REBATE_REGULAR_RATE = Decimal("0.03")
+REBATE_BULK_RATE = Decimal("0.06")
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_customer_rebate.py b/tests/unit/test_customer_rebate.py
--- a/tests/unit/test_customer_rebate.py	1969-12-31 19:00:00
+++ b/tests/unit/test_customer_rebate.py	2026-11-12 02:18:21
@@ -0,0 +1,44 @@
+import pytest
+
+from parcelo import customers, shipments
+from parcelo.errors import DomainError
+from parcelo.models import Invoice
+from parcelo.money import Money
+from parcelo.store import db
+
+
+def _customer_with(shipment_count, paid=100.0, open_amount=0.0):
+    c = customers.add_customer("Acme")
+    for _ in range(shipment_count):
+        s = shipments.create_shipment(c.id, 1, "local")
+        db.invoices[f"{s.id}p"] = Invoice(id=f"{s.id}p", shipment_id=s.id, amount=paid, status="paid")
+        if open_amount:
+            db.invoices[f"{s.id}o"] = Invoice(id=f"{s.id}o", shipment_id=s.id, amount=open_amount)
+    return c
+
+
+def test_below_threshold_is_zero():
+    c = _customer_with(9)
+    assert customers.rebate_for(c.id) == Money.zero()
+
+
+def test_regular_tier_three_percent_of_paid_only():
+    c = _customer_with(10, paid=100.0, open_amount=50.0)
+    assert customers.rebate_for(c.id) == Money(3000)  # 3% of 1000.00
+
+
+def test_bulk_tier_six_percent():
+    c = _customer_with(50, paid=10.0)
+    assert customers.rebate_for(c.id) == Money(3000)  # 6% of 500.00
+
+
+def test_ignores_other_customers():
+    c = _customer_with(10, paid=100.0)
+    _customer_with(50, paid=999.0)
+    assert customers.rebate_for(c.id) == Money(3000)
+
+
+def test_unknown_customer():
+    with pytest.raises(DomainError) as err:
+        customers.rebate_for("nope")
+    assert err.value.code == "E_UNKNOWN_CUSTOMER"
