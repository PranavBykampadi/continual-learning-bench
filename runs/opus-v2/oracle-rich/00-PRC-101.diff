diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/parcelo/shipments.py b/parcelo/shipments.py
--- a/parcelo/shipments.py	2026-11-10 12:17:53
+++ b/parcelo/shipments.py	2026-11-12 01:50:17
@@ -28,3 +28,15 @@
     if shipment_id not in db.shipments:
         raise DomainError("E_NOT_FOUND", shipment_id)
     return db.shipments[shipment_id]
+
+
+def cancel_shipment(shipment_id, reason):
+    shipment = get_shipment(shipment_id)
+    if shipment.status in ("cancelled", "delivered"):
+        raise DomainError(
+            "E_BAD_STATE", f"cannot cancel {shipment.status} shipment {shipment_id}"
+        )
+    shipment.status = "cancelled"
+    shipment.notes.append(reason)
+    audit.record("shipment.cancelled", shipment.id, reason=reason)
+    return shipment
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_cancel_shipment.py b/tests/unit/test_cancel_shipment.py
--- a/tests/unit/test_cancel_shipment.py	1969-12-31 19:00:00
+++ b/tests/unit/test_cancel_shipment.py	2026-11-12 01:50:21
@@ -0,0 +1,48 @@
+import pytest
+
+from parcelo import audit, customers, shipments
+from parcelo.errors import DomainError
+
+
+def _shipment():
+    c = customers.add_customer("Acme")
+    return shipments.create_shipment(c.id, 2.0, "national")
+
+
+def test_cancel_sets_status_notes_and_audits():
+    s = _shipment()
+    result = shipments.cancel_shipment(s.id, "customer request")
+    assert result is s
+    assert s.status == "cancelled"
+    assert s.notes == ["customer request"]
+    entry = audit.LOG[-1]
+    assert entry["action"] == "shipment.cancelled"
+    assert entry["entity_id"] == s.id
+    assert entry["details"] == {"reason": "customer request"}
+
+
+def test_cancel_unknown_shipment():
+    with pytest.raises(DomainError) as err:
+        shipments.cancel_shipment("shp_missing", "x")
+    assert err.value.code == "E_NOT_FOUND"
+
+
+def test_cancel_already_cancelled():
+    s = _shipment()
+    shipments.cancel_shipment(s.id, "first")
+    log_len = len(audit.LOG)
+    with pytest.raises(DomainError) as err:
+        shipments.cancel_shipment(s.id, "second")
+    assert err.value.code == "E_BAD_STATE"
+    assert s.notes == ["first"]
+    assert len(audit.LOG) == log_len
+
+
+def test_cancel_delivered():
+    s = _shipment()
+    s.status = "delivered"
+    with pytest.raises(DomainError) as err:
+        shipments.cancel_shipment(s.id, "too late")
+    assert err.value.code == "E_BAD_STATE"
+    assert s.status == "delivered"
+    assert s.notes == []
