@@ -0,0 +1,29 @@
+from parcelo import clock, events, ids
+from parcelo.errors import DomainError
+from parcelo.models import Voucher
+from parcelo.money import Money
+from parcelo.settings import MAX_VOUCHER_AMOUNT
+from parcelo.store import db
+
+
+def issue_voucher(customer_id, amount):
+    """Issue a goodwill voucher worth `amount` to an existing customer."""
+    if customer_id not in db.customers:
+        raise DomainError("E_UNKNOWN_CUSTOMER", customer_id)
+    try:
+        value = Money.parse(amount)
+    except Exception:
+        raise DomainError("E_BAD_INPUT", f"invalid voucher amount {amount!r}")
+    if value.cents <= 0:
+        raise DomainError("E_BAD_INPUT", f"voucher amount must be positive, got {value}")
+    if MAX_VOUCHER_AMOUNT < value:
+        raise DomainError("E_LIMIT", f"voucher amount {value} exceeds {MAX_VOUCHER_AMOUNT}")
+    voucher = Voucher(
+        id=ids.new_id("vch"),
+        customer_id=customer_id,
+        amount=value,
+        issued_at=clock.now(),
+    )
+    db.vouchers[voucher.id] = voucher
+    events.emit("voucher.issued", voucher.id, customer_id=customer_id, amount_cents=value.cents)
+    return voucher
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_vouchers.py b/tests/unit/test_vouchers.py
--- a/tests/unit/test_vouchers.py	1969-12-31 19:00:00
+++ b/tests/unit/test_vouchers.py	2026-11-12 02:19:53
@@ -0,0 +1,63 @@
+from datetime import datetime, timezone
+
+import pytest
+
+from parcelo import clock, customers, events, store, vouchers
+from parcelo.errors import DomainError
+from parcelo.money import Money
+
+
+@pytest.fixture
+def customer():
+    return customers.add_customer("Acme")
+
+
+def test_issue_voucher_saves_and_emits(customer):
+    moment = datetime(2026, 11, 12, 9, 0, tzinfo=timezone.utc)
+    clock.set_fixed(moment)
+    v = vouchers.issue_voucher(customer.id, Money(2500))
+    assert v.id.startswith("vch_")
+    assert v.customer_id == customer.id
+    assert v.amount == Money(2500)
+    assert v.issued_at == moment
+    assert store.db.vouchers[v.id] is v
+    assert events.OUTBOX[-1]["name"] == "voucher.issued"
+    assert events.OUTBOX[-1]["entity_id"] == v.id
+
+
+def test_float_amount_is_converted_to_money(customer):
+    v = vouchers.issue_voucher(customer.id, 19.99)
+    assert v.amount == Money(1999)
+
+
+def test_exactly_the_limit_is_allowed(customer):
+    v = vouchers.issue_voucher(customer.id, Money(15000))
+    assert v.amount == Money(15000)
+
+
+def test_over_the_limit_fails(customer):
+    with pytest.raises(DomainError) as err:
+        vouchers.issue_voucher(customer.id, Money(15001))
+    assert err.value.code == "E_LIMIT"
+    assert store.db.vouchers == {}
+
+
+@pytest.mark.parametrize("amount", [Money(0), Money(-100), 0, -5.0])
+def test_zero_or_negative_fails(customer, amount):
+    with pytest.raises(DomainError) as err:
+        vouchers.issue_voucher(customer.id, amount)
+    assert err.value.code == "E_BAD_INPUT"
+    assert store.db.vouchers == {}
+
+
+def test_unknown_customer_fails():
+    with pytest.raises(DomainError) as err:
+        vouchers.issue_voucher("cus_missing", Money(1000))
+    assert err.value.code == "E_UNKNOWN_CUSTOMER"
+    assert events.OUTBOX == []
+
+
+def test_reset_clears_vouchers(customer):
+    vouchers.issue_voucher(customer.id, Money(1000))
+    store.reset()
+    assert store.db.vouchers == {}
