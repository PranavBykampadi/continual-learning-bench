+def split_shipment(shipment_id, weights):
+    """Replace a "created" shipment with one new shipment per weight.
+
+    The new shipments keep the original's customer and zone and are returned
+    in the same order as ``weights``. The original is marked "split".
+    """
+    original = get_shipment(shipment_id)
+    if original.status != "created":
+        raise DomainError("E_BAD_STATE", f"{shipment_id} is {original.status}")
+    weights = list(weights)
+    if not weights:
+        raise DomainError("E_BAD_INPUT", "weights must not be empty")
+    for weight in weights:
+        if isinstance(weight, bool) or not isinstance(weight, (int, float)) or weight <= 0:
+            raise DomainError("E_BAD_WEIGHT", str(weight))
+    if abs(sum(weights) - original.weight_kg) > SPLIT_WEIGHT_TOLERANCE_KG:
+        raise DomainError(
+            "E_BAD_WEIGHT",
+            f"weights sum to {sum(weights)}, shipment weighs {original.weight_kg}",
+        )
+
+    parts = []
+    for weight in weights:
+        part = Shipment(
+            id=ids.new_id("shp"),
+            customer_id=original.customer_id,
+            weight_kg=weight,
+            zone=original.zone,
+            created_at=clock.now(),
+        )
+        db.shipments[part.id] = part
+        parts.append(part)
+    original.status = "split"
+
+    for part in parts:
+        events.emit("shipment.created", part.id, zone=part.zone, split_from=original.id)
+    events.emit("shipment.split", original.id, parts=[p.id for p in parts])
+    return parts
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_split_shipment.py b/tests/unit/test_split_shipment.py
