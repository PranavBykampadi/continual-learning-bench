+++ b/tests/unit/test_split_shipment.py	2026-11-12 02:09:37
@@ -0,0 +1,88 @@
+import pytest
+
+from parcelo import customers, events, shipments
+from parcelo.errors import DomainError
+from parcelo.store import db
+
+
+def _shipment(weight=10.0, zone="national"):
+    c = customers.add_customer("Acme")
+    return shipments.create_shipment(c.id, weight, zone)
+
+
+def test_split_creates_parts_in_weight_order():
+    s = _shipment(10.0)
+    parts = shipments.split_shipment(s.id, [6.0, 1.5, 2.5])
+    assert [p.weight_kg for p in parts] == [6.0, 1.5, 2.5]
+    for p in parts:
+        assert p.id.startswith("shp_")
+        assert p.id != s.id
+        assert p.customer_id == s.customer_id
+        assert p.zone == s.zone
+        assert p.status == "created"
+        assert db.shipments[p.id] is p
+    assert shipments.get_shipment(s.id).status == "split"
+
+
+def test_split_emits_events():
+    s = _shipment(3.0)
+    events.OUTBOX.clear()
+    parts = shipments.split_shipment(s.id, [1.0, 2.0])
+    names = [(e["name"], e["entity_id"]) for e in events.OUTBOX]
+    assert names == [
+        ("shipment.created", parts[0].id),
+        ("shipment.created", parts[1].id),
+        ("shipment.split", s.id),
+    ]
+    assert events.OUTBOX[-1]["payload"]["parts"] == [p.id for p in parts]
+
+
+def test_split_tolerates_float_rounding():
+    s = _shipment(0.3)
+    parts = shipments.split_shipment(s.id, [0.1, 0.2])
+    assert len(parts) == 2
+
+
+def test_split_unknown_shipment():
+    with pytest.raises(DomainError) as err:
+        shipments.split_shipment("shp_nope", [1.0])
+    assert err.value.code == "E_NOT_FOUND"
+
+
+def test_split_not_created_fails():
+    s = _shipment(4.0)
+    shipments.split_shipment(s.id, [2.0, 2.0])
+    count = len(db.shipments)
+    with pytest.raises(DomainError) as err:
+        shipments.split_shipment(s.id, [2.0, 2.0])
+    assert err.value.code == "E_BAD_STATE"
+    assert len(db.shipments) == count
+
+
+@pytest.mark.parametrize("weights", [[1.0, 2.0], [5.0, 6.0]])
+def test_split_weight_mismatch_fails_without_changes(weights):
