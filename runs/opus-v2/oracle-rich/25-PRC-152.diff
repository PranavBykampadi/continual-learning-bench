diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/parcelo/shipments.py b/parcelo/shipments.py
--- a/parcelo/shipments.py	2026-11-10 12:20:18
+++ b/parcelo/shipments.py	2026-11-12 02:11:33
@@ -28,3 +28,14 @@
     if shipment_id not in db.shipments:
         raise DomainError("E_NOT_FOUND", shipment_id)
     return db.shipments[shipment_id]
+
+
+def mark_lost(shipment_id):
+    shipment = get_shipment(shipment_id)
+    if shipment.status == "lost":
+        return shipment
+    if shipment.status == "delivered":
+        raise DomainError("E_BAD_STATE", f"{shipment_id} is already delivered")
+    shipment.status = "lost"
+    events.emit("shipment.lost", shipment.id)
+    return shipment
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_mark_lost.py b/tests/unit/test_mark_lost.py
--- a/tests/unit/test_mark_lost.py	1969-12-31 19:00:00
+++ b/tests/unit/test_mark_lost.py	2026-11-12 02:11:36
@@ -0,0 +1,45 @@
+import pytest
+
+from parcelo import customers, events, shipments
+from parcelo.errors import DomainError
+
+
+def _shipment():
+    c = customers.add_customer("Acme")
+    return shipments.create_shipment(c.id, 1.5, "national")
+
+
+def test_mark_lost_sets_status_and_emits_event():
+    s = _shipment()
+    result = shipments.mark_lost(s.id)
+    assert result is s
+    assert result.status == "lost"
+    assert events.OUTBOX[-1]["name"] == "shipment.lost"
+    assert events.OUTBOX[-1]["entity_id"] == s.id
+
+
+def test_mark_lost_is_idempotent():
+    s = _shipment()
+    shipments.mark_lost(s.id)
+    count = len(events.OUTBOX)
+    again = shipments.mark_lost(s.id)
+    assert again is s
+    assert again.status == "lost"
+    assert len(events.OUTBOX) == count
+
+
+def test_mark_lost_unknown_shipment():
+    with pytest.raises(DomainError) as err:
+        shipments.mark_lost("shp_missing")
+    assert err.value.code == "E_NOT_FOUND"
+
+
+def test_mark_lost_delivered_shipment_fails():
+    s = _shipment()
+    s.status = "delivered"
+    count = len(events.OUTBOX)
+    with pytest.raises(DomainError) as err:
+        shipments.mark_lost(s.id)
+    assert err.value.code == "E_BAD_STATE"
+    assert s.status == "delivered"
+    assert len(events.OUTBOX) == count
