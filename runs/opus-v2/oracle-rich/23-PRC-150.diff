+def set_credit_limit(customer_id, amount):
+    """Set a customer's credit limit; returns the new limit as Money.
+
+    `amount` may be Money or a dollar value (float/int/str/Decimal).
+    Setting the limit the customer already has is a no-op (no event).
+    """
+    customer = db.customers.get(customer_id)
+    if customer is None:
+        raise DomainError("E_UNKNOWN_CUSTOMER", f"no customer {customer_id}")
+    try:
+        limit = Money.parse(amount)
+    except Exception:
+        raise DomainError("E_BAD_INPUT", f"invalid credit limit {amount!r}") from None
+    if limit.cents < 0:
+        raise DomainError("E_BAD_INPUT", "credit limit must not be negative")
+    if Money.parse(customer.credit_limit) == limit:
+        return limit
+    previous = Money.parse(customer.credit_limit)
+    customer.credit_limit = limit
+    events.emit(
+        "customer.credit_limit_set",
+        customer.id,
+        previous_cents=previous.cents,
+        credit_limit_cents=limit.cents,
+    )
+    return limit
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_customers_credit_limit.py b/tests/unit/test_customers_credit_limit.py
--- a/tests/unit/test_customers_credit_limit.py	1969-12-31 19:00:00
+++ b/tests/unit/test_customers_credit_limit.py	2026-11-12 02:10:17
@@ -0,0 +1,50 @@
+import pytest
+
+from parcelo import customers, events
+from parcelo.errors import DomainError
+from parcelo.money import Money
+
+
+def test_sets_limit_and_emits_event():
+    c = customers.add_customer("Acme")
+    result = customers.set_credit_limit(c.id, 1250.5)
+    assert result == Money(125050)
+    assert customers.get_customer(c.id).credit_limit == Money(125050)
+    assert events.OUTBOX[-1]["name"] == "customer.credit_limit_set"
+    assert events.OUTBOX[-1]["entity_id"] == c.id
+
+
+def test_accepts_money_and_zero():
+    c = customers.add_customer("Acme")
+    assert customers.set_credit_limit(c.id, Money(0)) == Money(0)
+
+
+def test_same_limit_is_idempotent():
+    c = customers.add_customer("Acme")
+    customers.set_credit_limit(c.id, Money(90000))
+    count = len(events.OUTBOX)
+    assert customers.set_credit_limit(c.id, "900.00") == Money(90000)
+    assert len(events.OUTBOX) == count
+
+
+def test_unknown_customer_fails():
+    with pytest.raises(DomainError) as err:
+        customers.set_credit_limit("nope", 100)
+    assert err.value.code == "E_UNKNOWN_CUSTOMER"
+    assert events.OUTBOX == []
+
+
+def test_negative_amount_fails():
+    c = customers.add_customer("Acme")
+    with pytest.raises(DomainError) as err:
+        customers.set_credit_limit(c.id, -0.01)
+    assert err.value.code == "E_BAD_INPUT"
+    assert customers.get_customer(c.id).credit_limit == 500.0
+    assert events.OUTBOX == []
+
+
+def test_garbage_amount_fails():
+    c = customers.add_customer("Acme")
+    with pytest.raises(DomainError) as err:
+        customers.set_credit_limit(c.id, "lots")
+    assert err.value.code == "E_BAD_INPUT"
