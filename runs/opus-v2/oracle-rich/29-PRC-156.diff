diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_heavy_quote.py b/tests/unit/test_heavy_quote.py
--- a/tests/unit/test_heavy_quote.py	1969-12-31 19:00:00
+++ b/tests/unit/test_heavy_quote.py	2026-11-12 02:14:41
@@ -0,0 +1,35 @@
+import pytest
+
+from parcelo import rates
+from parcelo.errors import DomainError
+from parcelo.money import Money
+
+
+def test_at_or_below_threshold_is_normal_quote():
+    assert rates.heavy_quote(30, "local") == Money.parse(rates.quote(30, "local"))
+    assert rates.heavy_quote(2, "national") == Money.parse(rates.quote(2, "national"))
+
+
+def test_above_threshold_adds_surcharge():
+    # national: 9.00 + 1.25*40 = 59.00, plus 10 kg * 0.75 = 7.50
+    assert rates.heavy_quote(40, "national") == Money(6650)
+
+
+def test_fractional_excess_is_pro_rata():
+    # international: 24.00 + 1.25*32 = 64.00, plus 2 kg * 0.75 = 1.50
+    assert rates.heavy_quote(32, "international") == Money(6550)
+    # local: 4.50 + 1.25*31.2 = 43.50, plus 1.2 kg * 0.75 = 0.90
+    assert rates.heavy_quote(31.2, "local") == Money(4440)
+
+
+def test_unknown_zone_fails():
+    with pytest.raises(DomainError) as err:
+        rates.heavy_quote(40, "mars")
+    assert err.value.code == "E_BAD_ZONE"
+
+
+@pytest.mark.parametrize("weight", [0, -5, None, "40"])
+def test_bad_weight_fails(weight):
+    with pytest.raises(DomainError) as err:
+        rates.heavy_quote(weight, "local")
+    assert err.value.code == "E_BAD_WEIGHT"
