+from decimal import Decimal
+
+from parcelo.errors import DomainError
+from parcelo.money import Money
+from parcelo.settings import HEAVY_SURCHARGE_PER_KG, HEAVY_THRESHOLD_KG
+
 ZONE_BASE = {"local": 4.5, "national": 9.0, "international": 24.0}
 PER_KG = 1.25
 
@@ -12,3 +18,21 @@
     if weight_kg <= 0:
         raise ValueError("weight must be positive")
     return round(base_rate(zone) + PER_KG * weight_kg, 2)
+
+
+def heavy_quote(weight_kg, zone):
+    """Normal quote plus a surcharge per kg above the heavy threshold, as Money."""
+    if zone not in ZONE_BASE:
+        raise DomainError("E_BAD_ZONE", "unknown zone: %s" % zone)
+    if (
+        isinstance(weight_kg, bool)
+        or not isinstance(weight_kg, (int, float, Decimal))
+        or not weight_kg > 0
+    ):
+        raise DomainError("E_BAD_WEIGHT", "weight must be positive")
+
+    price = Money.parse(quote(weight_kg, zone))
+    excess_kg = Decimal(str(weight_kg)) - Decimal(HEAVY_THRESHOLD_KG)
+    if excess_kg > 0:
+        price = price + Money.parse(HEAVY_SURCHARGE_PER_KG).scale(excess_kg)
+    return price
