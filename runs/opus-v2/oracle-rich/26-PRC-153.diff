+def needs_review(customer_id):
+    """Return True when the customer's open invoices call for a manual review."""
+    if customer_id not in db.customers:
+        raise DomainError("E_UNKNOWN_CUSTOMER", f"unknown customer {customer_id}")
+    open_count = 0
+    open_total = Money.zero()
+    for invoice in db.invoices.values():
+        shipment = db.shipments[invoice.shipment_id]
+        if shipment.customer_id == customer_id and invoice.status == "open":
+            open_count += 1
+            open_total = open_total + Money.parse(invoice.amount)
+    return open_count > REVIEW_MAX_OPEN_INVOICES or REVIEW_MAX_OPEN_BALANCE < open_total
