@@ -0,0 +1,9 @@
+"""Business thresholds, limits and rates used by parcelo."""
+
+from parcelo.money import Money
+
+# Customers with more open invoices than this need a manual review.
+REVIEW_MAX_OPEN_INVOICES = 3
+
+# Customers whose open invoices total more than this need a manual review.
+REVIEW_MAX_OPEN_BALANCE = Money(25000)
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_customers_review.py b/tests/unit/test_customers_review.py
--- a/tests/unit/test_customers_review.py	1969-12-31 19:00:00
+++ b/tests/unit/test_customers_review.py	2026-11-12 02:12:06
@@ -0,0 +1,66 @@
+import pytest
+
+from parcelo import customers
+from parcelo.errors import DomainError
+from parcelo.models import Invoice, Shipment
+from parcelo.store import db
+
+
+def _invoice(customer_id, n, amount, status="open"):
+    shp = Shipment(id=f"shp_{customer_id}_{n}", customer_id=customer_id, weight_kg=1, zone="local")
+    db.shipments[shp.id] = shp
+    inv = Invoice(id=f"inv_{customer_id}_{n}", shipment_id=shp.id, amount=amount, status=status)
+    db.invoices[inv.id] = inv
+
+
+def test_no_invoices_is_false():
+    c = customers.add_customer("Acme")
+    assert customers.needs_review(c.id) is False
+
+
+def test_three_open_invoices_is_false():
+    c = customers.add_customer("Acme")
+    for n in range(3):
+        _invoice(c.id, n, 10.0)
+    assert customers.needs_review(c.id) is False
+
+
+def test_four_open_invoices_is_true():
+    c = customers.add_customer("Acme")
+    for n in range(4):
+        _invoice(c.id, n, 10.0)
+    assert customers.needs_review(c.id) is True
+
+
+def test_paid_invoices_do_not_count():
+    c = customers.add_customer("Acme")
+    for n in range(3):
+        _invoice(c.id, n, 10.0)
+    _invoice(c.id, 9, 500.0, status="paid")
+    assert customers.needs_review(c.id) is False
+
+
+def test_balance_exactly_250_is_false():
+    c = customers.add_customer("Acme")
+    _invoice(c.id, 0, 100.10)
+    _invoice(c.id, 1, 149.90)
+    assert customers.needs_review(c.id) is False
+
+
+def test_balance_over_250_is_true():
+    c = customers.add_customer("Acme")
+    _invoice(c.id, 0, 250.01)
+    assert customers.needs_review(c.id) is True
+
+
+def test_other_customers_invoices_ignored():
+    c = customers.add_customer("Acme")
+    other = customers.add_customer("Other")
+    _invoice(other.id, 0, 1000.0)
+    assert customers.needs_review(c.id) is False
+
+
+def test_unknown_customer_fails():
+    with pytest.raises(DomainError) as err:
+        customers.needs_review("nope")
+    assert err.value.code == "E_UNKNOWN_CUSTOMER"
