+def _volume_tier(shipment_count):
+    if shipment_count >= VOLUME_TIER_BULK_MIN_SHIPMENTS:
+        return "bulk"
+    if shipment_count >= VOLUME_TIER_REGULAR_MIN_SHIPMENTS:
+        return "regular"
+    return "starter"
+
+
+def volume_report():
+    """Shipment count and volume tier per customer, keyed by customer id.
+
+    Every customer is included, even those with no shipments. Keys are
+    ordered by customer id ascending.
+    """
+    counts = {customer_id: 0 for customer_id in db.customers}
+    for shipment in db.shipments.values():
+        if shipment.customer_id in counts:
+            counts[shipment.customer_id] += 1
+    return {
+        customer_id: {
+            "shipments": counts[customer_id],
+            "tier": _volume_tier(counts[customer_id]),
+        }
+        for customer_id in sorted(counts)
+    }
