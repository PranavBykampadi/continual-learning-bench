+"""Business thresholds, limits and rates used by parcelo."""
+
+# Minimum shipment counts for each volume tier (same thresholds as the
+# original billing volume_tier helper).
+VOLUME_TIER_BULK_MIN_SHIPMENTS = 50
+VOLUME_TIER_REGULAR_MIN_SHIPMENTS = 10
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_volume_report.py b/tests/unit/test_volume_report.py
--- a/tests/unit/test_volume_report.py	1969-12-31 19:00:00
+++ b/tests/unit/test_volume_report.py	2026-11-12 02:08:15
@@ -0,0 +1,38 @@
+from parcelo import customers, reports, shipments
+
+
+def _ship(customer_id, n):
+    for _ in range(n):
+        shipments.create_shipment(customer_id, 1.0, "local")
+
+
+def test_empty_store():
+    assert reports.volume_report() == {}
+
+
+def test_includes_customers_without_shipments():
+    c = customers.add_customer("Idle")
+    assert reports.volume_report() == {c.id: {"shipments": 0, "tier": "starter"}}
+
+
+def test_counts_and_tier_thresholds():
+    starter = customers.add_customer("Small")
+    regular_low = customers.add_customer("Ten")
+    regular_high = customers.add_customer("FortyNine")
+    bulk = customers.add_customer("Fifty")
+    _ship(starter.id, 9)
+    _ship(regular_low.id, 10)
+    _ship(regular_high.id, 49)
+    _ship(bulk.id, 50)
+
+    report = reports.volume_report()
+
+    assert report[starter.id] == {"shipments": 9, "tier": "starter"}
+    assert report[regular_low.id] == {"shipments": 10, "tier": "regular"}
+    assert report[regular_high.id] == {"shipments": 49, "tier": "regular"}
+    assert report[bulk.id] == {"shipments": 50, "tier": "bulk"}
+
+
+def test_keys_sorted_by_customer_id():
+    ids = [customers.add_customer("C%d" % i).id for i in range(5)]
+    assert list(reports.volume_report()) == sorted(ids)
