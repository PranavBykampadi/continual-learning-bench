diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/parcelo/refunds.py b/parcelo/refunds.py
--- a/parcelo/refunds.py	1969-12-31 19:00:00
+++ b/parcelo/refunds.py	2026-11-12 01:54:30
@@ -0,0 +1,43 @@
+from parcelo import audit, clock
+from parcelo.errors import DomainError
+from parcelo.ids import new_id
+from parcelo.models import Refund
+from parcelo.money import Money
+from parcelo.store import db
+
+
+def refunded_total(invoice_id):
+    total = Money.zero()
+    for refund in db.refunds.values():
+        if refund.invoice_id == invoice_id:
+            total = total + refund.amount
+    return total
+
+
+def create_refund(invoice_id, amount):
+    invoice = db.invoices.get(invoice_id)
+    if invoice is None:
+        raise DomainError("E_NOT_FOUND", f"invoice {invoice_id} not found")
+    if invoice.status != "paid":
+        raise DomainError("E_BAD_STATE", f"invoice {invoice_id} is not paid")
+
+    try:
+        money = Money.parse(amount)
+    except Exception:
+        raise DomainError("E_BAD_INPUT", f"invalid refund amount {amount!r}")
+    if money.cents <= 0:
+        raise DomainError("E_BAD_INPUT", "refund amount must be positive")
+
+    invoice_total = Money.parse(invoice.amount)
+    if invoice_total < refunded_total(invoice_id) + money:
+        raise DomainError("E_LIMIT", f"refunds would exceed invoice {invoice_id} amount")
+
+    refund = Refund(
+        id=new_id("ref"),
+        invoice_id=invoice_id,
+        amount=money,
+        created_at=clock.now(),
+    )
+    db.refunds[refund.id] = refund
+    audit.record("refund.created", refund.id, invoice_id=invoice_id, amount_cents=money.cents)
+    return refund
