diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_refunds.py b/tests/unit/test_refunds.py
--- a/tests/unit/test_refunds.py	1969-12-31 19:00:00
+++ b/tests/unit/test_refunds.py	2026-11-12 01:54:31
@@ -0,0 +1,68 @@
+from datetime import datetime, timezone
+
+import pytest
+
+from parcelo import audit, clock, refunds
+from parcelo.errors import DomainError
+from parcelo.models import Invoice
+from parcelo.money import Money
+from parcelo.store import db
+
+
+def _invoice(status="paid", amount=20.0):
+    inv = Invoice(id="inv_1", shipment_id="shp_1", amount=amount, status=status)
+    db.invoices[inv.id] = inv
+    return inv
+
+
+def test_create_refund_for_paid_invoice():
+    moment = datetime(2026, 1, 2, tzinfo=timezone.utc)
+    clock.set_fixed(moment)
+    inv = _invoice()
+    r = refunds.create_refund(inv.id, 5.25)
+    assert r.id.startswith("ref_")
+    assert r.invoice_id == inv.id
+    assert r.amount == Money(525)
+    assert r.created_at == moment
+    assert db.refunds[r.id] is r
+    assert audit.LOG[-1]["action"] == "refund.created"
+    assert audit.LOG[-1]["entity_id"] == r.id
+
+
+def test_accepts_money():
+    inv = _invoice()
+    r = refunds.create_refund(inv.id, Money(100))
+    assert r.amount == Money(100)
+
+
+def test_unknown_invoice():
+    with pytest.raises(DomainError) as err:
+        refunds.create_refund("nope", 1)
+    assert err.value.code == "E_NOT_FOUND"
+    assert db.refunds == {}
+
+
+def test_unpaid_invoice():
+    inv = _invoice(status="open")
+    with pytest.raises(DomainError) as err:
+        refunds.create_refund(inv.id, 1)
+    assert err.value.code == "E_BAD_STATE"
+    assert db.refunds == {}
+
+
+@pytest.mark.parametrize("amount", [0, -1, "abc"])
+def test_bad_amount(amount):
+    inv = _invoice()
+    with pytest.raises(DomainError) as err:
+        refunds.create_refund(inv.id, amount)
+    assert err.value.code == "E_BAD_INPUT"
+
+
+def test_cannot_refund_more_than_invoice():
+    inv = _invoice(amount=10.0)
+    refunds.create_refund(inv.id, 6)
+    with pytest.raises(DomainError) as err:
+        refunds.create_refund(inv.id, 4.01)
+    assert err.value.code == "E_LIMIT"
+    refunds.create_refund(inv.id, 4)
+    assert len(db.refunds) == 2
