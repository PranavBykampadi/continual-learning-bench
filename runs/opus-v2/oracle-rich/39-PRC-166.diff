diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_invoice_escalation.py b/tests/unit/test_invoice_escalation.py
--- a/tests/unit/test_invoice_escalation.py	1969-12-31 19:00:00
+++ b/tests/unit/test_invoice_escalation.py	2026-11-12 02:21:09
@@ -0,0 +1,53 @@
+import pytest
+
+from parcelo import events, invoices
+from parcelo.errors import DomainError
+from parcelo.models import Invoice
+from parcelo.store import db
+
+
+def _invoice(amount, status="open", id="inv_1"):
+    inv = Invoice(id=id, shipment_id="shp_1", amount=amount, status=status)
+    db.invoices[inv.id] = inv
+    return inv
+
+
+def test_escalates_open_invoice_at_threshold():
+    _invoice(500.00)
+    inv = invoices.escalate_invoice("inv_1")
+    assert inv.status == "escalated"
+    assert events.OUTBOX[-1]["name"] == "invoice.escalated"
+    assert events.OUTBOX[-1]["entity_id"] == "inv_1"
+
+
+def test_below_threshold_is_rejected():
+    _invoice(499.99)
+    with pytest.raises(DomainError) as err:
+        invoices.escalate_invoice("inv_1")
+    assert err.value.code == "E_LIMIT"
+    assert db.invoices["inv_1"].status == "open"
+    assert events.OUTBOX == []
+
+
+def test_non_open_invoice_is_rejected():
+    _invoice(900.0, status="paid")
+    with pytest.raises(DomainError) as err:
+        invoices.escalate_invoice("inv_1")
+    assert err.value.code == "E_BAD_STATE"
+    assert db.invoices["inv_1"].status == "paid"
+
+
+def test_missing_invoice_fails():
+    with pytest.raises(DomainError) as err:
+        invoices.escalate_invoice("nope")
+    assert err.value.code == "E_NOT_FOUND"
+
+
+def test_escalating_twice_is_idempotent():
+    _invoice(800.0)
+    first = invoices.escalate_invoice("inv_1")
+    count = len(events.OUTBOX)
+    again = invoices.escalate_invoice("inv_1")
+    assert again is first
+    assert again.status == "escalated"
+    assert len(events.OUTBOX) == count
