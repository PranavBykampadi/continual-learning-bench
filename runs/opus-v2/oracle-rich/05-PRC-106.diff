@@ -32,3 +37,29 @@
 
 def open_invoices():
     return [i for i in db.invoices.values() if i.status == "open"]
+
+
+LATE_AFTER_DAYS = 30
+LATE_FEE_DAILY_RATE = Decimal("0.015")
+
+
+def late_fee_for(invoice_id):
+    """Late fee an open invoice has accrued so far, as Money.
+
+    An invoice is late 30 days after issue; each further full day adds 1.5%
+    of the invoice amount.
+    """
+    invoice = db.invoices.get(invoice_id)
+    if invoice is None:
+        raise DomainError("E_NOT_FOUND", f"invoice {invoice_id} not found")
+    if invoice.status != "open":
+        raise DomainError("E_BAD_STATE", f"invoice {invoice_id} is not open")
+
+    issued_at = invoice.issued_at
+    if issued_at.tzinfo is None:
+        # Older code stores naive UTC timestamps.
+        issued_at = issued_at.replace(tzinfo=timezone.utc)
+    days_late = (clock.now() - issued_at).days - LATE_AFTER_DAYS
+    if days_late <= 0:
+        return Money.zero()
+    return Money.parse(invoice.amount).scale(LATE_FEE_DAILY_RATE * days_late)
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_invoice_late_fee.py b/tests/unit/test_invoice_late_fee.py
--- a/tests/unit/test_invoice_late_fee.py	1969-12-31 19:00:00
+++ b/tests/unit/test_invoice_late_fee.py	2026-11-12 01:55:59
@@ -0,0 +1,69 @@
+from datetime import datetime, timedelta, timezone
+
+import pytest
+
+from parcelo import clock, invoices
+from parcelo.errors import DomainError
+from parcelo.models import Invoice
+from parcelo.money import Money
+from parcelo.store import db
+
+ISSUED = datetime(2026, 1, 1, tzinfo=timezone.utc)
+
+
+def _invoice(amount=100.0, issued_at=ISSUED, status="open"):
+    inv = Invoice(id="inv_test", shipment_id="shp_x", amount=amount,
+                  status=status, issued_at=issued_at)
+    db.invoices[inv.id] = inv
+    return inv
+
+
+def _at_days(days):
+    clock.set_fixed(ISSUED + timedelta(days=days))
+
+
+def test_not_late_yet_is_zero():
+    inv = _invoice()
+    _at_days(10)
+    assert invoices.late_fee_for(inv.id) == Money.zero()
+
+
+def test_exactly_thirty_days_is_zero():
+    inv = _invoice()
+    _at_days(30)
+    assert invoices.late_fee_for(inv.id) == Money.zero()
+
+
+def test_fee_per_day_past_thirty():
+    inv = _invoice(amount=100.0)
+    _at_days(31)
+    assert invoices.late_fee_for(inv.id) == Money(150)
+    _at_days(40)
+    assert invoices.late_fee_for(inv.id) == Money(1500)
+
+
+def test_fee_rounds_to_cents():
+    inv = _invoice(amount=10.99)
+    _at_days(33)
+    # 10.99 * 0.015 * 3 = 0.49455 -> 0.49
+    assert invoices.late_fee_for(inv.id) == Money(49)
+
+
+def test_naive_issued_at_treated_as_utc():
+    inv = _invoice(issued_at=ISSUED.replace(tzinfo=None))
+    _at_days(32)
+    assert invoices.late_fee_for(inv.id) == Money(300)
+
+
+def test_unknown_invoice_fails():
+    with pytest.raises(DomainError) as err:
+        invoices.late_fee_for("nope")
+    assert err.value.code == "E_NOT_FOUND"
+
+
+def test_paid_invoice_fails():
+    inv = _invoice(status="paid")
+    _at_days(40)
+    with pytest.raises(DomainError) as err:
+        invoices.late_fee_for(inv.id)
+    assert err.value.code == "E_BAD_STATE"
