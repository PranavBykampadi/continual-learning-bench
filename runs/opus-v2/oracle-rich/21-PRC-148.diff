diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_disputes.py b/tests/unit/test_disputes.py
--- a/tests/unit/test_disputes.py	1969-12-31 19:00:00
+++ b/tests/unit/test_disputes.py	2026-11-12 02:08:55
@@ -0,0 +1,60 @@
+from datetime import datetime, timezone
+
+import pytest
+
+from parcelo import clock, disputes, events, store
+from parcelo.errors import DomainError
+from parcelo.models import Invoice
+from parcelo.store import db
+
+
+def _invoice():
+    inv = Invoice(id="inv_000001", shipment_id="shp_000001", amount=10.0)
+    db.invoices[inv.id] = inv
+    return inv
+
+
+def test_open_dispute_creates_and_stores():
+    inv = _invoice()
+    moment = datetime(2026, 11, 12, 9, 0, tzinfo=timezone.utc)
+    clock.set_fixed(moment)
+    d = disputes.open_dispute(inv.id, "Charged twice")
+    assert d.id.startswith("dsp_")
+    assert d.invoice_id == inv.id
+    assert d.reason == "Charged twice"
+    assert d.opened_at == moment
+    assert db.disputes[d.id] is d
+
+
+def test_open_dispute_emits_event():
+    inv = _invoice()
+    d = disputes.open_dispute(inv.id, "Wrong amount")
+    last = events.OUTBOX[-1]
+    assert last["name"] == "dispute.opened"
+    assert last["entity_id"] == d.id
+    assert last["payload"] == {"invoice_id": inv.id}
+
+
+def test_unknown_invoice_fails():
+    with pytest.raises(DomainError) as err:
+        disputes.open_dispute("inv_missing", "Wrong amount")
+    assert err.value.code == "E_NOT_FOUND"
+    assert db.disputes == {}
+    assert events.OUTBOX == []
+
+
+@pytest.mark.parametrize("reason", ["", "   ", None])
+def test_empty_reason_fails(reason):
+    inv = _invoice()
+    with pytest.raises(DomainError) as err:
+        disputes.open_dispute(inv.id, reason)
+    assert err.value.code == "E_BAD_INPUT"
+    assert db.disputes == {}
+    assert events.OUTBOX == []
+
+
+def test_reset_clears_disputes():
+    inv = _invoice()
+    disputes.open_dispute(inv.id, "Wrong amount")
+    store.reset()
+    assert db.disputes == {}
