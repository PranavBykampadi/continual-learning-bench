@@ -0,0 +1,8 @@
+"""Business thresholds, limits and rates."""
+
+# Insurance fee: percentage of the declared value, with a minimum fee in dollars.
+INSURANCE_RATE_PCT = "2"
+INSURANCE_MIN_FEE = "1.00"
+
+# Fuel surcharge percentage per zone (same values as legacy billing.fuel_surcharge).
+FUEL_SURCHARGE_PCT = {"local": "0", "national": "4.0", "international": "9.5"}
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_insurance_fee.py b/tests/unit/test_insurance_fee.py
--- a/tests/unit/test_insurance_fee.py	1969-12-31 19:00:00
+++ b/tests/unit/test_insurance_fee.py	2026-11-12 02:05:36
@@ -0,0 +1,42 @@
+import pytest
+
+from parcelo import rates
+from parcelo.errors import DomainError
+from parcelo.money import Money
+
+
+def test_local_is_two_percent():
+    assert rates.insurance_fee(Money.parse("200.00"), "local") == Money(400)
+
+
+def test_national_adds_fuel_surcharge():
+    assert rates.insurance_fee(Money.parse("100.00"), "national") == Money(600)
+
+
+def test_international_adds_fuel_surcharge():
+    assert rates.insurance_fee(Money.parse("100.00"), "international") == Money(1150)
+
+
+def test_accepts_legacy_float():
+    assert rates.insurance_fee(250.0, "local") == Money(500)
+
+
+def test_minimum_fee():
+    assert rates.insurance_fee(Money.parse("5.00"), "international") == Money(100)
+
+
+def test_just_above_minimum():
+    assert rates.insurance_fee(Money.parse("10.00"), "international") == Money(115)
+
+
+def test_unknown_zone():
+    with pytest.raises(DomainError) as err:
+        rates.insurance_fee(Money.parse("100"), "mars")
+    assert err.value.code == "E_BAD_ZONE"
+
+
+@pytest.mark.parametrize("value", [0, -5, Money(0), Money(-100)])
+def test_non_positive_value(value):
+    with pytest.raises(DomainError) as err:
+        rates.insurance_fee(value, "local")
+    assert err.value.code == "E_BAD_INPUT"
