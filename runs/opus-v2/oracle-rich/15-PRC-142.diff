 def open_invoices():
     return [i for i in db.invoices.values() if i.status == "open"]
+
+
+def reopen_invoice(invoice_id):
+    """Set a paid invoice back to "open" and record when it was reopened.
+
+    Idempotent: an invoice that was already reopened (and is still open) is
+    returned unchanged without emitting another event.
+    """
+    invoice = db.invoices.get(invoice_id)
+    if invoice is None:
+        raise DomainError("E_NOT_FOUND", f"invoice {invoice_id} not found")
+    if invoice.status == "open" and invoice.reopened_at is not None:
+        return invoice
+    if invoice.status != "paid":
+        raise DomainError("E_BAD_STATE", f"invoice {invoice_id} is not paid")
+    invoice.status = "open"
+    invoice.paid_at = None
+    invoice.reopened_at = clock.now()
+    events.emit("invoice.reopened", invoice.id)
+    return invoice
