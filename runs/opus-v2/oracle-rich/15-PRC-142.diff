diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_invoices_reopen.py b/tests/unit/test_invoices_reopen.py
--- a/tests/unit/test_invoices_reopen.py	1969-12-31 19:00:00
+++ b/tests/unit/test_invoices_reopen.py	2026-11-12 02:03:51
@@ -0,0 +1,55 @@
+from datetime import datetime, timezone
+
+import pytest
+
+from parcelo import clock, events, invoices
+from parcelo.errors import DomainError
+from parcelo.models import Invoice
+from parcelo.money import Money
+from parcelo.store import db
+
+MOMENT = datetime(2026, 11, 12, 9, 30, tzinfo=timezone.utc)
+
+
+def _invoice(status="open", paid_at=None):
+    inv = Invoice(id="inv_1", shipment_id="shp_1", amount=Money.parse("12.50"),
+                  status=status, paid_at=paid_at)
+    db.invoices[inv.id] = inv
+    return inv
+
+
+def test_reopen_paid_invoice():
+    _invoice(status="paid", paid_at=datetime(2026, 11, 1, tzinfo=timezone.utc))
+    clock.set_fixed(MOMENT)
+    inv = invoices.reopen_invoice("inv_1")
+    assert inv is db.invoices["inv_1"]
+    assert inv.status == "open"
+    assert inv.paid_at is None
+    assert inv.reopened_at == MOMENT
+    assert events.OUTBOX[-1]["name"] == "invoice.reopened"
+    assert events.OUTBOX[-1]["entity_id"] == "inv_1"
+
+
+def test_reopen_is_idempotent():
+    _invoice(status="paid", paid_at=MOMENT)
+    clock.set_fixed(MOMENT)
+    invoices.reopen_invoice("inv_1")
+    clock.set_fixed(datetime(2026, 11, 13, tzinfo=timezone.utc))
+    inv = invoices.reopen_invoice("inv_1")
+    assert inv.status == "open"
+    assert inv.reopened_at == MOMENT
+    assert len(events.OUTBOX) == 1
+
+
+def test_reopen_missing_invoice():
+    with pytest.raises(DomainError) as err:
+        invoices.reopen_invoice("nope")
+    assert err.value.code == "E_NOT_FOUND"
+
+
+def test_reopen_never_paid_invoice():
+    _invoice(status="open")
+    with pytest.raises(DomainError) as err:
+        invoices.reopen_invoice("inv_1")
+    assert err.value.code == "E_BAD_STATE"
+    assert events.OUTBOX == []
