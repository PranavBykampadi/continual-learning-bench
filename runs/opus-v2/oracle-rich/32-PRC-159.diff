     if shipment_id not in db.shipments:
         raise DomainError("E_NOT_FOUND", shipment_id)
     return db.shipments[shipment_id]
+
+
+def shipments_in_zone(zone):
+    if zone not in ZONE_BASE:
+        raise DomainError("E_BAD_ZONE", zone)
+    matching = [s for s in db.shipments.values() if s.zone == zone]
+    return sorted(matching, key=lambda s: s.id)
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_shipments_in_zone.py b/tests/unit/test_shipments_in_zone.py
--- a/tests/unit/test_shipments_in_zone.py	1969-12-31 19:00:00
+++ b/tests/unit/test_shipments_in_zone.py	2026-11-12 02:17:03
@@ -0,0 +1,38 @@
+import pytest
+
+from parcelo import customers, shipments
+from parcelo.errors import DomainError
+
+
+def test_returns_only_shipments_in_zone_sorted_by_id():
+    c = customers.add_customer("Acme")
+    a = shipments.create_shipment(c.id, 1, "local")
+    shipments.create_shipment(c.id, 2, "national")
+    b = shipments.create_shipment(c.id, 3, "local")
+    result = shipments.shipments_in_zone("local")
+    assert [s.id for s in result] == sorted([a.id, b.id])
+
+
+def test_sorted_by_id_not_storage_order():
+    c = customers.add_customer("Acme")
+    a = shipments.create_shipment(c.id, 1, "local")
+    b = shipments.create_shipment(c.id, 2, "local")
+    from parcelo.store import db
+
+    # re-insert in reverse order so storage order differs from id order
+    for sid in sorted(db.shipments, reverse=True):
+        db.shipments[sid] = db.shipments.pop(sid)
+    result = shipments.shipments_in_zone("local")
+    assert [s.id for s in result] == sorted([a.id, b.id])
+
+
+def test_empty_list_when_no_shipments_in_zone():
+    c = customers.add_customer("Acme")
+    shipments.create_shipment(c.id, 1, "local")
+    assert shipments.shipments_in_zone("international") == []
+
+
+def test_unknown_zone_fails():
+    with pytest.raises(DomainError) as err:
+        shipments.shipments_in_zone("mars")
+    assert err.value.code == "E_BAD_ZONE"
