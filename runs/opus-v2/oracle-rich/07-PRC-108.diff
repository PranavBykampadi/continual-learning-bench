@@ -0,0 +1,56 @@
+import pytest
+
+from parcelo import customers, reports, shipments
+from parcelo.errors import DomainError
+from parcelo.models import Invoice
+from parcelo.money import Money
+from parcelo.store import db
+
+
+def _invoice(inv_id, shipment_id, amount, status="open"):
+    db.invoices[inv_id] = Invoice(id=inv_id, shipment_id=shipment_id, amount=amount, status=status)
+
+
+def test_sums_open_invoices_per_customer():
+    a = customers.add_customer("Acme")
+    b = customers.add_customer("Globex")
+    sa = shipments.create_shipment(a.id, 1, "local")
+    sb = shipments.create_shipment(b.id, 1, "national")
+    _invoice("i1", sa.id, 10.10)
+    _invoice("i2", sa.id, 20.20)
+    _invoice("i3", sb.id, 5.5)
+
+    result = reports.outstanding_by_customer()
+
+    assert result == {a.id: Money(3030), b.id: Money(550)}
+    assert all(isinstance(v, Money) for v in result.values())
+
+
+def test_paid_and_void_invoices_are_excluded():
+    a = customers.add_customer("Acme")
+    s = shipments.create_shipment(a.id, 1, "local")
+    _invoice("i1", s.id, 7.25)
+    _invoice("i2", s.id, 100.0, status="paid")
+    _invoice("i3", s.id, 50.0, status="void")
+
+    assert reports.outstanding_by_customer() == {a.id: Money(725)}
+
+
+def test_customer_without_open_invoices_owes_zero():
+    a = customers.add_customer("Acme")
+    s = shipments.create_shipment(a.id, 1, "local")
+    _invoice("i1", s.id, 9.99, status="paid")
+
+    assert reports.outstanding_by_customer() == {a.id: Money.zero()}
+
+
+def test_empty_store():
+    assert reports.outstanding_by_customer() == {}
+
+
+def test_open_invoice_with_missing_shipment_raises():
+    _invoice("i1", "shp_missing", 1.0)
+
+    with pytest.raises(DomainError) as err:
+        reports.outstanding_by_customer()
+    assert err.value.code == "E_NOT_FOUND"
