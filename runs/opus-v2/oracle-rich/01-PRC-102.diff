diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_invoices_void.py b/tests/unit/test_invoices_void.py
--- a/tests/unit/test_invoices_void.py	1969-12-31 19:00:00
+++ b/tests/unit/test_invoices_void.py	2026-11-12 01:51:04
@@ -0,0 +1,44 @@
+from datetime import datetime, timezone
+
+import pytest
+
+from parcelo import audit, clock, invoices
+from parcelo.errors import DomainError
+from parcelo.models import Invoice
+from parcelo.store import db
+
+
+def _add_invoice(status="open"):
+    inv = Invoice(id="inv_test", shipment_id="shp_1", amount=10.0, status=status)
+    db.invoices[inv.id] = inv
+    return inv
+
+
+def test_void_sets_status_time_and_audits():
+    moment = datetime(2026, 11, 12, 9, 30, tzinfo=timezone.utc)
+    clock.set_fixed(moment)
+    inv = _add_invoice()
+    result = invoices.void_invoice(inv.id)
+    assert result is inv
+    assert inv.status == "void"
+    assert inv.voided_at == moment
+    assert audit.LOG[-1]["action"] == "invoice.voided"
+    assert audit.LOG[-1]["entity_id"] == inv.id
+
+
+def test_void_missing_invoice():
+    with pytest.raises(DomainError) as err:
+        invoices.void_invoice("nope")
+    assert err.value.code == "E_NOT_FOUND"
+    assert audit.LOG == []
+
+
+@pytest.mark.parametrize("status", ["paid", "void"])
+def test_void_rejects_paid_or_void(status):
+    inv = _add_invoice(status)
+    with pytest.raises(DomainError) as err:
+        invoices.void_invoice(inv.id)
+    assert err.value.code == "E_BAD_STATE"
+    assert inv.status == status
+    assert inv.voided_at is None
+    assert audit.LOG == []
