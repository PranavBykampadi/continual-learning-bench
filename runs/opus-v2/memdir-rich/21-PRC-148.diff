diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_disputes_open.py b/tests/unit/test_disputes_open.py
--- a/tests/unit/test_disputes_open.py	1969-12-31 19:00:00
+++ b/tests/unit/test_disputes_open.py	2026-11-12 03:13:49
@@ -0,0 +1,86 @@
+import re
+from datetime import datetime, timezone
+
+import pytest
+
+from parcelo import clock, customers, disputes, events, invoices, shipments, store
+from parcelo.errors import DomainError
+from parcelo.models import Dispute
+from parcelo.store import db
+
+NOW = datetime(2026, 11, 12, 9, 30, tzinfo=timezone.utc)
+
+
+@pytest.fixture
+def invoice():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 1.5, "national")
+    inv = invoices.issue_invoice(s.id)
+    events.OUTBOX.clear()
+    clock.set_fixed(NOW)
+    return inv
+
+
+def test_open_dispute_creates_and_stores(invoice):
+    d = disputes.open_dispute(invoice.id, "  Charged twice  ")
+    assert isinstance(d, Dispute)
+    assert d.id == "dsp_000002"  # shp_000001 was issued first
+    assert re.fullmatch(r"dsp_\d{6}", d.id)
+    assert d.invoice_id == invoice.id
+    assert d.reason == "Charged twice"
+    assert d.opened_at == NOW
+    assert db.disputes == {d.id: d}
+
+
+def test_open_dispute_emits_event(invoice):
+    d = disputes.open_dispute(invoice.id, "Wrong amount")
+    assert events.OUTBOX == [
+        {
+            "name": "dispute.opened",
+            "entity_id": d.id,
+            "at": NOW,
+            "payload": {"invoice_id": invoice.id, "reason": "Wrong amount"},
+        }
+    ]
+
+
+def test_multiple_disputes_get_distinct_ids(invoice):
+    a = disputes.open_dispute(invoice.id, "First")
+    b = disputes.open_dispute(invoice.id, "Second")
+    assert a.id != b.id
+    assert set(db.disputes) == {a.id, b.id}
+
+
+def test_invoice_untouched(invoice):
+    status, amount = invoice.status, invoice.amount
+    disputes.open_dispute(invoice.id, "Wrong amount")
+    assert (invoice.status, invoice.amount) == (status, amount)
+
+
+def test_missing_invoice_fails():
+    with pytest.raises(DomainError) as err:
+        disputes.open_dispute("inv_999999", "Charged twice")
+    assert err.value.code == "E_NOT_FOUND"
+    assert db.disputes == {}
+    assert events.OUTBOX == []
+
+
+@pytest.mark.parametrize("reason", ["", "   ", None, 42])
+def test_empty_or_invalid_reason_fails(invoice, reason):
+    with pytest.raises(DomainError) as err:
+        disputes.open_dispute(invoice.id, reason)
+    assert err.value.code == "E_BAD_INPUT"
+    assert db.disputes == {}
+    assert events.OUTBOX == []
+
+
+def test_missing_invoice_checked_before_reason():
+    with pytest.raises(DomainError) as err:
+        disputes.open_dispute("inv_999999", "")
+    assert err.value.code == "E_NOT_FOUND"
+
+
+def test_reset_clears_disputes(invoice):
+    disputes.open_dispute(invoice.id, "Charged twice")
+    store.reset()
+    assert db.disputes == {}
