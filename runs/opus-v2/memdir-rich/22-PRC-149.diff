+SPLITTABLE_STATUSES = ("created",)
+
+
+def _weight_as_decimal(weight):
+    if isinstance(weight, bool) or not isinstance(weight, (int, float, Decimal)):
+        raise DomainError("E_BAD_WEIGHT", repr(weight))
+    try:
+        value = Decimal(str(weight))
+    except InvalidOperation:
+        raise DomainError("E_BAD_WEIGHT", repr(weight))
+    if not value.is_finite() or value <= 0:
+        raise DomainError("E_BAD_WEIGHT", str(weight))
+    return value
+
+
+def split_shipment(shipment_id, weights):
+    original = get_shipment(shipment_id)
+    if original.status not in SPLITTABLE_STATUSES:
+        raise DomainError("E_BAD_STATE", f"{shipment_id} is {original.status}")
+    if isinstance(weights, (str, bytes)):
+        raise DomainError("E_BAD_INPUT", "weights must be a list of numbers")
+    try:
+        weights = list(weights)
+    except TypeError:
+        raise DomainError("E_BAD_INPUT", "weights must be a list of numbers")
+    if not weights:
+        raise DomainError("E_BAD_INPUT", "weights must not be empty")
+    parts = [_weight_as_decimal(w) for w in weights]
+    # Compare in Decimal so float noise (0.1 + 0.2) doesn't break the check.
+    if sum(parts) != Decimal(str(original.weight_kg)):
+        raise DomainError(
+            "E_BAD_WEIGHT",
+            f"weights add up to {sum(parts)}, shipment {shipment_id} weighs {original.weight_kg}",
+        )
+
+    original.status = "split"
+    new_shipments = []
+    for weight in weights:
+        shipment = Shipment(
+            id=ids.new_id("shp"),
+            customer_id=original.customer_id,
+            weight_kg=weight,
+            zone=original.zone,
+            created_at=clock.now(),
+        )
+        db.shipments[shipment.id] = shipment
+        events.emit("shipment.created", shipment.id, zone=shipment.zone)
+        new_shipments.append(shipment)
+    events.emit(
+        "shipment.split",
+        original.id,
+        into=[s.id for s in new_shipments],
+        weights=list(weights),
+    )
+    return new_shipments
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_shipments_split.py b/tests/unit/test_shipments_split.py
--- a/tests/unit/test_shipments_split.py	1969-12-31 19:00:00
+++ b/tests/unit/test_shipments_split.py	2026-11-12 03:15:19
@@ -0,0 +1,94 @@
+import pytest
+
+from parcelo import customers, events, shipments
+from parcelo.errors import DomainError
+from parcelo.store import db
+
+
+@pytest.fixture
+def shipment():
+    c = customers.add_customer("Acme")  # does not consume the shared id counter
+    s = shipments.create_shipment(c.id, 10, "national")  # shp_000001
+    events.OUTBOX.clear()
+    return s
+
+
+def test_split_creates_new_shipments_in_order(shipment):
+    parts = shipments.split_shipment(shipment.id, [3, 5, 2])
+    assert [p.id for p in parts] == ["shp_000002", "shp_000003", "shp_000004"]
+    assert [p.weight_kg for p in parts] == [3, 5, 2]
+    for p in parts:
+        assert p.customer_id == shipment.customer_id
+        assert p.zone == shipment.zone
+        assert p.status == "created"
+        assert db.shipments[p.id] is p
+    assert shipment.status == "split"
+    assert shipment.weight_kg == 10
+
+
+def test_split_emits_events(shipment):
+    parts = shipments.split_shipment(shipment.id, [4, 6])
+    names = [e["name"] for e in events.OUTBOX]
+    assert names == ["shipment.created", "shipment.created", "shipment.split"]
+    split_event = events.OUTBOX[-1]
+    assert split_event["entity_id"] == shipment.id
+    assert split_event["payload"]["into"] == [p.id for p in parts]
+
+
+def test_split_float_weights_tolerate_float_noise(shipment):
+    shipment.weight_kg = 0.3
+    parts = shipments.split_shipment(shipment.id, [0.1, 0.2])
+    assert len(parts) == 2
+
+
+def test_split_missing_shipment():
+    with pytest.raises(DomainError) as err:
+        shipments.split_shipment("shp_999999", [1])
+    assert err.value.code == "E_NOT_FOUND"
+    assert events.OUTBOX == []
+
+
+@pytest.mark.parametrize("status", ["delivered", "cancelled", "split"])
+def test_split_requires_created_status(shipment, status):
+    shipment.status = status
+    with pytest.raises(DomainError) as err:
+        shipments.split_shipment(shipment.id, [5, 5])
+    assert err.value.code == "E_BAD_STATE"
+    assert shipment.status == status
+    assert len(db.shipments) == 1
+    assert events.OUTBOX == []
+
+
+def test_split_twice_fails(shipment):
+    shipments.split_shipment(shipment.id, [5, 5])
+    with pytest.raises(DomainError) as err:
+        shipments.split_shipment(shipment.id, [5, 5])
+    assert err.value.code == "E_BAD_STATE"
+
+
+@pytest.mark.parametrize("weights", [[3, 3], [6, 6], [10, 0.5]])
+def test_split_weights_must_add_up(shipment, weights):
+    with pytest.raises(DomainError) as err:
+        shipments.split_shipment(shipment.id, weights)
+    assert err.value.code == "E_BAD_WEIGHT"
+    assert shipment.status == "created"
+    assert len(db.shipments) == 1
+    assert events.OUTBOX == []
+
+
+@pytest.mark.parametrize("weights", [[12, -2], [10, 0], [True, 9], ["5", 5], [None, 10]