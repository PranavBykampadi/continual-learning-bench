@@ -0,0 +1,84 @@
+import pytest
+
+from parcelo import audit, customers, invoices, reports, shipments
+from parcelo.errors import DomainError
+from parcelo.money import Money
+
+
+@pytest.fixture
+def setup():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 2, "local")
+    inv = invoices.issue_invoice(s.id)  # amount 7.0
+    audit.LOG.clear()
+    return c, inv
+
+
+def test_apply_credit_returns_remaining_money(setup):
+    _, inv = setup
+    remaining = invoices.apply_credit(inv.id, "2.50")
+    assert remaining == Money.parse("4.50")
+    assert isinstance(remaining, Money)
+    assert inv.amount == 4.5
+    assert inv.status == "open"
+    assert audit.LOG[-1]["action"] == "invoice.credit_applied"
+    assert audit.LOG[-1]["entity_id"] == inv.id
+
+
+def test_multiple_credits_avoid_float_drift(setup):
+    _, inv = setup
+    inv.amount = 0.3
+    assert invoices.apply_credit(inv.id, 0.1) == Money.parse("0.20")
+    assert invoices.apply_credit(inv.id, 0.2) == Money.zero()
+    assert inv.amount == 0.0
+
+
+def test_full_credit_allowed(setup):
+    _, inv = setup
+    assert invoices.apply_credit(inv.id, Money.parse("7.00")) == Money.zero()
+
+
+def test_credited_amount_works_with_balance_and_reports(setup):
+    c, inv = setup
+    invoices.apply_credit(inv.id, "1.25")
+    assert customers.outstanding_balance(c.id) == 5.75
+    invoices.mark_paid(inv.id)
+    assert reports.revenue_total() == 5.75
+    assert reports.daily_summary()["revenue"] == 5.75
+
+
+def test_missing_invoice(setup):
+    with pytest.raises(DomainError) as err:
+        invoices.apply_credit("INV-nope", "1.00")
+    assert err.value.code == "E_NOT_FOUND"
+    assert audit.LOG == []
+
+
+@pytest.mark.parametrize("status", ["paid", "void"])
+def test_not_open(setup, status):
+    _, inv = setup
+    inv.status = status
+    with pytest.raises(DomainError) as err:
+        invoices.apply_credit(inv.id, "1.00")
+    assert err.value.code == "E_BAD_STATE"
+    assert inv.amount == 7.0
+    assert audit.LOG == []
+
+
+def test_credit_larger_than_amount(setup):
+    _, inv = setup
+    with pytest.raises(DomainError) as err:
+        invoices.apply_credit(inv.id, "7.01")
+    assert err.value.code == "E_LIMIT"
+    assert inv.amount == 7.0
+    assert audit.LOG == []
+
+
+@pytest.mark.parametrize("bad", [0, "0", -1, "-0.01", "0.001", "abc", None, True])
+def test_bad_amount(setup, bad):
+    _, inv = setup
+    with pytest.raises(DomainError) as err:
+        invoices.apply_credit(inv.id, bad)
+    assert err.value.code == "E_BAD_INPUT"
+    assert inv.amount == 7.0
+    assert audit.LOG == []
