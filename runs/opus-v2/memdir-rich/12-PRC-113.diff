 def open_invoices():
     return [i for i in db.invoices.values() if i.status == "open"]
+
+
+CREDITABLE_STATUSES = ("open",)
+
+
+def _parse_credit(amount):
+    if amount is None or isinstance(amount, bool):
+        raise DomainError("E_BAD_INPUT", f"invalid credit amount {amount!r}")
+    try:
+        credit = Money.parse(amount)
+    except (InvalidOperation, ValueError, TypeError):
+        raise DomainError("E_BAD_INPUT", f"invalid credit amount {amount!r}")
+    if credit.cents <= 0:
+        raise DomainError("E_BAD_INPUT", "credit amount must be positive")
+    return credit
+
+
+def apply_credit(invoice_id, amount):
+    """Reduce an open invoice's amount by a credit and return the remaining Money.
+
+    Invoice.amount stays a plain dollar number (float) because revenue_total and
+    customers.outstanding_balance sum it with floats; the arithmetic is done in Money.
+    """
+    invoice = db.invoices.get(invoice_id)
+    if invoice is None:
+        raise DomainError("E_NOT_FOUND", invoice_id)
+    if invoice.status not in CREDITABLE_STATUSES:
+        raise DomainError("E_BAD_STATE", f"{invoice_id} is {invoice.status}")
+    credit = _parse_credit(amount)
+    current = Money.parse(invoice.amount)
+    if current < credit:
+        raise DomainError("E_LIMIT", f"credit {credit} exceeds invoice amount {current}")
+    remaining = current - credit
+    invoice.amount = float(Decimal(remaining.cents) / 100)
+    audit.record("invoice.credit_applied", invoice_id, credit=credit, remaining=remaining)
+    return remaining
