diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_rates_heavy.py b/tests/unit/test_rates_heavy.py
--- a/tests/unit/test_rates_heavy.py	1969-12-31 19:00:00
+++ b/tests/unit/test_rates_heavy.py	2026-11-12 03:24:02
@@ -0,0 +1,53 @@
+import pytest
+
+from parcelo import events, rates, settings
+from parcelo.errors import DomainError
+from parcelo.money import Money
+
+
+def test_light_parcel_gets_normal_quote():
+    # 4.50 + 1.25 * 10
+    assert rates.heavy_quote(10, "local") == Money.parse("17.00")
+
+
+def test_exactly_threshold_has_no_surcharge():
+    w = settings.HEAVY_THRESHOLD_KG
+    assert rates.heavy_quote(w, "national") == Money.parse(rates.quote(w, "national"))
+    assert rates.heavy_quote(30, "national") == Money.parse("46.50")
+
+
+def test_heavy_parcel_adds_surcharge():
+    # 9.00 + 1.25 * 40 = 59.00, plus 0.75 * 10 = 7.50
+    assert rates.heavy_quote(40, "national") == Money.parse("66.50")
+
+
+def test_fractional_excess_is_prorated():
+    # 24.00 + 1.25 * 30.4 = 62.00, plus 0.75 * 0.4 = 0.30
+    assert rates.heavy_quote(30.4, "international") == Money.parse("62.30")
+
+
+def test_returns_money():
+    assert isinstance(rates.heavy_quote(31, "local"), Money)
+
+
+def test_surcharge_follows_settings(monkeypatch):
+    monkeypatch.setattr(settings, "HEAVY_PER_KG_SURCHARGE", "1.00")
+    monkeypatch.setattr(settings, "HEAVY_THRESHOLD_KG", 20)
+    # 4.50 + 1.25 * 25 = 35.75, plus 1.00 * 5
+    assert rates.heavy_quote(25, "local") == Money.parse("40.75")
+
+
+@pytest.mark.parametrize("zone", ["moon", "", None, "LOCAL"])
+def test_unknown_zone_fails(zone):
+    with pytest.raises(DomainError) as err:
+        rates.heavy_quote(40, zone)
+    assert err.value.code == "E_BAD_ZONE"
+    assert events.OUTBOX == []
+
+
+@pytest.mark.parametrize("weight", [0, -1, -40.5, None, "40", True])
+def test_bad_weight_fails(weight):
+    with pytest.raises(DomainError) as err:
+        rates.heavy_quote(weight, "local")
+    assert err.value.code == "E_BAD_WEIGHT"
+    assert events.OUTBOX == []
