+def heavy_quote(weight_kg, zone):
+    """Normal quote plus a surcharge per kg above the heavy threshold, as Money.
+
+    Unknown zone -> DomainError E_BAD_ZONE; non-positive or non-numeric weight -> E_BAD_WEIGHT.
+    """
+    if zone not in ZONE_BASE:
+        raise DomainError("E_BAD_ZONE", f"unknown zone {zone!r}")
+    if isinstance(weight_kg, bool) or not isinstance(weight_kg, (int, float, Decimal)):
+        raise DomainError("E_BAD_WEIGHT", f"weight must be a number, got {weight_kg!r}")
+    if weight_kg <= 0:
+        raise DomainError("E_BAD_WEIGHT", "weight must be positive")
+    price = Money.parse(quote(weight_kg, zone))
+    excess_kg = Decimal(str(weight_kg)) - Decimal(str(settings.HEAVY_THRESHOLD_KG))
+    if excess_kg > 0:
+        price = price + Money.parse(settings.HEAVY_PER_KG_SURCHARGE).scale(excess_kg)
+    return price
