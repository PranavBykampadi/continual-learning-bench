     if shipment_id not in db.shipments:
         raise DomainError("E_NOT_FOUND", shipment_id)
     return db.shipments[shipment_id]
+
+
+def shipments_in_zone(zone):
+    """Return shipments whose zone is ``zone``, sorted by id.
+
+    Returns a new list (empty if none match). Unknown zones raise E_BAD_ZONE.
+    """
+    if not isinstance(zone, str) or zone not in ZONE_BASE:
+        raise DomainError("E_BAD_ZONE", f"unknown zone {zone!r}")
+    return sorted((s for s in db.shipments.values() if s.zone == zone), key=lambda s: s.id)
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_shipments_in_zone.py b/tests/unit/test_shipments_in_zone.py
--- a/tests/unit/test_shipments_in_zone.py	1969-12-31 19:00:00
+++ b/tests/unit/test_shipments_in_zone.py	2026-11-12 03:27:42
@@ -0,0 +1,48 @@
+import pytest
+
+from parcelo import customers, events, shipments
+from parcelo.errors import DomainError
+from parcelo.store import db
+
+
+@pytest.fixture
+def customer():
+    return customers.add_customer("Acme")
+
+
+def test_returns_only_matching_zone_sorted_by_id(customer):
+    a = shipments.create_shipment(customer.id, 1, "local")
+    shipments.create_shipment(customer.id, 1, "national")
+    b = shipments.create_shipment(customer.id, 2, "local")
+    # break storage order so it differs from id order
+    items = list(db.shipments.items())
+    db.shipments.clear()
+    db.shipments.update(reversed(items))
+
+    result = shipments.shipments_in_zone("local")
+
+    assert [s.id for s in result] == [a.id, b.id] == ["shp_000001", "shp_000003"]
+
+
+def test_known_zone_with_no_shipments_returns_empty(customer):
+    shipments.create_shipment(customer.id, 1, "local")
+    assert shipments.shipments_in_zone("international") == []
+
+
+def test_empty_store_returns_empty():
+    assert shipments.shipments_in_zone("national") == []
+
+
+def test_returns_new_list(customer):
+    shipments.create_shipment(customer.id, 1, "local")
+    first = shipments.shipments_in_zone("local")
+    first.clear()
+    assert len(shipments.shipments_in_zone("local")) == 1
+
+
+@pytest.mark.parametrize("zone", ["mars", "Local", "", None, 3, ["local"]])
+def test_unknown_zone_fails(zone):
+    with pytest.raises(DomainError) as err:
+        shipments.shipments_in_zone(zone)
+    assert err.value.code == "E_BAD_ZONE"
+    assert events.OUTBOX == []
