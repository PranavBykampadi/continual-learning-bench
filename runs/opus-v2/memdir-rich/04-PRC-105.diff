diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/parcelo/refunds.py b/parcelo/refunds.py
--- a/parcelo/refunds.py	1969-12-31 19:00:00
+++ b/parcelo/refunds.py	2026-11-12 02:52:54
@@ -0,0 +1,43 @@
+from parcelo import audit, clock, ids
+from parcelo.errors import DomainError
+from parcelo.models import Refund
+from parcelo.money import Money
+from parcelo.store import db
+
+
+def create_refund(invoice_id, amount):
+    """Record a refund against a paid invoice.
+
+    `amount` may be Money or a dollar value (str/int/Decimal/float); it is
+    stored as Money. Total refunds may not exceed the invoice amount.
+    """
+    invoice = db.invoices.get(invoice_id)
+    if invoice is None:
+        raise DomainError("E_NOT_FOUND", invoice_id)
+    if invoice.status != "paid":
+        raise DomainError("E_BAD_STATE", f"{invoice_id} is {invoice.status}")
+
+    amount = Money.parse(amount)
+    if amount.cents <= 0:
+        raise DomainError("E_BAD_INPUT", f"refund amount must be positive: {amount}")
+
+    invoice_total = Money.parse(invoice.amount)
+    already_refunded = Money.zero()
+    for r in db.refunds.values():
+        if r.invoice_id == invoice_id:
+            already_refunded = already_refunded + r.amount
+    if invoice_total < already_refunded + amount:
+        raise DomainError(
+            "E_LIMIT",
+            f"refunds for {invoice_id} would exceed invoice amount {invoice_total}",
+        )
+
+    refund = Refund(
+        id=ids.new_id("ref"),
+        invoice_id=invoice_id,
+        amount=amount,
+        created_at=clock.now(),
+    )
+    db.refunds[refund.id] = refund
+    audit.record("refund.created", refund.id, invoice_id=invoice_id, amount_cents=amount.cents)
+    return refund
