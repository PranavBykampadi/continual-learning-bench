diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_refunds_create.py b/tests/unit/test_refunds_create.py
--- a/tests/unit/test_refunds_create.py	1969-12-31 19:00:00
+++ b/tests/unit/test_refunds_create.py	2026-11-12 02:53:04
@@ -0,0 +1,80 @@
+from datetime import datetime, timezone
+
+import pytest
+
+from parcelo import audit, clock, customers, invoices, refunds, shipments
+from parcelo.errors import DomainError
+from parcelo.money import Money
+from parcelo.store import db
+
+
+def _invoice(paid=True):
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 2, "local")
+    inv = invoices.issue_invoice(s.id)
+    if paid:
+        invoices.mark_paid(inv.id)
+    audit.LOG.clear()
+    return inv
+
+
+def test_create_refund_for_paid_invoice():
+    inv = _invoice()
+    moment = datetime(2026, 11, 12, 9, 30, tzinfo=timezone.utc)
+    clock.set_fixed(moment)
+
+    refund = refunds.create_refund(inv.id, Money.parse("1.25"))
+
+    assert refund.id
+    assert refund.invoice_id == inv.id
+    assert refund.amount == Money.parse("1.25")
+    assert refund.created_at == moment
+    assert db.refunds[refund.id] is refund
+    assert audit.LOG[-1]["action"] == "refund.created"
+    assert audit.LOG[-1]["entity_id"] == refund.id
+
+
+def test_amount_given_as_string_is_stored_as_money():
+    inv = _invoice()
+    refund = refunds.create_refund(inv.id, "0.10")
+    assert refund.amount == Money(10)
+
+
+def test_unknown_invoice_fails():
+    with pytest.raises(DomainError) as err:
+        refunds.create_refund("INV-missing", Money.parse("1.00"))
+    assert err.value.code == "E_NOT_FOUND"
+    assert db.refunds == {}
+    assert audit.LOG == []
+
+
+@pytest.mark.parametrize("status", ["open", "void"])
+def test_unpaid_invoice_fails(status):
+    inv = _invoice(paid=False)
+    inv.status = status
+    with pytest.raises(DomainError) as err:
+        refunds.create_refund(inv.id, Money.parse("1.00"))
+    assert err.value.code == "E_BAD_STATE"
+    assert db.refunds == {}
+    assert audit.LOG == []
+
+
+@pytest.mark.parametrize("amount", ["0", "-1.00"])
+def test_non_positive_amount_fails(amount):
+    inv = _invoice()
+    with pytest.raises(DomainError) as err:
+        refunds.create_refund(inv.id, amount)
+    assert err.value.code == "E_BAD_INPUT"
+    assert db.refunds == {}
+    assert audit.LOG == []
+
+
+def test_refunds_cannot_exceed_invoice_amount():
+    inv = _invoice()
+    total = Money.parse(inv.amount)
+    refunds.create_refund(inv.id, total - Money(1))
+    refunds.create_refund(inv.id, Money(1))  # exactly the full amount is fine
+    with pytest.raises(DomainError) as err:
+        refunds.create_refund(inv.id, Money(1))
+    assert err.value.code == "E_LIMIT"
+    assert len(db.refunds) == 2
