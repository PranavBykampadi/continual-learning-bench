+def lock_customer(customer_id):
+    """Lock a customer account (e.g. after suspicious logins).
+
+    Idempotent: locking an already-locked customer returns it unchanged
+    and emits no event. Unknown customer -> DomainError E_NOT_FOUND.
+    """
+    customer = db.customers.get(customer_id)
+    if customer is None:
+        raise DomainError("E_NOT_FOUND", f"customer {customer_id} not found")
+    if customer.locked:
+        return customer
+    customer.locked = True
+    events.emit("customer.locked", customer.id)
+    return customer
