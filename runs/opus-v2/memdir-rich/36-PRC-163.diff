diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_customers_lock.py b/tests/unit/test_customers_lock.py
--- a/tests/unit/test_customers_lock.py	1969-12-31 19:00:00
+++ b/tests/unit/test_customers_lock.py	2026-11-12 03:32:42
@@ -0,0 +1,48 @@
+import pytest
+
+from parcelo import customers, events
+from parcelo.errors import DomainError
+from parcelo.models import Customer
+from parcelo.store import db
+
+
+@pytest.fixture
+def customer():
+    c = customers.add_customer("Acme")
+    events.OUTBOX.clear()
+    return c
+
+
+def test_locked_defaults_to_false():
+    assert Customer(id="x", name="n").locked is False
+    assert customers.add_customer("Beta").locked is False
+
+
+def test_lock_customer_sets_flag_and_emits_event(customer):
+    result = customers.lock_customer(customer.id)
+    assert result is customer
+    assert db.customers[customer.id].locked is True
+    assert [(e["name"], e["entity_id"]) for e in events.OUTBOX] == [
+        ("customer.locked", customer.id)
+    ]
+
+
+def test_lock_customer_does_not_change_other_fields(customer):
+    customers.lock_customer(customer.id)
+    assert customer.active is True
+    assert customer.tier == "standard"
+
+
+def test_lock_unknown_customer_fails():
+    with pytest.raises(DomainError) as exc:
+        customers.lock_customer("missing")
+    assert exc.value.code == "E_NOT_FOUND"
+    assert events.OUTBOX == []
+
+
+def test_lock_twice_is_idempotent(customer):
+    first = customers.lock_customer(customer.id)
+    second = customers.lock_customer(customer.id)
+    assert second is first
+    assert second.locked is True
+    assert len(events.OUTBOX) == 1
