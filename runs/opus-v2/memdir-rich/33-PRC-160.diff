+def mark_returned(shipment_id):
+    """Mark a delivered shipment as returned to the depot.
+
+    Idempotent: a shipment that is already "returned" is returned unchanged
+    (no new event, returned_at kept). Only "delivered" shipments can be
+    returned; any other status (e.g. "created") fails with E_BAD_STATE.
+    """
+    shipment = get_shipment(shipment_id)
+    if shipment.status == "returned":
+        return shipment
+    if shipment.status not in RETURNABLE_STATUSES:
+        raise DomainError("E_BAD_STATE", f"{shipment_id} is {shipment.status}")
+    previous = shipment.status
+    shipment.status = "returned"
+    shipment.returned_at = clock.now()
+    events.emit(
+        "shipment.returned", shipment.id, from_status=previous, to_status="returned"
+    )
+    return shipment
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_shipments_returned.py b/tests/unit/test_shipments_returned.py
--- a/tests/unit/test_shipments_returned.py	1969-12-31 19:00:00
+++ b/tests/unit/test_shipments_returned.py	2026-11-12 03:29:10
@@ -0,0 +1,73 @@
+from datetime import datetime, timezone
+
+import pytest
+
+from parcelo import clock, customers, events, shipments
+from parcelo.errors import DomainError
+
+T0 = datetime(2026, 11, 12, 9, 0, tzinfo=timezone.utc)
+T1 = datetime(2026, 11, 12, 10, 0, tzinfo=timezone.utc)
+
+
+@pytest.fixture
+def shipment():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 2, "national")
+    events.OUTBOX.clear()
+    return s
+
+
+def _deliver(s):
+    s.status = "delivered"
+    s.delivered_at = T0
+
+
+def test_mark_returned_happy_path(shipment):
+    _deliver(shipment)
+    clock.set_fixed(T1)
+    result = shipments.mark_returned(shipment.id)
+    assert result is shipment
+    assert result.id == "shp_000001"
+    assert result.status == "returned"
+    assert result.returned_at == T1
+    assert result.delivered_at == T0
+    assert events.OUTBOX == [
+        {
+            "name": "shipment.returned",
+            "entity_id": "shp_000001",
+            "at": T1,
+            "payload": {"from_status": "delivered", "to_status": "returned"},
+        }
+    ]
+
+
+def test_new_shipment_has_no_returned_at(shipment):
+    assert shipment.returned_at is None
+
+
+def test_created_shipment_cannot_be_returned(shipment):
+    with pytest.raises(DomainError) as err:
+        shipments.mark_returned(shipment.id)
+    assert err.value.code == "E_BAD_STATE"
+    assert shipment.status == "created"
+    assert shipment.returned_at is None
+    assert events.OUTBOX == []
+
+
+def test_unknown_shipment_fails():
+    with pytest.raises(DomainError) as err:
+        shipments.mark_returned("shp_999999")
+    assert err.value.code == "E_NOT_FOUND"
+    assert events.OUTBOX == []
+
+
+def test_mark_returned_twice_is_idempotent(shipment):
+    _deliver(shipment)
+    clock.set_fixed(T1)
+    shipments.mark_returned(shipment.id)
+    clock.set_fixed(datetime(2026, 11, 13, tzinfo=timezone.utc))
+    again = shipments.mark_returned(shipment.id)
+    assert again is shipment
+    assert again.status == "returned"
+    assert again.returned_at == T1
+    assert len(events.OUTBOX) == 1
