+def _parse_declared_value(declared_value):
+    if declared_value is None or isinstance(declared_value, bool):
+        raise DomainError("E_BAD_INPUT", "declared value must be a positive amount")
+    try:
+        value = Money.parse(declared_value)
+    except (InvalidOperation, ValueError, TypeError):
+        raise DomainError("E_BAD_INPUT", f"invalid declared value: {declared_value!r}")
+    if value.cents <= 0:
+        raise DomainError("E_BAD_INPUT", "declared value must be positive")
+    return value
+
+
+def insurance_fee(declared_value, zone):
+    """Insurance fee: 2% plus the zone's fuel surcharge % of the declared value, min 1.00."""
+    if zone not in FUEL_SURCHARGE_PCT:
+        raise DomainError("E_BAD_ZONE", f"unknown zone: {zone}")
+    value = _parse_declared_value(declared_value)
+    pct = INSURANCE_BASE_PCT + FUEL_SURCHARGE_PCT[zone]
+    fee = value.scale(pct / Decimal("100"))
+    if fee < INSURANCE_MIN_FEE:
+        return INSURANCE_MIN_FEE
+    return fee
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_rates_insurance.py b/tests/unit/test_rates_insurance.py
