+++ b/tests/unit/test_rates_insurance.py	2026-11-12 03:08:53
@@ -0,0 +1,68 @@
+from decimal import Decimal
+
+import pytest
+
+from parcelo import rates
+from parcelo.errors import DomainError
+from parcelo.money import Money
+
+
+@pytest.mark.parametrize(
+    "declared, zone, expected",
+    [
+        ("100.00", "local", "2.00"),           # 2% + 0%
+        ("100.00", "national", "6.00"),        # 2% + 4%
+        ("100.00", "international", "11.50"),  # 2% + 9.5%
+        ("1234.56", "national", "74.07"),      # 74.0736
+        ("0.10", "international", "1.00"),    # below minimum
+    ],
+)
+def test_insurance_fee(declared, zone, expected):
+    assert rates.insurance_fee(declared, zone) == Money.parse(expected)
+
+
+def test_returns_money():
+    assert isinstance(rates.insurance_fee("500", "national"), Money)
+
+
+def test_minimum_fee_applies():
+    # 2% of 10.00 is 0.20, so the minimum of 1.00 is charged
+    assert rates.insurance_fee("10.00", "local") == Money.parse("1.00")
+
+
+def test_exactly_minimum_boundary():
+    # 2% of 50.00 is exactly 1.00
+    assert rates.insurance_fee("50.00", "local") == Money.parse("1.00")
+    assert rates.insurance_fee("50.50", "local") == Money.parse("1.01")
+
+
+def test_half_cent_rounds_half_up():
+    # 11.5% of 10.10 = 1.1615 -> 1.16 ; 2% of 50.25 = 1.005 -> 1.01
+    assert rates.insurance_fee("10.10", "international") == Money.parse("1.16")
+    assert rates.insurance_fee("50.25", "local") == Money.parse("1.01")
+
+
+@pytest.mark.parametrize("declared", [Money.parse("100"), 100, 100.0, Decimal("100")])
+def test_accepts_numeric_and_money_input(declared):
+    assert rates.insurance_fee(declared, "national") == Money.parse("6.00")
+
+
+@pytest.mark.parametrize("zone", ["mars", "", None, "LOCAL"])
+def test_unknown_zone_fails(zone):
+    with pytest.raises(DomainError) as exc:
+        rates.insurance_fee("100", zone)
+    assert exc.value.code == "E_BAD_ZONE"
+
+
+@pytest.mark.parametrize("declared", [0, "0", "0.00", -1, "-50.00", "0.001"])
+def test_non_positive_declared_value_fails(declared):
+    with pytest.raises(DomainError) as exc:
+        rates.insurance_fee(declared, "local")
+    assert exc.value.code == "E_BAD_INPUT"
+
+
+@pytest.mark.parametrize("declared", [None, True, "abc", object()])
+def test_invalid_declared_value_fails(declared):
+    with pytest.raises(DomainError) as exc:
+        rates.insurance_fee(declared, "local")
+    assert exc.value.code == "E_BAD_INPUT"
