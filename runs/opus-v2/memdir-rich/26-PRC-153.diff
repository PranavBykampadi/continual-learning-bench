+
+
+REVIEW_MAX_OPEN_INVOICES = 3
+REVIEW_MAX_OPEN_TOTAL = Money.parse("250.00")
+
+
+def needs_review(customer_id):
+    """True if the customer has more than 3 open invoices or their open total is over 250.00."""
+    if customer_id not in db.customers:
+        raise DomainError("E_NOT_FOUND", f"customer {customer_id} not found")
+    count = 0
+    total = Money.zero()
+    for invoice in db.invoices.values():
+        shipment = db.shipments[invoice.shipment_id]
+        if shipment.customer_id == customer_id and invoice.status in ("open",):
+            count += 1
+            total = total + Money.parse(invoice.amount)
+    return count > REVIEW_MAX_OPEN_INVOICES or REVIEW_MAX_OPEN_TOTAL < total
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_customers_needs_review.py b/tests/unit/test_customers_needs_review.py
--- a/tests/unit/test_customers_needs_review.py	1969-12-31 19:00:00
+++ b/tests/unit/test_customers_needs_review.py	2026-11-12 03:20:10
@@ -0,0 +1,80 @@
+import pytest
+
+from parcelo import customers, events
+from parcelo.errors import DomainError
+from parcelo.models import Invoice, Shipment
+from parcelo.store import db
+
+
+@pytest.fixture
+def customer():
+    c = customers.add_customer("Acme")
+    db.shipments["shp_x"] = Shipment(id="shp_x", customer_id=c.id, weight_kg=1, zone="local")
+    return c
+
+
+def add_invoice(n, amount, status="open", shipment_id="shp_x"):
+    db.invoices[f"inv_{n}"] = Invoice(id=f"inv_{n}", shipment_id=shipment_id, amount=amount, status=status)
+
+
+def test_no_invoices_is_false(customer):
+    assert customers.needs_review(customer.id) is False
+
+
+def test_three_open_invoices_under_total_is_false(customer):
+    for n in range(3):
+        add_invoice(n, 10.0)
+    assert customers.needs_review(customer.id) is False
+
+
+def test_four_open_invoices_is_true(customer):
+    for n in range(4):
+        add_invoice(n, 1.0)
+    assert customers.needs_review(customer.id) is True
+
+
+def test_total_exactly_250_is_false(customer):
+    add_invoice(1, 125.0)
+    add_invoice(2, 125.0)
+    assert customers.needs_review(customer.id) is False
+
+
+def test_total_over_250_is_true(customer):
+    add_invoice(1, 250.01)
+    assert customers.needs_review(customer.id) is True
+
+
+def test_float_sum_does_not_tip_over(customer):
+    # 0.1 + 0.2 style float error must not push 250.00 over the limit
+    add_invoice(1, 249.9)
+    add_invoice(2, 0.1)
+    assert customers.needs_review(customer.id) is False
+
+
+def test_paid_and_void_invoices_ignored(customer):
+    add_invoice(1, 300.0, status="paid")
+    add_invoice(2, 300.0, status="void")
+    for n in range(3, 7):
+        add_invoice(n, 1.0, status="paid")
+    assert customers.needs_review(customer.id) is False
+
+
+def test_other_customers_invoices_ignored(customer):
+    other = customers.add_customer("Other")
+    db.shipments["shp_y"] = Shipment(id="shp_y", customer_id=other.id, weight_kg=1, zone="local")
+    for n in range(5):
+        add_invoice(n, 100.0, shipment_id="shp_y")
+    assert customers.needs_review(customer.id) is False
+    assert customers.needs_review(other.id) is True
+
+
+def test_unknown_customer_fails():
+    with pytest.raises(DomainError) as err:
+        customers.needs_review("nope")
+    assert err.value.code == "E_NOT_FOUND"
+
+
+def test_read_only_no_events(customer):
+    add_invoice(1, 300.0)
+    customers.needs_review(customer.id)
+    assert events.OUTBOX == []
