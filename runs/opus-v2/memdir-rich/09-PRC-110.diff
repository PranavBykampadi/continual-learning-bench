+++ b/tests/unit/test_rates_discount.py	2026-11-12 02:59:06
@@ -0,0 +1,54 @@
+import pytest
+
+from parcelo import rates
+from parcelo.errors import DomainError
+from parcelo.money import Money
+
+
+@pytest.mark.parametrize(
+    "weight, zone, expected",
+    [
+        (2, "local", "7.00"),  # 4.50 + 2.50
+        (1, "national", "10.25"),  # 9.00 + 1.25
+        (3, "international", "27.75"),  # 24.00 + 3.75
+    ],
+)
+def test_standard_tier_is_regular_quote(weight, zone, expected):
+    result = rates.discounted_quote(weight, zone, "standard")
+    assert isinstance(result, Money)
+    assert result == Money.parse(expected)
+
+
+@pytest.mark.parametrize(
+    "weight, zone, expected",
+    [
+        (2, "local", "6.30"),  # 7.00 * 0.9
+        (1, "national", "9.23"),  # 9.225 -> half-up
+        (3, "international", "24.98"),  # 24.975 -> half-up
+        (1, "local", "5.18"),  # 5.175 -> half-up
+    ],
+)
+def test_gold_tier_gets_ten_percent_off(weight, zone, expected):
+    result = rates.discounted_quote(weight, zone, "gold")
+    assert isinstance(result, Money)
+    assert result == Money.parse(expected)
+
+
+def test_unknown_zone_fails():
+    with pytest.raises(DomainError) as err:
+        rates.discounted_quote(2, "mars", "gold")
+    assert err.value.code == "E_BAD_ZONE"
+
+
+@pytest.mark.parametrize("tier", ["platinum", "Gold", "", None])
+def test_unknown_tier_fails(tier):
+    with pytest.raises(DomainError) as err:
+        rates.discounted_quote(2, "local", tier)
+    assert err.value.code == "E_BAD_INPUT"
+
+
+@pytest.mark.parametrize("weight", [0, -1, "2", None])
+def test_bad_weight_fails(weight):
+    with pytest.raises(DomainError) as err:
+        rates.discounted_quote(weight, "local", "gold")
+    assert err.value.code == "E_BAD_WEIGHT"
