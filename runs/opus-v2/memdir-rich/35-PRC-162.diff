+
+
+LISTABLE_STATUSES = ("open", "paid")
+
+
+def invoices_by_status(status):
+    """Return a new list of invoices whose status is `status`, sorted by id.
+
+    Only "open" and "paid" may be asked for; anything else raises
+    DomainError E_BAD_INPUT. Returns [] when nothing matches.
+    """
+    if not isinstance(status, str) or status not in LISTABLE_STATUSES:
+        raise DomainError("E_BAD_INPUT", f"unknown invoice status {status!r}")
+    return sorted(
+        (i for i in db.invoices.values() if i.status == status),
+        key=lambda i: i.id,
+    )
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_invoices_by_status.py b/tests/unit/test_invoices_by_status.py
--- a/tests/unit/test_invoices_by_status.py	1969-12-31 19:00:00
+++ b/tests/unit/test_invoices_by_status.py	2026-11-12 03:31:42
@@ -0,0 +1,56 @@
+import pytest
+
+from parcelo import customers, events, invoices, shipments
+from parcelo.errors import DomainError
+from parcelo.store import db
+
+
+def _invoice(status="open"):
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 1.5, "national")
+    inv = invoices.issue_invoice(s.id)
+    inv.status = status
+    return inv
+
+
+@pytest.mark.parametrize("status", ["open", "paid"])
+def test_returns_only_matching_sorted_by_id(status):
+    other = "paid" if status == "open" else "open"
+    wanted = [_invoice(status) for _ in range(3)]
+    _invoice(other)
+    _invoice("void")
+    # break storage order so sorting is actually exercised
+    items = list(db.invoices.items())
+    db.invoices.clear()
+    db.invoices.update(reversed(items))
+
+    result = invoices.invoices_by_status(status)
+
+    assert result == sorted(wanted, key=lambda i: i.id)
+    assert all(i.status == status for i in result)
+
+
+def test_no_matches_returns_empty_list():
+    _invoice("open")
+    assert invoices.invoices_by_status("paid") == []
+
+
+def test_empty_store_returns_empty_list():
+    assert invoices.invoices_by_status("open") == []
+
+
+def test_returns_new_list():
+    _invoice("open")
+    first = invoices.invoices_by_status("open")
+    first.clear()
+    assert len(invoices.invoices_by_status("open")) == 1
+
+
+@pytest.mark.parametrize("bad", ["void", "OPEN", "", None, 1, "on_hold", ["open"]])
+def test_invalid_status_fails(bad):
+    _invoice("open")
+    events.OUTBOX.clear()
+    with pytest.raises(DomainError) as err:
+        invoices.invoices_by_status(bad)
+    assert err.value.code == "E_BAD_INPUT"
+    assert events.OUTBOX == []
