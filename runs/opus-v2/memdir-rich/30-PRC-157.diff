diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_invoices_hold.py b/tests/unit/test_invoices_hold.py
--- a/tests/unit/test_invoices_hold.py	1969-12-31 19:00:00
+++ b/tests/unit/test_invoices_hold.py	2026-11-12 03:25:21
@@ -0,0 +1,69 @@
+from datetime import datetime, timezone
+
+import pytest
+
+from parcelo import clock, events
+from parcelo.errors import DomainError
+from parcelo.invoices import hold_invoice
+from parcelo.models import Invoice
+from parcelo.store import db
+
+T0 = datetime(2026, 11, 12, 9, 0, tzinfo=timezone.utc)
+T1 = datetime(2026, 11, 12, 10, 0, tzinfo=timezone.utc)
+
+
+def _invoice(status="open"):
+    inv = Invoice(id="inv_000001", shipment_id="shp_000001", amount=10.0, status=status)
+    db.invoices[inv.id] = inv
+    return inv
+
+
+def test_new_invoice_has_no_held_at():
+    assert _invoice().held_at is None
+
+
+def test_hold_open_invoice():
+    _invoice()
+    clock.set_fixed(T0)
+    inv = hold_invoice("inv_000001")
+    assert inv is db.invoices["inv_000001"]
+    assert inv.status == "on_hold"
+    assert inv.held_at == T0
+    assert events.OUTBOX == [
+        {
+            "name": "invoice.held",
+            "entity_id": "inv_000001",
+            "at": T0,
+            "payload": {"from_status": "open", "to_status": "on_hold"},
+        }
+    ]
+
+
+def test_missing_invoice_fails():
+    with pytest.raises(DomainError) as err:
+        hold_invoice("nope")
+    assert err.value.code == "E_NOT_FOUND"
+    assert events.OUTBOX == []
+
+
+@pytest.mark.parametrize("status", ["paid", "void"])
+def test_non_open_invoice_fails(status):
+    inv = _invoice(status)
+    with pytest.raises(DomainError) as err:
+        hold_invoice(inv.id)
+    assert err.value.code == "E_BAD_STATE"
+    assert inv.status == status
+    assert inv.held_at is None
+    assert events.OUTBOX == []
+
+
+def test_hold_twice_is_idempotent():
+    _invoice()
+    clock.set_fixed(T0)
+    first = hold_invoice("inv_000001")
+    clock.set_fixed(T1)
+    second = hold_invoice("inv_000001")
+    assert second is first
+    assert second.status == "on_hold"
+    assert second.held_at == T0
+    assert len(events.OUTBOX) == 1
