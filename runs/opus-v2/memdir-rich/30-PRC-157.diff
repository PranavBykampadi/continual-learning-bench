+def hold_invoice(invoice_id):
+    """Put an open invoice on hold, pausing collection.
+
+    Idempotent: an invoice already on hold is returned unchanged (no new
+    event, held_at kept). Raises E_NOT_FOUND for unknown ids and
+    E_BAD_STATE for invoices that are not open.
+    """
+    invoice = db.invoices.get(invoice_id)
+    if invoice is None:
+        raise DomainError("E_NOT_FOUND", f"invoice {invoice_id}")
+    if invoice.status == "on_hold":
+        return invoice
+    if invoice.status not in HOLDABLE_STATUSES:
+        raise DomainError("E_BAD_STATE", f"invoice {invoice_id} is {invoice.status}")
+    previous = invoice.status
+    invoice.status = "on_hold"
+    invoice.held_at = clock.now()
+    events.emit("invoice.held", invoice.id, from_status=previous, to_status="on_hold")
+    return invoice
