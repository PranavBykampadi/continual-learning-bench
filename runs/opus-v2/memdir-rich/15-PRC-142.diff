@@ -32,3 +34,21 @@
 
 def open_invoices():
     return [i for i in db.invoices.values() if i.status == "open"]
+
+
+REOPENABLE_STATUSES = ("paid",)
+
+
+def reopen_invoice(invoice_id):
+    """Undo a mistaken mark_paid: set a paid invoice back to "open"."""
+    invoice = db.invoices.get(invoice_id)
+    if invoice is None:
+        raise DomainError("E_NOT_FOUND", f"invoice {invoice_id} not found")
+    if invoice.status not in REOPENABLE_STATUSES:
+        raise DomainError("E_BAD_STATE", f"{invoice_id} is {invoice.status}")
+    previous_paid_at = invoice.paid_at
+    invoice.status = "open"
+    invoice.paid_at = None
+    invoice.reopened_at = clock.now()
+    events.emit("invoice.reopened", invoice.id, previous_paid_at=previous_paid_at)
+    return invoice
