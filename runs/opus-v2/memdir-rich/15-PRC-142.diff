--- a/tests/unit/test_invoices_reopen.py	1969-12-31 19:00:00
+++ b/tests/unit/test_invoices_reopen.py	2026-11-12 03:06:24
@@ -0,0 +1,84 @@
+from datetime import datetime, timezone
+
+import pytest
+
+from parcelo import clock, customers, events, invoices, shipments
+from parcelo.errors import DomainError
+
+REOPEN_AT = datetime(2026, 11, 12, 9, 30, tzinfo=timezone.utc)
+
+
+@pytest.fixture
+def invoice():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 2, "local")
+    inv = invoices.issue_invoice(s.id)
+    events.OUTBOX.clear()
+    return inv
+
+
+def test_reopen_paid_invoice(invoice):
+    invoices.mark_paid(invoice.id)
+    paid_at = invoice.paid_at
+    clock.set_fixed(REOPEN_AT)
+
+    result = invoices.reopen_invoice(invoice.id)
+
+    assert result is invoice
+    assert invoice.status == "open"
+    assert invoice.paid_at is None
+    assert invoice.reopened_at == REOPEN_AT
+    assert invoice in invoices.open_invoices()
+    assert len(events.OUTBOX) == 1
+    event = events.OUTBOX[0]
+    assert event["name"] == "invoice.reopened"
+    assert event["entity_id"] == invoice.id
+    assert event["payload"] == {"previous_paid_at": paid_at}
+
+
+def test_new_invoice_has_no_reopened_at(invoice):
+    assert invoice.reopened_at is None
+
+
+def test_reopened_invoice_can_be_paid_again(invoice):
+    invoices.mark_paid(invoice.id)
+    invoices.reopen_invoice(invoice.id)
+
+    invoices.mark_paid(invoice.id)
+
+    assert invoice.status == "paid"
+    assert invoice.paid_at is not None
+
+
+def test_missing_invoice():
+    with pytest.raises(DomainError) as err:
+        invoices.reopen_invoice("INV-nope")
+    assert err.value.code == "E_NOT_FOUND"
+    assert events.OUTBOX == []
+
+
+@pytest.mark.parametrize("status", ["open", "void"])
+def test_not_paid_invoice(invoice, status):
+    invoice.status = status
+
+    with pytest.raises(DomainError) as err:
+        invoices.reopen_invoice(invoice.id)
+
+    assert err.value.code == "E_BAD_STATE"
+    assert invoice.status == status
+    assert invoice.reopened_at is None
+    assert events.OUTBOX == []
+
+
+def test_reopen_twice_fails(invoice):
+    invoices.mark_paid(invoice.id)
+    clock.set_fixed(REOPEN_AT)
+    invoices.reopen_invoice(invoice.id)
+    events.OUTBOX.clear()
+
+    with pytest.raises(DomainError) as err:
+        invoices.reopen_invoice(invoice.id)
+
+    assert err.value.code == "E_BAD_STATE"
+    assert invoice.reopened_at == REOPEN_AT
+    assert events.OUTBOX == []
