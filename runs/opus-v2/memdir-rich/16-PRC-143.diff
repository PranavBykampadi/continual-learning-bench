diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_pickups_schedule.py b/tests/unit/test_pickups_schedule.py
--- a/tests/unit/test_pickups_schedule.py	1969-12-31 19:00:00
+++ b/tests/unit/test_pickups_schedule.py	2026-11-12 03:07:30
@@ -0,0 +1,68 @@
+from datetime import datetime, timezone
+
+import pytest
+
+from parcelo import clock, customers, events, pickups, shipments, store
+from parcelo.errors import DomainError
+from parcelo.store import db
+
+BOOKED = datetime(2026, 11, 12, 9, 0, tzinfo=timezone.utc)
+WINDOW = datetime(2026, 11, 13, 14, 0, tzinfo=timezone.utc)
+
+
+@pytest.fixture
+def shipment():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 2.0, "local")
+    events.OUTBOX.clear()
+    return s
+
+
+def test_schedule_pickup_creates_and_stores(shipment):
+    clock.set_fixed(BOOKED)
+    p = pickups.schedule_pickup(shipment.id, WINDOW)
+    assert p.id.startswith("pku_")
+    assert p.shipment_id == shipment.id
+    assert p.window_start == WINDOW
+    assert p.scheduled_at == BOOKED
+    assert db.pickups[p.id] is p
+
+
+def test_schedule_pickup_emits_event(shipment):
+    p = pickups.schedule_pickup(shipment.id, WINDOW)
+    assert len(events.OUTBOX) == 1
+    ev = events.OUTBOX[0]
+    assert ev["name"] == "pickup.scheduled"
+    assert ev["entity_id"] == p.id
+    assert ev["payload"] == {"shipment_id": shipment.id, "window_start": WINDOW}
+
+
+def test_unknown_shipment_fails():
+    with pytest.raises(DomainError) as err:
+        pickups.schedule_pickup("shp_nope", WINDOW)
+    assert err.value.code == "E_NOT_FOUND"
+    assert db.pickups == {}
+    assert events.OUTBOX == []
+
+
+@pytest.mark.parametrize("status", ["delivered", "cancelled", "in_transit"])
+def test_non_created_shipment_fails(shipment, status):
+    shipment.status = status
+    with pytest.raises(DomainError) as err:
+        pickups.schedule_pickup(shipment.id, WINDOW)
+    assert err.value.code == "E_BAD_STATE"
+    assert db.pickups == {}
+    assert events.OUTBOX == []
+
+
+def test_missing_window_start_fails(shipment):
+    with pytest.raises(DomainError) as err:
+        pickups.schedule_pickup(shipment.id, None)
+    assert err.value.code == "E_BAD_INPUT"
+    assert db.pickups == {}
+
+
+def test_reset_clears_pickups(shipment):
+    pickups.schedule_pickup(shipment.id, WINDOW)
+    store.reset()
+    assert db.pickups == {}
