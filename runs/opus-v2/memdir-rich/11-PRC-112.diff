diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_claims_file.py b/tests/unit/test_claims_file.py
--- a/tests/unit/test_claims_file.py	1969-12-31 19:00:00
+++ b/tests/unit/test_claims_file.py	2026-11-12 03:01:08
@@ -0,0 +1,82 @@
+from datetime import datetime, timezone
+
+import pytest
+
+from parcelo import audit, clock, customers, shipments, store
+from parcelo.claims import file_claim
+from parcelo.errors import DomainError
+from parcelo.models import Claim
+from parcelo.money import Money
+from parcelo.store import db
+
+NOW = datetime(2026, 11, 12, 9, 30, tzinfo=timezone.utc)
+
+
+@pytest.fixture
+def shipment():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 2, "local")
+    s.status = "delivered"
+    audit.LOG.clear()
+    return s
+
+
+def test_file_claim_on_delivered_shipment(shipment):
+    clock.set_fixed(NOW)
+    claim = file_claim(shipment.id, "12.34", "  box crushed  ")
+    assert isinstance(claim, Claim)
+    assert claim.shipment_id == shipment.id
+    assert claim.amount == Money.parse("12.34")
+    assert isinstance(claim.amount, Money)
+    assert claim.reason == "box crushed"
+    assert claim.filed_at == NOW
+    assert db.claims == {claim.id: claim}
+    assert audit.LOG[-1]["action"] == "claim.filed"
+    assert audit.LOG[-1]["entity_id"] == claim.id
+
+
+def test_file_claim_accepts_money_and_avoids_float_errors(shipment):
+    assert file_claim(shipment.id, Money.parse("5.00"), "lost").amount == Money(500)
+    assert file_claim(shipment.id, 0.1 + 0.2, "late").amount == Money(30)
+
+
+def test_missing_shipment():
+    with pytest.raises(DomainError) as err:
+        file_claim("shp_missing", "10", "lost")
+    assert err.value.code == "E_NOT_FOUND"
+    assert db.claims == {}
+    assert audit.LOG == []
+
+
+@pytest.mark.parametrize("status", ["created", "cancelled"])
+def test_not_delivered(shipment, status):
+    shipment.status = status
+    with pytest.raises(DomainError) as err:
+        file_claim(shipment.id, "10", "lost")
+    assert err.value.code == "E_BAD_STATE"
+    assert db.claims == {}
+    assert audit.LOG == []
+
+
+@pytest.mark.parametrize("amount", [0, "0", -1, "-0.01", "0.001", "abc", None, True])
+def test_bad_amount(shipment, amount):
+    with pytest.raises(DomainError) as err:
+        file_claim(shipment.id, amount, "lost")
+    assert err.value.code == "E_BAD_INPUT"
+    assert db.claims == {}
+    assert audit.LOG == []
+
+
+@pytest.mark.parametrize("reason", ["", "   ", None, 42])
+def test_bad_reason(shipment, reason):
+    with pytest.raises(DomainError) as err:
+        file_claim(shipment.id, "10", reason)
+    assert err.value.code == "E_BAD_INPUT"
+    assert db.claims == {}
+    assert audit.LOG == []
+
+
+def test_reset_clears_claims(shipment):
+    file_claim(shipment.id, "1", "lost")
+    store.reset()
+    assert db.claims == {}
