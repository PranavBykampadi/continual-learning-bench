+def _age_in_days(issued_at, now):
+    # Old-style invoices store naive UTC datetimes; clock.now() is tz-aware UTC.
+    if issued_at.tzinfo is None:
+        issued_at = issued_at.replace(tzinfo=timezone.utc)
+    return (now - issued_at).days
+
+
+def aging_report():
+    """Total open invoice amounts by whole days since issue: 0-30, 31-60, 60+."""
+    totals = {name: Money.zero() for name, _, _ in AGING_BUCKETS}
+    now = clock.now()
+    for invoice in db.invoices.values():
+        if invoice.status not in AGING_STATUSES or invoice.issued_at is None:
+            continue
+        age = max(_age_in_days(invoice.issued_at, now), 0)
+        for name, low, high in AGING_BUCKETS:
+            if age >= low and (high is None or age <= high):
+                totals[name] = totals[name] + Money.parse(invoice.amount)
+                break
+    return totals
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_reports_aging.py b/tests/unit/test_reports_aging.py
