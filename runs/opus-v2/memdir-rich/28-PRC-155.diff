diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_customers_by_tier.py b/tests/unit/test_customers_by_tier.py
--- a/tests/unit/test_customers_by_tier.py	1969-12-31 19:00:00
+++ b/tests/unit/test_customers_by_tier.py	2026-11-12 03:22:55
@@ -0,0 +1,49 @@
+import pytest
+
+from parcelo import customers, events
+from parcelo.errors import DomainError
+from parcelo.store import db
+
+
+def test_returns_only_matching_tier_sorted_by_id():
+    gold = [customers.add_customer(f"Gold {n}", tier="gold") for n in range(5)]
+    standard = customers.add_customer("Plain")
+    # Re-store in descending id order so storage order != id order.
+    items = sorted(db.customers.items(), reverse=True)
+    db.customers.clear()
+    db.customers.update(items)
+
+    result = customers.customers_by_tier("gold")
+
+    assert [c.id for c in result] == sorted(c.id for c in gold)
+    assert customers.customers_by_tier("standard") == [standard]
+
+
+def test_includes_customers_created_via_add_customer():
+    a = customers.add_customer("Acme", tier="gold")
+    customers.add_customer("Bolt")
+    assert customers.customers_by_tier("gold") == [a]
+
+
+def test_known_tier_with_no_customers_returns_empty_list():
+    customers.add_customer("Acme")
+    assert customers.customers_by_tier("gold") == []
+
+
+def test_no_customers_at_all_returns_empty_list():
+    assert customers.customers_by_tier("standard") == []
+
+
+@pytest.mark.parametrize("tier", ["platinum", "", None, "Gold"])
+def test_unknown_tier_fails(tier):
+    customers.add_customer("Acme")
+    with pytest.raises(DomainError) as err:
+        customers.customers_by_tier(tier)
+    assert err.value.code == "E_BAD_INPUT"
+    assert events.OUTBOX == []
+
+
+def test_returns_new_list():
+    customers.add_customer("Acme", tier="gold")
+    customers.customers_by_tier("gold").clear()
+    assert len(customers.customers_by_tier("gold")) == 1
