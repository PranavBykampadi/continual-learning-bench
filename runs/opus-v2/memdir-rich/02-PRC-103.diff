+
+
+def quote_with_surcharge(weight_kg, zone):
+    """Quote for weight and zone, plus that zone's fuel surcharge."""
+    if zone not in ZONE_BASE or zone not in FUEL_SURCHARGE_PCT:
+        raise DomainError("E_BAD_ZONE", f"unknown zone: {zone}")
+    if weight_kg <= 0:
+        raise DomainError("E_BAD_WEIGHT", f"weight must be positive, got {weight_kg}")
+    base = Money.parse(quote(weight_kg, zone))
+    surcharge = base.scale(FUEL_SURCHARGE_PCT[zone] / 100.0)
+    return (base + surcharge).cents / 100
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_rates_surcharge.py b/tests/unit/test_rates_surcharge.py
--- a/tests/unit/test_rates_surcharge.py	1969-12-31 19:00:00
+++ b/tests/unit/test_rates_surcharge.py	2026-11-12 02:50:30
@@ -0,0 +1,40 @@
+import pytest
+
+from parcelo import rates
+from parcelo.errors import DomainError
+from parcelo.legacy import billing
+
+
+def test_local_has_no_surcharge():
+    assert rates.quote_with_surcharge(2, "local") == 7.0
+
+
+def test_national_adds_4_percent():
+    # quote = 9.0 + 1.25 * 4 = 14.0; surcharge 4% = 0.56
+    assert rates.quote_with_surcharge(4, "national") == 14.56
+
+
+def test_international_adds_9_5_percent():
+    # quote = 24.0 + 1.25 * 2 = 26.5; surcharge 9.5% = 2.5175 -> 2.52
+    assert rates.quote_with_surcharge(2, "international") == 29.02
+
+
+@pytest.mark.parametrize("zone", ["local", "national", "international"])
+@pytest.mark.parametrize("weight", [0.5, 1, 3.3, 12])
+def test_matches_quote_plus_legacy_surcharge(zone, weight):
+    q = rates.quote(weight, zone)
+    expected = round(q + billing.fuel_surcharge(q, zone), 2)
+    assert rates.quote_with_surcharge(weight, zone) == expected
+
+
+def test_unknown_zone_fails():
+    with pytest.raises(DomainError) as err:
+        rates.quote_with_surcharge(2, "moon")
+    assert err.value.code == "E_BAD_ZONE"
+
+
+@pytest.mark.parametrize("weight", [0, -1, -0.5])
+def test_non_positive_weight_fails(weight):
+    with pytest.raises(DomainError) as err:
+        rates.quote_with_surcharge(weight, "national")
+    assert err.value.code == "E_BAD_WEIGHT"
