diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_customers_address.py b/tests/unit/test_customers_address.py
--- a/tests/unit/test_customers_address.py	1969-12-31 19:00:00
+++ b/tests/unit/test_customers_address.py	2026-11-12 02:57:56
@@ -0,0 +1,60 @@
+import pytest
+
+from parcelo import audit, customers
+from parcelo.errors import DomainError
+from parcelo.models import Address
+from parcelo.store import db
+
+
+@pytest.fixture
+def customer():
+    c = customers.add_customer("Acme")
+    audit.LOG.clear()
+    return c
+
+
+def test_add_address_creates_and_stores(customer):
+    addr = customers.add_address(customer.id, "1 Main St", "Springfield")
+    assert isinstance(addr, Address)
+    assert addr.id.startswith("adr_")
+    assert addr.customer_id == customer.id
+    assert addr.line == "1 Main St"
+    assert addr.city == "Springfield"
+    assert db.addresses == {addr.id: addr}
+    assert audit.LOG[-1]["action"] == "address.created"
+    assert audit.LOG[-1]["entity_id"] == addr.id
+
+
+def test_multiple_addresses_get_distinct_ids(customer):
+    a = customers.add_address(customer.id, "1 Main St", "Springfield")
+    b = customers.add_address(customer.id, "2 Oak Ave", "Shelbyville")
+    assert a.id != b.id
+    assert len(db.addresses) == 2
+
+
+def test_unknown_customer_fails():
+    with pytest.raises(DomainError) as err:
+        customers.add_address("nope", "1 Main St", "Springfield")
+    assert err.value.code == "E_UNKNOWN_CUSTOMER"
+    assert db.addresses == {}
+    assert audit.LOG == []
+
+
+@pytest.mark.parametrize(
+    "line,city",
+    [("", "Springfield"), ("   ", "Springfield"), (None, "Springfield"),
+     ("1 Main St", ""), ("1 Main St", "  "), ("1 Main St", None)],
+)
+def test_empty_line_or_city_fails(customer, line, city):
+    with pytest.raises(DomainError) as err:
+        customers.add_address(customer.id, line, city)
+    assert err.value.code == "E_BAD_INPUT"
+    assert db.addresses == {}
+    assert audit.LOG == []
+
+
+def test_reset_clears_addresses(customer):
+    from parcelo import store
+    customers.add_address(customer.id, "1 Main St", "Springfield")
+    store.reset()
+    assert db.addresses == {}
