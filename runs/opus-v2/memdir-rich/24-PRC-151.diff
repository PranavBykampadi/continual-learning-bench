         raise DomainError("E_NOT_FOUND", shipment_id)
     return db.shipments[shipment_id]
+
+
+def list_shipments(customer_id):
+    """Return the customer's shipments in creation order ([] if none)."""
+    if customer_id not in db.customers:
+        raise DomainError("E_UNKNOWN_CUSTOMER", customer_id)
+    return [s for s in db.shipments.values() if s.customer_id == customer_id]
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_shipments_list.py b/tests/unit/test_shipments_list.py
--- a/tests/unit/test_shipments_list.py	1969-12-31 19:00:00
+++ b/tests/unit/test_shipments_list.py	2026-11-12 03:17:42
@@ -0,0 +1,44 @@
+import pytest
+
+from parcelo import customers, events, shipments
+from parcelo.errors import DomainError
+
+
+@pytest.fixture
+def acme():
+    return customers.add_customer("Acme")
+
+
+def test_lists_only_that_customers_shipments_in_order(acme):
+    other = customers.add_customer("Globex")
+    s1 = shipments.create_shipment(acme.id, 1.0, "local")
+    shipments.create_shipment(other.id, 2.0, "local")
+    s3 = shipments.create_shipment(acme.id, 3.0, "national")
+
+    result = shipments.list_shipments(acme.id)
+
+    assert [s.id for s in result] == ["shp_000001", "shp_000003"]
+    assert result == [s1, s3]
+
+
+def test_customer_without_shipments_gets_empty_list(acme):
+    assert shipments.list_shipments(acme.id) == []
+
+
+def test_unknown_customer_fails():
+    with pytest.raises(DomainError) as err:
+        shipments.list_shipments("nope")
+    assert err.value.code == "E_UNKNOWN_CUSTOMER"
+
+
+def test_listing_has_no_side_effects(acme):
+    shipments.create_shipment(acme.id, 1.0, "local")
+    events.OUTBOX.clear()
+    shipments.list_shipments(acme.id)
+    assert events.OUTBOX == []
+
+
+def test_returned_list_is_a_copy(acme):
+    shipments.create_shipment(acme.id, 1.0, "local")
+    shipments.list_shipments(acme.id).clear()
+    assert len(shipments.list_shipments(acme.id)) == 1
