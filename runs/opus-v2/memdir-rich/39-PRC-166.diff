+++ b/tests/unit/test_invoices_escalate.py	2026-11-12 03:36:20
@@ -0,0 +1,92 @@
+from datetime import datetime, timezone
+
+import pytest
+
+from parcelo import clock, customers, events, invoices, settings, shipments
+from parcelo.errors import DomainError
+from parcelo.money import Money
+
+NOW = datetime(2026, 11, 12, 9, 0, tzinfo=timezone.utc)
+
+
+@pytest.fixture
+def invoice():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 1.5, "national")
+    inv = invoices.issue_invoice(s.id)
+    inv.amount = 750.0
+    events.OUTBOX.clear()
+    clock.set_fixed(NOW)
+    return inv
+
+
+def test_escalates_open_invoice(invoice):
+    result = invoices.escalate_invoice(invoice.id)
+    assert result is invoice
+    assert invoice.status == "escalated"
+    assert invoice.escalated_at == NOW
+    assert events.OUTBOX == [
+        {
+            "name": "invoice.escalated",
+            "entity_id": invoice.id,
+            "at": NOW,
+            "payload": {"from_status": "open", "to_status": "escalated", "amount": "750.00 USD"},
+        }
+    ]
+
+
+def test_new_invoice_has_no_escalated_at(invoice):
+    assert invoice.escalated_at is None
+
+
+def test_exactly_minimum_amount_is_escalated(invoice):
+    invoice.amount = 500.00
+    assert Money.parse(invoice.amount) == Money.parse(settings.ESCALATION_MIN_AMOUNT)
+    invoices.escalate_invoice(invoice.id)
+    assert invoice.status == "escalated"
+
+
+def test_below_minimum_fails(invoice):
+    invoice.amount = 499.99
+    assert Money.parse(invoice.amount) < Money.parse(settings.ESCALATION_MIN_AMOUNT)
+    with pytest.raises(DomainError) as err:
+        invoices.escalate_invoice(invoice.id)
+    assert err.value.code == "E_BAD_STATE"
+    assert invoice.status == "open"
+    assert invoice.escalated_at is None
+    assert events.OUTBOX == []
+
+
+def test_threshold_comes_from_settings(invoice, monkeypatch):
+    monkeypatch.setattr(settings, "ESCALATION_MIN_AMOUNT", "1000.00")
+    with pytest.raises(DomainError) as err:
+        invoices.escalate_invoice(invoice.id)
+    assert err.value.code == "E_BAD_STATE"
+
+
+@pytest.mark.parametrize("status", ["paid", "void", "on_hold"])
+def test_non_open_invoice_fails(invoice, status):
+    invoice.status = status
+    with pytest.raises(DomainError) as err:
+        invoices.escalate_invoice(invoice.id)
+    assert err.value.code == "E_BAD_STATE"
