+ESCALATABLE_STATUSES = ("open",)
+
+
+def escalate_invoice(invoice_id):
+    """Escalate a large open invoice to collections. Idempotent.
+
+    Only open invoices of at least settings.ESCALATION_MIN_AMOUNT can be escalated.
+    An invoice that is already escalated is returned unchanged (no second event).
+    """
+    invoice = db.invoices.get(invoice_id)
+    if invoice is None:
+        raise DomainError("E_NOT_FOUND", f"invoice {invoice_id}")
+    if invoice.status == "escalated":
+        return invoice
+    if invoice.status not in ESCALATABLE_STATUSES:
+        raise DomainError("E_BAD_STATE", f"invoice {invoice_id} is {invoice.status}")
+    amount = Money.parse(invoice.amount)
+    if amount < Money.parse(settings.ESCALATION_MIN_AMOUNT):
+        raise DomainError("E_BAD_STATE", f"invoice {invoice_id} amount {amount} is below the escalation minimum")
+    previous = invoice.status
+    invoice.status = "escalated"
+    invoice.escalated_at = clock.now()
+    events.emit("invoice.escalated", invoice.id, from_status=previous, to_status="escalated", amount=str(amount))
     return invoice
 
 
