@@ -0,0 +1,123 @@
+from datetime import datetime, timezone
+
+import pytest
+
+from parcelo import clock, customers, events, returns, settings, shipments, store
+from parcelo.errors import DomainError
+from parcelo.models import ReturnRequest
+from parcelo.store import db
+
+T0 = datetime(2026, 11, 1, 9, 0, tzinfo=timezone.utc)
+
+
+@pytest.fixture
+def delivered():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 2, "national")  # shp_000001
+    s.status = "delivered"
+    events.OUTBOX.clear()
+    return s
+
+
+def test_request_return_creates_and_stores(delivered):
+    clock.set_fixed(T0)
+    r = returns.request_return(delivered.id, "  wrong size  ")
+    assert isinstance(r, ReturnRequest)
+    assert r.id == "ret_000002"
+    assert r.shipment_id == delivered.id
+    assert r.reason == "wrong size"
+    assert r.requested_at == T0
+    assert db.returns[r.id] is r
+    assert events.OUTBOX == [
+        {
+            "name": "return.requested",
+            "entity_id": "ret_000002",
+            "at": T0,
+            "payload": {"shipment_id": delivered.id, "reason": "wrong size"},
+        }
+    ]
+
+
+def test_missing_shipment_fails():
+    with pytest.raises(DomainError) as err:
+        returns.request_return("shp_999999", "damaged")
+    assert err.value.code == "E_NOT_FOUND"
+    assert db.returns == {}
+    assert events.OUTBOX == []
+
+
+@pytest.mark.parametrize("status", ["created