diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/parcelo/returns.py b/parcelo/returns.py
--- a/parcelo/returns.py	1969-12-31 19:00:00
+++ b/parcelo/returns.py	2026-11-12 03:26:13
@@ -0,0 +1,45 @@
+from parcelo import clock, events, ids, settings
+from parcelo.errors import DomainError
+from parcelo.models import ReturnRequest
+from parcelo.shipments import get_shipment
+from parcelo.store import db
+
+RETURNABLE_STATUSES = ("delivered",)
+
+
+def request_return(shipment_id, reason):
+    """File a return request for a delivered shipment.
+
+    Fails with E_NOT_FOUND if the shipment does not exist, E_BAD_STATE if it is not
+    delivered, E_BAD_INPUT for an empty reason, and E_LIMIT once the shipment already
+    has settings.MAX_RETURNS_PER_SHIPMENT requests.
+    """
+    shipment = get_shipment(shipment_id)
+    if shipment.status not in RETURNABLE_STATUSES:
+        raise DomainError("E_BAD_STATE", f"{shipment_id} is {shipment.status}")
+    if not isinstance(reason, str) or not reason.strip():
+        raise DomainError("E_BAD_INPUT", "reason must be a non-empty string")
+    existing = sum(1 for r in db.returns.values() if r.shipment_id == shipment_id)
+    if existing >= settings.MAX_RETURNS_PER_SHIPMENT:
+        raise DomainError(
+            "E_LIMIT",
+            f"{shipment_id} already has {existing} return requests "
+            f"(max {settings.MAX_RETURNS_PER_SHIPMENT})",
+        )
+    request = ReturnRequest(
+        id=ids.new_id("ret"),
+        shipment_id=shipment_id,
+        reason=reason.strip(),
+        requested_at=clock.now(),
+    )
+    db.returns[request.id] = request
+    events.emit("return.requested", request.id, shipment_id=shipment_id, reason=request.reason)
+    return request
+
+
+def returns_for(shipment_id):
+    """Return the return requests filed for a shipment, sorted by id (new list)."""
+    return sorted(
+        (r for r in db.returns.values() if r.shipment_id == shipment_id),
+        key=lambda r: r.id,
+    )
