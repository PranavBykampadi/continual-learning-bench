 def open_invoices():
     return [i for i in db.invoices.values() if i.status == "open"]
+
+
+WRITE_OFFABLE_STATUSES = ("open",)
+
+
+def write_off(invoice_id):
+    """Write off an open invoice we will never collect; returns the amount written off as Money."""
+    invoice = db.invoices.get(invoice_id)
+    if invoice is None:
+        raise DomainError("E_NOT_FOUND", f"invoice {invoice_id} not found")
+    if invoice.status not in WRITE_OFFABLE_STATUSES:
+        raise DomainError("E_BAD_STATE", f"{invoice_id} is {invoice.status}")
+    amount = Money.parse(invoice.amount)
+    invoice.status = "written_off"
+    invoice.written_off_at = clock.now()
+    events.emit("invoice.written_off", invoice.id, amount=amount)
+    return amount
