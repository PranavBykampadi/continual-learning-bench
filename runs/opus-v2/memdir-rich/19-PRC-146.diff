--- a/tests/unit/test_invoices_write_off.py	1969-12-31 19:00:00
+++ b/tests/unit/test_invoices_write_off.py	2026-11-12 03:11:08
@@ -0,0 +1,76 @@
+from datetime import datetime, timezone
+
+import pytest
+
+from parcelo import clock, customers, events, invoices, shipments
+from parcelo.errors import DomainError
+from parcelo.money import Money
+
+WHEN = datetime(2026, 11, 12, 9, 30, tzinfo=timezone.utc)
+
+
+@pytest.fixture
+def invoice():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 1.5, "national")
+    inv = invoices.issue_invoice(s.id)
+    inv.amount = 12.34
+    events.OUTBOX.clear()
+    return inv
+
+
+def test_write_off_open_invoice(invoice):
+    clock.set_fixed(WHEN)
+    amount = invoices.write_off(invoice.id)
+    assert amount == Money.parse("12.34")
+    assert isinstance(amount, Money)
+    assert invoice.status == "written_off"
+    assert invoice.written_off_at == WHEN
+    assert invoice.amount == 12.34
+    assert invoice.paid_at is None
+    assert events.OUTBOX == [
+        {
+            "name": "invoice.written_off",
+            "entity_id": invoice.id,
+            "at": WHEN,
+            "payload": {"amount": Money.parse("12.34")},
+        }
+    ]
+
+
+def test_written_off_invoice_no_longer_open(invoice):
+    invoices.write_off(invoice.id)
+    assert invoice not in invoices.open_invoices()
+
+
+def test_new_invoice_has_no_written_off_at(invoice):
+    assert invoice.written_off_at is None
+
+
+def test_missing_invoice():
+    with pytest.raises(DomainError) as err:
+        invoices.write_off("nope")
+    assert err.value.code == "E_NOT_FOUND"
+    assert events.OUTBOX == []
+
+
+@pytest.mark.parametrize("status", ["paid", "void"])
+def test_non_open_invoice_rejected(invoice, status):
+    invoice.status = status
+    with pytest.raises(DomainError) as err:
+        invoices.write_off(invoice.id)
+    assert err.value.code == "E_BAD_STATE"
+    assert invoice.status == status
+    assert invoice.written_off_at is None
+    assert events.OUTBOX == []
+
+
+def test_write_off_twice_fails(invoice):
+    clock.set_fixed(WHEN)
+    invoices.write_off(invoice.id)
+    events.OUTBOX.clear()
+    with pytest.raises(DomainError) as err:
+        invoices.write_off(invoice.id)
+    assert err.value.code == "E_BAD_STATE"
+    assert invoice.written_off_at == WHEN
+    assert events.OUTBOX == []
