+import pytest
+
+from parcelo import customers, events, invoices, settings, shipments
+from parcelo.errors import DomainError
+from parcelo.money import Money
+from parcelo.store import db
+
+
+def _seed(customer, n_shipments, paid_amounts=(), open_amounts=()):
+    created = [shipments.create_shipment(customer.id, 1, "local") for _ in range(n_shipments)]
+    amounts = [(a, "paid") for a in paid_amounts] + [(a, "open") for a in open_amounts]
+    for shipment, (amount, status) in zip(created, amounts):
+        inv = invoices.issue_invoice(shipment.id)
+        inv.amount = amount
+        inv.status = status
+    return created
+
+
+def test_below_regular_cutoff_is_zero():
+    c = customers.add_customer("Acme")
+    _seed(c, settings.REBATE_REGULAR_MIN_SHIPMENTS - 1, paid_amounts=[100.0])
+    assert customers.rebate_for(c.id) == Money.zero()
+
+
+def test_no_shipments_is_zero():
+    c = customers.add_customer("Acme")
+    assert customers.rebate_for(c.id) == Money.zero()
+
+
+def test_regular_rate_at_cutoff_counts_only_paid():
+    c = customers.add_customer("Acme")
+    _seed(c, settings.REBATE_REGULAR_MIN_SHIPMENTS,
+          paid_amounts=[100.0, 50.5], open_amounts=[1000.0])
+    # 3% of 150.50
+    assert customers.rebate_for(c.id) == Money.parse("4.52")
+
+
+def test_just_below_bulk_is_regular():
+    c = customers.add_customer("Acme")
+    _seed(c, settings.REBATE_BULK_MIN_SHIPMENTS - 1, paid_amounts=[200.0])
+    assert customers.rebate_for(c.id) == Money.parse("6.00")
+
+
+def test_bulk_rate_at_cutoff():
+    c = customers.add_customer("Acme")
+    _seed(c, settings.REBATE_BULK_MIN_SHIPMENTS, paid_amounts=[200.0, 100.0])
+    assert customers.rebate_for(c.id) == Money.parse("18.00")
+
+
+def test_other_customers_invoices_and_shipments_ignored():
+    a = customers.add_customer("A")
+    b = customers.add_customer("B")
+    _seed(a, settings.REBATE_REGULAR_MIN_SHIPMENTS, paid_amounts=[100.0])
+    _seed(b, settings.REBATE_BULK_MIN_SHIPMENTS, paid_amounts=[999.0])
+    assert customers.rebate_for(a.id) == Money.parse("3.00")
+
+
+def test_tier_without_paid_invoices_is_zero():
+    c = customers.add_customer("Acme")
+    _seed(c, settings.REBATE_REGULAR_MIN_SHIPMENTS, open_amounts=[100.0])
+    assert customers.rebate_for(c.id) == Money.zero()
+
+
+def test_returns_money():
+    c = customers.add_customer("Acme")
+    _seed(c, settings.REBATE_REGULAR_MIN_SHIPMENTS, paid_amounts=[10.0])
+    assert isinstance(customers.rebate_for(c.id), Money)
+
+
+def test_unknown_customer_fails():
+    events.OUTBOX