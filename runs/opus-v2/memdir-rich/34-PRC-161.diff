+def _rebate_rate(shipment_count):
+    if shipment_count >= settings.REBATE_BULK_MIN_SHIPMENTS:
+        return settings.REBATE_BULK_RATE
+    if shipment_count >= settings.REBATE_REGULAR_MIN_SHIPMENTS:
+        return settings.REBATE_REGULAR_RATE
+    return None
+
+
+def rebate_for(customer_id):
+    """Volume rebate the customer has earned, as Money.
+
+    A share of the total of the customer's paid invoices, chosen by how many
+    shipments the customer has (all statuses). Zero below the lowest cut-off.
+    Raises DomainError E_NOT_FOUND for an unknown customer.
+    """
+    if customer_id not in db.customers:
+        raise DomainError("E_NOT_FOUND", customer_id)
+    shipment_ids = {s.id for s in db.shipments.values() if s.customer_id == customer_id}
+    rate = _rebate_rate(len(shipment_ids))
+    if rate is None:
+        return Money.zero()
+    paid_total = Money.zero()
+    for invoice in db.invoices.values():
+        if invoice.shipment_id in shipment_ids and invoice.status in REBATE_INVOICE_STATUSES:
+            paid_total = paid_total + Money.parse(invoice.amount)
+    return paid_total.scale(rate)
