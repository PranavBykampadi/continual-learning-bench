+"""Business numbers that Finance may change. Import these; don't copy them."""
+from decimal import Decimal
+
+# Volume rebate (PRC-161). Shipment-count cut-offs match the old billing volume tiers.
+REBATE_REGULAR_MIN_SHIPMENTS = 10
+REBATE_BULK_MIN_SHIPMENTS = 50
+REBATE_REGULAR_RATE = Decimal("0.03")
+REBATE_BULK_RATE = Decimal("0.06")
