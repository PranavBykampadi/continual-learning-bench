diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_customers_reactivate.py b/tests/unit/test_customers_reactivate.py
--- a/tests/unit/test_customers_reactivate.py	1969-12-31 19:00:00
+++ b/tests/unit/test_customers_reactivate.py	2026-11-12 03:21:29
@@ -0,0 +1,44 @@
+import pytest
+
+from parcelo import customers, events
+from parcelo.errors import DomainError
+from parcelo.store import db
+
+
+@pytest.fixture
+def inactive_customer():
+    c = customers.add_customer("Acme")
+    c.active = False
+    return c
+
+
+def test_reactivate_sets_active_and_returns_customer(inactive_customer):
+    result = customers.reactivate_customer(inactive_customer.id)
+    assert result is inactive_customer
+    assert db.customers[inactive_customer.id].active is True
+    assert len(events.OUTBOX) == 1
+    assert events.OUTBOX[0]["name"] == "customer.reactivated"
+    assert events.OUTBOX[0]["entity_id"] == inactive_customer.id
+
+
+def test_reactivate_missing_customer_fails():
+    with pytest.raises(DomainError) as err:
+        customers.reactivate_customer("nope")
+    assert err.value.code == "E_NOT_FOUND"
+    assert events.OUTBOX == []
+
+
+def test_reactivate_already_active_is_noop():
+    c = customers.add_customer("Acme")
+    result = customers.reactivate_customer(c.id)
+    assert result is c
+    assert c.active is True
+    assert events.OUTBOX == []
+
+
+def test_reactivate_twice_returns_same_customer_one_event(inactive_customer):
+    first = customers.reactivate_customer(inactive_customer.id)
+    second = customers.reactivate_customer(inactive_customer.id)
+    assert first is second
+    assert second.active is True
+    assert len(events.OUTBOX) == 1
