+def reactivate_customer(customer_id):
+    """Switch a customer back on. Idempotent: an already active customer is returned unchanged."""
+    customer = db.customers.get(customer_id)
+    if customer is None:
+        raise DomainError("E_NOT_FOUND", customer_id)
+    if customer.active:
+        return customer
+    customer.active = True
+    events.emit("customer.reactivated", customer.id)
+    return customer
 
 
