diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_returns.py b/tests/unit/test_returns.py
--- a/tests/unit/test_returns.py	1969-12-31 19:00:00
+++ b/tests/unit/test_returns.py	2026-11-12 02:14:50
@@ -0,0 +1,70 @@
+from datetime import datetime, timezone
+
+import pytest
+
+from parcelo import clock, customers, events, returns, shipments, store
+from parcelo.errors import DomainError
+
+
+def _delivered_shipment():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 1, "local")
+    s.status = "delivered"
+    return s
+
+
+def test_request_return_saves_and_returns():
+    moment = datetime(2026, 1, 2, tzinfo=timezone.utc)
+    clock.set_fixed(moment)
+    s = _delivered_shipment()
+    r = returns.request_return(s.id, "damaged")
+    assert r.id.startswith("ret_")
+    assert (r.shipment_id, r.reason, r.requested_at) == (s.id, "damaged", moment)
+    assert store.db.returns[r.id] is r
+    assert returns.returns_for(s.id) == [r]
+    assert events.OUTBOX[-1]["name"] == "return.requested"
+
+
+def test_returns_for_filters_by_shipment():
+    a, b = _delivered_shipment(), _delivered_shipment()
+    returns.request_return(a.id, "x")
+    assert returns.returns_for(b.id) == []
+
+
+def test_unknown_shipment():
+    with pytest.raises(DomainError) as err:
+        returns.request_return("shp_nope", "x")
+    assert err.value.code == "E_NOT_FOUND"
+
+
+def test_not_delivered():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 1, "local")
+    with pytest.raises(DomainError) as err:
+        returns.request_return(s.id, "x")
+    assert err.value.code == "E_BAD_STATE"
+    assert returns.returns_for(s.id) == []
+
+
+def test_empty_reason():
+    s = _delivered_shipment()
+    with pytest.raises(DomainError) as err:
+        returns.request_return(s.id, "  ")
+    assert err.value.code == "E_BAD_INPUT"
+
+
+def test_fourth_request_fails():
+    s = _delivered_shipment()
+    for i in range(3):
+        returns.request_return(s.id, f"r{i}")
+    with pytest.raises(DomainError) as err:
+        returns.request_return(s.id, "r3")
+    assert err.value.code == "E_LIMIT"
+    assert len(returns.returns_for(s.id)) == 3
+
+
+def test_reset_clears_returns():
+    s = _delivered_shipment()
+    returns.request_return(s.id, "x")
+    store.reset()
+    assert store.db.returns == {}
