+++ b/parcelo/rates.py	2026-11-12 01:51:43
@@ -1,3 +1,5 @@
+from parcelo.legacy.billing import fuel_surcharge
+
 ZONE_BASE = {"local": 4.5, "national": 9.0, "international": 24.0}
 PER_KG = 1.25
 
@@ -12,3 +14,13 @@
     if weight_kg <= 0:
         raise ValueError("weight must be positive")
     return round(base_rate(zone) + PER_KG * weight_kg, 2)
+
+
+def quote_with_surcharge(weight_kg, zone):
+    """Quote including the zone's fuel surcharge.
+
+    Raises ValueError for an unknown zone or a non-positive weight
+    (validation is done by ``quote`` before the surcharge is looked up).
+    """
+    amount = quote(weight_kg, zone)
+    return round(amount + fuel_surcharge(amount, zone), 2)
