+++ b/tests/test_reports.py	2026-11-12 01:57:11
@@ -0,0 +1,38 @@
+from parcelo import customers, invoices, reports, shipments
+from parcelo.store import db
+
+
+def _invoice(customer_id, weight=2, zone="local"):
+    s = shipments.create_shipment(customer_id, weight, zone)
+    return invoices.issue_invoice(s.id)
+
+
+def test_outstanding_by_customer_sums_open_only():
+    a = customers.add_customer("Acme")
+    b = customers.add_customer("Bolt")
+    _invoice(a.id)  # 7.0
+    _invoice(a.id, 1, "national")  # 10.25
+    paid = _invoice(a.id)
+    invoices.mark_paid(paid.id)
+    void = _invoice(b.id)
+    db.invoices[void.id].status = "void"
+    _invoice(b.id, 4, "international")  # 29.0
+
+    assert reports.outstanding_by_customer() == {a.id: 17.25, b.id: 29.0}
+
+
+def test_outstanding_includes_customers_with_nothing_owed():
+    a = customers.add_customer("Acme")
+    assert reports.outstanding_by_customer() == {a.id: 0.0}
+
+
+def test_outstanding_empty_store():
+    assert reports.outstanding_by_customer() == {}
+
+
+def test_outstanding_avoids_float_drift():
+    a = customers.add_customer("Acme")
+    for _ in range(3):
+        inv = _invoice(a.id)
+        db.invoices[inv.id].amount = 0.1
+    assert reports.outstanding_by_customer() == {a.id: 0.3}
