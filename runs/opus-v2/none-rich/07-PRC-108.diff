+def outstanding_by_customer():
+    """Map every customer id to the total of that customer's open invoices.
+
+    Only invoices with status "open" count; paid and void invoices are
+    excluded. Customers with nothing outstanding are included with 0.0 so the
+    report covers every customer. Amounts are summed in cents to avoid float
+    drift and returned as dollar floats rounded to 2 places.
+    """
+    totals = {customer_id: Money.zero() for customer_id in db.customers}
+    for invoice in db.invoices.values():
+        if invoice.status != "open":
+            continue
+        customer_id = db.shipments[invoice.shipment_id].customer_id
+        totals[customer_id] = totals.get(customer_id, Money.zero()) + Money.parse(
+            invoice.amount
+        )
+    return {customer_id: total.cents / 100 for customer_id, total in totals.items()}
 
 
