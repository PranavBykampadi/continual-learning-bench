diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/parcelo/claims.py b/parcelo/claims.py
--- a/parcelo/claims.py	1969-12-31 19:00:00
+++ b/parcelo/claims.py	2026-11-12 02:00:11
@@ -0,0 +1,37 @@
+import math
+from decimal import Decimal
+
+from parcelo import audit, clock, ids
+from parcelo.errors import DomainError
+from parcelo.models import Claim
+from parcelo.store import db
+
+
+def _validate_amount(amount):
+    if isinstance(amount, bool) or not isinstance(amount, (int, float, Decimal)):
+        raise DomainError("E_BAD_INPUT", f"amount must be a number: {amount!r}")
+    if isinstance(amount, (float, Decimal)) and not math.isfinite(amount):
+        raise DomainError("E_BAD_INPUT", f"amount must be finite: {amount!r}")
+    if amount <= 0:
+        raise DomainError("E_BAD_INPUT", f"amount must be positive: {amount!r}")
+
+
+def file_claim(shipment_id, amount, reason):
+    if shipment_id not in db.shipments:
+        raise DomainError("E_NOT_FOUND", str(shipment_id))
+    shipment = db.shipments[shipment_id]
+    if shipment.status != "delivered":
+        raise DomainError(
+            "E_BAD_STATE", f"shipment {shipment_id} is {shipment.status}, not delivered"
+        )
+    _validate_amount(amount)
+    claim = Claim(
+        id=ids.new_id("clm"),
+        shipment_id=shipment_id,
+        amount=amount,
+        reason=reason,
+        filed_at=clock.now(),
+    )
+    db.claims[claim.id] = claim
+    audit.record("claim.filed", claim.id, shipment_id=shipment_id, amount=amount)
+    return claim
