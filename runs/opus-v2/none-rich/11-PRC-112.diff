diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_claims.py b/tests/unit/test_claims.py
--- a/tests/unit/test_claims.py	1969-12-31 19:00:00
+++ b/tests/unit/test_claims.py	2026-11-12 02:00:11
@@ -0,0 +1,56 @@
+from datetime import datetime, timezone
+
+import pytest
+
+from parcelo import audit, claims, clock, customers, shipments, store
+from parcelo.errors import DomainError
+
+
+def _shipment(status="delivered"):
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 1, "local")
+    s.status = status
+    return s
+
+
+def test_file_claim_on_delivered_shipment():
+    moment = datetime(2026, 1, 2, tzinfo=timezone.utc)
+    clock.set_fixed(moment)
+    s = _shipment()
+    claim = claims.file_claim(s.id, 12.5, "damaged")
+    assert claim.id.startswith("clm_")
+    assert (claim.shipment_id, claim.amount, claim.reason) == (s.id, 12.5, "damaged")
+    assert claim.filed_at == moment
+    assert store.db.claims[claim.id] is claim
+    assert audit.LOG[-1]["action"] == "claim.filed"
+
+
+def test_unknown_shipment():
+    with pytest.raises(DomainError) as err:
+        claims.file_claim("nope", 5, "lost")
+    assert err.value.code == "E_NOT_FOUND"
+
+
+@pytest.mark.parametrize("status", ["created", "in_transit", "cancelled"])
+def test_not_delivered(status):
+    s = _shipment(status)
+    with pytest.raises(DomainError) as err:
+        claims.file_claim(s.id, 5, "lost")
+    assert err.value.code == "E_BAD_STATE"
+    assert store.db.claims == {}
+
+
+@pytest.mark.parametrize("amount", [0, -1, -0.01, float("nan"), float("inf"), True, "10", None])
+def test_bad_amount(amount):
+    s = _shipment()
+    with pytest.raises(DomainError) as err:
+        claims.file_claim(s.id, amount, "lost")
+    assert err.value.code == "E_BAD_INPUT"
+    assert store.db.claims == {}
+
+
+def test_reset_clears_claims():
+    s = _shipment()
+    claims.file_claim(s.id, 5, "lost")
+    store.reset()
+    assert store.db.claims == {}
