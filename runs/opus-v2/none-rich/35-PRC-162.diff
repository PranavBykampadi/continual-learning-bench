+
+def test_invoices_by_status():
+    c = customers.add_customer("Acme")
+    a = invoices.issue_invoice(shipments.create_shipment(c.id, 2, "local").id)
+    b = invoices.issue_invoice(shipments.create_shipment(c.id, 3, "local").id)
+    invoices.mark_paid(b.id)
+    assert invoices.invoices_by_status("open") == [a]
+    assert invoices.invoices_by_status("paid") == [b]
+
+
+def test_invoices_by_status_empty():
+    assert invoices.invoices_by_status("open") == []
+    assert invoices.invoices_by_status("paid") == []
+
+
+@pytest.mark.parametrize("status", ["void", "", None, "OPEN"])
+def test_invoices_by_status_rejects_invalid(status):
+    with pytest.raises(DomainError) as exc:
+        invoices.invoices_by_status(status)
+    assert exc.value.code == "E_BAD_INPUT"
