diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_pickups.py b/tests/unit/test_pickups.py
--- a/tests/unit/test_pickups.py	1969-12-31 19:00:00
+++ b/tests/unit/test_pickups.py	2026-11-12 02:04:25
@@ -0,0 +1,43 @@
+from datetime import datetime, timezone
+
+import pytest
+
+from parcelo import clock, customers, events, pickups, shipments
+from parcelo.errors import DomainError
+from parcelo.store import db
+
+WINDOW = datetime(2026, 11, 13, 9, 0, tzinfo=timezone.utc)
+
+
+def _shipment():
+    c = customers.add_customer("Acme")
+    return shipments.create_shipment(c.id, 1.5, "local")
+
+
+def test_schedule_pickup():
+    booked = datetime(2026, 11, 12, 15, 0, tzinfo=timezone.utc)
+    clock.set_fixed(booked)
+    s = _shipment()
+    p = pickups.schedule_pickup(s.id, WINDOW)
+    assert p.id.startswith("pku_")
+    assert p.shipment_id == s.id
+    assert p.window_start == WINDOW
+    assert p.scheduled_at == booked
+    assert db.pickups[p.id] is p
+    assert events.OUTBOX[-1]["name"] == "pickup.scheduled"
+
+
+def test_unknown_shipment():
+    with pytest.raises(DomainError) as err:
+        pickups.schedule_pickup("nope", WINDOW)
+    assert err.value.code == "E_NOT_FOUND"
+    assert db.pickups == {}
+
+
+def test_shipment_not_created():
+    s = _shipment()
+    s.status = "delivered"
+    with pytest.raises(DomainError) as err:
+        pickups.schedule_pickup(s.id, WINDOW)
+    assert err.value.code == "E_BAD_STATE"
+    assert db.pickups == {}
