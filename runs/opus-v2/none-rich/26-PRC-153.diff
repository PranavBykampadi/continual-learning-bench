+def needs_review(customer_id):
+    """True if the customer has more than 3 open invoices or more than 250.00 open."""
+    if customer_id not in db.customers:
+        raise DomainError("E_UNKNOWN_CUSTOMER", customer_id)
+    if _open_invoice_count(customer_id) > REVIEW_MAX_OPEN_INVOICES:
+        return True
+    return outstanding_balance(customer_id) > REVIEW_MAX_OPEN_BALANCE
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/test_customers.py b/tests/test_customers.py
--- a/tests/test_customers.py	1969-12-31 19:00:00
+++ b/tests/test_customers.py	2026-11-12 02:11:20
@@ -0,0 +1,66 @@
+import pytest
+
+from parcelo import customers
+from parcelo.errors import DomainError
+from parcelo.models import Invoice, Shipment
+from parcelo.store import db
+
+
+def _invoice(customer_id, amount, status="open"):
+    n = len(db.invoices)
+    sid = f"shp_t{n}"
+    db.shipments[sid] = Shipment(id=sid, customer_id=customer_id, weight_kg=1, zone="local")
+    db.invoices[f"inv_t{n}"] = Invoice(id=f"inv_t{n}", shipment_id=sid, amount=amount, status=status)
+
+
+def test_no_invoices():
+    c = customers.add_customer("Acme")
+    assert customers.needs_review(c.id) is False
+
+
+def test_three_open_invoices_is_fine():
+    c = customers.add_customer("Acme")
+    for _ in range(3):
+        _invoice(c.id, 10.0)
+    assert customers.needs_review(c.id) is False
+
+
+def test_four_open_invoices():
+    c = customers.add_customer("Acme")
+    for _ in range(4):
+        _invoice(c.id, 10.0)
+    assert customers.needs_review(c.id) is True
+
+
+def test_paid_invoices_not_counted():
+    c = customers.add_customer("Acme")
+    for _ in range(3):
+        _invoice(c.id, 10.0)
+    _invoice(c.id, 500.0, status="paid")
+    assert customers.needs_review(c.id) is False
+
+
+def test_balance_exactly_250_is_fine():
+    c = customers.add_customer("Acme")
+    _invoice(c.id, 200.0)
+    _invoice(c.id, 50.0)
+    assert customers.needs_review(c.id) is False
+
+
+def test_balance_over_250():
+    c = customers.add_customer("Acme")
+    _invoice(c.id, 250.01)
+    assert customers.needs_review(c.id) is True
+
+
+def test_other_customers_invoices_ignored():
+    c = customers.add_customer("Acme")
+    other = customers.add_customer("Other")
+    _invoice(other.id, 999.0)
+    assert customers.needs_review(c.id) is False
+
+
+def test_unknown_customer():
+    with pytest.raises(DomainError) as err:
+        customers.needs_review("nope")
+    assert err.value.code == "E_UNKNOWN_CUSTOMER"
