--- a/tests/test_reports.py	1969-12-31 19:00:00
+++ b/tests/test_reports.py	2026-11-12 02:07:13
@@ -0,0 +1,27 @@
+from parcelo import customers, reports, shipments
+
+
+def _ship(customer_id, n):
+    for _ in range(n):
+        shipments.create_shipment(customer_id, 1.0, "local")
+
+
+def test_volume_report_empty():
+    assert reports.volume_report() == {}
+
+
+def test_volume_report_counts_and_tiers():
+    idle = customers.add_customer("Idle")
+    small = customers.add_customer("Small")
+    regular = customers.add_customer("Regular")
+    bulk = customers.add_customer("Bulk")
+    _ship(small.id, 9)
+    _ship(regular.id, 10)
+    _ship(bulk.id, 50)
+
+    assert reports.volume_report() == {
+        idle.id: {"shipments": 0, "tier": "starter"},
+        small.id: {"shipments": 9, "tier": "starter"},
+        regular.id: {"shipments": 10, "tier": "regular"},
+        bulk.id: {"shipments": 50, "tier": "bulk"},
+    }
