diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/test_invoices.py b/tests/test_invoices.py
--- a/tests/test_invoices.py	2026-11-10 12:17:53
+++ b/tests/test_invoices.py	2026-11-12 02:03:54
@@ -1,9 +1,59 @@
-from parcelo import customers, invoices, shipments
+from datetime import datetime, timezone
 
+import pytest
 
+from parcelo import clock, customers, events, invoices, shipments
+from parcelo.errors import DomainError
+
+
+def _issued_invoice():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 2, "local")
+    return invoices.issue_invoice(s.id)
+
+
 def test_issue_and_pay():
     c = customers.add_customer("Acme")
     s = shipments.create_shipment(c.id, 2, "local")
     inv = invoices.issue_invoice(s.id)
     assert inv.amount == 7.0
     assert invoices.mark_paid(inv.id).status == "paid"
+
+
+def test_reopen_paid_invoice():
+    inv = _issued_invoice()
+    invoices.mark_paid(inv.id)
+    moment = datetime(2026, 11, 12, 9, 30, tzinfo=timezone.utc)
+    clock.set_fixed(moment)
+
+    reopened = invoices.reopen_invoice(inv.id)
+
+    assert reopened is inv
+    assert reopened.status == "open"
+    assert reopened.paid_at is None
+    assert reopened.reopened_at == moment
+    assert inv in invoices.open_invoices()
+    assert events.OUTBOX[-1]["name"] == "invoice.reopened"
+    assert events.OUTBOX[-1]["entity_id"] == inv.id
+
+
+def test_reopened_invoice_can_be_paid_again():
+    inv = _issued_invoice()
+    invoices.mark_paid(inv.id)
+    invoices.reopen_invoice(inv.id)
+    assert invoices.mark_paid(inv.id).status == "paid"
+
+
+def test_reopen_unknown_invoice_fails():
+    with pytest.raises(DomainError) as exc:
+        invoices.reopen_invoice("INV-missing")
+    assert exc.value.code == "E_NOT_FOUND"
+
+
+def test_reopen_unpaid_invoice_fails():
+    inv = _issued_invoice()
+    with pytest.raises(DomainError) as exc:
+        invoices.reopen_invoice(inv.id)
+    assert exc.value.code == "E_BAD_STATE"
+    assert inv.status == "open"
+    assert inv.reopened_at is None
