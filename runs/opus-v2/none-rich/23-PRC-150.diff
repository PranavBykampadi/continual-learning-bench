+def set_credit_limit(customer_id, amount):
+    customer = db.customers.get(customer_id)
+    if customer is None:
+        raise DomainError("E_UNKNOWN_CUSTOMER", customer_id)
+    if (
+        isinstance(amount, bool)
+        or not isinstance(amount, (int, float))
+        or not math.isfinite(amount)
+        or amount < 0
+    ):
+        raise DomainError("E_BAD_INPUT", f"invalid credit limit {amount!r}")
+    old_limit = customer.credit_limit
+    customer.credit_limit = float(amount)
+    audit.record(
+        "customer.credit_limit_set", customer_id, old=old_limit, new=customer.credit_limit
+    )
+    events.emit(
+        "customer.credit_limit_changed", customer_id, credit_limit=customer.credit_limit
+    )
+    return customer.credit_limit
 
 
