--- a/tests/unit/test_customers.py	1969-12-31 19:00:00
+++ b/tests/unit/test_customers.py	2026-11-12 02:09:22
@@ -0,0 +1,37 @@
+import pytest
+
+from parcelo import audit, customers, events
+from parcelo.errors import DomainError
+
+
+def test_set_credit_limit_updates_and_returns():
+    c = customers.add_customer("Acme")
+    assert customers.set_credit_limit(c.id, 1200) == 1200
+    assert customers.get_customer(c.id).credit_limit == 1200
+    assert audit.LOG[-1]["action"] == "customer.credit_limit_set"
+    assert audit.LOG[-1]["details"] == {"old": 500.0, "new": 1200.0}
+    assert events.OUTBOX[-1]["name"] == "customer.credit_limit_changed"
+
+
+def test_set_credit_limit_zero_allowed():
+    c = customers.add_customer("Acme")
+    assert customers.set_credit_limit(c.id, 0) == 0
+
+
+def test_set_credit_limit_unknown_customer():
+    with pytest.raises(DomainError) as err:
+        customers.set_credit_limit("nope", 100)
+    assert err.value.code == "E_UNKNOWN_CUSTOMER"
+
+
+@pytest.mark.parametrize(
+    "amount", [-1, -0.01, float("nan"), float("inf"), "100", None, True]
+)
+def test_set_credit_limit_rejects_bad_amount(amount):
+    c = customers.add_customer("Acme")
+    with pytest.raises(DomainError) as err:
+        customers.set_credit_limit(c.id, amount)
+    assert err.value.code == "E_BAD_INPUT"
+    assert customers.get_customer(c.id).credit_limit == 500.0
+    assert audit.LOG == []
+    assert events.OUTBOX == []
