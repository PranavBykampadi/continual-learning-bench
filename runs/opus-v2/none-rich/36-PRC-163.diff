diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_customers.py b/tests/unit/test_customers.py
--- a/tests/unit/test_customers.py	1969-12-31 19:00:00
+++ b/tests/unit/test_customers.py	2026-11-12 02:17:51
@@ -0,0 +1,22 @@
+import pytest
+
+from parcelo import customers, events
+from parcelo.errors import DomainError
+
+
+def test_new_customer_is_not_locked():
+    assert customers.add_customer("Acme").locked is False
+
+
+def test_lock_customer():
+    c = customers.add_customer("Acme")
+    locked = customers.lock_customer(c.id)
+    assert locked is c
+    assert customers.get_customer(c.id).locked is True
+    assert events.OUTBOX[-1]["name"] == "customer.locked"
+
+
+def test_lock_unknown_customer():
+    with pytest.raises(DomainError) as err:
+        customers.lock_customer("nope")
+    assert err.value.code == "E_UNKNOWN_CUSTOMER"
