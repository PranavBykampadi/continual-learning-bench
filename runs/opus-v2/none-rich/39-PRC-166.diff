@@ -32,3 +35,24 @@
 
 def open_invoices():
     return [i for i in db.invoices.values() if i.status == "open"]
+
+
+ESCALATION_THRESHOLD = Money.parse("500.00")
+
+
+def escalate_invoice(invoice_id):
+    """Hand a large open invoice over to the collections team."""
+    if invoice_id not in db.invoices:
+        raise DomainError("E_NOT_FOUND", invoice_id)
+    invoice = db.invoices[invoice_id]
+    if invoice.status != "open":
+        raise DomainError("E_BAD_STATE", f"{invoice_id} is {invoice.status}")
+    if Money.parse(invoice.amount) < ESCALATION_THRESHOLD:
+        raise DomainError(
+            "E_BAD_STATE",
+            f"{invoice_id} amount {invoice.amount:.2f} is below {ESCALATION_THRESHOLD}",
+        )
+    invoice.status = "escalated"
+    audit.record("invoice.escalated", invoice.id, amount=invoice.amount)
+    events.emit("invoice.escalated", invoice.id, amount=invoice.amount)
+    return invoice
