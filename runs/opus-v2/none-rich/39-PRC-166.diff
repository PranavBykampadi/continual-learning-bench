+
+
+import pytest
+
+from parcelo import audit, events
+from parcelo.errors import DomainError
+from parcelo.models import Invoice
+from parcelo.store import db
+
+
+def _invoice(amount, status="open"):
+    inv = Invoice(id="INV-test", shipment_id="shp-x", amount=amount, status=status)
+    db.invoices[inv.id] = inv
+    return inv
+
+
+def test_escalate_large_open_invoice():
+    inv = _invoice(750.0)
+    result = invoices.escalate_invoice(inv.id)
+    assert result is inv
+    assert inv.status == "escalated"
+    assert events.OUTBOX[-1]["name"] == "invoice.escalated"
+    assert audit.LOG[-1]["action"] == "invoice.escalated"
+
+
+def test_escalate_exactly_threshold():
+    inv = _invoice(500.0)
+    assert invoices.escalate_invoice(inv.id).status == "escalated"
+
+
+def test_escalate_threshold_with_float_noise():
+    inv = _invoice(0.1 * 5000)  # float arithmetic result near 500.00
+    assert invoices.escalate_invoice(inv.id).status == "escalated"
+
+
+def test_escalate_below_threshold_fails():
+    inv = _invoice(499.99)
+    with pytest.raises(DomainError) as err:
+        invoices.escalate_invoice(inv.id)
+    assert err.value.code == "E_BAD_STATE"
+    assert inv.status == "open"
+    assert events.OUTBOX == []
+
+
+@pytest.mark.parametrize("status", ["paid", "escalated"])
+def test_escalate_non_open_fails(status):
+    inv = _invoice(900.0, status=status)
+    with pytest.raises(DomainError) as err:
+        invoices.escalate_invoice(inv.id)
+    assert err.value.code == "E_BAD_STATE"
+    assert inv.status == status
+
+
+def test_escalate_missing_invoice_fails():
+    with pytest.raises(DomainError) as err:
+        invoices.escalate_invoice("INV-nope")
+    assert err.value.code == "E_NOT_FOUND"
