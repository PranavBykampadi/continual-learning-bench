@@ -1,6 +1,6 @@
 import pytest
 
-from parcelo import customers, events, shipments
+from parcelo import audit, customers, events, shipments
 from parcelo.errors import DomainError
 
 
@@ -15,3 +15,42 @@
     with pytest.raises(DomainError) as err:
         shipments.create_shipment("nope", 1, "local")
     assert err.value.code == "E_UNKNOWN_CUSTOMER"
+
+
+def test_reassign_shipment():
+    a = customers.add_customer("Acme")
+    b = customers.add_customer("Globex")
+    s = shipments.create_shipment(a.id, 2, "local")
+    result = shipments.reassign_shipment(s.id, b.id)
+    assert result is s
+    assert shipments.get_shipment(s.id).customer_id == b.id
+    assert events.OUTBOX[-1]["name"] == "shipment.reassigned"
+    assert events.OUTBOX[-1]["payload"] == {"from_customer": a.id, "to_customer": b.id}
+    assert audit.LOG[-1]["action"] == "shipment.reassigned"
+
+
+def test_reassign_unknown_shipment():
+    c = customers.add_customer("Acme")
+    with pytest.raises(DomainError) as err:
+        shipments.reassign_shipment("shp_missing", c.id)
+    assert err.value.code == "E_NOT_FOUND"
+
+
+def test_reassign_unknown_customer():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 2, "local")
+    with pytest.raises(DomainError) as err:
+        shipments.reassign_shipment(s.id, "nope")
+    assert err.value.code == "E_UNKNOWN_CUSTOMER"
+    assert s.customer_id == c.id
+
+
+def test_reassign_delivered_shipment():
+    a = customers.add_customer("Acme")
+    b = customers.add_customer("Globex")
+    s = shipments.create_shipment(a.id, 2, "local")
+    s.status = "delivered"
+    with pytest.raises(DomainError) as err:
+        shipments.reassign_shipment(s.id, b.id)
+    assert err.value.code == "E_BAD_STATE"
+    assert s.customer_id == a.id
