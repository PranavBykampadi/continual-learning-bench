+def write_off(invoice_id):
+    """Write off an open invoice we will never collect.
+
+    Sets status to "written_off", records ``written_off_at`` (tz-aware) and
+    returns the written-off amount as ``Money``.
+
+    Raises DomainError:
+      E_NOT_FOUND: invoice_id is not a str or no such invoice exists.
+      E_BAD_STATE: the invoice is not open (e.g. paid or already written off).
+    """
+    if not isinstance(invoice_id, str) or invoice_id not in db.invoices:
+        raise DomainError("E_NOT_FOUND", str(invoice_id))
+    invoice = db.invoices[invoice_id]
+    if invoice.status != "open":
+        raise DomainError("E_BAD_STATE", f"invoice is {invoice.status}, not open")
+    amount = Money.parse(invoice.amount)
+    previous_status = invoice.status
+    invoice.status = "written_off"
+    invoice.written_off_at = clock.now()
+    events.emit(
+        "invoice.written_off",
+        invoice.id,
+        from_status=previous_status,
+        to_status="written_off",
+        amount_cents=amount.cents,
+    )
+    return amount
