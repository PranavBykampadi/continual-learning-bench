diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_invoices_write_off.py b/tests/unit/test_invoices_write_off.py
--- a/tests/unit/test_invoices_write_off.py	1969-12-31 19:00:00
+++ b/tests/unit/test_invoices_write_off.py	2026-11-12 02:16:02
@@ -0,0 +1,63 @@
+from datetime import datetime, timezone
+
+import pytest
+
+from parcelo import clock, events, invoices
+from parcelo.errors import DomainError
+from parcelo.models import Invoice
+from parcelo.money import Money
+from parcelo.store import db
+
+NOW = datetime(2026, 11, 12, 9, 30, tzinfo=timezone.utc)
+
+
+def _invoice(status="open", amount=12.34):
+    inv = Invoice(id="inv_000001", shipment_id="shp_000001", amount=amount, status=status)
+    db.invoices[inv.id] = inv
+    return inv
+
+
+def test_written_off_at_defaults_to_none():
+    assert Invoice(id="x", shipment_id="y", amount=1.0).written_off_at is None
+
+
+def test_write_off_open_invoice():
+    clock.set_fixed(NOW)
+    inv = _invoice(amount=12.34)
+    amount = invoices.write_off(inv.id)
+    assert amount == Money(1234)
+    assert inv.status == "written_off"
+    assert inv.written_off_at == NOW
+    assert events.OUTBOX == [
+        {
+            "name": "invoice.written_off",
+            "entity_id": inv.id,
+            "at": NOW,
+            "payload": {"from_status": "open", "to_status": "written_off", "amount_cents": 1234},
+        }
+    ]
+
+
+def test_written_off_invoice_no_longer_open():
+    inv = _invoice()
+    invoices.write_off(inv.id)
+    assert invoices.open_invoices() == []
+
+
+@pytest.mark.parametrize("bad_id", ["missing", None, 42])
+def test_not_found(bad_id):
+    with pytest.raises(DomainError) as err:
+        invoices.write_off(bad_id)
+    assert err.value.code == "E_NOT_FOUND"
+    assert events.OUTBOX == []
+
+
+@pytest.mark.parametrize("status", ["paid", "written_off"])
+def test_only_open_invoices(status):
+    inv = _invoice(status=status)
+    with pytest.raises(DomainError) as err:
+        invoices.write_off(inv.id)
+    assert err.value.code == "E_BAD_STATE"
+    assert inv.status == status
+    assert inv.written_off_at is None
+    assert events.OUTBOX == []
