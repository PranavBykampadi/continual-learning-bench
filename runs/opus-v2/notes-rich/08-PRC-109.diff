+def _non_blank(value):
+    return isinstance(value, str) and value.strip() != ""
+
+
+def add_address(customer_id, line, city):
+    if not isinstance(customer_id, str) or customer_id not in db.customers:
+        raise DomainError("E_UNKNOWN_CUSTOMER", str(customer_id))
+    if not _non_blank(line):
+        raise DomainError("E_BAD_INPUT", "address line required")
+    if not _non_blank(city):
+        raise DomainError("E_BAD_INPUT", "city required")
+    address = Address(
+        id=ids.new_id("adr"), customer_id=customer_id, line=line, city=city
+    )
+    db.addresses[address.id] = address
+    audit.record("address.added", address.id, customer_id=customer_id)
+    return address
