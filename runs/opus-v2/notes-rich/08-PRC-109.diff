+++ b/tests/unit/test_customers_addresses.py	2026-11-12 02:01:20
@@ -0,0 +1,85 @@
+import pytest
+
+from parcelo import audit, customers, store
+from parcelo.errors import DomainError
+from parcelo.models import Address
+from parcelo.store import db
+
+
+def _customer():
+    return customers.add_customer("Acme")
+
+
+def test_add_address_stores_and_returns_address():
+    c = _customer()
+    addr = customers.add_address(c.id, "1 Main St", "Springfield")
+    assert isinstance(addr, Address)
+    assert addr.id == "adr_000001"
+    assert addr.customer_id == c.id
+    assert addr.line == "1 Main St"
+    assert addr.city == "Springfield"
+    assert db.addresses == {addr.id: addr}
+
+
+def test_add_address_records_audit():
+    c = _customer()
+    addr = customers.add_address(c.id, "1 Main St", "Springfield")
+    entry = audit.LOG[-1]
+    assert entry["action"] == "address.added"
+    assert entry["entity_id"] == addr.id
+    assert entry["details"] == {"customer_id": c.id}
+
+
+def test_multiple_addresses_per_customer_get_distinct_ids():
+    c = _customer()
+    a1 = customers.add_address(c.id, "1 Main St", "Springfield")
+    a2 = customers.add_address(c.id, "2 Elm St", "Shelbyville")
+    assert a1.id != a2.id
+    assert set(db.addresses) == {a1.id, a2.id}
+
+
+def test_empty_store_has_no_addresses():
+    assert db.addresses == {}
+
+
+def test_reset_clears_addresses():
+    c = _customer()
+    customers.add_address(c.id, "1 Main St", "Springfield")
+    store.reset()
+    assert db.addresses == {}
+
+
+@pytest.mark.parametrize("cid", ["nope", "", None, 123, []])
+def test_unknown_customer_rejected(cid):
+    _customer()
+    with pytest.raises(DomainError) as err:
+        customers.add_address(cid, "1 Main St", "Springfield")
+    assert err.value.code == "E_UNKNOWN_CUSTOMER"
+    assert db.addresses == {}
+    assert len(audit.LOG) == 0
+
+
+@pytest.mark.parametrize("line", ["", "   ", None, 123, []])
+def test_bad_line_rejected(line):
+    c = _customer()
+    with pytest.raises(DomainError) as err:
+        customers.add_address(c.id, line, "Springfield")
+    assert err.value.code == "E_BAD_INPUT"
+    assert db.addresses == {}
+    assert len(audit.LOG) == 0
+
+
+@pytest.mark.parametrize("city", ["", "   ", None, 123, []])
+def test_bad_city_rejected(city):
+    c = _customer()
+    with pytest.raises(DomainError) as err:
+        customers.add_address(c.id, "1 Main St", city)
+    assert err.value.code == "E_BAD_INPUT"
+    assert db.addresses == {}
+    assert len(audit.LOG) == 0
+
+
+def test_unknown_customer_checked_before_input():
+    with pytest.raises(DomainError) as err:
+        customers.add_address("nope", "", "")
+    assert err.value.code == "E_UNKNOWN_CUSTOMER"
