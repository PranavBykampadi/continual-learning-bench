diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_disputes_open.py b/tests/unit/test_disputes_open.py
--- a/tests/unit/test_disputes_open.py	1969-12-31 19:00:00
+++ b/tests/unit/test_disputes_open.py	2026-11-12 02:18:07
@@ -0,0 +1,79 @@
+import re
+from datetime import datetime, timezone
+
+import pytest
+
+from parcelo import clock, disputes, events, store
+from parcelo.errors import DomainError
+from parcelo.models import Dispute, Invoice
+from parcelo.store import db
+
+T0 = datetime(2026, 11, 12, 9, 0, tzinfo=timezone.utc)
+
+
+def _invoice(invoice_id="INV-1"):
+    inv = Invoice(id=invoice_id, shipment_id="shp_000001", amount=10.0)
+    db.invoices[inv.id] = inv
+    return inv
+
+
+def test_open_dispute_creates_and_stores():
+    clock.set_fixed(T0)
+    inv = _invoice()
+    d = disputes.open_dispute(inv.id, "double charged")
+    assert isinstance(d, Dispute)
+    assert re.fullmatch(r"dsp_\d{6}", d.id)
+    assert d.invoice_id == inv.id
+    assert d.reason == "double charged"
+    assert d.opened_at == T0
+    assert db.disputes[d.id] is d
+
+
+def test_open_dispute_emits_event():
+    clock.set_fixed(T0)
+    inv = _invoice()
+    d = disputes.open_dispute(inv.id, "wrong amount")
+    assert events.OUTBOX == [
+        {
+            "name": "dispute.opened",
+            "entity_id": d.id,
+            "at": T0,
+            "payload": {"invoice_id": inv.id, "reason": "wrong amount"},
+        }
+    ]
+
+
+@pytest.mark.parametrize("invoice_id", ["missing", None, 123])
+def test_unknown_invoice_is_not_found(invoice_id):
+    with pytest.raises(DomainError) as err:
+        disputes.open_dispute(invoice_id, "reason")
+    assert err.value.code == "E_NOT_FOUND"
+    assert db.disputes == {}
+    assert events.OUTBOX == []
+
+
+@pytest.mark.parametrize("reason", ["", "   ", None, 5])
+def test_bad_reason_is_bad_input(reason):
+    inv = _invoice()
+    with pytest.raises(DomainError) as err:
+        disputes.open_dispute(inv.id, reason)
+    assert err.value.code == "E_BAD_INPUT"
+    assert db.disputes == {}
+    assert events.OUTBOX == []
+
+
+def test_missing_invoice_checked_before_reason():
+    with pytest.raises(DomainError) as err:
+        disputes.open_dispute("missing", "")
+    assert err.value.code == "E_NOT_FOUND"
+
+
+def test_dispute_opened_at_defaults_to_none():
+    assert Dispute(id="dsp_000001", invoice_id="INV-1", reason="x").opened_at is None
+
+
+def test_reset_clears_disputes():
+    inv = _invoice()
+    disputes.open_dispute(inv.id, "reason")
+    store.reset()
+    assert db.disputes == {}
