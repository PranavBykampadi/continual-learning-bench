diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/parcelo/disputes.py b/parcelo/disputes.py
--- a/parcelo/disputes.py	1969-12-31 19:00:00
+++ b/parcelo/disputes.py	2026-11-12 02:17:57
@@ -0,0 +1,26 @@
+from parcelo import clock, events, ids
+from parcelo.errors import DomainError
+from parcelo.models import Dispute
+from parcelo.store import db
+
+
+def open_dispute(invoice_id, reason):
+    """Open a dispute against an existing invoice and return it.
+
+    Raises:
+        DomainError E_NOT_FOUND: invoice_id is not a str or no such invoice exists.
+        DomainError E_BAD_INPUT: reason is not a str or is empty/whitespace-only.
+    """
+    if not isinstance(invoice_id, str) or invoice_id not in db.invoices:
+        raise DomainError("E_NOT_FOUND", repr(invoice_id))
+    if not isinstance(reason, str) or not reason.strip():
+        raise DomainError("E_BAD_INPUT", "reason must be a non-empty string")
+    dispute = Dispute(
+        id=ids.new_id("dsp"),
+        invoice_id=invoice_id,
+        reason=reason,
+        opened_at=clock.now(),
+    )
+    db.disputes[dispute.id] = dispute
+    events.emit("dispute.opened", dispute.id, invoice_id=invoice_id, reason=reason)
+    return dispute
