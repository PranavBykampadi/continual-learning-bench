diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/parcelo/shipments.py b/parcelo/shipments.py
--- a/parcelo/shipments.py	2026-11-10 12:17:53
+++ b/parcelo/shipments.py	2026-11-12 01:58:57
@@ -25,6 +25,20 @@
 
 
 def get_shipment(shipment_id):
-    if shipment_id not in db.shipments:
+    if not isinstance(shipment_id, str) or shipment_id not in db.shipments:
         raise DomainError("E_NOT_FOUND", shipment_id)
     return db.shipments[shipment_id]
+
+
+_UNDELIVERABLE_STATUSES = ("cancelled", "delivered")
+
+
+def mark_delivered(shipment_id):
+    shipment = get_shipment(shipment_id)
+    if shipment.status in _UNDELIVERABLE_STATUSES:
+        raise DomainError("E_BAD_STATE", shipment.status)
+    delivered_at = clock.now()
+    shipment.status = "delivered"
+    shipment.delivered_at = delivered_at
+    audit.record("shipment.delivered", shipment.id, delivered_at=delivered_at)
+    return shipment
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_shipments_mark_delivered.py b/tests/unit/test_shipments_mark_delivered.py
--- a/tests/unit/test_shipments_mark_delivered.py	1969-12-31 19:00:00
+++ b/tests/unit/test_shipments_mark_delivered.py	2026-11-12 01:59:06
@@ -0,0 +1,88 @@
+from datetime import datetime, timezone
+
+import pytest
+
+from parcelo import audit, clock, customers, shipments
+from parcelo.errors import DomainError
+from parcelo.store import db
+
+NOW = datetime(2026, 11, 12, 15, 30, tzinfo=timezone.utc)
+EARLIER = datetime(2026, 1, 1, tzinfo=timezone.utc)
+
+
+def _create():
+    c = customers.add_customer("Acme")
+    return shipments.create_shipment(c.id, 2, "national")
+
+
+def test_new_shipment_has_no_delivered_at():
+    s = _create()
+    assert s.status == "created"
+    assert s.delivered_at is None
+
+
+def test_mark_delivered_sets_status_and_time():
+    s = _create()
+    clock.set_fixed(NOW)
+    result = shipments.mark_delivered(s.id)
+    assert result is s
+    assert db.shipments[s.id].status == "delivered"
+    assert db.shipments[s.id].delivered_at == NOW
+
+
+def test_mark_delivered_records_audit():
+    s = _create()
+    clock.set_fixed(NOW)
+    before = len(audit.LOG)
+    shipments.mark_delivered(s.id)
+    assert len(audit.LOG) == before + 1
+    entry = audit.LOG[-1]
+    assert entry["action"] == "shipment.delivered"
+    assert entry["entity_id"] == s.id
+    assert entry["details"] == {"delivered_at": NOW}
+
+
+@pytest.mark.parametrize("bad_id", ["nope", "", None, 123, []])
+def test_mark_delivered_unknown_shipment(bad_id):
+    _create()
+    before = len(audit.LOG)
+    with pytest.raises(DomainError) as err:
+        shipments.mark_delivered(bad_id)
+    assert err.value.code == "E_NOT_FOUND"
+    assert len(audit.LOG) == before
+
+
+@pytest.mark.parametrize(
+    "status, delivered_at",
+    [("cancelled", None), ("delivered", EARLIER)],
+)
+def test_mark_delivered_bad_state(status, delivered_at):
+    s = _create()
+    s.status = status
+    s.delivered_at = delivered_at
+    clock.set_fixed(NOW)
+    before = len(audit.LOG)
+    with pytest.raises(DomainError) as err:
+        shipments.mark_delivered(s.id)
+    assert err.value.code == "E_BAD_STATE"
+    assert s.status == status
+    assert s.delivered_at == delivered_at
+    assert len(audit.LOG) == before
+
+
+def test_mark_delivered_twice_fails():
+    s = _create()
+    clock.set_fixed(NOW)
+    shipments.mark_delivered(s.id)
+    clock.set_fixed(datetime(2026, 11, 13, tzinfo=timezone.utc))
+    with pytest.raises(DomainError) as err:
+        shipments.mark_delivered(s.id)
+    assert err.value.code == "E_BAD_STATE"
+    assert s.delivered_at == NOW
+
+
+@pytest.mark.parametrize("bad_id", [None, 123, [], ""])
+def test_get_shipment_non_string_id_not_found(bad_id):
+    with pytest.raises(DomainError) as err:
+        shipments.get_shipment(bad_id)
+    assert err.value.code == "E_NOT_FOUND"
