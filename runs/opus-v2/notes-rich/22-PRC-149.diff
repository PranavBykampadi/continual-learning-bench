+def _grams(weight_kg):
+    # Compare weights in whole grams so float sums like 0.1 + 0.2 match 0.3.
+    return round(weight_kg * 1000)
+
+
+def split_shipment(shipment_id, weights):
+    if shipment_id not in db.shipments:
+        raise DomainError("E_NOT_FOUND", shipment_id)
+    original = db.shipments[shipment_id]
+
+    if not isinstance(weights, (list, tuple)) or len(weights) < 2:
+        raise DomainError("E_BAD_INPUT", "weights must be a list of at least two weights")
+    for weight in weights:
+        if isinstance(weight, bool) or not isinstance(weight, (int, float)) or weight <= 0:
+            raise DomainError("E_BAD_WEIGHT", str(weight))
+    total_grams = sum(_grams(w) for w in weights)
+    if total_grams != _grams(original.weight_kg):
+        raise DomainError(
+            "E_BAD_WEIGHT",
+            f"weights sum to {total_grams / 1000} kg, shipment weighs {original.weight_kg} kg",
+        )
+
+    if original.status != "created":
+        raise DomainError("E_BAD_STATE", original.status)
+
+    now = clock.now()
+    parts = []
+    for weight in weights:
+        part = Shipment(
+            id=ids.new_id("shp"),
+            customer_id=original.customer_id,
+            weight_kg=weight,
+            zone=original.zone,
+            created_at=now,
+        )
+        db.shipments[part.id] = part
+        events.emit("shipment.created", part.id, zone=part.zone)
+        parts.append(part)
+
+    original.status = "split"
+    events.emit(
+        "shipment.split",
+        original.id,
+        from_status="created",
+        to_status="split",
+        shipment_ids=[p.id for p in parts],
+        weights_kg=list(weights),
+    )
+    return parts
+
+
