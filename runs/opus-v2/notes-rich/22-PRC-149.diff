+import re
+from datetime import datetime, timezone
+
+import pytest
+
+from parcelo import clock, events, shipments
+from parcelo.errors import DomainError
+from parcelo.models import Shipment
+from parcelo.store import db
+
+T0 = datetime(2026, 11, 12, 9, 30, tzinfo=timezone.utc)
+
+
+def _put(weight_kg=10.0, status="created", zone="national"):
+    s = Shipment(id="shp_000100", customer_id="cus_000001", weight_kg=weight_kg, zone=zone, status=status)
+    db.shipments[s.id] = s
+    return s
+
+
+def _snapshot():
+    return {k: (v.status, v.weight_kg) for k, v in db.shipments.items()}
+
+
+def test_split_creates_parts_in_order_and_marks_original():
+    clock.set_fixed(T0)
+    original = _put(10.0)
+    parts = shipments.split_shipment(original.id, [6.0, 3.0, 1.0])
+
+    assert [p.weight_kg for p in parts] == [6.0, 3.0, 1.0]
+    for p in parts:
+        assert re.fullmatch(r"shp_\d{6}", p.id)
+        assert p.customer_id == "cus_000001"
+        assert p.zone == "national"
+        assert p.status == "created"
+        assert p.created_at == T0
+        assert db.shipments[p.id] is p
+    assert len({p.id for p in parts}) == 3
+    assert original.status == "split"
+    assert db.shipments[original.id] is original
+
+    ids_ = [p.id for p in parts]
+    assert events.OUTBOX == [
+        {"name": "shipment.created", "entity_id": ids_[0], "at": T0, "payload": {"zone": "national"}},
+        {"name": "shipment.created", "entity_id": ids_[1], "at": T0, "payload": {"zone": "national"}},
+        {"name": "shipment.created", "entity_id": ids_[2], "at": T0, "payload": {"zone": "national"}},
+        {
+            "name": "shipment.split",
+            "entity_id": original.id,
+            "at": T0,
+            "payload": {
+                "from_status": "created",
+                "to_status": "split",
+                "shipment_ids": ids_,
+                "weights_kg": [6.0, 3.0, 1.0],
+            },
+        },
+    ]
+
+
+def test_split_tolerates_float_sum_rounding():
+    original = _put(0.3)
+    parts = shipments.split_shipment(original.id, [0.1, 0.2])
+    assert [p.weight_kg for p in parts] == [0.1, 0.2]
+    assert original.status == "split"
+
+
