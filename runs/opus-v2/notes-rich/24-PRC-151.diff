diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_shipments_list.py b/tests/unit/test_shipments_list.py
--- a/tests/unit/test_shipments_list.py	1969-12-31 19:00:00
+++ b/tests/unit/test_shipments_list.py	2026-11-12 02:21:25
@@ -0,0 +1,42 @@
+import pytest
+
+from parcelo import events, shipments
+from parcelo.errors import DomainError
+from parcelo.models import Customer, Shipment
+from parcelo.store import db
+
+
+def _customer(cid):
+    db.customers[cid] = Customer(id=cid, name=cid)
+
+
+def _shipment(sid, cid):
+    db.shipments[sid] = Shipment(id=sid, customer_id=cid, weight_kg=1.0, zone="local")
+    return db.shipments[sid]
+
+
+def test_returns_only_customers_shipments_in_order():
+    _customer("cus_1")
+    _customer("cus_2")
+    a = _shipment("shp_1", "cus_1")
+    _shipment("shp_2", "cus_2")
+    b = _shipment("shp_3", "cus_1")
+
+    assert shipments.list_shipments("cus_1") == [a, b]
+    assert events.OUTBOX == []
+
+
+def test_customer_without_shipments_returns_empty_list():
+    _customer("cus_1")
+    _shipment("shp_1", "cus_other")
+
+    assert shipments.list_shipments("cus_1") == []
+
+
+def test_unknown_customer_raises_not_found():
+    _shipment("shp_1", "ghost")
+
+    with pytest.raises(DomainError) as err:
+        shipments.list_shipments("ghost")
+    assert err.value.code == "E_NOT_FOUND"
+    assert events.OUTBOX == []
