@@ -0,0 +1,31 @@
+from decimal import InvalidOperation
+
+from parcelo import clock, events, ids, settings
+from parcelo.errors import DomainError
+from parcelo.models import Voucher
+from parcelo.money import Money
+from parcelo.store import db
+
+
+def issue_voucher(customer_id, amount):
+    if customer_id not in db.customers:
+        raise DomainError("E_UNKNOWN_CUSTOMER", customer_id)
+    if isinstance(amount, bool):
+        raise DomainError("E_BAD_INPUT", str(amount))
+    try:
+        money = Money.parse(amount)
+    except (InvalidOperation, ValueError, TypeError):
+        raise DomainError("E_BAD_INPUT", str(amount))
+    if money.cents <= 0:
+        raise DomainError("E_BAD_INPUT", str(money))
+    if settings.VOUCHER_MAX_AMOUNT < money:
+        raise DomainError("E_LIMIT", str(money))
+    voucher = Voucher(
+        id=ids.new_id("vch"),
+        customer_id=customer_id,
+        amount=money,
+        issued_at=clock.now(),
+    )
+    db.vouchers[voucher.id] = voucher
+    events.emit("voucher.issued", voucher.id, customer_id=customer_id)
+    return voucher
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_vouchers.py b/tests/unit/test_vouchers.py
--- a/tests/unit/test_vouchers.py	1969-12-31 19:00:00
+++ b/tests/unit/test_vouchers.py	2026-11-12 02:33:49
@@ -0,0 +1,83 @@
+from datetime import datetime, timezone
+
+import pytest
+
+from parcelo import clock, customers, events, vouchers
+from parcelo.errors import DomainError
+from parcelo.money import Money
+from parcelo.store import db, reset
+
+NOW = datetime(2026, 11, 12, 9, 0, tzinfo=timezone.utc)
+
+
+def _customer():
+    return customers.add_customer("Acme")
+
+
+def test_issue_voucher_success():
+    clock.set_fixed(NOW)
+    c = _customer()
+    v = vouchers.issue_voucher(c.id, "25.50")
+    assert v.id.startswith("vch_")
+    assert v.customer_id == c.id
+    assert v.amount == Money.parse("25.50")
+    assert v.issued_at == NOW
+    assert db.vouchers[v.id] is v
+    assert events.OUTBOX[-1]["name"] == "voucher.issued"
+    assert events.OUTBOX[-1]["entity_id"] == v.id
+
+
+def test_not_idempotent_each_call_creates_voucher():
+    c = _customer()
+    a = vouchers.issue_voucher(c.id, 10)
+    b = vouchers.issue_voucher(c.id, 10)
+    assert a.id != b.id
+    assert len(db.vouchers) == 2
+    assert [e["name"] for e in events.OUTBOX].count("voucher.issued") == 2
+
+
+def test_max_amount_allowed():
+    c = _customer()
+    v = vouchers.issue_voucher(c.id, Money.parse("150.00"))
+    assert v.amount == Money.parse("150.00")
+
+
+@pytest.mark.parametrize("amount", ["150.01", 151, "1000"])
+def test_over_limit(amount):
+    c = _customer()
+    with pytest.raises(DomainError) as err:
+        vouchers.issue_voucher(c.id, amount)
+    assert err.value.code == "E_LIMIT"
+    assert db.vouchers == {}
+    assert not any(e["name"] == "voucher.issued" for e in events.OUTBOX)
+
+
+@pytest.mark.parametrize("amount", [0, "0.00", -5, "-0.01", "abc", None, True])
+def test_bad_amount(amount):
+    c = _customer()
+    with pytest.raises(DomainError) as err:
+        vouchers.issue_voucher(c.id, amount)
+    assert err.value.code == "E_BAD_INPUT"
+    assert db.vouchers == {}
+    assert not any(e["name"] == "voucher.issued" for e in events.OUTBOX)
+
+
+def test_unknown_customer