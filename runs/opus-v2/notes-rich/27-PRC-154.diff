+def reactivate_customer(customer_id):
+    if customer_id not in db.customers:
+        raise DomainError("E_NOT_FOUND", customer_id)
+    customer = db.customers[customer_id]
+    if customer.active:
+        return customer
+    customer.active = True
+    events.emit("customer.reactivated", customer.id)
+    return customer
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_customers_reactivate.py b/tests/unit/test_customers_reactivate.py
--- a/tests/unit/test_customers_reactivate.py	1969-12-31 19:00:00
+++ b/tests/unit/test_customers_reactivate.py	2026-11-12 02:24:18
@@ -0,0 +1,31 @@
+import pytest
+
+from parcelo import customers, events
+from parcelo.errors import DomainError
+from parcelo.store import db
+
+
+def test_reactivate_sets_active_and_emits_once():
+    c = customers.add_customer("Acme")
+    c.active = False
+    events.OUTBOX.clear()
+    result = customers.reactivate_customer(c.id)
+    assert result is c
+    assert db.customers[c.id].active is True
+    again = customers.reactivate_customer(c.id)
+    assert again is c and again.active is True
+    assert [e["name"] for e in events.OUTBOX] == ["customer.reactivated"]
+    assert events.OUTBOX[0]["entity_id"] == c.id
+
+
+def test_reactivate_already_active_emits_nothing():
+    c = customers.add_customer("Acme")
+    events.OUTBOX.clear()
+    assert customers.reactivate_customer(c.id) is c
+    assert events.OUTBOX == []
+
+
+def test_reactivate_unknown_customer():
+    with pytest.raises(DomainError) as err:
+        customers.reactivate_customer("nope")
+    assert err.value.code == "E_NOT_FOUND"
