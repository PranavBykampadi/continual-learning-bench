 def open_invoices():
     return [i for i in db.invoices.values() if i.status == "open"]
+
+
+CREDITABLE_STATUS = "open"
+
+
+def apply_credit(invoice_id, amount):
+    """Reduce an open invoice's amount by a credit; return the remaining Money.
+
+    The invoice's ``amount`` stays a float in dollars so the existing reports
+    and ``customers.outstanding_balance`` keep working unchanged.
+
+    Raises DomainError:
+      - E_NOT_FOUND: invoice_id is not a known invoice.
+      - E_BAD_INPUT: amount is not a positive money value (None, bool,
+        unparseable, or zero/negative after rounding to cents).
+      - E_BAD_STATE: the invoice is not open.
+      - E_LIMIT: the credit is larger than the invoice's current amount.
+    """
+    if not isinstance(invoice_id, str) or invoice_id not in db.invoices:
+        raise DomainError("E_NOT_FOUND", f"invoice {invoice_id!r} not found")
+    invoice = db.invoices[invoice_id]
+
+    if amount is None or isinstance(amount, bool):
+        raise DomainError("E_BAD_INPUT", "credit amount required")
+    try:
+        credit = Money.parse(amount)
+    except (InvalidOperation, ValueError, ArithmeticError, TypeError):
+        raise DomainError("E_BAD_INPUT", f"bad credit amount {amount!r}")
+    if credit.cents <= 0:
+        raise DomainError("E_BAD_INPUT", "credit must be positive")
+
+    if invoice.status != CREDITABLE_STATUS:
+        raise DomainError("E_BAD_STATE", f"invoice is {invoice.status}")
+
+    current = Money.parse(invoice.amount)
+    if current < credit:
+        raise DomainError("E_LIMIT", "credit exceeds invoice amount")
+
+    remaining = current - credit
+    invoice.amount = remaining.cents / 100
+    audit.record(
+        "invoice.credited",
+        invoice.id,
+        credit_cents=credit.cents,
+        remaining_cents=remaining.cents,
+    )
+    return remaining
