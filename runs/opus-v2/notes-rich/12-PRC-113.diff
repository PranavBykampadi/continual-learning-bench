@@ -0,0 +1,122 @@
+from datetime import datetime, timedelta, timezone
+
+import pytest
+
+from parcelo import audit, clock, customers, invoices, reports, shipments
+from parcelo.errors import DomainError
+from parcelo.money import Money
+
+NOW = datetime(2026, 11, 12, 9, 0, tzinfo=timezone.utc)
+
+
+def _issue(weight=2, zone="local", name="Acme"):
+    c = customers.add_customer(name)
+    s = shipments.create_shipment(c.id, weight, zone)
+    return c, invoices.issue_invoice(s.id)
+
+
+def test_reduces_amount_and_returns_remaining():
+    _, inv = _issue()  # 4.50 + 2 * 1.25 = 7.00
+    remaining = invoices.apply_credit(inv.id, "2.50")
+    assert isinstance(remaining, Money)
+    assert remaining == Money(450)  # 700 - 250
+    assert inv.amount == 4.5
+    assert isinstance(inv.amount, float)
+    assert inv.status == "open"
+
+
+def test_repeated_credits_accumulate():
+    _, inv = _issue()  # 7.00
+    assert invoices.apply_credit(inv.id, 1) == Money(600)  # 700 - 100
+    assert invoices.apply_credit(inv.id, 2.25) == Money(375)  # 600 - 225
+
+
+def test_full_credit_leaves_zero():
+    _, inv = _issue()
+    assert invoices.apply_credit(inv.id, "7.00") == Money.zero()
+    assert inv.amount == 0.0
+
+
+def test_half_up_rounding():
+    _, inv = _issue()  # 7.00
+    assert invoices.apply_credit(inv.id, "1.005") == Money(599)  # credit rounds to 101
+
+
+def test_audit_record():
+    clock.set_fixed(NOW)
+    _, inv = _issue()
+    clock.set_fixed(NOW + timedelta(hours=1))
+    invoices.apply_credit(inv.id, "2.50")
+    entry = audit.LOG[-1]
+    assert entry["action"] == "invoice.credited"
+    assert entry["entity_id"] == inv.id
+    assert entry["at"] == NOW + timedelta(hours=1)
+    assert entry["details"] == {"credit_cents": 250, "remaining_cents": 450}
+
+
+def test_balance_and_reports_reflect_credit():
+    c, inv = _issue()  # 7.00
+    invoices.apply_credit(inv.id, "2.50")
+    assert customers.outstanding_balance(c.id) == 4.5
+    invoices.mark_paid(inv.id)
+    assert reports.revenue_total() == 4.5
+
+
+def test_no_leakage_between_invoices():
+    _, a = _issue(name="A")
+    _, b = _issue(name="B")
+    invoices.apply_credit(a.id, 1)
+    assert b.amount == 7.0
+
+
+@pytest.mark.parametrize("bad_id", ["nope", "", None, 123, []])
+def test_unknown_invoice(bad_id):
+    _issue()
+    before = len(audit.LOG)
+    with pytest.raises(DomainError) as err:
+        invoices.apply_credit(bad_id, 1)
+    assert err.value.code == "E_NOT_FOUND"
+    assert len(audit.LOG) == before
+
+
+@pytest.mark.parametrize(
+    "bad", [0, -1, "-0.50", "0.004", None, "abc", True, False, [], ""]
+)
+def test_bad_amount(bad):
+    _, inv = _issue()
+    before = len(audit.LOG)
+    with pytest.raises(DomainError) as err:
+        invoices.apply_credit(inv.id, bad)
+    assert err.value.code == "E_BAD_INPUT"
+    assert inv.amount == 7.0
+    assert len(audit.LOG) == before
+
+
