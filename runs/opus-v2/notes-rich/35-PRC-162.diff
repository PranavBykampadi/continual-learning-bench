+++ b/tests/test_invoices_by_status.py	2026-11-12 02:32:05
@@ -0,0 +1,42 @@
+import pytest
+
+from parcelo import customers, events, invoices, shipments
+from parcelo.errors import DomainError
+
+
+def _issue(n=1):
+    c = customers.add_customer("Acme")
+    out = []
+    for _ in range(n):
+        s = shipments.create_shipment(c.id, 2, "local")
+        out.append(invoices.issue_invoice(s.id))
+    return out
+
+
+def test_open_and_paid_filtered_in_issue_order():
+    a, b, c = _issue(3)
+    b.status = "paid"
+    assert invoices.invoices_by_status("open") == [a, c]
+    assert invoices.invoices_by_status("paid") == [b]
+
+
+def test_empty_list_when_none_match():
+    assert invoices.invoices_by_status("open") == []
+    _issue(1)
+    assert invoices.invoices_by_status("paid") == []
+
+
+def test_read_only_no_event_and_repeatable():
+    _issue(2)
+    before = list(events.OUTBOX)
+    first = invoices.invoices_by_status("open")
+    second = invoices.invoices_by_status("open")
+    assert first == second
+    assert events.OUTBOX == before
+
+
+@pytest.mark.parametrize("status", ["void", "OPEN", "Paid", "", None])
+def test_invalid_status_rejected(status):
+    with pytest.raises(DomainError) as err:
+        invoices.invoices_by_status(status)
+    assert err.value.code == "E_BAD_INPUT"
