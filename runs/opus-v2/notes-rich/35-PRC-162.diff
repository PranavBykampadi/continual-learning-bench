+
+
+def invoices_by_status(status):
+    """Return invoices whose status is ``status``, in issue order.
+
+    Read-only: emits no event. Returns an empty list if none match.
+    Raises DomainError("E_BAD_INPUT") if ``status`` is not one of
+    settings.INVOICE_QUERY_STATUSES.
+    """
+    if status not in INVOICE_QUERY_STATUSES:
+        raise DomainError("E_BAD_INPUT", repr(status))
+    return [i for i in db.invoices.values() if i.status == status]
