diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_invoices_reopen.py b/tests/unit/test_invoices_reopen.py
--- a/tests/unit/test_invoices_reopen.py	1969-12-31 19:00:00
+++ b/tests/unit/test_invoices_reopen.py	2026-11-12 02:10:29
@@ -0,0 +1,97 @@
+from datetime import datetime, timedelta, timezone
+
+import pytest
+
+from parcelo import clock, customers, events, invoices, shipments
+from parcelo.errors import DomainError
+from parcelo.store import db
+
+NOW = datetime(2026, 11, 12, 9, 0, tzinfo=timezone.utc)
+
+
+def _issue():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 1.5, "national")
+    return invoices.issue_invoice(s.id)
+
+
+def _paid():
+    inv = _issue()
+    invoices.mark_paid(inv.id)
+    return inv
+
+
+def test_reopen_paid_invoice():
+    inv = _paid()
+    clock.set_fixed(NOW)
+    result = invoices.reopen_invoice(inv.id)
+    assert result is inv
+    assert inv.status == "open"
+    assert inv.paid_at is None
+    assert inv.reopened_at == NOW
+    assert inv in invoices.open_invoices()
+    assert events.OUTBOX[-1] == {
+        "name": "invoice.reopened",
+        "entity_id": inv.id,
+        "at": NOW,
+        "payload": {"from_status": "paid", "to_status": "open"},
+    }
+
+
+def test_new_invoice_has_no_reopened_at():
+    assert _issue().reopened_at is None
+
+
+def test_pay_reopen_pay_again():
+    inv = _paid()
+    clock.set_fixed(NOW)
+    invoices.reopen_invoice(inv.id)
+    invoices.mark_paid(inv.id)
+    assert inv.status == "paid"
+    clock.set_fixed(NOW + timedelta(hours=1))
+    invoices.reopen_invoice(inv.id)
+    assert inv.reopened_at == NOW + timedelta(hours=1)
+    assert [e["name"] for e in events.OUTBOX].count("invoice.reopened") == 2
+
+
+@pytest.mark.parametrize("bad_id", ["nope", "", None, 123, []])
+def test_unknown_invoice(bad_id):
+    _paid()
+    before = len(events.OUTBOX)
+    with pytest.raises(DomainError) as err:
+        invoices.reopen_invoice(bad_id)
+    assert err.value.code == "E_NOT_FOUND"
+    assert len(events.OUTBOX) == before
+
+
+def test_deleted_invoice_not_found():
+    inv = _paid()
+    del db.invoices[inv.id]
+    with pytest.raises(DomainError) as err:
+        invoices.reopen_invoice(inv.id)
+    assert err.value.code == "E_NOT_FOUND"
+
+
+@pytest.mark.parametrize("status", ["open", "void", "PAID", "Paid"])
+def test_not_paid_rejected(status):
+    inv = _issue()
+    inv.status = status
+    before = len(events.OUTBOX)
+    with pytest.raises(DomainError) as err:
+        invoices.reopen_invoice(inv.id)
+    assert err.value.code == "E_BAD_STATE"
+    assert inv.status == status
+    assert inv.reopened_at is None
+    assert len(events.OUTBOX) == before
+
+
+def test_reopen_twice_rejected():
+    inv = _paid()
+    clock.set_fixed(NOW)
+    invoices.reopen_invoice(inv.id)
+    before = len(events.OUTBOX)
+    with pytest.raises(DomainError) as err:
+        invoices.reopen_invoice(inv.id)
+    assert err.value.code == "E_BAD_STATE"
+    assert inv.reopened_at == NOW
+    assert len(events.OUTBOX) == before
