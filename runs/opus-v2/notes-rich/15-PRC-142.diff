+PAID_STATUS = "paid"
+OPEN_STATUS = "open"
+
+
+def reopen_invoice(invoice_id):
+    """Set a paid invoice back to open, clearing paid_at and stamping reopened_at.
+
+    Raises DomainError:
+      E_NOT_FOUND  - invoice_id is not a str or no such invoice exists
+      E_BAD_STATE  - the invoice is not paid
+    Emits "invoice.reopened" on success; nothing is changed on failure.
+    """
+    if not isinstance(invoice_id, str) or invoice_id not in db.invoices:
+        raise DomainError("E_NOT_FOUND", str(invoice_id))
+    invoice = db.invoices[invoice_id]
+    if invoice.status != PAID_STATUS:
+        raise DomainError("E_BAD_STATE", f"invoice {invoice_id} is {invoice.status}, not paid")
+    now = clock.now()
+    invoice.status = OPEN_STATUS
+    invoice.paid_at = None
+    invoice.reopened_at = now
+    events.emit("invoice.reopened", invoice.id, from_status=PAID_STATUS, to_status=OPEN_STATUS)
     return invoice
 
 
