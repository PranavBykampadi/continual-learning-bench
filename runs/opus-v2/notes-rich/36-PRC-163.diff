diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_lock_customer.py b/tests/unit/test_lock_customer.py
--- a/tests/unit/test_lock_customer.py	1969-12-31 19:00:00
+++ b/tests/unit/test_lock_customer.py	2026-11-12 02:32:59
@@ -0,0 +1,45 @@
+from datetime import datetime, timezone
+
+import pytest
+
+from parcelo import clock, customers, events
+from parcelo.errors import DomainError
+
+
+def test_new_customer_is_not_locked():
+    c = customers.add_customer("Acme")
+    assert c.locked is False
+    assert c.locked_at is None
+
+
+def test_lock_customer_sets_flag_and_emits_event():
+    t1 = datetime(2026, 1, 1, tzinfo=timezone.utc)
+    clock.set_fixed(t1)
+    c = customers.add_customer("Acme")
+    result = customers.lock_customer(c.id)
+    assert result is c
+    assert c.locked is True
+    assert c.locked_at == t1
+    assert [e["name"] for e in events.OUTBOX] == ["customer.locked"]
+    assert events.OUTBOX[0]["entity_id"] == c.id
+
+
+def test_lock_customer_is_idempotent():
+    t1 = datetime(2026, 1, 1, tzinfo=timezone.utc)
+    t2 = datetime(2026, 1, 2, tzinfo=timezone.utc)
+    c = customers.add_customer("Acme")
+    clock.set_fixed(t1)
+    customers.lock_customer(c.id)
+    clock.set_fixed(t2)
+    result = customers.lock_customer(c.id)
+    assert result is c
+    assert c.locked is True
+    assert c.locked_at == t1
+    assert [e["name"] for e in events.OUTBOX] == ["customer.locked"]
+
+
+def test_lock_unknown_customer():
+    with pytest.raises(DomainError) as err:
+        customers.lock_customer("nope")
+    assert err.value.code == "E_NOT_FOUND"
+    assert events.OUTBOX == []
