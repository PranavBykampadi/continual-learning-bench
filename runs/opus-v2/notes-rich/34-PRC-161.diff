+"""Named thresholds, rates and limits used across parcelo."""
+
+# Volume rebate. Same shipment-count cut-offs as `legacy.billing.volume_tier`.
+REBATE_REGULAR_MIN_SHIPMENTS = 10
+REBATE_REGULAR_PCT = 3
+REBATE_BULK_MIN_SHIPMENTS = 50
+REBATE_BULK_PCT = 6
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/test_rebates.py b/tests/test_rebates.py
--- a/tests/test_rebates.py	1969-12-31 19:00:00
+++ b/tests/test_rebates.py	2026-11-12 02:31:04
@@ -0,0 +1,63 @@
+import pytest
+
+from parcelo import customers, events, shipments
+from parcelo.errors import DomainError
+from parcelo.models import Invoice
+from parcelo.store import db
+
+
+def _customer(n_shipments, paid=(), unpaid=()):
+    c = customers.add_customer("Acme")
+    ships = [shipments.create_shipment(c.id, 1, "local") for _ in range(n_shipments)]
+    for i, amt in enumerate(paid):
+        inv_id = f"{c.id}-P{i}"
+        db.invoices[inv_id] = Invoice(id=inv_id, shipment_id=ships[0].id, amount=amt, status="paid")
+    for i, amt in enumerate(unpaid):
+        inv_id = f"{c.id}-O{i}"
+        db.invoices[inv_id] = Invoice(id=inv_id, shipment_id=ships[0].id, amount=amt)
+    events.OUTBOX.clear()
+    return c
+
+
+def test_below_threshold_is_zero():
+    c = _customer(9, paid=[100.0])
+    assert customers.rebate_for(c.id) == 0.0
+
+
+def test_regular_tier_three_percent_of_paid_only():
+    c = _customer(10, paid=[100.0, 50.0], unpaid=[1000.0])
+    assert customers.rebate_for(c.id) == 4.5
+
+
+def test_bulk_tier_six_percent():
+    c = _customer(50, paid=[100.0])
+    assert customers.rebate_for(c.id) == 6.0
+
+
+def test_no_paid_invoices_is_zero():
+    c = _customer(10)
+    assert customers.rebate_for(c.id) == 0.0
+
+
+def test_rounds_half_up_to_cent():
+    c = _customer(10, paid=[0.5])  # 3% of 0.50 = 0.015
+    assert customers.rebate_for(c.id) == 0.02
+
+
+def test_ignores_other_customers_invoices():
+    c = _customer(10)
+    other = _customer(10, paid=[100.0])
+    assert customers.rebate_for(c.id) == 0.0
+    assert customers.rebate_for(other.id) == 3.0
+
+
+def test_read_only_no_event():
+    c = _customer(10, paid=[100.0])
+    assert customers.rebate_for(c.id) == customers.rebate_for(c.id)
+    assert events.OUTBOX == []
+
+
+def test_unknown_customer():
+    with pytest.raises(DomainError) as err:
+        customers.rebate_for("nope")
+    assert err.value.code == "E_NOT_FOUND"
