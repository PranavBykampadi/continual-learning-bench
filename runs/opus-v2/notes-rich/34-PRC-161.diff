+def rebate_for(customer_id):
+    """Volume rebate earned: a share of the customer's paid invoices by shipment count."""
+    if customer_id not in db.customers:
+        raise DomainError("E_NOT_FOUND", customer_id)
+    shipment_ids = {
+        s.id for s in db.shipments.values() if s.customer_id == customer_id
+    }
+    count = len(shipment_ids)
+    if count >= settings.REBATE_BULK_MIN_SHIPMENTS:
+        pct = settings.REBATE_BULK_PCT
+    elif count >= settings.REBATE_REGULAR_MIN_SHIPMENTS:
+        pct = settings.REBATE_REGULAR_PCT
+    else:
+        return 0.0
+    paid = Money.zero()
+    for invoice in db.invoices.values():
+        if invoice.shipment_id in shipment_ids and invoice.status == "paid":
+            paid = paid + Money.parse(invoice.amount)
+    return paid.scale(pct / 100).cents / 100
