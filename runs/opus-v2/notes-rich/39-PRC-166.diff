diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_escalate_invoice.py b/tests/unit/test_escalate_invoice.py
--- a/tests/unit/test_escalate_invoice.py	1969-12-31 19:00:00
+++ b/tests/unit/test_escalate_invoice.py	2026-11-12 02:35:59
@@ -0,0 +1,77 @@
+from datetime import datetime, timezone
+
+import pytest
+
+from parcelo import clock, events, invoices
+from parcelo.errors import DomainError
+from parcelo.models import Invoice
+from parcelo.store import db
+
+T1 = datetime(2026, 1, 1, tzinfo=timezone.utc)
+T2 = datetime(2026, 1, 2, tzinfo=timezone.utc)
+
+
+def _invoice(amount, status="open", id="INV-1"):
+    inv = Invoice(id=id, shipment_id="shp_1", amount=amount, status=status)
+    db.invoices[inv.id] = inv
+    return inv
+
+
+def test_escalates_open_invoice():
+    clock.set_fixed(T1)
+    _invoice(750.0)
+    inv = invoices.escalate_invoice("INV-1")
+    assert inv.status == "escalated"
+    assert inv.escalated_at == T1
+    assert [e["name"] for e in events.OUTBOX] == ["invoice.escalated"]
+    assert events.OUTBOX[0]["entity_id"] == "INV-1"
+
+
+def test_exact_threshold_is_allowed():
+    _invoice(500.00)
+    assert invoices.escalate_invoice("INV-1").status == "escalated"
+
+
+def test_idempotent_second_call():
+    clock.set_fixed(T1)
+    _invoice(600.0)
+    invoices.escalate_invoice("INV-1")
+    clock.set_fixed(T2)
+    inv = invoices.escalate_invoice("INV-1")
+    assert inv.status == "escalated"
+    assert inv.escalated_at == T1
+    assert len(events.OUTBOX) == 1
+
+
+def test_unknown_invoice():
+    with pytest.raises(DomainError) as err:
+        invoices.escalate_invoice("nope")
+    assert err.value.code == "E_NOT_FOUND"
+
+
+@pytest.mark.parametrize("status", ["paid", "void"])
+def test_bad_state_leaves_invoice_untouched(status):
+    inv = _invoice(900.0, status=status)
+    with pytest.raises(DomainError) as err:
+        invoices.escalate_invoice("INV-1")
+    assert err.value.code == "E_BAD_STATE"
+    assert inv.status == status
+    assert inv.escalated_at is None
+    assert events.OUTBOX == []
+
+
+def test_below_threshold_is_rejected():
+    inv = _invoice(499.99)
+    with pytest.raises(DomainError) as err:
+        invoices.escalate_invoice("INV-1")
+    assert err.value.code == "E_LIMIT"
+    assert inv.status == "open"
+    assert inv.escalated_at is None
+    assert events.OUTBOX == []
+
+
+def test_bad_state_checked_before_limit():
+    _invoice(10.0, status="paid")
+    with pytest.raises(DomainError) as err:
+        invoices.escalate_invoice("INV-1")
+    assert err.value.code == "E_BAD_STATE"
