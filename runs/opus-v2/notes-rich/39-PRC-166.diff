 def open_invoices():
     return [i for i in db.invoices.values() if i.status == "open"]
+
+
+def escalate_invoice(invoice_id):
+    """Hand a large open invoice to collections. Idempotent."""
+    if invoice_id not in db.invoices:
+        raise DomainError("E_NOT_FOUND", f"invoice {invoice_id}")
+    invoice = db.invoices[invoice_id]
+    if invoice.status == "escalated":
+        return invoice
+    if invoice.status != "open":
+        raise DomainError("E_BAD_STATE", invoice.status)
+    if Money.parse(invoice.amount) < settings.ESCALATION_MIN_AMOUNT:
+        raise DomainError("E_LIMIT", f"amount below {settings.ESCALATION_MIN_AMOUNT}")
+    invoice.status = "escalated"
+    invoice.escalated_at = clock.now()
+    events.emit("invoice.escalated", invoice.id)
+    return invoice
