+"""Customer claims against delivered shipments."""
+from decimal import Decimal, InvalidOperation
+
+from parcelo import audit, clock, ids
+from parcelo.errors import DomainError
+from parcelo.models import Claim
+from parcelo.money import Money
+from parcelo.store import db
+
+CLAIMABLE_STATUS = "delivered"
+
+
+def _parse_amount(amount):
+    """Return a positive Money, or raise E_BAD_INPUT.
+
+    Accepts Money, int, float, str or Decimal (dollars, rounded half-up to the
+    cent via Money). Rejects bool, None, unparseable or non-finite values, and
+    anything that is not strictly positive after rounding.
+    """
+    if amount is None or isinstance(amount, bool):
+        raise DomainError("E_BAD_INPUT", f"amount: {amount!r}")
+    if not isinstance(amount, (Money, int, float, str, Decimal)):
+        raise DomainError("E_BAD_INPUT", f"amount: {amount!r}")
+    try:
+        money = Money.parse(amount)
+    except (InvalidOperation, ValueError, ArithmeticError):
+        raise DomainError("E_BAD_INPUT", f"amount: {amount!r}") from None
+    if money.cents <= 0:
+        raise DomainError("E_BAD_INPUT", f"amount: {amount!r}")
+    return money
+
+
+def file_claim(shipment_id, amount, reason):
+    """File a claim for money back on a delivered shipment and return it.
+
+    Raises DomainError:
+      - E_NOT_FOUND if the shipment id is not a str or does not exist;
+      - E_BAD_INPUT if the amount is not positive or the reason is not a
+        non-blank string;
+      - E_BAD_STATE if the shipment is not delivered.
+    Nothing is stored or audited on failure.
+    """
+    if not isinstance(shipment_id, str) or shipment_id not in db.shipments:
+        raise DomainError("E_NOT_FOUND", str(shipment_id))
+    shipment = db.shipments[shipment_id]
+    money = _parse_amount(amount)
+    if not isinstance(reason, str) or not reason.strip():
+        raise DomainError("E_BAD_INPUT", f"reason: {reason!r}")
+    if shipment.status != CLAIMABLE_STATUS:
+        raise DomainError("E_BAD_STATE", shipment.status)
+    claim = Claim(
+        id=ids.new_id("clm"),
+        shipment_id=shipment_id,
+        amount=money,
+        reason=reason.strip(),
+        filed_at=clock.now(),
+    )
+    db.claims[claim.id] = claim
+    audit.record(
+        "claim.filed", claim.id, shipment_id=shipment_id, amount_cents=money.cents
+    )
+    return claim
