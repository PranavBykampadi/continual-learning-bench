+from datetime import datetime, timedelta, timezone
+
+import pytest
+
+from parcelo import audit, claims, clock, customers, shipments, store
+from parcelo.errors import DomainError
+from parcelo.models import Claim
+from parcelo.money import Money
+from parcelo.store import db
+
+NOW = datetime(2026, 11, 12, 9, 0, tzinfo=timezone.utc)
+
+
+def _delivered():
+    cid = customers.add_customer("Ada").id
+    s = shipments.create_shipment(cid, 2, "local")
+    s.status = "delivered"
+    return s
+
+
+def test_files_claim_on_delivered_shipment():
+    clock.set_fixed(NOW)
+    s = _delivered()
+    claim = claims.file_claim(s.id, "12.50", "box crushed")
+    assert isinstance(claim, Claim)
+    assert claim.id == "clm_000002"  # shp_000001 took the first id
+    assert claim.shipment_id == s.id
+    assert claim.amount == Money(1250)
+    assert claim.reason == "box crushed"
+    assert claim.filed_at == NOW
+    assert db.claims[claim.id] is claim
+    assert audit.LOG[-1]["action"] == "claim.filed"
+    assert audit.LOG[-1]["entity_id"] == claim.id
+    assert audit.LOG[-1]["details"] == {"shipment_id": s.id, "amount_cents": 1250}
+
+
+@pytest.mark.parametrize(
+    "amount, cents",
+    [(10, 1000), (0.01, 1), (Money(99), 99), ("1.005", 101)],  # 100.5 -> 101 half-up
+)
+def test_amount_forms(amount, cents):
+    s = _delivered()
+    assert claims.file_claim(s.id, amount, "lost").amount == Money(cents)
+
+
+def test_each_claim_gets_its_own_time_and_multiple_claims_allowed():
+    s = _delivered()
+    clock.set_fixed(NOW)
+    a = claims.file_claim(s.id, 1, "a")
+    clock.set_fixed(NOW + timedelta(hours=1))
+    b = claims.file_claim(s.id, 2, "b")
+    assert a.filed_at == NOW
+    assert b.filed_at == NOW + timedelta(hours=1)
+    assert list(db.claims) == [a.id, b.id]
+
+
