+
+def quote_with_surcharge(weight_kg, zone):
+    """Quote for weight/zone including the zone's fuel surcharge."""
+    if zone not in ZONE_BASE:
+        raise DomainError("E_BAD_ZONE", str(zone))
+    if weight_kg <= 0:
+        raise DomainError("E_BAD_WEIGHT", str(weight_kg))
+    amount = quote(weight_kg, zone)
+    return round(amount + fuel_surcharge(amount, zone), 2)
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_rates.py b/tests/unit/test_rates.py
--- a/tests/unit/test_rates.py	1969-12-31 19:00:00
+++ b/tests/unit/test_rates.py	2026-11-12 01:53:09
@@ -0,0 +1,48 @@
+import pytest
+
+from parcelo import rates
+from parcelo.errors import DomainError
+from parcelo.legacy.billing import fuel_surcharge
+
+
+def test_local_has_no_surcharge():
+    # base 4.5 + 2 * 1.25 = 7.0, 0% surcharge
+    assert rates.quote_with_surcharge(2, "local") == 7.0
+
+
+def test_national_adds_four_percent():
+    # base 9.0 + 2 * 1.25 = 11.5, +4% = 0.46
+    assert rates.quote_with_surcharge(2, "national") == 11.96
+
+
+def test_international_adds_nine_and_a_half_percent():
+    # base 24.0 + 4 * 1.25 = 29.0, +9.5% = 2.755 -> 2.76 (float rounding)
+    expected = round(29.0 + fuel_surcharge(29.0, "international"), 2)
+    assert rates.quote_with_surcharge(4, "international") == expected
+    assert expected > 29.0
+
+
+@pytest.mark.parametrize("zone", ["local", "national", "international"])
+def test_matches_quote_plus_legacy_surcharge(zone):
+    base = rates.quote(3.3, zone)
+    assert rates.quote_with_surcharge(3.3, zone) == round(
+        base + fuel_surcharge(base, zone), 2
+    )
+
+
+@pytest.mark.parametrize("zone", ["moon", "", None, "LOCAL"])
+def test_unknown_zone_rejected(zone):
+    with pytest.raises(DomainError) as err:
+        rates.quote_with_surcharge(2, zone)
+    assert err.value.code == "E_BAD_ZONE"
+
+
+@pytest.mark.parametrize("weight", [0, 0.0, -1, -0.5])
+def test_non_positive_weight_rejected(weight):
+    with pytest.raises(DomainError) as err:
+        rates.quote_with_surcharge(weight, "national")
+    assert err.value.code == "E_BAD_WEIGHT"
+
+
+def test_existing_quote_unchanged():
+    assert rates.quote(2, "national") == 11.5
