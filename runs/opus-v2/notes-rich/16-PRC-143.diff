@@ -0,0 +1,115 @@
+from datetime import datetime, timedelta, timezone
+
+import pytest
+
+from parcelo import clock, customers, events, pickups, shipments, store
+from parcelo.errors import DomainError
+from parcelo.models import Pickup
+from parcelo.store import db
+
+NOW = datetime(2026, 11, 12, 9, 0, tzinfo=timezone.utc)
+WINDOW = NOW + timedelta(hours=4)
+
+
+@pytest.fixture(autouse=True)
+def fixed_clock():
+    clock.set_fixed(NOW)
+
+
+def _shipment():
+    c = customers.add_customer("Acme")
+    return shipments.create_shipment(c.id, 2.0, "local")
+
+
+def _assert_nothing_happened(before):
+    assert db.pickups == {}
+    assert len(events.OUTBOX) == before
+
+
+def test_pickup_defaults_are_none():
+    p = Pickup(id="pkp_x", shipment_id="shp_x")
+    assert p.window_start is None
+    assert p.scheduled_at is None
+
+
+def test_schedule_creates_saves_and_emits():
+    s = _shipment()
+    p = pickups.schedule_pickup(s.id, WINDOW)
+    # global id counter: the shipment took _000001
+    assert p.id == "pkp_000002"
+    assert p.shipment_id == s.id
+    assert p.window_start == WINDOW
+    assert p.scheduled_at == NOW
+    assert db.pickups[p.id] is p
+    assert events.OUTBOX[-1] == {
+        "name": "pickup.scheduled",
+        "entity_id": p.id,
+        "at": NOW,
+        "payload": {"shipment_id": s.id, "window_start": WINDOW},
+    }
+
+
+def test_reset_clears_pickups():
+    s = _shipment()
+    pickups.schedule_pickup(s.id, WINDOW)
+    store.reset()
+    assert db.pickups == {}
+
+
+@pytest.mark.parametrize("bad_id", ["nope", "", None, 123, []])
+def test_unknown_shipment(bad_id):
+    _shipment()
+    before = len(events.OUTBOX)
+    with pytest.raises(DomainError) as err:
+        pickups.schedule_pickup(bad_id, WINDOW)
+    assert err.value.code == "E_NOT_FOUND"
+    _assert_nothing_happened(before)
+
+
+def test_orphaned_shipment_not_found():
+    s = _shipment()
+    del db.shipments[s.id]
+    before = len(events.OUTBOX)
+    with pytest.raises(DomainError) as err:
+        pickups.schedule_pickup(s.id, WINDOW)
+    assert err.value.code == "E_NOT_FOUND"
+    _assert_nothing_happened(before)
+
+
+@pytest.mark.parametrize("status", ["delivered", "in_transit", "Created", "CREATED", ""])
+def test_wrong_status(status):
+    s = _shipment()
+    s.status = status
+    before = len(events.OUTBOX)
+    with pytest.raises(DomainError) as err:
+        pickups.schedule_pickup(s.id, WINDOW)
+    assert err.value.code == "E_BAD_STATE"
+    assert s.status == status
+    _assert_nothing_happened(before)
+
+
+@pytest.mark.parametrize(
+    "bad_window",
+    [None, "2026-11-12T13:00:00Z", 123, datetime(2026, 11, 12, 13, 0)],
+)
+def test_bad_window(bad_window):
+    s = _shipment()
+    before = len(events.OUTBOX)
+    with pytest.raises(DomainError) as err:
+        pickups.schedule_pickup(s.id, bad_window)
+    assert err.value.code == "E_BAD_INPUT"
+    _assert_nothing_happened(before)
+
+
