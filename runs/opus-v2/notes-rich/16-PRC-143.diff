+from datetime import datetime
+
+from parcelo import clock, events, ids, shipments
+from parcelo.errors import DomainError
+from parcelo.models import Pickup
+from parcelo.store import db
+
+SCHEDULABLE_STATUS = "created"
+
+
+def schedule_pickup(shipment_id, window_start):
+    """Book a pickup for a shipment that is ready to go.
+
+    Errors:
+        E_NOT_FOUND: shipment_id is not a str or no such shipment exists.
+        E_BAD_INPUT: window_start is not a timezone-aware datetime.
+        E_BAD_STATE: the shipment status is not exactly "created".
+    """
+    if not isinstance(shipment_id, str):
+        raise DomainError("E_NOT_FOUND", repr(shipment_id))
+    shipment = shipments.get_shipment(shipment_id)
+    if not isinstance(window_start, datetime) or window_start.tzinfo is None:
+        raise DomainError("E_BAD_INPUT", "window_start must be a tz-aware datetime")
+    if shipment.status != SCHEDULABLE_STATUS:
+        raise DomainError("E_BAD_STATE", shipment.status)
+    pickup = Pickup(
+        id=ids.new_id("pkp"),
+        shipment_id=shipment.id,
+        window_start=window_start,
+        scheduled_at=clock.now(),
+    )
+    db.pickups[pickup.id] = pickup
+    events.emit(
+        "pickup.scheduled",
+        pickup.id,
+        shipment_id=shipment.id,
+        window_start=window_start,
+    )
+    return pickup
