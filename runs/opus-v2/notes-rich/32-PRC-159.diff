@@ -28,3 +28,10 @@
     if shipment_id not in db.shipments:
         raise DomainError("E_NOT_FOUND", shipment_id)
     return db.shipments[shipment_id]
+
+
+def shipments_in_zone(zone):
+    if zone not in ZONE_BASE:
+        raise DomainError("E_BAD_ZONE", zone)
+    matches = [s for s in db.shipments.values() if s.zone == zone]
+    return sorted(matches, key=lambda s: s.id)
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_shipments_zone_list.py b/tests/unit/test_shipments_zone_list.py
--- a/tests/unit/test_shipments_zone_list.py	1969-12-31 19:00:00
+++ b/tests/unit/test_shipments_zone_list.py	2026-11-12 02:28:47
@@ -0,0 +1,38 @@
+import pytest
+
+from parcelo import customers, events, shipments
+from parcelo.errors import DomainError
+from parcelo.store import db
+
+
+def test_returns_only_matching_zone_sorted_by_id():
+    c = customers.add_customer("Acme")
+    a = shipments.create_shipment(c.id, 1, "local")
+    shipments.create_shipment(c.id, 1, "national")
+    b = shipments.create_shipment(c.id, 2, "local")
+    # reinsert so the store iterates out of id order
+    others = {k: v for k, v in db.shipments.items() if k != b.id}
+    db.shipments.clear()
+    db.shipments[b.id] = b
+    db.shipments.update(others)
+    events.OUTBOX.clear()
+
+    result = shipments.shipments_in_zone("local")
+
+    assert [s.id for s in result] == sorted([a.id, b.id])
+    assert events.OUTBOX == []
+
+
+def test_empty_when_no_shipments_in_zone():
+    c = customers.add_customer("Acme")
+    shipments.create_shipment(c.id, 1, "local")
+    events.OUTBOX.clear()
+
+    assert shipments.shipments_in_zone("international") == []
+    assert events.OUTBOX == []
+
+
+def test_unknown_zone_rejected():
+    with pytest.raises(DomainError) as err:
+        shipments.shipments_in_zone("mars")
+    assert err.value.code == "E_BAD_ZONE"
