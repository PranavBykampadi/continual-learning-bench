@@ -0,0 +1,113 @@
+from datetime import datetime, timezone
+
+import pytest
+
+from parcelo import clock, events, returns
+from parcelo.errors import DomainError
+from parcelo.models import ReturnRequest, Shipment
+from parcelo.store import db, reset
+
+T = datetime(2026, 11, 12, 9, 30, tzinfo=timezone.utc)
+
+
+def _ship(sid="shp_1", status="delivered"):
+    db.shipments[sid] = Shipment(id=sid, customer_id="c1", weight_kg=1.0, zone="local", status=status)
+    return db.shipments[sid]
+
+
+def test_request_return_creates_and_stores():
+    _ship()
+    clock.set_fixed(T)
+    events.OUTBOX.clear()
+    r = returns.request_return("shp_1", "damaged")
+    assert r.id.startswith("ret_")
+    assert (r.shipment_id, r.reason, r.requested_at) == ("shp_1", "damaged", T)
+    assert db.returns[r.id] is r
+    assert [(e["name"], e["entity_id"]) for e in events.OUTBOX] == [("return.requested", r.id)]
+
+
+def test_unknown_shipment():
+    events.OUTBOX.clear()
+    with pytest.raises(DomainError) as err:
+        returns.request_return("nope", "damaged")
+    assert err.value.code == "E_NOT_FOUND"
+    assert db.returns == {} and events.OUTBOX == []
+
+
+def test_not_found_checked_before_bad_input():
+    with pytest.raises(DomainError) as err:
+        returns.request_return("nope", "")
+    assert err.value.code == "E_NOT_FOUND"
+
+
+@pytest.mark.parametrize("reason", ["", "   ", None])
+def test_bad_reason(reason):
+    _ship()
+    with pytest.raises(DomainError) as err:
+        returns.request_return("shp_1", reason)
+    assert er