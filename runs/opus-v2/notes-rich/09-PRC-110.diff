+from decimal import Decimal
+
+import pytest
+
+from parcelo import audit, rates
+from parcelo.errors import DomainError
+from parcelo.money import Money
+
+
+@pytest.mark.parametrize(
+    "weight, zone, expected",
+    [
+        (2, "local", Money(700)),
+        (2, "national", Money(1150)),
+        (2, "international", Money(2650)),
+        (Decimal("1.5"), "local", Money(638)),  # 6.375 -> half-up
+    ],
+)
+def test_standard_tier_is_regular_quote(weight, zone, expected):
+    assert rates.discounted_quote(weight, zone, "standard") == expected
+
+
+@pytest.mark.parametrize(
+    "weight, zone, expected",
+    [
+        (2, "local", Money(630)),  # 7.00 * 0.9
+        (2, "national", Money(1035)),  # 11.50 * 0.9
+        (2, "international", Money(2385)),  # 26.50 * 0.9
+        (1, "local", Money(518)),  # 5.75 * 0.9 = 5.175 -> half-up
+        (0.5, "national", Money(867)),  # 9.625 -> 9.63; * 0.9 = 8.667
+    ],
+)
+def test_gold_tier_gets_ten_percent_off(weight, zone, expected):
+    assert rates.discounted_quote(weight, zone, "gold") == expected
+
+
+def test_returns_money():
+    assert isinstance(rates.discounted_quote(2, "local", "gold"), Money)
+
+
+def test_standard_matches_regular_quote():
+    assert rates.discounted_quote(3, "national", "standard") == Money.parse(
+        rates.quote(3, "national")
+    )
+
+
+def test_writes_no_audit_entries():
+    rates.discounted_quote(2, "local", "gold")
+    assert len(audit.LOG) == 0
+
+
+@pytest.mark.parametrize("zone", ["moon", "", "   ", None, 123, [], "Local"])
+def test_unknown_zone(zone):
+    with pytest.raises(DomainError) as err:
+        rates.discounted_quote(2, zone, "gold")
+    assert err.value.code == "E_BAD_ZONE"
+
+
+@pytest.mark.parametrize("tier", ["platinum", "", "   ", None, 123, [], "Gold"])
+def test_unknown_tier(tier):
+    with pytest.raises(DomainError) as err:
+        rates.discounted_quote(2, "local", tier)
+    assert err.value.code == "E_BAD_INPUT"
+
+
+@pytest.mark.parametrize("weight", [0, -1, None, "abc", True, []])
+def test_bad_weight(weight):
+    with pytest.raises(DomainError) as err:
+        rates.discounted_quote(weight, "local", "gold")
+    assert err.value.code == "E_BAD_WEIGHT"
+
+
+def test_check_order_zone_then_weight_then_tier():
+    with pytest.raises(DomainError) as err:
+        rates.discounted_quote(0, "moon", "platinum")
+    assert err.value.code == "E_BAD_ZONE"
+    with pytest.raises(DomainError) as err:
+        rates.discounted_quote(0, "local", "platinum")
+    assert err.value.code == "E_BAD_WEIGHT"
