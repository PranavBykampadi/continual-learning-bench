+from decimal import Decimal
+
+from parcelo.errors import DomainError
+from parcelo.money import Money
+
 ZONE_BASE = {"local": 4.5, "national": 9.0, "international": 24.0}
 PER_KG = 1.25
 
+# Percentage off the regular quote, per customer tier (PRC-110).
+TIER_DISCOUNT_PCT = {"standard": Decimal("0"), "gold": Decimal("10")}
 
+
 def base_rate(zone):
     if zone not in ZONE_BASE:
         raise ValueError("unknown zone: %s" % zone)
@@ -12,3 +20,26 @@
     if weight_kg <= 0:
         raise ValueError("weight must be positive")
     return round(base_rate(zone) + PER_KG * weight_kg, 2)
+
+
+def discounted_quote(weight_kg, zone, tier):
+    """Regular quote for weight and zone, less the tier's discount, as Money.
+
+    Same percentage math as the legacy billing discount
+    (amount * (1 - pct / 100)), but computed in Decimal and rounded
+    half-up to the cent via Money rather than float round().
+    """
+    if not isinstance(zone, str) or zone not in ZONE_BASE:
+        raise DomainError("E_BAD_ZONE", str(zone))
+    if (
+        isinstance(weight_kg, bool)
+        or not isinstance(weight_kg, (int, float, Decimal))
+        or not weight_kg > 0
+    ):
+        raise DomainError("E_BAD_WEIGHT", str(weight_kg))
+    if not isinstance(tier, str) or tier not in TIER_DISCOUNT_PCT:
+        raise DomainError("E_BAD_INPUT", "unknown tier: %r" % (tier,))
+    regular = Money.parse(
+        Decimal(str(ZONE_BASE[zone])) + Decimal(str(PER_KG)) * Decimal(str(weight_kg))
+    )
+    return regular.scale(1 - TIER_DISCOUNT_PCT[tier] / 100)
