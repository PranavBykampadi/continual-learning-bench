@@ -0,0 +1,72 @@
+import pytest
+
+from parcelo import audit, customers, invoices, reports, shipments
+from parcelo.money import Money
+from parcelo.store import db
+
+
+def _issue(customer_id, weight=2, zone="local"):
+    s = shipments.create_shipment(customer_id, weight, zone)
+    return invoices.issue_invoice(s.id)
+
+
+def test_empty_store_returns_empty_dict():
+    assert reports.outstanding_by_customer() == {}
+
+
+def test_customer_without_invoices_owes_zero():
+    c = customers.add_customer("Acme")
+    assert reports.outstanding_by_customer() == {c.id: Money.zero()}
+
+
+def test_sums_open_invoices_per_customer():
+    a = customers.add_customer("Acme")
+    b = customers.add_customer("Globex")
+    _issue(a.id, 2, "local")  # 4.50 + 2.50 = 7.00
+    _issue(a.id, 1, "national")  # 9.00 + 1.25 = 10.25
+    _issue(b.id, 4, "international")  # 24.00 + 5.00 = 29.00
+    assert reports.outstanding_by_customer() == {
+        a.id: Money(1725),
+        b.id: Money(2900),
+    }
+
+
+@pytest.mark.parametrize("status", ["paid", "void"])
+def test_closed_invoices_excluded(status):
+    c = customers.add_customer("Acme")
+    _issue(c.id, 2, "local")
+    closed = _issue(c.id, 1, "national")
+    closed.status = status
+    assert reports.outstanding_by_customer() == {c.id: Money(700)}
+
+
+def test_mark_paid_flow_removes_balance():
+    c = customers.add_customer("Acme")
+    inv = _issue(c.id, 2, "local")
+    invoices.mark_paid(inv.id)
+    assert reports.outstanding_by_customer() == {c.id: Money.zero()}
+
+
+def test_float_amounts_summed_exactly():
+    c = customers.add_customer("Acme")
+    for _ in range(3):
+        _issue(c.id, 0.08, "local")  # 4.50 + 0.10 = 4.60
+    result = reports.outstanding_by_customer()
+    assert result[c.id] == Money(1380)
+    assert isinstance(result[c.id], Money)
+
+
+def test_orphan_invoice_skipped():
+    c = customers.add_customer("Acme")
+    inv = _issue(c.id)
+    del db.shipments[inv.shipment_id]
+    assert reports.outstanding_by_customer() == {c.id: Money.zero()}
+
+
+def test_read_only():
+    c = customers.add_customer("Acme")
+    inv = _issue(c.id)
+    log_len = len(audit.LOG)
+    reports.outstanding_by_customer()
+    assert inv.status == "open"
+    assert len(audit.LOG) == log_len
