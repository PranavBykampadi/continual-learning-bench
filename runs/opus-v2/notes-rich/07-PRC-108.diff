+def outstanding_by_customer():
+    """Map every customer id to the total of its open invoices as Money.
+
+    Customers with nothing open map to Money.zero(). Paid, void and any other
+    non-open invoices are excluded. Invoices whose shipment or customer no
+    longer exists are skipped.
+    """
+    totals = {customer_id: Money.zero() for customer_id in db.customers}
+    for invoice in db.invoices.values():
+        if invoice.status != OPEN_STATUS:
+            continue
+        shipment = db.shipments.get(invoice.shipment_id)
+        if shipment is None or shipment.customer_id not in totals:
+            continue
+        totals[shipment.customer_id] = totals[shipment.customer_id] + Money.parse(invoice.amount)
+    return totals
