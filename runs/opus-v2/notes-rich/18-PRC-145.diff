+def upgrade_tier(customer_id):
+    """Move a standard customer to the gold tier and return the customer.
+
+    Error codes:
+    - E_NOT_FOUND: customer_id is not a str or no such customer exists.
+    - E_BAD_STATE: the customer is not on the standard tier (e.g. already gold).
+
+    Emits ``customer.tier_upgraded`` with ``from_tier``/``to_tier`` on success;
+    stores nothing and emits nothing on failure.
+    """
+    if not isinstance(customer_id, str) or customer_id not in db.customers:
+        raise DomainError("E_NOT_FOUND", repr(customer_id))
+    customer = db.customers[customer_id]
+    if customer.tier != "standard":
+        raise DomainError("E_BAD_STATE", f"customer {customer_id} is already {customer.tier}")
+    customer.tier = "gold"
+    events.emit("customer.tier_upgraded", customer.id, from_tier="standard", to_tier="gold")
+    return customer
 
 
