diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_customers_upgrade_tier.py b/tests/unit/test_customers_upgrade_tier.py
--- a/tests/unit/test_customers_upgrade_tier.py	1969-12-31 19:00:00
+++ b/tests/unit/test_customers_upgrade_tier.py	2026-11-12 02:14:41
@@ -0,0 +1,43 @@
+import pytest
+
+from parcelo import customers, events
+from parcelo.errors import DomainError
+from parcelo.store import db
+
+
+def test_upgrade_standard_to_gold():
+    c = customers.add_customer("Acme")
+    result = customers.upgrade_tier(c.id)
+    assert result is c
+    assert db.customers[c.id].tier == "gold"
+    assert len(events.OUTBOX) == 1
+    entry = events.OUTBOX[0]
+    assert entry["name"] == "customer.tier_upgraded"
+    assert entry["entity_id"] == c.id
+    assert entry["payload"] == {"from_tier": "standard", "to_tier": "gold"}
+
+
+@pytest.mark.parametrize("bad_id", ["nope", None, 123])
+def test_unknown_customer(bad_id):
+    with pytest.raises(DomainError) as err:
+        customers.upgrade_tier(bad_id)
+    assert err.value.code == "E_NOT_FOUND"
+    assert events.OUTBOX == []
+
+
+def test_already_gold_created_as_gold():
+    c = customers.add_customer("Acme", tier="gold")
+    with pytest.raises(DomainError) as err:
+        customers.upgrade_tier(c.id)
+    assert err.value.code == "E_BAD_STATE"
+    assert c.tier == "gold"
+    assert events.OUTBOX == []
+
+
+def test_upgrade_twice_fails():
+    c = customers.add_customer("Acme")
+    customers.upgrade_tier(c.id)
+    with pytest.raises(DomainError) as err:
+        customers.upgrade_tier(c.id)
+    assert err.value.code == "E_BAD_STATE"
+    assert len(events.OUTBOX) == 1
