diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_invoices_hold.py b/tests/unit/test_invoices_hold.py
--- a/tests/unit/test_invoices_hold.py	1969-12-31 19:00:00
+++ b/tests/unit/test_invoices_hold.py	2026-11-12 02:26:36
@@ -0,0 +1,65 @@
+from datetime import datetime, timezone
+
+import pytest
+
+from parcelo import clock, events, invoices
+from parcelo.errors import DomainError
+from parcelo.models import Invoice
+from parcelo.store import db
+
+MOMENT = datetime(2026, 11, 12, 9, 30, tzinfo=timezone.utc)
+
+
+def _seed(status="open"):
+    db.invoices["inv_1"] = Invoice(id="inv_1", shipment_id="shp_1", amount=10, status=status)
+    return db.invoices["inv_1"]
+
+
+def test_hold_open_invoice():
+    _seed()
+    clock.set_fixed(MOMENT)
+    events.OUTBOX.clear()
+    inv = invoices.hold_invoice("inv_1")
+    assert inv is db.invoices["inv_1"]
+    assert inv.status == "on_hold"
+    assert inv.held_at == MOMENT
+    assert [(e["name"], e["entity_id"]) for e in events.OUTBOX] == [("invoice.held", "inv_1")]
+
+
+def test_hold_twice_is_idempotent():
+    _seed()
+    clock.set_fixed(MOMENT)
+    events.OUTBOX.clear()
+    invoices.hold_invoice("inv_1")
+    clock.set_fixed(datetime(2026, 11, 13, tzinfo=timezone.utc))
+    inv = invoices.hold_invoice("inv_1")
+    assert inv.status == "on_hold"
+    assert inv.held_at == MOMENT
+    assert len(events.OUTBOX) == 1
+
+
+def test_already_on_hold_returns_unchanged():
+    inv = _seed("on_hold")
+    events.OUTBOX.clear()
+    assert invoices.hold_invoice("inv_1") is inv
+    assert inv.held_at is None
+    assert events.OUTBOX == []
+
+
+def test_missing_invoice():
+    events.OUTBOX.clear()
+    with pytest.raises(DomainError) as err:
+        invoices.hold_invoice("nope")
+    assert err.value.code == "E_NOT_FOUND"
+    assert events.OUTBOX == []
+
+
+def test_paid_invoice_cannot_be_held():
+    inv = _seed("paid")
+    events.OUTBOX.clear()
+    with pytest.raises(DomainError) as err:
+        invoices.hold_invoice("inv_1")
+    assert err.value.code == "E_BAD_STATE"
+    assert inv.status == "paid"
+    assert inv.held_at is None
+    assert events.OUTBOX == []
