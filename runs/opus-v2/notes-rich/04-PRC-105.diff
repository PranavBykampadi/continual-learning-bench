@@ -0,0 +1,103 @@
+from datetime import datetime, timezone
+from decimal import Decimal
+
+import pytest
+
+from parcelo import audit, clock, customers, invoices, refunds, shipments, store
+from parcelo.errors import DomainError
+from parcelo.models import Refund
+from parcelo.money import Money
+from parcelo.store import db
+
+MOMENT = datetime(2026, 11, 12, 9, 30, tzinfo=timezone.utc)
+
+
+def _issue(status):
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 2, "national")
+    inv = invoices.issue_invoice(s.id)
+    inv.status = status
+    return inv
+
+
+def test_create_refund_for_paid_invoice():
+    clock.set_fixed(MOMENT)
+    inv = _issue("paid")
+    refund = refunds.create_refund(inv.id, "5.25")
+    assert isinstance(refund, Refund)
+    assert refund.id.startswith("rfd_")
+    assert refund.invoice_id == inv.id
+    assert refund.amount == Money(525)
+    assert refund.created_at == MOMENT
+    assert db.refunds == {refund.id: refund}
+    assert audit.LOG[-1]["action"] == "refund.created"
+    assert audit.LOG[-1]["entity_id"] == refund.id
+    assert audit.LOG[-1]["details"] == {"invoice_id": inv.id, "amount": Money(525)}
+
+
+@pytest.mark.parametrize("amount", [5, 5.0, "5.00", Decimal("5"), Money(500)])
+def test_amount_types_become_money(amount):
+    inv = _issue("paid")
+    assert refunds.create_refund(inv.id, amount).amount == Money(500)
+
+
+def test_multiple_refunds_get_distinct_ids():
+    inv = _issue("paid")
+    r1 = refunds.create_refund(inv.id, 1)
+    r2 = refunds.create_refund(inv.id, 2)
+    assert r1.id != r2.id
+    assert len(db.refunds) == 2
+
+
+@pytest.mark.parametrize("invoice_id", ["nope", "", None])
+def test_unknown_invoice(invoice_id):
+    _issue("paid")
+    before = len(audit.LOG)
+    with pytest.raises(DomainError) as err:
+        refunds.create_refund(invoice_id, 5)
+    assert err.value.code == "E_NOT_FOUND"
+    assert db.refunds == {}
+    assert len(audit.LOG) == before
+
+
+@pytest.mark.parametrize("status", ["open", "void"])
+def test_unpaid_invoice_rejected(status):
+    inv = _issue(status)
+    before = len(audit.LOG)
+    with pytest.raises(DomainError) as err:
+        refunds.create_refund(inv.id, 5)
+    assert err.value.code == "E_BAD_STATE"
+    assert db.refunds == {}
+    assert len(audit.LOG) == before
+
+
+@pytest.mark.parametrize("amount", [0, -1, "0.001", None, "abc", True])
+def test_bad_amount_rejected(amount):
+    inv = _issue("paid")
+    before = len(audit.LOG)
+    with pytest.raises(DomainError) as err:
+        refunds.create_refund(inv.id, amount)
+    assert err.value.code == "E_BAD_INPUT"
+    assert db.refunds == {}
+    assert len(audit.LOG) == before
+
+
