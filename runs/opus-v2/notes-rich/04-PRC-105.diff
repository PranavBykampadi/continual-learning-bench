@@ -0,0 +1,47 @@
+from parcelo import audit, clock, ids
+from parcelo.errors import DomainError
+from parcelo.models import Refund
+from parcelo.money import Money
+from parcelo.store import db
+
+
+def _get_invoice(invoice_id):
+    if invoice_id not in db.invoices:
+        raise DomainError("E_NOT_FOUND", str(invoice_id))
+    return db.invoices[invoice_id]
+
+
+def _to_money(amount):
+    if amount is None or isinstance(amount, bool):
+        raise DomainError("E_BAD_INPUT", f"invalid refund amount {amount!r}")
+    try:
+        money = Money.parse(amount)
+    except Exception:
+        raise DomainError("E_BAD_INPUT", f"invalid refund amount {amount!r}") from None
+    if money.cents <= 0:
+        raise DomainError("E_BAD_INPUT", f"refund amount must be positive: {amount!r}")
+    return money
+
+
+def create_refund(invoice_id, amount):
+    invoice = _get_invoice(invoice_id)
+    if invoice.status != "paid":
+        raise DomainError(
+            "E_BAD_STATE", f"invoice {invoice_id} is {invoice.status}, not paid"
+        )
+    money = _to_money(amount)
+    refund = Refund(
+        id=ids.new_id("rfd"),
+        invoice_id=invoice_id,
+        amount=money,
+        created_at=clock.now(),
+    )
+    db.refunds[refund.id] = refund
+    audit.record("refund.created", refund.id, invoice_id=invoice_id, amount=money)
+    return refund
+
+
+def get_refund(refund_id):
+    if refund_id not in db.refunds:
+        raise DomainError("E_NOT_FOUND", str(refund_id))
+    return db.refunds[refund_id]
