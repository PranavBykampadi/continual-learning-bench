@@ -28,3 +28,22 @@
     if shipment_id not in db.shipments:
         raise DomainError("E_NOT_FOUND", shipment_id)
     return db.shipments[shipment_id]
+
+
+def add_note(shipment_id, text):
+    """Append a timestamped note to a shipment and return the shipment.
+
+    The note is stored as ``{"text": <trimmed text>, "at": clock.now()}``.
+    Raises ``E_NOT_FOUND`` for an unknown/invalid shipment id and
+    ``E_BAD_INPUT`` for text that is not a non-blank string. On failure the
+    shipment and audit log are left unchanged.
+    """
+    if not isinstance(shipment_id, str) or shipment_id not in db.shipments:
+        raise DomainError("E_NOT_FOUND", str(shipment_id))
+    if not isinstance(text, str) or not text.strip():
+        raise DomainError("E_BAD_INPUT", "note text required")
+    shipment = db.shipments[shipment_id]
+    note = {"text": text.strip(), "at": clock.now()}
+    shipment.notes.append(note)
+    audit.record("shipment.note_added", shipment.id, text=note["text"])
+    return shipment
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_shipments_notes.py b/tests/unit/test_shipments_notes.py
--- a/tests/unit/test_shipments_notes.py	1969-12-31 19:00:00
+++ b/tests/unit/test_shipments_notes.py	2026-11-12 02:03:43
@@ -0,0 +1,88 @@
+from datetime import datetime, timedelta, timezone
+
+import pytest
+
+from parcelo import audit, clock, customers, shipments
+from parcelo.errors import DomainError
+from parcelo.models import Shipment
+from parcelo.store import db
+
+NOW = datetime(2026, 11, 12, 9, 0, tzinfo=timezone.utc)
+
+
+def _shipment():
+    c = customers.add_customer("Acme")
+    return shipments.create_shipment(c.id, 2.0, "local")
+
+
+def test_add_note_appends_text_and_time():
+    clock.set_fixed(NOW)
+    s = _shipment()
+    result = shipments.add_note(s.id, "Left at front desk")
+    assert isinstance(result, Shipment)
+    assert result is s
+    assert s.notes == [{"text": "Left at front desk", "at": NOW}]
+
+
+def test_each_note_gets_its_own_time_in_order():
+    clock.set_fixed(NOW)
+    s = _shipment()
+    shipments.add_note(s.id, "first")
+    clock.set_fixed(NOW + timedelta(minutes=30))
+    shipments.add_note(s.id, "second")
+    assert s.notes == [
+        {"text": "first", "at": NOW},
+        {"text": "second", "at": NOW + timedelta(minutes=30)},
+    ]
+
+
+def test_add_note_trims_text():
+    s = _shipment()
+    shipments.add_note(s.id, "  fragile  ")
+    assert s.notes[-1]["text"] == "fragile"
+
+
+def test_add_note_records_audit():
+    clock.set_fixed(NOW)
+    s = _shipment()
+    shipments.add_note(s.id, "call recipient")
+    entry = audit.LOG[-1]
+    assert entry["action"] == "shipment.note_added"
+    assert entry["entity_id"] == s.id
+    assert entry["details"] == {"text": "call recipient"}
+
+
+def test_notes_do_not_leak_between_shipments():
+    a = _shipment()
+    b = _shipment()
+    shipments.add_note(a.id, "only on a")
+    assert b.notes == []
+
+
+@pytest.mark.parametrize("bad_id", ["nope", "", None, 123, []])
+def test_unknown_shipment_fails(bad_id):
+    _shipment()
+    before = len(audit.LOG)
+    with pytest.raises(DomainError) as err:
+        shipments.add_note(bad_id, "hello")
+    assert err.value.code == "E_NOT_FOUND"
+    assert len(audit.LOG) == before
+
+
+def test_orphaned_shipment_fails():
+    s = _shipment()
+    del db.shipments[s.id]
+    with pytest.raises(DomainError) as err:
+        shipments.add_note(s.id, "hello")
+    assert err.value.code == "E_NOT_FOUND"
+
+
+@pytest.mark.parametrize("bad_text", ["", "   ", None, 123, []])
+def test_bad_text_fails_and_leaves_shipment_unchanged(bad_text):
+    s = _shipment()
+    before = len(audit.LOG)
+    with pytest.raises(DomainError) as err:
+        shipments.add_note(s.id, bad_text)
+    assert err.value.code == "E_BAD_INPUT"
+    assert s.notes == []
+    assert len(audit.LOG) == before
