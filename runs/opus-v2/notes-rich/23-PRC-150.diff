+def set_credit_limit(customer_id, amount):
+    """Set a customer's credit limit and return it as Money.
+
+    `amount` may be Money or a dollar amount (int, float, str, Decimal).
+    """
+    if customer_id not in db.customers:
+        raise DomainError("E_NOT_FOUND", customer_id)
+    if isinstance(amount, bool) or not isinstance(amount, (Money, int, float, str, Decimal)):
+        raise DomainError("E_BAD_INPUT", repr(amount))
+    try:
+        limit = Money.parse(amount)
+    except (InvalidOperation, ValueError):
+        raise DomainError("E_BAD_INPUT", repr(amount))
+    if limit.cents < 0:
+        raise DomainError("E_BAD_INPUT", "credit limit must not be negative")
+    customer = db.customers[customer_id]
+    previous = Money.parse(customer.credit_limit)
+    customer.credit_limit = limit
+    events.emit(
+        "customer.credit_limit_changed",
+        customer_id,
+        from_credit_limit_cents=previous.cents,
+        to_credit_limit_cents=limit.cents,
+    )
+    return limit
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_customers_credit_limit.py b/tests/unit/test_customers_credit_limit.py
--- a/tests/unit/test_customers_credit_limit.py	1969-12-31 19:00:00
+++ b/tests/unit/test_customers_credit_limit.py	2026-11-12 02:20:31
@@ -0,0 +1,81 @@
+from datetime import datetime, timezone
+from decimal import Decimal
+
+import pytest
+
+from parcelo import clock, customers, events
+from parcelo.errors import DomainError
+from parcelo.models import Customer
+from parcelo.money import Money
+from parcelo.store import db
+
+AT = datetime(2026, 11, 12, 9, 30, tzinfo=timezone.utc)
+
+
+@pytest.fixture
+def cust():
+    clock.set_fixed(AT)
+    c = Customer(id="cus_000001", name="Acme")
+    db.customers[c.id] = c
+    return c
+
+
+def test_sets_limit_returns_money_and_emits_event(cust):
+    result = customers.set_credit_limit(cust.id, Money(125050))
+    assert result == Money(125050)
+    assert db.customers[cust.id].credit_limit == Money(125050)
+    assert events.OUTBOX == [
+        {
+            "name": "customer.credit_limit_changed",
+            "entity_id": cust.id,
+            "at": AT,
+            "payload": {"from_credit_limit_cents": 50000, "to_credit_limit_cents": 125050},
+        }
+    ]
+
+
+@pytest.mark.parametrize(
+    "amount, cents",
+    [(750.25, 75025), (300, 30000), ("12.5", 1250), (Decimal("0.01"), 1)],
+)
+def test_accepts_legacy_dollar_amounts(cust, amount, cents):
+    assert customers.set_credit_limit(cust.id, amount) == Money(cents)
+
+
+def test_zero_is_allowed(cust):
+    assert customers.set_credit_limit(cust.id, 0) == Money(0)
+
+
+def test_second_change_reports_previous_money_limit(cust):
+    customers.set_credit_limit(cust.id, Money(1000))
+    customers.set_credit_limit(cust.id, Money(2000))
+    assert len(events.OUTBOX) == 2
+    assert events.OUTBOX[1]["payload"] == {
+        "from_credit_limit_cents": 1000,
+        "to_credit_limit_cents": 2000,
+    }
+
+
+def test_unknown_customer(cust):
+    with pytest.raises(DomainError) as err:
+        customers.set_credit_limit("cus_999999", Money(100))
+    assert err.value.code == "E_NOT_FOUND"
+    assert events.OUTBOX == []
+
+
+@pytest.mark.parametrize("amount", [Money(-1), -0.01, "-5"])
+def test_negative_rejected(cust, amount):
+    with pytest.raises(DomainError) as err:
+        customers.set_credit_limit(cust.id, amount)
+    assert err.value.code == "E_BAD_INPUT"
+    assert cust.credit_limit == 500.0
+    assert events.OUTBOX == []
+
+
+@pytest.mark.parametrize("amount", [None, True, "abc", float("nan"), float("inf"), [1]])
+def test_bad_amount_rejected(cust, amount):
+    with pytest.raises(DomainError) as err:
+        customers.set_credit_limit(cust.id, amount)
+    assert err.value.code == "E_BAD_INPUT"
+    assert cust.credit_limit == 500.0
+    assert events.OUTBOX == []
