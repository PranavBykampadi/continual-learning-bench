+
+
+DELIVERED_STATUS = "delivered"
+
+
+def _is_delivered(shipment):
+    return shipment.status == DELIVERED_STATUS or shipment.delivered_at is not None
+
+
+def reassign_shipment(shipment_id, new_customer_id):
+    """Move a shipment to another customer and return it.
+
+    Raises DomainError with:
+    - E_NOT_FOUND: the shipment does not exist (including non-str ids).
+    - E_UNKNOWN_CUSTOMER: the new customer does not exist.
+    - E_BAD_STATE: the shipment has already been delivered.
+    Nothing is changed or audited on failure.
+    """
+    if not isinstance(shipment_id, str) or shipment_id not in db.shipments:
+        raise DomainError("E_NOT_FOUND", str(shipment_id))
+    if not isinstance(new_customer_id, str) or new_customer_id not in db.customers:
+        raise DomainError("E_UNKNOWN_CUSTOMER", str(new_customer_id))
+    shipment = db.shipments[shipment_id]
+    if _is_delivered(shipment):
+        raise DomainError("E_BAD_STATE", f"shipment {shipment_id} already delivered")
+    old_customer_id = shipment.customer_id
+    shipment.customer_id = new_customer_id
+    audit.record(
+        "shipment.reassigned",
+        shipment.id,
+        from_customer_id=old_customer_id,
+        to_customer_id=new_customer_id,
+    )
+    return shipment
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_shipments_reassign.py b/tests/unit/test_shipments_reassign.py
--- a/tests/unit/test_shipments_reassign.py	1969-12-31 19:00:00
+++ b/tests/unit/test_shipments_reassign.py	2026-11-12 02:09:18
@@ -0,0 +1,83 @@
+from datetime import datetime, timezone
+
+import pytest
+
+from parcelo import audit, clock, customers, invoices, shipments
+from parcelo.errors import DomainError
+from parcelo.store import db
+
+NOW = datetime(2026, 11, 12, 12, 0, tzinfo=timezone.utc)
+
+
+def _setup():
+    a = customers.add_customer("Acme")
+    b = customers.add_customer("Beta")
+    s = shipments.create_shipment(a.id, 2, "local")
+    return a, b, s
+
+
+def test_reassign_changes_customer_and_returns_shipment():
+    clock.set_fixed(NOW)
+    a, b, s = _setup()
+    result = shipments.reassign_shipment(s.id, b.id)
+    assert result is s
+    assert s.customer_id == b.id
+    assert db.shipments[s.id].customer_id == b.id
+    assert audit.LOG[-1] == {
+        "action": "shipment.reassigned",
+        "entity_id": s.id,
+        "at": NOW,
+        "details": {"from_customer_id": a.id, "to_customer_id": b.id},
+    }
+
+
+def test_reassign_moves_outstanding_balance():
+    a, b, s = _setup()
+    invoices.issue_invoice(s.id)
+    before = customers.outstanding_balance(a.id)
+    assert before > 0
+    shipments.reassign_shipment(s.id, b.id)
+    assert customers.outstanding_balance(a.id) == 0
+    assert customers.outstanding_balance(b.id) == before
+
+
+@pytest.mark.parametrize("bad_id", ["nope", "", None, 123, []])
+def test_unknown_shipment(bad_id):
+    _, b, _ = _setup()
+    n = len(audit.LOG)
+    with pytest.raises(DomainError) as err:
+        shipments.reassign_shipment(bad_id, b.id)
+    assert err.value.code == "E_NOT_FOUND"
+    assert len(audit.LOG) == n
+
+
+@pytest.mark.parametrize("bad_id", ["nope", "", None, 123, []])
+def test_unknown_customer(bad_id):
+    a, _, s = _setup()
+    n = len(audit.LOG)
+    with pytest.raises(DomainError) as err:
+        shipments.reassign_shipment(s.id, bad_id)
+    assert err.value.code == "E_UNKNOWN_CUSTOMER"
+    assert s.customer_id == a.id
+    assert len(audit.LOG) == n
+
+
+def test_shipment_checked_before_customer():
+    with pytest.raises(DomainError) as err:
+        shipments.reassign_shipment("nope", "nope")
+    assert err.value.code == "E_NOT_FOUND"
+
+
+@pytest.mark.parametrize("mark", ["status", "delivered_at"])
+def test_delivered_shipment_rejected(mark):
+    a, b, s = _setup()
+    if mark == "status":
+        s.status = "delivered"
+    else:
+        s.delivered_at = NOW
+    n = len(audit.LOG)
+    with pytest.raises(DomainError) as err:
+        shipments.reassign_shipment(s.id, b.id)
+    assert err.value.code == "E_BAD_STATE"
+    assert s.customer_id == a.id
+    assert len(audit.LOG) == n
