+def customers_by_tier(tier):
+    if tier not in TIERS:
+        raise DomainError("E_BAD_INPUT", tier)
+    matches = [c for c in db.customers.values() if c.tier == tier]
+    return sorted(matches, key=lambda c: c.id)
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_customers_by_tier.py b/tests/unit/test_customers_by_tier.py
--- a/tests/unit/test_customers_by_tier.py	1969-12-31 19:00:00
+++ b/tests/unit/test_customers_by_tier.py	2026-11-12 02:24:52
@@ -0,0 +1,34 @@
+import pytest
+
+from parcelo import customers, events
+from parcelo.errors import DomainError
+from parcelo.models import Customer
+from parcelo.store import db
+
+
+def _put(cid, tier):
+    db.customers[cid] = Customer(id=cid, name=cid, tier=tier)
+
+
+def test_returns_matching_tier_sorted_by_id():
+    _put("c3", "gold")
+    _put("c1", "gold")
+    _put("c2", "standard")
+    events.OUTBOX.clear()
+    result = customers.customers_by_tier("gold")
+    assert [c.id for c in result] == ["c1", "c3"]
+    assert [c.id for c in customers.customers_by_tier("standard")] == ["c2"]
+    assert events.OUTBOX == []
+
+
+def test_empty_when_no_customers_on_tier():
+    _put("c1", "standard")
+    events.OUTBOX.clear()
+    assert customers.customers_by_tier("gold") == []
+
+
+def test_unknown_tier_fails():
+    events.OUTBOX.clear()
+    with pytest.raises(DomainError) as err:
+        customers.customers_by_tier("platinum")
+    assert err.value.code == "E_BAD_INPUT"
