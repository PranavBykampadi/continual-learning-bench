diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_rates_heavy_quote.py b/tests/unit/test_rates_heavy_quote.py
--- a/tests/unit/test_rates_heavy_quote.py	1969-12-31 19:00:00
+++ b/tests/unit/test_rates_heavy_quote.py	2026-11-12 02:25:37
@@ -0,0 +1,39 @@
+import pytest
+
+from parcelo import events, rates
+from parcelo.errors import DomainError
+from parcelo.money import Money
+
+
+def test_at_threshold_is_normal_quote():
+    events.OUTBOX.clear()
+    # 9.0 + 1.25 * 30 = 46.50
+    assert rates.heavy_quote(30, "national") == Money(4650)
+    assert events.OUTBOX == []
+
+
+def test_below_threshold_is_normal_quote():
+    assert rates.heavy_quote(2, "local") == Money(700)
+
+
+def test_above_threshold_adds_surcharge():
+    # 4.5 + 1.25 * 32 = 44.50, plus 0.75 * 2 = 1.50
+    assert rates.heavy_quote(32, "local") == Money(4600)
+
+
+def test_fractional_excess():
+    # 4.5 + 1.25 * 30.5 = 42.62 (existing quote rounding), plus 0.75 * 0.5 = 0.375 -> 0.38
+    assert rates.heavy_quote(30.5, "local") == Money(4300)
+
+
+def test_unknown_zone():
+    with pytest.raises(DomainError) as err:
+        rates.heavy_quote(40, "moon")
+    assert err.value.code == "E_BAD_ZONE"
+
+
+@pytest.mark.parametrize("weight", [0, -1])
+def test_non_positive_weight(weight):
+    with pytest.raises(DomainError) as err:
+        rates.heavy_quote(weight, "local")
+    assert err.value.code == "E_BAD_WEIGHT"
