+from parcelo.settings import HEAVY_SURCHARGE_PER_KG, HEAVY_THRESHOLD_KG
+
 ZONE_BASE = {"local": 4.5, "national": 9.0, "international": 24.0}
 PER_KG = 1.25
 
@@ -12,3 +18,16 @@
     if weight_kg <= 0:
         raise ValueError("weight must be positive")
     return round(base_rate(zone) + PER_KG * weight_kg, 2)
+
+
+def heavy_quote(weight_kg, zone):
+    """Normal quote plus a surcharge per kg above HEAVY_THRESHOLD_KG, as Money."""
+    if zone not in ZONE_BASE:
+        raise DomainError("E_BAD_ZONE", zone)
+    if weight_kg <= 0:
+        raise DomainError("E_BAD_WEIGHT", str(weight_kg))
+    price = Money.parse(quote(weight_kg, zone))
+    excess = Decimal(str(weight_kg)) - Decimal(str(HEAVY_THRESHOLD_KG))
+    if excess > 0:
+        price = price + Money.parse(HEAVY_SURCHARGE_PER_KG).scale(excess)
+    return price
