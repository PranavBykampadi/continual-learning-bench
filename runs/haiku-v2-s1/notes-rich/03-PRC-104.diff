diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_customer_deactivate.py b/tests/unit/test_customer_deactivate.py
--- a/tests/unit/test_customer_deactivate.py	1969-12-31 19:00:00
+++ b/tests/unit/test_customer_deactivate.py	2026-11-12 01:54:36
@@ -0,0 +1,42 @@
+import pytest
+
+from parcelo import audit, customers
+from parcelo.errors import DomainError
+from parcelo.store import db
+
+
+def _make_customer(name="Acme"):
+    return customers.add_customer(name)
+
+
+def test_deactivate_sets_inactive_and_returns_customer():
+    c = _make_customer()
+    result = customers.deactivate_customer(c.id)
+    assert result is c
+    assert c.active is False
+    assert db.customers[c.id].active is False
+
+
+def test_deactivate_records_audit():
+    c = _make_customer()
+    customers.deactivate_customer(c.id)
+    assert audit.LOG[-1]["action"] == "customer.deactivated"
+    assert audit.LOG[-1]["entity_id"] == c.id
+
+
+def test_deactivate_unknown_customer_fails():
+    with pytest.raises(DomainError) as err:
+        customers.deactivate_customer("C-missing")
+    assert err.value.code == "E_NOT_FOUND"
+    assert audit.LOG == []
+
+
+def test_deactivate_already_inactive_fails_and_is_unchanged():
+    c = _make_customer()
+    customers.deactivate_customer(c.id)
+    audit.LOG.clear()
+    with pytest.raises(DomainError) as err:
+        customers.deactivate_customer(c.id)
+    assert err.value.code == "E_BAD_STATE"
+    assert c.active is False
+    assert audit.LOG == []
