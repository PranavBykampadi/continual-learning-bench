diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_reactivate_customer.py b/tests/unit/test_reactivate_customer.py
--- a/tests/unit/test_reactivate_customer.py	1969-12-31 19:00:00
+++ b/tests/unit/test_reactivate_customer.py	2026-11-12 02:13:45
@@ -0,0 +1,53 @@
+import pytest
+
+from parcelo import customers, events
+from parcelo.errors import DomainError
+from parcelo.store import db
+
+
+def _deactivate(customer_id):
+    db.customers[customer_id].active = False
+
+
+def test_reactivate_sets_active_and_returns_customer():
+    c = customers.add_customer("Acme")
+    _deactivate(c.id)
+    result = customers.reactivate_customer(c.id)
+    assert result is c
+    assert c.active is True
+
+
+def test_reactivate_emits_event_with_customer_id():
+    c = customers.add_customer("Acme")
+    _deactivate(c.id)
+    events.OUTBOX.clear()
+    customers.reactivate_customer(c.id)
+    assert len(events.OUTBOX) == 1
+    assert events.OUTBOX[-1]["name"] == "customer.reactivated"
+    assert events.OUTBOX[-1]["entity_id"] == c.id
+
+
+def test_reactivate_already_active_is_noop():
+    c = customers.add_customer("Acme")
+    events.OUTBOX.clear()
+    result = customers.reactivate_customer(c.id)
+    assert result is c
+    assert c.active is True
+    assert events.OUTBOX == []
+
+
+def test_reactivate_is_idempotent_on_retry():
+    c = customers.add_customer("Acme")
+    _deactivate(c.id)
+    customers.reactivate_customer(c.id)
+    events.OUTBOX.clear()
+    customers.reactivate_customer(c.id)
+    assert c.active is True
+    assert events.OUTBOX == []
+
+
+def test_reactivate_unknown_customer_raises_not_found():
+    with pytest.raises(DomainError) as err:
+        customers.reactivate_customer("C_missing")
+    assert err.value.code == "E_NOT_FOUND"
+    assert events.OUTBOX == []
