diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/parcelo/shipments.py b/parcelo/shipments.py
--- a/parcelo/shipments.py	2026-11-10 12:20:18
+++ b/parcelo/shipments.py	2026-11-12 02:19:42
@@ -28,3 +28,21 @@
     if shipment_id not in db.shipments:
         raise DomainError("E_NOT_FOUND", shipment_id)
     return db.shipments[shipment_id]
+
+
+def mark_returned(shipment_id):
+    """Record that a delivered parcel came back to the depot.
+
+    Idempotent: an already-returned shipment is returned unchanged, with no
+    write and no event. A shipment still in "created" status cannot be
+    returned and raises E_BAD_STATE.
+    """
+    shipment = get_shipment(shipment_id)
+    if shipment.status == "returned":
+        return shipment
+    if shipment.status == "created":
+        raise DomainError("E_BAD_STATE", shipment_id)
+    shipment.status = "returned"
+    shipment.returned_at = clock.now()
+    events.emit("shipment.returned", shipment.id)
+    return shipment
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_mark_returned.py b/tests/unit/test_mark_returned.py
--- a/tests/unit/test_mark_returned.py	1969-12-31 19:00:00
+++ b/tests/unit/test_mark_returned.py	2026-11-12 02:19:46
@@ -0,0 +1,61 @@
+import pytest
+
+from parcelo import clock, customers, events, shipments
+from parcelo.errors import DomainError
+from parcelo.store import db
+
+
+def _delivered_shipment():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 2.0, "national")
+    s.status = "delivered"
+    return s
+
+
+def test_mark_returned_sets_status_and_timestamp():
+    moment = clock.now()
+    clock.set_fixed(moment)
+    s = _delivered_shipment()
+    result = shipments.mark_returned(s.id)
+    assert result is s
+    assert s.status == "returned"
+    assert s.returned_at == moment
+
+
+def test_mark_returned_emits_event():
+    s = _delivered_shipment()
+    events.OUTBOX.clear()
+    shipments.mark_returned(s.id)
+    assert len(events.OUTBOX) == 1
+    assert events.OUTBOX[-1]["name"] == "shipment.returned"
+    assert events.OUTBOX[-1]["entity_id"] == s.id
+
+
+def test_mark_returned_is_idempotent():
+    s = _delivered_shipment()
+    shipments.mark_returned(s.id)
+    first_at = s.returned_at
+    events.OUTBOX.clear()
+    again = shipments.mark_returned(s.id)
+    assert again is s
+    assert again.returned_at == first_at
+    assert events.OUTBOX == []
+
+
+def test_created_shipment_cannot_be_returned():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 2.0, "national")
+    events.OUTBOX.clear()
+    with pytest.raises(DomainError) as err:
+        shipments.mark_returned(s.id)
+    assert err.value.code == "E_BAD_STATE"
+    assert s.status == "created"
+    assert s.returned_at is None
+    assert events.OUTBOX == []
+
+
+def test_missing_shipment_fails():
+    with pytest.raises(DomainError) as err:
+        shipments.mark_returned("shp_does_not_exist")
+    assert err.value.code == "E_NOT_FOUND"
+    assert "shp_does_not_exist" not in db.shipments
