+
+def heavy_quote(weight_kg, zone):
+    """Quote for a parcel, plus a surcharge for every kg above HEAVY_THRESHOLD_KG.
+
+    Returns Money. Raises DomainError("E_BAD_ZONE") for an unknown zone and
+    DomainError("E_BAD_WEIGHT") for a weight that is not positive.
+    """
+    if zone not in ZONE_BASE:
+        raise DomainError("E_BAD_ZONE", zone)
+    if not weight_kg > 0:  # written this way so NaN is rejected too
+        raise DomainError("E_BAD_WEIGHT", weight_kg)
+    # quote() returns a legacy float; wrap it straight away so the rest is Money.
+    total = Money.parse(quote(weight_kg, zone))
+    excess_kg = weight_kg - HEAVY_THRESHOLD_KG
+    if excess_kg > 0:
+        total = total + Money.parse(HEAVY_SURCHARGE_PER_KG).scale(excess_kg)
+    return total
