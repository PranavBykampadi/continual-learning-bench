@@ -0,0 +1,5 @@
+"""Business thresholds, limits and rates. Import these where used; no bare numbers in logic."""
+
+# Heavy-parcel surcharge (PRC-156): parcels above this weight pay a per-kg surcharge.
+HEAVY_THRESHOLD_KG = 30
+HEAVY_SURCHARGE_PER_KG = "0.75"  # dollars per kg above the threshold; string keeps it exact for Money
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_heavy_quote.py b/tests/unit/test_heavy_quote.py
--- a/tests/unit/test_heavy_quote.py	1969-12-31 19:00:00
+++ b/tests/unit/test_heavy_quote.py	2026-11-12 02:15:57
@@ -0,0 +1,41 @@
+import pytest
+
+from parcelo import rates
+from parcelo.errors import DomainError
+from parcelo.money import Money
+
+
+def test_at_threshold_is_normal_quote():
+    assert rates.heavy_quote(30, "local") == Money.parse(rates.quote(30, "local"))
+
+
+def test_below_threshold_is_normal_quote():
+    assert rates.heavy_quote(2, "local") == Money.parse(7.0)
+
+
+def test_surcharge_per_kg_above_threshold():
+    # 35 kg local: quote 4.5 + 1.25*35 = 48.25, plus 5 kg * 0.75 = 3.75
+    assert rates.heavy_quote(35, "local") == Money.parse(52.0)
+
+
+def test_fractional_excess_rounds_half_up():
+    # 31.5 kg national: quote 9.0 + 1.25*31.5 = 48.375 -> 48.38;
+    # 1.5 kg * 0.75 = 1.125 -> 1.13; total 49.51
+    assert rates.heavy_quote(31.5, "national") == Money.parse(49.51)
+
+
+def test_returns_money():
+    assert isinstance(rates.heavy_quote(40, "international"), Money)
+
+
+def test_unknown_zone():
+    with pytest.raises(DomainError) as err:
+        rates.heavy_quote(35, "moon")
+    assert err.value.code == "E_BAD_ZONE"
+
+
+@pytest.mark.parametrize("weight", [0, -1, float("nan")])
+def test_weight_not_positive(weight):
+    with pytest.raises(DomainError) as err:
+        rates.heavy_quote(weight, "local")
+    assert err.value.code == "E_BAD_WEIGHT"
