+from datetime import datetime, timezone
 
+from parcelo import clock
+from parcelo.legacy.billing import days_between
+from parcelo.money import Money
 from parcelo.store import db
+
+
+def _as_utc(moment):
+    # issue_invoice stores naive UTC datetimes; clock.now() is tz-aware.
+    if moment.tzinfo is None:
+        return moment.replace(tzinfo=timezone.utc)
+    return moment.astimezone(timezone.utc)
+
+
+def aging_report():
+    """Totals of open invoices by age in whole days since issue.
+
+    Buckets: "0-30" (0 to 30 days), "31-60" (31 to 60 days), "60+" (more than 60).
+    Values are Money, so no float money leaves this function.
+    """
+    now = _as_utc(clock.now())
+    report = {"0-30": Money.zero(), "31-60": Money.zero(), "60+": Money.zero()}
+    for invoice in db.invoices.values():
+        if invoice.status != "open":
+            continue
+        age = days_between(_as_utc(invoice.issued_at), now)
+        if age <= 30:
+            bucket = "0-30"
+        elif age <= 60:
+            bucket = "31-60"
+        else:
+            bucket = "60+"
+        report[bucket] = report[bucket] + Money.parse(invoice.amount)
+    return report
 
 
