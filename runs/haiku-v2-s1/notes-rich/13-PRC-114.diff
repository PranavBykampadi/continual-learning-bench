diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_aging_report.py b/tests/unit/test_aging_report.py
--- a/tests/unit/test_aging_report.py	1969-12-31 19:00:00
+++ b/tests/unit/test_aging_report.py	2026-11-12 02:03:09
@@ -0,0 +1,54 @@
+from datetime import datetime, timedelta, timezone
+
+from parcelo import clock, customers, invoices, reports, shipments
+from parcelo.money import Money
+
+NOW = datetime(2026, 11, 12, 12, 0, 0, tzinfo=timezone.utc)
+
+
+def _invoice_issued_days_ago(days, amount_zone="local"):
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 2, amount_zone)
+    inv = invoices.issue_invoice(s.id)
+    inv.issued_at = (NOW - timedelta(days=days)).replace(tzinfo=None)  # naive UTC, as stored
+    return inv
+
+
+def test_empty_report_is_zero_in_every_bucket():
+    clock.set_fixed(NOW)
+    report = reports.aging_report()
+    assert report == {"0-30": Money.zero(), "31-60": Money.zero(), "60+": Money.zero()}
+
+
+def test_buckets_split_on_boundaries():
+    clock.set_fixed(NOW)
+    _invoice_issued_days_ago(0)
+    _invoice_issued_days_ago(30)
+    _invoice_issued_days_ago(31)
+    _invoice_issued_days_ago(60)
+    _invoice_issued_days_ago(61)
+    report = reports.aging_report()
+    # quote(2, "local") is 7.00 USD, so each bucket with two invoices totals 14.00.
+    assert report["0-30"] == Money.parse(14.0)
+    assert report["31-60"] == Money.parse(14.0)
+    assert report["60+"] == Money.parse(7.0)
+
+
+def test_paid_and_void_invoices_are_excluded():
+    clock.set_fixed(NOW)
+    paid = _invoice_issued_days_ago(5)
+    paid.status = "paid"
+    void = _invoice_issued_days_ago(5)
+    void.status = "void"
+    _invoice_issued_days_ago(5)
+    report = reports.aging_report()
+    assert report["0-30"] == Money.parse(7.0)
+    assert report["31-60"] == Money.zero()
+    assert report["60+"] == Money.zero()
+
+
+def test_values_are_money_not_floats():
+    clock.set_fixed(NOW)
+    _invoice_issued_days_ago(10)
+    report = reports.aging_report()
+    assert all(isinstance(v, Money) for v in report.values())
