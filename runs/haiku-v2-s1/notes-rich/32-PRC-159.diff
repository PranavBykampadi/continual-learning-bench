+
+def shipments_in_zone(zone):
+    if zone not in ZONE_BASE:
+        raise DomainError("E_BAD_INPUT", zone)
+    matches = [s for s in db.shipments.values() if s.zone == zone]
+    return sorted(matches, key=lambda x: x.id)
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_shipments_in_zone.py b/tests/unit/test_shipments_in_zone.py
--- a/tests/unit/test_shipments_in_zone.py	1969-12-31 19:00:00
+++ b/tests/unit/test_shipments_in_zone.py	2026-11-12 02:19:02
@@ -0,0 +1,45 @@
+import pytest
+
+from parcelo import customers, events, shipments
+from parcelo.errors import DomainError
+
+
+def test_returns_only_shipments_in_zone():
+    c = customers.add_customer("Acme")
+    local = shipments.create_shipment(c.id, 1.0, "local")
+    national = shipments.create_shipment(c.id, 2.0, "national")
+    other_local = shipments.create_shipment(c.id, 3.0, "local")
+
+    result = shipments.shipments_in_zone("local")
+
+    assert [s.id for s in result] == sorted([local.id, other_local.id])
+    assert all(s.zone == "local" for s in result)
+    assert national not in result
+
+
+def test_empty_list_when_no_shipments_in_zone():
+    c = customers.add_customer("Acme")
+    shipments.create_shipment(c.id, 1.0, "local")
+
+    assert shipments.shipments_in_zone("international") == []
+
+
+def test_empty_list_when_no_shipments_at_all():
+    assert shipments.shipments_in_zone("national") == []
+
+
+def test_unknown_zone_raises_bad_input():
+    with pytest.raises(DomainError) as err:
+        shipments.shipments_in_zone("mars")
+    assert err.value.code == "E_BAD_INPUT"
+    assert err.value.message == "mars"
+
+
+def test_read_only_emits_no_events():
+    c = customers.add_customer("Acme")
+    shipments.create_shipment(c.id, 1.0, "local")
+    before = len(events.OUTBOX)
+
+    shipments.shipments_in_zone("local")
+
+    assert len(events.OUTBOX) == before
