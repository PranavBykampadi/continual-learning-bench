@@ -1,6 +1,8 @@
+from datetime import datetime, timezone
+
 import pytest
 
-from parcelo import audit, customers, shipments
+from parcelo import audit, clock, customers, shipments
 from parcelo.errors import DomainError
 
 
@@ -15,3 +17,41 @@
     with pytest.raises(DomainError) as err:
         shipments.create_shipment("nope", 1, "local")
     assert err.value.code == "E_UNKNOWN_CUSTOMER"
+
+
+def test_add_note_appends_timestamped_text():
+    fixed = datetime(2026, 11, 12, 9, 30, tzinfo=timezone.utc)
+    clock.set_fixed(fixed)
+    try:
+        c = customers.add_customer("Acme")
+        s = shipments.create_shipment(c.id, 1.5, "national")
+        result = shipments.add_note(s.id, "  left at front desk  ")
+    finally:
+        clock.clear_fixed()
+    assert result is s
+    assert s.notes == [{"text": "left at front desk", "at": fixed}]
+    assert audit.LOG[-1]["action"] == "shipment.note_added"
+
+
+def test_add_note_keeps_order():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 1.5, "local")
+    shipments.add_note(s.id, "first")
+    shipments.add_note(s.id, "second")
+    assert [n["text"] for n in s.notes] == ["first", "second"]
+
+
+def test_add_note_unknown_shipment():
+    with pytest.raises(DomainError) as err:
+        shipments.add_note("shp_missing", "hello")
+    assert err.value.code == "E_NOT_FOUND"
+
+
+@pytest.mark.parametrize("text", ["", "   ", None])
+def test_add_note_rejects_blank_text(text):
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 1.5, "local")
+    with pytest.raises(DomainError) as err:
+        shipments.add_note(s.id, text)
+    assert err.value.code == "E_BAD_INPUT"
+    assert s.notes == []
