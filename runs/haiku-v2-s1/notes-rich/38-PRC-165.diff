+def shipments_without_invoice():
+    # Read-only: no events emitted. Returns shipments that no invoice refers to,
+    # sorted by id.
+    billed = {i.shipment_id for i in db.invoices.values()}
+    unbilled = [s for s in db.shipments.values() if s.id not in billed]
+    return sorted(unbilled, key=lambda s: s.id)
+
