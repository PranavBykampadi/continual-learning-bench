diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_customer_lock.py b/tests/unit/test_customer_lock.py
--- a/tests/unit/test_customer_lock.py	1969-12-31 19:00:00
+++ b/tests/unit/test_customer_lock.py	2026-11-12 02:22:08
@@ -0,0 +1,46 @@
+import pytest
+
+from parcelo import customers, events
+from parcelo.errors import DomainError
+from parcelo.models import Customer
+from parcelo.store import db
+
+
+def test_new_customer_is_not_locked():
+    c = customers.add_customer("Acme")
+    assert c.locked is False
+    assert Customer(id="X", name="x").locked is False
+
+
+def test_lock_sets_flag_and_returns_customer():
+    c = customers.add_customer("Acme")
+    locked = customers.lock_customer(c.id)
+    assert locked is c
+    assert c.locked is True
+    assert db.customers[c.id].locked is True
+
+
+def test_lock_emits_event():
+    c = customers.add_customer("Acme")
+    events.OUTBOX.clear()
+    customers.lock_customer(c.id)
+    assert len(events.OUTBOX) == 1
+    assert events.OUTBOX[-1]["name"] == "customer.locked"
+    assert events.OUTBOX[-1]["entity_id"] == c.id
+
+
+def test_lock_is_idempotent():
+    c = customers.add_customer("Acme")
+    customers.lock_customer(c.id)
+    events.OUTBOX.clear()
+    again = customers.lock_customer(c.id)
+    assert again.locked is True
+    assert events.OUTBOX == []
+
+
+def test_lock_unknown_customer_fails():
+    with pytest.raises(DomainError) as err:
+        customers.lock_customer("C_missing")
+    assert err.value.code == "E_NOT_FOUND"
+    assert "C_missing" not in db.customers
+    assert events.OUTBOX == []
