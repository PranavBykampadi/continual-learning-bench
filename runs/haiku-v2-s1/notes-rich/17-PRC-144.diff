+from decimal import Decimal
+
+from parcelo.money import Money
+
 ZONE_BASE = {"local": 4.5, "national": 9.0, "international": 24.0}
 PER_KG = 1.25
 
+# Fuel surcharge percentages per zone. These mirror the table used by
+# fuel_surcharge() in parcelo/legacy/billing.py; reimplemented here because
+# the legacy package is scheduled for deletion.
+FUEL_SURCHARGE_PCT = {
+    "local": Decimal("0"),
+    "national": Decimal("4.0"),
+    "international": Decimal("9.5"),
+}
+INSURANCE_RATE = Decimal("0.02")
+INSURANCE_MIN = Money(100)  # 1.00 USD
 
+
 def base_rate(zone):
     if zone not in ZONE_BASE:
         raise ValueError("unknown zone: %s" % zone)
@@ -12,3 +27,22 @@
     if weight_kg <= 0:
         raise ValueError("weight must be positive")
     return round(base_rate(zone) + PER_KG * weight_kg, 2)
+
+
+def insurance_fee(declared_value, zone):
+    """Insurance fee for a declared value, as Money.
+
+    2% of the declared value plus the zone's fuel surcharge percentage of the
+    declared value, with a minimum fee of 1.00. Unknown zones and non-positive
+    declared values raise ValueError.
+    """
+    if zone not in FUEL_SURCHARGE_PCT:
+        raise ValueError("unknown zone: %s" % zone)
+    value = Money.parse(declared_value)
+    if value.cents <= 0:
+        raise ValueError("declared value must be positive")
+    factor = INSURANCE_RATE + FUEL_SURCHARGE_PCT[zone] / Decimal(100)
+    fee = value.scale(factor)
+    if fee.cents < INSURANCE_MIN.cents:
+        return INSURANCE_MIN
+    return fee
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_insurance.py b/tests/unit/test_insurance.py
--- a/tests/unit/test_insurance.py	1969-12-31 19:00:00
+++ b/tests/unit/test_insurance.py	2026-11-12 02:06:51
@@ -0,0 +1,43 @@
+import pytest
+
+from parcelo import rates
+from parcelo.money import Money
+
+
+def test_local_fee_is_two_percent():
+    assert rates.insurance_fee(100, "local") == Money(200)
+
+
+def test_national_adds_fuel_surcharge():
+    # 2% + 4% of 100.00 = 6.00
+    assert rates.insurance_fee(100, "national") == Money(600)
+
+
+def test_international_adds_fuel_surcharge():
+    # 2% + 9.5% of 200.00 = 23.00
+    assert rates.insurance_fee("200.00", "international") == Money(2300)
+
+
+def test_accepts_money_input():
+    assert rates.insurance_fee(Money(10000), "local") == Money(200)
+
+
+def test_minimum_fee_applies():
+    # 2% of 10.00 is 0.20, so the 1.00 minimum applies.
+    assert rates.insurance_fee(10, "local") == Money(100)
+
+
+def test_returns_money_not_float():
+    fee = rates.insurance_fee(50, "national")
+    assert isinstance(fee, Money)
+
+
+def test_unknown_zone_fails():
+    with pytest.raises(ValueError):
+        rates.insurance_fee(100, "moon")
+
+
+@pytest.mark.parametrize("value", [0, -5, -0.01])
+def test_non_positive_declared_value_fails(value):
+    with pytest.raises(ValueError):
+        rates.insurance_fee(value, "local")
