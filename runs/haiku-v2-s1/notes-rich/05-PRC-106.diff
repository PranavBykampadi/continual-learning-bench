@@ -32,3 +39,26 @@
 
 def open_invoices():
     return [i for i in db.invoices.values() if i.status == "open"]
+
+
+def _as_utc(moment):
+    # issue_invoice stores naive UTC datetimes; clock.now() is timezone-aware.
+    if moment.tzinfo is None:
+        return moment.replace(tzinfo=timezone.utc)
+    return moment
+
+
+def late_fee_for(invoice_id):
+    """Late fee accrued so far on an invoice, as Money.
+
+    The invoice is late LATE_AFTER_DAYS days after it was issued. Each whole
+    day past that adds 1.5% of the invoice amount. Not late means zero.
+    """
+    if invoice_id not in db.invoices:
+        raise DomainError("E_NOT_FOUND", invoice_id)
+    invoice = db.invoices[invoice_id]
+    elapsed = _as_utc(clock.now()) - _as_utc(invoice.issued_at)
+    days_late = elapsed.days - LATE_AFTER_DAYS
+    if days_late <= 0:
+        return Money.zero()
+    return Money.parse(invoice.amount).scale(LATE_FEE_PER_DAY * days_late)
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_late_fee.py b/tests/unit/test_late_fee.py
--- a/tests/unit/test_late_fee.py	1969-12-31 19:00:00
+++ b/tests/unit/test_late_fee.py	2026-11-12 01:57:46
@@ -0,0 +1,81 @@
+from datetime import datetime, timedelta, timezone
+
+import pytest
+
+from parcelo import audit, clock, customers, invoices, shipments
+from parcelo.errors import DomainError
+from parcelo.money import Money
+
+ISSUED = datetime(2026, 1, 1, tzinfo=timezone.utc)
+
+
+def _make_invoice():
+    # local, 2 kg -> quote is 7.00 USD
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 2, "local")
+    inv = invoices.issue_invoice(s.id)
+    # issue_invoice stamps real wall-clock time, so pin it for the test
+    inv.issued_at = ISSUED
+    return inv
+
+
+def _at(days):
+    clock.set_fixed(ISSUED + timedelta(days=days))
+
+
+def test_not_found_raises():
+    with pytest.raises(DomainError) as err:
+        invoices.late_fee_for("INV-missing")
+    assert err.value.code == "E_NOT_FOUND"
+
+
+def test_not_late_before_30_days_is_zero():
+    inv = _make_invoice()
+    _at(29)
+    assert invoices.late_fee_for(inv.id) == Money.zero()
+
+
+def test_exactly_30_days_is_not_late_yet():
+    inv = _make_invoice()
+    _at(30)
+    assert invoices.late_fee_for(inv.id) == Money.zero()
+
+
+def test_first_day_past_30_is_1_5_percent():
+    inv = _make_invoice()
+    _at(31)
+    # 7.00 * 1.5% = 0.105 -> rounds half up to 0.11
+    assert invoices.late_fee_for(inv.id) == Money(11)
+
+
+def test_fee_scales_per_day_past_30():
+    inv = _make_invoice()
+    _at(40)  # 10 days past the grace period
+    # 7.00 * 15% = 1.05
+    assert invoices.late_fee_for(inv.id) == Money(105)
+
+
+def test_fee_is_money_and_does_not_change_invoice():
+    inv = _make_invoice()
+    _at(45)
+    fee = invoices.late_fee_for(inv.id)
+    assert isinstance(fee, Money)
+    assert inv.amount == 7.0
+    assert inv.status == "open"
+
+
+def test_naive_issued_at_from_issue_invoice_does_not_crash():
+    # issue_invoice stores a naive UTC timestamp; a fresh invoice is not late
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 2, "local")
+    inv = invoices.issue_invoice(s.id)
+    assert inv.issued_at.tzinfo is None
+    assert invoices.late_fee_for(inv.id) == Money.zero()
+
+
+def test_no_audit_entry_for_read_only_query():
+    inv = _make_invoice()
+    _at(60)
+    audit.LOG.clear()
+    invoices.late_fee_for(inv.id)
+    assert audit.LOG == []
