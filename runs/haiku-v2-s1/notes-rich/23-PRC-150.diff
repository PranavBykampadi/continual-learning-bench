diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_credit_limit.py b/tests/unit/test_credit_limit.py
--- a/tests/unit/test_credit_limit.py	1969-12-31 19:00:00
+++ b/tests/unit/test_credit_limit.py	2026-11-12 02:10:56
@@ -0,0 +1,39 @@
+import pytest
+
+from parcelo import customers, events
+from parcelo.errors import DomainError
+from parcelo.money import Money
+
+
+def _helper():
+    return customers.add_customer("Acme")
+
+
+def test_set_credit_limit_updates_and_returns_money():
+    c = _helper()
+    limit = customers.set_credit_limit(c.id, 1234.5)
+    assert limit == Money(123450)
+    assert isinstance(limit, Money)
+    assert customers.get_customer(c.id).credit_limit == Money(123450)
+
+
+def test_set_credit_limit_emits_event():
+    c = _helper()
+    customers.set_credit_limit(c.id, 100)
+    assert events.OUTBOX[-1]["name"] == "customer.credit_limit_set"
+    assert events.OUTBOX[-1]["entity_id"] == c.id
+
+
+def test_unknown_customer_fails():
+    with pytest.raises(DomainError) as err:
+        customers.set_credit_limit("C_nope", 100)
+    assert err.value.code == "E_NOT_FOUND"
+
+
+def test_negative_amount_fails_and_leaves_limit_unchanged():
+    c = _helper()
+    before = customers.get_customer(c.id).credit_limit
+    with pytest.raises(DomainError) as err:
+        customers.set_credit_limit(c.id, -1)
+    assert err.value.code == "E_BAD_INPUT"
+    assert customers.get_customer(c.id).credit_limit == before
