diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_refunds.py b/tests/unit/test_refunds.py
--- a/tests/unit/test_refunds.py	1969-12-31 19:00:00
+++ b/tests/unit/test_refunds.py	2026-11-12 01:56:27
@@ -0,0 +1,106 @@
+from datetime import datetime, timezone
+
+import pytest
+
+from parcelo import audit, clock, customers, invoices, refunds, shipments, store
+from parcelo.errors import DomainError
+from parcelo.models import Refund
+from parcelo.money import Money
+
+
+def _make_invoice():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 2, "local")
+    return invoices.issue_invoice(s.id)
+
+
+def _make_paid_invoice():
+    inv = _make_invoice()
+    invoices.mark_paid(inv.id)
+    return inv
+
+
+def test_refund_paid_invoice_is_stored_and_returned():
+    moment = datetime(2026, 11, 12, 10, 0, tzinfo=timezone.utc)
+    clock.set_fixed(moment)
+    inv = _make_paid_invoice()
+    audit.LOG.clear()
+
+    refund = refunds.create_refund(inv.id, Money.parse("3.50"))
+
+    assert isinstance(refund, Refund)
+    assert refund.id.startswith("ref_")
+    assert refund.invoice_id == inv.id
+    assert refund.amount == Money(350)
+    assert refund.created_at == moment
+    assert store.db.refunds[refund.id] is refund
+    assert audit.LOG[-1]["action"] == "refund.created"
+    assert audit.LOG[-1]["entity_id"] == refund.id
+
+
+def test_float_amount_is_wrapped_as_money():
+    inv = _make_paid_invoice()
+
+    refund = refunds.create_refund(inv.id, 7.0)
+
+    assert refund.amount == Money(700)
+    assert isinstance(refund.amount, Money)
+
+
+def test_unknown_invoice_is_not_found():
+    audit.LOG.clear()
+    with pytest.raises(DomainError) as err:
+        refunds.create_refund("INV-missing", Money(100))
+    assert err.value.code == "E_NOT_FOUND"
+    assert store.db.refunds == {}
+    assert audit.LOG == []
+
+
+def test_open_invoice_cannot_be_refunded():
+    inv = _make_invoice()
+    audit.LOG.clear()
+    with pytest.raises(DomainError) as err:
+        refunds.create_refund(inv.id, Money(100))
+    assert err.value.code == "E_BAD_STATE"
+    assert store.db.refunds == {}
+    assert audit.LOG == []
+    assert inv.status == "open"
+
+
+def test_void_invoice_cannot_be_refunded():
+    inv = _make_invoice()
+    inv.status = "void"
+    audit.LOG.clear()
+    with pytest.raises(DomainError) as err:
+        refunds.create_refund(inv.id, Money(100))
+    assert err.value.code == "E_BAD_STATE"
+    assert store.db.refunds == {}
+    assert audit.LOG == []
+    assert inv.status == "void"
+
+
+@pytest.mark.parametrize("amount", [0, -1, -0.5])
+def test_non_positive_amount_is_rejected(amount):
+    inv = _make_paid_invoice()
+    audit.LOG.clear()
+    with pytest.raises(DomainError) as err:
+        refunds.create_refund(inv.id, amount)
+    assert err.value.code == "E_BAD_INPUT"
+    assert store.db.refunds == {}
+    assert audit.LOG == []
+    assert inv.status == "paid"
+
+
+def test_unparseable_amount_is_rejected():
+    inv = _make_paid_invoice()
+    with pytest.raises(DomainError) as err:
+        refunds.create_refund(inv.id, "not-money")
+    assert err.value.code == "E_BAD_INPUT"
+    assert store.db.refunds == {}
+
+
+def test_reset_clears_refunds():
+    inv = _make_paid_invoice()
+    refunds.create_refund(inv.id, Money(100))
+    store.reset()
+    assert store.db.refunds == {}
