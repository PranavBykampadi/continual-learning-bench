diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_invoice_write_off.py b/tests/unit/test_invoice_write_off.py
--- a/tests/unit/test_invoice_write_off.py	1969-12-31 19:00:00
+++ b/tests/unit/test_invoice_write_off.py	2026-11-12 02:08:11
@@ -0,0 +1,66 @@
+import pytest
+
+from parcelo import customers, events, invoices, shipments
+from parcelo.errors import DomainError
+from parcelo.models import Invoice
+from parcelo.money import Money
+
+
+def _open_invoice():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 2, "local")
+    return invoices.issue_invoice(s.id)
+
+
+def test_write_off_open_invoice():
+    inv = _open_invoice()
+    events.OUTBOX.clear()
+    amount = invoices.write_off(inv.id)
+    assert inv.status == "written_off"
+    assert inv.written_off_at is not None
+    assert isinstance(amount, Money)
+    assert amount == Money(700)
+    assert events.OUTBOX[-1]["name"] == "invoice.written_off"
+    assert events.OUTBOX[-1]["entity_id"] == inv.id
+
+
+def test_write_off_returns_money_not_float():
+    inv = _open_invoice()
+    amount = invoices.write_off(inv.id)
+    assert not isinstance(amount, float)
+    assert amount.cents == 700
+    assert amount.currency == "USD"
+
+
+def test_write_off_paid_invoice_fails():
+    inv = _open_invoice()
+    invoices.mark_paid(inv.id)
+    events.OUTBOX.clear()
+    with pytest.raises(DomainError) as err:
+        invoices.write_off(inv.id)
+    assert err.value.code == "E_BAD_STATE"
+    assert inv.status == "paid"
+    assert events.OUTBOX == []
+
+
+def test_write_off_twice_fails():
+    inv = _open_invoice()
+    invoices.write_off(inv.id)
+    with pytest.raises(DomainError) as err:
+        invoices.write_off(inv.id)
+    assert err.value.code == "E_BAD_STATE"
+
+
+def test_write_off_unknown_invoice():
+    with pytest.raises(DomainError) as err:
+        invoices.write_off("INV-missing")
+    assert err.value.code == "E_NOT_FOUND"
+    assert events.OUTBOX == []
+
+
+def test_write_off_hand_built_invoice_wraps_float_amount():
+    from parcelo.store import db
+
+    db.invoices["INV-manual"] = Invoice(id="INV-manual", shipment_id="shp_x", amount=12.34)
+    amount = invoices.write_off("INV-manual")
+    assert amount == Money(1234)
