@@ -32,3 +35,17 @@
 
 def open_invoices():
     return [i for i in db.invoices.values() if i.status == "open"]
+
+
+def invoices_by_status(status):
+    """Return invoices whose status is `status`, sorted by id.
+
+    Raises DomainError("E_BAD_INPUT") if `status` is not one of INVOICE_STATUSES.
+    Read-only: no events are emitted.
+    """
+    if status not in INVOICE_STATUSES:
+        raise DomainError("E_BAD_INPUT", status)
+    return sorted(
+        (i for i in db.invoices.values() if i.status == status),
+        key=lambda i: i.id,
+    )
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_invoices_by_status.py b/tests/unit/test_invoices_by_status.py
--- a/tests/unit/test_invoices_by_status.py	1969-12-31 19:00:00
+++ b/tests/unit/test_invoices_by_status.py	2026-11-12 02:21:28
@@ -0,0 +1,43 @@
+import pytest
+
+from parcelo import customers, events, invoices, shipments
+from parcelo.errors import DomainError
+
+
+def _make_invoice():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 2, "local")
+    return invoices.issue_invoice(s.id)
+
+
+def test_returns_only_matching_status():
+    open_inv = _make_invoice()
+    paid_inv = _make_invoice()
+    invoices.mark_paid(paid_inv.id)
+
+    assert invoices.invoices_by_status("open") == [open_inv]
+    assert invoices.invoices_by_status("paid") == [paid_inv]
+
+
+def test_empty_when_none_match():
+    assert invoices.invoices_by_status("paid") == []
+
+
+def test_sorted_by_id():
+    ids_made = [_make_invoice().id for _ in range(3)]
+    result = invoices.invoices_by_status("open")
+    assert [i.id for i in result] == sorted(ids_made)
+
+
+def test_read_only_emits_no_events():
+    _make_invoice()
+    before = len(events.OUTBOX)
+    invoices.invoices_by_status("open")
+    assert len(events.OUTBOX) == before
+
+
+@pytest.mark.parametrize("bad", ["void", "OPEN", "", None])
+def test_invalid_status_raises_bad_input(bad):
+    with pytest.raises(DomainError) as err:
+        invoices.invoices_by_status(bad)
+    assert err.value.code == "E_BAD_INPUT"
