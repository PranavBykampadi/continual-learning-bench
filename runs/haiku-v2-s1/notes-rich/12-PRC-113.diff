 def open_invoices():
     return [i for i in db.invoices.values() if i.status == "open"]
+
+
+def apply_credit(invoice_id, amount):
+    """Reduce an open invoice by a credit and return the remaining amount.
+
+    The invoice keeps its float dollar amount so existing reports and
+    outstanding balances keep working; the arithmetic is done in Money.
+    """
+    if invoice_id not in db.invoices:
+        raise DomainError("E_NOT_FOUND", invoice_id)
+    invoice = db.invoices[invoice_id]
+    if invoice.status != "open":
+        raise DomainError("E_BAD_STATE", invoice_id)
+    credit = Money.parse(amount)
+    if credit.cents <= 0:
+        raise DomainError("E_BAD_INPUT", str(amount))
+    current = Money.parse(invoice.amount)
+    if current < credit:
+        raise DomainError("E_BAD_INPUT", str(amount))
+    remaining = current - credit
+    invoice.amount = round(remaining.cents / 100, 2)
+    audit.record(
+        "invoice.credit_applied",
+        invoice_id,
+        credit=str(credit),
+        remaining=str(remaining),
+    )
+    return invoice.amount
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_credits.py b/tests/unit/test_credits.py
--- a/tests/unit/test_credits.py	1969-12-31 19:00:00
+++ b/tests/unit/test_credits.py	2026-11-12 02:02:37
@@ -0,0 +1,71 @@
+import pytest
+
+from parcelo import audit, customers, invoices, reports, shipments
+from parcelo.errors import DomainError
+
+
+def _open_invoice():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 2, "local")  # quotes to 7.00
+    inv = invoices.issue_invoice(s.id)
+    return c, inv
+
+
+def test_apply_credit_returns_remaining():
+    _, inv = _open_invoice()
+    assert invoices.apply_credit(inv.id, 2.5) == 4.5
+    assert inv.amount == 4.5
+    assert inv.status == "open"
+
+
+def test_credit_flows_into_balance_and_revenue():
+    c, inv = _open_invoice()
+    invoices.apply_credit(inv.id, 2.5)
+    assert customers.outstanding_balance(c.id) == 4.5
+    invoices.mark_paid(inv.id)
+    assert reports.revenue_total() == 4.5
+
+
+def test_credit_equal_to_amount_leaves_zero():
+    _, inv = _open_invoice()
+    assert invoices.apply_credit(inv.id, 7.0) == 0.0
+
+
+def test_credit_records_audit_with_invoice_id():
+    _, inv = _open_invoice()
+    invoices.apply_credit(inv.id, 1.0)
+    entry = audit.LOG[-1]
+    assert entry["action"] == "invoice.credit_applied"
+    assert entry["entity_id"] == inv.id
+
+
+def test_unknown_invoice_fails():
+    with pytest.raises(DomainError) as err:
+        invoices.apply_credit("INV-missing", 1.0)
+    assert err.value.code == "E_NOT_FOUND"
+
+
+def test_non_open_invoice_fails():
+    _, inv = _open_invoice()
+    invoices.mark_paid(inv.id)
+    with pytest.raises(DomainError) as err:
+        invoices.apply_credit(inv.id, 1.0)
+    assert err.value.code == "E_BAD_STATE"
+
+
+def test_credit_larger_than_amount_fails():
+    _, inv = _open_invoice()
+    with pytest.raises(DomainError) as err:
+        invoices.apply_credit(inv.id, 7.01)
+    assert err.value.code == "E_BAD_INPUT"
+    assert inv.amount == 7.0
+    assert not [e for e in audit.LOG if e["action"] == "invoice.credit_applied"]
+
+
+@pytest.mark.parametrize("bad", [0, -1.0])
+def test_non_positive_credit_fails(bad):
+    _, inv = _open_invoice()
+    with pytest.raises(DomainError) as err:
+        invoices.apply_credit(inv.id, bad)
+    assert err.value.code == "E_BAD_INPUT"
+    assert inv.amount == 7.0
