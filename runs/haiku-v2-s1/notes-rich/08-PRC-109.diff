diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_customer_addresses.py b/tests/unit/test_customer_addresses.py
--- a/tests/unit/test_customer_addresses.py	1969-12-31 19:00:00
+++ b/tests/unit/test_customer_addresses.py	2026-11-12 02:00:03
@@ -0,0 +1,47 @@
+import pytest
+
+from parcelo import audit, customers
+from parcelo.errors import DomainError
+from parcelo.store import db
+
+
+def test_add_address_stores_and_returns_it():
+    c = customers.add_customer("Acme")
+    addr = customers.add_address(c.id, "1 Main St", "Springfield")
+    assert addr.id.startswith("adr_")
+    assert addr.customer_id == c.id
+    assert addr.line == "1 Main St"
+    assert addr.city == "Springfield"
+    assert db.addresses[addr.id] is addr
+
+
+def test_add_address_records_audit():
+    c = customers.add_customer("Acme")
+    addr = customers.add_address(c.id, "1 Main St", "Springfield")
+    assert audit.LOG[-1]["action"] == "customer.address_added"
+    assert audit.LOG[-1]["entity_id"] == addr.id
+
+
+def test_unknown_customer_fails():
+    with pytest.raises(DomainError) as err:
+        customers.add_address("C_missing", "1 Main St", "Springfield")
+    assert err.value.code == "E_NOT_FOUND"
+    assert db.addresses == {}
+
+
+@pytest.mark.parametrize("line", ["", "   ", None])
+def test_empty_line_fails(line):
+    c = customers.add_customer("Acme")
+    with pytest.raises(DomainError) as err:
+        customers.add_address(c.id, line, "Springfield")
+    assert err.value.code == "E_BAD_INPUT"
+    assert db.addresses == {}
+
+
+@pytest.mark.parametrize("city", ["", "  ", None])
+def test_empty_city_fails(city):
+    c = customers.add_customer("Acme")
+    with pytest.raises(DomainError) as err:
+        customers.add_address(c.id, "1 Main St", city)
+    assert err.value.code == "E_BAD_INPUT"
+    assert db.addresses == {}
