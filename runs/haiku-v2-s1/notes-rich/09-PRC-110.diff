 import pytest
 
 from parcelo import rates
+from parcelo.errors import DomainError
+from parcelo.money import Money
 
 
 def test_quote_local():
@@ -10,3 +12,29 @@
 def test_unknown_zone():
     with pytest.raises(ValueError):
         rates.base_rate("moon")
+
+
+def test_discounted_quote_gold():
+    # 7.00 USD less 10% = 6.30 USD
+    assert rates.discounted_quote(2, "local", "gold") == Money(630)
+
+
+def test_discounted_quote_standard_no_discount():
+    assert rates.discounted_quote(2, "local", "standard") == Money(700)
+
+
+def test_discounted_quote_gold_rounds_half_up():
+    # quote(1, "local") = 5.75 -> 90% = 5.175 -> 5.18 (half-up)
+    assert rates.discounted_quote(1, "local", "gold") == Money(518)
+
+
+def test_discounted_quote_unknown_zone():
+    with pytest.raises(DomainError) as exc:
+        rates.discounted_quote(2, "moon", "gold")
+    assert exc.value.code == "E_BAD_ZONE"
+
+
+def test_discounted_quote_unknown_tier():
+    with pytest.raises(DomainError) as exc:
+        rates.discounted_quote(2, "local", "platinum")
+    assert exc.value.code == "E_BAD_INPUT"
