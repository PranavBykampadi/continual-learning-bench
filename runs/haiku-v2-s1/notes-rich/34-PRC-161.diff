+def _rebate_rate(shipment_count):
+    if shipment_count >= REBATE_MIN_SHIPMENTS_BULK:
+        return REBATE_RATE_BULK
+    if shipment_count >= REBATE_MIN_SHIPMENTS_REGULAR:
+        return REBATE_RATE_REGULAR
+    return None
+
+
+def rebate_for(customer_id):
+    """Volume rebate earned by a customer, as Money.
+
+    Rate depends on the customer's total shipment count (all shipments, not
+    only paid ones) applied to the total of their paid invoices.
+    """
+    if customer_id not in db.customers:
+        raise DomainError("E_NOT_FOUND", customer_id)
+    shipment_count = 0
+    for shipment in db.shipments.values():
+        if shipment.customer_id == customer_id:
+            shipment_count += 1
+    rate = _rebate_rate(shipment_count)
+    if rate is None:
+        return Money.zero()
+    paid = Money.zero()
+    for invoice in db.invoices.values():
+        if invoice.status != "paid":
+            continue
+        shipment = db.shipments.get(invoice.shipment_id)
+        if shipment is None or shipment.customer_id != customer_id:
+            continue
+        paid = paid + Money.parse(invoice.amount)
+    return paid.scale(rate)
