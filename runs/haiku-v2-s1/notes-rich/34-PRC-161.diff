+++ b/parcelo/settings.py	2026-11-12 02:20:35
@@ -0,0 +1,9 @@
+"""Shared thresholds and rates. Import the constants where they are used."""
+
+# Volume rebate (PRC-161). Rates are strings so they stay exact in Money.scale.
+# The shipment-count cut-offs mirror parcelo.legacy.billing.volume_tier; that
+# module is being deleted, so the values are repeated here instead of imported.
+REBATE_MIN_SHIPMENTS_REGULAR = 10
+REBATE_MIN_SHIPMENTS_BULK = 50
+REBATE_RATE_REGULAR = "0.03"
+REBATE_RATE_BULK = "0.06"
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_rebate.py b/tests/unit/test_rebate.py
--- a/tests/unit/test_rebate.py	1969-12-31 19:00:00
+++ b/tests/unit/test_rebate.py	2026-11-12 02:20:43
@@ -0,0 +1,68 @@
+import pytest
+
+from parcelo import customers
+from parcelo.errors import DomainError
+from parcelo.models import Invoice, Shipment
+from parcelo.money import Money
+from parcelo.store import db
+
+
+def _customer_with_shipments(count, paid_amounts=(), open_amounts=()):
+    c = customers.add_customer("Acme")
+    for i in range(count):
+        sid = f"shp_t{i:04d}"
+        db.shipments[sid] = Shipment(id=sid, customer_id=c.id, weight_kg=1.0, zone="local")
+    # Paid/open invoices hang off the customer's first shipment.
+    first = next(s.id for s in db.shipments.values() if s.customer_id == c.id) if count else None
+    for n, amount in enumerate(paid_amounts):
+        db.invoices[f"INV-p{n}"] = Invoice(
+            id=f"INV-p{n}", shipment_id=first, amount=amount, status="paid"
+        )
+    for n, amount in enumerate(open_amounts):
+        db.invoices[f"INV-o{n}"] = Invoice(
+            id=f"INV-o{n}", shipment_id=first, amount=amount, status="open"
+        )
+    return c
+
+
+def test_unknown_customer_raises_not_found():
+    with pytest.raises(DomainError) as err:
+        customers.rebate_for("nope")
+    assert err.value.code == "E_NOT_FOUND"
+
+
+def test_fewer_than_ten_shipments_is_zero():
+    c = _customer_with_shipments(9, paid_amounts=[100.0])
+    assert customers.rebate_for(c.id) == Money.zero()
+
+
+def test_ten_shipments_gets_three_percent_of_paid():
+    c = _customer_with_shipments(10, paid_amounts=[100.0, 50.0])
+    assert customers.rebate_for(c.id) == Money.parse("4.50")
+
+
+def test_fifty_shipments_gets_six_percent_of_paid():
+    c = _customer_with_shipments(50, paid_amounts=[100.0, 50.0])
+    assert customers.rebate_for(c.id) == Money.parse("9.00")
+
+
+def test_open_invoices_are_not_counted():
+    c = _customer_with_shipments(10, paid_amounts=[100.0], open_amounts=[999.0])
+    assert customers.rebate_for(c.id) == Money.parse("3.00")
+
+
+def test_other_customers_invoices_are_not_counted():
+    c = _customer_with_shipments(10, paid_amounts=[100.0])
+    other = customers.add_customer("Other")
+    db.shipments["shp_other"] = Shipment(
+        id="shp_other", customer_id=other.id, weight_kg=1.0, zone="local"
+    )
+    db.invoices["INV-x"] = Invoice(
+        id="INV-x", shipment_id="shp_other", amount=500.0, status="paid"
+    )
+    assert customers.rebate