+from datetime import datetime, timezone
+
+import pytest
+
+from parcelo import clock, customers, events, returns, shipments, store
+from parcelo.errors import DomainError
+from parcelo.models import ReturnRequest
+from parcelo.settings import MAX_RETURNS_PER_SHIPMENT
+
+
+def _shipment(status="delivered"):
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 2.0, "local")
+    store.db.shipments[s.id].status = status
+    return s
+
+
+def test_request_return_creates_record():
+    clock.set_fixed(datetime(2026, 11, 1, 9, 0, tzinfo=timezone.utc))
+    s = _shipment()
+    r = returns.request_return(s.id, "damaged")
+    assert isinstance(r, ReturnRequest)
+    assert r.id.startswith("ret_")
+    assert r.shipment_id == s.id
+    assert r.reason == "damaged"
+    assert r.requested_at == clock.now()
+    assert store.db.returns[r.id] is r
+
+
+def test_request_return_emits_event():
+    s = _shipment()
+    events.OUTBOX.clear()
+    r = returns.request_return(s.id, "wrong item")
+    assert events.OUTBOX[-1]["name"] == "return.requested"
+    assert events.OUTBOX[-1]["entity_id"] == r.id
+    assert events.OUTBOX[-1]["payload"] == {"shipment_id": s.id}
+
+
+def test_returns_for_filters_and_sorts():
+    a = _shipment()
+    b = _shipment()
+    r1 = returns.request_return(a.id, "one")
+    returns.request_return(b.id, "other shipment")
+    r2 = returns.request_return(a.id, "two")
+    assert returns.returns_for(a.id) == [r1, r2]
+    assert [r.id for r in returns.returns_for(a.id)] == sorted(r.id for r in returns.returns_for(a.id))
+
+
+def test_returns_for_unknown_shipment_is_empty():
+    assert returns.returns_for("shp_missing") == []
+
+
+def test_missing_shipment_raises_not_found():
+    with pytest.raises(DomainError) as err:
+        returns.request_return("shp_missing", "damaged")
+    assert err.value.code == "E_NOT_FOUND"
+    assert store.db.returns == {}
+    assert events.OUTBOX == []
+
+
