@@ -32,3 +36,25 @@
 
 def open_invoices():
     return [i for i in db.invoices.values() if i.status == "open"]
+
+
+def escalate_invoice(invoice_id):
+    """Send an open invoice of at least ESCALATION_MIN_AMOUNT to collections.
+
+    Already-escalated invoices are returned unchanged. Raises E_NOT_FOUND for an
+    unknown id and E_BAD_STATE for a non-open invoice or one below the minimum.
+    """
+    if invoice_id not in db.invoices:
+        raise DomainError("E_NOT_FOUND", invoice_id)
+    invoice = db.invoices[invoice_id]
+    if invoice.status == "escalated":
+        return invoice
+    if invoice.status != "open":
+        raise DomainError("E_BAD_STATE", invoice_id)
+    # invoice.amount is a legacy float; wrap it in Money before comparing.
+    amount = Money.parse(invoice.amount)
+    if amount < Money.parse(ESCALATION_MIN_AMOUNT):
+        raise DomainError("E_BAD_STATE", invoice_id)
+    invoice.status = "escalated"
+    events.emit("invoice.escalated", invoice.id, amount=str(amount))
+    return invoice
