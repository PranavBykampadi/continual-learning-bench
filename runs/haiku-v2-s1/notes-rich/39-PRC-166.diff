+"""Shared thresholds, limits, and rates.
+
+Money values are strings so they go through Money.parse without float rounding.
+"""
+
+# Open invoices at or above this amount may be escalated to collections (PRC-166).
+ESCALATION_MIN_AMOUNT = "500.00"
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_escalate_invoice.py b/tests/unit/test_escalate_invoice.py
--- a/tests/unit/test_escalate_invoice.py	1969-12-31 19:00:00
+++ b/tests/unit/test_escalate_invoice.py	2026-11-12 02:24:27
@@ -0,0 +1,58 @@
+import pytest
+
+from parcelo import events, invoices
+from parcelo.errors import DomainError
+from parcelo.models import Invoice
+from parcelo.store import db
+
+
+def _add_invoice(invoice_id, amount, status="open"):
+    invoice = Invoice(id=invoice_id, shipment_id="shp_x", amount=amount, status=status)
+    db.invoices[invoice_id] = invoice
+    return invoice
+
+
+def test_escalates_large_open_invoice_and_emits_event():
+    _add_invoice("INV-1", 600.0)
+    result = invoices.escalate_invoice("INV-1")
+    assert result.status == "escalated"
+    assert db.invoices["INV-1"].status == "escalated"
+    assert events.OUTBOX[-1]["name"] == "invoice.escalated"
+    assert events.OUTBOX[-1]["entity_id"] == "INV-1"
+
+
+def test_exact_minimum_amount_can_be_escalated():
+    _add_invoice("INV-2", 500.0)
+    assert invoices.escalate_invoice("INV-2").status == "escalated"
+
+
+def test_below_minimum_is_rejected_and_unchanged():
+    _add_invoice("INV-3", 499.99)
+    before = len(events.OUTBOX)
+    with pytest.raises(DomainError) as err:
+        invoices.escalate_invoice("INV-3")
+    assert err.value.code == "E_BAD_STATE"
+    assert db.invoices["INV-3"].status == "open"
+    assert len(events.OUTBOX) == before
+
+
+def test_paid_invoice_is_rejected():
+    _add_invoice("INV-4", 900.0, status="paid")
+    with pytest.raises(DomainError) as err:
+        invoices.escalate_invoice("INV-4")
+    assert err.value.code == "E_BAD_STATE"
+    assert db.invoices["INV-4"].status == "paid"
+
+
+def test_already_escalated_is_noop():
+    _add_invoice("INV-5", 800.0, status="escalated")
+    before = len(events.OUTBOX)
+    result = invoices.escalate_invoice("INV-5")
+    assert result.status == "escalated"
+    assert len(events.OUTBOX) == before
+
+
+def test_missing_invoice_fails():
+    with pytest.raises(DomainError) as err:
+        invoices.escalate_invoice("INV-nope")
+    assert err.value.code == "E_NOT_FOUND"
