+def split_shipment(shipment_id, weights):
+    """Replace a "created" shipment with one new shipment per weight.
+
+    The new shipments keep the original customer and zone and are returned
+    in the same order as ``weights``. The original is marked "split".
+    Everything is validated before anything is created or changed.
+    """
+    original = get_shipment(shipment_id)
+    if original.status != "created":
+        raise DomainError("E_BAD_STATE", shipment_id)
+    weights = list(weights)
+    if not weights:
+        raise DomainError("E_BAD_INPUT", shipment_id)
+    for weight in weights:
+        if weight <= 0:
+            raise DomainError("E_BAD_WEIGHT", str(weight))
+    # Weights are kilograms (floats), so compare with a tolerance rather than ==.
+    if not math.isclose(sum(weights), original.weight_kg, rel_tol=1e-9, abs_tol=1e-9):
+        raise DomainError("E_BAD_INPUT", shipment_id)
+
+    new_shipments = [
+        create_shipment(original.customer_id, weight, original.zone) for weight in weights
+    ]
+    original.status = "split"
+    events.emit("shipment.split", original.id, parts=[s.id for s in new_shipments])
+    return new_shipments
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_split_shipment.py b/tests/unit/test_split_shipment.py
--- a/tests/unit/test_split_shipment.py	1969-12-31 19:00:00
+++ b/tests/unit/test_split_shipment.py	2026-11-12 02:10:03
@@ -0,0 +1,89 @@
+import pytest
+
+from parcelo import customers, events, shipments
+from parcelo.errors import DomainError
+from parcelo.store import db
+
+
+def _created(weight=10.0, zone="national"):
+    c = customers.add_customer("Acme")
+    return shipments.create_shipment(c.id, weight, zone)
+
+
+def test_split_returns_new_shipments_in_weight_order():
+    s = _created(10.0, "national")
+    events.OUTBOX.clear()
+    parts = shipments.split_shipment(s.id, [6.0, 4.0])
+    assert [p.weight_kg for p in parts] == [6.0, 4.0]
+    assert all(p.customer_id == s.customer_id for p in parts)
+    assert all(p.zone == "national" for p in parts)
+    assert all(p.status == "created" for p in parts)
+    assert all(p.id.startswith("shp_") for p in parts)
+    assert db.shipments[s.id].status == "split"
+    assert db.shipments[parts[0].id] is parts[0]
+
+
+def test_split_emits_events_for_original_and_new_shipments():
+    s = _created(10.0)
+    events.OUTBOX.clear()
+    parts = shipments.split_shipment(s.id, [5.0, 5.0])
+    names = [(e["name"], e["entity_id"]) for e in events.OUTBOX]
+    assert ("shipment.created", parts[0].id) in names
+    assert ("shipment.created", parts[1].id) in names
+    assert events.OUTBOX[-1]["name"] == "shipment.split"
+    assert events.OUTBOX[-1]["entity_id"] == s.id
+
+
+def test_split_missing_shipment_fails():
+    with pytest.raises(DomainError) as err:
+        shipments.split_shipment("shp_nope", [1.0])
+    assert err.value.code == "E_NOT_FOUND"
+    assert db.shipments == {}
+
+
+def test_split_non_created_shipment_fails():
+    s = _created(10.0)
+    s.status = "delivered"
+    events.OUTBOX.clear()
+    with pytest.raises(DomainError) as err:
+        shipments.split_shipment(s.id, [5.0, 5.0])
+    assert err.value.code == "E_BAD_STATE"
+    assert db.shipments[s.id].status == "delivered"
+    assert len(db.shipments) == 1
+    assert events.OUTBOX == []
+
+
+def test_split_weights_must_sum_to_original():
+    s = _created(10.0)
+    events.OUTBOX.clear()
+    with pytest.raises(DomainError) as err:
+        shipments.split_shipment(s.id, [6.0, 3.0])
+    assert err.value.code == "E_BAD_INPUT"
+    assert db.shipments[s.id].status == "created"
+    assert len(db.shipments) == 1
+    assert events.OUTBOX == []
+
+
+def test_split_empty_weights_fails():
+    s = _created(10.0)
+    with pytest.raises(DomainError) as err:
+        shipments.split_shipment(s.id, [])
+    assert err.value.code == "E_BAD_INPUT"
+    assert db.shipments[s.id].status == "created"
+
+
+def test_split_non_positive_weight_fails_without_changes():
+    s = _created(10.0)
+    events.OUTBOX.clear()
+    with pytest.raises(DomainError) as err:
+        shipments.split_shipment(s.id, [12.0, -2.0])
+    assert err.value.code == "E_BAD_WEIGHT"
+    assert db.shipments[s.id].status == "created"
+    assert len(db.shipments) == 1
+    assert events.OUTBOX == []
+
+
+def test_split_accepts_float_weights_that_sum_exactly_in_decimal():
+    s = _created(0.3)
+    parts = shipments.split_shipment(s.id, [0.1, 0.2])
+    assert [p.weight_kg for p in parts] == [0.1, 0.2]
