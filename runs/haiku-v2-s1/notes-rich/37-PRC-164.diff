diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/parcelo/vouchers.py b/parcelo/vouchers.py
--- a/parcelo/vouchers.py	1969-12-31 19:00:00
+++ b/parcelo/vouchers.py	2026-11-12 02:23:00
@@ -0,0 +1,32 @@
+from decimal import InvalidOperation
+
+from parcelo import clock, events, ids
+from parcelo.errors import DomainError
+from parcelo.models import Voucher
+from parcelo.money import Money
+from parcelo.settings import VOUCHER_MAX_AMOUNT
+from parcelo.store import db
+
+
+def issue_voucher(customer_id, amount):
+    """Issue a goodwill voucher. Raises E_NOT_FOUND, E_BAD_INPUT or E_LIMIT."""
+    if customer_id not in db.customers:
+        raise DomainError("E_NOT_FOUND", customer_id)
+    try:
+        # Accepts Money, or legacy float/str input.
+        money = Money.parse(amount)
+    except (ArithmeticError, ValueError, TypeError):
+        raise DomainError("E_BAD_INPUT", str(amount))
+    if not money.cents > 0:
+        raise DomainError("E_BAD_INPUT", str(amount))
+    if Money.parse(VOUCHER_MAX_AMOUNT) < money:
+        raise DomainError("E_LIMIT", str(money))
+    voucher = Voucher(
+        id=ids.new_id("vch"),
+        customer_id=customer_id,
+        amount=money,
+        issued_at=clock.now(),
+    )
+    db.vouchers[voucher.id] = voucher
+    events.emit("voucher.issued", voucher.id, customer_id=customer_id, amount=str(money))
+    return voucher
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_vouchers.py b/tests/unit/test_vouchers.py
--- a/tests/unit/test_vouchers.py	1969-12-31 19:00:00
+++ b/tests/unit/test_vouchers.py	2026-11-12 02:23:00
@@ -0,0 +1,57 @@
+import pytest
+
+from parcelo import customers, events, vouchers
+from parcelo.errors import DomainError
+from parcelo.money import Money
+from parcelo.store import db
+
+
+def test_issue_voucher_saves_and_emits():
+    c = customers.add_customer("Acme")
+    v = vouchers.issue_voucher(c.id, "20.00")
+    assert v.id.startswith("vch_")
+    assert v.customer_id == c.id
+    assert v.amount == Money.parse("20.00")
+    assert v.issued_at is not None
+    assert db.vouchers[v.id] is v
+    assert events.OUTBOX[-1]["name"] == "voucher.issued"
+    assert events.OUTBOX[-1]["entity_id"] == v.id
+
+
+def test_amount_at_maximum_is_allowed():
+    c = customers.add_customer("Acme")
+    v = vouchers.issue_voucher(c.id, "150.00")
+    assert v.amount.cents == 15000
+
+
+def test_amount_above_maximum_rejected():
+    c = customers.add_customer("Acme")
+    with pytest.raises(DomainError) as err:
+        vouchers.issue_voucher(c.id, "150.01")
+    assert err.value.code == "E_LIMIT"
+    assert db.vouchers == {}
+    assert events.OUTBOX == []
+
+
+def test_unknown_customer_rejected():
+    with pytest.raises(DomainError) as err:
+        vouchers.issue_voucher("C_missing", "10.00")
+    assert err.value.code == "E_NOT_FOUND"
+    assert db.vouchers == {}
+
+
+@pytest.mark.parametrize("amount", [0, "0", "-5.00", -0.01])
+def test_zero_or_negative_rejected(amount):
+    c = customers.add_customer("Acme")
+    with pytest.raises(DomainError) as err:
+        vouchers.issue_voucher(c.id, amount)
+    assert err.value.code == "E_BAD_INPUT"
+    assert db.vouchers == {}
+
+
+@pytest.mark.parametrize("amount", ["abc", float("nan")])
+def test_unparseable_amount_rejected(amount):
+    c = customers.add_customer("Acme")
+    with pytest.raises(DomainError) as err:
+        vouchers.issue_voucher(c.id, amount)
+    assert err.value.code == "E_BAD_INPUT"
