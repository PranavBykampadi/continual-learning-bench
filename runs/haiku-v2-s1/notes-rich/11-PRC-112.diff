diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_claims.py b/tests/unit/test_claims.py
--- a/tests/unit/test_claims.py	1969-12-31 19:00:00
+++ b/tests/unit/test_claims.py	2026-11-12 02:02:04
@@ -0,0 +1,66 @@
+import pytest
+
+from parcelo import customers, shipments, claims
+from parcelo.errors import DomainError
+from parcelo.money import Money
+from parcelo.store import db
+
+
+def _delivered_shipment():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 2, "local")
+    s.status = "delivered"
+    return s
+
+
+def test_file_claim_on_delivered_shipment():
+    s = _delivered_shipment()
+    claim = claims.file_claim(s.id, 12.5, "box damaged")
+    assert claim.id.startswith("clm_")
+    assert claim.shipment_id == s.id
+    assert claim.amount == Money(1250)
+    assert claim.reason == "box damaged"
+    assert claim.filed_at is not None
+    assert db.claims[claim.id] is claim
+
+
+def test_claim_on_missing_shipment():
+    with pytest.raises(DomainError) as err:
+        claims.file_claim("shp_nope", 5, "lost")
+    assert err.value.code == "E_NOT_FOUND"
+
+
+@pytest.mark.parametrize("state", ["created", "in_transit", "lost"])
+def test_claim_requires_delivered(state):
+    s = _delivered_shipment()
+    s.status = state
+    with pytest.raises(DomainError) as err:
+        claims.file_claim(s.id, 5, "late")
+    assert err.value.code == "E_BAD_STATE"
+    assert db.claims == {}
+
+
+@pytest.mark.parametrize("amount", [0, -3, -0.5, 0.001, "abc", None, float("nan")])
+def test_claim_rejects_bad_amount(amount):
+    s = _delivered_shipment()
+    with pytest.raises(DomainError) as err:
+        claims.file_claim(s.id, amount, "damaged")
+    assert err.value.code == "E_BAD_INPUT"
+    assert db.claims == {}
+
+
+@pytest.mark.parametrize("reason", ["", "   ", None])
+def test_claim_rejects_blank_reason(reason):
+    s = _delivered_shipment()
+    with pytest.raises(DomainError) as err:
+        claims.file_claim(s.id, 5, reason)
+    assert err.value.code == "E_BAD_INPUT"
+    assert db.claims == {}
+
+
+def test_reset_clears_claims():
+    from parcelo import store
+    s = _delivered_shipment()
+    claims.file_claim(s.id, 5, "damaged")
+    store.reset()
+    assert db.claims == {}
