 from datetime import datetime
 
+from parcelo.money import Money
+from parcelo.shipments import get_shipment
 from parcelo.store import db
+
+
+def outstanding_by_customer():
+    """Map every customer id to the total of their open invoices (Money).
+
+    Paid and void invoices are excluded. Customers with nothing owing map to
+    Money.zero().
+    """
+    totals = {customer_id: Money.zero() for customer_id in db.customers}
+    for invoice in db.invoices.values():
+        if invoice.status != "open":
+            continue
+        customer_id = get_shipment(invoice.shipment_id).customer_id
+        totals[customer_id] = totals.get(customer_id, Money.zero()) + Money.parse(
+            invoice.amount
+        )
+    return totals
 
 
