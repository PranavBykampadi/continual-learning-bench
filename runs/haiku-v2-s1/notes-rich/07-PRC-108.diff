diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_outstanding_report.py b/tests/unit/test_outstanding_report.py
--- a/tests/unit/test_outstanding_report.py	1969-12-31 19:00:00
+++ b/tests/unit/test_outstanding_report.py	2026-11-12 01:59:22
@@ -0,0 +1,47 @@
+from parcelo import customers, invoices, reports, shipments
+from parcelo.money import Money
+
+
+def _invoice_for(customer_id, weight_kg, zone="local"):
+    s = shipments.create_shipment(customer_id, weight_kg, zone)
+    return invoices.issue_invoice(s.id)
+
+
+def test_sums_open_invoices_per_customer():
+    a = customers.add_customer("Acme")
+    b = customers.add_customer("Beta")
+    _invoice_for(a.id, 2, "local")  # 7.00
+    _invoice_for(a.id, 2, "local")  # 7.00
+    _invoice_for(b.id, 2, "local")  # 7.00
+
+    result = reports.outstanding_by_customer()
+
+    assert result[a.id] == Money(1400)
+    assert result[b.id] == Money(700)
+
+
+def test_paid_and_void_invoices_excluded():
+    a = customers.add_customer("Acme")
+    paid = _invoice_for(a.id, 2, "local")
+    voided = _invoice_for(a.id, 2, "local")
+    _invoice_for(a.id, 2, "local")  # stays open
+    invoices.mark_paid(paid.id)
+    voided.status = "void"
+
+    result = reports.outstanding_by_customer()
+
+    assert result[a.id] == Money(700)
+
+
+def test_customer_with_nothing_owing_maps_to_zero():
+    a = customers.add_customer("Acme")
+    inv = _invoice_for(a.id, 2, "local")
+    invoices.mark_paid(inv.id)
+
+    result = reports.outstanding_by_customer()
+
+    assert result == {a.id: Money.zero()}
+
+
+def test_empty_store_returns_empty_dict():
+    assert reports.outstanding_by_customer() == {}
