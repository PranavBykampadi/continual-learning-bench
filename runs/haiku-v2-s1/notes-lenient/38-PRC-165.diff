diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_reports.py b/tests/unit/test_reports.py
--- a/tests/unit/test_reports.py	1969-12-31 19:00:00
+++ b/tests/unit/test_reports.py	2026-11-12 02:26:20
@@ -0,0 +1,41 @@
+from parcelo import customers, events, invoices, reports, shipments
+from parcelo.models import Shipment
+from parcelo.store import db
+
+
+def test_shipments_without_invoice_returns_uninvoiced_sorted_by_id():
+    c = customers.add_customer("Acme")
+    # Insert out of id order so the result must be sorted, not storage order.
+    for sid in ("shp_c", "shp_a", "shp_b"):
+        db.shipments[sid] = Shipment(id=sid, customer_id=c.id, weight_kg=1, zone="local")
+    invoices.issue_invoice("shp_b")
+    events.OUTBOX.clear()
+
+    result = reports.shipments_without_invoice()
+
+    assert [s.id for s in result] == ["shp_a", "shp_c"]
+
+
+def test_shipments_without_invoice_empty_when_none_exist():
+    assert reports.shipments_without_invoice() == []
+
+
+def test_shipments_without_invoice_empty_when_all_invoiced():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 2, "local")
+    invoices.issue_invoice(s.id)
+
+    assert reports.shipments_without_invoice() == []
+
+
+def test_shipments_without_invoice_is_read_only():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 2, "local")
+    events.OUTBOX.clear()
+    before = (len(db.shipments), len(db.invoices))
+
+    result = reports.shipments_without_invoice()
+
+    assert [x.id for x in result] == [s.id]
+    assert (len(db.shipments), len(db.invoices)) == before
+    assert events.OUTBOX == []
