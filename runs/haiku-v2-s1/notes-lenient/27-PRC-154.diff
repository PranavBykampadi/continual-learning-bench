diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_customers_reactivate.py b/tests/unit/test_customers_reactivate.py
--- a/tests/unit/test_customers_reactivate.py	1969-12-31 19:00:00
+++ b/tests/unit/test_customers_reactivate.py	2026-11-12 02:16:49
@@ -0,0 +1,44 @@
+import pytest
+
+from parcelo import customers, events
+from parcelo.errors import DomainError
+
+
+def _inactive_customer():
+    c = customers.add_customer("Acme")
+    c.active = False
+    return c
+
+
+def test_reactivate_sets_active_and_returns_customer():
+    c = _inactive_customer()
+    result = customers.reactivate_customer(c.id)
+    assert result is c
+    assert c.active is True
+    assert events.OUTBOX[-1]["name"] == "customer.reactivated"
+    assert events.OUTBOX[-1]["entity_id"] == c.id
+
+
+def test_reactivate_unknown_customer():
+    with pytest.raises(DomainError) as err:
+        customers.reactivate_customer("C_missing")
+    assert err.value.code == "E_NOT_FOUND"
+    assert events.OUTBOX == []
+
+
+@pytest.mark.parametrize("bad", [None, 42, "", ["C1"]])
+def test_reactivate_bad_input(bad):
+    with pytest.raises(DomainError) as err:
+        customers.reactivate_customer(bad)
+    assert err.value.code == "E_BAD_INPUT"
+    assert events.OUTBOX == []
+
+
+def test_reactivate_repeat_call_is_noop():
+    c = _inactive_customer()
+    customers.reactivate_customer(c.id)
+    outbox_len = len(events.OUTBOX)
+    result = customers.reactivate_customer(c.id)
+    assert result is c
+    assert c.active is True
+    assert len(events.OUTBOX) == outbox_len
