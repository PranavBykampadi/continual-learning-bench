+from parcelo.legacy.billing import FUEL_SURCHARGE_PCT
+from parcelo.money import Money
+
 ZONE_BASE = {"local": 4.5, "national": 9.0, "international": 24.0}
 PER_KG = 1.25
+INSURANCE_RATE = 0.02
+INSURANCE_MIN_FEE = Money(100)  # 1.00 USD
 
 
 def base_rate(zone):
@@ -12,3 +19,21 @@
     if weight_kg <= 0:
         raise ValueError("weight must be positive")
     return round(base_rate(zone) + PER_KG * weight_kg, 2)
+
+
+def insurance_fee(declared_value, zone):
+    """Insurance fee in dollars: 2% of declared value plus the zone's fuel
+    surcharge, with a minimum fee of 1.00."""
+    if zone not in FUEL_SURCHARGE_PCT:
+        raise ValueError("unknown zone: %s" % zone)
+    try:
+        value = Money.parse(declared_value)
+    except (TypeError, ValueError, ArithmeticError, InvalidOperation):
+        raise ValueError("declared value must be a number")
+    if value.cents <= 0:
+        raise ValueError("declared value must be positive")
+    fuel_pct = FUEL_SURCHARGE_PCT[zone]
+    fee = value.scale(INSURANCE_RATE) + value.scale(fuel_pct / 100.0)
+    if fee < INSURANCE_MIN_FEE:
+        fee = INSURANCE_MIN_FEE
+    return fee.cents / 100
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_insurance_fee.py b/tests/unit/test_insurance_fee.py
--- a/tests/unit/test_insurance_fee.py	1969-12-31 19:00:00
+++ b/tests/unit/test_insurance_fee.py	2026-11-12 02:07:27
@@ -0,0 +1,42 @@
+import pytest
+
+from parcelo import rates
+
+
+def test_insurance_fee_local():
+    assert rates.insurance_fee(1000, "local") == 20.0
+
+
+def test_insurance_fee_national_adds_fuel_surcharge():
+    assert rates.insurance_fee(1000, "national") == 60.0
+
+
+def test_insurance_fee_international_adds_fuel_surcharge():
+    assert rates.insurance_fee(1000, "international") == 115.0
+
+
+def test_insurance_fee_float_value():
+    assert rates.insurance_fee(10.50, "local") == 1.0
+    assert rates.insurance_fee(1050.25, "local") == 21.01
+
+
+def test_insurance_fee_minimum_applies():
+    assert rates.insurance_fee(10, "local") == 1.0
+    assert rates.insurance_fee(10, "international") == 1.15
+
+
+def test_insurance_fee_unknown_zone():
+    with pytest.raises(ValueError):
+        rates.insurance_fee(1000, "moon")
+
+
+@pytest.mark.parametrize("value", [0, -5, -0.01])
+def test_insurance_fee_non_positive_value(value):
+    with pytest.raises(ValueError):
+        rates.insurance_fee(value, "local")
+
+
+@pytest.mark.parametrize("value", [None, "", "abc", [100], float("nan")])
+def test_insurance_fee_bad_value(value):
+    with pytest.raises(ValueError):
+        rates.insurance_fee(value, "local")
