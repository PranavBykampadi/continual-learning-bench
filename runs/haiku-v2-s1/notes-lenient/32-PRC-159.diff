diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/test_shipments.py b/tests/test_shipments.py
--- a/tests/test_shipments.py	1969-12-31 19:00:00
+++ b/tests/test_shipments.py	2026-11-12 02:21:28
@@ -0,0 +1,45 @@
+import pytest
+
+from parcelo import customers, events, shipments
+from parcelo.errors import DomainError
+
+
+def test_shipments_in_zone_returns_matching_shipments():
+    c = customers.add_customer("Acme")
+    a = shipments.create_shipment(c.id, 1.0, "local")
+    shipments.create_shipment(c.id, 2.0, "national")
+    b = shipments.create_shipment(c.id, 3.0, "local")
+    result = shipments.shipments_in_zone("local")
+    assert result == [a, b]
+
+
+def test_shipments_in_zone_empty_when_none_match():
+    c = customers.add_customer("Acme")
+    shipments.create_shipment(c.id, 1.0, "local")
+    assert shipments.shipments_in_zone("international") == []
+
+
+def test_shipments_in_zone_empty_when_no_shipments():
+    assert shipments.shipments_in_zone("national") == []
+
+
+def test_shipments_in_zone_does_not_emit_events():
+    c = customers.add_customer("Acme")
+    shipments.create_shipment(c.id, 1.0, "local")
+    events.OUTBOX.clear()
+    shipments.shipments_in_zone("local")
+    assert events.OUTBOX == []
+
+
+@pytest.mark.parametrize("zone", ["moon", "LOCAL", " local", ""])
+def test_shipments_in_zone_unknown_zone(zone):
+    with pytest.raises(DomainError) as exc:
+        shipments.shipments_in_zone(zone)
+    assert exc.value.code == "E_BAD_INPUT"
+
+
+@pytest.mark.parametrize("zone", [None, 0, 1.5, ["local"], ("local",), {"local": 1}])
+def test_shipments_in_zone_bad_type(zone):
+    with pytest.raises(DomainError) as exc:
+        shipments.shipments_in_zone(zone)
+    assert exc.value.code == "E_BAD_INPUT"
