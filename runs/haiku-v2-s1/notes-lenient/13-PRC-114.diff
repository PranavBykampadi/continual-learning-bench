 from datetime import datetime
 
+from parcelo.legacy.billing import days_between
+from parcelo.money import Money
 from parcelo.store import db
+
+
+def aging_report():
+    """Total unpaid invoice amounts grouped by age in whole days since issue.
+
+    Invoices are bucketed as 0-30, 31-60 and 60+ days old. Paid invoices are
+    excluded. Issue timestamps are naive UTC (see invoices.issue_invoice), so
+    the age is measured against naive UTC too.
+    """
+    now = datetime.utcnow()
+    totals = {"0-30": Money.zero(), "31-60": Money.zero(), "60+": Money.zero()}
+    for invoice in db.invoices.values():
+        if invoice.status == "paid":
+            continue
+        age = days_between(invoice.issued_at, now)
+        if age <= 30:
+            bucket = "0-30"
+        elif age <= 60:
+            bucket = "31-60"
+        else:
+            bucket = "60+"
+        totals[bucket] = totals[bucket] + Money.parse(invoice.amount)
+    return {bucket: total.cents / 100 for bucket, total in totals.items()}
 
 
