diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_customers_by_tier.py b/tests/unit/test_customers_by_tier.py
--- a/tests/unit/test_customers_by_tier.py	1969-12-31 19:00:00
+++ b/tests/unit/test_customers_by_tier.py	2026-11-12 02:17:48
@@ -0,0 +1,43 @@
+import pytest
+
+from parcelo import customers, events
+from parcelo.errors import DomainError
+from parcelo.store import db
+
+
+def test_returns_matching_customers():
+    gold = customers.add_customer("Acme", tier="gold")
+    customers.add_customer("Bob")
+    result = customers.customers_by_tier("gold")
+    assert result == [gold]
+
+
+def test_empty_when_no_customers_on_tier():
+    customers.add_customer("Bob")
+    assert customers.customers_by_tier("gold") == []
+
+
+def test_empty_when_no_customers_at_all():
+    assert customers.customers_by_tier("standard") == []
+
+
+def test_unknown_tier_raises():
+    with pytest.raises(DomainError) as err:
+        customers.customers_by_tier("platinum")
+    assert err.value.code == "E_BAD_INPUT"
+
+
+@pytest.mark.parametrize("bad", [None, 1, ["gold"], b"gold", ""])
+def test_non_string_or_empty_tier_raises(bad):
+    with pytest.raises(DomainError) as err:
+        customers.customers_by_tier(bad)
+    assert err.value.code == "E_BAD_INPUT"
+
+
+def test_read_only_no_event_no_mutation():
+    customers.add_customer("Acme", tier="gold")
+    before_events = len(events.OUTBOX)
+    before_customers = dict(db.customers)
+    customers.customers_by_tier("gold")
+    assert len(events.OUTBOX) == before_events
+    assert db.customers == before_customers
