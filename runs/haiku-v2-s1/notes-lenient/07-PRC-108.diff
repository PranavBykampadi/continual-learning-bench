--- a/tests/unit/test_reports.py	1969-12-31 19:00:00
+++ b/tests/unit/test_reports.py	2026-11-12 01:58:13
@@ -0,0 +1,66 @@
+import pytest
+
+from parcelo import audit, customers, invoices, reports, shipments
+from parcelo.money import Money
+
+
+def _invoice(customer, amount, status="open"):
+    shipment = shipments.create_shipment(customer.id, 1.0, "local")
+    inv = invoices.issue_invoice(shipment.id)
+    inv.amount = amount
+    inv.status = status
+    return inv
+
+
+def test_sums_open_invoices_per_customer():
+    acme = customers.add_customer("Acme")
+    _invoice(acme, 10.50)
+    _invoice(acme, 4.25)
+    result = reports.outstanding_by_customer()
+    assert result[acme.id] == Money(1475)
+
+
+def test_excludes_paid_and_void_invoices():
+    acme = customers.add_customer("Acme")
+    _invoice(acme, 10.00, status="paid")
+    _invoice(acme, 7.00, status="void")
+    _invoice(acme, 3.00)
+    assert reports.outstanding_by_customer()[acme.id] == Money(300)
+
+
+def test_customer_with_nothing_open_is_zero():
+    acme = customers.add_customer("Acme")
+    _invoice(acme, 10.00, status="paid")
+    assert reports.outstanding_by_customer() == {acme.id: Money.zero()}
+
+
+def test_each_customer_gets_own_total():
+    acme = customers.add_customer("Acme")
+    beta = customers.add_customer("Beta")
+    _invoice(acme, 1.00)
+    _invoice(beta, 2.00)
+    result = reports.outstanding_by_customer()
+    assert result[acme.id] == Money(100)
+    assert result[beta.id] == Money(200)
+
+
+def test_no_customers_gives_empty_dict():
+    assert reports.outstanding_by_customer() == {}
+
+
+@pytest.mark.parametrize("amount", [0.10, 0.20, 0.30])
+def test_float_amounts_add_exactly(amount):
+    acme = customers.add_customer("Acme")
+    for _ in range(3):
+        _invoice(acme, amount)
+    assert reports.outstanding_by_customer()[acme.id] == Money.parse(amount).scale(3)
+
+
+def test_read_only_leaves_state_and_audit_unchanged():
+    acme = customers.add_customer("Acme")
+    inv = _invoice(acme, 5.00)
+    audit.LOG.clear()
+    before = (inv.amount, inv.status)
+    reports.outstanding_by_customer()
+    assert (inv.amount, inv.status) == before
+    assert audit.LOG == []
