 from datetime import datetime
 
+from parcelo.money import Money
 from parcelo.store import db
+
+
+def outstanding_by_customer():
+    """Map each customer id to the Money total of its open invoices.
+
+    Paid and void invoices are excluded. Customers with nothing open map to zero.
+    """
+    totals = {customer_id: Money.zero() for customer_id in db.customers}
+    for invoice in db.invoices.values():
+        if invoice.status != "open":
+            continue
+        shipment = db.shipments.get(invoice.shipment_id)
+        if shipment is None:
+            continue
+        customer_id = shipment.customer_id
+        totals[customer_id] = totals.get(customer_id, Money.zero()) + Money.parse(
+            invoice.amount
+        )
+    return totals
 
 
