diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_customer_addresses.py b/tests/unit/test_customer_addresses.py
--- a/tests/unit/test_customer_addresses.py	1969-12-31 19:00:00
+++ b/tests/unit/test_customer_addresses.py	2026-11-12 01:59:21
@@ -0,0 +1,47 @@
+import pytest
+
+from parcelo import audit, customers
+from parcelo.errors import DomainError
+from parcelo.models import Address
+from parcelo.store import db
+
+
+def test_add_address_stores_and_returns():
+    c = customers.add_customer("Acme")
+    addr = customers.add_address(c.id, "12 High St", "Leeds")
+    assert isinstance(addr, Address)
+    assert addr.id.startswith("adr_")
+    assert addr.customer_id == c.id
+    assert addr.line == "12 High St"
+    assert addr.city == "Leeds"
+    assert db.addresses[addr.id] is addr
+
+
+def test_add_address_records_audit():
+    c = customers.add_customer("Acme")
+    addr = customers.add_address(c.id, "12 High St", "Leeds")
+    assert audit.LOG[-1]["action"] == "address.added"
+    assert audit.LOG[-1]["entity_id"] == addr.id
+
+
+def test_unknown_customer():
+    with pytest.raises(DomainError) as err:
+        customers.add_address("nope", "12 High St", "Leeds")
+    assert err.value.code == "E_UNKNOWN_CUSTOMER"
+    assert db.addresses == {}
+
+
+@pytest.mark.parametrize("line, city", [
+    ("", "Leeds"),
+    ("   ", "Leeds"),
+    (None, "Leeds"),
+    ("12 High St", ""),
+    ("12 High St", "  "),
+    ("12 High St", None),
+])
+def test_blank_line_or_city_rejected(line, city):
+    c = customers.add_customer("Acme")
+    with pytest.raises(DomainError) as err:
+        customers.add_address(c.id, line, city)
+    assert err.value.code == "E_BAD_INPUT"
+    assert db.addresses == {}
