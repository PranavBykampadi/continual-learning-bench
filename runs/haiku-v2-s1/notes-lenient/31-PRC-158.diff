diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/test_returns.py b/tests/test_returns.py
--- a/tests/test_returns.py	1969-12-31 19:00:00
+++ b/tests/test_returns.py	2026-11-12 02:20:44
@@ -0,0 +1,87 @@
+import pytest
+
+from parcelo import clock, customers, events, returns, shipments
+from parcelo.errors import DomainError
+from parcelo.store import db
+
+
+def _delivered_shipment():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 2, "local")
+    s.status = "delivered"
+    return s
+
+
+def test_request_return_creates_request():
+    clock.set_fixed("2026-11-12T10:00:00+00:00")
+    s = _delivered_shipment()
+    events.OUTBOX.clear()
+    r = returns.request_return(s.id, "damaged")
+    assert r.id.startswith("ret_")
+    assert r.shipment_id == s.id
+    assert r.reason == "damaged"
+    assert r.requested_at == "2026-11-12T10:00:00+00:00"
+    assert db.returns[r.id] is r
+    assert events.OUTBOX[-1]["name"] == "return.requested"
+    clock.clear_fixed()
+
+
+def test_request_return_unknown_shipment():
+    with pytest.raises(DomainError) as exc:
+        returns.request_return("shp_999999", "damaged")
+    assert exc.value.code == "E_NOT_FOUND"
+
+
+@pytest.mark.parametrize("bad_id", [None, "", 7, ["shp_000001"]])
+def test_request_return_bad_shipment_id(bad_id):
+    with pytest.raises(DomainError) as exc:
+        returns.request_return(bad_id, "damaged")
+    assert exc.value.code == "E_BAD_INPUT"
+
+
+@pytest.mark.parametrize("bad_reason", [None, "", 3])
+def test_request_return_bad_reason(bad_reason):
+    s = _delivered_shipment()
+    with pytest.raises(DomainError) as exc:
+        returns.request_return(s.id, bad_reason)
+    assert exc.value.code == "E_BAD_INPUT"
+
+
+@pytest.mark.parametrize("status", ["created", "in_transit"])
+def test_request_return_not_delivered(status):
+    s = _delivered_shipment()
+    s.status = status
+    with pytest.raises(DomainError) as exc:
+        returns.request_return(s.id, "damaged")
+    assert exc.value.code == "E_BAD_STATE"
+    assert returns.returns_for(s.id) == []
+
+
+def test_request_return_limit_is_three():
+    s = _delivered_shipment()
+    for i in range(3):
+        returns.request_return(s.id, f"reason {i}")