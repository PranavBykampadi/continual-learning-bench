diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/parcelo/returns.py b/parcelo/returns.py
--- a/parcelo/returns.py	1969-12-31 19:00:00
+++ b/parcelo/returns.py	2026-11-12 02:20:39
@@ -0,0 +1,35 @@
+from parcelo import clock, events, ids
+from parcelo.errors import DomainError
+from parcelo.models import ReturnRequest
+from parcelo.store import db
+
+MAX_RETURNS_PER_SHIPMENT = 3
+
+
+def request_return(shipment_id, reason):
+    if not isinstance(shipment_id, str) or not shipment_id:
+        raise DomainError("E_BAD_INPUT", repr(shipment_id))
+    if not isinstance(reason, str) or not reason:
+        raise DomainError("E_BAD_INPUT", repr(reason))
+    if shipment_id not in db.shipments:
+        raise DomainError("E_NOT_FOUND", shipment_id)
+    shipment = db.shipments[shipment_id]
+    if shipment.status != "delivered":
+        raise DomainError("E_BAD_STATE", f"{shipment_id} is {shipment.status}")
+    if len(returns_for(shipment_id)) >= MAX_RETURNS_PER_SHIPMENT:
+        raise DomainError("E_LIMIT", f"{shipment_id} already has {MAX_RETURNS_PER_SHIPMENT} return requests")
+    request = ReturnRequest(
+        id=ids.new_id("ret"),
+        shipment_id=shipment_id,
+        reason=reason,
+        requested_at=clock.now(),
+    )
+    db.returns[request.id] = request
+    events.emit("return.requested", request.id, shipment_id=shipment_id)
+    return request
+
+
+def returns_for(shipment_id):
+    if not isinstance(shipment_id, str) or not shipment_id:
+        raise DomainError("E_BAD_INPUT", repr(shipment_id))
+    return [r for r in db.returns.values() if r.shipment_id == shipment_id]
