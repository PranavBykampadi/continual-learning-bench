diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/parcelo/vouchers.py b/parcelo/vouchers.py
--- a/parcelo/vouchers.py	1969-12-31 19:00:00
+++ b/parcelo/vouchers.py	2026-11-12 02:25:22
@@ -0,0 +1,37 @@
+from decimal import Decimal, InvalidOperation
+
+from parcelo import clock, events, ids, settings
+from parcelo.errors import DomainError
+from parcelo.models import Voucher
+from parcelo.money import Money
+from parcelo.store import db
+
+
+def issue_voucher(customer_id, amount):
+    """Issue a goodwill voucher. Not idempotent: every call creates a new voucher, so do not retry."""
+    if not isinstance(customer_id, str) or not customer_id:
+        raise DomainError("E_BAD_INPUT", "customer_id")
+    if isinstance(amount, bool) or not isinstance(amount, (int, float, Decimal)):
+        raise DomainError("E_BAD_INPUT", "amount")
+    try:
+        value = Decimal(str(amount))
+    except InvalidOperation:
+        raise DomainError("E_BAD_INPUT", "amount")
+    if not value.is_finite() or value <= 0:
+        raise DomainError("E_BAD_INPUT", "amount")
+    money = Money.parse(amount)
+    if money.cents <= 0:
+        raise DomainError("E_BAD_INPUT", "amount")
+    if customer_id not in db.customers:
+        raise DomainError("E_NOT_FOUND", customer_id)
+    if money.cents > settings.MAX_VOUCHER_CENTS:
+        raise DomainError("E_LIMIT", str(money))
+    voucher = Voucher(
+        id=ids.new_id("vch"),
+        customer_id=customer_id,
+        amount=money,
+        issued_at=clock.now(),
+    )
+    db.vouchers[voucher.id] = voucher
+    events.emit("voucher.issued", voucher.id, customer_id=customer_id)
+    return voucher
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_vouchers.py b/tests/unit/test_vouchers.py
--- a/tests/unit/test_vouchers.py	1969-12-31 19:00:00
+++ b/tests/unit/test_vouchers.py	2026-11-12 02:25:25
@@ -0,0 +1,64 @@
+import pytest
+
+from parcelo import customers, events, vouchers
+from parcelo.errors import DomainError
+from parcelo.money import Money
+from parcelo.store import db
+
+
+def test_issue_voucher_creates_and_emits():
+    c = customers.add_customer("Acme")
+    v = vouchers.issue_voucher(c.id, 25)
+    assert v.id.startswith("vch_")
+    assert v.customer_id == c.id
+    assert v.amount == Money.parse(25)
+    assert v.issued_at is not None
+    assert db.vouchers[v.id] is v
+    assert events.OUTBOX[-1]["name"] == "voucher.issued"
+    assert events.OUTBOX[-1]["entity_id"] == v.id
+
+
+def test_issue_voucher_at_limit_is_allowed():
+    c = customers.add_customer("Acme")
+    v = vouchers.issue_voucher(c.id, 150.00)
+    assert v.amount.cents == 15000
+
+
+def test_issue_voucher_unknown_customer():
+    with pytest.raises(DomainError) as exc:
+        vouchers.issue_voucher("nope", 10)
+    assert exc.value.code == "E_NOT_FOUND"
+    assert db.vouchers == {}
+
+
+def test_issue_voucher_over_limit():
+    c = customers.add_customer("Acme")
+    with pytest.raises(DomainError) as exc:
+        vouchers.issue_voucher(c.id, 150.01)
+    assert exc.value.code == "E_LIMIT"
+    assert db.vouchers == {}
+
+
+@pytest.mark.parametrize("amount", [0, -5, -0.01, 0.001, float("nan"), float("inf")])
+def test_issue_voucher_nonpositive_or_nonfinite_amount(amount):
+    c = customers.add_customer("Acme")
+    events.OUTBOX.clear()
+    with pytest.raises(DomainError) as exc:
+        vouchers.issue_voucher(c.id, amount)
+    assert exc.value.code == "E_BAD_INPUT"
+    assert events.OUTBOX == []
+
+
