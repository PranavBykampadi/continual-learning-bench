+def apply_credit(invoice_id, amount):
+    """Reduce an open invoice by a credit and return the remaining amount.
+
+    Validation runs before anything is stored, so a failed call leaves no
+    partial state behind.
+    """
+    if not (isinstance(invoice_id, str) and invoice_id.strip()):
+        raise DomainError("E_BAD_INPUT", "invoice_id must be a non-empty string")
+    try:
+        credit = Money.parse(amount)
+    except (TypeError, ValueError, ArithmeticError, InvalidOperation):
+        raise DomainError("E_BAD_INPUT", "credit amount is not a number: %r" % (amount,))
+    if credit.cents <= 0:
+        raise DomainError("E_BAD_INPUT", "credit must be positive")
+    if invoice_id not in db.invoices:
+        raise DomainError("E_NOT_FOUND", invoice_id)
+    invoice = db.invoices[invoice_id]
+    if invoice.status != "open":
+        raise DomainError("E_BAD_STATE", "invoice %s is not open" % invoice_id)
+    current = Money.parse(invoice.amount)
+    if current < credit:
+        raise DomainError("E_BAD_INPUT", "credit exceeds invoice amount")
+    remaining = current - credit
+    # Invoice amounts are stored as float dollars; reports and balances sum them.
+    invoice.amount = remaining.cents / 100
+    audit.record("invoice.credit_applied", invoice_id, credit_cents=credit.cents)
+    return invoice.amount
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_invoice_credit.py b/tests/unit/test_invoice_credit.py
--- a/tests/unit/test_invoice_credit.py	1969-12-31 19:00:00
+++ b/tests/unit/test_invoice_credit.py	2026-11-12 02:02:50
@@ -0,0 +1,94 @@
+import pytest
+
+from parcelo import audit, customers, invoices, reports, shipments
+from parcelo.errors import DomainError
+
+
+def _open_invoice(amount_kg=2):
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, amount_kg, "local")
+    inv = invoices.issue_invoice(s.id)
+    return c, inv
+
+
+def test_apply_credit_returns_remaining_and_updates_invoice():
+    _, inv = _open_invoice()
+    assert invoices.apply_credit(inv.id, 2.5) == 4.5
+    assert inv.amount == 4.5
+    assert inv.status == "open"
+
+
+def test_apply_credit_handles_cents_exactly():
+    _, inv = _open_invoice()
+    assert invoices.apply_credit(inv.id, "0.10") == 6.9
+
+
+def test_credit_equal_to_amount_leaves_zero():
+    _, inv = _open_invoice()
+    assert invoices.apply_credit(inv.id, 7.0) == 0.0
+    assert inv.amount == 0.0
+
+
+def test_credit_flows_into_customer_balance_and_revenue():
+    c, inv = _open_invoice()
+    invoices.apply_credit(inv.id, 2.5)
+    assert customers.outstanding_balance(c.id) == 4.5
+    invoices.mark_paid(inv.id)
+    assert reports.revenue_total() == 4.5
+
+
+def test_apply_credit_records_audit():
+    _, inv = _open_invoice()
+    invoices.apply_credit(inv.id, 1)
+    assert audit.LOG[-1]["action"] == "invoice.credit_applied"
+    assert audit.LOG[-1]["entity_id"] == inv.id
+
+
+def test_unknown_invoice_is_not_found():
+    with pytest.raises(DomainError) as err:
+        invoices.apply_credit("INV-missing", 1)
+    assert err.value.code == "E_NOT_FOUND"
+
+
+def test_paid_invoice_is_bad_state():
+    _, inv = _open_invoice()
+    invoices.mark_paid(inv.id)
+    with pytest.raises(DomainError) as err:
+        invoices.apply_credit(inv.id, 1)
+    assert err.value.code == "E_BAD_STATE"
+    assert inv.amount == 7.0
+    assert audit.LOG[-1]["action"] != "invoice.credit_applied"
+
+
+def test_credit_larger_than_amount_is_rejected_without_change():
+    _, inv = _open_invoice()
+    with pytest.raises(DomainError) as err:
+        invoices.apply_credit(inv.id, 7.01)
+    assert err.value.code == "E_BAD_INPUT"
+    assert inv.amount == 7.0
+    assert all(e["action"] != "invoice.credit_applied" for e in audit.LOG)
+
+
+@pytest.mark.parametrize("credit", [0, -1, -0.5])
+def test_non_positive_credit_is_bad_input(credit):
+    _, inv = _open_invoice()
+    with pytest.raises(DomainError) as err:
+        invoices.apply_credit(inv.id, credit)
+    assert err.value.code == "E_BAD_INPUT"
+    assert inv.amount == 7.0
+
+
+@pytest.mark.parametrize("credit", [None, "abc", float("nan"), [1]])
+def test_non_numeric_credit_is_bad_input(credit):
+    _, inv = _open_invoice()
+    with pytest.raises(DomainError) as err:
+        invoices.apply_credit(inv.id, credit)
+    assert err.value.code == "E_BAD_INPUT"
+    assert inv.amount == 7.0
+
+
+@pytest.mark.parametrize("invoice_id", ["", "   ", None, 42])
+def test_blank_or_non_string_invoice_id_is_bad_input(invoice_id):
+    with pytest.raises(DomainError) as err:
+        invoices.apply_credit(invoice_id, 1)
+    assert err.value.code == "E_BAD_INPUT"
