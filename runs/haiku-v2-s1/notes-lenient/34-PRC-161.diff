+"""Business thresholds and rates. Finance changes these; keep them all here."""
+
+# Volume rebate on paid invoices (customers.rebate_for).
+# Cut-offs match parcelo.legacy.billing.volume_tier.
+REBATE_REGULAR_MIN_SHIPMENTS = 10
+REBATE_REGULAR_RATE = 0.03
+REBATE_BULK_MIN_SHIPMENTS = 50
+REBATE_BULK_RATE = 0.06
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_customers.py b/tests/unit/test_customers.py
--- a/tests/unit/test_customers.py	1969-12-31 19:00:00
+++ b/tests/unit/test_customers.py	2026-11-12 02:23:05
@@ -0,0 +1,63 @@
+import pytest
+
+from parcelo import customers, invoices, shipments
+from parcelo.errors import DomainError
+
+
+def _paid_shipments(customer_id, count, weight_kg=2):
+    """Create `count` shipments for the customer and pay an invoice for each.
+
+    At 2 kg local each invoice is 7.00.
+    """
+    for _ in range(count):
+        s = shipments.create_shipment(customer_id, weight_kg, "local")
+        inv = invoices.issue_invoice(s.id)
+        invoices.mark_paid(inv.id)
+
+
+def test_rebate_for_zero_below_regular_cutoff():
+    c = customers.add_customer("Acme")
+    _paid_shipments(c.id, 9)
+    assert customers.rebate_for(c.id) == 0.0
+
+
+def test_rebate_for_regular_rate_at_ten_shipments():
+    c = customers.add_customer("Acme")
+    _paid_shipments(c.id, 10)
+    assert customers.rebate_for(c.id) == pytest.approx(2.1)
+
+
+def test_rebate_for_bulk_rate_at_fifty_shipments():
+    c = customers.add_customer("Acme")
+    _paid_shipments(c.id, 50)
+    assert customers.rebate_for(c.id) == pytest.approx(21.0)
+
+
+def test_rebate_for_ignores_unpaid_invoices():
+    c = customers.add_customer("Acme")
+    _paid_shipments(c.id, 10)
+    s = shipments.create_shipment(c.id, 2, "local")
+    invoices.issue_invoice(s.id)  # open, not paid
+    assert customers.rebate_for(c.id) == pytest.approx(2.1)
+
+
+def test_rebate_for_ignores_other_customers():
+    a = customers.add_customer("Acme")
+    b = customers.add_customer("Other")
+    _paid_shipments(a.id, 10)
+    _paid_shipments(b.id, 3)
+    assert customers.rebate_for(a.id) == pytest.approx(2.1)
+    assert customers.rebate_for(b.id) == 0.0
+
+
+def test_rebate_for_unknown_customer():
+    with pytest.raises(DomainError) as exc:
+        customers.rebate_for("C-missing")
+    assert exc.value.code == "E_NOT_FOUND"
+
+
+@pytest.mark.parametrize("bad", [None, "", 123])
+def test_rebate_for_bad_input(bad):
+    with pytest.raises(DomainError) as exc:
+        customers.rebate_for(bad)
+    assert exc.value.code == "E_BAD_INPUT"
