+def rebate_for(customer_id):
+    """Volume rebate earned on the customer's paid invoices.
+
+    Read-only, so safe to retry. Returns 0.0 below the regular cut-off.
+    The cut-offs mirror parcelo.legacy.billing.volume_tier; legacy is not imported.
+    """
+    if not isinstance(customer_id, str) or not customer_id:
+        raise DomainError("E_BAD_INPUT", repr(customer_id))
+    if customer_id not in db.customers:
+        raise DomainError("E_NOT_FOUND", customer_id)
+
+    shipment_count = 0
+    for shipment in db.shipments.values():
+        if shipment.customer_id == customer_id:
+            shipment_count += 1
+
+    if shipment_count >= settings.REBATE_BULK_MIN_SHIPMENTS:
+        rate = settings.REBATE_BULK_RATE
+    elif shipment_count >= settings.REBATE_REGULAR_MIN_SHIPMENTS:
+        rate = settings.REBATE_REGULAR_RATE
+    else:
+        return 0.0
+
+    paid_total = 0.0
+    for invoice in db.invoices.values():
+        shipment = db.shipments.get(invoice.shipment_id)
+        if shipment is None or shipment.customer_id != customer_id:
+            continue
+        if invoice.status == "paid":
+            paid_total += invoice.amount
+    return round(paid_total * rate, 2)
