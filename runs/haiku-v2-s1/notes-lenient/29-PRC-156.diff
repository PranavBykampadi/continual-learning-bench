+
+def test_heavy_quote_at_or_below_threshold_is_normal_quote():
+    assert rates.heavy_quote(30, "local") == rates.quote(30, "local")
+    assert rates.heavy_quote(2, "national") == rates.quote(2, "national")
+
+
+def test_heavy_quote_adds_surcharge_above_30kg():
+    # 4.5 + 1.25 * 32 = 44.5, plus 0.75 * 2 = 1.5
+    assert rates.heavy_quote(32, "local") == 46.0
+
+
+def test_heavy_quote_prorates_partial_kg():
+    assert rates.heavy_quote(31, "local") == rates.quote(31, "local") + 0.75
+    assert rates.heavy_quote(30.5, "local") == pytest.approx(
+        rates.quote(30.5, "local") + 0.375, abs=0.01
+    )
+
+
+def test_heavy_quote_unknown_zone():
+    with pytest.raises(DomainError) as exc:
+        rates.heavy_quote(40, "moon")
+    assert exc.value.code == "E_BAD_INPUT"
+
+
+@pytest.mark.parametrize("weight", [0, -1, float("nan"), float("inf")])
+def test_heavy_quote_bad_weight(weight):
+    with pytest.raises(DomainError) as exc:
+        rates.heavy_quote(weight, "local")
+    assert exc.value.code == "E_BAD_WEIGHT"
+
+
+@pytest.mark.parametrize("weight", [None, "10", True, [5]])
+def test_heavy_quote_bad_type(weight):
+    with pytest.raises(DomainError) as exc:
