     return round(base_rate(zone) + PER_KG * weight_kg, 2)
+
+
+def heavy_quote(weight_kg, zone):
+    """Quote for heavy parcels: the normal quote plus 0.75 per kg above 30 kg.
+
+    Parcels of 30 kg or less get the normal quote. The surcharge is
+    pro-rated for partial kilograms.
+    """
+    # Validate everything before doing any work.
+    if isinstance(weight_kg, bool) or not isinstance(weight_kg, (int, float, Decimal)):
+        raise DomainError("E_BAD_INPUT", "weight_kg must be a number")
+    if not isinstance(zone, str) or not zone:
+        raise DomainError("E_BAD_INPUT", "zone must be a non-empty string")
+    if zone not in ZONE_BASE:
+        raise DomainError("E_BAD_INPUT", "unknown zone: %s" % zone)
+    weight = float(weight_kg)
+    if not math.isfinite(weight) or weight <= 0:
+        raise DomainError("E_BAD_WEIGHT", "weight must be positive and finite")
+
+    total = Money.parse(quote(weight, zone))
+    excess = weight - HEAVY_THRESHOLD_KG
+    if excess > 0:
+        total = total + Money.parse(HEAVY_SURCHARGE_PER_KG).scale(excess)
+    return total.cents / 100
