+def hold_invoice(invoice_id):
+    """Pause collection on an open invoice. Idempotent: holding an invoice that is already on hold returns it unchanged."""
+    if not isinstance(invoice_id, str) or not invoice_id:
+        raise DomainError("E_BAD_INPUT", repr(invoice_id))
+    if invoice_id not in db.invoices:
+        raise DomainError("E_NOT_FOUND", invoice_id)
+    invoice = db.invoices[invoice_id]
+    if invoice.status == "on_hold":
+        return invoice
+    if invoice.status != "open":
+        raise DomainError("E_BAD_STATE", f"{invoice_id} is {invoice.status}")
+    invoice.status = "on_hold"
+    invoice.held_at = clock.now()
+    events.emit("invoice.held", invoice.id, shipment_id=invoice.shipment_id)
     return invoice
 
 
