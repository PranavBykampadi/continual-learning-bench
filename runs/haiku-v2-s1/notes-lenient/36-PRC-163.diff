diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_customers.py b/tests/unit/test_customers.py
--- a/tests/unit/test_customers.py	1969-12-31 19:00:00
+++ b/tests/unit/test_customers.py	2026-11-12 02:24:32
@@ -0,0 +1,52 @@
+import pytest
+
+from parcelo import customers, events, store
+from parcelo.errors import DomainError
+
+
+def test_new_customer_is_not_locked():
+    c = customers.add_customer("Acme")
+    assert c.locked is False
+
+
+def test_lock_customer_sets_flag():
+    c = customers.add_customer("Acme")
+    locked = customers.lock_customer(c.id)
+    assert locked.locked is True
+    assert store.db.customers[c.id].locked is True
+
+
+def test_lock_customer_returns_same_customer():
+    c = customers.add_customer("Acme")
+    assert customers.lock_customer(c.id) is c
+
+
+def test_lock_customer_emits_event():
+    c = customers.add_customer("Acme")
+    events.OUTBOX.clear()
+    customers.lock_customer(c.id)
+    assert len(events.OUTBOX) == 1
+    assert events.OUTBOX[-1]["name"] == "customer.locked"
+    assert events.OUTBOX[-1]["entity_id"] == c.id
+
+
+def test_lock_customer_already_locked_is_noop():
+    c = customers.add_customer("Acme")
+    customers.lock_customer(c.id)
+    events.OUTBOX.clear()
+    again = customers.lock_customer(c.id)
+    assert again.locked is True
+    assert events.OUTBOX == []
+
+
+def test_lock_customer_unknown_customer_not_found():
+    with pytest.raises(DomainError) as exc:
+        customers.lock_customer("C_missing")
+    assert exc.value.code == "E_NOT_FOUND"
+
+
+@pytest.mark.parametrize("bad", ["", None, 42, ["C1"], ("C1",)])
+def test_lock_customer_bad_input(bad):
+    with pytest.raises(DomainError) as exc:
+        customers.lock_customer(bad)
+    assert exc.value.code == "E_BAD_INPUT"
