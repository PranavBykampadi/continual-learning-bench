@@ -0,0 +1,104 @@
+import dataclasses
+
+import pytest
+
+from parcelo import customers, events, shipments
+from parcelo.errors import DomainError
+from parcelo.store import db
+
+
+def _make_shipment(weight=10.0, zone="national"):
+    c = customers.add_customer("Acme")
+    return shipments.create_shipment(c.id, weight, zone)
+
+
+def test_split_happy_path_returns_new_shipments_in_weight_order():
+    s = _make_shipment(weight=10.0, zone="national")
+    before = len(events.OUTBOX)
+
+    parts = shipments.split_shipment(s.id, [3.0, 7.0])
+
+    assert [p.weight_kg for p in parts] == [3.0, 7.0]
+    for p in parts:
+        assert p.id.startswith("shp_")
+        assert p.id != s.id
+        assert p.customer_id == s.customer_id
+        assert p.zone == "national"
+        assert p.status == "created"
+        assert db.shipments[p.id] is p
+    assert db.shipments[s.id].status == "split"
+    names = [e["name"] for e in events.OUTBOX[before:]]
+    assert names == ["shipment.created", "shipment.created", "shipment.split"]
+    assert events.OUTBOX[-1]["entity_id"] == s.id
+
+
+def test_split_unknown_id_raises_not_found():
+    with pytest.raises(DomainError) as err:
+        shipments.split_shipment("shp_missing", [1.0])
+    assert err.value.code == "E_NOT_FOUND"
+
+
+def test_split_wrong_state_raises_bad_state():
+    s = _make_shipment(weight=10.0)
+    shipments.split_shipment(s.id, [4.0, 6.0])
+    before_events = len(events.OUTBOX)
+    snapshot = dataclasses.asdict(db.shipments[s.id])
+    count = len(db.shipments)
+
+    with pytest.raises(DomainError) as err:
+        shipments.split_shipment(s.id, [4.0, 6.0])
+
+    assert err.value.code == "E_BAD_STATE"
+    assert dataclasses.asdict(db.shipments[s.id]) == snapshot
+    assert len(db.shipments) == count
+    assert len(events.OUTBOX) == before_events
+
+
+@pytest.mark.parametrize(
+    "weights",
+    [None, [], "   ", 5.0, [[1.0], [9.0]]],
+    ids=["none", "empty", "whitespace", "wrong_type", "list_element"],
+)
+def test_split_bad_input_raises_bad_input(weights):
+    s = _make_shipment(weight=10.0)
+    snapshot = dataclasses.asdict(db.shipments[s.id])
+    count = len(db.shipments)
+    before_events = len(events.OUTBOX)
+
