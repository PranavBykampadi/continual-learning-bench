+def split_shipment(shipment_id, weights):
+    """Replace a "created" shipment with one new shipment per weight.
+
+    The original is marked "split". New shipments keep its customer and zone
+    and are returned in the same order as ``weights``. Weights must sum to the
+    original weight. All checks run before anything is mutated.
+    """
+    # Validate input.
+    if not isinstance(weights, (list, tuple)) or len(weights) == 0:
+        raise DomainError("E_BAD_INPUT", "weights must be a non-empty list")
+    for w in weights:
+        if isinstance(w, bool) or not isinstance(w, (int, float)):
+            raise DomainError("E_BAD_INPUT", repr(w))
+        if not math.isfinite(w) or w <= 0:
+            raise DomainError("E_BAD_WEIGHT", str(w))
+
+    # Check existence and state.
+    if shipment_id not in db.shipments:
+        raise DomainError("E_NOT_FOUND", shipment_id)
+    original = db.shipments[shipment_id]
+    if original.status != "created":
+        raise DomainError("E_BAD_STATE", f"{shipment_id} is {original.status}")
+
+    # Check that the parts add up to the whole.
+    if not math.isclose(sum(weights), original.weight_kg, rel_tol=1e-9, abs_tol=1e-9):
+        raise DomainError(
+            "E_BAD_WEIGHT", f"weights sum to {sum(weights)}, shipment weighs {original.weight_kg}"
+        )
+
+    # Mutate and emit.
+    new_shipments = []
+    for w in weights:
+        child = Shipment(
+            id=ids.new_id("shp"),
+            customer_id=original.customer_id,
+            weight_kg=w,
+            zone=original.zone,
+            created_at=clock.now(),
+        )
+        db.shipments[child.id] = child
+        new_shipments.append(child)
+    original.status = "split"
+    for child in new_shipments:
+        events.emit("shipment.created", child.id, zone=child.zone)
+    events.emit("shipment.split", original.id, children=[c.id for c in new_shipments])
+    return new_shipments
