     if shipment_id not in db.shipments:
         raise DomainError("E_NOT_FOUND", shipment_id)
     return db.shipments[shipment_id]
+
+
+def add_note(shipment_id, text):
+    if not isinstance(text, str) or not text.strip():
+        raise DomainError("E_BAD_INPUT", "note text must be a non-empty string")
+    if shipment_id not in db.shipments:
+        raise DomainError("E_NOT_FOUND", shipment_id)
+    shipment = db.shipments[shipment_id]
+    at = clock.now()
+    shipment.notes.append({"text": text, "at": at})
+    audit.record("shipment.note_added", shipment_id, length=len(text))
+    return shipment
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_shipment_notes.py b/tests/unit/test_shipment_notes.py
--- a/tests/unit/test_shipment_notes.py	1969-12-31 19:00:00
+++ b/tests/unit/test_shipment_notes.py	2026-11-12 02:00:59
@@ -0,0 +1,54 @@
+import datetime as dt
+
+import pytest
+
+from parcelo import audit, clock, customers, shipments
+from parcelo.errors import DomainError
+
+
+def _shipment():
+    c = customers.add_customer("Acme")
+    return shipments.create_shipment(c.id, 1.0, "national")
+
+
+def test_add_note_appends_text_and_time():
+    moment = dt.datetime(2026, 11, 12, 9, 30, tzinfo=dt.timezone.utc)
+    clock.set_fixed(moment)
+    s = _shipment()
+    result = shipments.add_note(s.id, "left at front desk")
+    assert result is s
+    assert s.notes == [{"text": "left at front desk", "at": moment}]
+
+
+def test_add_note_keeps_each_time_separately():
+    s = _shipment()
+    first = dt.datetime(2026, 11, 12, 9, 0, tzinfo=dt.timezone.utc)
+    second = dt.datetime(2026, 11, 12, 10, 0, tzinfo=dt.timezone.utc)
+    clock.set_fixed(first)
+    shipments.add_note(s.id, "picked up")
+    clock.set_fixed(second)
+    shipments.add_note(s.id, "delivered late")
+    assert [n["text"] for n in s.notes] == ["picked up", "delivered late"]
+    assert [n["at"] for n in s.notes] == [first, second]
+
+
+def test_add_note_records_audit():
+    s = _shipment()
+    shipments.add_note(s.id, "call customer")
+    assert audit.LOG[-1]["action"] == "shipment.note_added"
+    assert audit.LOG[-1]["entity_id"] == s.id
+
+
+def test_add_note_unknown_shipment():
+    with pytest.raises(DomainError) as err:
+        shipments.add_note("shp_missing", "hello")
+    assert err.value.code == "E_NOT_FOUND"
+
+
+@pytest.mark.parametrize("text", ["", "   ", None, 42])
+def test_add_note_rejects_bad_text(text):
+    s = _shipment()
+    with pytest.raises(DomainError) as err:
+        shipments.add_note(s.id, text)
+    assert err.value.code == "E_BAD_INPUT"
+    assert s.notes == []
