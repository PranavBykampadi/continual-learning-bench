     if shipment_id not in db.shipments:
         raise DomainError("E_NOT_FOUND", shipment_id)
     return db.shipments[shipment_id]
+
+
+def list_shipments(customer_id):
+    if not isinstance(customer_id, str) or not customer_id.strip():
+        raise DomainError("E_BAD_INPUT", repr(customer_id))
+    if customer_id not in db.customers:
+        raise DomainError("E_UNKNOWN_CUSTOMER", customer_id)
+    return [s for s in db.shipments.values() if s.customer_id == customer_id]
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_list_shipments.py b/tests/unit/test_list_shipments.py
--- a/tests/unit/test_list_shipments.py	1969-12-31 19:00:00
+++ b/tests/unit/test_list_shipments.py	2026-11-12 02:13:16
@@ -0,0 +1,49 @@
+import dataclasses
+
+import pytest
+
+from parcelo import customers, events, shipments
+from parcelo.errors import DomainError
+
+
+def test_lists_only_that_customers_shipments():
+    a = customers.add_customer("Acme")
+    b = customers.add_customer("Globex")
+    s1 = shipments.create_shipment(a.id, 1.5, "national")
+    shipments.create_shipment(b.id, 2.0, "local")
+    s2 = shipments.create_shipment(a.id, 3.0, "local")
+
+    result = shipments.list_shipments(a.id)
+
+    assert isinstance(result, list)
+    assert [s.id for s in result] == [s1.id, s2.id]
+    assert all(s.customer_id == a.id for s in result)
+
+
+def test_customer_with_no_shipments_gets_empty_list():
+    c = customers.add_customer("Acme")
+    assert shipments.list_shipments(c.id) == []
+
+
+def test_unknown_customer():
+    with pytest.raises(DomainError) as err:
+        shipments.list_shipments("C_nope")
+    assert err.value.code == "E_UNKNOWN_CUSTOMER"
+
+
+@pytest.mark.parametrize("bad", [None, "", "   ", 42, ["C1"]])
+def test_bad_input(bad):
+    c = customers.add_customer("Acme")
+    shipments.create_shipment(c.id, 1.5, "national")
+    before_events = len(events.OUTBOX)
+    with pytest.raises(DomainError) as err:
+        shipments.list_shipments(bad)
+    assert err.value.code == "E_BAD_INPUT"
+    assert len(events.OUTBOX) == before_events
+
+
+def test_returned_shipments_match_stored_records():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 1.5, "national")
+    result = shipments.list_shipments(c.id)
+    assert dataclasses.asdict(result[0]) == dataclasses.asdict(s)
