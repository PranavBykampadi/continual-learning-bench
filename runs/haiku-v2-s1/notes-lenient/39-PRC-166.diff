+def escalate_invoice(invoice_id):
+    """Send an open invoice of at least 500.00 USD to the collections team.
+
+    Idempotent: safe to retry. An invoice that is already escalated is returned unchanged.
+    """
+    if not isinstance(invoice_id, str) or not invoice_id:
+        raise DomainError("E_BAD_INPUT", repr(invoice_id))
+    if invoice_id not in db.invoices:
+        raise DomainError("E_NOT_FOUND", invoice_id)
+    invoice = db.invoices[invoice_id]
+    if invoice.status == "escalated":
+        return invoice
+    if invoice.status != "open":
+        raise DomainError("E_BAD_STATE", invoice.status)
+    amount = Money.parse(invoice.amount)
+    if amount.cents < settings.ESCALATION_MIN_CENTS:
+        raise DomainError("E_LIMIT", str(amount))
+    invoice.status = "escalated"
+    events.emit("invoice.escalated", invoice.id)
+    return invoice
