+import math
+
+import pytest
+
+from parcelo import events, invoices, store
+from parcelo.errors import DomainError
+from parcelo.models import Invoice
+
+
+def _add_invoice(invoice_id="INV-1", amount=600.0, status="open"):
+    invoice = Invoice(id=invoice_id, shipment_id="shp_1", amount=amount, status=status)
+    store.db.invoices[invoice.id] = invoice
+    return invoice
+
+
+def _snapshot():
+    return {k: (v.status, v.amount) for k, v in store.db.invoices.items()}
+
+
+def test_escalate_invoice_sets_status_and_emits():
+    _add_invoice(amount=750.0)
+    events.OUTBOX.clear()
+    result = invoices.escalate_invoice("INV-1")
+    assert result.status == "escalated"
+    assert store.db.invoices["INV-1"].status == "escalated"
+    assert events.OUTBOX[-1]["name"] == "invoice.escalated"
+    assert events.OUTBOX[-1]["entity_id"] == "INV-1"
+
+
+def test_escalate_invoice_at_limit_succeeds():
+    _add_invoice(amount=500.0)
+    assert invoices.escalate_invoice("INV-1").status == "escalated"
+
+
+def test_escalate_invoice_just_below_limit_fails():
+    _add_invoice(amount=499.99)
+    events.OUTBOX.clear()
+    before = _snapshot()
+    with pytest.raises(DomainError) as exc:
+        invoices.escalate_invoice("INV-1")
+    assert exc.value.code == "E_LIMIT"
+    assert _snapshot() == before
+    assert events.OUTBOX == []
+
+
+def test_escalate_invoice_already_escalated_returns_unchanged():
+    _add_invoice(amount=600.0)
+    invoices.escalate_invoice("INV-1")
+    events.OUTBOX.clear()
+    before = _snapshot()
+    result = invoices.escalate_invoice("INV-1")
+    assert result.status == "escalated"
+    assert _snapshot() == before
+    assert events.OUTBOX == []
+
+
+def test_escalate_invoice_paid_fails():
+    _add_invoice(amount=600.0, status="paid")
+    events.OUTBOX.clear()
+    before = _snapshot()
+    with pytest.raises(DomainError) as exc:
+        invoices.escalate_invoice("INV-1")
+    assert exc.value.code == "E_BAD_STATE"
+    assert _snapshot() == before
+    assert events.OUTBOX == []
+
+
+def test_escalate_invoice_unknown_fails():
+    _add_invoice(amount=600.0)
+    events.OUTBOX.clear()
+    before = _snapshot()
+    with pytest.raises(DomainError) as exc:
+        invoices.escalate_invoice("INV-404")
+    assert exc.value.code == "E_NOT_FOUND"
+    assert _snapshot() == before
+    assert events.OUTBOX == []
+
+
+def test_escalate_invoice_wrong_case_is_not_found():
+    _add_invoice(invoice_id="INV-1", amount=600.0)
+    with pytest.raises(DomainError) as exc:
+        invoices.escalate_invoice("inv-1")
+    assert exc.value.code == "E_NOT_FOUND"
+    assert store.db.invoices["INV-1"].status == "open"
+    assert events.OUTBOX == []
+
+
