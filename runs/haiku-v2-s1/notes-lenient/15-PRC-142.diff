+def reopen_invoice(invoice_id):
+    if not isinstance(invoice_id, str) or not invoice_id.strip():
+        raise DomainError("E_BAD_INPUT", repr(invoice_id))
+    if invoice_id not in db.invoices:
+        raise DomainError("E_NOT_FOUND", invoice_id)
+    invoice = db.invoices[invoice_id]
+    if invoice.status != "paid":
+        raise DomainError("E_BAD_STATE", f"{invoice_id} is {invoice.status}, not paid")
+    invoice.status = "open"
+    invoice.paid_at = None
+    invoice.reopened_at = datetime.utcnow()
+    events.emit("invoice.reopened", invoice.id)
     return invoice
 
 
