diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_reopen_invoice.py b/tests/unit/test_reopen_invoice.py
--- a/tests/unit/test_reopen_invoice.py	1969-12-31 19:00:00
+++ b/tests/unit/test_reopen_invoice.py	2026-11-12 02:05:29
@@ -0,0 +1,76 @@
+import dataclasses
+from datetime import datetime
+
+import pytest
+
+from parcelo import customers, events, invoices, shipments
+from parcelo.errors import DomainError
+from parcelo.store import db
+
+
+def _open_invoice():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 2, "local")
+    return invoices.issue_invoice(s.id)
+
+
+def _paid_invoice():
+    inv = _open_invoice()
+    invoices.mark_paid(inv.id)
+    return inv
+
+
+def test_reopen_paid_invoice():
+    inv = _paid_invoice()
+    before = len(events.OUTBOX)
+
+    result = invoices.reopen_invoice(inv.id)
+
+    assert result is inv
+    assert inv.status == "open"
+    assert inv.paid_at is None
+    assert isinstance(inv.reopened_at, datetime)
+    assert db.invoices[inv.id].status == "open"
+    assert events.OUTBOX[before:][-1]["name"] == "invoice.reopened"
+    assert events.OUTBOX[-1]["entity_id"] == inv.id
+
+
+def test_reopened_invoice_counts_as_open_again():
+    inv = _paid_invoice()
+    invoices.reopen_invoice(inv.id)
+    assert inv in invoices.open_invoices()
+
+
+def test_unknown_invoice_is_not_found():
+    before = len(events.OUTBOX)
+    with pytest.raises(DomainError) as err:
+        invoices.reopen_invoice("INV-missing")
+    assert err.value.code == "E_NOT_FOUND"
+    assert len(events.OUTBOX) == before
+
+
+def test_open_invoice_is_bad_state():
+    inv = _open_invoice()
+    snapshot = dataclasses.asdict(inv)
+    before = len(events.OUTBOX)
+
+    with pytest.raises(DomainError) as err:
+        invoices.reopen_invoice(inv.id)
+
+    assert err.value.code == "E_BAD_STATE"
+    assert dataclasses.asdict(db.invoices[inv.id]) == snapshot
+    assert len(events.OUTBOX) == before
+
+
+@pytest.mark.parametrize("bad", [None, "", "   ", 123, ["INV-x"]])
+def test_bad_input_is_rejected(bad):
+    inv = _paid_invoice()
+    snapshot = dataclasses.asdict(inv)
+    before = len(events.OUTBOX)
+
+    with pytest.raises(DomainError) as err:
+        invoices.reopen_invoice(bad)
+
+    assert err.value.code == "E_BAD_INPUT"
+    assert dataclasses.asdict(db.invoices[inv.id]) == snapshot
+    assert len(events.OUTBOX) == before
