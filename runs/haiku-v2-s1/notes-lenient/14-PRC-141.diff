+def reassign_shipment(shipment_id, new_customer_id):
+    if not (isinstance(shipment_id, str) and shipment_id.strip()):
+        raise DomainError("E_BAD_INPUT", "shipment_id")
+    if not (isinstance(new_customer_id, str) and new_customer_id.strip()):
+        raise DomainError("E_BAD_INPUT", "new_customer_id")
+    if shipment_id not in db.shipments:
+        raise DomainError("E_NOT_FOUND", shipment_id)
+    if new_customer_id not in db.customers:
+        raise DomainError("E_UNKNOWN_CUSTOMER", new_customer_id)
+    shipment = db.shipments[shipment_id]
+    if shipment.status == "delivered":
+        raise DomainError("E_BAD_STATE", shipment_id)
+    old_customer_id = shipment.customer_id
+    shipment.customer_id = new_customer_id
+    audit.record(
+        "shipment.reassigned",
+        shipment_id,
+        old_customer_id=old_customer_id,
+        new_customer_id=new_customer_id,
+    )
+    return shipment
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_reassign_shipment.py b/tests/unit/test_reassign_shipment.py
--- a/tests/unit/test_reassign_shipment.py	1969-12-31 19:00:00
+++ b/tests/unit/test_reassign_shipment.py	2026-11-12 02:04:39
@@ -0,0 +1,72 @@
+import pytest
+
+from parcelo import audit, customers, shipments
+from parcelo.errors import DomainError
+
+
+def _setup():
+    a = customers.add_customer("Acme")
+    b = customers.add_customer("Beta")
+    s = shipments.create_shipment(a.id, 2.0, "national")
+    audit.LOG.clear()
+    return a, b, s
+
+
+def test_reassign_changes_customer_and_audits():
+    a, b, s = _setup()
+    result = shipments.reassign_shipment(s.id, b.id)
+    assert result is s
+    assert s.customer_id == b.id
+    assert len(audit.LOG) == 1
+    entry = audit.LOG[-1]
+    assert entry["action"] == "shipment.reassigned"
+    assert entry["entity_id"] == s.id
+    assert entry["details"] == {"old_customer_id": a.id, "new_customer_id": b.id}
+
+
+def test_unknown_shipment_fails():
+    _, b, _ = _setup()
+    with pytest.raises(DomainError) as err:
+        shipments.reassign_shipment("shp_missing", b.id)
+    assert err.value.code == "E_NOT_FOUND"
+    assert audit.LOG == []
+
+
+def test_unknown_customer_fails_and_leaves_shipment_unchanged():
+    a, _, s = _setup()
+    with pytest.raises(DomainError) as err:
+        shipments.reassign_shipment(s.id, "C_missing")
+    assert err.value.code == "E_UNKNOWN_CUSTOMER"
+    assert s.customer_id == a.id
+    assert audit.LOG == []
+
+
+def test_delivered_shipment_fails_and_leaves_shipment_unchanged():
+    a, b, s = _setup()
+    s.status = "delivered"
+    with pytest.raises(DomainError) as err:
+        shipments.reassign_shipment(s.id, b.id)
+    assert err.value.code == "E_BAD_STATE"
+    assert s.customer_id == a.id
+    assert s.status == "delivered"
+    assert audit.LOG == []
+
+
+@pytest.mark.parametrize("bad", [None, "", "   ", 42, ["x"]])
+def test_bad_shipment_id_fails(bad):
+    a, b, s = _setup()
+    with pytest.raises(DomainError) as err:
+        shipments.reassign_shipment(bad, b.id)
+    assert err.value.code == "E_BAD_INPUT"
+    assert s.customer_id == a.id
+    assert audit.LOG == []
+
+
+@pytest.mark.parametrize("bad", [None, "", "   ", 42, ["x"]])
+def test_bad_new_customer_id_fails(bad):
+    a, _, s = _setup()
+    with pytest.raises(DomainError) as err:
+        shipments.reassign_shipment(s.id, bad)
+    assert err.value.code == "E_BAD_INPUT"
+    assert s.customer_id == a.id
+    assert audit.LOG == []
