     if weight_kg <= 0:
         raise ValueError("weight must be positive")
     return round(base_rate(zone) + PER_KG * weight_kg, 2)
+
+
+def discounted_quote(weight_kg, zone, tier):
+    if not isinstance(tier, str) or tier not in TIERS:
+        raise DomainError("E_BAD_INPUT", "unknown tier: %r" % (tier,))
+    regular = quote(weight_kg, zone)
+    if tier != "gold":
+        return regular
+    # Money handles the rounding (half-up to the cent); return a float like quote().
+    discounted = Money.parse(regular).scale(GOLD_FACTOR)
+    return discounted.cents / 100
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_discounted_quote.py b/tests/unit/test_discounted_quote.py
--- a/tests/unit/test_discounted_quote.py	1969-12-31 19:00:00
+++ b/tests/unit/test_discounted_quote.py	2026-11-12 02:00:23
@@ -0,0 +1,33 @@
+import pytest
+
+from parcelo import rates
+from parcelo.errors import DomainError
+
+
+def test_gold_gets_ten_percent_off():
+    assert rates.discounted_quote(2, "local", "gold") == 6.3
+
+
+def test_standard_has_no_discount():
+    assert rates.discounted_quote(2, "local", "standard") == rates.quote(2, "local")
+
+
+def test_gold_rounds_to_cents_half_up():
+    # regular quote 5.75 -> 90% is 5.175 -> 5.18 (half-up, per Money)
+    assert rates.discounted_quote(1, "local", "gold") == 5.18
+
+
+def test_unknown_tier_fails():
+    with pytest.raises(DomainError) as err:
+        rates.discounted_quote(2, "local", "platinum")
+    assert err.value.code == "E_BAD_INPUT"
+
+
+def test_non_string_tier_fails():
+    with pytest.raises(DomainError):
+        rates.discounted_quote(2, "local", None)
+
+
+def test_unknown_zone_fails():
+    with pytest.raises(ValueError):
+        rates.discounted_quote(2, "moon", "gold")
