diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_customer_upgrade.py b/tests/unit/test_customer_upgrade.py
--- a/tests/unit/test_customer_upgrade.py	1969-12-31 19:00:00
+++ b/tests/unit/test_customer_upgrade.py	2026-11-12 02:08:08
@@ -0,0 +1,40 @@
+import dataclasses
+
+import pytest
+
+from parcelo import customers, events
+from parcelo.errors import DomainError
+from parcelo.store import db
+
+
+def test_upgrade_standard_to_gold():
+    c = customers.add_customer("Acme")
+    before = len(events.OUTBOX)
+
+    result = customers.upgrade_tier(c.id)
+
+    assert result is c
+    assert db.customers[c.id].tier == "gold"
+    assert events.OUTBOX[before:][0]["name"] == "customer.upgraded"
+    assert events.OUTBOX[before:][0]["entity_id"] == c.id
+
+
+def test_upgrade_unknown_customer():
+    before = len(events.OUTBOX)
+    with pytest.raises(DomainError) as err:
+        customers.upgrade_tier("C_missing")
+    assert err.value.code == "E_NOT_FOUND"
+    assert len(events.OUTBOX) == before
+
+
+def test_upgrade_already_gold():
+    c = customers.add_customer("Acme", tier="gold")
+    snapshot = dataclasses.asdict(db.customers[c.id])
+    before = len(events.OUTBOX)
+
+    with pytest.raises(DomainError) as err:
+        customers.upgrade_tier(c.id)
+
+    assert err.value.code == "E_BAD_STATE"
+    assert dataclasses.asdict(db.customers[c.id]) == snapshot
+    assert len(events.OUTBOX) == before
