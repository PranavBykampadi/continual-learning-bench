+def _as_utc(moment):
+    # issue_invoice stores naive UTC datetimes; clock.now() is tz-aware UTC.
+    if moment.tzinfo is None:
+        return moment.replace(tzinfo=timezone.utc)
+    return moment.astimezone(timezone.utc)
+
+
+def late_fee_for(invoice_id):
+    """Late fee picked up so far: 1.5% of the invoice amount per full day past 30 days."""
+    if invoice_id not in db.invoices:
+        raise DomainError("E_NOT_FOUND", invoice_id)
+    invoice = db.invoices[invoice_id]
+    elapsed = _as_utc(clock.now()) - _as_utc(invoice.issued_at)
+    overdue = elapsed - LATE_AFTER
+    if overdue <= timedelta(0):
+        return Money.zero()
+    days_late = overdue.days  # whole days past the 30-day mark
+    amount = Money.parse(invoice.amount)
+    return amount.scale(LATE_RATE_PER_DAY * days_late)
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_late_fee.py b/tests/unit/test_late_fee.py
--- a/tests/unit/test_late_fee.py	1969-12-31 19:00:00
+++ b/tests/unit/test_late_fee.py	2026-11-12 01:56:21
@@ -0,0 +1,65 @@
+from datetime import datetime, timedelta, timezone
+
+import pytest
+
+from parcelo import audit, clock, customers, invoices, shipments
+from parcelo.errors import DomainError
+from parcelo.money import Money
+
+ISSUED = datetime(2026, 1, 1, tzinfo=timezone.utc)
+
+
+def _invoice(amount=200.0):
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 2, "local")
+    inv = invoices.issue_invoice(s.id)
+    inv.amount = amount
+    inv.issued_at = ISSUED
+    return inv
+
+
+def _at(days):
+    clock.set_fixed(ISSUED + timedelta(days=days))
+
+
+@pytest.mark.parametrize("days", [0, 1, 29, 30])
+def test_not_late_yet_is_zero(days):
+    inv = _invoice()
+    _at(days)
+    assert invoices.late_fee_for(inv.id) == Money.zero()
+
+
+def test_partial_day_past_threshold_is_not_a_full_day():
+    inv = _invoice()
+    clock.set_fixed(ISSUED + timedelta(days=30, hours=12))
+    assert invoices.late_fee_for(inv.id) == Money.zero()
+
+
+@pytest.mark.parametrize("days_past", [1, 2, 5])
+def test_fee_is_one_and_a_half_percent_per_day_past_30(days_past):
+    inv = _invoice(200.0)  # 1.5% of 200.00 = 3.00 per day
+    _at(30 + days_past)
+    assert invoices.late_fee_for(inv.id) == Money.parse(3.0 * days_past)
+
+
+def test_naive_issued_at_as_stored_by_issue_invoice():
+    inv = _invoice(200.0)
+    inv.issued_at = datetime(2026, 1, 1)  # naive UTC, as issue_invoice stores it
+    clock.set_fixed(datetime(2026, 2, 5, tzinfo=timezone.utc))  # 35 days later
+    assert invoices.late_fee_for(inv.id) == Money.parse(15.0)
+
+
+def test_unknown_invoice_raises_not_found():
+    with pytest.raises(DomainError) as err:
+        invoices.late_fee_for("INV-missing")
+    assert err.value.code == "E_NOT_FOUND"
+
+
+def test_fee_does_not_change_invoice_or_write_audit():
+    inv = _invoice(200.0)
+    before = (inv.status, inv.amount, inv.issued_at, inv.paid_at)
+    audit.LOG.clear()
+    _at(40)
+    invoices.late_fee_for(inv.id)
+    assert (inv.status, inv.amount, inv.issued_at, inv.paid_at) == before
+    assert audit.LOG == []
