diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_pickups.py b/tests/unit/test_pickups.py
--- a/tests/unit/test_pickups.py	1969-12-31 19:00:00
+++ b/tests/unit/test_pickups.py	2026-11-12 02:06:26
@@ -0,0 +1,47 @@
+import dataclasses
+
+import pytest
+
+from parcelo import customers, events, pickups, shipments, store
+from parcelo.errors import DomainError
+
+
+def _created_shipment():
+    c = customers.add_customer("Acme")
+    return shipments.create_shipment(c.id, 1.5, "national")
+
+
+def test_schedule_pickup_happy_path():
+    s = _created_shipment()
+    before = len(events.OUTBOX)
+    window = object()
+    p = pickups.schedule_pickup(s.id, window)
+    assert p.id.startswith("pkp_")
+    assert p.shipment_id == s.id
+    assert p.window_start is window
+    assert p.scheduled_at is not None
+    assert store.db.pickups[p.id] is p
+    assert events.OUTBOX[before:][0]["name"] == "pickup.scheduled"
+    assert events.OUTBOX[before:][0]["entity_id"] == p.id
+
+
+def test_unknown_shipment():
+    before = len(events.OUTBOX)
+    with pytest.raises(DomainError) as err:
+        pickups.schedule_pickup("shp_missing", object())
+    assert err.value.code == "E_NOT_FOUND"
+    assert store.db.pickups == {}
+    assert len(events.OUTBOX) == before
+
+
+def test_shipment_not_in_created_state():
+    s = _created_shipment()
+    s.status = "delivered"
+    snapshot = dataclasses.asdict(store.db.shipments[s.id])
+    before = len(events.OUTBOX)
+    with pytest.raises(DomainError) as err:
+        pickups.schedule_pickup(s.id, object())
+    assert err.value.code == "E_BAD_STATE"
+    assert dataclasses.asdict(store.db.shipments[s.id]) == snapshot
+    assert store.db.pickups == {}
+    assert len(events.OUTBOX) == before
