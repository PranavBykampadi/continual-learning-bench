+def needs_review(customer_id):
+    """True if the customer has more than 3 open invoices, or their open
+    invoices total more than 250.00. Read-only; no event is emitted."""
+    if not isinstance(customer_id, str) or not customer_id.strip():
+        raise DomainError("E_BAD_INPUT", "customer_id must be a non-empty string")
+    if customer_id not in db.customers:
+        raise DomainError("E_NOT_FOUND", customer_id)
+
+    count = 0
+    total = Money.zero()
+    for invoice in db.invoices.values():
+        shipment = db.shipments[invoice.shipment_id]
+        if shipment.customer_id == customer_id and invoice.status == "open":
+            count += 1
+            total = total + Money.parse(invoice.amount)
+    return count > REVIEW_MAX_OPEN_INVOICES or REVIEW_MAX_OPEN_TOTAL < total
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_needs_review.py b/tests/unit/test_needs_review.py
--- a/tests/unit/test_needs_review.py	1969-12-31 19:00:00
+++ b/tests/unit/test_needs_review.py	2026-11-12 02:15:57
@@ -0,0 +1,96 @@
+import itertools
+
+import pytest
+
+from parcelo import customers, events
+from parcelo.errors import DomainError
+from parcelo.models import Invoice, Shipment
+from parcelo.store import db
+
+_seq = itertools.count(1)
+
+
+def _add_invoice(customer_id, amount, status="open"):
+    n = next(_seq)
+    ship_id = f"shp_t{n}"
+    db.shipments[ship_id] = Shipment(id=ship_id, customer_id=customer_id, weight_kg=1, zone="local")
+    inv_id = f"INV-t{n}"
+    db.invoices[inv_id] = Invoice(id=inv_id, shipment_id=ship_id, amount=amount, status=status)
+    return inv_id
+
+
+def test_no_invoices_is_not_flagged():
+    c = customers.add_customer("Acme")
+    assert customers.needs_review(c.id) is False
+
+
+def test_three_open_invoices_is_not_flagged():
+    c = customers.add_customer("Acme")
+    for _ in range(3):
+        _add_invoice(c.id, 1.0)
+    assert customers.needs_review(c.id) is False
+
+
+def test_more_than_three_open_invoices_is_flagged():
+    c = customers.add_customer("Acme")
+    for _ in range(4):
+        _add_invoice(c.id, 1.0)
+    assert customers.needs_review(c.id) is True
+
+
+def test_total_at_250_is_not_flagged():
+    c = customers.add_customer("Acme")
+    _add_invoice(c.id, 150.00)
+    _add_invoice(c.id, 100.00)
+    assert customers.needs_review(c.id) is False
+
+
+def test_total_over_250_is_flagged():
+    c = customers.add_customer("Acme")
+    _add_invoice(c.id, 150.00)
+    _add_invoice(c.id, 100.01)
+    assert customers.needs_review(c.id) is True
+
+
+def test_float_amounts_sum_exactly():
+    # 0.1 + 0.2 style float drift must not push a 250.00 total over the line.
+    c = customers.add_customer("Acme")
+    for amount in (83.33, 83.33, 83.34):
+        _add_invoice(c.id, amount)
+    assert customers.needs_review(c.id) is False
+
+
+def test_paid_invoices_are_ignored():
+    c = customers.add_customer("Acme")
+    for _ in range(5):
+        _add_invoice(c.id, 100.00, status="paid")
+    assert customers.needs_review(c.id) is False
+
+
+def test_other_customers_invoices_are_ignored():
+    c = customers.add_customer("Acme")
+    other = customers.add_customer("Other")
+    for _ in range(4):
+        _add_invoice(other.id, 1.0)
+    assert customers.needs_review(c.id) is False
+
+
+def test_read_only_no_event():
+    c = customers.add_customer("Acme")
+    _add_invoice(c.id, 1.0)
+    before = len(events.OUTBOX)
+    customers.needs_review(c.id)
+    assert len(events.OUTBOX) == before
+
+
+def test_unknown_customer_raises_not_found():
+    with pytest.raises(DomainError) as err:
+        customers.needs_review("C_missing")
+    assert err.value.code == "E_NOT_FOUND"
+
+
+@pytest.mark.parametrize("bad", [None, "", "   ", 42, ["C1"]])
+def test_bad_input_raises(bad):
+    with pytest.raises(DomainError) as err:
+        customers.needs_review(bad)
+    assert err.value.code == "E_BAD_INPUT"
