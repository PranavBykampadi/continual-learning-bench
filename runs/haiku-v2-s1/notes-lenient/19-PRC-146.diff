@@ -0,0 +1,82 @@
+import dataclasses
+from datetime import datetime, timezone
+
+import pytest
+
+from parcelo import clock, customers, events, invoices, shipments
+from parcelo.errors import DomainError
+from parcelo.money import Money
+from parcelo.store import db
+
+
+def _open_invoice():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 2, "local")
+    return invoices.issue_invoice(s.id)
+
+
+def test_write_off_happy_path():
+    moment = datetime(2026, 11, 12, 9, 30, tzinfo=timezone.utc)
+    clock.set_fixed(moment)
+    inv = _open_invoice()
+    before = len(events.OUTBOX)
+
+    result = invoices.write_off(inv.id)
+
+    assert result == Money(700)
+    stored = db.invoices[inv.id]
+    assert stored.status == "written_off"
+    assert stored.written_off_at == moment
+    assert events.OUTBOX[before:][0]["name"] == "invoice.written_off"
+    assert events.OUTBOX[before:][0]["entity_id"] == inv.id
+    assert invoices.open_invoices() == []
+
+
+def test_unknown_invoice():
+    before = len(events.OUTBOX)
+    with pytest.raises(DomainError) as err:
+        invoices.write_off("INV-nope")
+    assert err.value.code == "E_NOT_FOUND"
+    assert len(events.OUTBOX) == before
+
+
+def test_already_written_off_is_bad_state():
+    inv = _open_invoice()
+    invoices.write_off(inv.id)
+    snapshot = dataclasses.asdict(db.invoices[inv.id])
+    before = len(events.OUTBOX)
+
+    with pytest.raises(DomainError) as err:
+        invoices.write_off(inv.id)
+
+    assert err.value.code == "E_BAD_STATE"
+    assert dataclasses.asdict(db.invoices[inv.id]) == snapshot
+    assert len(events.OUTBOX) == before
+
+
+def test_paid_invoice_is_bad_state():
+    inv = _open_invoice()
+    invoices.mark_paid(inv.id)
+    snapshot = dataclasses.asdict(db.invoices[inv.id])
+    before = len(events.OUTBOX)
+
+    with pytest.raises(DomainError) as err:
+        invoices.write_off(inv.id)
+
+    assert err.value.code == "E_BAD_STATE"
+    assert dataclasses.asdict(db.invoices[inv.id]) == snapshot
+    assert len(events.OUTBOX) == before
+
+
+@pytest.mark.parametrize("bad", [None, "", "   ", 123, ["INV-1"]])
+def test_bad_input(bad):
+    inv = _open_invoice()
+    snapshot = dataclasses.asdict(db.invoices[inv.id])
+    before = len(events.OUTBOX)
+
+    with pytest.raises(DomainError) as err:
+        invoices.write_off(bad)
+
+    assert err.value.code == "E_BAD_INPUT"
+    assert dataclasses.asdict(db.invoices[inv.id]) == snapshot
+    assert len(events.OUTBOX) == before
