diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_claims.py b/tests/unit/test_claims.py
--- a/tests/unit/test_claims.py	1969-12-31 19:00:00
+++ b/tests/unit/test_claims.py	2026-11-12 02:01:55
@@ -0,0 +1,86 @@
+import pytest
+
+from parcelo import audit, claims, customers, shipments
+from parcelo.errors import DomainError
+from parcelo.money import Money
+from parcelo.store import db
+
+
+def _delivered_shipment():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 1.5, "national")
+    s.status = "delivered"
+    return s
+
+
+def test_file_claim_stores_and_records():
+    s = _delivered_shipment()
+    claim = claims.file_claim(s.id, 10.50, "box damaged")
+    assert claim.id.startswith("clm_")
+    assert claim.shipment_id == s.id
+    assert claim.amount == Money(1050)
+    assert claim.reason == "box damaged"
+    assert claim.filed_at is not None
+    assert db.claims[claim.id] is claim
+    assert audit.LOG[-1]["action"] == "claim.filed"
+    assert audit.LOG[-1]["entity_id"] == claim.id
+
+
+def test_reset_clears_claims():
+    from parcelo import store
+
+    s = _delivered_shipment()
+    claims.file_claim(s.id, 5, "late")
+    store.reset()
+    assert db.claims == {}
+
+
+def test_unknown_shipment_is_not_found():
+    with pytest.raises(DomainError) as err:
+        claims.file_claim("shp_missing", 5, "lost")
+    assert err.value.code == "E_NOT_FOUND"
+    assert db.claims == {}
+
+
+def test_undelivered_shipment_is_bad_state():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 1.5, "national")
+    with pytest.raises(DomainError) as err:
+        claims.file_claim(s.id, 5, "lost")
+    assert err.value.code == "E_BAD_STATE"
+    assert db.claims == {}
+
+
+@pytest.mark.parametrize("amount", [0, -1, -0.01, 0.001])
+def test_non_positive_amount_is_bad_input(amount):
+    s = _delivered_shipment()
+    with pytest.raises(DomainError) as err:
+        claims.file_claim(s.id, amount, "damaged")
+    assert err.value.code == "E_BAD_INPUT"
+    assert db.claims == {}
+
+
+@pytest.mark.parametrize("amount", [None, "abc", float("nan"), float("inf"), True])
+def test_unparseable_amount_is_bad_input(amount):
+    s = _delivered_shipment()
+    with pytest.raises(DomainError) as err:
+        claims.file_claim(s.id, amount, "damaged")
+    assert err.value.code == "E_BAD_INPUT"
+    assert db.claims == {}
+
+
+@pytest.mark.parametrize("reason", ["", "   ", None, 42])
+def test_blank_reason_is_bad_input(reason):
+    s = _delivered_shipment()
+    with pytest.raises(DomainError) as err:
+        claims.file_claim(s.id, 5, reason)
+    assert err.value.code == "E_BAD_INPUT"
+    assert db.claims == {}
+
+
+@pytest.mark.parametrize("shipment_id", ["", "  ", None, 7])
+def test_bad_shipment_id_is_bad_input(shipment_id):
+    with pytest.raises(DomainError) as err:
+        claims.file_claim(shipment_id, 5, "damaged")
+    assert err