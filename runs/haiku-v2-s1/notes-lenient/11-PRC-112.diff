diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/parcelo/claims.py b/parcelo/claims.py
--- a/parcelo/claims.py	1969-12-31 19:00:00
+++ b/parcelo/claims.py	2026-11-12 02:01:49
@@ -0,0 +1,43 @@
+from decimal import InvalidOperation
+
+from parcelo import audit, clock, ids
+from parcelo.errors import DomainError
+from parcelo.models import Claim
+from parcelo.money import Money
+from parcelo.store import db
+
+
+def file_claim(shipment_id, amount, reason):
+    """File a claim against a delivered shipment and return the stored Claim.
+
+    All validation happens before anything is stored, so a failed call
+    leaves no partial state behind.
+    """
+    if not (isinstance(shipment_id, str) and shipment_id.strip()):
+        raise DomainError("E_BAD_INPUT", "shipment_id")
+    if not (isinstance(reason, str) and reason.strip()):
+        raise DomainError("E_BAD_INPUT", "reason")
+
+    try:
+        money = Money.parse(amount)
+    except (TypeError, ValueError, ArithmeticError, InvalidOperation):
+        raise DomainError("E_BAD_INPUT", "amount")
+    if money.cents <= 0:
+        raise DomainError("E_BAD_INPUT", "amount must be positive")
+
+    if shipment_id not in db.shipments:
+        raise DomainError("E_NOT_FOUND", shipment_id)
+    shipment = db.shipments[shipment_id]
+    if shipment.status != "delivered":
+        raise DomainError("E_BAD_STATE", f"shipment {shipment_id} is {shipment.status}")
+
+    claim = Claim(
+        id=ids.new_id("clm"),
+        shipment_id=shipment_id,
+        amount=money,
+        reason=reason,
+        filed_at=clock.now(),
+    )
+    db.claims[claim.id] = claim
+    audit.record("claim.filed", claim.id, shipment_id=shipment_id)
+    return claim
