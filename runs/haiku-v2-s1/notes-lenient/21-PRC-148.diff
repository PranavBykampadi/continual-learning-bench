diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_disputes.py b/tests/unit/test_disputes.py
--- a/tests/unit/test_disputes.py	1969-12-31 19:00:00
+++ b/tests/unit/test_disputes.py	2026-11-12 02:10:09
@@ -0,0 +1,59 @@
+import dataclasses
+
+import pytest
+
+from parcelo import clock, disputes, events
+from parcelo.errors import DomainError
+from parcelo.models import Invoice
+from parcelo.store import db
+
+
+def _invoice(invoice_id="INV-TEST0001"):
+    inv = Invoice(id=invoice_id, shipment_id="shp_000001", amount=10.50)
+    db.invoices[inv.id] = inv
+    return inv
+
+
+def test_open_dispute_creates_and_stores_record():
+    inv = _invoice()
+    moment = clock.now()
+    clock.set_fixed(moment)
+    before = len(events.OUTBOX)
+
+    d = disputes.open_dispute(inv.id, "wrong weight")
+
+    assert d.id.startswith("dsp_")
+    assert d.invoice_id == inv.id
+    assert d.reason == "wrong weight"
+    assert d.opened_at == moment
+    assert db.disputes[d.id] is d
+    assert events.OUTBOX[before:][0]["name"] == "dispute.opened"
+    assert events.OUTBOX[before:][0]["entity_id"] == d.id
+
+
+def test_unknown_invoice():
+    before_disputes = dict(db.disputes)
+    before = len(events.OUTBOX)
+
+    with pytest.raises(DomainError) as err:
+        disputes.open_dispute("INV-MISSING", "wrong weight")
+
+    assert err.value.code == "E_NOT_FOUND"
+    assert db.disputes == before_disputes
+    assert len(events.OUTBOX) == before
+
+
+@pytest.mark.parametrize("reason", [None, "", "   ", 42, ["too", "wrong"]])
+def test_bad_reason(reason):
+    inv = _invoice()
+    snapshot = dataclasses.asdict(inv)
+    before_disputes = dict(db.disputes)
+    before = len(events.OUTBOX)
+
+    with pytest.raises(DomainError) as err:
+        disputes.open_dispute(inv.id, reason)
+
+    assert err.value.code == "E_BAD_INPUT"
+    assert dataclasses.asdict(db.invoices[inv.id]) == snapshot
+    assert db.disputes == before_disputes
+    assert len(events.OUTBOX) == before
