diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_customers.py b/tests/unit/test_customers.py
--- a/tests/unit/test_customers.py	1969-12-31 19:00:00
+++ b/tests/unit/test_customers.py	2026-11-12 02:12:24
@@ -0,0 +1,56 @@
+import dataclasses
+from decimal import Decimal
+
+import pytest
+
+from parcelo import customers, events
+from parcelo.errors import DomainError
+from parcelo.store import db
+
+
+def test_set_credit_limit_updates_and_returns_new_limit():
+    c = customers.add_customer("Acme")
+    before = len(events.OUTBOX)
+    result = customers.set_credit_limit(c.id, 1200.5)
+    assert result == 1200.5
+    assert db.customers[c.id].credit_limit == 1200.5
+    assert events.OUTBOX[before:][0]["name"] == "customer.credit_limit_set"
+    assert events.OUTBOX[before:][0]["entity_id"] == c.id
+
+
+def test_set_credit_limit_accepts_zero_and_decimal():
+    c = customers.add_customer("Acme")
+    assert customers.set_credit_limit(c.id, 0) == 0
+    assert customers.set_credit_limit(c.id, Decimal("99.99")) == 99.99
+
+
+def test_unknown_customer():
+    before = len(events.OUTBOX)
+    with pytest.raises(DomainError) as err:
+        customers.set_credit_limit("C-missing", 100)
+    assert err.value.code == "E_NOT_FOUND"
+    assert len(events.OUTBOX) == before
+
+
+@pytest.mark.parametrize("bad_id", [None, "", "   ", 42, ["C1"]])
+def test_bad_customer_id_input(bad_id):
+    c = customers.add_customer("Acme")
+    snapshot = dataclasses.asdict(db.customers[c.id])
+    before = len(events.OUTBOX)
+    with pytest.raises(DomainError) as err:
+        customers.set_credit_limit(bad_id, 100)
+    assert err.value.code == "E_BAD_INPUT"
+    assert dataclasses.asdict(db.customers[c.id]) == snapshot
+    assert len(events.OUTBOX) == before
+
+
+@pytest.mark.parametrize("bad_amount", [None, "100", ["100"], True, -1, -0.01, float("nan"), float("inf")])
+def test_bad_amount_input(bad_amount):
+    c = customers.add_customer("Acme")
+    snapshot = dataclasses.asdict(db.customers[c.id])
+    before = len(events.OUTBOX)
+    with pytest.raises(DomainError) as err:
+        customers.set_credit_limit(c.id, bad_amount)
+    assert err.value.code == "E_BAD_INPUT"
+    assert dataclasses.asdict(db.customers[c.id]) == snapshot
+    assert len(events.OUTBOX) == before
