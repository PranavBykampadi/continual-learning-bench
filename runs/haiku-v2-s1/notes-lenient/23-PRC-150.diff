+def set_credit_limit(customer_id, amount):
+    # Validate input first.
+    if not isinstance(customer_id, str) or not customer_id.strip():
+        raise DomainError("E_BAD_INPUT", "customer_id required")
+    if isinstance(amount, bool) or not isinstance(amount, (int, float, Decimal)):
+        raise DomainError("E_BAD_INPUT", "amount must be a number")
+    finite = amount.is_finite() if isinstance(amount, Decimal) else math.isfinite(amount)
+    if not finite or amount < 0:
+        raise DomainError("E_BAD_INPUT", f"credit limit must be a finite non-negative amount: {amount}")
+    # Check existence.
+    if customer_id not in db.customers:
+        raise DomainError("E_NOT_FOUND", customer_id)
+    # Convert money before mutating anything.
+    limit = Money.parse(amount)
+    customer = db.customers[customer_id]
+    customer.credit_limit = limit.cents / 100
+    events.emit("customer.credit_limit_set", customer_id, credit_limit=customer.credit_limit)
+    return customer.credit_limit
 
 
