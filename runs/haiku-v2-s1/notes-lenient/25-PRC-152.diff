     if shipment_id not in db.shipments:
         raise DomainError("E_NOT_FOUND", shipment_id)
     return db.shipments[shipment_id]
+
+
+def mark_lost(shipment_id):
+    # Validate input first.
+    if not isinstance(shipment_id, str) or not shipment_id.strip():
+        raise DomainError("E_BAD_INPUT", repr(shipment_id))
+    # Existence check before indexing.
+    if shipment_id not in db.shipments:
+        raise DomainError("E_NOT_FOUND", shipment_id)
+    shipment = db.shipments[shipment_id]
+    # State check: a delivered shipment cannot be lost.
+    if shipment.status == "delivered":
+        raise DomainError("E_BAD_STATE", shipment_id)
+    # Mutate, then emit.
+    shipment.status = "lost"
+    events.emit("shipment.lost", shipment.id)
+    return shipment
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_mark_lost.py b/tests/unit/test_mark_lost.py
--- a/tests/unit/test_mark_lost.py	1969-12-31 19:00:00
+++ b/tests/unit/test_mark_lost.py	2026-11-12 02:14:28
@@ -0,0 +1,55 @@
+import dataclasses
+
+import pytest
+
+from parcelo import customers, events, shipments
+from parcelo.errors import DomainError
+from parcelo.store import db
+
+
+def _shipment(status="created"):
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 1.5, "national")
+    s.status = status
+    return s
+
+
+def test_mark_lost_sets_status_and_returns_shipment():
+    s = _shipment()
+    before = len(events.OUTBOX)
+    result = shipments.mark_lost(s.id)
+    assert result is s
+    assert db.shipments[s.id].status == "lost"
+    assert events.OUTBOX[before:][-1]["name"] == "shipment.lost"
+    assert events.OUTBOX[before:][-1]["entity_id"] == s.id
+
+
+def test_mark_lost_unknown_shipment():
+    before = len(events.OUTBOX)
+    with pytest.raises(DomainError) as err:
+        shipments.mark_lost("shp_missing")
+    assert err.value.code == "E_NOT_FOUND"
+    assert len(events.OUTBOX) == before
+
+
+def test_mark_lost_delivered_fails():
+    s = _shipment(status="delivered")
+    snapshot = dataclasses.asdict(db.shipments[s.id])
+    before = len(events.OUTBOX)
+    with pytest.raises(DomainError) as err:
+        shipments.mark_lost(s.id)
+    assert err.value.code == "E_BAD_STATE"
+    assert dataclasses.asdict(db.shipments[s.id]) == snapshot
+    assert len(events.OUTBOX) == before
+
+
+@pytest.mark.parametrize("bad", [None, "", "   ", 42, ["shp_1"]])
+def test_mark_lost_bad_input(bad):
+    s = _shipment()
+    snapshot = dataclasses.asdict(db.shipments[s.id])
+    before = len(events.OUTBOX)
+    with pytest.raises(DomainError) as err:
+        shipments.mark_lost(bad)
+    assert err.value.code == "E_BAD_INPUT"
+    assert dataclasses.asdict(db.shipments[s.id]) == snapshot
+    assert len(events.OUTBOX) == before
