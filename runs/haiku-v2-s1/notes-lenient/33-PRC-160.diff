diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/parcelo/shipments.py b/parcelo/shipments.py
--- a/parcelo/shipments.py	2026-11-10 12:20:18
+++ b/parcelo/shipments.py	2026-11-12 02:22:06
@@ -28,3 +28,19 @@
     if shipment_id not in db.shipments:
         raise DomainError("E_NOT_FOUND", shipment_id)
     return db.shipments[shipment_id]
+
+
+def mark_returned(shipment_id):
+    if not isinstance(shipment_id, str) or not shipment_id:
+        raise DomainError("E_BAD_INPUT", repr(shipment_id))
+    if shipment_id not in db.shipments:
+        raise DomainError("E_NOT_FOUND", shipment_id)
+    shipment = db.shipments[shipment_id]
+    if shipment.status == "returned":
+        return shipment
+    if shipment.status != "delivered":
+        raise DomainError("E_BAD_STATE", shipment.status)
+    shipment.status = "returned"
+    shipment.returned_at = clock.now()
+    events.emit("shipment.returned", shipment.id)
+    return shipment
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_shipments.py b/tests/unit/test_shipments.py
--- a/tests/unit/test_shipments.py	2026-11-10 12:20:18
+++ b/tests/unit/test_shipments.py	2026-11-12 02:22:16
@@ -1,6 +1,8 @@
+from datetime import datetime, timezone
+
 import pytest
 
-from parcelo import customers, events, shipments
+from parcelo import clock, customers, events, shipments
 from parcelo.errors import DomainError
 
 
@@ -15,3 +17,62 @@
     with pytest.raises(DomainError) as err:
         shipments.create_shipment("nope", 1, "local")
     assert err.value.code == "E_UNKNOWN_CUSTOMER"
+
+
+def _delivered_shipment():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 1.5, "national")
+    s.status = "delivered"
+    return s
+
+
+def test_mark_returned_sets_status_and_time():
+    moment = datetime(2026, 11, 12, 9, 30, tzinfo=timezone.utc)
+    clock.set_fixed(moment)
+    s = _delivered_shipment()
+    events.OUTBOX.clear()
+    result = shipments.mark_returned(s.id)
+    assert result is s
+    assert result.status == "returned"
+    assert result.returned_at == moment
+    assert events.OUTBOX[-1]["name"] == "shipment.returned"
+    assert events.OUTBOX[-1]["entity_id"] == s.id
+    assert len(events.OUTBOX) == 1
+
+
+def test_mark_returned_already_returned_is_unchanged():
+    first = datetime(2026, 11, 12, 9, 30, tzinfo=timezone.utc)
+    clock.set_fixed(first)
+    s = _delivered_shipment()
+    shipments.mark_returned(s.id)
+    events.OUTBOX.clear()
+    clock.set_fixed(datetime(2026, 11, 13, 9, 30, tzinfo=timezone.utc))
+    result = shipments.mark_returned(s.id)
+    assert result.status == "returned"
+    assert result.returned_at == first
+    assert events.OUTBOX == []
+
+
+def test_mark_returned_created_shipment_fails():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 1.5, "national")
+    events.OUTBOX.clear()
+    with pytest.raises(DomainError) as err:
+        shipments.mark_returned(s.id)
+    assert err.value.code == "E_BAD_STATE"
+    assert s.status == "created"
+    assert s.returned_at is None
+    assert events.OUTBOX == []
+
+
+def test_mark_returned_unknown_shipment_fails():
+    with pytest.raises(DomainError) as err:
+        shipments.mark_returned("shp_999999")
+    assert err.value.code == "E_NOT_FOUND"
+
+
+@pytest.mark.parametrize("bad", [None, "", 42, ["shp_000001"]])
+def test_mark_returned_bad_input(bad):
+    with pytest.raises(DomainError) as err:
+        shipments.mark_returned(bad)
+    assert err.value.code == "E_BAD_INPUT"
