 def open_invoices():
     return [i for i in db.invoices.values() if i.status == "open"]
+
+
+def apply_credit(invoice_id, amount):
+    """Reduce an open invoice's amount by a credit and return the remaining amount.
+
+    The invoice's ``amount`` is reduced in place, so reports (which only count
+    paid invoices) and ``customers.outstanding_balance`` (which sums open
+    invoices) pick up the change without further adjustment. Arithmetic is done
+    in integer cents to avoid float drift.
+    """
+    if invoice_id not in db.invoices:
+        raise DomainError("E_NOT_FOUND", invoice_id)
+    invoice = db.invoices[invoice_id]
+    if invoice.status != "open":
+        raise DomainError("E_BAD_STATE", f"{invoice_id} is {invoice.status}")
+    credit = Money.parse(amount)
+    if credit.cents <= 0:
+        raise DomainError("E_BAD_INPUT", f"credit must be positive: {amount}")
+    current = Money.parse(invoice.amount)
+    if current < credit:
+        raise DomainError("E_BAD_INPUT", f"credit {amount} exceeds invoice amount {invoice.amount}")
+    remaining = current - credit
+    invoice.amount = remaining.cents / 100
+    audit.record("invoice.credit_applied", invoice.id, credit=credit.cents, remaining=remaining.cents)
+    return invoice.amount
