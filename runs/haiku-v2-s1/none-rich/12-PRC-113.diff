+
+def _open_invoice():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 2, "local")
+    return c, invoices.issue_invoice(s.id)
+
+
+def test_apply_credit_reduces_open_invoice():
+    c, inv = _open_invoice()
+    assert invoices.apply_credit(inv.id, 2.5) == 4.5
+    assert inv.amount == 4.5
+    assert inv.status == "open"
+    assert customers.outstanding_balance(c.id) == 4.5
+
+
+def test_apply_credit_exact_float_arithmetic():
+    _, inv = _open_invoice()
+    assert invoices.apply_credit(inv.id, 0.1) == 6.9
+    assert invoices.apply_credit(inv.id, 0.2) == 6.7
+
+
+def test_credit_flows_into_revenue_after_payment():
+    _, inv = _open_invoice()
+    invoices.apply_credit(inv.id, 2)
+    invoices.mark_paid(inv.id)
+    assert revenue_total() == 5.0
+
+
+def test_apply_credit_unknown_invoice_fails():
+    with pytest.raises(DomainError) as err:
+        invoices.apply_credit("INV-missing", 1)
+    assert err.value.code == "E_NOT_FOUND"
+
+
+def test_apply_credit_to_paid_invoice_fails():
+    _, inv = _open_invoice()
+    invoices.mark_paid(inv.id)
+    with pytest.raises(DomainError) as err:
+        invoices.apply_credit(inv.id, 1)
+    assert err.value.code == "E_BAD_STATE"
+    assert inv.amount == 7.0
+
+
+def test_credit_larger_than_amount_fails():
+    _, inv = _open_invoice()
+    with pytest.raises(DomainError) as err:
+        invoices.apply_credit(inv.id, 7.01)
+    assert err.value.code == "E_BAD_INPUT"
+    assert inv.amount == 7.0
+
+
+def test_non_positive_credit_fails():
+    _, inv = _open_invoice()
+    with pytest.raises(DomainError):
+        invoices.apply_credit(inv.id, 0)
+    with pytest.raises(DomainError):
+        invoices.apply_credit(inv.id, -1)
+    assert inv.amount == 7.0
