diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/parcelo/rates.py b/parcelo/rates.py
--- a/parcelo/rates.py	2026-11-10 12:17:53
+++ b/parcelo/rates.py	2026-11-12 02:02:14
@@ -1,5 +1,9 @@
+from parcelo.legacy.billing import FUEL_SURCHARGE_PCT
+
 ZONE_BASE = {"local": 4.5, "national": 9.0, "international": 24.0}
 PER_KG = 1.25
+INSURANCE_PCT = 2.0
+MIN_INSURANCE_FEE = 1.00
 
 
 def base_rate(zone):
@@ -12,3 +16,14 @@
     if weight_kg <= 0:
         raise ValueError("weight must be positive")
     return round(base_rate(zone) + PER_KG * weight_kg, 2)
+
+
+def insurance_fee(declared_value, zone):
+    """2% of declared value plus the zone's fuel surcharge on the declared value,
+    with a minimum fee of MIN_INSURANCE_FEE."""
+    if declared_value <= 0:
+        raise ValueError("declared value must be positive")
+    base_rate(zone)  # raises ValueError for unknown zones
+    pct = INSURANCE_PCT + FUEL_SURCHARGE_PCT[zone]
+    fee = declared_value * pct / 100.0
+    return round(max(MIN_INSURANCE_FEE, fee), 2)
