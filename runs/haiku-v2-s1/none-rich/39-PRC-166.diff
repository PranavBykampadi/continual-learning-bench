+def _add_invoice(invoice_id, amount, status="open"):
+    inv = Invoice(id=invoice_id, shipment_id="SHP-X", amount=amount, status=status)
+    db.invoices[invoice_id] = inv
+    return inv
+
+
+def test_escalate_large_open_invoice():
+    inv = _add_invoice("INV-ESC1", 500.00)
+    result = invoices.escalate_invoice(inv.id)
+    assert result is inv
+    assert result.status == "escalated"
+
+
+def test_escalate_rejects_below_threshold():
+    inv = _add_invoice("INV-ESC2", 499.99)
+    with pytest.raises(DomainError):
+        invoices.escalate_invoice(inv.id)
+    assert inv.status == "open"
+
+
+def test_escalate_rejects_non_open_invoice():
+    inv = _add_invoice("INV-ESC3", 900.00, status="paid")
+    with pytest.raises(DomainError):
+        invoices.escalate_invoice(inv.id)
+    assert inv.status == "paid"
+
+
+def test_escalate_missing_invoice_fails():
+    with pytest.raises(DomainError) as err:
+        invoices.escalate_invoice("INV-DOES-NOT-EXIST")
+    assert err.value.code == "E_NOT_FOUND"
