+++ b/tests/test_reports.py	2026-11-12 02:00:29
@@ -0,0 +1,39 @@
+from datetime import datetime, timedelta, timezone
+
+from parcelo import clock, reports, store
+from parcelo.models import Invoice
+
+NOW = datetime(2026, 11, 12, 12, 0, 0)
+
+
+def _invoice(inv_id, amount, days_old, status="open"):
+    store.db.invoices[inv_id] = Invoice(
+        id=inv_id,
+        shipment_id="SHP",
+        amount=amount,
+        status=status,
+        issued_at=NOW - timedelta(days=days_old),
+    )
+
+
+def test_aging_report_buckets():
+    clock.set_fixed(NOW)
+    _invoice("a", 10.0, 0)
+    _invoice("b", 20.0, 30)
+    _invoice("c", 5.0, 31)
+    _invoice("d", 7.5, 60)
+    _invoice("e", 100.0, 61)
+    assert reports.aging_report() == {"0-30": 30.0, "31-60": 12.5, "60+": 100.0}
+
+
+def test_aging_report_skips_paid_and_empty_buckets():
+    clock.set_fixed(NOW)
+    _invoice("a", 10.0, 5, status="paid")
+    _invoice("b", 3.0, 90)
+    assert reports.aging_report() == {"0-30": 0.0, "31-60": 0.0, "60+": 3.0}
+
+
+def test_aging_report_accepts_aware_clock():
+    clock.set_fixed(NOW.replace(tzinfo=timezone.utc))
+    _invoice("a", 4.0, 45)
+    assert reports.aging_report() == {"0-30": 0.0, "31-60": 4.0, "60+": 0.0}
