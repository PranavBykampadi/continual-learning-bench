 from parcelo.store import db
 
 
 def revenue_total():
     return round(sum(i.amount for i in db.invoices.values() if i.status == "paid"), 2)
+
+
+def _naive_utc(moment):
+    # Invoices store naive UTC timestamps; normalize aware values to match.
+    if moment.tzinfo is not None:
+        return moment.astimezone(timezone.utc).replace(tzinfo=None)
+    return moment
+
+
+def aging_report():
+    """Total open invoice amounts by age in whole days since issue."""
+    now = _naive_utc(clock.now())
+    buckets = {"0-30": 0.0, "31-60": 0.0, "60+": 0.0}
+    for invoice in db.invoices.values():
+        if invoice.status != "open":
+            continue
+        age = days_between(_naive_utc(invoice.issued_at), now)
+        if 0 <= age <= 30:
+            buckets["0-30"] += invoice.amount
+        elif 31 <= age <= 60:
+            buckets["31-60"] += invoice.amount
+        elif age > 60:
+            buckets["60+"] += invoice.amount
+    return {key: round(total, 2) for key, total in buckets.items()}
 
 
