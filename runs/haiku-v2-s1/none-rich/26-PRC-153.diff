+def needs_review(customer_id):
+    """True if the customer has more than 3 open invoices or open balance over 250.00."""
+    if customer_id not in db.customers:
+        raise DomainError("E_UNKNOWN_CUSTOMER", customer_id)
+    open_count = 0
+    for invoice in db.invoices.values():
+        shipment = db.shipments[invoice.shipment_id]
+        if shipment.customer_id == customer_id and invoice.status == "open":
+            open_count += 1
+    return open_count > REVIEW_INVOICE_COUNT or outstanding_balance(customer_id) > REVIEW_BALANCE
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/test_customers_review.py b/tests/test_customers_review.py
--- a/tests/test_customers_review.py	1969-12-31 19:00:00
+++ b/tests/test_customers_review.py	2026-11-12 02:07:05
@@ -0,0 +1,64 @@
+import pytest
+
+from parcelo import customers, invoices, shipments
+from parcelo.errors import DomainError
+from parcelo.store import db
+
+
+def _invoice_for(customer_id, amount):
+    s = shipments.create_shipment(customer_id, 1, "local")
+    inv = invoices.issue_invoice(s.id)
+    inv.amount = amount
+    return inv
+
+
+def test_no_open_invoices_does_not_need_review():
+    c = customers.add_customer("Acme")
+    assert customers.needs_review(c.id) is False
+
+
+def test_three_open_invoices_small_total_does_not_need_review():
+    c = customers.add_customer("Acme")
+    for _ in range(3):
+        _invoice_for(c.id, 10.0)
+    assert customers.needs_review(c.id) is False
+
+
+def test_more_than_three_open_invoices_needs_review():
+    c = customers.add_customer("Acme")
+    for _ in range(4):
+        _invoice_for(c.id, 1.0)
+    assert customers.needs_review(c.id) is True
+
+
+def test_balance_exactly_250_does_not_need_review():
+    c = customers.add_customer("Acme")
+    _invoice_for(c.id, 250.00)
+    assert customers.needs_review(c.id) is False
+
+
+def test_balance_over_250_needs_review():
+    c = customers.add_customer("Acme")
+    _invoice_for(c.id, 250.01)
+    assert customers.needs_review(c.id) is True
+
+
+def test_paid_invoices_are_ignored():
+    c = customers.add_customer("Acme")
+    for _ in range(4):
+        inv = _invoice_for(c.id, 100.0)
+        invoices.mark_paid(inv.id)
+    assert customers.needs_review(c.id) is False
+
+
+def test_other_customers_invoices_are_ignored():
+    a = customers.add_customer("Acme")
+    b = customers.add_customer("Beta")
+    _invoice_for(b.id, 999.0)
+    assert customers.needs_review(a.id) is False
+
+
+def test_unknown_customer_raises():
+    with pytest.raises(DomainError) as exc:
+        customers.needs_review("C-missing")
+    assert exc.value.code == "E_UNKNOWN_CUSTOMER"
