diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_pickups.py b/tests/unit/test_pickups.py
--- a/tests/unit/test_pickups.py	1969-12-31 19:00:00
+++ b/tests/unit/test_pickups.py	2026-11-12 02:01:51
@@ -0,0 +1,46 @@
+import pytest
+
+from parcelo import clock, customers, pickups, shipments, store
+from parcelo.errors import DomainError
+
+
+def _shipment():
+    c = customers.add_customer("Acme")
+    return shipments.create_shipment(c.id, 2.0, "local")
+
+
+def test_schedule_pickup_saves_and_returns():
+    s = _shipment()
+    window = "2026-11-13T09:00"
+    p = pickups.schedule_pickup(s.id, window)
+    assert p.id.startswith("pkp_")
+    assert p.shipment_id == s.id
+    assert p.window_start == window
+    assert p.scheduled_at is not None
+    assert store.db.pickups[p.id] is p
+
+
+def test_scheduled_at_uses_clock():
+    from datetime import datetime, timezone
+
+    fixed = datetime(2026, 11, 12, 12, 0, tzinfo=timezone.utc)
+    clock.set_fixed(fixed)
+    s = _shipment()
+    p = pickups.schedule_pickup(s.id, "2026-11-13T09:00")
+    assert p.scheduled_at == fixed
+
+
+def test_unknown_shipment_fails():
+    with pytest.raises(DomainError) as err:
+        pickups.schedule_pickup("shp_missing", "2026-11-13T09:00")
+    assert err.value.code == "E_NOT_FOUND"
+    assert store.db.pickups == {}
+
+
+def test_non_created_shipment_fails():
+    s = _shipment()
+    s.status = "delivered"
+    with pytest.raises(DomainError) as err:
+        pickups.schedule_pickup(s.id, "2026-11-13T09:00")
+    assert err.value.code == "E_BAD_STATE"
+    assert store.db.pickups == {}
