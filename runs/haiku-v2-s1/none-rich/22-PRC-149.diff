diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/parcelo/shipments.py b/parcelo/shipments.py
--- a/parcelo/shipments.py	2026-11-10 12:20:18
+++ b/parcelo/shipments.py	2026-11-12 02:04:31
@@ -1,3 +1,5 @@
+import math
+
 from parcelo import clock, events, ids
 from parcelo.errors import DomainError
 from parcelo.models import Shipment
@@ -28,3 +30,43 @@
     if shipment_id not in db.shipments:
         raise DomainError("E_NOT_FOUND", shipment_id)
     return db.shipments[shipment_id]
+
+
+def split_shipment(shipment_id, weights):
+    """Replace a "created" shipment with one new shipment per weight.
+
+    The original is marked "split". Returns the new shipments in the same
+    order as ``weights``. All validation happens before any state changes.
+    """
+    original = get_shipment(shipment_id)
+    if original.status != "created":
+        raise DomainError("E_BAD_STATE", f"{shipment_id} is {original.status}")
+    weights = list(weights)
+    if not weights:
+        raise DomainError("E_BAD_INPUT", "no weights given")
+    for w in weights:
+        if w <= 0:
+            raise DomainError("E_BAD_WEIGHT", str(w))
+    if not math.isclose(sum(weights), original.weight_kg, rel_tol=1e-9, abs_tol=1e-9):
+        raise DomainError(
+            "E_BAD_INPUT",
+            f"weights sum to {sum(weights)}, expected {original.weight_kg}",
+        )
+
+    now = clock.now()
+    new_shipments = []
+    for w in weights:
+        shipment = Shipment(
+            id=ids.new_id("shp"),
+            customer_id=original.customer_id,
+            weight_kg=w,
+            zone=original.zone,
+            created_at=now,
+        )
+        db.shipments[shipment.id] = shipment
+        events.emit("shipment.created", shipment.id, zone=original.zone)
+        new_shipments.append(shipment)
+
+    original.status = "split"
+    events.emit("shipment.split", shipment_id, into=[s.id for s in new_shipments])
+    return new_shipments
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_shipments.py b/tests/unit/test_shipments.py
--- a/tests/unit/test_shipments.py	2026-11-10 12:20:18
+++ b/tests/unit/test_shipments.py	2026-11-12 02:04:38
@@ -15,3 +15,37 @@
     with pytest.raises(DomainError) as err:
         shipments.create_shipment("nope", 1, "local")
     assert err.value.code == "E_UNKNOWN_CUSTOMER"
+
+
+def test_split_creates_shipments_in_weight_order():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 3.0, "national")
+    parts = shipments.split_shipment(s.id, [1.0, 2.0])
+    assert [p.weight_kg for p in parts] == [1.0, 2.0]
+    assert all(p.customer_id == c.id and p.zone == "national" for p in parts)
+    assert all(p.status == "created" for p in parts)
+    assert s.status == "split"
+
+
+def test_split_unknown_shipment():
+    with pytest.raises(DomainError) as err:
+        shipments.split_shipment("nope", [1.0])
+    assert err.value.code == "E_NOT_FOUND"
+
+
+def test_split_requires_created_status():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 2.0, "local")
+    shipments.split_shipment(s.id, [1.0, 1.0])
+    with pytest.raises(DomainError) as err:
+        shipments.split_shipment(s.id, [1.0, 1.0])
+    assert err.value.code == "E_BAD_STATE"
+
+
+def test_split_weights_must_sum_to_original():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 2.0, "local")
+    with pytest.raises(DomainError) as err:
+        shipments.split_shipment(s.id, [1.0, 0.5])
+    assert err.value.code == "E_BAD_INPUT"
+    assert s.status == "created"
