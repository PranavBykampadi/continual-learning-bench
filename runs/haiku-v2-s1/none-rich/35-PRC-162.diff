 def open_invoices():
     return [i for i in db.invoices.values() if i.status == "open"]
+
+
+VALID_STATUSES = ("open", "paid")
+
+
+def invoices_by_status(status):
+    if status not in VALID_STATUSES:
+        raise ValueError("unknown invoice status: %r" % (status,))
+    return [i for i in db.invoices.values() if i.status == status]
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/test_invoices.py b/tests/test_invoices.py
--- a/tests/test_invoices.py	2026-11-10 12:17:53
+++ b/tests/test_invoices.py	2026-11-12 02:10:27
@@ -1,3 +1,5 @@
+import pytest
+
 from parcelo import customers, invoices, shipments
 
 
@@ -7,3 +9,22 @@
     inv = invoices.issue_invoice(s.id)
     assert inv.amount == 7.0
     assert invoices.mark_paid(inv.id).status == "paid"
+
+
+def test_invoices_by_status():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 2, "local")
+    open_inv = invoices.issue_invoice(s.id)
+    paid_inv = invoices.issue_invoice(s.id)
+    invoices.mark_paid(paid_inv.id)
+    assert invoices.invoices_by_status("open") == [open_inv]
+    assert invoices.invoices_by_status("paid") == [paid_inv]
+
+
+def test_invoices_by_status_empty():
+    assert invoices.invoices_by_status("paid") == []
+
+
+def test_invoices_by_status_rejects_unknown():
+    with pytest.raises(ValueError):
+        invoices.invoices_by_status("void")
