+def _open_invoice():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 2, "local")
+    return invoices.issue_invoice(s.id)
+
+
+def test_void_open_invoice():
+    from parcelo import clock
+    from datetime import datetime, timezone
+
+    moment = datetime(2026, 1, 2, 3, 4, 5, tzinfo=timezone.utc)
+    clock.set_fixed(moment)
+    inv = _open_invoice()
+    result = invoices.void_invoice(inv.id)
+    assert result is inv
+    assert result.status == "void"
+    assert result.voided_at == moment
+
+
+def test_void_missing_invoice_fails():
+    from parcelo.errors import DomainError
+    import pytest
+
+    with pytest.raises(DomainError):
+        invoices.void_invoice("INV-nope")
+
+
+def test_void_paid_invoice_fails():
+    from parcelo.errors import DomainError
+    import pytest
+
+    inv = _open_invoice()
+    invoices.mark_paid(inv.id)
+    with pytest.raises(DomainError):
+        invoices.void_invoice(inv.id)
+
+
+def test_void_twice_fails():
+    from parcelo.errors import DomainError
+    import pytest
+
+    inv = _open_invoice()
+    invoices.void_invoice(inv.id)
+    with pytest.raises(DomainError):
+        invoices.void_invoice(inv.id)
