diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/test_customers_rebate.py b/tests/test_customers_rebate.py
--- a/tests/test_customers_rebate.py	1969-12-31 19:00:00
+++ b/tests/test_customers_rebate.py	2026-11-12 02:09:58
@@ -0,0 +1,46 @@
+import pytest
+
+from parcelo import customers, invoices, shipments
+from parcelo.errors import DomainError
+
+
+def _paid_shipments(customer_id, count, zone="local", weight=2):
+    for _ in range(count):
+        s = shipments.create_shipment(customer_id, weight, zone)
+        inv = invoices.issue_invoice(s.id)
+        invoices.mark_paid(inv.id)
+
+
+def test_no_rebate_under_ten_shipments():
+    c = customers.add_customer("Acme")
+    _paid_shipments(c.id, 9)
+    assert customers.rebate_for(c.id) == 0.0
+
+
+def test_three_percent_at_ten_shipments():
+    c = customers.add_customer("Acme")
+    _paid_shipments(c.id, 10)
+    paid = 10 * 7.0
+    assert customers.rebate_for(c.id) == round(paid * 0.03, 2)
+
+
+def test_six_percent_at_fifty_shipments():
+    c = customers.add_customer("Acme")
+    _paid_shipments(c.id, 50)
+    paid = 50 * 7.0
+    assert customers.rebate_for(c.id) == round(paid * 0.06, 2)
+
+
+def test_unpaid_invoices_do_not_count():
+    c = customers.add_customer("Acme")
+    _paid_shipments(c.id, 10)
+    for _ in range(5):
+        s = shipments.create_shipment(c.id, 2, "local")
+        invoices.issue_invoice(s.id)
+    # 15 shipments -> regular tier, but only the 10 paid invoices add to the total
+    assert customers.rebate_for(c.id) == round(10 * 7.0 * 0.03, 2)
+
+
+def test_unknown_customer_raises():
+    with pytest.raises(DomainError):
+        customers.rebate_for("C-does-not-exist")
