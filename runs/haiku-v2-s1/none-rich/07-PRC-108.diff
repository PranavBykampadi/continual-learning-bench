+from parcelo import reports, store
+from parcelo.models import Customer, Invoice, Shipment
+
+
+def _setup():
+    store.db.customers["A"] = Customer(id="A", name="Alice")
+    store.db.customers["B"] = Customer(id="B", name="Bob")
+    store.db.customers["C"] = Customer(id="C", name="Carol")
+    store.db.shipments["s1"] = Shipment(id="s1", customer_id="A", weight_kg=1, zone="local")
+    store.db.shipments["s2"] = Shipment(id="s2", customer_id="B", weight_kg=1, zone="local")
+
+
+def test_outstanding_sums_only_open_invoices_per_customer():
+    _setup()
+    store.db.invoices["i1"] = Invoice(id="i1", shipment_id="s1", amount=0.1, status="open")
+    store.db.invoices["i2"] = Invoice(id="i2", shipment_id="s1", amount=0.2, status="open")
+    store.db.invoices["i3"] = Invoice(id="i3", shipment_id="s2", amount=5.0, status="paid")
+    store.db.invoices["i4"] = Invoice(id="i4", shipment_id="s2", amount=7.0, status="void")
+
+    result = reports.outstanding_by_customer()
+
+    assert result == {"A": 0.3, "B": 0.0, "C": 0.0}
+
+
+def test_outstanding_includes_customers_with_no_invoices():
+    _setup()
+    assert reports.outstanding_by_customer() == {"A": 0.0, "B": 0.0, "C": 0.0}
