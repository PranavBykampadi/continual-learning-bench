 from datetime import datetime
 
+from parcelo.money import Money
 from parcelo.store import db
+
+
+def outstanding_by_customer():
+    """Map each customer id to the total of their open invoices.
+
+    Paid and void invoices are excluded. Every known customer appears in the
+    result, with 0.0 if they have no open invoices. Totals are summed in
+    integer cents to avoid floating-point drift.
+    """
+    cents = {customer_id: 0 for customer_id in db.customers}
+    for invoice in db.invoices.values():
+        if invoice.status != "open":
+            continue
+        customer_id = db.shipments[invoice.shipment_id].customer_id
+        cents[customer_id] = cents.get(customer_id, 0) + Money.parse(invoice.amount).cents
+    return {customer_id: total / 100 for customer_id, total in cents.items()}
 
 
