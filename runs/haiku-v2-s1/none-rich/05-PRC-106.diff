 def open_invoices():
     return [i for i in db.invoices.values() if i.status == "open"]
+
+
+def late_fee_for(invoice_id):
+    """Late fee for an invoice: 1.5% of the amount per day past the 30-day grace period."""
+    if invoice_id not in db.invoices:
+        raise DomainError("E_NOT_FOUND", invoice_id)
+    invoice = db.invoices[invoice_id]
+    now = clock.now()
+    if invoice.issued_at.tzinfo is None:
+        # issue_invoice stores naive UTC timestamps; compare like with like.
+        now = now.replace(tzinfo=None)
+    days_outstanding = (now - invoice.issued_at).days
+    return late_fee(invoice.amount, days_outstanding - LATE_AFTER_DAYS)
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/test_invoices.py b/tests/test_invoices.py
--- a/tests/test_invoices.py	2026-11-10 12:17:53
+++ b/tests/test_invoices.py	2026-11-12 01:54:59
@@ -1,9 +1,51 @@
-from parcelo import customers, invoices, shipments
+from datetime import datetime, timedelta, timezone
 
+import pytest
 
+from parcelo import clock, customers, invoices, shipments
+from parcelo.errors import DomainError
+from parcelo.models import Invoice
+from parcelo.store import db
+
+
 def test_issue_and_pay():
     c = customers.add_customer("Acme")
     s = shipments.create_shipment(c.id, 2, "local")
     inv = invoices.issue_invoice(s.id)
     assert inv.amount == 7.0
     assert invoices.mark_paid(inv.id).status == "paid"
+
+
+def _invoice_issued_days_ago(days, amount=100.0):
+    now = datetime(2026, 11, 12, 12, 0, tzinfo=timezone.utc)
+    clock.set_fixed(now)
+    inv = Invoice(
+        id="INV-test",
+        shipment_id="shp-x",
+        amount=amount,
+        issued_at=(now - timedelta(days=days)).replace(tzinfo=None),
+    )
+    db.invoices[inv.id] = inv
+    return inv
+
+
+@pytest.mark.parametrize("days_old", [0, 15, 30])
+def test_late_fee_zero_within_grace_period(days_old):
+    inv = _invoice_issued_days_ago(days_old)
+    assert invoices.late_fee_for(inv.id) == 0.0
+
+
+def test_late_fee_starts_day_after_thirty():
+    inv = _invoice_issued_days_ago(31)
+    assert invoices.late_fee_for(inv.id) == 1.5
+
+
+def test_late_fee_accrues_per_day():
+    inv = _invoice_issued_days_ago(40, amount=200.0)
+    # 40 days outstanding = 10 days past the 30-day mark; 1.5% of 200 * 10 = 30.
+    assert invoices.late_fee_for(inv.id) == 30.0
+
+
+def test_late_fee_unknown_invoice_fails():
+    with pytest.raises(DomainError):
+        invoices.late_fee_for("INV-missing")
