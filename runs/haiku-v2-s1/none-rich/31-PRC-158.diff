diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/test_returns.py b/tests/test_returns.py
--- a/tests/test_returns.py	1969-12-31 19:00:00
+++ b/tests/test_returns.py	2026-11-12 02:08:52
@@ -0,0 +1,67 @@
+import pytest
+
+from parcelo import customers, returns, shipments, store
+from parcelo.errors import DomainError
+
+
+def _delivered_shipment():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 2.0, "national")
+    s.status = "delivered"
+    return s
+
+
+def test_request_return_saves_and_returns_request():
+    s = _delivered_shipment()
+    r = returns.request_return(s.id, "damaged")
+    assert r.id.startswith("ret_")
+    assert r.shipment_id == s.id
+    assert r.reason == "damaged"
+    assert r.requested_at is not None
+    assert store.db.returns[r.id] is r
+    assert returns.returns_for(s.id) == [r]
+
+
+def test_returns_for_unknown_shipment_is_empty():
+    assert returns.returns_for("shp_missing") == []
+
+
+def test_unknown_shipment_fails():
+    with pytest.raises(DomainError) as err:
+        returns.request_return("shp_missing", "oops")
+    assert err.value.code == "E_NOT_FOUND"
+
+
+def test_undelivered_shipment_cannot_be_returned():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 2.0, "national")
+    with pytest.raises(DomainError) as err:
+        returns.request_return(s.id, "changed mind")
+    assert err.value.code == "E_BAD_STATE"
+    assert returns.returns_for(s.id) == []
+
+
+def test_fourth_return_request_fails():
+    s = _delivered_shipment()
+    for i in range(3):
+        returns.request_return(s.id, f"reason {i}")
+    with pytest.raises(DomainError) as err:
+        returns.request_return(s.id, "one too many")
+    assert err.value.code == "E_LIMIT"
+    assert len(returns.returns_for(s.id)) == 3
+
+
+def test_limit_is_per_shipment():
+    s1 = _delivered_shipment()
+    s2 = _delivered_shipment()
+    for i in range(3):
+        returns.request_return(s1.id, f"reason {i}")
+    r = returns.request_return(s2.id, "fine")
+    assert r.shipment_id == s2.id
+
+
+def test_reset_clears_returns():
+    s = _delivered_shipment()
+    returns.request_return(s.id, "damaged")
+    store.reset()
+    assert store.db.returns == {}
