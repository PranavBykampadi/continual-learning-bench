@@ -0,0 +1,21 @@
+from parcelo import customers, reports, shipments
+
+
+def test_volume_report_counts_and_tiers():
+    busy = customers.add_customer("Busy")
+    idle = customers.add_customer("Idle")
+    for _ in range(10):
+        shipments.create_shipment(busy.id, 1, "local")
+
+    result = reports.volume_report()
+
+    assert result[busy.id] == {"shipments": 10, "tier": "regular"}
+    assert result[idle.id] == {"shipments": 0, "tier": "starter"}
+
+
+def test_volume_report_bulk_tier_at_fifty():
+    c = customers.add_customer("Big")
+    for _ in range(50):
+        shipments.create_shipment(c.id, 1, "local")
+
+    assert reports.volume_report()[c.id] == {"shipments": 50, "tier": "bulk"}
