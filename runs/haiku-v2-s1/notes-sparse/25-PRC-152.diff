diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/parcelo/shipments.py b/parcelo/shipments.py
--- a/parcelo/shipments.py	2026-11-10 12:20:18
+++ b/parcelo/shipments.py	2026-11-12 02:16:58
@@ -28,3 +28,11 @@
     if shipment_id not in db.shipments:
         raise DomainError("E_NOT_FOUND", shipment_id)
     return db.shipments[shipment_id]
+
+
+def mark_lost(shipment_id):
+    shipment = get_shipment(shipment_id)
+    if shipment.delivered_at is not None:
+        raise DomainError("E_BAD_STATE", "a delivered shipment cannot be marked lost")
+    shipment.status = "lost"
+    return shipment
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_shipments.py b/tests/unit/test_shipments.py
--- a/tests/unit/test_shipments.py	2026-11-10 12:20:18
+++ b/tests/unit/test_shipments.py	2026-11-12 02:17:01
@@ -1,6 +1,6 @@
 import pytest
 
-from parcelo import customers, events, shipments
+from parcelo import clock, customers, events, shipments
 from parcelo.errors import DomainError
 
 
@@ -15,3 +15,26 @@
     with pytest.raises(DomainError) as err:
         shipments.create_shipment("nope", 1, "local")
     assert err.value.code == "E_UNKNOWN_CUSTOMER"
+
+
+def test_mark_lost():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 1, "local")
+    assert shipments.mark_lost(s.id) is s
+    assert s.status == "lost"
+
+
+def test_mark_lost_unknown_shipment():
+    with pytest.raises(DomainError) as err:
+        shipments.mark_lost("shp_missing")
+    assert err.value.code == "E_NOT_FOUND"
+
+
+def test_mark_lost_delivered_fails():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 1, "local")
+    s.delivered_at = clock.now()
+    with pytest.raises(DomainError) as err:
+        shipments.mark_lost(s.id)
+    assert err.value.code == "E_BAD_STATE"
+    assert s.status == "created"
