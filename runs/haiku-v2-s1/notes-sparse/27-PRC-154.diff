--- a/tests/unit/test_customers.py	1969-12-31 19:00:00
+++ b/tests/unit/test_customers.py	2026-11-12 02:18:41
@@ -0,0 +1,16 @@
+import pytest
+
+from parcelo import customers
+
+
+def test_reactivate_sets_active_and_returns_customer():
+    c = customers.add_customer("Acme")
+    c.active = False
+    result = customers.reactivate_customer(c.id)
+    assert result is c
+    assert c.active is True
+
+
+def test_reactivate_unknown_customer_fails():
+    with pytest.raises(KeyError):
+        customers.reactivate_customer("C_missing")
