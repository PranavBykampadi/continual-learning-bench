--- a/parcelo/rates.py	2026-11-10 12:17:53
+++ b/parcelo/rates.py	2026-11-12 02:08:19
@@ -1,5 +1,10 @@
+from parcelo.errors import DomainError
+from parcelo.legacy.billing import fuel_surcharge
+
 ZONE_BASE = {"local": 4.5, "national": 9.0, "international": 24.0}
 PER_KG = 1.25
+INSURANCE_RATE = 0.02
+INSURANCE_MIN_FEE = 1.00
 
 
 def base_rate(zone):
@@ -12,3 +17,13 @@
     if weight_kg <= 0:
         raise ValueError("weight must be positive")
     return round(base_rate(zone) + PER_KG * weight_kg, 2)
+
+
+def insurance_fee(declared_value, zone):
+    """Insurance for a declared value: 2% plus the zone's fuel surcharge, minimum 1.00."""
+    if zone not in ZONE_BASE:
+        raise DomainError("E_BAD_ZONE", "unknown zone")
+    if declared_value <= 0:
+        raise DomainError("E_BAD_INPUT", "declared value must be positive")
+    fee = declared_value * INSURANCE_RATE + fuel_surcharge(declared_value, zone)
+    return max(INSURANCE_MIN_FEE, round(fee, 2))
