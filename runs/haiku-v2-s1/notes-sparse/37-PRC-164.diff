diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/parcelo/vouchers.py b/parcelo/vouchers.py
--- a/parcelo/vouchers.py	1969-12-31 19:00:00
+++ b/parcelo/vouchers.py	2026-11-12 02:28:25
@@ -0,0 +1,25 @@
+from parcelo import clock, ids
+from parcelo.errors import DomainError
+from parcelo.models import Voucher
+from parcelo.store import db
+
+MAX_VOUCHER_AMOUNT = 150.00
+
+
+def issue_voucher(customer_id, amount):
+    if not db.has_customer(customer_id):
+        raise DomainError("E_UNKNOWN_CUSTOMER", "customer does not exist")
+    if amount <= 0:
+        raise DomainError("E_BAD_INPUT", "voucher amount must be greater than zero")
+    if amount > MAX_VOUCHER_AMOUNT:
+        raise DomainError(
+            "E_LIMIT", f"voucher amount cannot exceed {MAX_VOUCHER_AMOUNT:.2f}"
+        )
+    voucher = Voucher(
+        id=ids.new_id("vch"),
+        customer_id=customer_id,
+        amount=amount,
+        issued_at=clock.now(),
+    )
+    db.add_voucher(voucher)
+    return voucher
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/test_vouchers.py b/tests/test_vouchers.py
--- a/tests/test_vouchers.py	1969-12-31 19:00:00
+++ b/tests/test_vouchers.py	2026-11-12 02:28:27
@@ -0,0 +1,42 @@
+import pytest
+
+from parcelo import customers, vouchers
+from parcelo.errors import DomainError
+from parcelo.store import db
+
+
+def test_issue_voucher_saves_and_returns():
+    c = customers.add_customer("Acme")
+    v = vouchers.issue_voucher(c.id, 25.0)
+    assert v.id.startswith("vch_")
+    assert v.customer_id == c.id
+    assert v.amount == 25.0
+    assert v.issued_at is not None
+    assert db.get_voucher(v.id) is v
+
+
+def test_max_amount_is_allowed():
+    c = customers.add_customer("Acme")
+    v = vouchers.issue_voucher(c.id, 150.0)
+    assert v.amount == 150.0
+
+
+def test_amount_over_max_rejected():
+    c = customers.add_customer("Acme")
+    with pytest.raises(DomainError) as err:
+        vouchers.issue_voucher(c.id, 150.01)
+    assert err.value.code == "E_LIMIT"
+
+
+@pytest.mark.parametrize("amount", [0, -5.0])
+def test_zero_or_negative_amount_rejected(amount):
+    c = customers.add_customer("Acme")
+    with pytest.raises(DomainError) as err:
+        vouchers.issue_voucher(c.id, amount)
+    assert err.value.code == "E_BAD_INPUT"
+
+
+def test_unknown_customer_rejected():
+    with pytest.raises(DomainError) as err:
+        vouchers.issue_voucher("nope", 10.0)
+    assert err.value.code == "E_UNKNOWN_CUSTOMER"
