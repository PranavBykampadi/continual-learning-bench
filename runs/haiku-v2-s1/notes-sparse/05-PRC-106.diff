 def open_invoices():
     return [i for i in db.invoices.values() if i.status == "open"]
+
+
+def _as_utc(moment):
+    # issue_invoice stores naive UTC datetimes; clock.now() is timezone-aware.
+    if moment.tzinfo is None:
+        return moment.replace(tzinfo=timezone.utc)
+    return moment
+
+
+def late_fee_for(invoice_id):
+    if invoice_id not in db.invoices:
+        raise DomainError("E_NOT_FOUND", invoice_id)
+    invoice = db.invoices[invoice_id]
+    elapsed_days = (_as_utc(clock.now()) - _as_utc(invoice.issued_at)).days
+    days_late = elapsed_days - LATE_AFTER_DAYS
+    return late_fee(invoice.amount, days_late)
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/test_invoices.py b/tests/test_invoices.py
--- a/tests/test_invoices.py	2026-11-10 12:17:53
+++ b/tests/test_invoices.py	2026-11-12 01:57:31
@@ -1,9 +1,65 @@
-from parcelo import customers, invoices, shipments
+from datetime import datetime, timedelta, timezone
 
+import pytest
 
+from parcelo import clock, customers, invoices, shipments
+from parcelo.errors import DomainError
+from parcelo.models import Invoice
+from parcelo.store import db
+
+ISSUED = datetime(2026, 1, 1, tzinfo=timezone.utc)
+
+
 def test_issue_and_pay():
     c = customers.add_customer("Acme")
     s = shipments.create_shipment(c.id, 2, "local")
     inv = invoices.issue_invoice(s.id)
     assert inv.amount == 7.0
     assert invoices.mark_paid(inv.id).status == "paid"
+
+
+def _invoice(amount=100.0, issued_at=ISSUED):
+    inv = Invoice(id="INV-test", shipment_id="shp-test", amount=amount, issued_at=issued_at)
+    db.invoices[inv.id] = inv
+    return inv
+
+
+def _pin(days_after_issue):
+    clock.set_fixed(ISSUED + timedelta(days=days_after_issue))
+
+
+def test_late_fee_zero_before_grace_period():
+    inv = _invoice()
+    _pin(29)
+    assert invoices.late_fee_for(inv.id) == 0.0
+    clock.clear_fixed()
+
+
+def test_late_fee_zero_on_day_thirty():
+    inv = _invoice()
+    _pin(30)
+    assert invoices.late_fee_for(inv.id) == 0.0
+    clock.clear_fixed()
+
+
+def test_late_fee_accrues_per_day_past_thirty():
+    inv = _invoice(amount=200.0)
+    _pin(40)
+    # 10 days past the grace period: 200 * 0.015 * 10
+    assert invoices.late_fee_for(inv.id) == 30.0
+    clock.clear_fixed()
+
+
+def test_late_fee_accepts_naive_issued_at_from_issue_invoice():
+    inv = _invoice(amount=200.0, issued_at=datetime(2026, 1, 1))
+    _pin(31)
+    assert invoices.late_fee_for(inv.id) == 3.0
+    clock.clear_fixed()
+
+
+def test_late_fee_missing_invoice_fails():
+    _pin(40)
+    with pytest.raises(DomainError) as err:
+        invoices.late_fee_for("INV-missing")
+    assert err.value.code == "E_NOT_FOUND"
+    clock.clear_fixed()
