+from parcelo import audit, clock, customers, shipments
 from parcelo.errors import DomainError
 
 
@@ -15,3 +17,42 @@
     with pytest.raises(DomainError) as err:
         shipments.create_shipment("nope", 1, "local")
     assert err.value.code == "E_UNKNOWN_CUSTOMER"
+
+
+def _make_shipment():
+    c = customers.add_customer("Acme")
+    return shipments.create_shipment(c.id, 1.5, "national")
+
+
+def test_add_note_appends_timestamped_text():
+    s = _make_shipment()
+    moment = datetime(2026, 11, 1, 9, 30, tzinfo=timezone.utc)
+    clock.set_fixed(moment)
+    try:
+        result = shipments.add_note(s.id, "left at front desk")
+    finally:
+        clock.clear_fixed()
+    assert result is s
+    assert s.notes == [{"text": "left at front desk", "at": moment}]
+    assert audit.LOG[-1]["action"] == "shipment.note_added"
+
+
+def test_add_note_keeps_original_text():
+    s = _make_shipment()
+    shipments.add_note(s.id, "  padded  ")
+    assert s.notes[0]["text"] == "  padded  "
+
+
+def test_add_note_unknown_shipment():
+    with pytest.raises(DomainError) as err:
+        shipments.add_note("shp_missing", "hello")
+    assert err.value.code == "E_NOT_FOUND"
+
+
+def test_add_note_empty_text_rejected():
+    s = _make_shipment()
+    for bad in ["", "   "]:
+        with pytest.raises(DomainError) as err:
+            shipments.add_note(s.id, bad)
+        assert err.value.code == "E_BAD_INPUT"
+    assert s.notes == []
