diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/parcelo/returns.py b/parcelo/returns.py
--- a/parcelo/returns.py	1969-12-31 19:00:00
+++ b/parcelo/returns.py	2026-11-12 02:22:45
@@ -0,0 +1,27 @@
+from parcelo import clock, ids
+from parcelo.errors import DomainError
+from parcelo.models import DELIVERED, ReturnRequest
+from parcelo.shipments import get_shipment
+from parcelo.store import returns_for_shipment, save_return
+
+MAX_RETURNS_PER_SHIPMENT = 3
+
+
+def request_return(shipment_id, reason):
+    shipment = get_shipment(shipment_id)
+    if shipment.status != DELIVERED:
+        raise DomainError("E_BAD_STATE", "only delivered shipments can be returned")
+    if len(returns_for_shipment(shipment_id)) >= MAX_RETURNS_PER_SHIPMENT:
+        raise DomainError("E_LIMIT", "shipment already has the maximum number of return requests")
+    return_request = ReturnRequest(
+        id=ids.new_id("ret"),
+        shipment_id=shipment_id,
+        reason=reason,
+        requested_at=clock.now(),
+    )
+    save_return(return_request)
+    return return_request
+
+
+def returns_for(shipment_id):
+    return returns_for_shipment(shipment_id)
