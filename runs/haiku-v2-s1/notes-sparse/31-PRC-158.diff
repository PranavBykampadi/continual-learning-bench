diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_returns.py b/tests/unit/test_returns.py
--- a/tests/unit/test_returns.py	1969-12-31 19:00:00
+++ b/tests/unit/test_returns.py	2026-11-12 02:22:50
@@ -0,0 +1,72 @@
+from datetime import datetime, timezone
+
+import pytest
+
+from parcelo import clock, customers, returns, shipments
+from parcelo.errors import DomainError
+from parcelo.models import DELIVERED
+
+
+def _delivered_shipment():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 2, "local")
+    return shipments.mark_delivered(s.id)
+
+
+def test_request_return_saves_and_returns_request():
+    moment = datetime(2026, 11, 1, 9, 30, tzinfo=timezone.utc)
+    clock.set_fixed(moment)
+    s = _delivered_shipment()
+    r = returns.request_return(s.id, "damaged box")
+    assert r.id.startswith("ret_")
+    assert r.shipment_id == s.id
+    assert r.reason == "damaged box"
+    assert r.requested_at == moment
+    assert returns.returns_for(s.id) == [r]
+
+
+def test_returns_for_only_lists_that_shipment():
+    first = _delivered_shipment()
+    second = _delivered_shipment()
+    r1 = returns.request_return(first.id, "wrong item")
+    returns.request_return(second.id, "late")
+    assert returns.returns_for(first.id) == [r1]
+
+
+def test_returns_for_unreturned_shipment_is_empty():
+    s = _delivered_shipment()
+    assert returns.returns_for(s.id) == []
+
+
+def test_unknown_shipment_is_not_found():
+    with pytest.raises(DomainError) as err:
+        returns.request_return("shp_missing", "reason")
+    assert err.value.code == "E_NOT_FOUND"
+
+
+def test_shipment_not_delivered_is_bad_state():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 2, "local")
+