diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_shipments.py b/tests/unit/test_shipments.py
--- a/tests/unit/test_shipments.py	2026-11-10 12:20:18
+++ b/tests/unit/test_shipments.py	2026-11-12 02:23:33
@@ -15,3 +15,26 @@
     with pytest.raises(DomainError) as err:
         shipments.create_shipment("nope", 1, "local")
     assert err.value.code == "E_UNKNOWN_CUSTOMER"
+
+
+def test_shipments_in_zone_returns_matches_only():
+    c = customers.add_customer("Acme")
+    local = shipments.create_shipment(c.id, 1, "local")
+    national_a = shipments.create_shipment(c.id, 2, "national")
+    national_b = shipments.create_shipment(c.id, 3, "national")
+    result = shipments.shipments_in_zone("national")
+    assert sorted(s.id for s in result) == sorted([national_a.id, national_b.id])
+    assert all(s.zone == "national" for s in result)
+    assert local.id not in [s.id for s in result]
+
+
+def test_shipments_in_zone_empty_when_none():
+    c = customers.add_customer("Acme")
+    shipments.create_shipment(c.id, 1, "local")
+    assert shipments.shipments_in_zone("international") == []
+
+
+def test_shipments_in_zone_unknown_zone_fails():
+    with pytest.raises(DomainError) as err:
+        shipments.shipments_in_zone("moon")
+    assert err.value.code == "E_BAD_ZONE"
