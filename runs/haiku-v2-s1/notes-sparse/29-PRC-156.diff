 def test_unknown_zone():
     with pytest.raises(ValueError):
         rates.base_rate("moon")
+
+
+def test_heavy_quote_at_threshold_is_normal_quote():
+    assert rates.heavy_quote(30, "local") == rates.quote(30, "local")
+
+
+def test_heavy_quote_adds_surcharge_above_30kg():
+    # 4.5 + 1.25 * 32 + 0.75 * 2 = 46.0
+    assert rates.heavy_quote(32, "local") == 46.0
+
+
+def test_heavy_quote_light_parcel_is_normal_quote():
+    assert rates.heavy_quote(2, "local") == rates.quote(2, "local")
+
+
+def test_heavy_quote_unknown_zone_raises():
+    with pytest.raises(DomainError) as exc:
+        rates.heavy_quote(40, "moon")
+    assert exc.value.code == "E_BAD_ZONE"
+
+
+@pytest.mark.parametrize("weight", [0, -1])
+def test_heavy_quote_non_positive_weight_raises(weight):
+    with pytest.raises(DomainError) as exc:
+        rates.heavy_quote(weight, "local")
+    assert exc.value.code == "E_BAD_WEIGHT"
