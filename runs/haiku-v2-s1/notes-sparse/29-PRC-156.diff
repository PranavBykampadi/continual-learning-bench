diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/parcelo/rates.py b/parcelo/rates.py
--- a/parcelo/rates.py	2026-11-10 12:17:53
+++ b/parcelo/rates.py	2026-11-12 02:20:11
@@ -1,5 +1,9 @@
+from parcelo.errors import DomainError
+
 ZONE_BASE = {"local": 4.5, "national": 9.0, "international": 24.0}
 PER_KG = 1.25
+HEAVY_THRESHOLD_KG = 30
+HEAVY_PER_KG = 0.75
 
 
 def base_rate(zone):
@@ -8,7 +12,20 @@
     return ZONE_BASE[zone]
 
 
+def _unrounded(weight_kg, zone):
+    return base_rate(zone) + PER_KG * weight_kg
+
+
 def quote(weight_kg, zone):
     if weight_kg <= 0:
         raise ValueError("weight must be positive")
-    return round(base_rate(zone) + PER_KG * weight_kg, 2)
+    return round(_unrounded(weight_kg, zone), 2)
+
+
+def heavy_quote(weight_kg, zone):
+    if zone not in ZONE_BASE:
+        raise DomainError("E_BAD_ZONE", "zone is not a known shipping zone")
+    if weight_kg <= 0:
+        raise DomainError("E_BAD_WEIGHT", "weight must be positive")
+    surcharge = HEAVY_PER_KG * max(0, weight_kg - HEAVY_THRESHOLD_KG)
+    return round(_unrounded(weight_kg, zone) + surcharge, 2)
