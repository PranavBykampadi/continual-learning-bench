+from parcelo.invoices import open_invoices
+from parcelo.legacy.billing import days_between
 from parcelo.store import db
+
+
+def _naive_utc_now():
+    # issue_invoice stores naive UTC datetimes; clock.now() is timezone-aware.
+    now = clock.now()
+    if now.tzinfo is not None:
+        now = now.astimezone(timezone.utc).replace(tzinfo=None)
+    return now
+
+
+def aging_report():
+    buckets = {"0-30": 0.0, "31-60": 0.0, "60+": 0.0}
+    now = _naive_utc_now()
+    for invoice in open_invoices():
+        if invoice.issued_at is None:
+            raise DomainError("E_BAD_STATE", f"invoice {invoice.id} has no issue date")
+        age = days_between(invoice.issued_at, now)
+        if age < 0:
+            raise DomainError("E_BAD_STATE", f"invoice {invoice.id} is issued in the future")
+        if age <= 30:
+            key = "0-30"
+        elif age <= 60:
+            key = "31-60"
+        else:
+            key = "60+"
+        buckets[key] += invoice.amount
+    return {key: round(total, 2) for key, total in buckets.items()}
 
 
