diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_customers.py b/tests/unit/test_customers.py
--- a/tests/unit/test_customers.py	1969-12-31 19:00:00
+++ b/tests/unit/test_customers.py	2026-11-12 01:54:38
@@ -0,0 +1,46 @@
+import pytest
+
+from parcelo import audit, customers
+from parcelo.errors import DomainError
+from parcelo.store import db
+
+
+def _customer(name="Acme", tier="standard"):
+    return customers.add_customer(name, tier)
+
+
+def test_deactivate_sets_inactive_and_returns_customer():
+    c = _customer()
+    result = customers.deactivate_customer(c.id)
+    assert result is c
+    assert c.active is False
+    assert db.customers[c.id].active is False
+
+
+def test_deactivate_records_audit():
+    c = _customer()
+    customers.deactivate_customer(c.id)
+    assert audit.LOG[-1]["action"] == "customer.deactivated"
+    assert audit.LOG[-1]["entity_id"] == c.id
+
+
+def test_deactivate_unknown_customer_fails():
+    _customer()
+    before = {k: v.active for k, v in db.customers.items()}
+    audit_len = len(audit.LOG)
+    with pytest.raises(DomainError) as err:
+        customers.deactivate_customer("C-missing")
+    assert err.value.code == "E_NOT_FOUND"
+    assert {k: v.active for k, v in db.customers.items()} == before
+    assert len(audit.LOG) == audit_len
+
+
+def test_deactivate_already_inactive_fails():
+    c = _customer()
+    customers.deactivate_customer(c.id)
+    audit_len = len(audit.LOG)
+    with pytest.raises(DomainError) as err:
+        customers.deactivate_customer(c.id)
+    assert err.value.code == "E_BAD_STATE"
+    assert db.customers[c.id].active is False
+    assert len(audit.LOG) == audit_len
