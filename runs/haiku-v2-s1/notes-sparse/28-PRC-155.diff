diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_customers.py b/tests/unit/test_customers.py
--- a/tests/unit/test_customers.py	1969-12-31 19:00:00
+++ b/tests/unit/test_customers.py	2026-11-12 02:19:21
@@ -0,0 +1,28 @@
+import pytest
+
+from parcelo import customers
+from parcelo.errors import DomainError
+
+
+def test_customers_by_tier_returns_matching_customers():
+    a = customers.add_customer("Acme", tier="gold")
+    customers.add_customer("Birch")
+    c = customers.add_customer("Cedar", tier="gold")
+    result = customers.customers_by_tier("gold")
+    assert sorted(x.id for x in result) == sorted([a.id, c.id])
+    assert all(x.tier == "gold" for x in result)
+
+
+def test_customers_by_tier_empty_when_none_match():
+    customers.add_customer("Birch", tier="standard")
+    assert customers.customers_by_tier("gold") == []
+
+
+def test_customers_by_tier_empty_when_no_customers():
+    assert customers.customers_by_tier("standard") == []
+
+
+def test_customers_by_tier_unknown_tier_fails():
+    with pytest.raises(DomainError) as err:
+        customers.customers_by_tier("platinum")
+    assert err.value.code == "E_BAD_INPUT"
