@@ -31,4 +36,22 @@
 
 
 def open_invoices():
-    return [i for i in db.invoices.values() if i.status == "open"]
+    return [i for i in db.invoices.values() if i.status == OPEN]
+
+
+def apply_credit(invoice_id, amount):
+    """Reduce an open invoice's amount by a credit; return the remaining amount."""
+    if invoice_id not in db.invoices:
+        raise DomainError("E_NOT_FOUND", f"no invoice with id {invoice_id}")
+    if isinstance(amount, bool) or not isinstance(amount, (int, float)):
+        raise DomainError("E_BAD_INPUT", "credit must be a number")
+    if math.isnan(amount) or amount <= 0:
+        raise DomainError("E_BAD_INPUT", "credit must be a positive number")
+    invoice = db.invoices[invoice_id]
+    if invoice.status != OPEN:
+        raise DomainError("E_BAD_STATE", "credit can only be applied to an open invoice")
+    if amount > invoice.amount:
+        raise DomainError("E_BAD_INPUT", "credit exceeds invoice amount")
+    invoice.amount = round(invoice.amount - amount, 2)
+    audit.record("invoice.credit_applied", invoice_id, credit=amount, remaining=invoice.amount)
+    return invoice.amount
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_invoices.py b/tests/unit/test_invoices.py
--- a/tests/unit/test_invoices.py	1969-12-31 19:00:00
+++ b/tests/unit/test_invoices.py	2026-11-12 02:03:09
@@ -0,0 +1,75 @@
+import pytest
+
+from parcelo import audit, clock, customers, invoices, reports, shipments
+from parcelo.errors import DomainError
+
+
+def _open_invoice(amount_kg=2):
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, amount_kg, "local")
+    return c, invoices.issue_invoice(s.id)
+
+
+def test_apply_credit_reduces_open_invoice_and_returns_remaining():
+    _, inv = _open_invoice()
+    before = inv.amount
+    remaining = invoices.apply_credit(inv.id, 2.5)
+    assert remaining == round(before - 2.5, 2)
+    assert inv.amount == remaining
+    assert inv.status == "open"
+
+
+def test_apply_credit_equal_to_amount_leaves_zero():
+    _, inv = _open_invoice()
+    assert invoices.apply_credit(inv.id, inv.amount) == 0
+
+
+def test_apply_credit_flows_into_outstanding_balance_and_reports():
+    c, inv = _open_invoice()
+    invoices.apply_credit(inv.id, 1.0)
+    assert customers.outstanding_balance(c.id) == round(inv.amount, 2)
+    assert reports.revenue_total() == 0
+    invoices.mark_paid(inv.id)
+    assert reports.revenue_total() == round(inv.amount, 2)
+
+
+def test_apply_credit_records_audit_entry():
+    _, inv = _open_invoice()
+    invoices.apply_credit(inv.id, 1.0)
+    assert audit.LOG[-1]["action"] == "invoice.credit_applied"
+    assert audit.LOG[-1]["entity_id"] == inv.id
+
+
+def test_apply_credit_unknown_invoice_fails():
+    with pytest.raises(DomainError) as exc:
+        invoices.apply_credit("INV-missing", 1.0)
+    assert exc.value.code == "E_NOT_FOUND"
+
+
+def test_apply_credit_to_paid_invoice_fails():
+    _, inv = _open_invoice()
+    invoices.mark_paid(inv.id)
+    amount_before = inv.amount
+    with pytest.raises(DomainError) as exc:
+        invoices.apply_credit(inv.id, 1.0)
+    assert exc.value.code == "E_BAD_STATE"
+    assert inv.amount == amount_before
+
+
+def test_apply_credit_larger_than_amount_fails():
+    _, inv = _open_invoice()
+    amount_before = inv.amount
+    with pytest.raises(DomainError) as exc:
+        invoices.apply_credit(inv.id, inv.amount + 0.01)
+    assert exc.value.code == "E_BAD_INPUT"
+    assert inv.amount == amount_before
+
+
+@pytest.mark.parametrize("bad", [0, -1, True, "5", None, float("nan")])
+def test_apply_credit_rejects_invalid_amount(bad):
+    _, inv = _open_invoice()
+    amount_before = inv.amount
+    with pytest.raises(DomainError) as exc:
+        invoices.apply_credit(inv.id, bad)
+    assert exc.value.code == "E_BAD_INPUT"
+    assert inv.amount == amount_before
