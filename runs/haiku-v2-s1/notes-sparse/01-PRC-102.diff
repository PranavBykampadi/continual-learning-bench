diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_invoices.py b/tests/unit/test_invoices.py
--- a/tests/unit/test_invoices.py	1969-12-31 19:00:00
+++ b/tests/unit/test_invoices.py	2026-11-12 01:51:13
@@ -0,0 +1,51 @@
+import pytest
+
+from parcelo import audit, clock, customers, invoices, shipments
+from parcelo.errors import DomainError
+from parcelo.store import db
+
+
+def _open_invoice():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 2, "local")
+    return invoices.issue_invoice(s.id)
+
+
+def test_void_open_invoice():
+    inv = _open_invoice()
+    clock.set_fixed("2026-11-12T10:00:00+00:00")
+    result = invoices.void_invoice(inv.id)
+    assert result is inv
+    assert result.status == "void"
+    assert result.voided_at == "2026-11-12T10:00:00+00:00"
+    assert db.invoices[inv.id].status == "void"
+
+
+def test_void_records_audit():
+    inv = _open_invoice()
+    invoices.void_invoice(inv.id)
+    assert audit.LOG[-1]["action"] == "invoice.voided"
+    assert audit.LOG[-1]["entity_id"] == inv.id
+
+
+def test_void_unknown_invoice():
+    with pytest.raises(DomainError) as err:
+        invoices.void_invoice("INV-missing")
+    assert err.value.code == "E_NOT_FOUND"
+
+
+def test_void_paid_invoice_fails():
+    inv = _open_invoice()
+    invoices.mark_paid(inv.id)
+    with pytest.raises(DomainError) as err:
+        invoices.void_invoice(inv.id)
+    assert err.value.code == "E_BAD_STATE"
+    assert db.invoices[inv.id].status == "paid"
+
+
+def test_void_already_void_invoice_fails():
+    inv = _open_invoice()
+    invoices.void_invoice(inv.id)
+    with pytest.raises(DomainError) as err:
+        invoices.void_invoice(inv.id)
+    assert err.value.code == "E_BAD_STATE"
