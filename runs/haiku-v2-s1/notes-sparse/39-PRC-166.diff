+
+
+def _issue(weight_kg):
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, weight_kg, "local")
+    return invoices.issue_invoice(s.id)
+
+
+def test_escalate_large_open_invoice():
+    inv = _issue(400)  # local 400 kg quotes 504.50
+    assert inv.amount >= 500.0
+    escalated = invoices.escalate_invoice(inv.id)
+    assert escalated is inv
+    assert escalated.status == "escalated"
+
+
+def test_escalate_rejects_invoice_under_minimum():
+    inv = _issue(2)  # local 2 kg quotes 7.00
+    with pytest.raises(DomainError) as err:
+        invoices.escalate_invoice(inv.id)
+    assert err.value.code == "E_BAD_STATE"
+    assert inv.status == "open"
+
+
+def test_escalate_rejects_paid_invoice():
+    inv = _issue(400)
+    invoices.mark_paid(inv.id)
+    with pytest.raises(DomainError) as err:
+        invoices.escalate_invoice(inv.id)
+    assert err.value.code == "E_BAD_STATE"
+    assert inv.status == "paid"
+
+
+def test_escalate_unknown_invoice():
+    with pytest.raises(DomainError) as err:
+        invoices.escalate_invoice("nope")
+    assert err.value.code == "E_NOT_FOUND"
