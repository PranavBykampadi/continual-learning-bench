 def open_invoices():
     return [i for i in db.invoices.values() if i.status == "open"]
+
+
+def escalate_invoice(invoice_id):
+    if invoice_id not in db.invoices:
+        raise DomainError("E_NOT_FOUND", "invoice does not exist")
+    invoice = db.invoices[invoice_id]
+    if invoice.status != "open":
+        raise DomainError("E_BAD_STATE", "only open invoices can be escalated")
+    if invoice.amount < ESCALATION_MIN_AMOUNT:
+        raise DomainError(
+            "E_BAD_STATE",
+            f"only invoices of at least {ESCALATION_MIN_AMOUNT:.2f} can be escalated",
+        )
+    invoice.status = "escalated"
+    return invoice
