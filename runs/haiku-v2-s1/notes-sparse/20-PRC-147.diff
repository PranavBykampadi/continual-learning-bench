+def volume_report():
+    """Shipment count and volume tier for every customer, keyed by customer id."""
+    known_ids = {customer.id for customer in db.customers.values()}
+    counts = {customer_id: 0 for customer_id in known_ids}
+    for shipment in db.shipments.values():
+        if shipment.customer_id not in known_ids:
+            # Fail loudly rather than silently dropping the shipment from the report.
+            raise DomainError(
+                "E_UNKNOWN_CUSTOMER",
+                "a shipment refers to a customer that does not exist",
+            )
+        counts[shipment.customer_id] += 1
+    return {
+        customer_id: {"shipments": count, "tier": volume_tier(count)}
+        for customer_id, count in counts.items()
+    }
 
 
