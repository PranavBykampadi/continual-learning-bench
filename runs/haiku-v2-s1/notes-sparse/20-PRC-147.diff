+import pytest
+
+from parcelo import customers, reports, shipments
+
+
+def test_volume_report_includes_customers_without_shipments():
+    c = customers.add_customer("Acme")
+    report = reports.volume_report()
+    assert report == {c.id: {"shipments": 0, "tier": "starter"}}
+
+
+def test_volume_report_counts_shipments_per_customer():
+    a = customers.add_customer("Acme")
+    b = customers.add_customer("Globex")
+    for _ in range(2):
+        shipments.create_shipment(a.id, 1.0, "local")
+    shipments.create_shipment(b.id, 3.0, "national")
+    report = reports.volume_report()
+    assert report[a.id] == {"shipments": 2, "tier": "starter"}
+    assert report[b.id] == {"shipments": 1, "tier": "starter"}
+
+
+@pytest.mark.parametrize(
+    "count, tier",
+    [(9, "starter"), (10, "regular"), (49, "regular"), (50, "bulk")],
+)
+def test_volume_report_tier_thresholds(count, tier):
+    c = customers.add_customer("Acme")
+    for _ in range(count):
+        shipments.create_shipment(c.id, 1.0, "local")
+    assert reports.volume_report()[c.id] == {"shipments": count, "tier": tier}
+
