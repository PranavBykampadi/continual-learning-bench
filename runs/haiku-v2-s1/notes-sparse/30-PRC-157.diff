+def get_invoice(invoice_id):
+    invoice = db.invoices.get(invoice_id)
+    if invoice is None:
+        raise DomainError("E_NOT_FOUND", "no invoice with that id exists")
+    return invoice
+
+
+def hold_invoice(invoice_id):
+    invoice = get_invoice(invoice_id)
+    if invoice.status != "open":
+        raise DomainError("E_BAD_STATE", "only open invoices can be put on hold")
+    invoice.status = "on_hold"
+    invoice.held_at = clock.now()
     return invoice
 
 
