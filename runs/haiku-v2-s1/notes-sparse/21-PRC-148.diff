@@ -0,0 +1,18 @@
+from parcelo import clock, ids
+from parcelo.errors import DomainError
+from parcelo.invoices import get_invoice
+from parcelo.models import Dispute
+from parcelo.store import save_dispute
+
+
+def open_dispute(invoice_id, reason):
+    get_invoice(invoice_id)
+    if not isinstance(reason, str) or not reason.strip():
+        raise DomainError("E_BAD_INPUT", "dispute reason is required")
+    dispute = Dispute(
+        id=ids.new_id("dsp"),
+        invoice_id=invoice_id,
+        reason=reason,
+        opened_at=clock.now(),
+    )
+    return save_dispute(dispute)
