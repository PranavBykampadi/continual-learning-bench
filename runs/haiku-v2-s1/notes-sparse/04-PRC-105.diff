diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_refunds.py b/tests/unit/test_refunds.py
--- a/tests/unit/test_refunds.py	1969-12-31 19:00:00
+++ b/tests/unit/test_refunds.py	2026-11-12 01:56:09
@@ -0,0 +1,50 @@
+import pytest
+
+from parcelo import audit, clock, customers, invoices, refunds, shipments, store
+from parcelo.errors import DomainError
+from parcelo.store import db
+
+
+def _invoice(paid):
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 2, "local")
+    inv = invoices.issue_invoice(s.id)
+    if paid:
+        invoices.mark_paid(inv.id)
+    return inv
+
+
+def test_refund_paid_invoice_records_audit():
+    clock.set_fixed("2026-11-12T00:00:00Z")
+    inv = _invoice(paid=True)
+    r = refunds.create_refund(inv.id, 3.5)
+    assert r.id.startswith("ref_")
+    assert r.invoice_id == inv.id
+    assert r.amount == 3.5
+    assert r.created_at == "2026-11-12T00:00:00Z"
+    assert db.refunds[r.id] is r
+    assert audit.LOG[-1]["action"] == "refund.created"
+    assert audit.LOG[-1]["entity_id"] == r.id
+
+
+def test_refund_unknown_invoice():
+    before_refunds = dict(db.refunds)
+    before_log = len(audit.LOG)
+    with pytest.raises(DomainError) as err:
+        refunds.create_refund("INV-missing", 1.0)
+    assert err.value.code == "E_NOT_FOUND"
+    assert db.refunds == before_refunds
+    assert len(audit.LOG) == before_log
+
+
+def test_refund_unpaid_invoice():
+    inv = _invoice(paid=False)
+    before_refunds = dict(db.refunds)
+    before_status = inv.status
+    before_log = len(audit.LOG)
+    with pytest.raises(DomainError) as err:
+        refunds.create_refund(inv.id, 1.0)
+    assert err.value.code == "E_BAD_STATE"
+    assert db.invoices[inv.id].status == before_status == "open"
+    assert db.refunds == before_refunds
+    assert len(audit.LOG) == before_log
