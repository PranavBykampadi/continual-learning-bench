     assert err.value.code == "E_UNKNOWN_CUSTOMER"
+
+
+def test_split_replaces_with_new_shipments_in_order():
+    c = customers.add_customer("Acme")
+    original = shipments.create_shipment(c.id, 3.0, "national")
+    created_before = sum(1 for e in events.OUTBOX if e["name"] == "shipment.created")
+
+    parts = shipments.split_shipment(original.id, [1.0, 2.0])
+
+    assert [p.weight_kg for p in parts] == [1.0, 2.0]
+    for part in parts:
+        assert part.customer_id == c.id
+        assert part.zone == "national"
+        assert part.status == shipments.STATUS_CREATED
+    assert shipments.get_shipment(original.id).status == shipments.STATUS_SPLIT
+    created_after = sum(1 for e in events.OUTBOX if e["name"] == "shipment.created")
+    assert created_after - created_before == 2
+
+
+def test_split_unknown_shipment_fails():
+    with pytest.raises(DomainError) as err:
+        shipments.split_shipment("shp_missing", [1.0])
+    assert err.value.code == "E_NOT_FOUND"
+
+
+def test_split_requires_created_status():
+    c = customers.add_customer("Acme")
+    original = shipments.create_shipment(c.id, 2.0, "local")
+    shipments.split_shipment(original.id, [1.0, 1.0])
+
+    with pytest.raises(DomainError) as err:
+        shipments.split_shipment(original.id, [1.0, 1.0])
+    assert err.value.code == "E_BAD_STATE"
+
+
+def test_split_weights_must_sum_to_original():
+    c = customers.add_customer("Acme")
+    original = shipments.create_shipment(c.id, 3.0, "local")
+    created_before = sum(1 for e in events.OUTBOX if e["name"] == "shipment.created")
+
+    with pytest.raises(DomainError) as err:
+        shipments.split_shipment(original.id, [1.0, 1.0])
+    assert err.value.code == "E_BAD_WEIGHT"
+
+    # Nothing was changed by the failed call.
+    assert shipments.get_shipment(original.id).status == shipments.STATUS_CREATED
+    created_after = sum(1 for e in events.OUTBOX if e["name"] == "shipment.created")
+    assert created_after == created_before
+
+
+def test_split_rejects_non_positive_weight():
+    c = customers.add_customer("Acme")
+    original = shipments.create_shipment(c.id, 2.0, "local")
+
+    with pytest.raises(DomainError) as err:
