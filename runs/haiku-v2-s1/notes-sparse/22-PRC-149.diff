 from parcelo import clock, events, ids
 from parcelo.errors import DomainError
 from parcelo.models import Shipment
 from parcelo.rates import ZONE_BASE
 from parcelo.store import db
 
+STATUS_CREATED = "created"
+STATUS_SPLIT = "split"
 
+
 def create_shipment(customer_id, weight_kg, zone):
     if customer_id not in db.customers:
         raise DomainError("E_UNKNOWN_CUSTOMER", customer_id)
@@ -28,3 +33,30 @@
     if shipment_id not in db.shipments:
         raise DomainError("E_NOT_FOUND", shipment_id)
     return db.shipments[shipment_id]
+
+
+def split_shipment(shipment_id, weights):
+    """Replace a created shipment with one new shipment per weight.
+
+    The original is kept with status "split". Returns the new shipments in
+    the same order as ``weights``.
+    """
+    shipment = get_shipment(shipment_id)
+    if shipment.status != STATUS_CREATED:
+        raise DomainError("E_BAD_STATE", "shipment is not in status created")
+    weights = list(weights)
+    if not weights:
+        raise DomainError("E_BAD_INPUT", "no split weights given")
+    for weight in weights:
+        if weight <= 0:
+            raise DomainError("E_BAD_WEIGHT", "split weights must be positive")
+    if not math.isclose(sum(weights), shipment.weight_kg, rel_tol=1e-9, abs_tol=1e-9):
+        raise DomainError("E_BAD_WEIGHT", "split weights must add up to the shipment weight")
+
+    # Every input is validated above, so creating the new shipments cannot fail
+    # part way through and leave partial results behind.
+    new_shipments = [
+        create_shipment(shipment.customer_id, weight, shipment.zone) for weight in weights
+    ]
+    shipment.status = STATUS_SPLIT
+    return new_shipments
