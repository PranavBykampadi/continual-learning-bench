@@ -0,0 +1,20 @@
+from parcelo import audit, clock, ids
+from parcelo.errors import DomainError
+from parcelo.models import Pickup
+from parcelo.shipments import STATUS_CREATED, get_shipment
+from parcelo.store import db
+
+
+def schedule_pickup(shipment_id, window_start):
+    shipment = get_shipment(shipment_id)
+    if shipment.status != STATUS_CREATED:
+        raise DomainError("E_BAD_STATE", "shipment must be in created status to schedule a pickup")
+    pickup = Pickup(
+        id=ids.new_id("pkp"),
+        shipment_id=shipment.id,
+        window_start=window_start,
+        scheduled_at=clock.now(),
+    )
+    db.pickups[pickup.id] = pickup
+    audit.record("pickup.scheduled", pickup.id, shipment_id=shipment.id)
+    return pickup
