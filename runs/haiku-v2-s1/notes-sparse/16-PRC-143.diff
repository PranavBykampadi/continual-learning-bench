diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_pickups.py b/tests/unit/test_pickups.py
--- a/tests/unit/test_pickups.py	1969-12-31 19:00:00
+++ b/tests/unit/test_pickups.py	2026-11-12 02:07:22
@@ -0,0 +1,50 @@
+from datetime import datetime, timezone
+
+import pytest
+
+from parcelo import clock, customers, pickups, shipments
+from parcelo.errors import DomainError
+from parcelo.store import db
+
+NOW = datetime(2026, 11, 12, 9, 0, tzinfo=timezone.utc)
+WINDOW = datetime(2026, 11, 13, 14, 0, tzinfo=timezone.utc)
+
+
+@pytest.fixture(autouse=True)
+def pinned_clock():
+    clock.set_fixed(NOW)
+    yield
+    clock.clear_fixed()
+
+
+def _shipment(status="created"):
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 2.0, "national")
+    s.status = status
+    return s
+
+
+def test_schedule_pickup_creates_and_stores_pickup():
+    s = _shipment()
+    p = pickups.schedule_pickup(s.id, WINDOW)
+    assert p.id.startswith("pkp_")
+    assert p.shipment_id == s.id
+    assert p.window_start == WINDOW
+    assert p.scheduled_at == clock.now()
+    assert list(db.pickups.values()) == [p]
+
+
+def test_unknown_shipment_fails():
+    with pytest.raises(DomainError) as err:
+        pickups.schedule_pickup("shp_missing", WINDOW)
+    assert err.value.code == "E_NOT_FOUND"
+    assert db.pickups == {}
+
+
+@pytest.mark.parametrize("status", ["delivered", "in_transit", "cancelled"])
+def test_non_created_shipment_fails(status):
+    s = _shipment(status=status)
+    with pytest.raises(DomainError) as err:
+        pickups.schedule_pickup(s.id, WINDOW)
+    assert err.value.code == "E_BAD_STATE"
+    assert db.pickups == {}
