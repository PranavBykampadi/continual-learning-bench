diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/test_reports.py b/tests/test_reports.py
--- a/tests/test_reports.py	1969-12-31 19:00:00
+++ b/tests/test_reports.py	2026-11-12 02:29:00
@@ -0,0 +1,20 @@
+from parcelo import customers, invoices, reports, shipments
+
+
+def test_shipments_without_invoice_returns_only_uninvoiced():
+    c = customers.add_customer("Acme")
+    invoiced = shipments.create_shipment(c.id, 2, "local")
+    uninvoiced = shipments.create_shipment(c.id, 3, "local")
+    invoices.issue_invoice(invoiced.id)
+
+    result = reports.shipments_without_invoice()
+
+    assert result == [uninvoiced]
+
+
+def test_shipments_without_invoice_empty_when_all_invoiced():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 2, "local")
+    invoices.issue_invoice(s.id)
+
+    assert reports.shipments_without_invoice() == []
