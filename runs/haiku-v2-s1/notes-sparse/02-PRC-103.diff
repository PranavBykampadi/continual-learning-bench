+
+def test_quote_with_surcharge_local_has_no_surcharge():
+    assert rates.quote_with_surcharge(2, "local") == 7.0
+
+
+def test_quote_with_surcharge_national():
+    # base 11.50 + 4% surcharge (0.46)
+    assert rates.quote_with_surcharge(2, "national") == 11.96
+
+
+def test_quote_with_surcharge_international():
+    # base 26.50 + 9.5% surcharge (2.5175, rounded to 2.52)
+    assert rates.quote_with_surcharge(2, "international") == 29.02
+
+
+def test_quote_with_surcharge_unknown_zone():
+    with pytest.raises(DomainError) as err:
+        rates.quote_with_surcharge(2, "moon")
+    assert err.value.code == "E_BAD_ZONE"
+
+
+def test_quote_with_surcharge_zero_weight():
+    with pytest.raises(DomainError) as err:
+        rates.quote_with_surcharge(0, "national")
+    assert err.value.code == "E_BAD_WEIGHT"
+
+
+def test_quote_with_surcharge_negative_weight():
+    with pytest.raises(DomainError) as err:
+        rates.quote_with_surcharge(-1, "national")
+    assert err.value.code == "E_BAD_WEIGHT"
