diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_hold_invoice.py b/tests/unit/test_hold_invoice.py
--- a/tests/unit/test_hold_invoice.py	1969-12-31 19:00:00
+++ b/tests/unit/test_hold_invoice.py	2026-11-12 02:30:46
@@ -0,0 +1,54 @@
+from datetime import datetime, timezone
+
+import pytest
+
+from parcelo import clock, events, invoices
+from parcelo.errors import DomainError
+from parcelo.models import Invoice
+from parcelo.store import db
+
+HELD_AT = datetime(2026, 11, 12, 9, 30, tzinfo=timezone.utc)
+
+
+def _put(invoice_id, status="open"):
+    inv = Invoice(id=invoice_id, shipment_id="shp_000001", amount=42.0, status=status)
+    db.invoices[invoice_id] = inv
+    return inv
+
+
+def test_hold_open_invoice_sets_status_and_held_at():
+    clock.set_fixed(HELD_AT)
+    inv = _put("INV-0000001")
+    result = invoices.hold_invoice("INV-0000001")
+    assert result is inv
+    assert inv.status == "on_hold"
+    assert inv.held_at == HELD_AT
+
+
+def test_hold_emits_event():
+    clock.set_fixed(HELD_AT)
+    _put("INV-0000002")
+    events.OUTBOX.clear()
+    invoices.hold_invoice("INV-0000002")
+    assert len(events.OUTBOX) == 1
+    assert events.OUTBOX[-1]["name"] == "invoice.held"
+    assert events.OUTBOX[-1]["entity_id"] == "INV-0000002"
+
+
+def test_unknown_invoice_is_not_found():
+    with pytest.raises(DomainError) as err:
+        invoices.hold_invoice("INV-missing")
+    assert err.value.code == "E_NOT_FOUND"
+
+
+@pytest.mark.parametrize("status", ["paid", "written_off", "on_hold"])
+def test_non_open_invoice_is_bad_state_and_unchanged(status):
+    clock.set_fixed(HELD_AT)
+    inv = _put("INV-0000003", status=status)
+    events.OUTBOX.clear()
+    with pytest.raises(DomainError) as err:
+        invoices.hold_invoice("INV-0000003")
+    assert err.value.code == "E_BAD_STATE"
+    assert inv.status == status
+    assert inv.held_at is None
+    assert events.OUTBOX == []
