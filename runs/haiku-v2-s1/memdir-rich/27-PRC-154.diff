diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_reactivate_customer.py b/tests/unit/test_reactivate_customer.py
--- a/tests/unit/test_reactivate_customer.py	1969-12-31 19:00:00
+++ b/tests/unit/test_reactivate_customer.py	2026-11-12 02:27:33
@@ -0,0 +1,53 @@
+import pytest
+
+from parcelo import events
+from parcelo.customers import reactivate_customer
+from parcelo.errors import DomainError
+from parcelo.models import Customer
+from parcelo.store import db
+
+
+def _add(customer_id="C000001", active=True):
+    customer = Customer(id=customer_id, name="Acme", active=active)
+    db.customers[customer_id] = customer
+    return customer
+
+
+def test_reactivates_inactive_customer():
+    customer = _add(active=False)
+    result = reactivate_customer("C000001")
+    assert result is customer
+    assert customer.active is True
+
+
+def test_emits_event_on_reactivation():
+    _add(active=False)
+    reactivate_customer("C000001")
+    assert len(events.OUTBOX) == 1
+    assert events.OUTBOX[-1]["name"] == "customer.reactivated"
+    assert events.OUTBOX[-1]["entity_id"] == "C000001"
+
+
+def test_unknown_customer_raises_not_found():
+    with pytest.raises(DomainError) as exc:
+        reactivate_customer("C999999")
+    assert exc.value.code == "E_NOT_FOUND"
+    assert events.OUTBOX == []
+
+
+def test_already_active_returns_unchanged_without_event():
+    customer = _add(active=True)
+    result = reactivate_customer("C000001")
+    assert result is customer
+    assert customer.active is True
+    assert events.OUTBOX == []
+
+
+def test_repeat_call_is_idempotent():
+    customer = _add(active=False)
+    reactivate_customer("C000001")
+    count_after_first = len(events.OUTBOX)
+    result = reactivate_customer("C000001")
+    assert result is customer
+    assert customer.active is True
+    assert len(events.OUTBOX) == count_after_first
