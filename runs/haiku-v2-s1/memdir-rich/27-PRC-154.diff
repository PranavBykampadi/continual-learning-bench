+def reactivate_customer(customer_id):
+    customer = db.customers.get(customer_id)
+    if customer is None:
+        raise DomainError("E_NOT_FOUND", f"unknown customer {customer_id}")
+    if customer.active:
+        # Already active: return unchanged, no event (callers retry on timeouts).
+        return customer
+    customer.active = True
+    events.emit("customer.reactivated", customer_id)
+    return customer
 
 
