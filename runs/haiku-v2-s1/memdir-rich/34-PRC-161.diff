+"""Business constants. Finance edits this file; feature modules import from here."""
+from decimal import Decimal
+
+# Volume rebate (customers.rebate_for). Shipment-count cut-offs match
+# volume_tier in parcelo/legacy/billing.py; the legacy module is not imported.
+REBATE_TIER_1_MIN_SHIPMENTS = 10
+REBATE_TIER_1_RATE = Decimal("0.03")
+REBATE_TIER_2_MIN_SHIPMENTS = 50
+REBATE_TIER_2_RATE = Decimal("0.06")
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_rebate_for.py b/tests/unit/test_rebate_for.py
--- a/tests/unit/test_rebate_for.py	1969-12-31 19:00:00
+++ b/tests/unit/test_rebate_for.py	2026-11-12 02:39:00
@@ -0,0 +1,110 @@
+import pytest
+
+from parcelo import events
+from parcelo.customers import add_customer, rebate_for
+from parcelo.errors import DomainError
+from parcelo.models import Invoice, Shipment
+from parcelo.money import Money
+from parcelo.settings import REBATE_TIER_1_MIN_SHIPMENTS, REBATE_TIER_2_MIN_SHIPMENTS
+from parcelo.store import db
+
+
+def _add_shipments(customer_id, count, status="created"):
+    ids_made = []
+    for _ in range(count):
+        shipment_id = f"shp_{len(db.shipments) + 1:06d}"
+        db.shipments[shipment_id] = Shipment(
+            id=shipment_id, customer_id=customer_id, weight_kg=1.0, zone="local", status=status
+        )
+        ids_made.append(shipment_id)
+    return ids_made
+
+
+def _add_invoice(shipment_id, amount, status="paid"):
+    invoice_id = f"INV-{len(db.invoices) + 1:06d}"
+    db.invoices[invoice_id] = Invoice(
+        id=invoice_id, shipment_id=shipment_id, amount=amount, status=status
+    )
+    return invoice_id
+
+
+def test_unknown_customer_raises_not_found():
+    with pytest.raises(DomainError) as exc:
+        rebate_for("C_missing")
+    assert exc.value.code == "E_NOT_FOUND"
+
+
+def test_no_shipments_gives_zero():
+    customer = add_customer("Acme")
+    assert rebate_for(customer.id) == Money.zero()
+
+
+def test_nine_shipments_gives_zero_even_with_paid_invoices():
+    customer = add_customer("Acme")
+    shipment_ids = _add_shipments(customer.id, REBATE_TIER_1_MIN_SHIPMENTS - 1)
+    _add_invoice(shipment_ids[0], 100.00)
+    assert rebate_for(customer.id) == Money.zero()
+
+
+def test_ten_shipments_gives_three_percent_of_paid():
+    customer = add_customer("Acme")
+    shipment_ids = _add_shipments(customer.id, REBATE_TIER_1_MIN_SHIPMENTS)
+    _add_invoice(shipment_ids[0], 60.00)
+    _add_invoice(shipment_ids[1], 40.00)
+    assert rebate_for(customer.id) == Money.parse("3.00")
+
+
+def test_forty_nine_shipments_is_still_three_percent():
+    customer = add_customer("Acme")
+    shipment_ids = _add_shipments(customer.id, REBATE_TIER_2_MIN_SHIPMENTS - 1)
+    _add_invoice(shipment_ids[0], 100.00)
+    assert rebate_for(customer.id) == Money.parse("3.00")
+
+
+def test_fifty_shipments_gives_six_percent_of_paid():
+    customer = add_customer("Acme")
+    shipment_ids = _add_shipments(customer.id, REBATE_TIER_2_MIN_SHIPMENTS)
+    _add_invoice(shipment_ids[0], 100.00)
+    assert rebate_for(customer.id) == Money.parse("6.00")
+
+
+def te