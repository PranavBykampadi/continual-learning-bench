+def rebate_for(customer_id):
+    """Volume rebate earned: a share of the customer's paid invoices.
+
+    Shipment count is all of the customer's shipments, whatever their status.
+    Fewer than REBATE_TIER_1_MIN_SHIPMENTS gives zero. Read-only.
+    """
+    if customer_id not in db.customers:
+        raise DomainError("E_NOT_FOUND", f"unknown customer {customer_id}")
+
+    shipment_count = 0
+    for shipment in db.shipments.values():
+        if shipment.customer_id == customer_id:
+            shipment_count += 1
+
+    if shipment_count >= REBATE_TIER_2_MIN_SHIPMENTS:
+        rate = REBATE_TIER_2_RATE
+    elif shipment_count >= REBATE_TIER_1_MIN_SHIPMENTS:
+        rate = REBATE_TIER_1_RATE
+    else:
+        return Money.zero()
+
+    paid = Money.zero()
+    for invoice in db.invoices.values():
+        if invoice.status != "paid":
+            continue
+        shipment = db.shipments.get(invoice.shipment_id)
+        if shipment is not None and shipment.customer_id == customer_id:
+            paid = paid + Money.parse(invoice.amount)
+    return paid.scale(rate)
