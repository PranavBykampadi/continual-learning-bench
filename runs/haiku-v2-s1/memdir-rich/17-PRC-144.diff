+from decimal import Decimal
+
+from parcelo.errors import DomainError
+from parcelo.money import Money
+
 ZONE_BASE = {"local": 4.5, "national": 9.0, "international": 24.0}
 PER_KG = 1.25
 
+# Fuel surcharge percent by zone. Copied from parcelo/legacy/billing.py
+# fuel_surcharge (legacy is not imported; it is being removed).
+FUEL_SURCHARGE_PCT = {
+    "local": Decimal("0"),
+    "national": Decimal("4.0"),
+    "international": Decimal("9.5"),
+}
+INSURANCE_PCT = Decimal("2")
+INSURANCE_MIN_FEE = Money.parse("1.00")
 
+
 def base_rate(zone):
     if zone not in ZONE_BASE:
         raise ValueError("unknown zone: %s" % zone)
@@ -12,3 +27,16 @@
     if weight_kg <= 0:
         raise ValueError("weight must be positive")
     return round(base_rate(zone) + PER_KG * weight_kg, 2)
+
+
+def insurance_fee(declared_value, zone):
+    """Insurance fee for a declared value: 2% plus the zone's fuel surcharge %, minimum 1.00."""
+    if zone not in FUEL_SURCHARGE_PCT:
+        raise DomainError("E_BAD_ZONE", zone)
+    if declared_value <= 0:
+        raise DomainError("E_BAD_INPUT", "declared value must be positive")
+    rate = (INSURANCE_PCT + FUEL_SURCHARGE_PCT[zone]) / Decimal("100")
+    fee = Money.parse(declared_value).scale(rate)
+    if fee < INSURANCE_MIN_FEE:
+        return INSURANCE_MIN_FEE
+    return fee
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_insurance_fee.py b/tests/unit/test_insurance_fee.py
--- a/tests/unit/test_insurance_fee.py	1969-12-31 19:00:00
+++ b/tests/unit/test_insurance_fee.py	2026-11-12 02:15:29
@@ -0,0 +1,54 @@
+import pytest
+
+from parcelo import rates
+from parcelo.errors import DomainError
+from parcelo.money import Money
+
+
+def test_local_fee_is_two_percent():
+    assert rates.insurance_fee(100, "local") == Money(200)
+
+
+def test_national_fee_adds_fuel_surcharge():
+    assert rates.insurance_fee(100, "national") == Money(600)
+
+
+def test_international_fee_adds_fuel_surcharge():
+    assert rates.insurance_fee(100, "international") == Money(1150)
+
+
+def test_minimum_fee_applies_below_threshold():
+    assert rates.insurance_fee(10, "local") == Money(100)
+    assert rates.insurance_fee(10, "national") == Money(100)
+
+
+def test_international_above_minimum_is_not_raised():
+    # 10 * 11.5% = 1.15, above the 1.00 minimum
+    assert rates.insurance_fee(10, "international") == Money(115)
+
+
+def test_minimum_fee_boundary_is_exact():
+    assert rates.insurance_fee(50, "local") == Money(100)
+    assert rates.insurance_fee(60, "local") == Money(120)
+
+
+def test_fee_rounds_to_cents():
+    # 33.33 * 0.06 = 1.9998 -> 2.00
+    assert rates.insurance_fee(33.33, "national") == Money(200)
+
+
+def test_returns_money():
+    assert isinstance(rates.insurance_fee(100, "local"), Money)
+
+
+def test_unknown_zone_fails():
+    with pytest.raises(DomainError) as err:
+        rates.insurance_fee(100, "moon")
+    assert err.value.code == "E_BAD_ZONE"
+
+
+@pytest.mark.parametrize("value", [0, -5])
+def test_non_positive_value_fails(value):
+    with pytest.raises(DomainError) as err:
+        rates.insurance_fee(value, "local")
+    assert err.value.code == "E_BAD_INPUT"
