diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_shipments_in_zone.py b/tests/unit/test_shipments_in_zone.py
--- a/tests/unit/test_shipments_in_zone.py	1969-12-31 19:00:00
+++ b/tests/unit/test_shipments_in_zone.py	2026-11-12 02:33:25
@@ -0,0 +1,65 @@
+import pytest
+
+from parcelo import events
+from parcelo.errors import DomainError
+from parcelo.models import Shipment
+from parcelo.shipments import shipments_in_zone
+from parcelo.store import db
+
+
+def _add(shipment_id, zone):
+    db.shipments[shipment_id] = Shipment(
+        id=shipment_id,
+        customer_id="cus_000001",
+        weight_kg=1.0,
+        zone=zone,
+    )
+
+
+def test_returns_only_shipments_in_zone():
+    _add("shp_000001", "local")
+    _add("shp_000002", "national")
+    _add("shp_000003", "local")
+
+    result = shipments_in_zone("local")
+
+    assert [s.id for s in result] == ["shp_000001", "shp_000003"]
+    assert all(s.zone == "local" for s in result)
+
+
+def test_sorted_by_id_even_when_inserted_out_of_order():
+    _add("shp_000003", "international")
+    _add("shp_000001", "international")
+    _add("shp_000002", "international")
+
+    result = shipments_in_zone("international")
+
+    assert [s.id for s in result] == ["shp_000001", "shp_000002", "shp_000003"]
+
+
+def test_empty_list_when_no_shipments_in_zone():
+    _add("shp_000001", "local")
+
+    assert shipments_in_zone("national") == []
+
+
+def test_empty_list_when_no_shipments_at_all():
+    assert shipments_in_zone("local") == []
+
+
+def test_unknown_zone_raises_bad_zone():
+    _add("shp_000001", "local")
+
+    with pytest.raises(DomainError) as exc:
+        shipments_in_zone("mars")
+
+    assert exc.value.code == "E_BAD_ZONE"
+
+
+def test_read_only_emits_no_events():
+    _add("shp_000001", "local")
+    events.OUTBOX.clear()
+
+    shipments_in_zone("local")
+
+    assert events.OUTBOX == []
