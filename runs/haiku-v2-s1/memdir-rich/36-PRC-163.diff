diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_lock_customer.py b/tests/unit/test_lock_customer.py
--- a/tests/unit/test_lock_customer.py	1969-12-31 19:00:00
+++ b/tests/unit/test_lock_customer.py	2026-11-12 02:40:45
@@ -0,0 +1,43 @@
+import pytest
+
+from parcelo import events
+from parcelo.customers import add_customer, lock_customer
+from parcelo.errors import DomainError
+from parcelo.models import Customer
+from parcelo.store import db
+
+
+def test_new_customer_is_not_locked():
+    customer = add_customer("Ada")
+    assert customer.locked is False
+    assert Customer(id="X", name="x").locked is False
+
+
+def test_lock_sets_flag_and_returns_customer():
+    customer = add_customer("Ada")
+    result = lock_customer(customer.id)
+    assert result is customer
+    assert db.customers[customer.id].locked is True
+
+
+def test_lock_emits_event():
+    customer = add_customer("Ada")
+    lock_customer(customer.id)
+    assert [e["name"] for e in events.OUTBOX] == ["customer.locked"]
+    assert events.OUTBOX[0]["entity_id"] == customer.id
+
+
+def test_lock_unknown_customer_raises_not_found():
+    with pytest.raises(DomainError) as exc:
+        lock_customer("C_missing")
+    assert exc.value.code == "E_NOT_FOUND"
+    assert events.OUTBOX == []
+
+
+def test_lock_twice_is_idempotent():
+    customer = add_customer("Ada")
+    lock_customer(customer.id)
+    count = len(events.OUTBOX)
+    result = lock_customer(customer.id)
+    assert result.locked is True
+    assert len(events.OUTBOX) == count
