 def open_invoices():
     return [i for i in db.invoices.values() if i.status == "open"]
+
+
+def write_off(invoice_id):
+    if invoice_id not in db.invoices:
+        raise DomainError("E_NOT_FOUND", f"invoice {invoice_id} not found")
+    invoice = db.invoices[invoice_id]
+    if invoice.status != "open":
+        raise DomainError(
+            "E_BAD_STATE", f"invoice {invoice_id} is {invoice.status}, only open invoices can be written off"
+        )
+    invoice.status = "written_off"
+    invoice.written_off_at = clock.now()
+    events.emit("invoice.written_off", invoice_id, written_off_at=invoice.written_off_at)
+    return Money.parse(invoice.amount)
