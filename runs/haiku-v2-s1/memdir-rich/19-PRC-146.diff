diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_write_off.py b/tests/unit/test_write_off.py
--- a/tests/unit/test_write_off.py	1969-12-31 19:00:00
+++ b/tests/unit/test_write_off.py	2026-11-12 02:18:06
@@ -0,0 +1,61 @@
+from datetime import datetime, timezone
+
+import pytest
+
+from parcelo import clock, customers, events, invoices, shipments
+from parcelo.errors import DomainError
+from parcelo.money import Money
+
+
+def _open_invoice():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 2, "local")
+    inv = invoices.issue_invoice(s.id)
+    events.OUTBOX.clear()
+    return inv
+
+
+def test_write_off_open_invoice():
+    moment = datetime(2026, 11, 12, 9, 0, tzinfo=timezone.utc)
+    clock.set_fixed(moment)
+    inv = _open_invoice()
+    amount = invoices.write_off(inv.id)
+    assert inv.status == "written_off"
+    assert inv.written_off_at == moment
+    assert amount == Money.parse(inv.amount)
+    assert isinstance(amount, Money)
+    assert inv.id not in [i.id for i in invoices.open_invoices()]
+
+
+def test_write_off_emits_event():
+    inv = _open_invoice()
+    invoices.write_off(inv.id)
+    assert events.OUTBOX[-1]["name"] == "invoice.written_off"
+    assert events.OUTBOX[-1]["entity_id"] == inv.id
+
+
+def test_write_off_status_only_setup():
+    inv = invoices.Invoice(id="INV-TEST0001", shipment_id="shp_x", amount=12.5)
+    invoices.db.invoices[inv.id] = inv
+    assert invoices.write_off(inv.id) == Money(1250)
+    assert inv.status == "written_off"
+
+
+def test_unknown_invoice():
+    with pytest.raises(DomainError) as err:
+        invoices.write_off("INV-nope")
+    assert err.value.code == "E_NOT_FOUND"
+
+
+@pytest.mark.parametrize("status", ["paid", "written_off"])
+def test_non_open_invoice_fails_without_side_effects(status):
+    inv = _open_invoice()
+    inv.status = status
+    before_at = inv.written_off_at
+    events.OUTBOX.clear()
+    with pytest.raises(DomainError) as err:
+        invoices.write_off(inv.id)
+    assert err.value.code == "E_BAD_STATE"
+    assert inv.status == status
+    assert inv.written_off_at == before_at
+    assert events.OUTBOX == []
