 def open_invoices():
     return [i for i in db.invoices.values() if i.status == "open"]
+
+
+def reopen_invoice(invoice_id):
+    if invoice_id not in db.invoices:
+        raise DomainError("E_NOT_FOUND", f"invoice {invoice_id} not found")
+    invoice = db.invoices[invoice_id]
+    if invoice.status != "paid":
+        raise DomainError(
+            "E_BAD_STATE", f"invoice {invoice_id} is not paid (status={invoice.status})"
+        )
+    invoice.status = "open"
+    invoice.paid_at = None
+    invoice.reopened_at = clock.now()
+    events.emit("invoice.reopened", invoice_id, reopened_at=invoice.reopened_at)
+    return invoice
