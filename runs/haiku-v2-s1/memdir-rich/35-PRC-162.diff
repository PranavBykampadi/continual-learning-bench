+
+
+INVOICE_STATUSES = ("open", "paid")
+
+
+def invoices_by_status(status):
+    if status not in INVOICE_STATUSES:
+        raise DomainError("E_BAD_INPUT", f"unknown invoice status {status!r}")
+    return sorted(
+        (i for i in db.invoices.values() if i.status == status),
+        key=lambda i: i.id,
+    )
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_invoices_by_status.py b/tests/unit/test_invoices_by_status.py
--- a/tests/unit/test_invoices_by_status.py	1969-12-31 19:00:00
+++ b/tests/unit/test_invoices_by_status.py	2026-11-12 02:39:58
@@ -0,0 +1,58 @@
+import pytest
+
+from parcelo import invoices, store
+from parcelo.errors import DomainError
+from parcelo.models import Invoice
+
+
+def _add(invoice_id, status):
+    store.db.invoices[invoice_id] = Invoice(
+        id=invoice_id, shipment_id="shp_x", amount=10.0, status=status
+    )
+
+
+def test_returns_only_matching_status():
+    _add("INV-b", "open")
+    _add("INV-a", "paid")
+    _add("INV-c", "open")
+    result = invoices.invoices_by_status("open")
+    assert [i.id for i in result] == ["INV-b", "INV-c"]
+    assert all(i.status == "open" for i in result)
+
+
+def test_paid_status():
+    _add("INV-1", "paid")
+    _add("INV-2", "open")
+    assert [i.id for i in invoices.invoices_by_status("paid")] == ["INV-1"]
+
+
+def test_empty_when_none_match():
+    _add("INV-1", "open")
+    assert invoices.invoices_by_status("paid") == []
+
+
+def test_empty_when_no_invoices():
+    assert invoices.invoices_by_status("open") == []
+
+
+def test_sorted_by_id_regardless_of_insertion_order():
+    _add("INV-z", "paid")
+    _add("INV-m", "paid")
+    _add("INV-a", "paid")
+    result = invoices.invoices_by_status("paid")
+    assert [i.id for i in result] == sorted(i.id for i in result)
+
+
+@pytest.mark.parametrize("bad", ["void", "OPEN", "", None, "written_off"])
+def test_invalid_status_raises(bad):
+    _add("INV-1", "open")
+    with pytest.raises(DomainError) as err:
+        invoices.invoices_by_status(bad)
+    assert err.value.code == "E_BAD_INPUT"
+
+
+def test_read_only():
+    _add("INV-1", "open")
+    before = dict(store.db.invoices)
+    invoices.invoices_by_status("open")
+    assert store.db.invoices == before
