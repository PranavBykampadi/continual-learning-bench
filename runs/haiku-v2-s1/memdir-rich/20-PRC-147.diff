+# Volume tier thresholds, copied from parcelo/legacy/billing.py volume_tier.
+# The legacy package is banned from imports, so the values live here.
+BULK_MIN_SHIPMENTS = 50
+REGULAR_MIN_SHIPMENTS = 10
+
+
+def _volume_tier_label(shipment_count):
+    if shipment_count >= BULK_MIN_SHIPMENTS:
+        return "bulk"
+    if shipment_count >= REGULAR_MIN_SHIPMENTS:
+        return "regular"
+    return "starter"
+
+
+def volume_report():
+    """Shipment count and volume tier per customer.
+
+    Every customer in the store is included, even with zero shipments.
+    Shipments are counted by their customer_id.
+    """
+    counts = {customer_id: 0 for customer_id in db.customers}
+    for shipment in db.shipments.values():
+        if shipment.customer_id in counts:
+            counts[shipment.customer_id] += 1
+    return {
+        customer_id: {"shipments": count, "tier": _volume_tier_label(count)}
+        for customer_id, count in counts.items()
+    }
+
+
