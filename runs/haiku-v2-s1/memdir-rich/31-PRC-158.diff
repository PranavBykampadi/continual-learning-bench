@@ -0,0 +1,137 @@
+import re
+from datetime import datetime, timezone
+
+import pytest
+
+from parcelo import clock, events, returns
+from parcelo.errors import DomainError
+from parcelo.models import ReturnRequest, Shipment
+from parcelo.settings import RETURN_LIMIT_PER_SHIPMENT
+from parcelo.store import db, reset
+
+
+def _shipment(shipment_id="shp_000001", status="delivered"):
+    s = Shipment(id=shipment_id, customer_id="cus_1", weight_kg=2.0, zone="A", status=status)
+    db.shipments[s.id] = s
+    return s
+
+
+def test_request_return_creates_record_and_stores_it():
+    _shipment()
+    moment = datetime(2026, 11, 12, 9, 30, tzinfo=timezone.utc)
+    clock.set_fixed(moment)
+
+    req = returns.request_return("shp_000001", "damaged")
+
+    assert isinstance(req, ReturnRequest)
+    assert req.shipment_id == "shp_000001"
+    assert req.reason == "damaged"
+    assert req.requested_at == moment
+    assert db.returns[req.id] is req
+
+
+def test_return_id_has_prefix_and_six_digit_sequence():
+    _shipment()
+    req = returns.request_return("shp_000001", "wrong item")
+    assert re.fullmatch(r"ret_\d{6}", req.id)
+
+
+def test_request_return_emits_event():
+    _shipment()
+    events.OUTBOX.clear()
+
+    req = returns.request_return("shp_000001", "damaged")
+
+    assert events.OUTBOX[-1]["name"] == "return.requested"
+    assert events.OUTBOX[-1]["entity_id"] == req.id
+
+
+def test_unknown_shipment_is_not_found():
+    with pytest.raises(DomainError) as exc:
+        returns.request_return("shp_nope", "damaged")
+    assert exc.value.code == "E_NOT_FOUND"
+    assert db.returns == {}
+
+
+@pytest.mark.parametrize("status", ["created", "in_transit", "cancelled"])
+def test_only_delivered_shipments_can_be_returned(status):
+    _shipment(status=status)
+    with pytest.raises(DomainError) as exc:
+        returns.request_return("shp_000001", "damaged")
+    assert exc.value.code == "E_BAD_STATE"
+    assert db.returns == {}
+
+
+def test_delivered_status_alone_is_enough():
+    # Ticket definition: delivered means status == "delivered". No delivered_at set.
+    _shipment(status="delivered")
+    req = returns.request_return("shp_000001", "damaged")
+    assert req.shipment_id == "shp_000001"
+
+
