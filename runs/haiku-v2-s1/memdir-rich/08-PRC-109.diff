diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_add_address.py b/tests/unit/test_add_address.py
--- a/tests/unit/test_add_address.py	1969-12-31 19:00:00
+++ b/tests/unit/test_add_address.py	2026-11-12 02:02:00
@@ -0,0 +1,72 @@
+import pytest
+
+from parcelo import audit
+from parcelo.customers import add_address
+from parcelo.errors import DomainError
+from parcelo.models import Address, Customer
+from parcelo.store import db
+
+
+def _customer(cid="C1"):
+    c = Customer(id=cid, name="Ann")
+    db.customers[cid] = c
+    return c
+
+
+def test_add_address_creates_and_stores():
+    _customer()
+    addr = add_address("C1", "1 Main St", "Springfield")
+    assert isinstance(addr, Address)
+    assert addr.customer_id == "C1"
+    assert addr.line == "1 Main St"
+    assert addr.city == "Springfield"
+    assert addr.id
+    assert db.addresses[addr.id] is addr
+
+
+def test_ids_are_unique():
+    _customer()
+    a = add_address("C1", "1 Main St", "Springfield")
+    b = add_address("C1", "2 Oak Ave", "Shelbyville")
+    assert a.id != b.id
+    assert len(db.addresses) == 2
+
+
+def test_unknown_customer_raises_not_found():
+    with pytest.raises(DomainError) as exc:
+        add_address("NOPE", "1 Main St", "Springfield")
+    assert exc.value.code == "E_NOT_FOUND"
+    assert db.addresses == {}
+
+
+@pytest.mark.parametrize("line", ["", "   ", None])
+def test_empty_line_raises_bad_input(line):
+    _customer()
+    with pytest.raises(DomainError) as exc:
+        add_address("C1", line, "Springfield")
+    assert exc.value.code == "E_BAD_INPUT"
+    assert db.addresses == {}
+
+
+@pytest.mark.parametrize("city", ["", "   ", None])
+def test_empty_city_raises_bad_input(city):
+    _customer()
+    with pytest.raises(DomainError) as exc:
+        add_address("C1", "1 Main St", city)
+    assert exc.value.code == "E_BAD_INPUT"
+    assert db.addresses == {}
+
+
+def test_audit_recorded():
+    _customer()
+    addr = add_address("C1", "1 Main St", "Springfield")
+    assert audit.LOG[-1]["action"] == "address.added"
+    assert audit.LOG[-1]["entity_id"] == addr.id
+
+
+def test_reset_clears_addresses():
+    _customer()
+    add_address("C1", "1 Main St", "Springfield")
+    from parcelo import store
+    store.reset()
+    assert db.addresses == {}
