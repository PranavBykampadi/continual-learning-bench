diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_schedule_pickup.py b/tests/unit/test_schedule_pickup.py
--- a/tests/unit/test_schedule_pickup.py	1969-12-31 19:00:00
+++ b/tests/unit/test_schedule_pickup.py	2026-11-12 02:13:26
@@ -0,0 +1,63 @@
+import re
+from datetime import datetime, timezone
+
+import pytest
+
+from parcelo import clock, customers, events, pickups, shipments, store
+from parcelo.errors import DomainError
+from parcelo.models import Pickup
+
+WINDOW = datetime(2026, 11, 13, 9, 0, tzinfo=timezone.utc)
+BOOKED = datetime(2026, 11, 12, 15, 30, tzinfo=timezone.utc)
+
+
+def _shipment(status=None):
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 1.5, "national")
+    if status is not None:
+        s.status = status
+    events.OUTBOX.clear()
+    return s
+
+
+def test_schedule_creates_and_stores_pickup():
+    clock.set_fixed(BOOKED)
+    s = _shipment()
+    p = pickups.schedule_pickup(s.id, WINDOW)
+    assert isinstance(p, Pickup)
+    assert p.shipment_id == s.id
+    assert p.window_start == WINDOW
+    assert p.scheduled_at == BOOKED
+    assert store.db.pickups[p.id] is p
+
+
+def test_pickup_id_format():
+    s = _shipment()
+    p = pickups.schedule_pickup(s.id, WINDOW)
+    assert re.fullmatch(r"pkp_\d{6}", p.id)
+
+
+def test_schedule_emits_event():
+    s = _shipment()
+    p = pickups.schedule_pickup(s.id, WINDOW)
+    assert events.OUTBOX[-1]["name"] == "pickup.scheduled"
+    assert events.OUTBOX[-1]["entity_id"] == p.id
+
+
+def test_unknown_shipment_fails():
+    with pytest.raises(DomainError) as err:
+        pickups.schedule_pickup("shp_999999", WINDOW)
+    assert err.value.code == "E_NOT_FOUND"
+    assert store.db.pickups == {}
+    assert events.OUTBOX == []
+
+
+@pytest.mark.parametrize("status", ["picked_up", "delivered", "cancelled"])
+def test_non_created_shipment_fails(status):
+    s = _shipment(status=status)
+    with pytest.raises(DomainError) as err:
+        pickups.schedule_pickup(s.id, WINDOW)
+    assert err.value.code == "E_BAD_STATE"
+    assert store.db.pickups == {}
+    assert events.OUTBOX == []
+    assert s.status == status
