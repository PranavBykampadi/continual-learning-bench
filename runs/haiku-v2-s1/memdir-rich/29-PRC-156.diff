@@ -0,0 +1,11 @@
+"""Business constants (thresholds, rates, limits). Finance edits this file.
+
+Feature modules import these names; do not redefine them elsewhere.
+"""
+
+from parcelo.money import Money
+
+# Heavy parcel surcharge (PRC-156): parcels above this weight pay the
+# per-kilogram surcharge for every kilogram over the threshold.
+HEAVY_THRESHOLD_KG = 30
+HEAVY_SURCHARGE_PER_KG = Money.parse("0.75")
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_heavy_quote.py b/tests/unit/test_heavy_quote.py
--- a/tests/unit/test_heavy_quote.py	1969-12-31 19:00:00
+++ b/tests/unit/test_heavy_quote.py	2026-11-12 02:29:27
@@ -0,0 +1,41 @@
+import pytest
+
+from parcelo import rates
+from parcelo.errors import DomainError
+from parcelo.money import Money
+from parcelo.settings import HEAVY_THRESHOLD_KG
+
+
+def test_at_threshold_is_normal_quote():
+    assert rates.heavy_quote(HEAVY_THRESHOLD_KG, "local") == Money.parse(rates.quote(30, "local"))
+
+
+def test_below_threshold_is_normal_quote():
+    assert rates.heavy_quote(10, "national") == Money.parse(rates.quote(10, "national"))
+
+
+def test_above_threshold_adds_surcharge_per_kg():
+    # local 32 kg: normal 44.50 + 2 kg * 0.75 = 46.00
+    assert rates.heavy_quote(32, "local") == Money.parse("46.00")
+
+
+def test_international_above_threshold():
+    # international 31 kg: normal 62.75 + 1 kg * 0.75 = 63.50
+    assert rates.heavy_quote(31, "international") == Money.parse("63.50")
+
+
+def test_returns_money():
+    assert isinstance(rates.heavy_quote(40, "local"), Money)
+
+
+def test_unknown_zone_raises_bad_zone():
+    with pytest.raises(DomainError) as exc:
+        rates.heavy_quote(40, "moon")
+    assert exc.value.code == "E_BAD_ZONE"
+
+
+@pytest.mark.parametrize("weight", [0, -1, -0.5])
+def test_non_positive_weight_raises_bad_weight(weight):
+    with pytest.raises(DomainError) as exc:
+        rates.heavy_quote(weight, "local")
+    assert exc.value.code == "E_BAD_WEIGHT"
