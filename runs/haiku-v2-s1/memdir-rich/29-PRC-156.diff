@@ -12,3 +16,15 @@
     if weight_kg <= 0:
         raise ValueError("weight must be positive")
     return round(base_rate(zone) + PER_KG * weight_kg, 2)
+
+
+def heavy_quote(weight_kg, zone):
+    """Normal quote plus HEAVY_SURCHARGE_PER_KG for each kg above HEAVY_THRESHOLD_KG."""
+    if zone not in ZONE_BASE:
+        raise DomainError("E_BAD_ZONE", "unknown zone: %s" % zone)
+    if weight_kg <= 0:
+        raise DomainError("E_BAD_WEIGHT", "weight must be positive")
+    total = Money.parse(quote(weight_kg, zone))
+    if weight_kg > HEAVY_THRESHOLD_KG:
+        total = total + HEAVY_SURCHARGE_PER_KG.scale(weight_kg - HEAVY_THRESHOLD_KG)
+    return total
