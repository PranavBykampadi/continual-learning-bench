@@ -0,0 +1,87 @@
+import re
+from datetime import datetime, timezone
+
+import pytest
+
+from parcelo import clock, events, store
+from parcelo.errors import DomainError
+from parcelo.models import Customer, Voucher
+from parcelo.money import Money
+from parcelo.settings import VOUCHER_MAX_AMOUNT
+from parcelo.store import db
+from parcelo.vouchers import issue_voucher
+
+MOMENT = datetime(2026, 11, 12, 9, 30, tzinfo=timezone.utc)
+
+
+@pytest.fixture
+def customer():
+    db.customers["C1"] = Customer(id="C1", name="Ann")
+    clock.set_fixed(MOMENT)
+    return "C1"
+
+
+def test_issue_returns_voucher_with_fields(customer):
+    voucher = issue_voucher(customer, "25.00")
+    assert isinstance(voucher, Voucher)
+    assert re.fullmatch(r"vch_\d{6}", voucher.id)
+    assert voucher.customer_id == customer
+    assert voucher.amount == Money.parse("25.00")
+    assert voucher.issued_at == MOMENT
+
+
+def test_voucher_is_stored_in_vouchers(customer):
+    voucher = issue_voucher(customer, 10)
+    assert db.vouchers[voucher.id] is voucher
+
+
+def test_issue_emits_event(customer):
+    events.OUTBOX.clear()
+    voucher = issue_voucher(customer, 10)
+    assert events.OUTBOX[-1]["name"] == "voucher.issued"
+    assert events.OUTBOX[-1]["entity_id"] == voucher.id
+
+
+def test_amount_at_cap_is_allowed(customer):
+    voucher = issue_voucher(customer, VOUCHER_MAX_AMOUNT)
+    assert voucher.amount == Money.parse("150.00")
+
+
+def test_amount_above_cap_fails(customer):
+    events.OUTBOX.clear()
+    with pytest.raises(DomainError) as exc:
+        issue_voucher(customer, "150.01")
+    assert exc.value.code == "E_LIMIT"
+    assert db.vouchers == {}
+    assert events.OUTBOX == []
+
+
+@pytest.mark.parametrize("amount", [0, "0.00", -5, "-0.01"])
+def test_zero_or_negative_amount_fails(customer, amount):
+    with pytest.raises(DomainError) as exc:
+        issue_voucher(customer, amount)
+    assert exc.value.code == "E_BAD_INPUT"
+    assert db.vouchers == {}
+
+
+@pytest.mark.parametrize("amount", [None, "abc"])
