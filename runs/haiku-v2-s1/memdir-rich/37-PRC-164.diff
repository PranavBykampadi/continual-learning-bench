diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/parcelo/vouchers.py b/parcelo/vouchers.py
--- a/parcelo/vouchers.py	1969-12-31 19:00:00
+++ b/parcelo/vouchers.py	2026-11-12 02:42:24
@@ -0,0 +1,37 @@
+from parcelo import clock, events, ids
+from parcelo.errors import DomainError
+from parcelo.models import Voucher
+from parcelo.money import Money
+from parcelo.settings import VOUCHER_MAX_AMOUNT
+from parcelo.store import db
+
+
+def issue_voucher(customer_id, amount):
+    """Issue a goodwill voucher to an existing customer.
+
+    Raises E_NOT_FOUND for an unknown customer, E_BAD_INPUT for a missing,
+    unparseable, zero or negative amount, and E_LIMIT for an amount above
+    VOUCHER_MAX_AMOUNT. Nothing is stored or emitted on error.
+    """
+    if customer_id not in db.customers:
+        raise DomainError("E_NOT_FOUND", f"unknown customer {customer_id}")
+    if amount is None:
+        raise DomainError("E_BAD_INPUT", "amount required")
+    try:
+        value = Money.parse(amount)
+    except (ArithmeticError, TypeError, ValueError):
+        raise DomainError("E_BAD_INPUT", f"bad amount {amount!r}")
+    if value <= Money.zero():
+        raise DomainError("E_BAD_INPUT", "amount must be positive")
+    if VOUCHER_MAX_AMOUNT < value:
+        raise DomainError("E_LIMIT", f"voucher cannot exceed {VOUCHER_MAX_AMOUNT}")
+
+    voucher = Voucher(
+        id=ids.new_id("vch"),
+        customer_id=customer_id,
+        amount=value,
+        issued_at=clock.now(),
+    )
+    db.vouchers[voucher.id] = voucher
+    events.emit("voucher.issued", voucher.id, customer_id=customer_id, amount=str(value))
+    return voucher
