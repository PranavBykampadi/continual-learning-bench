+def _as_utc(moment):
+    # Invoice.issued_at is naive UTC (invoices.issue_invoice uses utcnow);
+    # clock.now() is timezone-aware. Treat naive values as UTC before subtracting.
+    if moment.tzinfo is None:
+        return moment.replace(tzinfo=timezone.utc)
+    return moment
+
+
+def aging_report():
+    """Total open invoice amounts by age in whole days since issue.
+
+    Buckets: "0-30" (0 to 30 days), "31-60" (31 to 60 days), "60+" (more than 60).
+    Paid invoices are skipped. An invoice issued in the future counts as age 0.
+    """
+    now = clock.now()
+    buckets = {"0-30": Money.zero(), "31-60": Money.zero(), "60+": Money.zero()}
+    for invoice in db.invoices.values():
+        if invoice.status != "open":
+            continue
+        if invoice.issued_at is None:
+            raise DomainError("E_BAD_STATE", f"invoice {invoice.id} has no issued_at")
+        age = max((now - _as_utc(invoice.issued_at)).days, 0)
+        if age <= 30:
+            key = "0-30"
+        elif age <= 60:
+            key = "31-60"
+        else:
+            key = "60+"
+        buckets[key] = buckets[key] + Money.parse(invoice.amount)
+    return buckets
 
 
