+def _split_weight(weight):
+    if isinstance(weight, bool) or not isinstance(weight, (int, float, Decimal)):
+        raise DomainError("E_BAD_WEIGHT", repr(weight))
+    value = Decimal(str(weight))
+    if not value.is_finite() or value <= 0:
+        raise DomainError("E_BAD_WEIGHT", repr(weight))
+    return value
+
+
+def split_shipment(shipment_id, weights):
+    weights = list(weights)
+    shipment = get_shipment(shipment_id)
+    if shipment.status != "created":
+        raise DomainError("E_BAD_STATE", f"{shipment_id} (status={shipment.status})")
+    parts = [_split_weight(w) for w in weights]
+    if sum(parts, Decimal(0)) != Decimal(str(shipment.weight_kg)):
+        raise DomainError(
+            "E_BAD_WEIGHT",
+            f"weights {weights} do not add up to {shipment.weight_kg} for {shipment_id}",
+        )
+    now = clock.now()
+    new_shipments = [
+        Shipment(
+            id=ids.new_id("shp"),
+            customer_id=shipment.customer_id,
+            weight_kg=weight,
+            zone=shipment.zone,
+            created_at=now,
+        )
+        for weight in weights
+    ]
+    for new in new_shipments:
+        db.shipments[new.id] = new
+    shipment.status = "split"
+    events.emit(
+        "shipment.split",
+        shipment_id,
+        new_shipment_ids=[new.id for new in new_shipments],
+    )
+    return new_shipments
