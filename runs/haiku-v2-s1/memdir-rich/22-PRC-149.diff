+import pytest
+
+from parcelo import clock, customers, events, shipments
+from parcelo.errors import DomainError
+from parcelo.models import Shipment
+from parcelo.store import db
+
+
+@pytest.fixture
+def customer():
+    return customers.add_customer("Acme")
+
+
+@pytest.fixture
+def shipment(customer):
+    s = shipments.create_shipment(customer.id, 10.0, "national")
+    events.OUTBOX.clear()
+    return s
+
+
+def snapshot(s):
+    return (s.status, s.weight_kg, s.customer_id, s.zone)
+
+
+def test_split_creates_one_shipment_per_weight_in_order(shipment, customer):
+    clock.set_fixed("2026-11-12T10:00:00+00:00")
+    events.OUTBOX.clear()
+    result = shipments.split_shipment(shipment.id, [4.0, 6.0])
+
+    assert [s.weight_kg for s in result] == [4.0, 6.0]
+    for s in result:
+        assert isinstance(s, Shipment)
+        assert s.id.startswith("shp_")
+        assert s.customer_id == customer.id
+        assert s.zone == "national"
+        assert s.status == "created"
+        assert db.shipments[s.id] is s
+    assert len({s.id for s in result}) == 2
+    assert result[0].created_at == clock.now()
+
+
+def test_original_is_marked_split(shipment):
+    shipments.split_shipment(shipment.id, [3.0, 7.0])
+    assert db.shipments[shipment.id].status == "split"
+    assert db.shipments[shipment.id].weight_kg == 10.0
+
+
+def test_split_emits_event(shipment):
+    events.OUTBOX.clear()
+    result = shipments.split_shipment(shipment.id, [5.0, 5.0])
+    assert events.OUTBOX[-1]["name"] == "shipment.split"
+    assert events.OUTBOX[-1]["entity_id"] == shipment.id
+    assert events.OUTBOX[-1]["payload"]["new_shipment_ids"] == [s.id for s in result]
+
+
+def test_float_weights_that_add_up_are_accepted(customer):
+    s = shipments.create_shipment(customer.id, 0.3, "local")
+    result = shipments.split_shipment(s.id, [0.1, 0.2])
+    assert [r.weight_kg for r in result] == [0.1, 0.2]
+
+
+def test_unknown_shipment_fails():
+    with pytest.raises(DomainError) as err:
+        shipments.split_shipment("shp_999999", [1.0])
+    assert err.value.code == "E_NOT_FOUND"
+    assert db.shipments == {}
+
+
+def test_not_created_status_fails(shipment):
+    shipment.status = "delivered"
+    before = snapshot(shipment)
+    with pytest.raises(DomainError) as err:
+        shipments.split_shipment(shipment.id, [4.0, 6.0])
+    assert err.value.code == "E_BAD_STATE"
+    assert snapshot(shipment) == before
+    assert len(db.shipments) == 1
+    assert events.OUTBOX == []
+
+
+def test_already_split_fails(shipment):
+    shipments.split_shipment(shipment.id, [4.0, 6.0])
+    count = len(db.shipments)
+    with pytest.raises(DomainError) as err:
+        shipments.split_shipment(shipment.id, [4.0, 6.0])
+    assert err.value.code == "E_BAD_STATE"
+    assert len(db.shipments) == count
+
+
+@pytest.mark.parametrize("weights", [[4.0, 5.0], [4.0, 7.0], [], [10.0, 0.0], [-2.0, 12.0]])
+def test_weights_not_adding_up_fail_without_side_effects(shipment, weights):
+    before = snapshot(shipment)
+    with pytest.raises(DomainError) as err:
+        shipments.split_shipment(shipment.id, weights)
+    assert err.value.code == "E_BAD_WEIGHT"
+    assert snapshot(shipment) == before
+    assert len(db.shipments) == 1
+    assert events.OUTBOX == []
+
+
