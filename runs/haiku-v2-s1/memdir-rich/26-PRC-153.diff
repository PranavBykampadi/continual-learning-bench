+def needs_review(customer_id):
+    """True if the customer has more than 3 open invoices or open invoices totalling over 250.00."""
+    if customer_id not in db.customers:
+        raise DomainError("E_NOT_FOUND", customer_id)
+    open_count = 0
+    total = Money.zero()
+    for invoice in db.invoices.values():
+        shipment = db.shipments[invoice.shipment_id]
+        if shipment.customer_id == customer_id and invoice.status == "open":
+            open_count += 1
+            total = total + Money.parse(invoice.amount)
+    return open_count > REVIEW_MAX_OPEN_INVOICES or REVIEW_MAX_OPEN_TOTAL < total
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_needs_review.py b/tests/unit/test_needs_review.py
--- a/tests/unit/test_needs_review.py	1969-12-31 19:00:00
+++ b/tests/unit/test_needs_review.py	2026-11-12 02:26:23
@@ -0,0 +1,80 @@
+import pytest
+
+from parcelo import customers, events, shipments
+from parcelo.errors import DomainError
+from parcelo.models import Invoice
+from parcelo.store import db
+
+
+def _invoice(customer_id, amount, status="open"):
+    shipment = shipments.create_shipment(customer_id, 1, "local")
+    invoice = Invoice(
+        id="INV-%06d" % (len(db.invoices) + 1),
+        shipment_id=shipment.id,
+        amount=amount,
+        status=status,
+    )
+    db.invoices[invoice.id] = invoice
+    return invoice
+
+
+def test_unknown_customer_fails():
+    with pytest.raises(DomainError) as err:
+        customers.needs_review("nope")
+    assert err.value.code == "E_NOT_FOUND"
+
+
+def test_no_invoices_is_false():
+    c = customers.add_customer("Acme")
+    assert customers.needs_review(c.id) is False
+
+
+def test_three_open_invoices_small_total_is_false():
+    c = customers.add_customer("Acme")
+    for _ in range(3):
+        _invoice(c.id, 10.00)
+    assert customers.needs_review(c.id) is False
+
+
+def test_four_open_invoices_is_true():
+    c = customers.add_customer("Acme")
+    for _ in range(4):
+        _invoice(c.id, 1.00)
+    assert customers.needs_review(c.id) is True
+
+
+def test_total_exactly_250_is_false():
+    c = customers.add_customer("Acme")
+    _invoice(c.id, 100.00)
+    _invoice(c.id, 150.00)
+    assert customers.needs_review(c.id) is False
+
+
+def test_total_just_over_250_is_true():
+    c = customers.add_customer("Acme")
+    _invoice(c.id, 100.00)
+    _invoice(c.id, 150.01)
+    assert customers.needs_review(c.id) is True
+
+
+def test_paid_and_other_customers_do_not_count():
+    c = customers.add_customer("Acme")
+    other = customers.add_customer("Other")
+    for _ in range(5):
+        _invoice(c.id, 1.00, status="paid")
+    _invoice(c.id, 300.00, status="paid")
+    _invoice(other.id, 300.00)
+    _invoice(other.id, 300.00)
+    _invoice(other.id, 300.00)
+    _invoice(other.id, 300.00)
+    assert customers.needs_review(c.id) is False
+
+
+def test_read_only_no_events_no_mutation():
+    c = customers.add_customer("Acme")
+    inv = _invoice(c.id, 300.00)
+    events.OUTBOX.clear()
+    assert customers.needs_review(c.id) is True
+    assert events.OUTBOX == []
+    assert inv.status == "open"
+    assert inv.amount == 300.00
