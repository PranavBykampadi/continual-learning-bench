+from parcelo.money import Money
 from parcelo.store import db
+
+
+def outstanding_by_customer():
+    """Map customer id -> total of that customer's open invoices (as Money).
+
+    Only invoices with status "open" count; paid and void invoices are skipped.
+    A customer appears only if they have at least one open invoice.
+    """
+    totals = {}
+    for invoice in db.invoices.values():
+        if invoice.status != "open":
+            continue
+        customer_id = db.shipments[invoice.shipment_id].customer_id
+        amount = Money.parse(invoice.amount)
+        totals[customer_id] = totals.get(customer_id, Money.zero()) + amount
+    return totals
 
 
