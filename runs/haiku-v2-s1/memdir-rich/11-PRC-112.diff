diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_file_claim.py b/tests/unit/test_file_claim.py
--- a/tests/unit/test_file_claim.py	1969-12-31 19:00:00
+++ b/tests/unit/test_file_claim.py	2026-11-12 02:05:42
@@ -0,0 +1,91 @@
+import re
+from datetime import datetime, timezone
+
+import pytest
+
+from parcelo import audit, clock, customers, shipments
+from parcelo.claims import file_claim
+from parcelo.errors import DomainError
+from parcelo.money import Money
+from parcelo.store import db
+
+NOW = datetime(2026, 11, 12, 9, 30, tzinfo=timezone.utc)
+
+
+def _shipment(status="delivered", delivered=True):
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 1.5, "national")
+    s.status = status
+    s.delivered_at = NOW if delivered else None
+    return s
+
+
+def test_file_claim_returns_and_stores_claim():
+    clock.set_fixed(NOW)
+    s = _shipment()
+    claim = file_claim(s.id, 12.5, "item damaged")
+    assert db.claims[claim.id] is claim
+    assert claim.shipment_id == s.id
+    assert claim.amount == Money(1250)
+    assert claim.reason == "item damaged"
+    assert claim.filed_at == NOW
+
+
+def test_claim_id_format():
+    s = _shipment()
+    claim = file_claim(s.id, 5, "late")
+    assert re.fullmatch(r"clm_\d{6}", claim.id)
+
+
+def test_claim_ids_are_distinct():
+    s = _shipment()
+    a = file_claim(s.id, 5, "late")
+    b = file_claim(s.id, 5, "late")
+    assert a.id != b.id
+
+
+def test_file_claim_records_audit():
+    s = _shipment()
+    claim = file_claim(s.id, 5, "late")
+    assert audit.LOG[-1]["action"] == "claim.filed"
+    assert audit.LOG[-1]["entity_id"] == claim.id
+
+
+def test_unknown_shipment_is_not_found():
+    with pytest.raises(DomainError) as err:
+        file_claim("shp_000999", 5, "late")
+    assert err.value.code == "E_NOT_FOUND"
+    assert db.claims == {}
+
+
+@pytest.mark.parametrize(
+    "status,delivered",
+    [("created", False), ("cancelled", False), ("delivered", False)],
+)
+def test_undelivered_shipment_is_bad_state(status, delivered):
+    s = _shipment(status=status, delivered=delivered)
+    before = (s.status, s.delivered_at)
+    with pytest.raises(DomainError) as err:
+        file_claim(s.id, 5, "late")
+    assert err.value.code == "E_BAD_STATE"
+    assert db.claims == {}
+    assert (s.status, s.delivered_at) == before
+    assert all(e["action"] != "claim.filed" for e in audit.LOG)
+
+
+@pytest.mark.parametrize("amount", [0, -5, -0.01, "0", "-3", None, "abc", float("nan")])
+def test_non_positive_or_invalid_amount_is_bad_input(amount):
+    s = _shipment()
+    with pytest.raises(DomainError) as err:
+        file_claim(s.id, amount, "late")
+    assert err.value.code == "E_BAD_INPUT"
+    assert db.claims == {}
+
+
+@pytest.mark.parametrize("reason", ["", "   ", None])
+def test_blank_reason_is_bad_input(reason):
+    s = _shipment()
+    with pytest.raises(DomainError) as err:
+        file_claim(s.id, 5, reason)
+    assert err.value.code == "E_BAD_INPUT"
+    assert db.claims == {}
