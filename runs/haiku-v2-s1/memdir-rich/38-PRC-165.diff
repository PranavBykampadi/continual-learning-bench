diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_shipments_without_invoice.py b/tests/unit/test_shipments_without_invoice.py
--- a/tests/unit/test_shipments_without_invoice.py	1969-12-31 19:00:00
+++ b/tests/unit/test_shipments_without_invoice.py	2026-11-12 02:44:56
@@ -0,0 +1,63 @@
+from parcelo import reports
+from parcelo.models import Invoice, Shipment
+from parcelo.store import db
+
+
+def _shipment(sid, customer_id="cus_1"):
+    s = Shipment(id=sid, customer_id=customer_id, weight_kg=1.0, zone="local")
+    db.shipments[sid] = s
+    return s
+
+
+def _invoice(iid, shipment_id, status="open"):
+    inv = Invoice(id=iid, shipment_id=shipment_id, amount=10.0, status=status)
+    db.invoices[iid] = inv
+    return inv
+
+
+def test_empty_store_returns_empty_list():
+    assert reports.shipments_without_invoice() == []
+
+
+def test_returns_only_shipments_with_no_invoice():
+    _shipment("shp_000002")
+    _shipment("shp_000001")
+    _invoice("INV-1", "shp_000001")
+    result = reports.shipments_without_invoice()
+    assert [s.id for s in result] == ["shp_000002"]
+
+
+def test_any_invoice_status_counts_as_invoiced():
+    _shipment("shp_000001")
+    _shipment("shp_000002")
+    _shipment("shp_000003")
+    _invoice("INV-1", "shp_000001", status="paid")
+    _invoice("INV-2", "shp_000002", status="open")
+    assert [s.id for s in reports.shipments_without_invoice()] == ["shp_000003"]
+
+
+def test_sorted_by_id_ascending():
+    for sid in ["shp_000003", "shp_000001", "shp_000002"]:
+        _shipment(sid)
+    assert [s.id for s in reports.shipments_without_invoice()] == [
+        "shp_000001",
+        "shp_000002",
+        "shp_000003",
+    ]
+
+
+def test_all_invoiced_returns_empty():
+    _shipment("shp_000001")
+    _invoice("INV-1", "shp_000001")
+    assert reports.shipments_without_invoice() == []
+
+
+def test_read_only():
+    _shipment("shp_000001")
+    _invoice("INV-1", "shp_000001")
+    _shipment("shp_000002")
+    before_shipments = dict(db.shipments)
+    before_invoices = dict(db.invoices)
+    reports.shipments_without_invoice()
+    assert db.shipments == before_shipments
+    assert db.invoices == before_invoices
