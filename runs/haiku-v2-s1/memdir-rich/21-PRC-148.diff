diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_disputes.py b/tests/unit/test_disputes.py
--- a/tests/unit/test_disputes.py	1969-12-31 19:00:00
+++ b/tests/unit/test_disputes.py	2026-11-12 02:20:28
@@ -0,0 +1,71 @@
+import re
+from datetime import datetime, timezone
+
+import pytest
+
+from parcelo import clock, disputes, events, ids, store
+from parcelo.errors import DomainError
+from parcelo.models import Dispute, Invoice
+
+
+def _add_invoice(invoice_id="INV-1"):
+    inv = Invoice(id=invoice_id, shipment_id="shp_000001", amount=7.0)
+    store.db.invoices[inv.id] = inv
+    return inv
+
+
+def test_open_dispute_stores_and_returns_dispute():
+    clock.set_fixed(datetime(2026, 11, 12, 9, 0, tzinfo=timezone.utc))
+    _add_invoice("INV-1")
+    d = disputes.open_dispute("INV-1", "wrong weight")
+    assert isinstance(d, Dispute)
+    assert d.invoice_id == "INV-1"
+    assert d.reason == "wrong weight"
+    assert d.opened_at == datetime(2026, 11, 12, 9, 0, tzinfo=timezone.utc)
+    assert store.db.disputes[d.id] is d
+
+
+def test_dispute_id_format():
+    _add_invoice("INV-1")
+    d = disputes.open_dispute("INV-1", "damaged")
+    assert re.fullmatch(r"dsp_\d{6}", d.id)
+
+
+def test_dispute_ids_are_unique():
+    _add_invoice("INV-1")
+    a = disputes.open_dispute("INV-1", "one")
+    b = disputes.open_dispute("INV-1", "two")
+    assert a.id != b.id
+    assert len(store.db.disputes) == 2
+
+
+def test_unknown_invoice_raises_not_found():
+    with pytest.raises(DomainError) as exc:
+        disputes.open_dispute("INV-missing", "reason")
+    assert exc.value.code == "E_NOT_FOUND"
+    assert store.db.disputes == {}
+    assert events.OUTBOX == []
+
+
+@pytest.mark.parametrize("reason", ["", "   ", None])
+def test_empty_reason_raises_bad_input(reason):
+    _add_invoice("INV-1")
+    with pytest.raises(DomainError) as exc:
+        disputes.open_dispute("INV-1", reason)
+    assert exc.value.code == "E_BAD_INPUT"
+    assert store.db.disputes == {}
+    assert events.OUTBOX == []
+
+
+def test_open_dispute_emits_event():
+    _add_invoice("INV-1")
+    d = disputes.open_dispute("INV-1", "late")
+    assert events.OUTBOX[-1]["name"] == "dispute.opened"
+    assert events.OUTBOX[-1]["entity_id"] == d.id
+
+
+def test_reset_clears_disputes():
+    _add_invoice("INV-1")
+    disputes.open_dispute("INV-1", "late")
+    store.reset()
+    assert store.db.disputes == {}
