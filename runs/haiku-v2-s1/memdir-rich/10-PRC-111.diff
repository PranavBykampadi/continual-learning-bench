     if shipment_id not in db.shipments:
         raise DomainError("E_NOT_FOUND", shipment_id)
     return db.shipments[shipment_id]
+
+
+def add_note(shipment_id, text):
+    shipment = get_shipment(shipment_id)
+    if not isinstance(text, str) or not text.strip():
+        raise DomainError("E_BAD_INPUT", "note text must not be empty")
+    shipment.notes.append({"text": text, "at": clock.now()})
+    audit.record("shipment.note_added", shipment.id)
+    return shipment
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_add_note.py b/tests/unit/test_add_note.py
--- a/tests/unit/test_add_note.py	1969-12-31 19:00:00
+++ b/tests/unit/test_add_note.py	2026-11-12 02:04:08
@@ -0,0 +1,66 @@
+from datetime import datetime, timezone
+
+import pytest
+
+from parcelo import audit, clock, store
+from parcelo.errors import DomainError
+from parcelo.models import Shipment
+from parcelo.shipments import add_note
+from parcelo.store import db
+
+MOMENT = datetime(2026, 11, 12, 9, 30, tzinfo=timezone.utc)
+
+
+def _shipment(sid="shp_1"):
+    s = Shipment(id=sid, customer_id="c1", weight_kg=2.0, zone="local")
+    db.shipments[sid] = s
+    return s
+
+
+def test_appends_note_with_text_and_time():
+    clock.set_fixed(MOMENT)
+    s = _shipment()
+    result = add_note("shp_1", "left at front desk")
+    assert result is s
+    assert s.notes == [{"text": "left at front desk", "at": MOMENT}]
+
+
+def test_notes_accumulate_in_order():
+    s = _shipment()
+    clock.set_fixed(MOMENT)
+    add_note("shp_1", "first")
+    later = datetime(2026, 11, 12, 10, 0, tzinfo=timezone.utc)
+    clock.set_fixed(later)
+    add_note("shp_1", "second")
+    assert [n["text"] for n in s.notes] == ["first", "second"]
+    assert [n["at"] for n in s.notes] == [MOMENT, later]
+
+
+def test_unknown_shipment_raises_not_found():
+    with pytest.raises(DomainError) as exc:
+        add_note("shp_missing", "hello")
+    assert exc.value.code == "E_NOT_FOUND"
+    assert "shp_missing" not in db.shipments
+
+
+@pytest.mark.parametrize("text", ["", "   ", "\n\t", None])
+def test_empty_text_raises_bad_input_and_does_not_change_notes(text):
+    s = _shipment()
+    with pytest.raises(DomainError) as exc:
+        add_note("shp_1", text)
+    assert exc.value.code == "E_BAD_INPUT"
+    assert s.notes == []
+
+
+def test_failed_add_writes_no_audit_entry():
+    _shipment()
+    with pytest.raises(DomainError):
+        add_note("shp_1", "")
+    assert audit.LOG == []
+
+
+def test_successful_add_is_audited():
+    _shipment()
+    add_note("shp_1", "hello")
+    assert audit.LOG[-1]["action"] == "shipment.note_added"
+    assert audit.LOG[-1]["entity_id"] == "shp_1"
