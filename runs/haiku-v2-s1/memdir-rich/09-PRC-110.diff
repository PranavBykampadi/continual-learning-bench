+++ b/tests/unit/test_discounted_quote.py	2026-11-12 02:03:00
@@ -0,0 +1,47 @@
+import pytest
+
+from parcelo import rates
+from parcelo.errors import DomainError
+
+
+def test_gold_gets_ten_percent_off():
+    # local: 4.5 + 1.25 * 2 = 7.0 -> 10% off = 6.3
+    assert rates.discounted_quote(2, "local", "gold") == 6.3
+
+
+def test_gold_discount_on_national():
+    # national: 9.0 + 1.25 * 4 = 14.0 -> 12.6
+    assert rates.discounted_quote(4, "national", "gold") == 12.6
+
+
+def test_gold_discount_on_international():
+    # international: 24.0 + 1.25 * 2 = 26.5 -> 23.85
+    assert rates.discounted_quote(2, "international", "gold") == 23.85
+
+
+def test_standard_has_no_discount():
+    assert rates.discounted_quote(2, "local", "standard") == rates.quote(2, "local")
+    assert rates.discounted_quote(2, "local", "standard") == 7.0
+
+
+def test_gold_is_quote_minus_ten_percent_rounded_to_cents():
+    base = rates.quote(3, "national")
+    assert rates.discounted_quote(3, "national", "gold") == round(base * 0.9, 2)
+
+
+def test_unknown_zone_fails():
+    with pytest.raises(DomainError) as exc:
+        rates.discounted_quote(2, "moon", "gold")
+    assert exc.value.code == "E_BAD_ZONE"
+
+
+def test_unknown_tier_fails():
+    with pytest.raises(DomainError) as exc:
+        rates.discounted_quote(2, "local", "platinum")
+    assert exc.value.code == "E_BAD_INPUT"
+
+
+def test_unknown_zone_checked_before_tier():
+    with pytest.raises(DomainError) as exc:
+        rates.discounted_quote(2, "moon", "platinum")
+    assert exc.value.code == "E_BAD_ZONE"
