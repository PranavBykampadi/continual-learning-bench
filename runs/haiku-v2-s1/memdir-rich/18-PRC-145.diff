+def upgrade_tier(customer_id):
+    if customer_id not in db.customers:
+        raise DomainError("E_NOT_FOUND", customer_id)
+    customer = db.customers[customer_id]
+    if customer.tier == "gold":
+        raise DomainError("E_BAD_STATE", f"{customer_id} is already gold")
+    customer.tier = "gold"
+    events.emit("customer.upgraded", customer_id, tier="gold")
+    return customer
 
 
