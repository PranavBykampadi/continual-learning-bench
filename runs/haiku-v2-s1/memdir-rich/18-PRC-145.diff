diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_upgrade_tier.py b/tests/unit/test_upgrade_tier.py
--- a/tests/unit/test_upgrade_tier.py	1969-12-31 19:00:00
+++ b/tests/unit/test_upgrade_tier.py	2026-11-12 02:16:40
@@ -0,0 +1,46 @@
+import pytest
+
+from parcelo import customers, events
+from parcelo.errors import DomainError
+
+
+def test_upgrade_standard_to_gold_returns_same_customer():
+    c = customers.add_customer("Acme")
+    assert c.tier == "standard"
+    result = customers.upgrade_tier(c.id)
+    assert result is c
+    assert c.tier == "gold"
+    assert customers.get_customer(c.id).tier == "gold"
+
+
+def test_upgrade_emits_event():
+    c = customers.add_customer("Acme")
+    events.OUTBOX.clear()
+    customers.upgrade_tier(c.id)
+    assert events.OUTBOX[-1]["name"] == "customer.upgraded"
+    assert events.OUTBOX[-1]["entity_id"] == c.id
+
+
+def test_unknown_customer_fails_with_not_found():
+    with pytest.raises(DomainError) as err:
+        customers.upgrade_tier("C_nope")
+    assert err.value.code == "E_NOT_FOUND"
+
+
+def test_already_gold_fails_with_bad_state_and_no_change():
+    c = customers.add_customer("Acme", tier="gold")
+    events.OUTBOX.clear()
+    with pytest.raises(DomainError) as err:
+        customers.upgrade_tier(c.id)
+    assert err.value.code == "E_BAD_STATE"
+    assert c.tier == "gold"
+    assert events.OUTBOX == []
+
+
+def test_failed_upgrade_leaves_standard_customer_unchanged():
+    c = customers.add_customer("Acme")
+    events.OUTBOX.clear()
+    with pytest.raises(DomainError):
+        customers.upgrade_tier("C_nope")
+    assert customers.get_customer(c.id).tier == "standard"
+    assert events.OUTBOX == []
