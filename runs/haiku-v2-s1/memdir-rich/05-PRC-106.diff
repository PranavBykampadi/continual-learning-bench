+def _as_utc(moment):
+    # issue_invoice stores naive UTC datetimes; clock.now() is timezone-aware.
+    if moment.tzinfo is None:
+        return moment.replace(tzinfo=timezone.utc)
+    return moment
+
+
+def late_fee_for(invoice_id):
+    """Late fee accrued on an invoice as of now.
+
+    The invoice is late 30 days after issue. From then on the fee is 1.5% of
+    the invoice amount for each whole day past those 30 days. Returns Money.
+    """
+    if invoice_id not in db.invoices:
+        raise DomainError("E_NOT_FOUND", f"invoice {invoice_id} not found")
+    invoice = db.invoices[invoice_id]
+    if invoice.issued_at is None:
+        raise DomainError("E_BAD_STATE", f"invoice {invoice_id} has no issue date")
+
+    elapsed_days = (_as_utc(clock.now()) - _as_utc(invoice.issued_at)).days
+    days_late = elapsed_days - LATE_AFTER_DAYS
+    if days_late <= 0:
+        return Money.zero()
+    amount = Money.parse(invoice.amount)
+    return amount.scale(LATE_FEE_PER_DAY * days_late)
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_late_fee.py b/tests/unit/test_late_fee.py
--- a/tests/unit/test_late_fee.py	1969-12-31 19:00:00
+++ b/tests/unit/test_late_fee.py	2026-11-12 01:58:27
@@ -0,0 +1,61 @@
+from datetime import datetime, timedelta, timezone
+
+import pytest
+
+from parcelo import clock, invoices
+from parcelo.errors import DomainError
+from parcelo.models import Invoice
+from parcelo.money import Money
+from parcelo.store import db
+
+ISSUED = datetime(2026, 1, 1, tzinfo=timezone.utc)
+
+
+def _invoice(amount=100.0, issued_at=ISSUED):
+    inv = Invoice(id="INV-1", shipment_id="S-1", amount=amount, issued_at=issued_at)
+    db.invoices[inv.id] = inv
+    return inv
+
+
+def _at(days):
+    clock.set_fixed(ISSUED + timedelta(days=days))
+    return invoices.late_fee_for("INV-1")
+
+
+def test_not_late_before_30_days_is_zero():
+    _invoice()
+    assert _at(29) == Money.zero()
+
+
+def test_exactly_30_days_is_zero():
+    _invoice()
+    assert _at(30) == Money.zero()
+
+
+def test_one_day_past_30_is_1_5_percent():
+    _invoice(amount=100.0)
+    assert _at(31) == Money(150)  # $100 * 1.5%
+
+
+def test_fee_scales_per_day():
+    _invoice(amount=200.0)
+    assert _at(40) == Money(3000)  # 10 days late * $3.00/day = $30.00
+
+
+def test_fee_uses_money_not_float():
+    _invoice(amount=10.0)
+    fee = _at(33)  # 3 days late: 10 * 1.5% * 3 = 0.45
+    assert isinstance(fee, Money)
+    assert fee.cents == 45
+
+
+def test_naive_issued_at_is_accepted():
+    # issue_invoice stores naive UTC datetimes.
+    _invoice(amount=100.0, issued_at=datetime(2026, 1, 1))
+    assert _at(31) == Money(150)
+
+
+def test_missing_invoice_raises_not_found():
+    with pytest.raises(DomainError) as exc:
+        invoices.late_fee_for("INV-missing")
+    assert exc.value.code == "E_NOT_FOUND"
