 def open_invoices():
     return [i for i in db.invoices.values() if i.status == "open"]
+
+
+def apply_credit(invoice_id, amount):
+    """Reduce an open invoice's amount by a credit and return the remaining amount as Money.
+
+    Invoice.amount stays a float (reports and customers.outstanding_balance sum it
+    directly), so the new value is written back as dollars.
+    """
+    if invoice_id not in db.invoices:
+        raise DomainError("E_NOT_FOUND", invoice_id)
+    invoice = db.invoices[invoice_id]
+    if invoice.status != "open":
+        raise DomainError("E_BAD_STATE", f"{invoice_id} is {invoice.status}, not open")
+    credit = Money.parse(amount)
+    if credit.cents < 0:
+        raise DomainError("E_BAD_INPUT", f"credit must not be negative: {credit}")
+    current = Money.parse(invoice.amount)
+    if current < credit:
+        raise DomainError("E_LIMIT", f"credit {credit} exceeds invoice {invoice_id} amount {current}")
+    remaining = current - credit
+    invoice.amount = remaining.cents / 100
+    audit.record("invoice.credit_applied", invoice_id, credit=str(credit))
+    return remaining
