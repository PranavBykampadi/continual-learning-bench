@@ -0,0 +1,119 @@
+import pytest
+
+from parcelo import audit, clock, customers, invoices, reports, shipments
+from parcelo.errors import DomainError
+from parcelo.money import Money
+
+
+def _open_invoice(customer_name="Acme", weight=2):
+    c = customers.add_customer(customer_name)
+    s = shipments.create_shipment(c.id, weight, "local")
+    inv = invoices.issue_invoice(s.id)
+    return c, inv
+
+
+def test_credit_reduces_amount_and_returns_remaining():
+    _, inv = _open_invoice()  # local, 2 kg -> 7.00
+    remaining = invoices.apply_credit(inv.id, 2.5)
+    assert remaining == Money.parse(4.5)
+    assert inv.amount == 4.5
+    assert inv.status == "open"
+
+
+def test_credit_equal_to_amount_leaves_zero():
+    _, inv = _open_invoice()
+    remaining = invoices.apply_credit(inv.id, 7.0)
+    assert remaining == Money.zero()
+    assert inv.amount == 0.0
+    assert inv.status == "open"
+
+
+def test_zero_credit_leaves_amount_unchanged():
+    _, inv = _open_invoice()
+    assert invoices.apply_credit(inv.id, 0) == Money.parse(7.0)
+    assert inv.amount == 7.0
+
+
+def test_credits_accumulate():
+    _, inv = _open_invoice()
+    invoices.apply_credit(inv.id, 1.25)
+    remaining = invoices.apply_credit(inv.id, 1.25)
+    assert remaining == Money.parse(4.5)
+    assert inv.amount == 4.5
+
+
+def test_unknown_invoice_raises_not_found():
+    with pytest.raises(DomainError) as exc:
+        invoices.apply_credit("INV-missing", 1.0)
+    assert exc.value.code == "E_NOT_FOUND"
+
+
+def test_paid_invoice_raises_bad_state_and_is_unchanged():
+    _, inv = _open_invoice()
+    invoices.mark_paid(inv.id)
+    with pytest.raises(DomainError) as exc:
+        invoices.apply_credit(inv.id, 1.0)
+    assert exc.value.code == "E_BAD_STATE"
+    assert inv.amount == 7.0
+    assert inv.status == "paid"
+
+
+def test_void_invoice_raises_bad_state_and_is_unchanged():
+    _, inv = _open_invoice()
+    inv.status = "void"
+    with pytest.raises(DomainError) as exc:
+        invoices.apply_credit(inv.id, 1.0)
+    assert exc.value.code == "E_BAD_STATE"
+    assert inv.amount == 7.0
+
+
+def test_credit_larger_than_amount_raises_and_is_unchanged():
+    _, inv = _open_invoice()
+    with pytest.raises(DomainError) as exc:
+        invoices.apply_credit(inv.id, 7.01)
+    assert exc.value.code == "E_LIMIT"
+    assert inv.amount == 7.0
+    assert inv.status == "open"
+    assert not any(e["action"] == "invoice.credit_applied" for e in audit.LOG)
+
+
+def test_negative_credit_raises_bad_input_and_is_unchanged():
+    _, inv = _open_invoice()
+    with pytest.raises(DomainError) as exc:
+        invoices.apply_credit(inv.id, -1.0)
+    assert exc.value.code == "E_BAD_INPUT"
+    assert inv.amount == 7.0
+
+
+def test_audit_records_credit_applied():
+    _, inv = _open_invoice()
+    invoices.apply_credit(inv.id, 2.0)
+    assert audit.LOG[-1]["action"] == "invoice.credit_applied"
+    assert audit.LOG[-1]["entity_id"] == inv.id
+
+
+def test_credit_works_with_revenue_total_and_outstanding_balance():
+    c, inv = _open_invoice()
+    invoices.apply_credit(inv.id, 2.0)  # 7.00 -> 5.00
+    # Open: customer balance reflects the reduced amount.
+    assert customers.outstanding_balance(c.id) == 5.0
+    # Paid: report sums the reduced amount.
+    invoices.mark_paid(inv.id)
+    assert reports.revenue_total() == 5.0
+    assert customers.outstanding_balance(c.id) == 0.0
+
+
+def test_credit_does_not_touch_other_invoices():
+    c, inv1 = _open_invoice()
+    s2 = shipments.create_shipment(c.id, 2, "local")
+    inv2 = invoices.issue_invoice(s2.id)
+    invoices.apply_credit(inv1.id, 3.0)
+    assert inv2.amount == 7.0
+    assert customers.outstanding_balance(c.id) == 11.0
+
+
