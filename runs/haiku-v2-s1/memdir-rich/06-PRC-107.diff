diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/parcelo/shipments.py b/parcelo/shipments.py
--- a/parcelo/shipments.py	2026-11-10 12:17:53
+++ b/parcelo/shipments.py	2026-11-12 01:59:39
@@ -28,3 +28,15 @@
     if shipment_id not in db.shipments:
         raise DomainError("E_NOT_FOUND", shipment_id)
     return db.shipments[shipment_id]
+
+
+def mark_delivered(shipment_id):
+    shipment = get_shipment(shipment_id)
+    if shipment.status == "cancelled":
+        raise DomainError("E_BAD_STATE", f"{shipment_id} is cancelled")
+    if shipment.status == "delivered" or shipment.delivered_at is not None:
+        raise DomainError("E_BAD_STATE", f"{shipment_id} is already delivered")
+    shipment.status = "delivered"
+    shipment.delivered_at = clock.now()
+    audit.record("shipment.delivered", shipment.id)
+    return shipment
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_mark_delivered.py b/tests/unit/test_mark_delivered.py
--- a/tests/unit/test_mark_delivered.py	1969-12-31 19:00:00
+++ b/tests/unit/test_mark_delivered.py	2026-11-12 01:59:41
@@ -0,0 +1,53 @@
+from datetime import datetime, timezone
+
+import pytest
+
+from parcelo import audit, clock, customers, shipments
+from parcelo.errors import DomainError
+
+
+def _shipment():
+    c = customers.add_customer("Acme")
+    return shipments.create_shipment(c.id, 1.5, "national")
+
+
+def test_marks_delivered_and_stamps_time():
+    clock.set_fixed(datetime(2026, 11, 12, 9, 30, tzinfo=timezone.utc))
+    s = _shipment()
+    result = shipments.mark_delivered(s.id)
+    assert result is s
+    assert s.status == "delivered"
+    assert s.delivered_at == datetime(2026, 11, 12, 9, 30, tzinfo=timezone.utc)
+
+
+def test_records_audit():
+    s = _shipment()
+    shipments.mark_delivered(s.id)
+    assert audit.LOG[-1]["action"] == "shipment.delivered"
+    assert audit.LOG[-1]["entity_id"] == s.id
+
+
+def test_unknown_shipment_fails():
+    with pytest.raises(DomainError) as err:
+        shipments.mark_delivered("shp_missing")
+    assert err.value.code == "E_NOT_FOUND"
+
+
+def test_cancelled_shipment_fails():
+    s = _shipment()
+    s.status = "cancelled"
+    with pytest.raises(DomainError) as err:
+        shipments.mark_delivered(s.id)
+    assert err.value.code == "E_BAD_STATE"
+    assert s.status == "cancelled"
+    assert s.delivered_at is None
+
+
+def test_already_delivered_fails():
+    s = _shipment()
+    shipments.mark_delivered(s.id)
+    first = s.delivered_at
+    with pytest.raises(DomainError) as err:
+        shipments.mark_delivered(s.id)
+    assert err.value.code == "E_BAD_STATE"
+    assert s.delivered_at == first
