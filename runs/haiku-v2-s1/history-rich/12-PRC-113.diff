 def open_invoices():
     return [i for i in db.invoices.values() if i.status == "open"]
+
+
+def apply_credit(invoice_id, amount):
+    """Reduce an open invoice by ``amount`` and return the remaining Money."""
+    if invoice_id not in db.invoices:
+        raise DomainError("E_NOT_FOUND", f"invoice {invoice_id} not found")
+    invoice = db.invoices[invoice_id]
+    if invoice.status != "open":
+        raise DomainError("E_BAD_STATE", f"invoice {invoice_id} is {invoice.status}")
+    credit = Money.parse(amount)
+    if credit.cents <= 0:
+        raise DomainError("E_BAD_INPUT", "credit must be positive")
+    current = Money.parse(invoice.amount)
+    if credit.cents > current.cents:
+        raise DomainError("E_BAD_INPUT", "credit exceeds invoice amount")
+    remaining = current - credit
+    # Invoice.amount stays a float: revenue_total and outstanding_balance sum it directly.
+    invoice.amount = remaining.cents / 100
+    audit.record(
+        "invoice.credit_applied",
+        invoice_id,
+        credit=str(credit),
+        remaining=str(remaining),
+    )
+    return remaining
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_invoice_credit.py b/tests/unit/test_invoice_credit.py
--- a/tests/unit/test_invoice_credit.py	1969-12-31 19:00:00
+++ b/tests/unit/test_invoice_credit.py	2026-11-12 01:59:56
@@ -0,0 +1,74 @@
+import pytest
+
+from parcelo import audit, customers, invoices, shipments
+from parcelo.errors import DomainError
+from parcelo.money import Money
+from parcelo.reports import revenue_total
+
+
+def _open_invoice():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 2, "local")  # invoice amount 7.00
+    inv = invoices.issue_invoice(s.id)
+    return c, inv
+
+
+def test_credit_reduces_open_invoice():
+    c, inv = _open_invoice()
+    remaining = invoices.apply_credit(inv.id, 2)
+    assert remaining == Money(500)
+    assert inv.amount == 5.0
+    assert inv.status == "open"
+
+
+def test_credit_flows_into_outstanding_balance_and_revenue():
+    c, inv = _open_invoice()
+    invoices.apply_credit(inv.id, 2.5)
+    assert customers.outstanding_balance(c.id) == 4.5
+    invoices.mark_paid(inv.id)
+    assert revenue_total() == 4.5
+
+
+def test_credit_equal_to_amount_leaves_zero():
+    c, inv = _open_invoice()
+    assert invoices.apply_credit(inv.id, 7.0) == Money(0)
+    assert inv.amount == 0.0
+
+
+def test_credit_is_audited_with_invoice_id():
+    c, inv = _open_invoice()
+    invoices.apply_credit(inv.id, 1)
+    entry = audit.LOG[-1]
+    assert entry["action"] == "invoice.credit_applied"
+    assert entry["entity_id"] == inv.id
+
+
+def test_unknown_invoice_fails():
+    with pytest.raises(DomainError) as err:
+        invoices.apply_credit("INV-missing", 1)
+    assert err.value.code == "E_NOT_FOUND"
+
+
+def test_paid_invoice_fails():
+    c, inv = _open_invoice()
+    invoices.mark_paid(inv.id)
+    with pytest.raises(DomainError) as err:
+        invoices.apply_credit(inv.id, 1)
+    assert err.value.code == "E_BAD_STATE"
+    assert inv.amount == 7.0
+
+
+def test_credit_larger_than_amount_fails():
+    c, inv = _open_invoice()
+    with pytest.raises(DomainError) as err:
+        invoices.apply_credit(inv.id, 7.01)
+    assert err.value.code == "E_BAD_INPUT"
+    assert inv.amount == 7.0
+
+
+def test_non_positive_credit_fails():
+    c, inv = _open_invoice()
+    with pytest.raises(DomainError) as err:
+        invoices.apply_credit(inv.id, 0)
+    assert err.value.code == "E_BAD_INPUT"
+    assert inv.amount == 7.0
