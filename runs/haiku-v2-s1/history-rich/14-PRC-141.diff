+
+
+def reassign_shipment(shipment_id, new_customer_id):
+    shipment = get_shipment(shipment_id)
+    if new_customer_id not in db.customers:
+        raise DomainError("E_UNKNOWN_CUSTOMER", new_customer_id)
+    if shipment.status == "delivered" or shipment.delivered_at is not None:
+        raise DomainError("E_BAD_STATE", shipment_id)
+    old_customer_id = shipment.customer_id
+    shipment.customer_id = new_customer_id
+    audit.record(
+        "shipment.reassign",
+        shipment_id,
+        old_customer_id=old_customer_id,
+        new_customer_id=new_customer_id,
+    )
+    return shipment
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_reassign_shipment.py b/tests/unit/test_reassign_shipment.py
--- a/tests/unit/test_reassign_shipment.py	1969-12-31 19:00:00
+++ b/tests/unit/test_reassign_shipment.py	2026-11-12 02:01:06
@@ -0,0 +1,65 @@
+import pytest
+
+from parcelo import audit, customers, shipments
+from parcelo.errors import DomainError
+from parcelo.store import db
+
+
+def _shipment(customer_id):
+    return shipments.create_shipment(customer_id, 2.0, "national")
+
+
+def test_reassign_changes_customer_and_returns_shipment():
+    old = customers.add_customer("Old")
+    new = customers.add_customer("New")
+    s = _shipment(old.id)
+
+    result = shipments.reassign_shipment(s.id, new.id)
+
+    assert result is s
+    assert db.shipments[s.id].customer_id == new.id
+
+
+def test_reassign_writes_audit_entry_with_shipment_id():
+    old = customers.add_customer("Old")
+    new = customers.add_customer("New")
+    s = _shipment(old.id)
+
+    shipments.reassign_shipment(s.id, new.id)
+
+    entry = audit.LOG[-1]
+    assert entry["action"] == "shipment.reassign"
+    assert entry["entity_id"] == s.id
+    assert entry["details"]["old_customer_id"] == old.id
+    assert entry["details"]["new_customer_id"] == new.id
+
+
+def test_reassign_unknown_shipment_fails():
+    new = customers.add_customer("New")
+    with pytest.raises(DomainError) as err:
+        shipments.reassign_shipment("shp_999999", new.id)
+    assert err.value.code == "E_NOT_FOUND"
+    assert audit.LOG == []
+
+
+def test_reassign_to_unknown_customer_fails_and_leaves_shipment_alone():
+    old = customers.add_customer("Old")
+    s = _shipment(old.id)
+    with pytest.raises(DomainError) as err:
+        shipments.reassign_shipment(s.id, "C_nope")
+    assert err.value.code == "E_UNKNOWN_CUSTOMER"
+    assert db.shipments[s.id].customer_id == old.id
+    assert audit.LOG == []
+
+
+def test_reassign_delivered_shipment_fails():
+    old = customers.add_customer("Old")
+    new = customers.add_customer("New")
+    s = _shipment(old.id)
+    s.status = "delivered"
+
+    with pytest.raises(DomainError) as err:
+        shipments.reassign_shipment(s.id, new.id)
+    assert err.value.code == "E_BAD_STATE"
+    assert db.shipments[s.id].customer_id == old.id
+    assert audit.LOG == []
