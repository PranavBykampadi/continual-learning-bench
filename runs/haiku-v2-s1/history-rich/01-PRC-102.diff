diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_void_invoice.py b/tests/unit/test_void_invoice.py
--- a/tests/unit/test_void_invoice.py	1969-12-31 19:00:00
+++ b/tests/unit/test_void_invoice.py	2026-11-12 01:50:52
@@ -0,0 +1,50 @@
+import pytest
+
+from parcelo import clock, customers, invoices, shipments
+from parcelo.store import db
+
+
+def _new_invoice():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 2, "local")
+    return invoices.issue_invoice(s.id)
+
+
+def test_void_sets_status_and_timestamp():
+    inv = _new_invoice()
+    result = invoices.void_invoice(inv.id)
+    assert result is inv
+    assert result.status == "void"
+    assert result.voided_at is not None
+    assert db.invoices[inv.id].status == "void"
+
+
+def test_void_uses_clock():
+    moment = clock.now()
+    clock.set_fixed(moment)
+    try:
+        inv = _new_invoice()
+        assert invoices.void_invoice(inv.id).voided_at == moment
+    finally:
+        clock.clear_fixed()
+
+
+def test_void_unknown_invoice_fails():
+    with pytest.raises(KeyError):
+        invoices.void_invoice("INV-missing")
+
+
+def test_void_paid_invoice_fails():
+    inv = _new_invoice()
+    invoices.mark_paid(inv.id)
+    with pytest.raises(ValueError):
+        invoices.void_invoice(inv.id)
+    assert db.invoices[inv.id].status == "paid"
+    assert db.invoices[inv.id].voided_at is None
+
+
+def test_void_twice_fails():
+    inv = _new_invoice()
+    invoices.void_invoice(inv.id)
+    with pytest.raises(ValueError):
+        invoices.void_invoice(inv.id)
