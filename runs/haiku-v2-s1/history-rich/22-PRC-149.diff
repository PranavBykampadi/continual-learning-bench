+++ b/tests/unit/test_split_shipment.py	2026-11-12 02:04:46
@@ -0,0 +1,90 @@
+import pytest
+
+from parcelo import customers, events, shipments
+from parcelo.errors import DomainError
+
+
+def _created(weight=10, zone="national"):
+    c = customers.add_customer("Acme")
+    return shipments.create_shipment(c.id, weight, zone)
+
+
+def test_split_replaces_original_with_new_shipments():
+    s = _created(10, "international")
+    new = shipments.split_shipment(s.id, [6, 4])
+
+    assert [n.weight_kg for n in new] == [6, 4]
+    assert all(n.id.startswith("shp_") for n in new)
+    assert all(n.customer_id == s.customer_id for n in new)
+    assert all(n.zone == "international" for n in new)
+    assert all(n.status == "created" for n in new)
+    assert s.status == "split"
+    assert shipments.get_shipment(new[0].id) is new[0]
+
+
+def test_split_emits_events():
+    s = _created(3)
+    events.OUTBOX.clear()
+    new = shipments.split_shipment(s.id, [1, 2])
+
+    names = [e["name"] for e in events.OUTBOX]
+    assert names.count("shipment.created") == 2
+    split = [e for e in events.OUTBOX if e["name"] == "shipment.split"]
+    assert len(split) == 1
+    assert split[0]["entity_id"] == s.id
+    assert split[0]["payload"]["new_ids"] == [n.id for n in new]
+
+
+def test_split_accepts_float_weights_that_sum_exactly():
+    s = _created(1.5)
+    new = shipments.split_shipment(s.id, [0.5, 1.0])
+    assert len(new) == 2
+
+
+def test_split_missing_shipment_fails():
+    with pytest.raises(DomainError) as err:
+        shipments.split_shipment("shp_999999", [1])
+    assert err.value.code == "E_NOT_FOUND"
+
+
+def test_split_non_created_shipment_fails():
+    s = _created(4)
+    s.status = "delivered"
+    with pytest.raises(DomainError) as err:
+        shipments.split_shipment(s.id, [2, 2])
+    assert err.value.code == "E_BAD_STATE"
+    assert s.status == "delivered"
+
+
+def test_split_already_split_shipment_fails():
+    s = _created(4)
+    shipments.split_shipment(s.id, [2, 2])
+    with pytest.raises(DomainError) as err:
+        shipments.split_shipment(s.id, [2, 2])
+    assert err.value.code == "E_BAD_STATE"
+
+
+def test_split_weights_must_sum_to_original():
+    s = _created(10)
+    with pytest.raises(DomainError) as err:
+        shipments.split_shipment(s.id, [4, 5])
+    assert err.value.code == "E_BAD_INPUT"
+    # Failed split leaves the original untouched and creates nothing.
+    assert s.status == "created"
+    assert len(shipments.db.shipments) == 1
+
+
+def test_split_rejects_non_positive_weight():
+    s = _created(5)
+    with pytest.raises(DomainError) as err:
+        shipments.split_shipment(s.id, [5, 0])
+    assert err.value.code == "E_BAD_WEIGHT"
+    assert s.status == "created"
+
+
+def test_split_rejects_empty_weights():
+    s = _created(5)
+    with pytest.raises(DomainError) as err:
+        shipments.split_shipment(s.id, [])
+    assert err.value.code == "E_BAD_INPUT"
+    assert s.status == "created"
