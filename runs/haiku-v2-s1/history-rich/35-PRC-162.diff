+
+
+VALID_INVOICE_STATUSES = ("open", "paid")
+
+
+def invoices_by_status(status):
+    if status not in VALID_INVOICE_STATUSES:
+        raise DomainError("E_BAD_INPUT", f"invalid invoice status {status!r}")
+    matches = [i for i in db.invoices.values() if i.status == status]
+    return sorted(matches, key=lambda i: i.id)
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_invoices_by_status.py b/tests/unit/test_invoices_by_status.py
--- a/tests/unit/test_invoices_by_status.py	1969-12-31 19:00:00
+++ b/tests/unit/test_invoices_by_status.py	2026-11-12 02:12:00
@@ -0,0 +1,38 @@
+import pytest
+
+from parcelo import customers, invoices, shipments
+from parcelo.errors import DomainError
+
+
+def _issue(customer_id, weight=2):
+    s = shipments.create_shipment(customer_id, weight, "local")
+    return invoices.issue_invoice(s.id)
+
+
+def test_empty_when_no_invoices():
+    assert invoices.invoices_by_status("open") == []
+    assert invoices.invoices_by_status("paid") == []
+
+
+def test_filters_by_status():
+    c = customers.add_customer("Acme")
+    a = _issue(c.id)
+    b = _issue(c.id)
+    invoices.mark_paid(b.id)
+
+    assert [i.id for i in invoices.invoices_by_status("open")] == [a.id]
+    assert [i.id for i in invoices.invoices_by_status("paid")] == [b.id]
+
+
+def test_sorted_by_id():
+    c = customers.add_customer("Acme")
+    ids_issued = [_issue(c.id).id for _ in range(5)]
+    result = [i.id for i in invoices.invoices_by_status("open")]
+    assert result == sorted(ids_issued)
+
+
+@pytest.mark.parametrize("bad", ["void", "", None, "OPEN"])
+def test_invalid_status_raises(bad):
+    with pytest.raises(DomainError) as err:
+        invoices.invoices_by_status(bad)
+    assert err.value.code == "E_BAD_INPUT"
