+
+def needs_review(customer_id):
+    """True if the customer has more than 3 open invoices or open invoices totalling over 250.00."""
+    if customer_id not in db.customers:
+        raise DomainError("E_UNKNOWN_CUSTOMER", customer_id)
+    open_count = 0
+    total = Money.zero()
+    for invoice in db.invoices.values():
+        shipment = db.shipments[invoice.shipment_id]
+        if shipment.customer_id == customer_id and invoice.status == "open":
+            open_count += 1
+            total = total + Money.parse(invoice.amount)
+    return open_count > REVIEW_INVOICE_COUNT or REVIEW_BALANCE_LIMIT < total
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_customers_needs_review.py b/tests/unit/test_customers_needs_review.py
--- a/tests/unit/test_customers_needs_review.py	1969-12-31 19:00:00
+++ b/tests/unit/test_customers_needs_review.py	2026-11-12 02:07:21
@@ -0,0 +1,68 @@
+import pytest
+
+from parcelo import customers, ids, shipments
+from parcelo.errors import DomainError
+from parcelo.models import Invoice
+from parcelo.store import db
+
+
+def _open_invoice(customer_id, amount, status="open"):
+    s = shipments.create_shipment(customer_id, 1, "local")
+    inv = Invoice(id=ids.new_id("inv"), shipment_id=s.id, amount=amount, status=status)
+    db.invoices[inv.id] = inv
+    return inv
+
+
+def test_no_invoices_is_not_flagged():
+    c = customers.add_customer("Acme")
+    assert customers.needs_review(c.id) is False
+
+
+def test_three_open_invoices_small_total_not_flagged():
+    c = customers.add_customer("Acme")
+    for _ in range(3):
+        _open_invoice(c.id, 10.0)
+    assert customers.needs_review(c.id) is False
+
+
+def test_more_than_three_open_invoices_flagged():
+    c = customers.add_customer("Acme")
+    for _ in range(4):
+        _open_invoice(c.id, 1.0)
+    assert customers.needs_review(c.id) is True
+
+
+def test_open_total_over_limit_flagged():
+    c = customers.add_customer("Acme")
+    _open_invoice(c.id, 150.0)
+    _open_invoice(c.id, 100.01)
+    assert customers.needs_review(c.id) is True
+
+
+def test_open_total_exactly_at_limit_not_flagged():
+    c = customers.add_customer("Acme")
+    _open_invoice(c.id, 150.0)
+    _open_invoice(c.id, 100.0)
+    assert customers.needs_review(c.id) is False
+
+
+def test_paid_invoices_do_not_count():
+    c = customers.add_customer("Acme")
+    for _ in range(5):
+        _open_invoice(c.id, 100.0, status="paid")
+    assert customers.needs_review(c.id) is False
+
+
+def test_other_customers_invoices_do_not_count():
+    a = customers.add_customer("Acme")
+    b = customers.add_customer("Beta")
+    for _ in range(4):
+        _open_invoice(b.id, 1.0)
+    assert customers.needs_review(a.id) is False
+    assert customers.needs_review(b.id) is True
+
+
+def test_unknown_customer_raises_domain_error():
+    with pytest.raises(DomainError) as err:
+        customers.needs_review("nope")
+    assert err.value.code == "E_UNKNOWN_CUSTOMER"
