diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_reports.py b/tests/unit/test_reports.py
--- a/tests/unit/test_reports.py	1969-12-31 19:00:00
+++ b/tests/unit/test_reports.py	2026-11-12 02:03:44
@@ -0,0 +1,36 @@
+from parcelo import customers, reports, shipments
+
+
+def test_volume_report_includes_customers_without_shipments():
+    c = customers.add_customer("Acme")
+    report = reports.volume_report()
+    assert report == {c.id: {"shipments": 0, "tier": "starter"}}
+
+
+def test_volume_report_counts_shipments_per_customer():
+    a = customers.add_customer("Acme")
+    b = customers.add_customer("Globex")
+    shipments.create_shipment(a.id, 1.0, "local")
+    shipments.create_shipment(a.id, 2.0, "national")
+    report = reports.volume_report()
+    assert report[a.id] == {"shipments": 2, "tier": "starter"}
+    assert report[b.id] == {"shipments": 0, "tier": "starter"}
+
+
+def test_volume_report_tier_thresholds():
+    c = customers.add_customer("Bulk Co")
+    d = customers.add_customer("Regular Co")
+    for _ in range(50):
+        shipments.create_shipment(c.id, 1.0, "local")
+    for _ in range(10):
+        shipments.create_shipment(d.id, 1.0, "local")
+    report = reports.volume_report()
+    assert report[c.id] == {"shipments": 50, "tier": "bulk"}
+    assert report[d.id] == {"shipments": 10, "tier": "regular"}
+
+
+def test_volume_report_tier_boundary_below_regular():
+    c = customers.add_customer("Almost")
+    for _ in range(9):
+        shipments.create_shipment(c.id, 1.0, "local")
+    assert reports.volume_report()[c.id] == {"shipments": 9, "tier": "starter"}
