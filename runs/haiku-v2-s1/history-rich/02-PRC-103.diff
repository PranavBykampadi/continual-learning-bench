+from parcelo.legacy.billing import fuel_surcharge
+
 ZONE_BASE = {"local": 4.5, "national": 9.0, "international": 24.0}
 PER_KG = 1.25
 
@@ -12,3 +15,21 @@
     if weight_kg <= 0:
         raise ValueError("weight must be positive")
     return round(base_rate(zone) + PER_KG * weight_kg, 2)
+
+
+def quote_with_surcharge(weight_kg, zone):
+    """Return the quote plus the zone's fuel surcharge.
+
+    Raises DomainError (E_BAD_ZONE / E_BAD_WEIGHT) for invalid input.
+    """
+    if zone not in ZONE_BASE:
+        raise DomainError("E_BAD_ZONE", "unknown zone: %s" % zone)
+    if weight_kg <= 0:
+        raise DomainError("E_BAD_WEIGHT", "weight must be positive")
+    base = quote(weight_kg, zone)
+    surcharge = fuel_surcharge(base, zone)
+    return {
+        "quote": base,
+        "fuel_surcharge": surcharge,
+        "total": round(base + surcharge, 2),
+    }
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_rates_surcharge.py b/tests/unit/test_rates_surcharge.py
--- a/tests/unit/test_rates_surcharge.py	1969-12-31 19:00:00
+++ b/tests/unit/test_rates_surcharge.py	2026-11-12 01:51:48
@@ -0,0 +1,39 @@
+import pytest
+
+from parcelo import rates
+from parcelo.errors import DomainError
+
+
+def test_quote_with_surcharge_national():
+    # base quote: 9.0 + 1.25 * 2 = 11.5; 4% surcharge = 0.46
+    result = rates.quote_with_surcharge(2, "national")
+    assert result["quote"] == 11.5
+    assert result["fuel_surcharge"] == 0.46
+    assert result["total"] == 11.96
+
+
+def test_quote_with_surcharge_local_has_no_surcharge():
+    result = rates.quote_with_surcharge(2, "local")
+    assert result["quote"] == 7.0
+    assert result["fuel_surcharge"] == 0.0
+    assert result["total"] == 7.0
+
+
+def test_quote_with_surcharge_international():
+    # base quote: 24.0 + 1.25 * 4 = 29.0; 9.5% of 29.0 = 2.755, rounded to cents
+    result = rates.quote_with_surcharge(4, "international")
+    assert result["quote"] == 29.0
+    assert result["fuel_surcharge"] == pytest.approx(2.755, abs=0.01)
+
+
+def test_unknown_zone_raises_domain_error():
+    with pytest.raises(DomainError) as err:
+        rates.quote_with_surcharge(2, "moon")
+    assert err.value.code == "E_BAD_ZONE"
+
+
+@pytest.mark.parametrize("weight", [0, -1, -0.5])
+def test_non_positive_weight_raises_domain_error(weight):
+    with pytest.raises(DomainError) as err:
+        rates.quote_with_surcharge(weight, "local")
+    assert err.value.code == "E_BAD_WEIGHT"
