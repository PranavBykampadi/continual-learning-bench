+from decimal import Decimal
+
+from parcelo.errors import DomainError
+from parcelo.money import Money
+
 ZONE_BASE = {"local": 4.5, "national": 9.0, "international": 24.0}
 PER_KG = 1.25
 
+# Percentage off the regular quote, per customer tier.
+TIER_DISCOUNT_PCT = {"standard": 0, "gold": 10}
 
+
 def base_rate(zone):
     if zone not in ZONE_BASE:
         raise ValueError("unknown zone: %s" % zone)
@@ -12,3 +20,16 @@
     if weight_kg <= 0:
         raise ValueError("weight must be positive")
     return round(base_rate(zone) + PER_KG * weight_kg, 2)
+
+
+def discounted_quote(weight_kg, zone, tier):
+    """Regular quote minus the tier's percentage discount, as Money."""
+    if zone not in ZONE_BASE:
+        raise DomainError("E_BAD_ZONE", zone)
+    if tier not in TIER_DISCOUNT_PCT:
+        raise DomainError("E_BAD_INPUT", "unknown tier: %s" % tier)
+    if weight_kg <= 0:
+        raise DomainError("E_BAD_WEIGHT", str(weight_kg))
+    amount = Money.parse(quote(weight_kg, zone))
+    keep = Decimal(100 - TIER_DISCOUNT_PCT[tier]) / Decimal(100)
+    return amount.scale(keep)
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_discounted_quote.py b/tests/unit/test_discounted_quote.py
--- a/tests/unit/test_discounted_quote.py	1969-12-31 19:00:00
+++ b/tests/unit/test_discounted_quote.py	2026-11-12 01:58:08
@@ -0,0 +1,41 @@
+import pytest
+
+from parcelo import rates
+from parcelo.errors import DomainError
+from parcelo.money import Money
+
+
+def test_standard_tier_has_no_discount():
+    assert rates.discounted_quote(2, "local", "standard") == Money(700)
+
+
+def test_gold_tier_takes_10_percent_off():
+    # local 2kg regular quote is 7.00 -> 6.30
+    assert rates.discounted_quote(2, "local", "gold") == Money(630)
+
+
+def test_gold_tier_national():
+    # national 2kg regular quote is 11.50 -> 10.35
+    assert rates.discounted_quote(2, "national", "gold") == Money(1035)
+
+
+def test_returns_money():
+    assert isinstance(rates.discounted_quote(2, "local", "gold"), Money)
+
+
+def test_unknown_zone():
+    with pytest.raises(DomainError) as err:
+        rates.discounted_quote(2, "moon", "gold")
+    assert err.value.code == "E_BAD_ZONE"
+
+
+def test_unknown_tier():
+    with pytest.raises(DomainError) as err:
+        rates.discounted_quote(2, "local", "platinum")
+    assert err.value.code == "E_BAD_INPUT"
+
+
+def test_non_positive_weight():
+    with pytest.raises(DomainError) as err:
+        rates.discounted_quote(0, "local", "gold")
+    assert err.value.code == "E_BAD_WEIGHT"
