     if shipment_id not in db.shipments:
         raise DomainError("E_NOT_FOUND", shipment_id)
     return db.shipments[shipment_id]
+
+
+def mark_lost(shipment_id):
+    shipment = get_shipment(shipment_id)
+    if shipment.status == "delivered":
+        raise DomainError("E_BAD_STATE", shipment_id)
+    shipment.status = "lost"
+    events.emit("shipment.lost", shipment.id)
+    return shipment
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_mark_lost.py b/tests/unit/test_mark_lost.py
--- a/tests/unit/test_mark_lost.py	1969-12-31 19:00:00
+++ b/tests/unit/test_mark_lost.py	2026-11-12 02:06:50
@@ -0,0 +1,39 @@
+import pytest
+
+from parcelo import customers, events, shipments
+from parcelo.errors import DomainError
+
+
+def _new_shipment():
+    c = customers.add_customer("Acme")
+    return shipments.create_shipment(c.id, 2.0, "national")
+
+
+def test_mark_lost_sets_status_and_returns_shipment():
+    s = _new_shipment()
+    result = shipments.mark_lost(s.id)
+    assert result is s
+    assert result.status == "lost"
+    assert shipments.get_shipment(s.id).status == "lost"
+
+
+def test_mark_lost_emits_event():
+    s = _new_shipment()
+    shipments.mark_lost(s.id)
+    assert events.OUTBOX[-1]["name"] == "shipment.lost"
+    assert events.OUTBOX[-1]["entity_id"] == s.id
+
+
+def test_mark_lost_unknown_shipment_fails():
+    with pytest.raises(DomainError) as err:
+        shipments.mark_lost("shp_999999")
+    assert err.value.code == "E_NOT_FOUND"
+
+
+def test_mark_lost_delivered_shipment_fails():
+    s = _new_shipment()
+    s.status = "delivered"
+    with pytest.raises(DomainError) as err:
+        shipments.mark_lost(s.id)
+    assert err.value.code == "E_BAD_STATE"
+    assert s.status == "delivered"
