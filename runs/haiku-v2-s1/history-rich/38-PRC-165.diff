diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_reports.py b/tests/unit/test_reports.py
--- a/tests/unit/test_reports.py	1969-12-31 19:00:00
+++ b/tests/unit/test_reports.py	2026-11-12 02:14:00
@@ -0,0 +1,21 @@
+from parcelo import customers, invoices, reports, shipments
+
+
+def test_shipments_without_invoice_lists_only_uninvoiced_sorted_by_id():
+    c = customers.add_customer("Acme")
+    s1 = shipments.create_shipment(c.id, 1, "local")
+    s2 = shipments.create_shipment(c.id, 2, "local")
+    s3 = shipments.create_shipment(c.id, 3, "local")
+    invoices.issue_invoice(s2.id)
+
+    result = reports.shipments_without_invoice()
+
+    assert [s.id for s in result] == sorted([s1.id, s3.id])
+
+
+def test_shipments_without_invoice_empty_when_all_invoiced():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 1, "local")
+    invoices.issue_invoice(s.id)
+
+    assert reports.shipments_without_invoice() == []
