diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_refunds.py b/tests/unit/test_refunds.py
--- a/tests/unit/test_refunds.py	1969-12-31 19:00:00
+++ b/tests/unit/test_refunds.py	2026-11-12 01:53:37
@@ -0,0 +1,55 @@
+import pytest
+
+from parcelo import audit, customers, invoices, refunds, shipments, store
+from parcelo.errors import DomainError
+from parcelo.models import Refund
+from parcelo.money import Money
+
+
+@pytest.fixture
+def paid_invoice():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 2, "local")
+    inv = invoices.issue_invoice(s.id)
+    invoices.mark_paid(inv.id)
+    return inv
+
+
+def test_create_refund_stores_and_returns(paid_invoice):
+    r = refunds.create_refund(paid_invoice.id, "3.50")
+    assert isinstance(r, Refund)
+    assert r.id.startswith("RFD_")
+    assert r.invoice_id == paid_invoice.id
+    assert r.amount == Money.parse("3.50")
+    assert r.created_at is not None
+    assert store.db.refunds[r.id] is r
+
+
+def test_create_refund_records_audit(paid_invoice):
+    r = refunds.create_refund(paid_invoice.id, 1)
+    assert audit.LOG[-1]["action"] == "refund.created"
+    assert audit.LOG[-1]["entity_id"] == r.id
+
+
+def test_unknown_invoice_fails():
+    with pytest.raises(DomainError) as err:
+        refunds.create_refund("INV-missing", 1)
+    assert err.value.code == "E_NOT_FOUND"
+    assert store.db.refunds == {}
+
+
+def test_unpaid_invoice_fails():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 2, "local")
+    inv = invoices.issue_invoice(s.id)
+    with pytest.raises(DomainError) as err:
+        refunds.create_refund(inv.id, 1)
+    assert err.value.code == "E_BAD_STATE"
+    assert store.db.refunds == {}
+
+
+def test_non_positive_amount_fails(paid_invoice):
+    with pytest.raises(DomainError) as err:
+        refunds.create_refund(paid_invoice.id, 0)
+    assert err.value.code == "E_BAD_INPUT"
+    assert store.db.refunds == {}
