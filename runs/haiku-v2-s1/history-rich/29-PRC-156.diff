@@ -0,0 +1,7 @@
+"""Business thresholds and rates. Finance changes these; keep them all here."""
+
+# Parcels above this weight pay the heavy surcharge.
+HEAVY_THRESHOLD_KG = 30
+
+# Surcharge in dollars for each kilogram above HEAVY_THRESHOLD_KG.
+HEAVY_SURCHARGE_PER_KG = 0.75
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_rates_heavy.py b/tests/unit/test_rates_heavy.py
--- a/tests/unit/test_rates_heavy.py	1969-12-31 19:00:00
+++ b/tests/unit/test_rates_heavy.py	2026-11-12 02:08:41
@@ -0,0 +1,36 @@
+import pytest
+
+from parcelo import rates
+from parcelo.errors import DomainError
+from parcelo.money import Money
+
+
+def test_at_threshold_has_no_surcharge():
+    assert rates.heavy_quote(30, "local") == Money.parse(rates.quote(30, "local"))
+
+
+def test_below_threshold_is_normal_quote():
+    assert rates.heavy_quote(2, "local") == Money.parse(rates.quote(2, "local"))
+
+
+def test_surcharge_per_kg_above_threshold():
+    base = Money.parse(rates.quote(32, "national"))
+    assert rates.heavy_quote(32, "national") == base + Money(150)
+
+
+def test_fractional_excess_is_rounded():
+    base = Money.parse(rates.quote(30.5, "international"))
+    assert rates.heavy_quote(30.5, "international") == base + Money(38)
+
+
+def test_unknown_zone():
+    with pytest.raises(DomainError) as err:
+        rates.heavy_quote(10, "moon")
+    assert err.value.code == "E_BAD_ZONE"
+
+
+@pytest.mark.parametrize("weight", [0, -1])
+def test_non_positive_weight(weight):
+    with pytest.raises(DomainError) as err:
+        rates.heavy_quote(weight, "local")
+    assert err.value.code == "E_BAD_WEIGHT"
