 def open_invoices():
     return [i for i in db.invoices.values() if i.status == "open"]
+
+
+def _as_utc(moment):
+    # issue_invoice stores naive UTC timestamps; clock.now() is timezone-aware.
+    if moment.tzinfo is None:
+        return moment.replace(tzinfo=timezone.utc)
+    return moment
+
+
+def late_fee_for(invoice_id):
+    """Late fee accrued so far on an invoice, as Money.
+
+    The invoice is late 30 days after issue; from then on the fee is 1.5% of
+    the invoice amount for each day past those 30 days. Not late means zero.
+    """
+    if invoice_id not in db.invoices:
+        raise DomainError("E_NOT_FOUND", invoice_id)
+    invoice = db.invoices[invoice_id]
+    if invoice.issued_at is None:
+        raise DomainError("E_BAD_STATE", f"{invoice_id} has no issue date")
+    elapsed = _as_utc(clock.now()) - _as_utc(invoice.issued_at)
+    days_late = elapsed.days - LATE_AFTER_DAYS
+    if days_late <= 0:
+        return Money.zero()
+    return Money.parse(invoice.amount).scale(LATE_FEE_RATE_PER_DAY * days_late)
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_late_fee.py b/tests/unit/test_late_fee.py
--- a/tests/unit/test_late_fee.py	1969-12-31 19:00:00
+++ b/tests/unit/test_late_fee.py	2026-11-12 01:55:14
@@ -0,0 +1,69 @@
+from datetime import datetime, timedelta, timezone
+
+import pytest
+
+from parcelo import clock, customers, invoices, shipments
+from parcelo.errors import DomainError
+from parcelo.models import Invoice
+from parcelo.money import Money
+from parcelo.store import db
+
+ISSUED = datetime(2026, 1, 1, tzinfo=timezone.utc)
+
+
+def _invoice(amount=100.0, issued_at=ISSUED):
+    inv = Invoice(id="INV-TEST", shipment_id="shp_x", amount=amount, issued_at=issued_at)
+    db.invoices[inv.id] = inv
+    return inv
+
+
+def _at(days):
+    clock.set_fixed(ISSUED + timedelta(days=days))
+
+
+def test_not_late_on_day_30_is_zero():
+    _invoice()
+    _at(30)
+    assert invoices.late_fee_for("INV-TEST") == Money.zero()
+
+
+def test_zero_before_issue_window():
+    _invoice()
+    _at(5)
+    assert invoices.late_fee_for("INV-TEST") == Money.zero()
+
+
+def test_one_day_past_window_is_1_5_percent():
+    _invoice(amount=100.0)
+    _at(31)
+    assert invoices.late_fee_for("INV-TEST") == Money(150)
+
+
+def test_ten_days_past_window_is_15_percent():
+    _invoice(amount=100.0)
+    _at(40)
+    assert invoices.late_fee_for("INV-TEST").cents == 1500
+
+
+def test_fee_returns_money_not_float():
+    _invoice(amount=80.0)
+    _at(33)
+    fee = invoices.late_fee_for("INV-TEST")
+    assert isinstance(fee, Money)
+    assert fee.cents == 360  # 80 * 1.5% * 3 days
+
+
+def test_missing_invoice_raises():
+    with pytest.raises(DomainError) as err:
+        invoices.late_fee_for("INV-NOPE")
+    assert err.value.code == "E_NOT_FOUND"
+
+
+def test_invoice_from_issue_invoice_uses_naive_utc_timestamp():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 2, "local")
+    inv = invoices.issue_invoice(s.id)
+    clock.set_fixed(datetime.now(timezone.utc) + timedelta(days=32))
+    # 2 days past the window at 1.5% of the invoice amount
+    expected = Money.parse(inv.amount).scale(0.03)
+    assert invoices.late_fee_for(inv.id) == expected
