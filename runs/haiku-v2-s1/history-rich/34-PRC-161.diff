+"""Business thresholds and rates. Finance owns these values; keep them here."""
+
+# Volume rebate (PRC-161): share of a customer's paid invoices, by shipment count.
+REBATE_REGULAR_MIN_SHIPMENTS = 10
+REBATE_REGULAR_RATE = 0.03
+REBATE_BULK_MIN_SHIPMENTS = 50
+REBATE_BULK_RATE = 0.06
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_customers_rebate.py b/tests/unit/test_customers_rebate.py
--- a/tests/unit/test_customers_rebate.py	1969-12-31 19:00:00
+++ b/tests/unit/test_customers_rebate.py	2026-11-12 02:11:31
@@ -0,0 +1,63 @@
+import pytest
+
+from parcelo import customers, ids, shipments, store
+from parcelo.errors import DomainError
+from parcelo.models import Invoice
+from parcelo.money import Money
+
+
+def _add_invoice(shipment_id, amount, status):
+    inv = Invoice(
+        id=ids.new_id("inv"),
+        shipment_id=shipment_id,
+        amount=amount,
+        status=status,
+    )
+    store.db.invoices[inv.id] = inv
+    return inv
+
+
+def _customer_with_shipments(count):
+    c = customers.add_customer("Acme")
+    ships = [shipments.create_shipment(c.id, 1.0, "local") for _ in range(count)]
+    return c, ships
+
+
+def test_zero_below_ten_shipments():
+    c, ships = _customer_with_shipments(9)
+    _add_invoice(ships[0].id, 100.0, "paid")
+    assert customers.rebate_for(c.id) == Money.zero()
+
+
+def test_three_percent_from_ten_shipments():
+    c, ships = _customer_with_shipments(10)
+    _add_invoice(ships[0].id, 100.0, "paid")
+    assert customers.rebate_for(c.id) == Money(300)
+
+
+def test_six_percent_from_fifty_shipments():
+    c, ships = _customer_with_shipments(50)
+    _add_invoice(ships[0].id, 100.0, "paid")
+    assert customers.rebate_for(c.id) == Money(600)
+
+
+def test_only_paid_invoices_count():
+    c, ships = _customer_with_shipments(10)
+    _add_invoice(ships[0].id, 100.0, "paid")
+    _add_invoice(ships[1].id, 999.0, "open")
+    assert customers.rebate_for(c.id) == Money(300)
+
+
+def test_other_customers_invoices_ignored():
+    c, ships = _customer_with_shipments(10)
+    _add_invoice(ships[0].id, 100.0, "paid")
+    other = customers.add_customer("Other")
+    other_ship = shipments.create_shipment(other.id, 1.0, "local")
+    _add_invoice(other_ship.id, 5000.0, "paid")
+    assert customers.rebate_for(c.id) == Money(300)
+
+
+def test_unknown_customer_raises():
+    with pytest.raises(DomainError) as err:
+        customers.rebate_for("nope")
+    assert err.value.code == "E_UNKNOWN_CUSTOMER"
