diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_customer_credit_limit.py b/tests/unit/test_customer_credit_limit.py
--- a/tests/unit/test_customer_credit_limit.py	1969-12-31 19:00:00
+++ b/tests/unit/test_customer_credit_limit.py	2026-11-12 02:05:37
@@ -0,0 +1,55 @@
+import pytest
+
+from parcelo import customers, events
+from parcelo.errors import DomainError
+from parcelo.money import Money
+from parcelo.store import db
+
+
+def test_set_credit_limit_updates_and_returns_new_limit():
+    c = customers.add_customer("Acme")
+    limit = customers.set_credit_limit(c.id, 1200.50)
+    assert limit == Money(120050)
+    assert customers.get_customer(c.id).credit_limit == Money(120050)
+
+
+def test_set_credit_limit_accepts_money():
+    c = customers.add_customer("Acme")
+    limit = customers.set_credit_limit(c.id, Money(7500))
+    assert limit == Money(7500)
+
+
+def test_set_credit_limit_zero_is_allowed():
+    c = customers.add_customer("Acme")
+    assert customers.set_credit_limit(c.id, 0) == Money(0)
+
+
+def test_default_credit_limit_is_money():
+    c = customers.add_customer("Acme")
+    assert c.credit_limit == Money(50000)
+
+
+def test_set_credit_limit_emits_event():
+    c = customers.add_customer("Acme")
+    customers.set_credit_limit(c.id, 250)
+    event = events.OUTBOX[-1]
+    assert event["name"] == "customer.credit_limit_set"
+    assert event["entity_id"] == c.id
+    assert event["payload"] == {"limit_cents": 25000}
+
+
+def test_set_credit_limit_unknown_customer_fails():
+    with pytest.raises(DomainError) as err:
+        customers.set_credit_limit("nope", 100)
+    assert err.value.code == "E_UNKNOWN_CUSTOMER"
+    assert "nope" not in db.customers
+    assert events.OUTBOX == []
+
+
+def test_set_credit_limit_negative_amount_fails():
+    c = customers.add_customer("Acme")
+    with pytest.raises(DomainError) as err:
+        customers.set_credit_limit(c.id, -1)
+    assert err.value.code == "E_BAD_INPUT"
+    assert customers.get_customer(c.id).credit_limit == Money(50000)
+    assert events.OUTBOX == []
