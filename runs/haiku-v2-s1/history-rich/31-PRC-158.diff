diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_returns.py b/tests/unit/test_returns.py
--- a/tests/unit/test_returns.py	1969-12-31 19:00:00
+++ b/tests/unit/test_returns.py	2026-11-12 02:09:38
@@ -0,0 +1,64 @@
+import pytest
+
+from parcelo import clock, customers, events, returns, shipments, store
+from parcelo.errors import DomainError
+from parcelo.settings import MAX_RETURNS_PER_SHIPMENT
+
+
+def _delivered_shipment():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 2.0, "national")
+    s.status = "delivered"
+    return s
+
+
+def test_request_return_creates_and_stores_request():
+    clock.set_fixed("2026-11-12T10:00:00+00:00")
+    s = _delivered_shipment()
+    r = returns.request_return(s.id, "damaged")
+    assert r.id.startswith("ret_")
+    assert r.shipment_id == s.id
+    assert r.reason == "damaged"
+    assert r.requested_at == "2026-11-12T10:00:00+00:00"
+    assert store.db.returns[r.id] is r
+    assert events.OUTBOX[-1]["name"] == "return.requested"
+
+
+def test_returns_for_lists_sorted_by_id():
+    s = _delivered_shipment()
+    first = returns.request_return(s.id, "a")
+    second = returns.request_return(s.id, "b")
+    assert [r.id for r in returns.returns_for(s.id)] == [first.id, second.id]
+
+
+def test_returns_for_only_returns_matching_shipment():
+    s1 = _delivered_shipment()
+    s2 = _delivered_shipment()
+    returns.request_return(s1.id, "x")
+    assert returns.returns_for(s2.id) == []
+
+
+def test_unknown_shipment_fails():
+    with pytest.raises(DomainError) as err:
+        returns.request_return("shp_missing", "x")
+    assert err.value.code == "E_NOT_FOUND"
+
+
+def test_undelivered_shipment_fails():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 2.0, "national")
+    with pytest.raises(DomainError) as err:
+        returns.request_return(s.id, "x")
+    assert err.value.code == "E_BAD_STATE"
+    assert returns.returns_for(s.id) == []
+
+
+def test_limit_per_shipment():
+    s = _delivered_shipment()
+    assert MAX_RETURNS_PER_SHIPMENT == 3
+    for i in range(MAX_RETURNS_PER_SHIPMENT):
+        returns.request_return(s.id, f"r{i}")
+    with pytest.raises(DomainError) as err:
+        returns.request_return(s.id, "fourth")
+    assert err.value.code == "E_LIMIT"
+    assert len(returns.returns_for(s.id)) == MAX_RETURNS_PER_SHIPMENT
