+from decimal import ROUND_HALF_UP, Decimal
+
+from parcelo.errors import DomainError
+from parcelo.money import Money
+
 ZONE_BASE = {"local": 4.5, "national": 9.0, "international": 24.0}
 PER_KG = 1.25
 
+INSURANCE_PCT = Decimal("2")
+INSURANCE_MIN = Money(100)
+# Fuel surcharge percentages per zone. Copied here (not imported from
+# parcelo.legacy, which is scheduled for deletion).
+FUEL_SURCHARGE_PCT = {
+    "local": Decimal("0"),
+    "national": Decimal("4.0"),
+    "international": Decimal("9.5"),
+}
 
+
 def base_rate(zone):
     if zone not in ZONE_BASE:
         raise ValueError("unknown zone: %s" % zone)
@@ -12,3 +27,18 @@
     if weight_kg <= 0:
         raise ValueError("weight must be positive")
     return round(base_rate(zone) + PER_KG * weight_kg, 2)
+
+
+def insurance_fee(declared_value, zone):
+    """Insurance fee: 2% of declared value plus the zone's fuel surcharge %, minimum 1.00."""
+    if zone not in FUEL_SURCHARGE_PCT:
+        raise DomainError("E_BAD_ZONE", "unknown zone: %s" % zone)
+    value = Money.parse(declared_value)
+    if value.cents <= 0:
+        raise DomainError("E_BAD_INPUT", "declared value must be positive")
+    total_pct = INSURANCE_PCT + FUEL_SURCHARGE_PCT[zone]
+    cents = (Decimal(value.cents) * total_pct / Decimal(100)).quantize(
+        Decimal("1"), rounding=ROUND_HALF_UP
+    )
+    fee = Money(int(cents), value.currency)
+    return fee if fee.cents >= INSURANCE_MIN.cents else INSURANCE_MIN
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_insurance_fee.py b/tests/unit/test_insurance_fee.py
--- a/tests/unit/test_insurance_fee.py	1969-12-31 19:00:00
+++ b/tests/unit/test_insurance_fee.py	2026-11-12 02:02:26
@@ -0,0 +1,43 @@
+import pytest
+
+from parcelo import rates
+from parcelo.errors import DomainError
+from parcelo.money import Money
+
+
+def test_local_fee_is_two_percent():
+    assert rates.insurance_fee(Money(10000), "local") == Money(200)
+
+
+def test_national_fee_adds_fuel_surcharge():
+    assert rates.insurance_fee(Money(10000), "national") == Money(600)
+
+
+def test_international_fee_adds_fuel_surcharge():
+    assert rates.insurance_fee(Money(10000), "international") == Money(1150)
+
+
+def test_minimum_fee_applies():
+    # 2% of 10.00 is 0.20, below the 1.00 minimum
+    assert rates.insurance_fee(Money(1000), "local") == Money(100)
+
+
+def test_float_declared_value_is_accepted():
+    assert rates.insurance_fee(100.0, "national") == Money(600)
+
+
+def test_returns_money():
+    assert isinstance(rates.insurance_fee(50, "local"), Money)
+
+
+@pytest.mark.parametrize("value", [0, -5, -0.01])
+def test_non_positive_value_fails(value):
+    with pytest.raises(DomainError) as err:
+        rates.insurance_fee(value, "local")
+    assert err.value.code == "E_BAD_INPUT"
+
+
+def test_unknown_zone_fails():
+    with pytest.raises(DomainError) as err:
+        rates.insurance_fee(100, "moon")
+    assert err.value.code == "E_BAD_ZONE"
