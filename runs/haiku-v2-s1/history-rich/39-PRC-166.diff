diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_invoice_escalation.py b/tests/unit/test_invoice_escalation.py
--- a/tests/unit/test_invoice_escalation.py	1969-12-31 19:00:00
+++ b/tests/unit/test_invoice_escalation.py	2026-11-12 02:15:00
@@ -0,0 +1,70 @@
+import pytest
+
+from parcelo import customers, events, invoices, shipments
+from parcelo.errors import DomainError
+from parcelo.store import db
+
+
+def _invoice(weight_kg, zone, amount=None):
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, weight_kg, zone)
+    inv = invoices.issue_invoice(s.id)
+    if amount is not None:
+        inv.amount = amount
+    return inv
+
+
+def test_escalates_large_open_invoice():
+    inv = _invoice(400, "international")  # 524.00
+    result = invoices.escalate_invoice(inv.id)
+    assert result is inv
+    assert result.status == "escalated"
+    assert events.OUTBOX[-1]["name"] == "invoice.escalated"
+    assert events.OUTBOX[-1]["entity_id"] == inv.id
+
+
+def test_threshold_is_inclusive():
+    inv = _invoice(1, "local", amount=500.0)
+    assert invoices.escalate_invoice(inv.id).status == "escalated"
+
+
+def test_small_invoice_rejected():
+    inv = _invoice(2, "local")  # 7.00
+    with pytest.raises(DomainError) as err:
+        invoices.escalate_invoice(inv.id)
+    assert err.value.code == "E_BAD_STATE"
+    assert inv.status == "open"
+    assert not any(e["name"] == "invoice.escalated" for e in events.OUTBOX)
+
+
+def test_just_below_threshold_rejected():
+    inv = _invoice(1, "local", amount=499.99)
+    with pytest.raises(DomainError) as err:
+        invoices.escalate_invoice(inv.id)
+    assert err.value.code == "E_BAD_STATE"
+    assert inv.status == "open"
+
+
+def test_paid_invoice_rejected():
+    inv = _invoice(400, "international")
+    invoices.mark_paid(inv.id)
+    with pytest.raises(DomainError) as err:
+        invoices.escalate_invoice(inv.id)
+    assert err.value.code == "E_BAD_STATE"
+    assert inv.status == "paid"
+
+
+def test_unknown_invoice_fails():
+    with pytest.raises(DomainError) as err:
+        invoices.escalate_invoice("INV-missing")
+    assert err.value.code == "E_NOT_FOUND"
+
+
+def test_repeat_escalation_is_noop():
+    inv = _invoice(400, "international")
+    invoices.escalate_invoice(inv.id)
+    events_before = len(events.OUTBOX)
+    result = invoices.escalate_invoice(inv.id)
+    assert result.status == "escalated"
+    assert len(events.OUTBOX) == events_before
+    assert db.invoices[inv.id] is result
