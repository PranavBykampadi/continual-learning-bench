 def open_invoices():
     return [i for i in db.invoices.values() if i.status == "open"]
+
+
+def escalate_invoice(invoice_id):
+    if invoice_id not in db.invoices:
+        raise DomainError("E_NOT_FOUND", invoice_id)
+    invoice = db.invoices[invoice_id]
+    if invoice.status == "escalated":
+        # Already in the target state: return unchanged, no second event.
+        return invoice
+    if invoice.status != "open":
+        raise DomainError("E_BAD_STATE", f"invoice {invoice_id} is {invoice.status}, not open")
+    amount = Money.parse(invoice.amount)
+    if amount < ESCALATION_THRESHOLD:
+        raise DomainError("E_BAD_STATE", f"invoice {invoice_id} is below the escalation threshold")
+    invoice.status = "escalated"
+    events.emit("invoice.escalated", invoice.id, amount=str(amount))
+    return invoice
