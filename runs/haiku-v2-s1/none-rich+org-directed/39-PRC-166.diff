 def open_invoices():
     return [i for i in db.invoices.values() if i.status == "open"]
+
+
+def escalate_invoice(invoice_id: str) -> Invoice:
+    """Hand a large unpaid invoice over to the collections team.
+
+    Only open invoices of at least ESCALATION_MIN_AMOUNT can be escalated.
+
+    Args:
+        invoice_id: ID of the invoice to escalate.
+
+    Returns:
+        The escalated invoice.
+
+    Raises:
+        DomainError: E_NOT_FOUND if the invoice does not exist. E_BAD_STATE if
+            it is not open or is below ESCALATION_MIN_AMOUNT.
+    """
+    if invoice_id not in db.invoices:
+        raise DomainError("E_NOT_FOUND", invoice_id)
+    invoice = db.invoices[invoice_id]
+    if invoice.status != "open":
+        raise DomainError("E_BAD_STATE", f"invoice {invoice_id} is {invoice.status}")
+    if Money.parse(invoice.amount) < ESCALATION_MIN_AMOUNT:
+        raise DomainError("E_BAD_STATE", f"invoice {invoice_id} is below the escalation minimum")
+    invoice.status = "escalated"
+    events.emit("invoice.escalated", invoice.id)
+    return invoice
