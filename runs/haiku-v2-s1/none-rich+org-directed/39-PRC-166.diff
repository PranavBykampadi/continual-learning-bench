@@ -0,0 +1,6 @@
+"""Business thresholds and rates. Finance or product may ask us to change these."""
+
+from parcelo.money import Money
+
+# Open invoices at or above this amount can be escalated to collections.
+ESCALATION_MIN_AMOUNT = Money.parse("500.00")
