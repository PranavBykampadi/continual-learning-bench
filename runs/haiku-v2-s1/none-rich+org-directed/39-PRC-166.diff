-from parcelo import customers, invoices, shipments
+import pytest
 
+from parcelo import customers, events, invoices, shipments
+from parcelo.errors import DomainError
 
+
 def test_issue_and_pay():
     c = customers.add_customer("Acme")
     s = shipments.create_shipment(c.id, 2, "local")
     inv = invoices.issue_invoice(s.id)
     assert inv.amount == 7.0
     assert invoices.mark_paid(inv.id).status == "paid"
+
+
+def test_escalate_large_open_invoice():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 400, "local")  # 504.00
+    inv = invoices.issue_invoice(s.id)
+    out = invoices.escalate_invoice(inv.id)
+    assert out is inv
+    assert out.status == "escalated"
+    assert [e["name"] for e in events.OUTBOX] == ["shipment.created", "invoice.escalated"]
+    assert inv not in invoices.open_invoices()
+
+
+def test_escalate_at_threshold_is_allowed():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 396.4, "local")  # 4.5 + 1.25 * 396.4 = 500.00
+    inv = invoices.issue_invoice(s.id)
+    assert inv.amount == 500.0
+    assert invoices.escalate_invoice(inv.id).status == "escalated"
+
+
+def test_escalate_small_invoice_fails():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 2, "local")  # 7.00
+    inv = invoices.issue_invoice(s.id)
+    with pytest.raises(DomainError) as exc:
+        invoices.escalate_invoice(inv.id)
+    assert exc.value.code == "E_BAD_STATE"
+    assert inv.status == "open"
+
+
+def test_escalate_paid_invoice_fails():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 400, "local")
+    inv = invoices.issue_invoice(s.id)
+    invoices.mark_paid(inv.id)
+    with pytest.raises(DomainError) as exc:
+        invoices.escalate_invoice(inv.id)
+    assert exc.value.code == "E_BAD_STATE"
+    assert inv.status == "paid"
+
+
+def test_escalate_missing_invoice_fails():
+    with pytest.raises(DomainError) as exc:
+        invoices.escalate_invoice("INV-missing")
+    assert exc.value.code == "E_NOT_FOUND"
