+def customers_by_tier(tier: str) -> list[Customer]:
+    """Return all customers on the given tier.
+
+    Args:
+        tier: One of the values in ``TIERS``.
+
+    Returns:
+        A list of matching customers, empty if there are none.
+
+    Raises:
+        DomainError: With code ``E_BAD_INPUT`` if ``tier`` is not a known tier.
+    """
+    if tier not in TIERS:
+        raise DomainError("E_BAD_INPUT", f"unknown tier: {tier}")
+    return [c for c in db.customers.values() if c.tier == tier]
 
 
