diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_customers.py b/tests/unit/test_customers.py
--- a/tests/unit/test_customers.py	1969-12-31 19:00:00
+++ b/tests/unit/test_customers.py	2026-11-12 02:23:28
@@ -0,0 +1,34 @@
+import pytest
+
+from parcelo import audit, customers
+from parcelo.errors import DomainError
+from parcelo.models import Customer
+from parcelo.store import db
+
+
+def test_new_customer_is_not_locked():
+    customer = customers.add_customer("Acme")
+    assert customer.locked is False
+
+
+def test_lock_customer_sets_flag_and_returns_customer():
+    customer = customers.add_customer("Acme")
+    result = customers.lock_customer(customer.id)
+    assert result is customer
+    assert db.customers[customer.id].locked is True
+
+
+def test_lock_customer_records_audit_entry():
+    customer = customers.add_customer("Acme")
+    audit.LOG.clear()
+    customers.lock_customer(customer.id)
+    assert [e["action"] for e in audit.LOG] == ["customer.locked"]
+    assert audit.LOG[0]["entity_id"] == customer.id
+
+
+def test_lock_unknown_customer_fails():
+    with pytest.raises(DomainError) as exc:
+        customers.lock_customer("C000000")
+    assert exc.value.code == "E_NOT_FOUND"
+    assert "C000000" not in db.customers
+    assert audit.LOG == []
