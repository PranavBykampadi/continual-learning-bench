+++ b/tests/test_reports.py	2026-11-12 02:24:45
@@ -0,0 +1,27 @@
+from parcelo import customers, invoices, reports, shipments
+
+
+def test_shipments_without_invoice_lists_only_uninvoiced():
+    c = customers.add_customer("Acme")
+    invoiced = shipments.create_shipment(c.id, 2, "local")
+    bare = shipments.create_shipment(c.id, 3, "national")
+    invoices.issue_invoice(invoiced.id)
+
+    assert [s.id for s in reports.shipments_without_invoice()] == [bare.id]
+
+
+def test_shipments_without_invoice_empty_when_all_invoiced():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 2, "local")
+    invoices.issue_invoice(s.id)
+
+    assert reports.shipments_without_invoice() == []
+
+
+def test_shipments_without_invoice_counts_each_shipment_once():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 2, "local")
+    invoices.issue_invoice(s.id)
+    invoices.issue_invoice(s.id)
+
+    assert reports.shipments_without_invoice() == []
