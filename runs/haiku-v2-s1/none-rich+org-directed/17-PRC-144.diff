     return round(base_rate(zone) + PER_KG * weight_kg, 2)
+
+
+def insurance_fee(declared_value, zone):
+    """Insurance fee for a shipment with a declared value.
+
+    Args:
+        declared_value: Dollar value of the goods (float, int, str or Decimal).
+        zone: One of the zones in FUEL_SURCHARGE_PCT.
+
+    Returns:
+        Money: 2% of the declared value plus the zone's fuel surcharge
+        percentage of the declared value, rounded to the cent once, and
+        never less than 1.00.
+
+    Raises:
+        DomainError: E_BAD_ZONE for an unknown zone, E_BAD_INPUT for a
+            declared value that is zero or negative.
+    """
+    if zone not in FUEL_SURCHARGE_PCT:
+        raise DomainError("E_BAD_ZONE", f"unknown zone: {zone}")
+    value = Money.parse(declared_value)
+    if value.cents <= 0:
+        raise DomainError("E_BAD_INPUT", "declared value must be positive")
+    rate = INSURANCE_RATE + Decimal(str(FUEL_SURCHARGE_PCT[zone])) / Decimal(100)
+    fee = value.scale(rate)
+    return INSURANCE_MIN_FEE if fee < INSURANCE_MIN_FEE else fee
