+
+
+def test_insurance_fee_percentages():
+    # 2% plus fuel surcharge: local 2%, national 6%, international 11.5%
+    assert rates.insurance_fee(1000, "local") == Money(2000)
+    assert rates.insurance_fee(1000, "national") == Money(6000)
+    assert rates.insurance_fee(1000, "international") == Money(11500)
+
+
+def test_insurance_fee_minimum():
+    assert rates.insurance_fee(10, "local") == Money(100)
+    assert rates.insurance_fee("0.01", "international") == Money(100)
+
+
+def test_insurance_fee_rounds_once_at_the_end():
+    # 1234.56 * 0.02 = 24.6912 -> 24.69
+    assert rates.insurance_fee(1234.56, "local") == Money(2469)
+
+
+def test_insurance_fee_accepts_money_and_strings():
+    assert rates.insurance_fee(Money(100000), "national") == Money(6000)
+    assert rates.insurance_fee("1000.00", "local") == Money(2000)
+
+
+def test_insurance_fee_unknown_zone():
+    with pytest.raises(DomainError) as exc:
+        rates.insurance_fee(100, "moon")
+    assert exc.value.code == "E_BAD_ZONE"
+
+
+@pytest.mark.parametrize("value", [0, -5, "0", -0.01])
+def test_insurance_fee_rejects_non_positive_value(value):
+    with pytest.raises(DomainError) as exc:
+        rates.insurance_fee(value, "local")
