diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/parcelo/vouchers.py b/parcelo/vouchers.py
--- a/parcelo/vouchers.py	1969-12-31 19:00:00
+++ b/parcelo/vouchers.py	2026-11-12 02:24:09
@@ -0,0 +1,31 @@
+from parcelo import clock, ids
+from parcelo.errors import DomainError
+from parcelo.models import Voucher
+from parcelo.money import Money
+from parcelo.store import db
+
+# Largest single goodwill voucher, in cents (150.00).
+MAX_VOUCHER = Money.parse("150.00")
+
+
+def issue_voucher(customer_id, amount):
+    """Issue a goodwill voucher to an existing customer.
+
+    `amount` may be a Money, or a float/int/str/Decimal dollar amount, which is
+    converted to Money at this edge.
+    """
+    if customer_id not in db.customers:
+        raise DomainError("E_UNKNOWN_CUSTOMER", customer_id)
+    money = Money.parse(amount)
+    if money.cents <= 0:
+        raise DomainError("E_BAD_INPUT", str(money))
+    if MAX_VOUCHER < money:
+        raise DomainError("E_LIMIT", f"{money} exceeds {MAX_VOUCHER}")
+    voucher = Voucher(
+        id=ids.new_id("vch"),
+        customer_id=customer_id,
+        amount=money,
+        issued_at=clock.now(),
+    )
+    db.vouchers[voucher.id] = voucher
+    return voucher
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_vouchers.py b/tests/unit/test_vouchers.py
--- a/tests/unit/test_vouchers.py	1969-12-31 19:00:00
+++ b/tests/unit/test_vouchers.py	2026-11-12 02:24:14
@@ -0,0 +1,59 @@
+import pytest
+
+from parcelo import store, vouchers
+from parcelo.errors import DomainError
+from parcelo.models import Customer
+from parcelo.money import Money
+
+
+@pytest.fixture
+def customer():
+    c = Customer(id="C1", name="Acme")
+    store.db.customers[c.id] = c
+    return c
+
+
+def test_issue_voucher_saves_and_returns(customer):
+    v = vouchers.issue_voucher("C1", "25.50")
+    assert v.customer_id == "C1"
+    assert v.amount == Money(2550)
+    assert v.issued_at is not None
+    assert store.db.vouchers[v.id] is v
+
+
+def test_float_amount_is_converted_to_cents(customer):
+    v = vouchers.issue_voucher("C1", 0.1 + 0.2)
+    assert v.amount == Money(30)
+
+
+def test_exact_cap_is_allowed(customer):
+    v = vouchers.issue_voucher("C1", 150)
+    assert v.amount == Money(15000)
+
+
+def test_over_cap_is_rejected(customer):
+    with pytest.raises(DomainError) as err:
+        vouchers.issue_voucher("C1", "150.01")
+    assert err.value.code == "E_LIMIT"
+    assert store.db.vouchers == {}
+
+
+@pytest.mark.parametrize("amount", [0, -5, "0.00", "-0.01"])
+def test_zero_or_negative_rejected(customer, amount):
+    with pytest.raises(DomainError) as err:
+        vouchers.issue_voucher("C1", amount)
+    assert err.value.code == "E_BAD_INPUT"
+    assert store.db.vouchers == {}
+
+
+def test_unknown_customer_rejected():
+    with pytest.raises(DomainError) as err:
+        vouchers.issue_voucher("nope", 10)
+    assert err.value.code == "E_UNKNOWN_CUSTOMER"
+    assert store.db.vouchers == {}
+
+
+def test_reset_clears_vouchers(customer):
+    vouchers.issue_voucher("C1", 10)
+    store.reset()
+    assert store.db.vouchers == {}
