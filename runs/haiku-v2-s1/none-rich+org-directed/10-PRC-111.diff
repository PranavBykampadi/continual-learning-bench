     if shipment_id not in db.shipments:
         raise DomainError("E_NOT_FOUND", shipment_id)
     return db.shipments[shipment_id]
+
+
+def add_note(shipment_id: str, text: str) -> Shipment:
+    """Append a timestamped note to a shipment.
+
+    Args:
+        shipment_id: ID of the shipment to annotate.
+        text: Note body. Must contain non-whitespace characters.
+
+    Returns:
+        The updated Shipment.
+
+    Raises:
+        DomainError: E_NOT_FOUND if the shipment does not exist, or
+            E_BAD_INPUT if text is empty or whitespace-only.
+    """
+    shipment = get_shipment(shipment_id)
+    if not isinstance(text, str) or not text.strip():
+        raise DomainError("E_BAD_INPUT", "note text must not be empty")
+    shipment.notes.append({"text": text, "at": clock.now()})
+    audit.record("shipment.note_added", shipment.id)
+    return shipment
