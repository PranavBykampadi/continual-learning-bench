+
+
+def test_add_note_appends_timestamped_note():
+    moment = datetime(2026, 11, 12, 9, 30, tzinfo=timezone.utc)
+    clock.set_fixed(moment)
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 1.5, "national")
+    result = shipments.add_note(s.id, "left at back door")
+    assert result is s
+    assert s.notes == [{"text": "left at back door", "at": moment}]
+    assert audit.LOG[-1]["action"] == "shipment.note_added"
+
+
+def test_add_note_unknown_shipment():
+    with pytest.raises(DomainError) as err:
+        shipments.add_note("shp_missing", "hello")
+    assert err.value.code == "E_NOT_FOUND"
+
+
+@pytest.mark.parametrize("text", ["", "   "])
+def test_add_note_empty_text(text):
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 1.5, "national")
+    with pytest.raises(DomainError) as err:
+        shipments.add_note(s.id, text)
+    assert err.value.code == "E_BAD_INPUT"
+    assert s.notes == []
