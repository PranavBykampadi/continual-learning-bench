@@ -1,3 +1,5 @@
+import pytest
+
 from parcelo import customers, invoices, shipments
 
 
@@ -7,3 +9,24 @@
     inv = invoices.issue_invoice(s.id)
     assert inv.amount == 7.0
     assert invoices.mark_paid(inv.id).status == "paid"
+
+
+def test_invoices_by_status():
+    c = customers.add_customer("Acme")
+    s1 = shipments.create_shipment(c.id, 2, "local")
+    s2 = shipments.create_shipment(c.id, 2, "local")
+    paid = invoices.issue_invoice(s1.id)
+    open_inv = invoices.issue_invoice(s2.id)
+    invoices.mark_paid(paid.id)
+
+    assert invoices.invoices_by_status("paid") == [paid]
+    assert invoices.invoices_by_status("open") == [open_inv]
+
+
+def test_invoices_by_status_empty():
+    assert invoices.invoices_by_status("paid") == []
+
+
+def test_invoices_by_status_rejects_unknown_status():
+    with pytest.raises(ValueError):
+        invoices.invoices_by_status("void")
