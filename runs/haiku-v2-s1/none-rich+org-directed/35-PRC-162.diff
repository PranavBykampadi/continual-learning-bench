diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/parcelo/invoices.py b/parcelo/invoices.py
--- a/parcelo/invoices.py	2026-11-10 12:17:53
+++ b/parcelo/invoices.py	2026-11-12 02:23:00
@@ -32,3 +32,23 @@
 
 def open_invoices():
     return [i for i in db.invoices.values() if i.status == "open"]
+
+
+VALID_STATUSES = ("open", "paid")
+
+
+def invoices_by_status(status):
+    """List invoices in the given status.
+
+    Args:
+        status: "open" or "paid".
+
+    Returns:
+        The matching invoices, or an empty list if there are none.
+
+    Raises:
+        ValueError: If status is not "open" or "paid".
+    """
+    if status not in VALID_STATUSES:
+        raise ValueError(f"bad invoice status: {status}")
+    return [i for i in db.invoices.values() if i.status == status]
