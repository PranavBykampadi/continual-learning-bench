+def rebate_for(customer_id: str) -> Money:
+    """Return the volume rebate a customer has earned on their paid invoices.
+
+    The rebate is zero below REBATE_MIN_SHIPMENTS shipments, REBATE_RATE of the
+    paid total from REBATE_MIN_SHIPMENTS up, and REBATE_BULK_RATE of the paid
+    total from REBATE_BULK_MIN_SHIPMENTS up.
+
+    Args:
+        customer_id: ID of the customer.
+
+    Returns:
+        The rebate as Money, rounded half up to the cent.
+
+    Raises:
+        DomainError: If the customer does not exist (E_UNKNOWN_CUSTOMER).
+    """
+    if customer_id not in db.customers:
+        raise DomainError("E_UNKNOWN_CUSTOMER", customer_id)
+
+    shipment_ids = set()
+    for shipment in db.shipments.values():
+        if shipment.customer_id == customer_id:
+            shipment_ids.add(shipment.id)
+    shipment_count = len(shipment_ids)
+
+    if shipment_count >= settings.REBATE_BULK_MIN_SHIPMENTS:
+        rate = settings.REBATE_BULK_RATE
+    elif shipment_count >= settings.REBATE_MIN_SHIPMENTS:
+        rate = settings.REBATE_RATE
+    else:
+        return Money.zero()
+
+    paid_total = Money.zero()
+    for invoice in db.invoices.values():
+        if invoice.shipment_id in shipment_ids and invoice.status == "paid":
+            paid_total = paid_total + Money.parse(invoice.amount)
+    return paid_total.scale(rate)
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/parcelo/settings.py b/parcelo/settings.py
