+++ b/parcelo/settings.py	2026-11-12 02:22:18
@@ -0,0 +1,9 @@
+"""Business thresholds and rates. Finance or product may ask us to change these."""
+
+# Volume rebate: customers need this many shipments to earn a rebate at all.
+REBATE_MIN_SHIPMENTS = 10
+# Customers with at least this many shipments earn the bulk rebate rate.
+REBATE_BULK_MIN_SHIPMENTS = 50
+# Rebate rates, as a fraction of the customer's total paid invoices.
+REBATE_RATE = 0.03
+REBATE_BULK_RATE = 0.06
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/test_rebates.py b/tests/test_rebates.py
--- a/tests/test_rebates.py	1969-12-31 19:00:00
+++ b/tests/test_rebates.py	2026-11-12 02:22:28
@@ -0,0 +1,44 @@
+import pytest
+
+from parcelo import customers, invoices, shipments
+from parcelo.errors import DomainError
+from parcelo.money import Money
+
+
+def _paid_shipments(customer_id, count):
+    for _ in range(count):
+        s = shipments.create_shipment(customer_id, 1, "local")  # quotes 5.75
+        invoices.mark_paid(invoices.issue_invoice(s.id).id)
+
+
+def test_no_rebate_below_ten_shipments():
+    c = customers.add_customer("Small")
+    _paid_shipments(c.id, 9)
+    assert customers.rebate_for(c.id) == Money.zero()
+
+
+def test_three_percent_from_ten_shipments():
+    c = customers.add_customer("Regular")
+    _paid_shipments(c.id, 10)  # paid total 57.50 -> 3% = 1.725 -> 1.73
+    assert customers.rebate_for(c.id) == Money(173)
+
+
+def test_six_percent_from_fifty_shipments():
+    c = customers.add_customer("Bulk")
+    _paid_shipments(c.id, 50)  # paid total 287.50 -> 6% = 17.25
+    assert customers.rebate_for(c.id) == Money(1725)
+
+
+def test_unpaid_invoices_do_not_count():
+    c = customers.add_customer("Open")
+    _paid_shipments(c.id, 10)
+    for _ in range(5):
+        s = shipments.create_shipment(c.id, 1, "local")
+        invoices.issue_invoice(s.id)  # left open
+    assert customers.rebate_for(c.id) == Money(173)
+
+
+def test_unknown_customer_fails():
+    with pytest.raises(DomainError) as err:
+        customers.rebate_for("nope")
+    assert err.value.code == "E_UNKNOWN_CUSTOMER"
