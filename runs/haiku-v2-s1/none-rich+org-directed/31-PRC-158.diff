@@ -0,0 +1,59 @@
+import pytest
+
+from parcelo import customers, events, returns, shipments
+from parcelo.errors import DomainError
+from parcelo.settings import MAX_RETURNS_PER_SHIPMENT
+from parcelo.store import db
+
+
+def _delivered_shipment():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 1.5, "national")
+    s.status = "delivered"
+    return s
+
+
+def test_request_return_stores_and_emits():
+    s = _delivered_shipment()
+    r = returns.request_return(s.id, "damaged")
+    assert r.id.startswith("ret_")
+    assert r.shipment_id == s.id
+    assert r.reason == "damaged"
+    assert r.requested_at is not None
+    assert db.returns[r.id] is r
+    assert events.OUTBOX[-1]["name"] == "return.requested"
+
+
+def test_returns_for_lists_only_that_shipment():
+    s1 = _delivered_shipment()
+    s2 = _delivered_shipment()
+    r1 = returns.request_return(s1.id, "a")
+    returns.request_return(s2.id, "b")
+    assert returns.returns_for(s1.id) == [r1]
+    assert returns.returns_for("shp_missing") == []
+
+
+def test_unknown_shipment_fails():
+    with pytest.raises(DomainError) as err:
+        returns.request_return("shp_missing", "x")
+    assert err.value.code == "E_NOT_FOUND"
+
+
+def test_undelivered_shipment_fails():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 1.5, "national")
+    with pytest.raises(DomainError) as err:
+        returns.request_return(s.id, "x")
+    assert err.value.code == "E_BAD_STATE"
+    assert returns.returns_for(s.id) == []
+
+
+def test_limit_per_shipment():
+    assert MAX_RETURNS_PER_SHIPMENT == 3
