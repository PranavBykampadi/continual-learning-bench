 def test_quote_local():
@@ -10,3 +12,38 @@
 def test_unknown_zone():
     with pytest.raises(ValueError):
         rates.base_rate("moon")
+
+
+def test_quote_with_surcharge_national():
+    # base quote 9.0 + 1.25 * 2 = 11.50; 4% surcharge = 0.46
+    result = rates.quote_with_surcharge(2, "national")
+    assert result["quote"] == Money(1150)
+    assert result["surcharge"] == Money(46)
+    assert result["total"] == Money(1196)
+
+
+def test_quote_with_surcharge_local_has_no_surcharge():
+    result = rates.quote_with_surcharge(2, "local")
+    assert result["surcharge"] == Money(0)
+    assert result["total"] == result["quote"] == Money(700)
+
+
+def test_quote_with_surcharge_matches_legacy_percentage():
+    from parcelo.legacy.billing import fuel_surcharge
+
+    base = rates.quote(3, "international")
+    expected = Money.parse(fuel_surcharge(base, "international"))
+    assert rates.quote_with_surcharge(3, "international")["surcharge"] == expected
+
+
+def test_quote_with_surcharge_unknown_zone():
+    with pytest.raises(DomainError) as exc:
+        rates.quote_with_surcharge(2, "moon")
+    assert exc.value.code == "E_BAD_ZONE"
+
+
+@pytest.mark.parametrize("weight", [0, -1])
+def test_quote_with_surcharge_bad_weight(weight):
