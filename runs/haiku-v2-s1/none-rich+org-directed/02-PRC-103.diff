diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/parcelo/rates.py b/parcelo/rates.py
--- a/parcelo/rates.py	2026-11-10 12:17:53
+++ b/parcelo/rates.py	2026-11-12 01:53:17
@@ -1,3 +1,7 @@
+from parcelo.errors import DomainError
+from parcelo.legacy.billing import FUEL_SURCHARGE_PCT
+from parcelo.money import Money
+
 ZONE_BASE = {"local": 4.5, "national": 9.0, "international": 24.0}
 PER_KG = 1.25
 
@@ -12,3 +16,18 @@
     if weight_kg <= 0:
         raise ValueError("weight must be positive")
     return round(base_rate(zone) + PER_KG * weight_kg, 2)
+
+
+def quote_with_surcharge(weight_kg, zone):
+    """Quote plus the zone's fuel surcharge, as Money.
+
+    Returns a dict with "quote" (base price), "surcharge" and "total".
+    The surcharge is rounded to the cent once, here.
+    """
+    if zone not in ZONE_BASE:
+        raise DomainError("E_BAD_ZONE", "unknown zone: %s" % zone)
+    if weight_kg <= 0:
+        raise DomainError("E_BAD_WEIGHT", "weight must be positive")
+    base = Money.parse(quote(weight_kg, zone))
+    surcharge = base.scale(FUEL_SURCHARGE_PCT[zone] / 100.0)
+    return {"quote": base, "surcharge": surcharge, "total": base + surcharge}
