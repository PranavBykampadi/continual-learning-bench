+from parcelo import customers, reports, shipments
+from parcelo.store import db
+
+
+def test_volume_report_includes_customers_without_shipments():
+    c = customers.add_customer("Idle Co")
+    report = reports.volume_report()
+    assert report == {c.id: {"shipments": 0, "tier": "starter"}}
+
+
+def test_volume_report_counts_shipments_per_customer():
+    a = customers.add_customer("Acme")
+    b = customers.add_customer("Bolt")
+    for _ in range(3):
+        shipments.create_shipment(a.id, 1, "local")
+    shipments.create_shipment(b.id, 1, "national")
+    report = reports.volume_report()
+    assert report[a.id] == {"shipments": 3, "tier": "starter"}
+    assert report[b.id] == {"shipments": 1, "tier": "starter"}
+
+
+def test_volume_report_tier_thresholds():
+    c = customers.add_customer("Thresholds")
+    tiers = {}
+    for n in (9, 10, 49, 50):
+        db.shipments.clear()
+        for _ in range(n):
+            shipments.create_shipment(c.id, 1, "local")
+        tiers[n] = reports.volume_report()[c.id]["tier"]
+    assert tiers == {9: "starter", 10: "regular", 49: "regular", 50: "bulk"}
