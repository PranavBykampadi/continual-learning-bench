 from datetime import datetime
 
+from parcelo import settings
 from parcelo.store import db
+
+
+def _volume_tier(shipment_count: int) -> str:
+    """Return the volume tier label for a shipment count.
+
+    Args:
+        shipment_count: Number of shipments the customer has.
+
+    Returns:
+        "bulk", "regular", or "starter".
+    """
+    if shipment_count >= settings.VOLUME_BULK_MIN_SHIPMENTS:
+        return "bulk"
+    if shipment_count >= settings.VOLUME_REGULAR_MIN_SHIPMENTS:
+        return "regular"
+    return "starter"
+
+
+def volume_report() -> dict:
+    """Build a per-customer shipment count and volume tier.
+
+    Every customer is included, including customers with no shipments.
+
+    Returns:
+        A dict keyed by customer id, where each value is
+        {"shipments": <count>, "tier": <label>}.
+    """
+    counts = {customer_id: 0 for customer_id in db.customers}
+    for shipment in db.shipments.values():
+        if shipment.customer_id in counts:
+            counts[shipment.customer_id] += 1
+    return {
+        customer_id: {"shipments": count, "tier": _volume_tier(count)}
+        for customer_id, count in counts.items()
+    }
 
 
