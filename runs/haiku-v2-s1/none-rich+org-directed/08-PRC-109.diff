diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_customers.py b/tests/unit/test_customers.py
--- a/tests/unit/test_customers.py	1969-12-31 19:00:00
+++ b/tests/unit/test_customers.py	2026-11-12 01:59:54
@@ -0,0 +1,42 @@
+import pytest
+
+from parcelo import audit, customers
+from parcelo.errors import DomainError
+from parcelo.models import Address
+from parcelo.store import db
+
+
+def test_add_address_stores_and_returns_address():
+    customer = customers.add_customer("Acme")
+    address = customers.add_address(customer.id, "1 Main St", "Springfield")
+
+    assert isinstance(address, Address)
+    assert address.customer_id == customer.id
+    assert address.line == "1 Main St"
+    assert address.city == "Springfield"
+    assert address.id.startswith("adr_")
+    assert db.addresses[address.id] is address
+
+
+def test_add_address_records_audit_entry():
+    customer = customers.add_customer("Acme")
+    address = customers.add_address(customer.id, "1 Main St", "Springfield")
+
+    assert audit.LOG[-1]["action"] == "address.created"
+    assert audit.LOG[-1]["entity_id"] == address.id
+
+
+def test_add_address_unknown_customer_fails():
+    with pytest.raises(DomainError) as exc:
+        customers.add_address("C_missing", "1 Main St", "Springfield")
+    assert exc.value.code == "E_UNKNOWN_CUSTOMER"
+    assert db.addresses == {}
+
+
+@pytest.mark.parametrize("line, city", [("", "Springfield"), ("1 Main St", "")])
+def test_add_address_empty_fields_fail(line, city):
+    customer = customers.add_customer("Acme")
+    with pytest.raises(DomainError) as exc:
+        customers.add_address(customer.id, line, city)
+    assert exc.value.code == "E_BAD_INPUT"
+    assert db.addresses == {}
