+def split_shipment(shipment_id: str, weights: Sequence[float]) -> list[Shipment]:
+    """Replace a shipment with one new shipment per weight.
+
+    The original shipment is marked with status "split". Each new shipment
+    keeps the original's customer and zone.
+
+    Args:
+        shipment_id: Id of the shipment to split. Must be in status "created".
+        weights: Weight in kg for each new shipment. Must add up to the
+            original shipment's weight.
+
+    Returns:
+        The new shipments, in the same order as ``weights``.
+
+    Raises:
+        DomainError: E_NOT_FOUND if the shipment does not exist, E_BAD_STATE if
+            it is not in status "created", E_BAD_WEIGHT if any weight is zero or
+            negative, E_BAD_INPUT if no weights are given or they do not add up
+            to the original weight. Nothing is changed when this raises.
+    """
+    shipment = get_shipment(shipment_id)
+    if shipment.status != "created":
+        raise DomainError("E_BAD_STATE", f"{shipment_id} is {shipment.status}")
+    weights = list(weights)
+    if not weights:
+        raise DomainError("E_BAD_INPUT", "no weights given")
+    for weight in weights:
+        if weight <= 0:
+            raise DomainError("E_BAD_WEIGHT", str(weight))
+    total = math.fsum(weights)
+    if abs(total - shipment.weight_kg) > WEIGHT_TOLERANCE_KG:
+        raise DomainError(
+            "E_BAD_INPUT",
+            f"weights sum to {total}, expected {shipment.weight_kg}",
+        )
+
+    new_shipments = []
+    for weight in weights:
+        new = Shipment(
+            id=ids.new_id("shp"),
+            customer_id=shipment.customer_id,
+            weight_kg=weight,
+            zone=shipment.zone,
+            created_at=clock.now(),
+        )
+        db.shipments[new.id] = new
+        events.emit("shipment.created", new.id, zone=new.zone)
+        new_shipments.append(new)
+
+    shipment.status = "split"
+    events.emit("shipment.split", shipment_id, into=[s.id for s in new_shipments])
+    return new_shipments
