+def _created(weight=10.0, zone="national"):
+    c = customers.add_customer("Acme")
+    return shipments.create_shipment(c.id, weight, zone)
+
+
+def test_split_returns_new_shipments_in_order():
+    original = _created(10.0, "international")
+    parts = shipments.split_shipment(original.id, [3.0, 4.5, 2.5])
+    assert [p.weight_kg for p in parts] == [3.0, 4.5, 2.5]
+    for p in parts:
+        assert p.id != original.id
+        assert p.customer_id == original.customer_id
+        assert p.zone == "international"
+        assert p.status == "created"
+        assert shipments.get_shipment(p.id) is p
+    assert shipments.get_shipment(original.id).status == "split"
+
+
+def test_split_emits_events():
+    original = _created(4.0)
+    parts = shipments.split_shipment(original.id, [1.0, 3.0])
+    names = [e["name"] for e in events.OUTBOX]
+    assert names[-3:] == ["shipment.created", "shipment.created", "shipment.split"]
+    split_event = events.OUTBOX[-1]
+    assert split_event["entity_id"] == original.id
+    assert split_event["payload"]["into"] == [p.id for p in parts]
+
+
+def test_split_tolerates_float_drift():
+    original = _created(0.3)
+    parts = shipments.split_shipment(original.id, [0.1, 0.2])
+    assert len(parts) == 2
+
