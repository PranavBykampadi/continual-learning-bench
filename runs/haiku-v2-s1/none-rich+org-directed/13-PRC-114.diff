@@ -0,0 +1,70 @@
+from datetime import datetime, timedelta, timezone
+
+from parcelo import clock, reports
+from parcelo.models import Invoice
+from parcelo.store import db
+
+NOW = datetime(2026, 11, 12, 12, 0, tzinfo=timezone.utc)
+
+
+def _add(inv_id, amount, days_old, status="open", naive=False):
+    issued = NOW - timedelta(days=days_old)
+    if naive:
+        issued = issued.replace(tzinfo=None)
+    db.invoices[inv_id] = Invoice(
+        id=inv_id,
+        shipment_id="S",
+        amount=amount,
+        status=status,
+        issued_at=issued,
+    )
+
+
+def test_empty_report_is_all_zero():
+    clock.set_fixed(NOW)
+    assert reports.aging_report() == {"0-30": 0.0, "31-60": 0.0, "60+": 0.0}
+
+
+def test_bucket_boundaries():
+    clock.set_fixed(NOW)
+    _add("a", 1.0, 0)
+    _add("b", 10.0, 30)
+    _add("c", 100.0, 31)
+    _add("d", 1000.0, 60)
+    _add("e", 10000.0, 61)
+    assert reports.aging_report() == {"0-30": 11.0, "31-60": 1100.0, "60+": 10000.0}
+
+
+def test_paid_invoices_are_left_out():
+    clock.set_fixed(NOW)
+    _add("open", 5.0, 3)
+    _add("paid", 50.0, 3, status="paid")
+    _add("old-paid", 500.0, 90, status="paid")
+    assert reports.aging_report() == {"0-30": 5.0, "31-60": 0.0, "60+": 0.0}
+
+
+def test_partial_days_round_down():
+    clock.set_fixed(NOW)
+    issued = NOW - timedelta(days=30, hours=23)
+    db.invoices["x"] = Invoice(id="x", shipment_id="S", amount=7.0, issued_at=issued)
+    assert reports.aging_report()["0-30"] == 7.0
+
+
+def test_naive_issued_at_is_treated_as_utc():
+    clock.set_fixed(NOW)
+    _add("naive-old", 2.5, 70, naive=True)
+    _add("naive-mid", 4.0, 45, naive=True)
+    assert reports.aging_report() == {"0-30": 0.0, "31-60": 4.0, "60+": 2.5}
+
+
+def test_future_dated_invoice_is_in_no_bucket():
+    clock.set_fixed(NOW)
+    _add("future", 9.0, -2)
+    assert reports.aging_report() == {"0-30": 0.0, "31-60": 0.0, "60+": 0.0}
+
+
+def test_totals_round_to_cents():
+    clock.set_fixed(NOW)
+    _add("a", 0.1, 1)
+    _add("b", 0.2, 1)
+    assert reports.aging_report()["0-30"] == 0.3
