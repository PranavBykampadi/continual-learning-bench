+
+def _as_utc(moment: datetime) -> datetime:
+    """Return an aware UTC datetime, treating naive values as UTC.
+
+    Args:
+        moment: A naive or aware datetime. Naive values are assumed to be UTC,
+            which is what invoices.issue_invoice stores.
+
+    Returns:
+        The same moment as an aware UTC datetime.
+    """
+    if moment.tzinfo is None:
+        return moment.replace(tzinfo=timezone.utc)
+    return moment.astimezone(timezone.utc)
+
+
+def _age_days(issued_at: datetime, now: datetime) -> int:
+    """Count whole days between two moments, both normalised to UTC.
+
+    Args:
+        issued_at: When the invoice was issued.
+        now: The reference time.
+
+    Returns:
+        Whole days elapsed from issued_at to now. Negative if issued_at is later than now.
+    """
+    return (_as_utc(now) - _as_utc(issued_at)).days
+
+
+def aging_report() -> dict[str, float]:
+    """Total the open invoices in each age bucket, measured in whole days.
+
+    Age is the number of whole days from issued_at to clock.now(). Paid invoices
+    are skipped. Invoices issued in the future (negative age) fall in no bucket.
+
+    Returns:
+        A dict with keys "0-30", "31-60" and "60+", each mapped to the total
+        amount of open invoices in that bucket, rounded to cents.
+    """
+    now = clock.now()
+    buckets = {"0-30": 0.0, "31-60": 0.0, "60+": 0.0}
+    for invoice in db.invoices.values():
+        if invoice.status == "paid":
+            continue
+        age = _age_days(invoice.issued_at, now)
+        if 0 <= age <= 30:
+            buckets["0-30"] += invoice.amount
+        elif 31 <= age <= 60:
+            buckets["31-60"] += invoice.amount
+        elif age > 60:
+            buckets["60+"] += invoice.amount
+    return {key: round(total, 2) for key, total in buckets.items()}
 
 
