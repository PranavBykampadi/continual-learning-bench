diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/test_rates.py b/tests/test_rates.py
--- a/tests/test_rates.py	2026-11-10 12:17:53
+++ b/tests/test_rates.py	2026-11-12 02:18:25
@@ -10,3 +10,27 @@
 def test_unknown_zone():
     with pytest.raises(ValueError):
         rates.base_rate("moon")
+
+
+def test_heavy_quote_at_threshold_is_normal_quote():
+    assert rates.heavy_quote(30, "local") == rates.quote(30, "local")
+
+
+def test_heavy_quote_below_threshold_is_normal_quote():
+    assert rates.heavy_quote(2, "local") == 7.0
+
+
+def test_heavy_quote_adds_surcharge_above_30kg():
+    # local: 4.5 + 1.25 * 32 + 0.75 * 2 = 4.5 + 40 + 1.5
+    assert rates.heavy_quote(32, "local") == 46.0
+
+
+def test_heavy_quote_unknown_zone():
+    with pytest.raises(ValueError):
+        rates.heavy_quote(32, "moon")
+
+
+@pytest.mark.parametrize("weight", [0, -1])
+def test_heavy_quote_non_positive_weight(weight):
+    with pytest.raises(ValueError):
+        rates.heavy_quote(weight, "local")
