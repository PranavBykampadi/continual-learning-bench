diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/parcelo/rates.py b/parcelo/rates.py
--- a/parcelo/rates.py	2026-11-10 12:17:53
+++ b/parcelo/rates.py	2026-11-12 02:18:23
@@ -1,3 +1,5 @@
+from parcelo.settings import HEAVY_SURCHARGE_PER_KG, HEAVY_THRESHOLD_KG
+
 ZONE_BASE = {"local": 4.5, "national": 9.0, "international": 24.0}
 PER_KG = 1.25
 
@@ -8,7 +10,21 @@
     return ZONE_BASE[zone]
 
 
-def quote(weight_kg, zone):
+def _check_weight(weight_kg):
     if weight_kg <= 0:
         raise ValueError("weight must be positive")
+
+
+def quote(weight_kg, zone):
+    _check_weight(weight_kg)
     return round(base_rate(zone) + PER_KG * weight_kg, 2)
+
+
+def heavy_quote(weight_kg, zone):
+    """Return the normal quote plus a surcharge per kg above the heavy threshold.
+
+    Rounds to cents once, at the end.
+    """
+    _check_weight(weight_kg)
+    surcharge = HEAVY_SURCHARGE_PER_KG * max(0, weight_kg - HEAVY_THRESHOLD_KG)
+    return round(base_rate(zone) + PER_KG * weight_kg + surcharge, 2)
