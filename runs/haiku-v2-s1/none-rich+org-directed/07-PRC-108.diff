+from parcelo import customers, invoices, reports, shipments
+from parcelo.money import Money
+
+
+def test_outstanding_by_customer_counts_only_open_invoices():
+    acme = customers.add_customer("Acme")
+    globex = customers.add_customer("Globex")
+    idle = customers.add_customer("Idle")
+
+    s1 = shipments.create_shipment(acme.id, 2, "local")
+    s2 = shipments.create_shipment(acme.id, 2, "local")
+    s3 = shipments.create_shipment(globex.id, 2, "local")
+
+    open_inv = invoices.issue_invoice(s1.id)
+    paid_inv = invoices.issue_invoice(s2.id)
+    invoices.mark_paid(paid_inv.id)
+    other_open = invoices.issue_invoice(s3.id)
+    voided = invoices.issue_invoice(s3.id)
+    voided.status = "void"
+
+    result = reports.outstanding_by_customer()
+
+    assert result[acme.id] == Money.parse(open_inv.amount)
+    assert result[globex.id] == Money.parse(other_open.amount)
+    assert result[idle.id] == Money.zero()
+    assert set(result) == {acme.id, globex.id, idle.id}
+
+
+def test_outstanding_by_customer_sums_in_cents():
+    c = customers.add_customer("Acme")
+    shipment = shipments.create_shipment(c.id, 2, "local")
+    a = invoices.issue_invoice(shipment.id)
+    b = invoices.issue_invoice(shipment.id)
+    a.amount = 0.1
+    b.amount = 0.2
+
+    result = reports.outstanding_by_customer()
+
+    assert result[c.id] == Money(30)
