+from parcelo.money import Money
 from parcelo.store import db
+
+
+def outstanding_by_customer():
+    """Map each customer id to the total of their open invoices, as Money.
+
+    Paid and void invoices are excluded. Customers with nothing open map to zero.
+    Invoice amounts are still stored as floats, so each one is wrapped with
+    Money.parse as it is read; the sum is done in integer cents.
+    """
+    totals = {customer_id: Money.zero() for customer_id in db.customers}
+    for invoice in db.invoices.values():
+        if invoice.status != "open":
+            continue
+        customer_id = db.shipments[invoice.shipment_id].customer_id
+        totals[customer_id] = totals.get(customer_id, Money.zero()) + Money.parse(invoice.amount)
+    return totals
 
 
