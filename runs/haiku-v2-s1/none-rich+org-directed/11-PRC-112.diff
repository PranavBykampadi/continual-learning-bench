diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/parcelo/claims.py b/parcelo/claims.py
--- a/parcelo/claims.py	1969-12-31 19:00:00
+++ b/parcelo/claims.py	2026-11-12 02:02:03
@@ -0,0 +1,48 @@
+from decimal import InvalidOperation
+
+from parcelo import audit, clock, ids
+from parcelo.errors import DomainError
+from parcelo.models import Claim
+from parcelo.money import Money
+from parcelo.shipments import get_shipment
+from parcelo.store import db
+
+
+def file_claim(shipment_id, amount, reason):
+    """File a money-back claim against a delivered shipment.
+
+    Args:
+        shipment_id: Id of the delivered shipment the claim is about.
+        amount: Dollar amount claimed. Accepts float, int, str, Decimal or Money.
+            Converted to Money (integer cents) at this edge.
+        reason: Free-text reason given by the customer.
+
+    Returns:
+        The stored Claim.
+
+    Raises:
+        DomainError: E_BAD_INPUT if the amount is not a number or not positive,
+            E_NOT_FOUND if the shipment does not exist, E_BAD_STATE if the
+            shipment has not been delivered.
+    """
+    try:
+        money = Money.parse(amount)
+    except (InvalidOperation, ValueError, TypeError) as exc:
+        raise DomainError("E_BAD_INPUT", f"amount {amount!r}") from exc
+    if money.cents <= 0:
+        raise DomainError("E_BAD_INPUT", f"amount must be positive, got {money}")
+
+    shipment = get_shipment(shipment_id)
+    if shipment.status != "delivered":
+        raise DomainError("E_BAD_STATE", f"{shipment_id} is {shipment.status}, not delivered")
+
+    claim = Claim(
+        id=ids.new_id("clm"),
+        shipment_id=shipment_id,
+        amount=money,
+        reason=reason,
+        filed_at=clock.now(),
+    )
+    db.claims[claim.id] = claim
+    audit.record("claim.filed", claim.id, shipment_id=shipment_id, cents=money.cents)
+    return claim
