diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_claims.py b/tests/unit/test_claims.py
--- a/tests/unit/test_claims.py	1969-12-31 19:00:00
+++ b/tests/unit/test_claims.py	2026-11-12 02:02:14
@@ -0,0 +1,69 @@
+import pytest
+
+from parcelo import audit, claims, customers, shipments
+from parcelo.errors import DomainError
+from parcelo.money import Money
+from parcelo.store import db
+
+
+def _delivered_shipment():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 1.5, "national")
+    s.status = "delivered"
+    return s
+
+
+def test_file_claim_stores_and_returns_claim():
+    s = _delivered_shipment()
+    claim = claims.file_claim(s.id, 12.5, "box arrived crushed")
+    assert claim.id.startswith("clm_")
+    assert claim.shipment_id == s.id
+    assert claim.amount == Money(1250)
+    assert claim.reason == "box arrived crushed"
+    assert claim.filed_at is not None
+    assert db.claims[claim.id] is claim
+
+
+def test_file_claim_records_audit():
+    s = _delivered_shipment()
+    claim = claims.file_claim(s.id, "3.10", "late")
+    assert audit.LOG[-1]["action"] == "claim.filed"
+    assert audit.LOG[-1]["entity_id"] == claim.id
+
+
+def test_file_claim_accepts_money():
+    s = _delivered_shipment()
+    claim = claims.file_claim(s.id, Money(500), "lost contents")
+    assert claim.amount == Money(500)
+
+
+def test_unknown_shipment():
+    with pytest.raises(DomainError) as err:
+        claims.file_claim("shp_nope", 5, "x")
+    assert err.value.code == "E_NOT_FOUND"
+
+
+def test_shipment_not_delivered():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 1.5, "national")
+    with pytest.raises(DomainError) as err:
+        claims.file_claim(s.id, 5, "x")
+    assert err.value.code == "E_BAD_STATE"
+    assert db.claims == {}
+
+
+@pytest.mark.parametrize("amount", [0, -1, "0", 0.001, "-2.50"])
+def test_non_positive_amount(amount):
+    s = _delivered_shipment()
+    with pytest.raises(DomainError) as err:
+        claims.file_claim(s.id, amount, "x")
+    assert err.value.code == "E_BAD_INPUT"
+    assert db.claims == {}
+
+
+@pytest.mark.parametrize("amount", ["abc", None])
+def test_unparseable_amount(amount):
+    s = _delivered_shipment()
+    with pytest.raises(DomainError) as err:
+        claims.file_claim(s.id, amount, "x")
+    assert err.value.code == "E_BAD_INPUT"
