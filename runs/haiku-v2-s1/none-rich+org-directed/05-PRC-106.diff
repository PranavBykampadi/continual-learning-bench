-from parcelo import customers, invoices, shipments
+from datetime import timedelta, timezone
 
+import pytest
 
+from parcelo import clock, customers, invoices, shipments
+from parcelo.errors import DomainError
+
+
 def test_issue_and_pay():
     c = customers.add_customer("Acme")
     s = shipments.create_shipment(c.id, 2, "local")
     inv = invoices.issue_invoice(s.id)
     assert inv.amount == 7.0
     assert invoices.mark_paid(inv.id).status == "paid"
+
+
+def _issued_invoice():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 2, "local")
+    inv = invoices.issue_invoice(s.id)
+    issued = inv.issued_at.replace(tzinfo=timezone.utc)
+    return inv, issued
+
+
+def test_late_fee_zero_before_thirty_days():
+    inv, issued = _issued_invoice()
+    clock.set_fixed(issued + timedelta(days=29, hours=23))
+    assert invoices.late_fee_for(inv.id).cents == 0
+
+
+def test_late_fee_zero_exactly_thirty_days():
+    inv, issued = _issued_invoice()
+    clock.set_fixed(issued + timedelta(days=30))
+    assert invoices.late_fee_for(inv.id).cents == 0
+
+
+def test_late_fee_one_day_past_thirty():
+    # 7.00 * 1.5% = 0.105, rounds half up to 0.11
+    inv, issued = _issued_invoice()
+    clock.set_fixed(issued + timedelta(days=31))
+    assert invoices.late_fee_for(inv.id).cents == 11
+
+
+def test_late_fee_ten_days_past_thirty():
+    inv, issued = _issued_invoice()
+    clock.set_fixed(issued + timedelta(days=40))
+    assert str(invoices.late_fee_for(inv.id)) == "1.05 USD"
+
+
+def test_late_fee_unknown_invoice_raises():
+    with pytest.raises(DomainError) as exc:
+        invoices.late_fee_for("INV-nope")
+    assert exc.value.code == "E_NOT_FOUND"
