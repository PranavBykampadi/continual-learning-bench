 def open_invoices():
     return [i for i in db.invoices.values() if i.status == "open"]
+
+
+def late_fee_for(invoice_id: str) -> Money:
+    """Return the late fee an invoice has accrued as of now.
+
+    The invoice becomes late 30 days after it was issued. Each whole day past
+    that point adds 1.5% of the invoice amount. The fee is rounded to the cent
+    once, at the end.
+
+    Args:
+        invoice_id: ID of the invoice to price.
+
+    Returns:
+        The late fee as Money. Zero if the invoice is not late yet.
+
+    Raises:
+        DomainError: With code E_NOT_FOUND if no invoice has this ID.
+    """
+    if invoice_id not in db.invoices:
+        raise DomainError("E_NOT_FOUND", invoice_id)
+    invoice = db.invoices[invoice_id]
+    issued_at = invoice.issued_at
+    if issued_at.tzinfo is None:
+        # issue_invoice still stores naive UTC timestamps (legacy code).
+        issued_at = issued_at.replace(tzinfo=timezone.utc)
+    days_late = (clock.now() - issued_at).days - LATE_AFTER_DAYS
+    if days_late <= 0:
+        return Money.zero()
+    amount = Money.parse(invoice.amount)
+    return amount.scale(LATE_FEE_RATE_PER_DAY * days_late)
