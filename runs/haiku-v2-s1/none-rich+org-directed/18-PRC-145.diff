+def upgrade_tier(customer_id):
+    """Move a standard customer to the gold tier.
+
+    Args:
+        customer_id: Id of the customer to upgrade.
+
+    Returns:
+        The updated Customer.
+
+    Raises:
+        DomainError: E_UNKNOWN_CUSTOMER if the customer does not exist, or
+            E_BAD_STATE if the customer is not on the standard tier.
+    """
+    if customer_id not in db.customers:
+        raise DomainError("E_UNKNOWN_CUSTOMER", customer_id)
+    customer = db.customers[customer_id]
+    if customer.tier != "standard":
+        raise DomainError("E_BAD_STATE", f"{customer_id} is already {customer.tier}")
+    customer.tier = "gold"
+    events.emit("customer.upgraded", customer.id, tier="gold")
+    return customer
 
 
