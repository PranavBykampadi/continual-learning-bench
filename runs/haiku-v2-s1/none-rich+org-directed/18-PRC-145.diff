diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/test_customers.py b/tests/test_customers.py
--- a/tests/test_customers.py	1969-12-31 19:00:00
+++ b/tests/test_customers.py	2026-11-12 02:07:49
@@ -0,0 +1,32 @@
+import pytest
+
+from parcelo import customers, events
+from parcelo.errors import DomainError
+
+
+def test_upgrade_standard_to_gold():
+    c = customers.add_customer("Acme")
+    upgraded = customers.upgrade_tier(c.id)
+    assert upgraded is c
+    assert customers.get_customer(c.id).tier == "gold"
+
+
+def test_upgrade_emits_event():
+    c = customers.add_customer("Acme")
+    customers.upgrade_tier(c.id)
+    assert events.OUTBOX[-1]["name"] == "customer.upgraded"
+    assert events.OUTBOX[-1]["entity_id"] == c.id
+
+
+def test_upgrade_unknown_customer():
+    with pytest.raises(DomainError) as err:
+        customers.upgrade_tier("nope")
+    assert err.value.code == "E_UNKNOWN_CUSTOMER"
+
+
+def test_upgrade_already_gold():
+    c = customers.add_customer("Acme", tier="gold")
+    with pytest.raises(DomainError) as err:
+        customers.upgrade_tier(c.id)
+    assert err.value.code == "E_BAD_STATE"
+    assert not events.OUTBOX
