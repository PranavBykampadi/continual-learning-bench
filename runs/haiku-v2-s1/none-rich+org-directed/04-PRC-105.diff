diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/test_refunds.py b/tests/test_refunds.py
--- a/tests/test_refunds.py	1969-12-31 19:00:00
+++ b/tests/test_refunds.py	2026-11-12 01:56:22
@@ -0,0 +1,52 @@
+import pytest
+
+from parcelo import audit, clock, customers, invoices, refunds, shipments, store
+from parcelo.errors import DomainError
+from parcelo.money import Money
+
+
+def _invoice(paid):
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 2, "local")
+    inv = invoices.issue_invoice(s.id)
+    if paid:
+        invoices.mark_paid(inv.id)
+    return inv
+
+
+def test_refund_paid_invoice_is_stored():
+    clock.set_fixed(clock.now())
+    inv = _invoice(paid=True)
+    refund = refunds.create_refund(inv.id, 3.5)
+    assert refund.invoice_id == inv.id
+    assert refund.amount == Money(350)
+    assert refund.created_at == clock.now()
+    assert store.db.refunds[refund.id] is refund
+    assert any(
+        e["action"] == "refund.created" and e["entity_id"] == refund.id
+        for e in audit.LOG
+    )
+
+
+def test_refund_unpaid_invoice_fails():
+    inv = _invoice(paid=False)
+    with pytest.raises(DomainError) as exc:
+        refunds.create_refund(inv.id, 1)
+    assert exc.value.code == "E_BAD_STATE"
+    assert store.db.refunds == {}
+
+
+def test_refund_missing_invoice_fails():
+    with pytest.raises(DomainError) as exc:
+        refunds.create_refund("INV-missing", 1)
+    assert exc.value.code == "E_NOT_FOUND"
+    assert store.db.refunds == {}
+
+
+@pytest.mark.parametrize("amount", [0, -1, "abc", None])
+def test_refund_bad_amount_fails(amount):
+    inv = _invoice(paid=True)
+    with pytest.raises(DomainError) as exc:
+        refunds.create_refund(inv.id, amount)
+    assert exc.value.code == "E_BAD_INPUT"
+    assert store.db.refunds == {}
