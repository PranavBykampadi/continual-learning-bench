@@ -1,9 +1,56 @@
-from parcelo import customers, invoices, shipments
+from datetime import datetime, timezone
 
+import pytest
 
+from parcelo import audit, clock, customers, invoices, shipments
+from parcelo.errors import DomainError
+
+
 def test_issue_and_pay():
     c = customers.add_customer("Acme")
     s = shipments.create_shipment(c.id, 2, "local")
     inv = invoices.issue_invoice(s.id)
     assert inv.amount == 7.0
     assert invoices.mark_paid(inv.id).status == "paid"
+
+
+def _paid_invoice():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 2, "local")
+    inv = invoices.issue_invoice(s.id)
+    return invoices.mark_paid(inv.id)
+
+
+def test_reopen_paid_invoice():
+    inv = _paid_invoice()
+    moment = datetime(2026, 11, 12, 9, 30, tzinfo=timezone.utc)
+    clock.set_fixed(moment)
+    try:
+        out = invoices.reopen_invoice(inv.id)
+    finally:
+        clock.clear_fixed()
+    assert out is inv
+    assert out.status == "open"
+    assert out.paid_at is None
+    assert out.reopened_at == moment
+    assert [e["action"] for e in audit.LOG] == ["invoice.reopened"]
+    assert audit.LOG[0]["entity_id"] == inv.id
+
+
+def test_reopen_missing_invoice_fails():
+    with pytest.raises(DomainError) as exc:
+        invoices.reopen_invoice("INV-nope")
+    assert exc.value.code == "E_NOT_FOUND"
+    assert audit.LOG == []
+
+
+def test_reopen_unpaid_invoice_fails():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 2, "local")
+    inv = invoices.issue_invoice(s.id)
+    with pytest.raises(DomainError) as exc:
+        invoices.reopen_invoice(inv.id)
+    assert exc.value.code == "E_BAD_STATE"
+    assert inv.status == "open"
+    assert inv.reopened_at is None
+    assert audit.LOG == []
