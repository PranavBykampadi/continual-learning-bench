diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_customers.py b/tests/unit/test_customers.py
--- a/tests/unit/test_customers.py	1969-12-31 19:00:00
+++ b/tests/unit/test_customers.py	2026-11-12 02:12:30
@@ -0,0 +1,39 @@
+import pytest
+
+from parcelo import customers, events
+from parcelo.errors import DomainError
+
+
+def test_set_credit_limit_updates_and_returns_new_limit():
+    c = customers.add_customer("Acme")
+    assert customers.set_credit_limit(c.id, 2500.0) == 2500.0
+    assert customers.get_customer(c.id).credit_limit == 2500.0
+
+
+def test_set_credit_limit_to_zero_is_allowed():
+    c = customers.add_customer("Acme")
+    assert customers.set_credit_limit(c.id, 0) == 0
+
+
+def test_set_credit_limit_emits_event():
+    c = customers.add_customer("Acme")
+    customers.set_credit_limit(c.id, 900)
+    event = events.OUTBOX[-1]
+    assert event["name"] == "customer.credit_limit_changed"
+    assert event["entity_id"] == c.id
+    assert event["payload"] == {"old_limit": 500.0, "new_limit": 900}
+
+
+def test_set_credit_limit_unknown_customer():
+    with pytest.raises(DomainError) as err:
+        customers.set_credit_limit("nope", 100)
+    assert err.value.code == "E_UNKNOWN_CUSTOMER"
+
+
+def test_set_credit_limit_negative_amount_rejected():
+    c = customers.add_customer("Acme")
+    with pytest.raises(DomainError) as err:
+        customers.set_credit_limit(c.id, -1)
+    assert err.value.code == "E_BAD_INPUT"
+    assert customers.get_customer(c.id).credit_limit == 500.0
+    assert all(e["name"] != "customer.credit_limit_changed" for e in events.OUTBOX)
