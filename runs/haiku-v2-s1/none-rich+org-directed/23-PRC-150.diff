+def set_credit_limit(customer_id: str, amount: float) -> float:
+    """Set a customer's credit limit.
+
+    Args:
+        customer_id: ID of the customer to update.
+        amount: The new credit limit. Must not be negative.
+
+    Returns:
+        The customer's new credit limit.
+
+    Raises:
+        DomainError: E_UNKNOWN_CUSTOMER if the customer does not exist,
+            E_BAD_INPUT if amount is negative.
+    """
+    if customer_id not in db.customers:
+        raise DomainError("E_UNKNOWN_CUSTOMER", customer_id)
+    if amount < 0:
+        raise DomainError("E_BAD_INPUT", f"credit limit cannot be negative: {amount}")
+    customer = db.customers[customer_id]
+    old_limit = customer.credit_limit
+    customer.credit_limit = amount
+    events.emit(
+        "customer.credit_limit_changed",
+        customer_id,
+        old_limit=old_limit,
+        new_limit=amount,
+    )
+    return customer.credit_limit
 
 
