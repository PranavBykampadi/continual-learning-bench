+++ b/parcelo/settings.py	2026-11-12 02:15:55
@@ -0,0 +1,9 @@
+"""Business thresholds and limits. Finance and product may ask us to change these."""
+
+from parcelo.money import Money
+
+# A customer with more than this many open invoices needs a manual review.
+MAX_OPEN_INVOICES_FOR_REVIEW = 3
+
+# A customer whose open invoices total more than this needs a manual review.
+REVIEW_OPEN_BALANCE_LIMIT = Money.parse("250.00")
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_customers_review.py b/tests/unit/test_customers_review.py
--- a/tests/unit/test_customers_review.py	1969-12-31 19:00:00
+++ b/tests/unit/test_customers_review.py	2026-11-12 02:16:04
@@ -0,0 +1,72 @@
+import pytest
+
+from parcelo import customers, shipments
+from parcelo.errors import DomainError
+from parcelo.models import Invoice
+from parcelo.store import db
+
+
+def _add_invoice(customer_id, amount, status="open"):
+    shipment = shipments.create_shipment(customer_id, 1, "local")
+    invoice = Invoice(
+        id=f"INV-{len(db.invoices)}",
+        shipment_id=shipment.id,
+        amount=amount,
+        status=status,
+    )
+    db.invoices[invoice.id] = invoice
+
+
+def test_no_invoices_does_not_need_review():
+    c = customers.add_customer("Acme")
+    assert customers.needs_review(c.id) is False
+
+
+def test_three_open_invoices_does_not_need_review():
+    c = customers.add_customer("Acme")
+    for _ in range(3):
+        _add_invoice(c.id, 10.0)
+    assert customers.needs_review(c.id) is False
+
+
+def test_more_than_three_open_invoices_needs_review():
+    c = customers.add_customer("Acme")
+    for _ in range(4):
+        _add_invoice(c.id, 1.0)
+    assert customers.needs_review(c.id) is True
+
+
+def test_paid_invoices_do_not_count_towards_open_limit():
+    c = customers.add_customer("Acme")
+    for _ in range(3):
+        _add_invoice(c.id, 1.0)
+    for _ in range(3):
+        _add_invoice(c.id, 1.0, status="paid")
+    assert customers.needs_review(c.id) is False
+
+
+def test_open_balance_exactly_at_limit_does_not_need_review():
+    c = customers.add_customer("Acme")
+    _add_invoice(c.id, 250.00)
+    assert customers.needs_review(c.id) is False
+
+
+def test_open_balance_over_limit_needs_review():
+    c = customers.add_customer("Acme")
+    _add_invoice(c.id, 200.00)
+    _add_invoice(c.id, 50.01)
+    assert customers.needs_review(c.id) is True
+
+
+def test_other_customers_invoices_are_ignored():
+    c = customers.add_customer("Acme")
+    other = customers.add_customer("Other")
+    for _ in range(4):
+        _add_invoice(other.id, 100.0)
+    assert customers.needs_review(c.id) is False
+
+
+def test_unknown_customer_raises():
+    with pytest.raises(DomainError) as err:
+        customers.needs_review("nope")
+    assert err.value.code == "E_UNKNOWN_CUSTOMER"
