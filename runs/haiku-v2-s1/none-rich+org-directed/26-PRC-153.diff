+def needs_review(customer_id: str) -> bool:
+    """Return True if the customer's open invoices need a manual look.
+
+    A customer needs review when they have more than
+    MAX_OPEN_INVOICES_FOR_REVIEW open invoices, or when the total of their
+    open invoices is over REVIEW_OPEN_BALANCE_LIMIT.
+
+    Args:
+        customer_id: ID of the customer to check.
+
+    Returns:
+        True if the customer needs a manual review, otherwise False.
+
+    Raises:
+        DomainError: With code E_UNKNOWN_CUSTOMER if the customer does not exist.
+    """
+    if customer_id not in db.customers:
+        raise DomainError("E_UNKNOWN_CUSTOMER", customer_id)
+    open_count = 0
+    for invoice in db.invoices.values():
+        shipment = db.shipments[invoice.shipment_id]
+        if shipment.customer_id == customer_id and invoice.status == "open":
+            open_count += 1
+    if open_count > MAX_OPEN_INVOICES_FOR_REVIEW:
+        return True
+    balance = Money.parse(outstanding_balance(customer_id))
+    return REVIEW_OPEN_BALANCE_LIMIT < balance
