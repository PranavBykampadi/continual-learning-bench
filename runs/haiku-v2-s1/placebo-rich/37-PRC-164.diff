diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/parcelo/vouchers.py b/parcelo/vouchers.py
--- a/parcelo/vouchers.py	1969-12-31 19:00:00
+++ b/parcelo/vouchers.py	2026-11-12 02:09:09
@@ -0,0 +1,27 @@
+import uuid
+
+from parcelo import clock
+from parcelo.errors import DomainError
+from parcelo.models import Voucher
+from parcelo.money import Money
+from parcelo.store import db
+
+MAX_VOUCHER = Money.parse("150.00")
+
+
+def issue_voucher(customer_id, amount):
+    if customer_id not in db.customers:
+        raise DomainError("E_UNKNOWN_CUSTOMER", customer_id)
+    value = Money.parse(amount)
+    if value.cents <= 0:
+        raise DomainError("E_BAD_INPUT", "voucher amount must be positive")
+    if MAX_VOUCHER < value:
+        raise DomainError("E_LIMIT", "voucher amount exceeds 150.00")
+    voucher = Voucher(
+        id="VCH-" + uuid.uuid4().hex[:8],
+        customer_id=customer_id,
+        amount=amount,
+        issued_at=clock.now(),
+    )
+    db.vouchers[voucher.id] = voucher
+    return voucher
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/test_vouchers.py b/tests/test_vouchers.py
--- a/tests/test_vouchers.py	1969-12-31 19:00:00
+++ b/tests/test_vouchers.py	2026-11-12 02:09:09
@@ -0,0 +1,44 @@
+import pytest
+
+from parcelo.customers import add_customer
+from parcelo.errors import DomainError
+from parcelo.store import db
+from parcelo.vouchers import issue_voucher
+
+
+def test_issue_voucher_saves_and_returns():
+    customer = add_customer("Ada")
+    voucher = issue_voucher(customer.id, 25.0)
+    assert voucher.customer_id == customer.id
+    assert voucher.amount == 25.0
+    assert voucher.issued_at is not None
+    assert db.vouchers[voucher.id] is voucher
+
+
+def test_voucher_at_limit_is_allowed():
+    customer = add_customer("Ada")
+    assert issue_voucher(customer.id, 150.00).amount == 150.00
+
+
+def test_voucher_above_limit_rejected():
+    customer = add_customer("Ada")
+    with pytest.raises(DomainError) as exc:
+        issue_voucher(customer.id, 150.01)
+    assert exc.value.code == "E_LIMIT"
+    assert db.vouchers == {}
+
+
+@pytest.mark.parametrize("amount", [0, -5, -0.01])
+def test_non_positive_amount_rejected(amount):
+    customer = add_customer("Ada")
+    with pytest.raises(DomainError) as exc:
+        issue_voucher(customer.id, amount)
+    assert exc.value.code == "E_BAD_INPUT"
+    assert db.vouchers == {}
+
+
+def test_unknown_customer_rejected():
+    with pytest.raises(DomainError) as exc:
+        issue_voucher("nope", 10)
+    assert exc.value.code == "E_UNKNOWN_CUSTOMER"
+    assert db.vouchers == {}
