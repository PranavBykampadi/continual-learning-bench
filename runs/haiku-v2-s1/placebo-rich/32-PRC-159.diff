     assert events.OUTBOX[-1]["name"] == "shipment.created"
 
 
+def test_shipments_in_zone_filters_by_zone():
+    c = customers.add_customer("Zoner")
+    local = shipments.create_shipment(c.id, 1, "local")
+    intl = shipments.create_shipment(c.id, 2, "international")
+    assert shipments.shipments_in_zone("local") == [local]
+    assert shipments.shipments_in_zone("international") == [intl]
+
+
+def test_shipments_in_zone_empty():
+    assert shipments.shipments_in_zone("national") == []
+
+
+def test_shipments_in_zone_unknown_zone():
+    with pytest.raises(DomainError) as err:
+        shipments.shipments_in_zone("mars")
+    assert err.value.code == "E_BAD_ZONE"
+
+
