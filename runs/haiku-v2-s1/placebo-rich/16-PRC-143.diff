diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_pickups.py b/tests/unit/test_pickups.py
--- a/tests/unit/test_pickups.py	1969-12-31 19:00:00
+++ b/tests/unit/test_pickups.py	2026-11-12 02:01:17
@@ -0,0 +1,35 @@
+import pytest
+
+from parcelo import pickups, shipments
+from parcelo.errors import DomainError
+from parcelo.models import Customer
+from parcelo.store import db
+
+
+@pytest.fixture
+def shipment():
+    db.customers["cus_1"] = Customer(id="cus_1", name="Acme")
+    return shipments.create_shipment("cus_1", 2.5, "local")
+
+
+def test_schedule_pickup_saves_and_returns(shipment):
+    pickup = pickups.schedule_pickup(shipment.id, "2026-11-13T09:00")
+    assert pickup.shipment_id == shipment.id
+    assert pickup.window_start == "2026-11-13T09:00"
+    assert pickup.scheduled_at is not None
+    assert db.pickups[pickup.id] is pickup
+
+
+def test_unknown_shipment_fails():
+    with pytest.raises(DomainError) as exc:
+        pickups.schedule_pickup("shp_missing", "2026-11-13T09:00")
+    assert exc.value.code == "E_NOT_FOUND"
+    assert db.pickups == {}
+
+
+def test_non_created_shipment_fails(shipment):
+    shipment.status = "delivered"
+    with pytest.raises(DomainError) as exc:
+        pickups.schedule_pickup(shipment.id, "2026-11-13T09:00")
+    assert exc.value.code == "E_BAD_STATE"
+    assert db.pickups == {}
