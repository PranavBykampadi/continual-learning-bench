     return round(base_rate(zone) + PER_KG * weight_kg, 2)
+
+
+HEAVY_THRESHOLD_KG = 30
+HEAVY_PER_KG = 0.75
+
+
+def heavy_quote(weight_kg, zone):
+    # quote() validates weight and zone, so both checks apply here too.
+    price = quote(weight_kg, zone)
+    if weight_kg > HEAVY_THRESHOLD_KG:
+        price += HEAVY_PER_KG * (weight_kg - HEAVY_THRESHOLD_KG)
+    return round(price, 2)
