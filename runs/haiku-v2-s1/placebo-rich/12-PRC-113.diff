 def open_invoices():
     return [i for i in db.invoices.values() if i.status == "open"]
+
+
+def apply_credit(invoice_id, amount):
+    """Reduce an open invoice's amount by `amount` and return the remaining amount.
+
+    The amount is reduced in place, so reports and customer balances that read
+    `Invoice.amount` pick up the credit automatically.
+    """
+    if invoice_id not in db.invoices:
+        raise DomainError("E_NOT_FOUND", f"invoice {invoice_id} not found")
+    invoice = db.invoices[invoice_id]
+    if invoice.status != "open":
+        raise DomainError("E_BAD_STATE", f"invoice {invoice_id} is not open")
+    if amount <= 0:
+        raise DomainError("E_BAD_INPUT", "credit must be positive")
+    remaining = round(invoice.amount - amount, 2)
+    if remaining < 0:
+        raise DomainError("E_BAD_INPUT", "credit exceeds invoice amount")
+    invoice.amount = remaining
+    return remaining
