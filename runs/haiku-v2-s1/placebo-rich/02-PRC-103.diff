diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/parcelo/rates.py b/parcelo/rates.py
--- a/parcelo/rates.py	2026-11-10 12:17:53
+++ b/parcelo/rates.py	2026-11-12 01:51:14
@@ -1,3 +1,5 @@
+from parcelo.legacy.billing import fuel_surcharge
+
 ZONE_BASE = {"local": 4.5, "national": 9.0, "international": 24.0}
 PER_KG = 1.25
 
@@ -12,3 +14,9 @@
     if weight_kg <= 0:
         raise ValueError("weight must be positive")
     return round(base_rate(zone) + PER_KG * weight_kg, 2)
+
+
+def quote_with_surcharge(weight_kg, zone):
+    """Return (quote, fuel_surcharge) for the given weight and zone."""
+    amount = quote(weight_kg, zone)
+    return amount, fuel_surcharge(amount, zone)
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/test_rates.py b/tests/test_rates.py
--- a/tests/test_rates.py	2026-11-10 12:17:53
+++ b/tests/test_rates.py	2026-11-12 01:51:16
@@ -10,3 +10,24 @@
 def test_unknown_zone():
     with pytest.raises(ValueError):
         rates.base_rate("moon")
+
+
+def test_quote_with_surcharge_national():
+    # quote = 9.0 + 1.25 * 2 = 11.5; national surcharge 4% = 0.46
+    assert rates.quote_with_surcharge(2, "national") == (11.5, 0.46)
+
+
+def test_quote_with_surcharge_local_is_zero():
+    assert rates.quote_with_surcharge(2, "local") == (7.0, 0.0)
+
+
+def test_quote_with_surcharge_rejects_unknown_zone():
+    with pytest.raises(ValueError):
+        rates.quote_with_surcharge(2, "moon")
+
+
+def test_quote_with_surcharge_rejects_non_positive_weight():
+    with pytest.raises(ValueError):
+        rates.quote_with_surcharge(0, "local")
+    with pytest.raises(ValueError):
+        rates.quote_with_surcharge(-1, "local")
