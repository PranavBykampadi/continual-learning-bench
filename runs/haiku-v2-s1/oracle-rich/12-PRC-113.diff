 def open_invoices():
     return [i for i in db.invoices.values() if i.status == "open"]
+
+
+def apply_credit(invoice_id, amount):
+    """Reduce an open invoice by a credit. Returns the remaining amount as Money."""
+    if invoice_id not in db.invoices:
+        raise DomainError("E_NOT_FOUND", f"no invoice {invoice_id}")
+    invoice = db.invoices[invoice_id]
+    if invoice.status != "open":
+        raise DomainError("E_BAD_STATE", f"invoice {invoice_id} is not open")
+    try:
+        credit = Money.parse(amount)
+    except (ArithmeticError, TypeError, ValueError):
+        raise DomainError("E_BAD_INPUT", f"bad credit amount {amount!r}")
+    if credit.currency != "USD" or credit.cents <= 0:
+        raise DomainError("E_BAD_INPUT", "credit must be a positive USD amount")
+    if invoice.balance() < credit:
+        raise DomainError("E_BAD_INPUT", "credit is larger than the invoice balance")
+    invoice.credited_cents += credit.cents
+    remaining = invoice.balance()
+    audit.record(
+        "invoice.credit_applied",
+        invoice_id,
+        credit_cents=credit.cents,
+        remaining_cents=remaining.cents,
+    )
+    return remaining
