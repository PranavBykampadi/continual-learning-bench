--- a/tests/unit/test_invoice_credit.py	1969-12-31 19:00:00
+++ b/tests/unit/test_invoice_credit.py	2026-11-12 02:00:56
@@ -0,0 +1,91 @@
+import pytest
+
+from parcelo import audit, customers, invoices, reports, shipments
+from parcelo.errors import DomainError
+from parcelo.money import Money
+
+
+def _open_invoice():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 2, "local")  # quotes at 7.00
+    return c, invoices.issue_invoice(s.id)
+
+
+def test_apply_credit_returns_remaining_money():
+    _, inv = _open_invoice()
+    remaining = invoices.apply_credit(inv.id, 2.5)
+    assert isinstance(remaining, Money)
+    assert remaining == Money(450)
+    assert inv.status == "open"
+
+
+def test_credit_affects_customer_balance():
+    c, inv = _open_invoice()
+    invoices.apply_credit(inv.id, Money(250))
+    assert customers.outstanding_balance(c.id) == 4.5
+
+
+def test_credit_affects_revenue_once_paid():
+    _, inv = _open_invoice()
+    invoices.apply_credit(inv.id, 2.5)
+    invoices.mark_paid(inv.id)
+    assert reports.revenue_total() == 4.5
+
+
+def test_multiple_credits_accumulate():
+    _, inv = _open_invoice()
+    invoices.apply_credit(inv.id, 2.0)
+    assert invoices.apply_credit(inv.id, 5.0) == Money(0)
+
+
+def test_credit_records_audit():
+    _, inv = _open_invoice()
+    invoices.apply_credit(inv.id, 1.0)
+    entry = audit.LOG[-1]
+    assert entry["action"] == "invoice.credit_applied"
+    assert entry["entity_id"] == inv.id
+
+
+def test_unknown_invoice_fails():
+    with pytest.raises(DomainError) as err:
+        invoices.apply_credit("INV-missing", 1.0)
+    assert err.value.code == "E_NOT_FOUND"
+
+
