diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_claims.py b/tests/unit/test_claims.py
--- a/tests/unit/test_claims.py	1969-12-31 19:00:00
+++ b/tests/unit/test_claims.py	2026-11-12 01:59:36
@@ -0,0 +1,78 @@
+import pytest
+
+from parcelo import audit, claims, customers, shipments, store
+from parcelo.errors import DomainError
+from parcelo.money import Money
+from parcelo.store import db
+
+
+def _delivered_shipment():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 2.0, "national")
+    s.status = "delivered"
+    return s
+
+
+def test_file_claim_stores_and_returns_claim():
+    s = _delivered_shipment()
+    claim = claims.file_claim(s.id, "12.50", "damaged")
+    assert claim.id.startswith("clm_")
+    assert claim.shipment_id == s.id
+    assert claim.amount == Money(1250)
+    assert claim.reason == "damaged"
+    assert claim.filed_at is not None
+    assert db.claims[claim.id] is claim
+
+
+def test_file_claim_records_audit():
+    s = _delivered_shipment()
+    claim = claims.file_claim(s.id, 5, "lost")
+    assert audit.LOG[-1]["action"] == "claim.filed"
+    assert audit.LOG[-1]["entity_id"] == claim.id
+
+
+def test_amount_accepts_money_and_float():
+    s = _delivered_shipment()
+    assert claims.file_claim(s.id, Money(300), "a").amount == Money(300)
+    assert claims.file_claim(s.id, 0.1, "b").amount == Money(10)
+
+
+def test_unknown_shipment_is_not_found():
+    with pytest.raises(DomainError) as err:
+        claims.file_claim("shp_missing", 1, "x")
+    assert err.value.code == "E_NOT_FOUND"
+
+
+@pytest.mark.parametrize("status", ["created", "in_transit", "lost"])
+def test_undelivered_shipment_rejected(status):
+    s = _delivered_shipment()
+    s.status = status
+    with pytest.raises(DomainError) as err:
+        claims.file_claim(s.id, 1, "x")
+    assert err.value.code == "E_BAD_STATE"
+    assert db.claims == {}
+
+
+@pytest.mark.parametrize("amount", [0, -1, "-2.00", 0.001])
+def test_non_positive_amount_rejected(amount):
+    s = _delivered_shipment()
+    with pytest.raises(DomainError) as err:
+        claims.file_claim(s.id, amount, "x")
+    assert err.value.code == "E_BAD_INPUT"
+    assert db.claims == {}
+
+
+@pytest.mark.parametrize("amount", ["abc", None, float("nan"), float("inf")])
+def test_unparseable_amount_rejected(amount):
+    s = _delivered_shipment()
+    with pytest.raises(DomainError) as err:
+        claims.file_claim(s.id, amount, "x")
+    assert err.value.code == "E_BAD_INPUT"
+    assert db.claims == {}
+
+
+def test_store_reset_clears_claims():
+    s = _delivered_shipment()
+    claims.file_claim(s.id, 1, "x")
+    store.reset()
+    assert db.claims == {}
