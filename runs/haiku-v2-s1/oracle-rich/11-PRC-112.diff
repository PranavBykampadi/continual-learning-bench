+++ b/parcelo/claims.py	2026-11-12 01:59:34
@@ -0,0 +1,41 @@
+from dataclasses import dataclass
+from datetime import datetime
+
+from parcelo import audit, clock, ids
+from parcelo.errors import DomainError
+from parcelo.money import Money
+from parcelo.shipments import get_shipment
+from parcelo.store import db
+
+
+@dataclass
+class Claim:
+    id: str
+    shipment_id: str
+    amount: Money
+    reason: str
+    filed_at: datetime
+
+
+def file_claim(shipment_id, amount, reason):
+    shipment = get_shipment(shipment_id)
+    if shipment.status != "delivered":
+        raise DomainError(
+            "E_BAD_STATE", f"{shipment_id} is {shipment.status}, not delivered"
+        )
+    try:
+        money = Money.parse(amount)
+    except (ArithmeticError, TypeError, ValueError):
+        raise DomainError("E_BAD_INPUT", f"invalid amount {amount!r}")
+    if money.cents <= 0:
+        raise DomainError("E_BAD_INPUT", f"amount must be positive, got {money}")
+    claim = Claim(
+        id=ids.new_id("clm"),
+        shipment_id=shipment_id,
+        amount=money,
+        reason=reason,
+        filed_at=clock.now(),
+    )
+    db.claims[claim.id] = claim
+    audit.record("claim.filed", claim.id, shipment_id=shipment_id, cents=money.cents)
+    return claim
