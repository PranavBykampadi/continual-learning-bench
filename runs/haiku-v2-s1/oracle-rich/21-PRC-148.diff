+++ b/parcelo/disputes.py	2026-11-12 02:06:17
@@ -0,0 +1,21 @@
+from parcelo import clock, events, ids
+from parcelo.errors import DomainError
+from parcelo.models import Dispute
+from parcelo.store import db
+
+
+def open_dispute(invoice_id, reason):
+    """Open a dispute against an invoice. Raises E_NOT_FOUND for an unknown invoice, E_BAD_INPUT for an empty reason."""
+    if invoice_id not in db.invoices:
+        raise DomainError("E_NOT_FOUND", invoice_id)
+    if not isinstance(reason, str) or not reason.strip():
+        raise DomainError("E_BAD_INPUT", "reason is required")
+    dispute = Dispute(
+        id=ids.new_id("dsp"),
+        invoice_id=invoice_id,
+        reason=reason,
+        opened_at=clock.now(),
+    )
+    db.disputes[dispute.id] = dispute
+    events.emit("dispute.opened", dispute.id, invoice_id=invoice_id)
+    return dispute
