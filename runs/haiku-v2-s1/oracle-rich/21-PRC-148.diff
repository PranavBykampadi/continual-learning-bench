diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_disputes.py b/tests/unit/test_disputes.py
--- a/tests/unit/test_disputes.py	1969-12-31 19:00:00
+++ b/tests/unit/test_disputes.py	2026-11-12 02:06:20
@@ -0,0 +1,50 @@
+import pytest
+
+from parcelo import clock, disputes, events, store
+from parcelo.errors import DomainError
+from parcelo.models import Invoice
+
+
+@pytest.fixture
+def invoice():
+    inv = Invoice(id="inv_test_1", shipment_id="shp_x", amount=12.5)
+    store.db.invoices[inv.id] = inv
+    return inv
+
+
+def test_open_dispute_saves_and_returns(invoice):
+    fixed = clock.now()
+    clock.set_fixed(fixed)
+    d = disputes.open_dispute(invoice.id, "wrong weight")
+    assert d.id.startswith("dsp_")
+    assert d.invoice_id == invoice.id
+    assert d.reason == "wrong weight"
+    assert d.opened_at == fixed
+    assert store.db.disputes[d.id] is d
+
+
+def test_open_dispute_emits_event(invoice):
+    d = disputes.open_dispute(invoice.id, "not received")
+    assert events.OUTBOX[-1]["name"] == "dispute.opened"
+    assert events.OUTBOX[-1]["entity_id"] == d.id
+
+
+def test_unknown_invoice_fails(invoice):
+    with pytest.raises(DomainError) as err:
+        disputes.open_dispute("inv_missing", "reason")
+    assert err.value.code == "E_NOT_FOUND"
+    assert store.db.disputes == {}
+
+
+@pytest.mark.parametrize("reason", ["", "   ", None])
+def test_empty_reason_fails(invoice, reason):
+    with pytest.raises(DomainError) as err:
+        disputes.open_dispute(invoice.id, reason)
+    assert err.value.code == "E_BAD_INPUT"
+    assert store.db.disputes == {}
+
+
+def test_reset_clears_disputes(invoice):
+    disputes.open_dispute(invoice.id, "reason")
+    store.reset()
+    assert store.db.disputes == {}
