--- a/tests/unit/test_reports_aging.py	1969-12-31 19:00:00
+++ b/tests/unit/test_reports_aging.py	2026-11-12 02:01:32
@@ -0,0 +1,75 @@
+from datetime import datetime, timedelta, timezone
+
+from parcelo import clock
+from parcelo.models import Invoice
+from parcelo.money import Money
+from parcelo.reports import aging_report
+from parcelo.store import db
+
+NOW = datetime(2026, 11, 12, 12, 0, tzinfo=timezone.utc)
+
+
+def _add(inv_id, amount, days_old, status="open", naive=False):
+    issued = NOW - timedelta(days=days_old)
+    if naive:
+        issued = issued.replace(tzinfo=None)
+    db.invoices[inv_id] = Invoice(
+        id=inv_id,
+        shipment_id="shp_x",
+        amount=amount,
+        status=status,
+        issued_at=issued,
+    )
+
+
+def setup_function():
+    clock.set_fixed(NOW)
+
+
+def teardown_function():
+    clock.clear_fixed()
+
+
+def test_empty_buckets_are_zero():
+    report = aging_report()
+    assert report.keys() == {"0-30", "31-60", "60+"}
+    assert all(v == Money.zero() for v in report.values())
+
+
+def test_bucket_boundaries():
+    _add("a", 1.0, 0)
+    _add("b", 1.0, 30)
+    _add("c", 1.0, 31)
+    _add("d", 1.0, 60)
+    _add("e", 1.0, 61)
+    report = aging_report()
+    assert report["0-30"] == Money(200)
+    assert report["31-60"] == Money(200)
+    assert report["60+"] == Money(100)
+
+
+def test_partial_days_are_floored():
+    issued = NOW - timedelta(days=30, hours=23)
+    db.invoices["x"] = Invoice(id="x", shipment_id="s", amount=5.0, issued_at=issued)
+    assert aging_report()["0-30"] == Money(500)
+
+
+def test_paid_invoices_excluded():
+    _add("paid", 99.0, 90, status="paid")
+    _add("open", 2.5, 10)
+    report = aging_report()
+    assert report["60+"] == Money.zero()
+    assert report["0-30"] == Money(250)
+
+
+def test_naive_issue_timestamp_treated_as_utc():
+    _add("n", 3.0, 45, naive=True)
+    assert aging_report()["31-60"] == Money(300)
+
+
+def test_amounts_are_money_not_floats():
+    _add("f", 0.1, 1)
+    _add("g", 0.2, 1)
+    total = aging_report()["0-30"]
+    assert isinstance(total, Money)
+    assert total.cents == 30
