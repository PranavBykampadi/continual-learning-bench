-from datetime import datetime
+from datetime import datetime, timezone
 
+from parcelo import clock
+from parcelo.errors import DomainError
+from parcelo.money import Money
 from parcelo.store import db
+
+
+def _aware(moment):
+    # Some invoices carry naive UTC timestamps (see invoices.issue_invoice).
+    if moment.tzinfo is None:
+        return moment.replace(tzinfo=timezone.utc)
+    return moment
+
+
+def _whole_days_since(issued_at, now):
+    return (_aware(now) - _aware(issued_at)).days
+
+
+def aging_report():
+    """Total open invoice amounts bucketed by whole days since issue."""
+    today = clock.now()
+    buckets = {"0-30": Money.zero(), "31-60": Money.zero(), "60+": Money.zero()}
+    for invoice in db.invoices.values():
+        if invoice.status != "open":
+            continue
+        if invoice.issued_at is None:
+            raise DomainError(
+                "E_BAD_STATE", f"invoice {invoice.id} has no issue date"
+            )
+        age = _whole_days_since(invoice.issued_at, today)
+        amount = Money.parse(invoice.amount)
+        if age <= 30:
+            key = "0-30"
+        elif age <= 60:
+            key = "31-60"
+        else:
+            key = "60+"
+        buckets[key] = buckets[key] + amount
+    return buckets
 
 
