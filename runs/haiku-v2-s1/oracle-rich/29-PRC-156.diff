diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_rates_heavy.py b/tests/unit/test_rates_heavy.py
--- a/tests/unit/test_rates_heavy.py	1969-12-31 19:00:00
+++ b/tests/unit/test_rates_heavy.py	2026-11-12 02:10:11
@@ -0,0 +1,41 @@
+import pytest
+
+from parcelo import rates
+from parcelo.errors import DomainError
+from parcelo.money import Money
+
+
+def test_at_threshold_is_normal_quote():
+    assert rates.heavy_quote(30, "local") == Money.parse(rates.quote(30, "local"))
+
+
+def test_below_threshold_is_normal_quote():
+    assert rates.heavy_quote(2, "national") == Money.parse(rates.quote(2, "national"))
+
+
+def test_surcharge_per_kg_above_threshold():
+    # 32 kg local: normal quote 4.5 + 1.25*32 = 44.5, surcharge 2 * 0.75 = 1.50
+    assert rates.heavy_quote(32, "local") == Money(4600)
+
+
+def test_fractional_excess_rounds_half_up():
+    # 31.5 kg national: normal quote 9 + 1.25*31.5 = 48.375 -> 48.38
+    # surcharge 1.5 * 0.75 = 1.125 -> 1.13 ; total 49.51
+    assert rates.heavy_quote(31.5, "national") == Money(4951)
+
+
+def test_returns_money_not_float():
+    assert isinstance(rates.heavy_quote(40, "international"), Money)
+
+
+def test_unknown_zone_raises_domain_error():
+    with pytest.raises(DomainError) as err:
+        rates.heavy_quote(40, "moon")
+    assert err.value.code == "E_BAD_ZONE"
+
+
+@pytest.mark.parametrize("weight", [0, -1, -0.5])
+def test_non_positive_weight_raises_domain_error(weight):
+    with pytest.raises(DomainError) as err:
+        rates.heavy_quote(weight, "local")
+    assert err.value.code == "E_BAD_WEIGHT"
