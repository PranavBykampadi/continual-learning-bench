+from collections import Counter
 from datetime import datetime
 
+from parcelo.settings import VOLUME_BULK_MIN_SHIPMENTS, VOLUME_REGULAR_MIN_SHIPMENTS
 from parcelo.store import db
+
+
+def _volume_tier(shipment_count):
+    if shipment_count >= VOLUME_BULK_MIN_SHIPMENTS:
+        return "bulk"
+    if shipment_count >= VOLUME_REGULAR_MIN_SHIPMENTS:
+        return "regular"
+    return "starter"
+
+
+def volume_report():
+    """Per-customer shipment count and volume tier, keyed by customer id.
+
+    Every customer is included, including those with no shipments.
+    """
+    counts = Counter(shipment.customer_id for shipment in db.shipments.values())
+    report = {}
+    for customer_id in sorted(db.customers):
+        shipment_count = counts.get(customer_id, 0)
+        report[customer_id] = {
+            "shipments": shipment_count,
+            "tier": _volume_tier(shipment_count),
+        }
+    return report
 
 
