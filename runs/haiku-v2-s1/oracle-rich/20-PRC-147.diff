diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_reports_volume.py b/tests/unit/test_reports_volume.py
--- a/tests/unit/test_reports_volume.py	1969-12-31 19:00:00
+++ b/tests/unit/test_reports_volume.py	2026-11-12 02:05:19
@@ -0,0 +1,38 @@
+import pytest
+
+from parcelo import customers, reports, shipments
+
+
+def _book(customer_id, n):
+    for _ in range(n):
+        shipments.create_shipment(customer_id, 1.0, "local")
+
+
+def test_customer_without_shipments_is_included():
+    c = customers.add_customer("Idle")
+    report = reports.volume_report()
+    assert report[c.id] == {"shipments": 0, "tier": "starter"}
+
+
+def test_counts_only_own_shipments():
+    a = customers.add_customer("A")
+    b = customers.add_customer("B")
+    _book(a.id, 3)
+    _book(b.id, 5)
+    report = reports.volume_report()
+    assert report[a.id]["shipments"] == 3
+    assert report[b.id]["shipments"] == 5
+
+
+def test_empty_store_returns_empty_dict():
+    assert reports.volume_report() == {}
+
+
+@pytest.mark.parametrize(
+    "count, tier",
+    [(9, "starter"), (10, "regular"), (49, "regular"), (50, "bulk")],
+)
+def test_tier_boundaries(count, tier):
+    c = customers.add_customer("T")
+    _book(c.id, count)
+    assert reports.volume_report()[c.id] == {"shipments": count, "tier": tier}
