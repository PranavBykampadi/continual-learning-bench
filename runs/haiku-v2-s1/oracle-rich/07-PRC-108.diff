@@ -0,0 +1,57 @@
+from parcelo import reports, store
+from parcelo.money import Money
+from parcelo.models import Customer, Invoice, Shipment
+
+
+def _setup():
+    store.db.customers["C_A"] = Customer(id="C_A", name="Acme")
+    store.db.customers["C_B"] = Customer(id="C_B", name="Birch")
+    store.db.customers["C_C"] = Customer(id="C_C", name="Cedar")
+    store.db.shipments["shp_1"] = Shipment(id="shp_1", customer_id="C_A", weight_kg=1, zone="local")
+    store.db.shipments["shp_2"] = Shipment(id="shp_2", customer_id="C_A", weight_kg=2, zone="local")
+    store.db.shipments["shp_3"] = Shipment(id="shp_3", customer_id="C_B", weight_kg=3, zone="local")
+
+
+def _invoice(invoice_id, shipment_id, amount, status="open"):
+    store.db.invoices[invoice_id] = Invoice(
+        id=invoice_id, shipment_id=shipment_id, amount=amount, status=status
+    )
+
+
+def test_sums_open_invoices_per_customer_as_money():
+    _setup()
+    _invoice("INV-1", "shp_1", 10.25)
+    _invoice("INV-2", "shp_2", 4.50)
+    _invoice("INV-3", "shp_3", 7.00)
+
+    result = reports.outstanding_by_customer()
+
+    assert result["C_A"] == Money(1475)
+    assert result["C_B"] == Money(700)
+    assert all(isinstance(v, Money) for v in result.values())
+
+
+def test_paid_and_void_invoices_are_excluded():
+    _setup()
+    _invoice("INV-1", "shp_1", 10.00, status="paid")
+    _invoice("INV-2", "shp_2", 5.00, status="void")
+    _invoice("INV-3", "shp_2", 2.00, status="open")
+
+    result = reports.outstanding_by_customer()
+
+    assert result["C_A"] == Money(200)
+
+
+def test_customer_without_open_invoices_maps_to_zero():
+    _setup()
+    _invoice("INV-1", "shp_3", 9.00, status="paid")
+
+    result = reports.outstanding_by_customer()
+
+    assert result["C_B"] == Money.zero()
+    assert result["C_C"] == Money.zero()
+    assert set(result) == {"C_A", "C_B", "C_C"}
+
+
+def test_empty_database():
+    assert reports.outstanding_by_customer() == {}
