 from datetime import datetime
 
+from parcelo.money import Money
 from parcelo.store import db
+
+
+def outstanding_by_customer():
+    """Map each customer id to the total Money of that customer's open invoices.
+
+    Invoices are linked to customers through their shipment. Paid and void
+    invoices are excluded. Customers with nothing open map to Money.zero().
+    """
+    totals = {customer_id: Money.zero() for customer_id in db.customers}
+    for invoice in db.invoices.values():
+        if invoice.status != "open":
+            continue
+        customer_id = db.shipments[invoice.shipment_id].customer_id
+        totals[customer_id] = totals.get(customer_id, Money.zero()) + Money.parse(invoice.amount)
+    return totals
 
 
