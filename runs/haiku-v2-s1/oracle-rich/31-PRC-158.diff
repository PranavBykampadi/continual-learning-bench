+import pytest
+
+from parcelo import clock, customers, events, returns, shipments
+from parcelo.errors import DomainError
+from parcelo.store import db
+
+
+def _delivered_shipment():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 2.0, "national")
+    s.status = "delivered"
+    return s
+
+
+def test_request_return_creates_and_stores_request():
+    s = _delivered_shipment()
+    clock.set_fixed("2026-11-12T00:00:00+00:00")
+    r = returns.request_return(s.id, "damaged")
+    assert r.id.startswith("ret_")
+    assert r.shipment_id == s.id
+    assert r.reason == "damaged"
+    assert r.requested_at == "2026-11-12T00:00:00+00:00"
+    assert db.returns[r.id] is r
+    assert returns.returns_for(s.id) == [r]
+
+
+def test_request_return_emits_event():
+    s = _delivered_shipment()
+    events.OUTBOX.clear()
+    r = returns.request_return(s.id, "late")
+    assert events.OUTBOX[-1]["name"] == "return.requested"
+    assert events.OUTBOX[-1]["entity_id"] == r.id
+
+
+def test_unknown_shipment_fails():
+    with pytest.raises(DomainError) as err:
+        returns.request_return("shp_nope", "damaged")
+    assert err.value.code == "E_NOT_FOUND"
+
+
+def test_undelivered_shipment_fails():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 2.0, "national")
+    with pytest.raises(DomainError) as err:
+        returns.request_return(s.id, "damaged")
+    assert err.value.code == "E_BAD_STATE"
+    assert returns.returns_for(s.id) == []
+
+
+def test_fourth_request_fails():
+    s = _delivered_shipment()
+    for _ in range(3):
+        returns.request_return(s.id, "damaged")
+    with pytest.raises(DomainError) as err:
+        returns.request_return(s.id, "damaged")
+    assert err.value.code == "E_LIMIT"
+    assert len(returns.returns_for(s.id)) == 3
+
+
