+"""Business thresholds, limits and rates used by new code."""
+
+# Volume rebate (PRC-161): shipment-count cut-offs and rebate rates.
+REBATE_TIER1_MIN_SHIPMENTS = 10
+REBATE_TIER1_RATE = 0.03
+REBATE_TIER2_MIN_SHIPMENTS = 50
+REBATE_TIER2_RATE = 0.06
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_rebate.py b/tests/unit/test_rebate.py
--- a/tests/unit/test_rebate.py	1969-12-31 19:00:00
+++ b/tests/unit/test_rebate.py	2026-11-12 02:13:33
@@ -0,0 +1,64 @@
+import pytest
+
+from parcelo import customers, invoices, shipments
+from parcelo.errors import DomainError
+from parcelo.money import Money
+from parcelo.store import db
+
+
+def _customer_with_shipments(count, paid_amount=None):
+    """Create a customer with `count` shipments; the first one gets a paid invoice."""
+    c = customers.add_customer("Acme")
+    created = [shipments.create_shipment(c.id, 1.0, "local") for _ in range(count)]
+    if paid_amount is not None:
+        inv = invoices.issue_invoice(created[0].id)
+        inv.amount = paid_amount
+        inv.status = "paid"
+    return c
+
+
+def test_zero_below_ten_shipments():
+    c = _customer_with_shipments(9, paid_amount=100.0)
+    assert customers.rebate_for(c.id) == Money.zero()
+
+
+def test_three_percent_at_ten_shipments():
+    c = _customer_with_shipments(10, paid_amount=100.0)
+    assert customers.rebate_for(c.id) == Money(300)
+
+
+def test_three_percent_below_fifty_shipments():
+    c = _customer_with_shipments(49, paid_amount=200.0)
+    assert customers.rebate_for(c.id) == Money(600)
+
+
+def test_six_percent_at_fifty_shipments():
+    c = _customer_with_shipments(50, paid_amount=100.0)
+    assert customers.rebate_for(c.id) == Money(600)
+
+
+def test_only_paid_invoices_count():
+    c = _customer_with_shipments(10)
+    s = shipments.create_shipment(c.id, 1.0, "local")
+    inv = invoices.issue_invoice(s.id)
+    inv.amount = 500.0
+    assert inv.status == "open"
+    assert customers.rebate_for(c.id) == Money.zero()
+
+
+def test_other_customers_invoices_ignored():
+    c = _customer_with_shipments(10, paid_amount=100.0)
+    other = _customer_with_shipments(1, paid_amount=1000.0)
+    assert customers.rebate_for(c.id) == Money(300)
+    assert customers.rebate_for(other.id) == Money.zero()
+
+
+def test_no_invoices_gives_zero():
+    c = _customer_with_shipments(10)
+    assert customers.rebate_for(c.id) == Money.zero()
+
+
+def test_unknown_customer_fails():
+    with pytest.raises(DomainError) as err:
+        customers.rebate_for("C_missing")
+    assert err.value.code == "E_UNKNOWN_CUSTOMER"
