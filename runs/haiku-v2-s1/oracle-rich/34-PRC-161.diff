+def rebate_for(customer_id):
+    """Volume rebate earned by a customer: a share of total paid invoices.
+
+    Zero below REBATE_TIER1_MIN_SHIPMENTS shipments; REBATE_TIER1_RATE from
+    that count; REBATE_TIER2_RATE from REBATE_TIER2_MIN_SHIPMENTS shipments.
+    """
+    if customer_id not in db.customers:
+        raise DomainError("E_UNKNOWN_CUSTOMER", customer_id)
+
+    shipment_count = sum(
+        1 for shipment in db.shipments.values() if shipment.customer_id == customer_id
+    )
+    if shipment_count >= REBATE_TIER2_MIN_SHIPMENTS:
+        rate = REBATE_TIER2_RATE
+    elif shipment_count >= REBATE_TIER1_MIN_SHIPMENTS:
+        rate = REBATE_TIER1_RATE
+    else:
+        return Money.zero()
+
+    paid = Money.zero()
+    for invoice in db.invoices.values():
+        shipment = db.shipments[invoice.shipment_id]
+        if shipment.customer_id == customer_id and invoice.status == "paid":
+            paid = paid + Money.parse(invoice.amount)
+    return paid.scale(rate)
