+def set_credit_limit(customer_id, amount):
+    """Set a customer's credit limit to amount (dollars); returns the new limit as Money."""
+    if customer_id not in db.customers:
+        raise DomainError("E_UNKNOWN_CUSTOMER", customer_id)
+    try:
+        limit = Money.parse(amount)
+    except (InvalidOperation, TypeError, ValueError):
+        raise DomainError("E_BAD_INPUT", f"credit limit {amount!r} is not an amount")
+    if limit.cents < 0:
+        raise DomainError("E_BAD_INPUT", "credit limit cannot be negative")
+    customer = db.customers[customer_id]
+    customer.credit_limit = limit
+    events.emit("customer.credit_limit_set", customer_id, cents=limit.cents)
+    return limit
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_customers_credit_limit.py b/tests/unit/test_customers_credit_limit.py
--- a/tests/unit/test_customers_credit_limit.py	1969-12-31 19:00:00
+++ b/tests/unit/test_customers_credit_limit.py	2026-11-12 02:07:39
@@ -0,0 +1,49 @@
+import pytest
+
+from parcelo import customers, events
+from parcelo.errors import DomainError
+from parcelo.money import Money
+
+
+def test_set_credit_limit_updates_and_returns_money():
+    c = customers.add_customer("Acme")
+    limit = customers.set_credit_limit(c.id, 1200.50)
+    assert limit == Money(120050)
+    assert customers.get_customer(c.id).credit_limit == Money(120050)
+
+
+def test_set_credit_limit_emits_event():
+    c = customers.add_customer("Acme")
+    customers.set_credit_limit(c.id, 250)
+    assert events.OUTBOX[-1]["name"] == "customer.credit_limit_set"
+    assert events.OUTBOX[-1]["entity_id"] == c.id
+    assert events.OUTBOX[-1]["payload"] == {"cents": 25000}
+
+
+def test_zero_limit_allowed():
+    c = customers.add_customer("Acme")
+    assert customers.set_credit_limit(c.id, 0) == Money(0)
+
+
+def test_unknown_customer_fails():
+    with pytest.raises(DomainError) as err:
+        customers.set_credit_limit("nope", 100)
+    assert err.value.code == "E_UNKNOWN_CUSTOMER"
+    assert events.OUTBOX == []
+
+
+def test_negative_amount_fails():
+    c = customers.add_customer("Acme")
+    before = customers.get_customer(c.id).credit_limit
+    with pytest.raises(DomainError) as err:
+        customers.set_credit_limit(c.id, -1)
+    assert err.value.code == "E_BAD_INPUT"
+    assert customers.get_customer(c.id).credit_limit == before
+    assert events.OUTBOX == []
+
+
+def test_unparseable_amount_fails():
+    c = customers.add_customer("Acme")
+    with pytest.raises(DomainError) as err:
+        customers.set_credit_limit(c.id, "lots")
+    assert err.value.code == "E_BAD_INPUT"
