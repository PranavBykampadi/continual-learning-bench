@@ -0,0 +1,15 @@
+"""Business thresholds, limits and rates used by new code."""
+from decimal import Decimal
+
+# Insurance on declared-value shipments (PRC-144).
+INSURANCE_RATE_PERCENT = Decimal("2")
+# Minimum insurance fee, in cents (1.00 USD).
+MIN_INSURANCE_FEE_CENTS = 100
+
+# Fuel surcharge percentages per zone. Same values as legacy billing.fuel_surcharge,
+# reimplemented here because parcelo.legacy is being deleted.
+FUEL_SURCHARGE_PERCENT = {
+    "local": Decimal("0"),
+    "national": Decimal("4"),
+    "international": Decimal("9.5"),
+}
