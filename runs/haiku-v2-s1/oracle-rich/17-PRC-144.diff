+from decimal import Decimal, InvalidOperation
+
+from parcelo import settings
+from parcelo.errors import DomainError
+from parcelo.money import Money
+
 ZONE_BASE = {"local": 4.5, "national": 9.0, "international": 24.0}
 PER_KG = 1.25
+
+
+def insurance_fee(declared_value, zone):
+    """Insurance fee as Money: (rate + zone fuel surcharge) % of declared value, minimum 1.00.
+
+    Raises DomainError E_BAD_ZONE for an unknown zone and E_BAD_INPUT for a
+    declared value that is not a number or is zero or negative.
+    """
+    if zone not in settings.FUEL_SURCHARGE_PERCENT:
+        raise DomainError("E_BAD_ZONE", "unknown zone: %s" % zone)
+    try:
+        value = Money.parse(declared_value)
+    except (InvalidOperation, TypeError, ValueError):
+        raise DomainError("E_BAD_INPUT", "declared value must be a number")
+    if value.cents <= 0:
+        raise DomainError("E_BAD_INPUT", "declared value must be positive")
+    percent = settings.INSURANCE_RATE_PERCENT + settings.FUEL_SURCHARGE_PERCENT[zone]
+    fee = value.scale(percent / Decimal("100"))
+    minimum = Money(settings.MIN_INSURANCE_FEE_CENTS)
+    if fee < minimum:
+        return minimum
+    return fee
 
 
