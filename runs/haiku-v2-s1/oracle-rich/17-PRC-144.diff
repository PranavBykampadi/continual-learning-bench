+++ b/tests/unit/test_insurance.py	2026-11-12 02:03:35
@@ -0,0 +1,53 @@
+import pytest
+
+from parcelo import rates
+from parcelo.errors import DomainError
+from parcelo.money import Money
+
+
+def test_local_fee_is_two_percent():
+    # 2% of 500.00 = 10.00, no fuel surcharge in local zone
+    assert rates.insurance_fee(500, "local") == Money(1000)
+
+
+def test_national_includes_fuel_surcharge():
+    # (2% + 4%) of 200.00 = 12.00
+    assert rates.insurance_fee(200, "national") == Money(1200)
+
+
+def test_international_fractional_percent():
+    # (2% + 9.5%) of 100.00 = 11.50
+    assert rates.insurance_fee("100", "international") == Money(1150)
+
+
+def test_returns_money_not_float():
+    assert isinstance(rates.insurance_fee(50, "local"), Money)
+
+
+def test_minimum_fee_applies():
+    # 2% of 10.00 = 0.20, raised to the 1.00 minimum
+    assert rates.insurance_fee(10, "local") == Money(100)
+
+
+def test_rounds_half_up_to_cents():
+    # 2% of 1234.56 = 24.6912 -> 24.69
+    assert rates.insurance_fee(1234.56, "local") == Money(2469)
+
+
+def test_unknown_zone_fails():
+    with pytest.raises(DomainError) as err:
+        rates.insurance_fee(100, "mars")
+    assert err.value.code == "E_BAD_ZONE"
+
+
+@pytest.mark.parametrize("value", [0, -5, -0.01])
+def test_non_positive_value_fails(value):
+    with pytest.raises(DomainError) as err:
+        rates.insurance_fee(value, "local")
+    assert err.value.code == "E_BAD_INPUT"
+
+
+def test_non_numeric_value_fails():
+    with pytest.raises(DomainError) as err:
+        rates.insurance_fee("abc", "local")
+    assert err.value.code == "E_BAD_INPUT"
