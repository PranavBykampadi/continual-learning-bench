diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_invoice_write_off.py b/tests/unit/test_invoice_write_off.py
--- a/tests/unit/test_invoice_write_off.py	1969-12-31 19:00:00
+++ b/tests/unit/test_invoice_write_off.py	2026-11-12 02:04:33
@@ -0,0 +1,67 @@
+import pytest
+
+from parcelo import clock, events, invoices, customers, shipments
+from parcelo.errors import DomainError
+from parcelo.money import Money
+from parcelo.store import db
+
+
+def _open_invoice():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 2, "local")
+    return invoices.issue_invoice(s.id)
+
+
+def test_write_off_open_invoice():
+    inv = _open_invoice()
+    amount = invoices.write_off(inv.id)
+    assert amount == Money(700)
+    assert db.invoices[inv.id].status == "written_off"
+
+
+def test_write_off_sets_time_from_clock():
+    moment = clock.now().replace(year=2026, month=11, day=12, hour=9, minute=0, second=0, microsecond=0)
+    clock.set_fixed(moment)
+    try:
+        inv = _open_invoice()
+        invoices.write_off(inv.id)
+        assert db.invoices[inv.id].written_off_at == moment
+    finally:
+        clock.clear_fixed()
+
+
+def test_write_off_emits_event():
+    inv = _open_invoice()
+    events.OUTBOX.clear()
+    invoices.write_off(inv.id)
+    assert len(events.OUTBOX) == 1
+    assert events.OUTBOX[-1]["name"] == "invoice.written_off"
+    assert events.OUTBOX[-1]["entity_id"] == inv.id
+    assert events.OUTBOX[-1]["payload"] == {"cents": 700}
+
+
+def test_write_off_is_idempotent():
+    inv = _open_invoice()
+    invoices.write_off(inv.id)
+    first_time = db.invoices[inv.id].written_off_at
+    events.OUTBOX.clear()
+    amount = invoices.write_off(inv.id)
+    assert amount == Money(700)
+    assert db.invoices[inv.id].status == "written_off"
+    assert db.invoices[inv.id].written_off_at == first_time
+    assert events.OUTBOX == []
+
+
+def test_write_off_paid_invoice_rejected():
+    inv = _open_invoice()
+    invoices.mark_paid(inv.id)
+    with pytest.raises(DomainError) as err:
+        invoices.write_off(inv.id)
+    assert err.value.code == "E_BAD_STATE"
+    assert db.invoices[inv.id].status == "paid"
+
+
+def test_write_off_unknown_invoice():
+    with pytest.raises(DomainError) as err:
+        invoices.write_off("INV-nope")
+    assert err.value.code == "E_NOT_FOUND"
