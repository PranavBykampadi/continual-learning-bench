--- a/parcelo/shipments.py	2026-11-10 12:20:18
+++ b/parcelo/shipments.py	2026-11-12 02:01:58
@@ -28,3 +28,26 @@
     if shipment_id not in db.shipments:
         raise DomainError("E_NOT_FOUND", shipment_id)
     return db.shipments[shipment_id]
+
+
+def reassign_shipment(shipment_id, new_customer_id):
+    """Move a shipment to another customer. Delivered shipments cannot be reassigned.
+
+    Reassigning to the customer it already belongs to returns it unchanged, with no event.
+    """
+    shipment = get_shipment(shipment_id)
+    if new_customer_id not in db.customers:
+        raise DomainError("E_UNKNOWN_CUSTOMER", new_customer_id)
+    if shipment.status == "delivered" or shipment.delivered_at is not None:
+        raise DomainError("E_BAD_STATE", shipment_id)
+    if shipment.customer_id == new_customer_id:
+        return shipment
+    previous_customer_id = shipment.customer_id
+    shipment.customer_id = new_customer_id
+    events.emit(
+        "shipment.reassigned",
+        shipment.id,
+        from_customer_id=previous_customer_id,
+        to_customer_id=new_customer_id,
+    )
+    return shipment
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_reassign_shipment.py b/tests/unit/test_reassign_shipment.py
--- a/tests/unit/test_reassign_shipment.py	1969-12-31 19:00:00
+++ b/tests/unit/test_reassign_shipment.py	2026-11-12 02:02:04
@@ -0,0 +1,86 @@
+import pytest
+
+from parcelo import customers, events, shipments, store
+from parcelo.errors import DomainError
+
+
+def _setup():
+    a = customers.add_customer("Acme")
+    b = customers.add_customer("Globex")
+    s = shipments.create_shipment(a.id, 2.0, "national")
+    return a, b, s
+
+
+def test_reassign_changes_customer_and_returns_shipment():
+    a, b, s = _setup()
+    events.OUTBOX.clear()
+    result = shipments.reassign_shipment(s.id, b.id)
+    assert result is s
+    assert result.customer_id == b.id
+    assert store.db.shipments[s.id].customer_id == b.id
+
+
+def test_reassign_emits_event_with_old_and_new_customer():
+    a, b, s = _setup()
+    events.OUTBOX.clear()
+    shipments.reassign_shipment(s.id, b.id)
+    assert len(events.OUTBOX) == 1
+    event = events.OUTBOX[-1]
+    assert event["name"] == "shipment.reassigned"
+    assert event["entity_id"] == s.id
+    assert event["payload"] == {"from_customer_id": a.id, "to_customer_id": b.id}
+
+
+def test_reassign_unknown_shipment_fails():
+    _, b, _ = _setup()
+    with pytest.raises(DomainError) as err:
+        shipments.reassign_shipment("shp_999999", b.id)
+    assert err.value.code == "E_NOT_FOUND"
+
+
+def test_reassign_to_unknown_customer_fails():
+    _, _, s = _setup()
+    events.OUTBOX.clear()
+    with pytest.raises(DomainError) as err:
+        shipments.reassign_shipment(s.id, "nope")
+    assert err.value.code == "E_UNKNOWN_CUSTOMER"
+    assert store.db.shipments[s.id].customer_id != "nope"
+    assert events.OUTBOX == []
+
+
+def test_reassign_delivered_shipment_fails_by_status():
+    a, b, s = _setup()
+    s.status = "delivered"
+    events.OUTBOX.clear()
+    with pytest.raises(DomainError) as err:
+        shipments.reassign_shipment(s.id, b.id)
+    assert err.value.code == "E_BAD_STATE"
+    assert store.db.shipments[s.id].customer_id == a.id
+    assert events.OUTBOX == []
+
+
+def test_reassign_delivered_shipment_fails_by_delivered_at():
+    a, b, s = _setup()
+    s.delivered_at = object()
+    with pytest.raises(DomainError) as err:
+        shipments.reassign_shipment(s.id, b.id)
+    assert err.value.code == "E_BAD_STATE"
+    assert store.db.shipments[s.id].customer_id == a.id
+
+
+def test_reassign_to_same_customer_is_noop_without_event():
+    a, _, s = _setup()
+    events.OUTBOX.clear()
+    result = shipments.reassign_shipment(s.id, a.id)
+    assert result is s
+    assert result.customer_id == a.id
+    assert events.OUTBOX == []
+
+
+def test_reassign_twice_second_call_is_noop():
+    _, b, s = _setup()
+    shipments.reassign_shipment(s.id, b.id)
+    events.OUTBOX.clear()
+    shipments.reassign_shipment(s.id, b.id)
+    assert store.db.shipments[s.id].customer_id == b.id
+    assert events.OUTBOX == []
