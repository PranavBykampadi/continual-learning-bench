diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_pickups.py b/tests/unit/test_pickups.py
--- a/tests/unit/test_pickups.py	1969-12-31 19:00:00
+++ b/tests/unit/test_pickups.py	2026-11-12 02:02:52
@@ -0,0 +1,54 @@
+from datetime import datetime, timezone
+
+import pytest
+
+from parcelo import clock, customers, events, pickups, shipments
+from parcelo.errors import DomainError
+from parcelo.models import Pickup
+
+
+def _created_shipment():
+    c = customers.add_customer("Acme")
+    return shipments.create_shipment(c.id, 2.0, "national")
+
+
+def test_schedule_pickup_creates_and_stores():
+    s = _created_shipment()
+    start = datetime(2026, 11, 13, 9, 0, tzinfo=timezone.utc)
+    clock.set_fixed(datetime(2026, 11, 12, 12, 0, tzinfo=timezone.utc))
+
+    p = pickups.schedule_pickup(s.id, start)
+
+    assert isinstance(p, Pickup)
+    assert p.id.startswith("pkp_")
+    assert p.shipment_id == s.id
+    assert p.window_start == start
+    assert p.scheduled_at == datetime(2026, 11, 12, 12, 0, tzinfo=timezone.utc)
+    from parcelo.store import db
+
+    assert db.pickups[p.id] is p
+
+
+def test_schedule_pickup_emits_event():
+    s = _created_shipment()
+    p = pickups.schedule_pickup(s.id, datetime(2026, 11, 13, tzinfo=timezone.utc))
+    assert events.OUTBOX[-1]["name"] == "pickup.scheduled"
+    assert events.OUTBOX[-1]["entity_id"] == p.id
+
+
+def test_unknown_shipment_fails():
+    with pytest.raises(DomainError) as err:
+        pickups.schedule_pickup("shp_missing", datetime(2026, 11, 13, tzinfo=timezone.utc))
+    assert err.value.code == "E_NOT_FOUND"
+
+
+@pytest.mark.parametrize("status", ["in_transit", "delivered", "cancelled"])
+def test_shipment_not_created_fails(status):
+    s = _created_shipment()
+    s.status = status
+    with pytest.raises(DomainError) as err:
+        pickups.schedule_pickup(s.id, datetime(2026, 11, 13, tzinfo=timezone.utc))
+    assert err.value.code == "E_BAD_STATE"
+    from parcelo.store import db
+
+    assert db.pickups == {}
