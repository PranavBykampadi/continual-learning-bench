+++ b/tests/unit/test_split_shipment.py	2026-11-12 02:07:05
@@ -0,0 +1,82 @@
+import pytest
+
+from parcelo import customers, events, shipments
+from parcelo.errors import DomainError
+from parcelo.store import db
+
+
+def _created(weight=10.0, zone="national"):
+    c = customers.add_customer("Acme")
+    return shipments.create_shipment(c.id, weight, zone)
+
+
+def test_split_returns_new_shipments_in_weight_order():
+    s = _created(10.0)
+    parts = shipments.split_shipment(s.id, [3.0, 7.0])
+    assert [p.weight_kg for p in parts] == [3.0, 7.0]
+    assert [p.id for p in parts] == sorted(p.id for p in parts)
+    for p in parts:
+        assert p.customer_id == s.customer_id
+        assert p.zone == s.zone
+        assert p.status == "created"
+        assert db.shipments[p.id] is p
+
+
+def test_split_marks_original_as_split():
+    s = _created(10.0)
+    shipments.split_shipment(s.id, [5.0, 5.0])
+    assert db.shipments[s.id].status == "split"
+
+
+def test_split_tolerates_float_rounding():
+    s = _created(0.3)
+    parts = shipments.split_shipment(s.id, [0.1, 0.2])
+    assert len(parts) == 2
+
+
+def test_split_emits_events():
+    s = _created(10.0)
+    events.OUTBOX.clear()
+    parts = shipments.split_shipment(s.id, [4.0, 6.0])
+    names = [e["name"] for e in events.OUTBOX]
+    assert names == ["shipment.created", "shipment.created", "shipment.split"]
+    assert events.OUTBOX[-1]["entity_id"] == s.id
+    assert events.OUTBOX[-1]["payload"]["new_ids"] == [p.id for p in parts]
+
+
+def test_split_unknown_shipment_fails():
+    with pytest.raises(DomainError) as err:
+        shipments.split_shipment("shp_999999", [1.0])
+    assert err.value.code == "E_NOT_FOUND"
+
+
+def test_split_non_created_shipment_fails():
+    s = _created(10.0)
+    shipments.split_shipment(s.id, [5.0, 5.0])
+    with pytest.raises(DomainError) as err:
+        shipments.split_shipment(s.id, [5.0, 5.0])
+    assert err.value.code == "E_BAD_STATE"
+
+
+def test_split_weights_must_sum_to_original():
+    s = _created(10.0)
+    with pytest.raises(DomainError) as err:
+        shipments.split_shipment(s.id, [3.0, 3.0])
+    assert err.value.code == "E_BAD_INPUT"
+    assert db.shipments[s.id].status == "created"
+    assert len(db.shipments) == 1
+
+
