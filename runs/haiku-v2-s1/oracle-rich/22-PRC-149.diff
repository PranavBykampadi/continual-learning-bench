+def split_shipment(shipment_id, weights):
+    """Replace a created shipment with one new shipment per weight.
+
+    Returns the new shipments sorted by id ascending (which is also the order
+    of `weights`, since ids are issued in creation order).
+    """
+    shipment = get_shipment(shipment_id)
+    if shipment.status != "created":
+        raise DomainError("E_BAD_STATE", f"{shipment_id} is {shipment.status}")
+    weights = list(weights)
+    if not weights:
+        raise DomainError("E_BAD_INPUT", "no weights given")
+    for weight in weights:
+        if weight <= 0:
+            raise DomainError("E_BAD_WEIGHT", str(weight))
+    if abs(sum(weights) - shipment.weight_kg) > SPLIT_WEIGHT_TOLERANCE_KG:
+        raise DomainError(
+            "E_BAD_INPUT",
+            f"weights sum to {sum(weights)}, expected {shipment.weight_kg}",
+        )
+
+    new_shipments = []
+    for weight in weights:
+        new = Shipment(
+            id=ids.new_id("shp"),
+            customer_id=shipment.customer_id,
+            weight_kg=weight,
+            zone=shipment.zone,
+            created_at=clock.now(),
+        )
+        db.shipments[new.id] = new
+        new_shipments.append(new)
+    shipment.status = "split"
+
+    for new in new_shipments:
+        events.emit("shipment.created", new.id, zone=new.zone)
+    events.emit(
+        "shipment.split", shipment.id, new_ids=[new.id for new in new_shipments]
+    )
+    return sorted(new_shipments, key=lambda s: s.id)
