+"""Business thresholds, limits and rates used by new code."""
+
+# Tolerance when checking that split weights add up to the original weight.
+# Float addition is inexact (0.1 + 0.2 != 0.3), so an exact comparison would
+# reject valid splits.
+SPLIT_WEIGHT_TOLERANCE_KG = 1e-6
