diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_invoice_reopen.py b/tests/unit/test_invoice_reopen.py
--- a/tests/unit/test_invoice_reopen.py	1969-12-31 19:00:00
+++ b/tests/unit/test_invoice_reopen.py	2026-11-12 02:02:32
@@ -0,0 +1,68 @@
+from datetime import datetime, timezone
+
+import pytest
+
+from parcelo import clock, customers, events, invoices, shipments
+from parcelo.errors import DomainError
+
+
+def _paid_invoice():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 2, "local")
+    inv = invoices.issue_invoice(s.id)
+    invoices.mark_paid(inv.id)
+    return inv
+
+
+def test_reopen_paid_invoice_sets_open_and_clears_paid_at():
+    inv = _paid_invoice()
+    assert inv.paid_at is not None
+
+    result = invoices.reopen_invoice(inv.id)
+
+    assert result is inv
+    assert result.status == "open"
+    assert result.paid_at is None
+    assert result.reopened_at is not None
+    assert inv.id in invoices.db.invoices
+    assert inv in invoices.open_invoices()
+
+
+def test_reopened_at_uses_clock():
+    moment = datetime(2026, 11, 12, 9, 0, tzinfo=timezone.utc)
+    clock.set_fixed(moment)
+    inv = _paid_invoice()
+    invoices.reopen_invoice(inv.id)
+    assert inv.reopened_at == moment
+
+
+def test_reopen_emits_event():
+    inv = _paid_invoice()
+    events.OUTBOX.clear()
+
+    invoices.reopen_invoice(inv.id)
+
+    assert len(events.OUTBOX) == 1
+    assert events.OUTBOX[-1]["name"] == "invoice.reopened"
+    assert events.OUTBOX[-1]["entity_id"] == inv.id
+
+
+def test_reopen_missing_invoice_fails():
+    with pytest.raises(DomainError) as err:
+        invoices.reopen_invoice("INV-missing")
+    assert err.value.code == "E_NOT_FOUND"
+
+
+def test_reopen_unpaid_invoice_fails():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 2, "local")
+    inv = invoices.issue_invoice(s.id)
+    events.OUTBOX.clear()
+
+    with pytest.raises(DomainError) as err:
+        invoices.reopen_invoice(inv.id)
+
+    assert err.value.code == "E_BAD_STATE"
+    assert inv.status == "open"
+    assert inv.reopened_at is None
+    assert events.OUTBOX == []
