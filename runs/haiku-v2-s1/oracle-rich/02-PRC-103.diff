+@dataclass(frozen=True)
+class SurchargedQuote:
+    base: Money
+    surcharge: Money
+
+    @property
+    def total(self):
+        return self.base + self.surcharge
+
+
+def quote_with_surcharge(weight_kg, zone):
+    """Return the base quote, the fuel surcharge for the zone, and their total."""
+    if zone not in FUEL_SURCHARGE:
+        raise DomainError("E_BAD_ZONE", "unknown zone: %s" % zone)
+    if weight_kg <= 0:
+        raise DomainError("E_BAD_WEIGHT", "weight must be positive")
+    base = Money.parse(quote(weight_kg, zone))
+    surcharge = base.scale(FUEL_SURCHARGE[zone])
+    return SurchargedQuote(base=base, surcharge=surcharge)
