 def open_invoices():
     return [i for i in db.invoices.values() if i.status == "open"]
+
+
+def escalate_invoice(invoice_id):
+    """Send an open invoice of at least ESCALATION_MIN_CENTS to collections.
+
+    Escalating an already escalated invoice returns it unchanged and emits nothing.
+    """
+    if invoice_id not in db.invoices:
+        raise DomainError("E_NOT_FOUND", invoice_id)
+    invoice = db.invoices[invoice_id]
+    if invoice.status == "escalated":
+        return invoice
+    if invoice.status != "open":
+        raise DomainError("E_BAD_STATE", f"{invoice_id} is {invoice.status}")
+    amount = Money.parse(invoice.amount)
+    if amount.cents < ESCALATION_MIN_CENTS:
+        raise DomainError("E_BELOW_THRESHOLD", f"{invoice_id} is {amount}")
+    invoice.status = "escalated"
+    events.emit("invoice.escalated", invoice.id, amount_cents=amount.cents)
+    return invoice
