diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_invoice_escalation.py b/tests/unit/test_invoice_escalation.py
--- a/tests/unit/test_invoice_escalation.py	1969-12-31 19:00:00
+++ b/tests/unit/test_invoice_escalation.py	2026-11-12 02:17:07
@@ -0,0 +1,59 @@
+import pytest
+
+from parcelo import events, invoices
+from parcelo.errors import DomainError
+from parcelo.models import Invoice
+from parcelo.store import db
+
+
+def _add_invoice(invoice_id, amount, status="open"):
+    inv = Invoice(id=invoice_id, shipment_id="shp_x", amount=amount, status=status)
+    db.invoices[invoice_id] = inv
+    return inv
+
+
+def test_escalates_open_invoice_at_threshold():
+    _add_invoice("INV-1", 500.00)
+    inv = invoices.escalate_invoice("INV-1")
+    assert inv.status == "escalated"
+    assert db.invoices["INV-1"].status == "escalated"
+
+
+def test_emits_event_on_escalation():
+    _add_invoice("INV-1", 750.5)
+    invoices.escalate_invoice("INV-1")
+    assert events.OUTBOX[-1]["name"] == "invoice.escalated"
+    assert events.OUTBOX[-1]["entity_id"] == "INV-1"
+    assert events.OUTBOX[-1]["payload"] == {"amount_cents": 75050}
+
+
+def test_below_threshold_rejected():
+    _add_invoice("INV-2", 499.99)
+    with pytest.raises(DomainError) as err:
+        invoices.escalate_invoice("INV-2")
+    assert err.value.code == "E_BELOW_THRESHOLD"
+    assert db.invoices["INV-2"].status == "open"
+    assert events.OUTBOX == []
+
+
+def test_unknown_invoice_rejected():
+    with pytest.raises(DomainError) as err:
+        invoices.escalate_invoice("INV-missing")
+    assert err.value.code == "E_NOT_FOUND"
+
+
+def test_paid_invoice_rejected():
+    _add_invoice("INV-3", 900.0, status="paid")
+    with pytest.raises(DomainError) as err:
+        invoices.escalate_invoice("INV-3")
+    assert err.value.code == "E_BAD_STATE"
+    assert db.invoices["INV-3"].status == "paid"
+
+
+def test_escalating_again_is_idempotent():
+    _add_invoice("INV-4", 600.0)
+    invoices.escalate_invoice("INV-4")
+    events.OUTBOX.clear()
+    inv = invoices.escalate_invoice("INV-4")
+    assert inv.status == "escalated"
+    assert events.OUTBOX == []
