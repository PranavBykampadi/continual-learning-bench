+def list_shipments(customer_id):
+    if customer_id not in db.customers:
+        raise DomainError("E_UNKNOWN_CUSTOMER", customer_id)
+    owned = [s for s in db.shipments.values() if s.customer_id == customer_id]
+    return sorted(owned, key=lambda s: s.id)
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_list_shipments.py b/tests/unit/test_list_shipments.py
--- a/tests/unit/test_list_shipments.py	1969-12-31 19:00:00
+++ b/tests/unit/test_list_shipments.py	2026-11-12 02:08:06
@@ -0,0 +1,52 @@
+import pytest
+
+from parcelo import customers, events, shipments
+from parcelo.errors import DomainError
+from parcelo.store import db
+
+
+def test_list_returns_only_customers_shipments_sorted_by_id():
+    a = customers.add_customer("Acme")
+    b = customers.add_customer("Bolt")
+    s1 = shipments.create_shipment(a.id, 1.0, "local")
+    shipments.create_shipment(b.id, 2.0, "local")
+    s3 = shipments.create_shipment(a.id, 3.0, "national")
+
+    result = shipments.list_shipments(a.id)
+
+    assert [s.id for s in result] == [s1.id, s3.id]
+    assert all(s.customer_id == a.id for s in result)
+
+
+def test_list_is_sorted_by_id_not_storage_order():
+    c = customers.add_customer("Acme")
+    s1 = shipments.create_shipment(c.id, 1.0, "local")
+    s2 = shipments.create_shipment(c.id, 1.0, "local")
+    # Rebuild storage so the later id is inserted first.
+    saved = dict(db.shipments)
+    db.shipments.clear()
+    for shipment in reversed(list(saved.values())):
+        db.shipments[shipment.id] = shipment
+
+    result = shipments.list_shipments(c.id)
+
+    assert [s.id for s in result] == [s1.id, s2.id]
+
+
+def test_list_empty_when_customer_has_no_shipments():
+    c = customers.add_customer("Quiet")
+    assert shipments.list_shipments(c.id) == []
+
+
+def test_list_unknown_customer_fails():
+    with pytest.raises(DomainError) as err:
+        shipments.list_shipments("nope")
+    assert err.value.code == "E_UNKNOWN_CUSTOMER"
+
+
+def test_list_does_not_emit_events():
+    c = customers.add_customer("Acme")
+    shipments.create_shipment(c.id, 1.0, "local")
+    before = len(events.OUTBOX)
+    shipments.list_shipments(c.id)
+    assert len(events.OUTBOX) == before
