diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_refunds.py b/tests/unit/test_refunds.py
--- a/tests/unit/test_refunds.py	1969-12-31 19:00:00
+++ b/tests/unit/test_refunds.py	2026-11-12 01:54:03
@@ -0,0 +1,56 @@
+import pytest
+
+from parcelo import audit, refunds
+from parcelo.errors import DomainError
+from parcelo.models import Invoice
+from parcelo.money import Money
+from parcelo.store import db
+
+
+def _invoice(invoice_id, status):
+    inv = Invoice(id=invoice_id, shipment_id="shp_x", amount=10.0, status=status)
+    db.invoices[invoice_id] = inv
+    return inv
+
+
+def test_refund_paid_invoice_stores_and_returns_refund():
+    _invoice("INV-1", "paid")
+    r = refunds.create_refund("INV-1", 2.5)
+    assert r.id.startswith("ref_")
+    assert r.invoice_id == "INV-1"
+    assert r.amount == Money(250)
+    assert r.created_at is not None
+    assert db.refunds[r.id] is r
+    assert audit.LOG[-1]["action"] == "refund.created"
+    assert audit.LOG[-1]["entity_id"] == r.id
+
+
+def test_refund_accepts_money_amount():
+    _invoice("INV-2", "paid")
+    r = refunds.create_refund("INV-2", Money(199))
+    assert r.amount == Money(199)
+
+
+def test_refund_unknown_invoice_fails():
+    with pytest.raises(DomainError) as err:
+        refunds.create_refund("INV-missing", 1)
+    assert err.value.code == "E_NOT_FOUND"
+    assert db.refunds == {}
+
+
+@pytest.mark.parametrize("status", ["open", "void"])
+def test_refund_unpaid_invoice_fails(status):
+    _invoice("INV-3", status)
+    with pytest.raises(DomainError) as err:
+        refunds.create_refund("INV-3", 1)
+    assert err.value.code == "E_BAD_STATE"
+    assert db.refunds == {}
+
+
+@pytest.mark.parametrize("amount", [0, -5, "abc", None])
+def test_refund_bad_amount_fails(amount):
+    _invoice("INV-4", "paid")
+    with pytest.raises(DomainError) as err:
+        refunds.create_refund("INV-4", amount)
+    assert err.value.code == "E_BAD_INPUT"
+    assert db.refunds == {}
