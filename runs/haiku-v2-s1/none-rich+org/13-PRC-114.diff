+
+def _as_utc(moment):
+    # Legacy invoices store naive UTC datetimes (utcnow); newer code uses aware UTC.
+    if moment.tzinfo is None:
+        return moment.replace(tzinfo=timezone.utc)
+    return moment.astimezone(timezone.utc)
+
+
+def aging_report():
+    """Total open (unpaid) invoice amounts grouped by age in whole days since issue."""
+    now = _as_utc(clock.now())
+    totals = {"0-30": Money.zero(), "31-60": Money.zero(), "60+": Money.zero()}
+    for invoice in db.invoices.values():
+        if invoice.status == "paid":
+            continue
+        age = days_between(_as_utc(invoice.issued_at), now)
+        if age <= 30:
+            bucket = "0-30"
+        elif age <= 60:
+            bucket = "31-60"
+        else:
+            bucket = "60+"
+        totals[bucket] = totals[bucket] + Money.parse(invoice.amount)
+    return {bucket: round(total.cents / 100, 2) for bucket, total in totals.items()}
 
 
