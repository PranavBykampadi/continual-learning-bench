+
+def test_mark_returned_sets_status_and_time():
+    from parcelo import audit, clock
+
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 1.5, "national")
+    s.status = "delivered"
+    moment = datetime(2026, 11, 12, 9, 0, tzinfo=timezone.utc)
+    clock.set_fixed(moment)
+    result = shipments.mark_returned(s.id)
+    assert result is s
+    assert s.status == "returned"
+    assert s.returned_at == moment
+    assert audit.LOG[-1]["action"] == "shipment.returned"
+
+
+def test_mark_returned_rejects_created():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 1.5, "national")
+    with pytest.raises(DomainError) as err:
+        shipments.mark_returned(s.id)
+    assert err.value.code == "E_BAD_STATE"
+    assert s.status == "created"
+    assert s.returned_at is None
+
+
+def test_mark_returned_unknown_shipment():
+    with pytest.raises(DomainError) as err:
+        shipments.mark_returned("shp_missing")
+    assert err.value.code == "E_NOT_FOUND"
 
 
