diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_customers.py b/tests/unit/test_customers.py
--- a/tests/unit/test_customers.py	1969-12-31 19:00:00
+++ b/tests/unit/test_customers.py	2026-11-12 02:10:52
@@ -0,0 +1,24 @@
+import pytest
+
+from parcelo import customers
+from parcelo.errors import DomainError
+from parcelo.store import db
+
+
+def test_reactivate_customer_sets_active_true():
+    c = customers.add_customer("Acme")
+    c.active = False
+    result = customers.reactivate_customer(c.id)
+    assert result is c
+    assert db.customers[c.id].active is True
+
+
+def test_reactivate_already_active_customer_is_noop():
+    c = customers.add_customer("Acme")
+    assert customers.reactivate_customer(c.id).active is True
+
+
+def test_reactivate_unknown_customer_raises():
+    with pytest.raises(DomainError) as err:
+        customers.reactivate_customer("C000000")
+    assert err.value.code == "E_NOT_FOUND"
