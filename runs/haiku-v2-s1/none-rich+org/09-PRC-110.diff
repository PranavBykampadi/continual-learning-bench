diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/parcelo/rates.py b/parcelo/rates.py
--- a/parcelo/rates.py	2026-11-10 12:17:53
+++ b/parcelo/rates.py	2026-11-12 01:59:18
@@ -1,7 +1,14 @@
+from decimal import Decimal
+
+from parcelo.money import Money
+
 ZONE_BASE = {"local": 4.5, "national": 9.0, "international": 24.0}
 PER_KG = 1.25
 
+# Share of the regular quote that a customer pays, by tier. Gold is 10% off.
+TIER_MULTIPLIER = {"standard": Decimal("1"), "gold": Decimal("0.9")}
 
+
 def base_rate(zone):
     if zone not in ZONE_BASE:
         raise ValueError("unknown zone: %s" % zone)
@@ -12,3 +19,12 @@
     if weight_kg <= 0:
         raise ValueError("weight must be positive")
     return round(base_rate(zone) + PER_KG * weight_kg, 2)
+
+
+def discounted_quote(weight_kg, zone, tier):
+    if tier not in TIER_MULTIPLIER:
+        raise ValueError("unknown tier: %s" % tier)
+    # quote() validates weight and zone. Work in integer cents and round
+    # half up once, at the end.
+    regular = Money.parse(quote(weight_kg, zone))
+    return regular.scale(TIER_MULTIPLIER[tier]).cents / 100
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/test_rates.py b/tests/test_rates.py
