--- a/parcelo/shipments.py	2026-11-10 12:20:18
+++ b/parcelo/shipments.py	2026-11-12 02:08:14
@@ -1,3 +1,5 @@
+from decimal import Decimal, InvalidOperation
+
 from parcelo import clock, events, ids
 from parcelo.errors import DomainError
 from parcelo.models import Shipment
@@ -28,3 +30,45 @@
     if shipment_id not in db.shipments:
         raise DomainError("E_NOT_FOUND", shipment_id)
     return db.shipments[shipment_id]
+
+
+def split_shipment(shipment_id, weights):
+    """Replace a "created" shipment with one new shipment per weight.
+
+    The original is marked "split". New shipments keep its customer and zone
+    and are returned in the same order as `weights`. All validation happens
+    before anything is changed, so a failed split leaves no partial state.
+    """
+    original = get_shipment(shipment_id)
+    if original.status != "created":
+        raise DomainError("E_BAD_STATE", f"{shipment_id} is {original.status}")
+
+    weights = list(weights)
+    if not weights:
+        raise DomainError("E_BAD_INPUT", "no weights given")
+
+    # Decimal(str(...)) keeps the sum exact, so 0.1 + 0.2 == 0.3 holds.
+    try:
+        decimals = [Decimal(str(w)) for w in weights]
+    except (InvalidOperation, TypeError, ValueError):
+        raise DomainError("E_BAD_WEIGHT", repr(weights))
+    for w, d in zip(weights, decimals):
+        if d <= 0:
+            raise DomainError("E_BAD_WEIGHT", str(w))
+    total = sum(decimals, Decimal(0))
+    if total != Decimal(str(original.weight_kg)):
+        raise DomainError(
+            "E_BAD_INPUT",
+            f"weights sum to {total}, expected {original.weight_kg}",
+        )
+
+    new_shipments = [
+        create_shipment(original.customer_id, w, original.zone) for w in weights
+    ]
+    original.status = "split"
+    events.emit(
+        "shipment.split",
+        original.id,
+        children=[s.id for s in new_shipments],
+    )
+    return new_shipments
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_shipments.py b/tests/unit/test_shipments.py
--- a/tests/unit/test_shipments.py	2026-11-10 12:20:18
+++ b/tests/unit/test_shipments.py	2026-11-12 02:08:17
@@ -15,3 +15,65 @@
     with pytest.raises(DomainError) as err:
         shipments.create_shipment("nope", 1, "local")
     assert err.value.code == "E_UNKNOWN_CUSTOMER"
+
+
+def _created(weight=3.0, zone="national"):
+    c = customers.add_customer("Acme")
+    return shipments.create_shipment(c.id, weight, zone)
+
+
+def test_split_replaces_original_with_new_shipments():
+    original = _created(3.0, "international")
+    new = shipments.split_shipment(original.id, [1.0, 2.0])
+    assert [s.weight_kg for s in new] == [1.0, 2.0]
+    assert all(s.customer_id == original.customer_id for s in new)
+    assert all(s.zone == "international" for s in new)
+    assert original.status == "split"
+    assert events.OUTBOX[-1]["name"] == "shipment.split"
+    assert events.OUTBOX[-1]["payload"]["children"] == [s.id for s in new]
+
+
+def test_split_float_weights_sum_exactly():
+    original = _created(0.3)
+    new = shipments.split_shipment(original.id, [0.1, 0.2])
+    assert len(new) == 2
+
+
+def test_split_unknown_shipment():
+    with pytest.raises(DomainError) as err:
+        shipments.split_shipment("shp_missing", [1.0])
+    assert err.value.code == "E_NOT_FOUND"
+
+
+def test_split_requires_created_status():
+    original = _created(2.0)
+    shipments.split_shipment(original.id, [1.0, 1.0])
+    with pytest.raises(DomainError) as err:
+        shipments.split_shipment(original.id, [1.0, 1.0])
+    assert err.value.code == "E_BAD_STATE"
+
+
+def test_split_weights_must_sum_to_original():
+    original = _created(2.0)
+    before = len(shipments.db.shipments)
+    with pytest.raises(DomainError) as err:
+        shipments.split_shipment(original.id, [1.0, 0.5])
+    assert err.value.code == "E_BAD_INPUT"
+    # Failed split must not change anything.
+    assert original.status == "created"
+    assert len(shipments.db.shipments) == before
+
+
+def test_split_rejects_non_positive_weight():
+    original = _created(2.0)
+    with pytest.raises(DomainError) as err:
+        shipments.split_shipment(original.id, [3.0, -1.0])
+    assert err.value.code == "E_BAD_WEIGHT"
+    assert original.status == "created"
+
+
+def test_split_rejects_empty_weights():
+    original = _created(2.0)
+    with pytest.raises(DomainError) as err:
+        shipments.split_shipment(original.id, [])
+    assert err.value.code == "E_BAD_INPUT"
