+"""Claims filed by customers against delivered shipments."""
+
+from parcelo import audit, clock, ids
+from parcelo.errors import DomainError
+from parcelo.models import Claim
+from parcelo.money import Money
+from parcelo.store import db
+
+
+def file_claim(shipment_id: str, amount, reason: str) -> Claim:
+    """File a claim against a delivered shipment.
+
+    Args:
+        shipment_id: Id of the shipment the claim is about.
+        amount: Amount to claim, as a dollar value (float, int, str, Decimal) or Money.
+        reason: Free-text reason for the claim.
+
+    Returns:
+        The stored Claim.
+
+    Raises:
+        DomainError: E_BAD_INPUT if the amount is not a positive number,
+            E_NOT_FOUND if the shipment does not exist,
+            E_BAD_STATE if the shipment has not been delivered.
+    """
+    try:
+        money = Money.parse(amount)
+    except (ArithmeticError, TypeError, ValueError):
+        raise DomainError("E_BAD_INPUT", f"amount: {amount!r}") from None
+    if money.cents <= 0:
+        raise DomainError("E_BAD_INPUT", f"amount must be positive: {amount!r}")
+
+    if shipment_id not in db.shipments:
+        raise DomainError("E_NOT_FOUND", shipment_id)
+    shipment = db.shipments[shipment_id]
+    if shipment.status != "delivered":
+        raise DomainError("E_BAD_STATE", f"shipment {shipment_id} is {shipment.status}")
+
+    claim = Claim(
+        id=ids.new_id("clm"),
+        shipment_id=shipment_id,
+        amount=money,
+        reason=reason,
+        filed_at=clock.now(),
+    )
+    db.claims[claim.id] = claim
+    audit.record("claim.filed", claim.id, shipment_id=shipment_id, cents=money.cents)
+    return claim
