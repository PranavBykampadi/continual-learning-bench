diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_claims.py b/tests/unit/test_claims.py
--- a/tests/unit/test_claims.py	1969-12-31 19:00:00
+++ b/tests/unit/test_claims.py	2026-11-12 02:00:51
@@ -0,0 +1,63 @@
+from datetime import datetime, timezone
+
+import pytest
+
+from parcelo import audit, claims, clock, customers, shipments
+from parcelo.errors import DomainError
+from parcelo.money import Money
+from parcelo.store import db
+
+
+def _delivered_shipment():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 2.0, "local")
+    s.status = "delivered"
+    return s
+
+
+def test_file_claim_stores_and_returns_claim():
+    s = _delivered_shipment()
+    moment = datetime(2026, 11, 1, 12, 0, tzinfo=timezone.utc)
+    clock.set_fixed(moment)
+    claim = claims.file_claim(s.id, "12.50", "box arrived crushed")
+    assert claim.id.startswith("clm_")
+    assert claim.shipment_id == s.id
+    assert claim.amount == Money.parse("12.50")
+    assert claim.reason == "box arrived crushed"
+    assert claim.filed_at == moment
+    assert db.claims[claim.id] is claim
+    assert audit.LOG[-1]["action"] == "claim.filed"
+    assert audit.LOG[-1]["entity_id"] == claim.id
+    clock.clear_fixed()
+
+
+def test_accepts_float_and_int_amounts():
+    s = _delivered_shipment()
+    assert claims.file_claim(s.id, 3.5, "x").amount == Money(350)
+    assert claims.file_claim(s.id, 4, "y").amount == Money(400)
+
+
+@pytest.mark.parametrize("amount", [0, -1, -0.5, "0", 0.001, "abc", None, float("nan")])
+def test_rejects_non_positive_or_invalid_amount(amount):
+    s = _delivered_shipment()
+    with pytest.raises(DomainError) as err:
+        claims.file_claim(s.id, amount, "r")
+    assert err.value.code == "E_BAD_INPUT"
+    assert db.claims == {}
+
+
+def test_unknown_shipment():
+    with pytest.raises(DomainError) as err:
+        claims.file_claim("shp_missing", 5, "r")
+    assert err.value.code == "E_NOT_FOUND"
+
+
+@pytest.mark.parametrize("status", ["created", "in_transit"])
+def test_undelivered_shipment_rejected(status):
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 2.0, "local")
+    s.status = status
+    with pytest.raises(DomainError) as err:
+        claims.file_claim(s.id, 5, "r")
+    assert err.value.code == "E_BAD_STATE"
+    assert db.claims == {}
