+import pytest
+
 from parcelo import customers, invoices, shipments
+from parcelo.errors import DomainError
 
 
 def test_issue_and_pay():
@@ -7,3 +10,40 @@
     inv = invoices.issue_invoice(s.id)
     assert inv.amount == 7.0
