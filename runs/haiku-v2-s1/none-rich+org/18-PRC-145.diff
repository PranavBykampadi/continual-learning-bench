diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_customers_upgrade.py b/tests/unit/test_customers_upgrade.py
--- a/tests/unit/test_customers_upgrade.py	1969-12-31 19:00:00
+++ b/tests/unit/test_customers_upgrade.py	2026-11-12 02:05:33
@@ -0,0 +1,29 @@
+import pytest
+
+from parcelo import customers
+from parcelo.errors import DomainError
+from parcelo.store import db
+
+
+def test_upgrade_standard_to_gold_keeps_customer():
+    c = customers.add_customer("Acme")
+    assert c.tier == "standard"
+    result = customers.upgrade_tier(c.id)
+    assert result is c
+    assert db.customers[c.id].tier == "gold"
+    assert db.customers[c.id].name == "Acme"
+
+
+def test_upgrade_unknown_customer_fails():
+    with pytest.raises(DomainError) as exc:
+        customers.upgrade_tier("C000000")
+    assert exc.value.code == "E_UNKNOWN_CUSTOMER"
+    assert "C000000" not in db.customers
+
+
+def test_upgrade_already_gold_fails():
+    c = customers.add_customer("Acme", tier="gold")
+    with pytest.raises(DomainError) as exc:
+        customers.upgrade_tier(c.id)
+    assert exc.value.code == "E_BAD_STATE"
+    assert db.customers[c.id].tier == "gold"
