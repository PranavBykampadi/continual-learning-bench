-from parcelo import customers, invoices, shipments
+import pytest
 
+from parcelo import audit, customers, invoices, reports, shipments
+from parcelo.errors import DomainError
+from parcelo.money import Money
 
+
 def test_issue_and_pay():
     c = customers.add_customer("Acme")
     s = shipments.create_shipment(c.id, 2, "local")
     inv = invoices.issue_invoice(s.id)
     assert inv.amount == 7.0
     assert invoices.mark_paid(inv.id).status == "paid"
+
+
+def _open_invoice(weight_kg=2):
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, weight_kg, "local")
+    return c, invoices.issue_invoice(s.id)
+
+
+def test_apply_credit_reduces_open_invoice():
+    c, inv = _open_invoice()
+    remaining = invoices.apply_credit(inv.id, 2.5)
+    assert remaining == Money(450)
+    assert inv.amount == 4.5
+    assert inv.status == "open"
+    assert customers.outstanding_balance(c.id) == 4.5
+    assert any(e["action"] == "invoice.credit_applied" for e in audit.LOG)
+
+
+def test_credit_flows_into_paid_revenue():
+    _, inv = _open_invoice()
+    invoices.apply_credit(inv.id, 1.0)
+    invoices.mark_paid(inv.id)
+    assert reports.revenue_total() == 6.0
+
+
+def test_credit_equal_to_amount_leaves_zero_balance():
+    c, inv = _open_invoice()
+    assert invoices.apply_credit(inv.id, 7.0) == Money(0)
+    assert customers.outstanding_balance(c.id) == 0.0
+
+
+def test_apply_credit_unknown_invoice_fails():
+    with pytest.raises(DomainError) as err:
+        invoices.apply_credit("INV-missing", 1.0)
+    assert err.value.code == "E_NOT_FOUND"
+
+
+def test_apply_credit_to_paid_invoice_fails():
+    _, inv = _open_invoice()
+    invoices.mark_paid(inv.id)
+    with pytest.raises(DomainError) as err:
+        invoices.apply_credit(inv.id, 1.0)
+    assert err.value.code == "E_BAD_STATE"
+    assert inv.amount == 7.0
+
+
+def test_credit_larger_than_amount_fails():
+    _, inv = _open_invoice()
+    with pytest.raises(DomainError) as err:
+        invoices.apply_credit(inv.id, 7.01)
+    assert err.value.code == "E_BAD_INPUT"
+    assert inv.amount == 7.0
+
+
+def test_non_positive_credit_fails():
+    _, inv = _open_invoice()
+    with pytest.raises(DomainError) as err:
+        invoices.apply_credit(inv.id, 0)
+    assert err.value.code == "E_BAD_INPUT"
+    assert inv.amount == 7.0
