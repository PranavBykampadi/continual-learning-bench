+def apply_credit(invoice_id: str, amount: float) -> Money:
+    """Reduce an open invoice by a credit and return the amount still owed.
+
+    The invoice's stored amount is updated to the remaining amount, so
+    reports and customer balances see the credit. The stored field stays a
+    float (the invoice model has not moved to Money yet); the arithmetic is
+    done in integer cents.
+
+    Args:
+        invoice_id: ID of the open invoice to credit.
+        amount: Credit to subtract, in dollars.
+
+    Returns:
+        The remaining amount on the invoice, as Money.
+
+    Raises:
+        DomainError: E_NOT_FOUND if the invoice does not exist, E_BAD_STATE if
+            it is not open, or E_BAD_INPUT if the credit is not positive or is
+            larger than the invoice amount.
+    """
+    if invoice_id not in db.invoices:
+        raise DomainError("E_NOT_FOUND", invoice_id)
+    invoice = db.invoices[invoice_id]
+    if invoice.status != "open":
+        raise DomainError("E_BAD_STATE", invoice_id)
+    credit = Money.parse(amount)
+    if credit.cents <= 0:
+        raise DomainError("E_BAD_INPUT", "credit must be positive")
+    current = Money.parse(invoice.amount)
+    if current < credit:
+        raise DomainError("E_BAD_INPUT", "credit exceeds invoice amount")
+    remaining = current - credit
+    invoice.amount = remaining.cents / 100
+    audit.record(
+        "invoice.credit_applied",
+        invoice.id,
+        credit=str(credit),
+        remaining=str(remaining),
+    )
+    return remaining
