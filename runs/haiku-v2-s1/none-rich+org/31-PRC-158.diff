diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/test_returns.py b/tests/test_returns.py
--- a/tests/test_returns.py	1969-12-31 19:00:00
+++ b/tests/test_returns.py	2026-11-12 02:13:21
@@ -0,0 +1,51 @@
+import pytest
+
+from parcelo import audit, customers, returns, shipments
+from parcelo.errors import DomainError
+
+
+def _delivered_shipment():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 2.0, "national")
+    s.status = "delivered"
+    return s
+
+
+def test_request_return_for_delivered_shipment():
+    s = _delivered_shipment()
+    r = returns.request_return(s.id, "damaged")
+    assert r.id.startswith("ret_")
+    assert r.shipment_id == s.id
+    assert r.reason == "damaged"
+    assert r.requested_at is not None
+    assert returns.returns_for(s.id) == [r]
+    assert audit.LOG[-1]["action"] == "return.requested"
+
+
+def test_unknown_shipment_fails():
+    with pytest.raises(DomainError) as err:
+        returns.request_return("shp_missing", "x")
+    assert err.value.code == "E_NOT_FOUND"
+
+
+def test_undelivered_shipment_fails():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 2.0, "national")
+    with pytest.raises(DomainError) as err:
+        returns.request_return(s.id, "x")
+    assert err.value.code == "E_BAD_STATE"
+    assert returns.returns_for(s.id) == []
+
+
+def test_fourth_request_fails():
+    s = _delivered_shipment()
+    for i in range(returns.MAX_RETURNS_PER_SHIPMENT):
+        returns.request_return(s.id, f"reason {i}")
+    with pytest.raises(DomainError) as err:
+        returns.request_return(s.id, "one too many")
+    assert err.value.code == "E_LIMIT"
+    assert len(returns.returns_for(s.id)) == 3
+
+
+def test_returns_for_unknown_shipment_is_empty():
+    assert returns.returns_for("shp_nope") == []
