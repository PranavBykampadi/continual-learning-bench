 from datetime import datetime
 
+from parcelo.money import Money
 from parcelo.store import db
+
+
+def outstanding_by_customer():
+    """Map each customer id to the total of its open invoices (paid and void excluded).
+
+    Customers with no open invoices are omitted. Totals are summed in cents via
+    Money so float drift doesn't creep in; values are returned as dollar floats.
+    """
+    totals = {}
+    for invoice in db.invoices.values():
+        if invoice.status != "open":
+            continue
+        customer_id = db.shipments[invoice.shipment_id].customer_id
+        amount = Money.parse(invoice.amount)
+        totals[customer_id] = totals.get(customer_id, Money.zero()) + amount
+    return {customer_id: total.cents / 100 for customer_id, total in totals.items()}
 
 
