+import pytest
+
 from parcelo import customers, invoices, shipments
+from parcelo.errors import DomainError
+from parcelo.models import Invoice
+from parcelo.store import db
+
+
+def _invoice(inv_id, amount, status="open"):
+    inv = Invoice(id=inv_id, shipment_id="S", amount=amount, status=status)
+    db.invoices[inv_id] = inv
+    return inv
+
+
+def test_escalate_large_open_invoice():
+    _invoice("INV-BIG1", 500.0)
+    assert invoices.escalate_invoice("INV-BIG1").status == "escalated"
+
+
+def test_escalate_rejects_small_invoice():
+    _invoice("INV-SMALL", 499.99)
+    with pytest.raises(DomainError) as e:
+        invoices.escalate_invoice("INV-SMALL")
+    assert e.value.code == "E_BAD_STATE"
+    assert db.invoices["INV-SMALL"].status == "open"
+
+
+def test_escalate_rejects_paid_invoice():
+    _invoice("INV-PAID", 900.0, status="paid")
+    with pytest.raises(DomainError):
+        invoices.escalate_invoice("INV-PAID")
+
+
+def test_escalate_missing_invoice_fails():
+    with pytest.raises(DomainError) as e:
+        invoices.escalate_invoice("INV-NOPE")
