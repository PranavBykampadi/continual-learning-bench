+def rebate_for(customer_id):
+    """Volume rebate earned by a customer, as a Money amount.
+
+    3% of paid invoices from 10 shipments, 6% from 50. Zero below 10.
+    Raises DomainError if the customer does not exist.
+    """
+    if customer_id not in db.customers:
+        raise DomainError("E_UNKNOWN_CUSTOMER", customer_id)
+    shipment_ids = {s.id for s in db.shipments.values() if s.customer_id == customer_id}
+    rate = REBATE_RATES.get(volume_tier(len(shipment_ids)))
+    if rate is None:
+        return Money.zero()
+    paid = Money.zero()
+    for invoice in db.invoices.values():
+        if invoice.shipment_id in shipment_ids and invoice.status == "paid":
+            paid = paid + Money.parse(invoice.amount)
+    # Round to cents once, at the end.
+    return paid.scale(rate)
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/test_customers.py b/tests/test_customers.py
--- a/tests/test_customers.py	1969-12-31 19:00:00
+++ b/tests/test_customers.py	2026-11-12 02:16:15
@@ -0,0 +1,47 @@
+import pytest
+
+from parcelo import customers, invoices, shipments
+from parcelo.errors import DomainError
+from parcelo.money import Money
+
+
+def _paid_shipments(customer_id, count):
+    """Create `count` shipments for the customer, each invoiced and paid at 7.00."""
+    for _ in range(count):
+        s = shipments.create_shipment(customer_id, 2, "local")
+        inv = invoices.issue_invoice(s.id)
+        invoices.mark_paid(inv.id)
+
+
+def test_no_rebate_below_ten_shipments():
+    c = customers.add_customer("Small")
+    _paid_shipments(c.id, 9)
+    assert customers.rebate_for(c.id) == Money.zero()
+
+
+def test_three_percent_from_ten_shipments():
+    c = customers.add_customer("Regular")
+    _paid_shipments(c.id, 10)
+    # 10 paid invoices of 7.00 = 70.00, 3% = 2.10
+    assert customers.rebate_for(c.id) == Money(210)
+
+
+def test_six_percent_from_fifty_shipments():
+    c = customers.add_customer("Bulk")
+    _paid_shipments(c.id, 50)
+    # 50 paid invoices of 7.00 = 350.00, 6% = 21.00
+    assert customers.rebate_for(c.id) == Money(2100)
+
+
+def test_unpaid_invoices_do_not_count():
+    c = customers.add_customer("Open")
+    _paid_shipments(c.id, 9)
+    s = shipments.create_shipment(c.id, 2, "local")
+    invoices.issue_invoice(s.id)  # open, not paid
+    # Tenth shipment exists, so tier is regular, but only 9 paid invoices: 63.00 * 3%
+    assert customers.rebate_for(c.id) == Money(189)
+
+
+def test_unknown_customer_fails():
+    with pytest.raises(DomainError):
+        customers.rebate_for("C000000")
