diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/parcelo/refunds.py b/parcelo/refunds.py
--- a/parcelo/refunds.py	1969-12-31 19:00:00
+++ b/parcelo/refunds.py	2026-11-12 01:54:47
@@ -0,0 +1,62 @@
+from parcelo import audit, clock, ids
+from parcelo.errors import DomainError
+from parcelo.models import Refund
+from parcelo.money import Money
+from parcelo.store import db
+
+
+def _refunded_total(invoice_id):
+    """Sum the refunds already recorded against an invoice.
+
+    Args:
+        invoice_id: Id of the invoice.
+
+    Returns:
+        Money: Total of all refunds for the invoice (zero if none).
+    """
+    total = Money.zero()
+    for refund in db.refunds.values():
+        if refund.invoice_id == invoice_id:
+            total = total + refund.amount
+    return total
+
+
+def create_refund(invoice_id, amount):
+    """Record a refund against a paid invoice.
+
+    Args:
+        invoice_id: Id of the invoice to refund.
+        amount: Refund amount in dollars (float, int, str, Decimal or Money).
+
+    Returns:
+        Refund: The stored refund.
+
+    Raises:
+        DomainError: E_NOT_FOUND if the invoice does not exist, E_BAD_STATE if it
+            is not paid, E_BAD_INPUT if the amount is not a positive number, and
+            E_LIMIT if the amount exceeds what is still refundable.
+    """
+    invoice = db.invoices.get(invoice_id)
+    if invoice is None:
+        raise DomainError("E_NOT_FOUND", invoice_id)
+    if invoice.status != "paid":
+        raise DomainError("E_BAD_STATE", f"{invoice_id} is {invoice.status}")
+    try:
+        money = Money.parse(amount)
+    except (ArithmeticError, TypeError, ValueError):
+        raise DomainError("E_BAD_INPUT", repr(amount)) from None
+    if money.cents <= 0:
+        raise DomainError("E_BAD_INPUT", repr(amount))
+    # Invoice amounts are still stored as floats; wrap them where they are read.
+    remaining = Money.parse(invoice.amount) - _refunded_total(invoice_id)
+    if remaining < money:
+        raise DomainError("E_LIMIT", f"{invoice_id} has {remaining} refundable")
+    refund = Refund(
+        id=ids.new_id("ref"),
+        invoice_id=invoice_id,
+        amount=money,
+        created_at=clock.now(),
+    )
+    db.refunds[refund.id] = refund
+    audit.record("refund.created", refund.id, invoice_id=invoice_id, amount=str(money))
+    return refund
