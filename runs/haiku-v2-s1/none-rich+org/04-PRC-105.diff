diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/test_refunds.py b/tests/test_refunds.py
--- a/tests/test_refunds.py	1969-12-31 19:00:00
+++ b/tests/test_refunds.py	2026-11-12 01:54:50
@@ -0,0 +1,66 @@
+import pytest
+
+from parcelo import customers, invoices, refunds, shipments, store
+from parcelo.errors import DomainError
+from parcelo.money import Money
+
+
+def _paid_invoice():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 2, "local")
+    inv = invoices.issue_invoice(s.id)
+    invoices.mark_paid(inv.id)
+    return inv
+
+
+def test_refund_paid_invoice():
+    inv = _paid_invoice()
+    refund = refunds.create_refund(inv.id, 3)
+    assert refund.invoice_id == inv.id
+    assert refund.amount == Money.parse(3)
+    assert refund.created_at is not None
+    assert store.db.refunds[refund.id] is refund
+
+
+def test_refund_unknown_invoice_fails():
+    with pytest.raises(DomainError) as exc:
+        refunds.create_refund("INV-missing", 1)
+    assert exc.value.code == "E_NOT_FOUND"
+
+
+def test_refund_unpaid_invoice_fails():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 2, "local")
+    inv = invoices.issue_invoice(s.id)
+    with pytest.raises(DomainError) as exc:
+        refunds.create_refund(inv.id, 1)
+    assert exc.value.code == "E_BAD_STATE"
+    assert store.db.refunds == {}
+
+
+@pytest.mark.parametrize("amount", [0, -1, "abc"])
+def test_refund_bad_amount_fails(amount):
+    inv = _paid_invoice()
+    with pytest.raises(DomainError) as exc:
+        refunds.create_refund(inv.id, amount)
+    assert exc.value.code == "E_BAD_INPUT"
+
+
+def test_refund_cannot_exceed_remaining_balance():
+    inv = _paid_invoice()  # 7.0
+    refunds.create_refund(inv.id, 5)
+    with pytest.raises(DomainError) as exc:
+        refunds.create_refund(inv.id, 3)
+    assert exc.value.code == "E_LIMIT"
+    refunds.create_refund(inv.id, 2)
+    assert len(store.db.refunds) == 2
+
+
+def test_refund_writes_audit_entry():
+    from parcelo import audit
+
+    inv = _paid_invoice()
+    refund = refunds.create_refund(inv.id, 1)
+    entry = audit.LOG[-1]
+    assert entry["action"] == "refund.created"
+    assert entry["entity_id"] == refund.id
