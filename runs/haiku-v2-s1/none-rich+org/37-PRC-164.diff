diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/parcelo/vouchers.py b/parcelo/vouchers.py
--- a/parcelo/vouchers.py	1969-12-31 19:00:00
+++ b/parcelo/vouchers.py	2026-11-12 02:17:55
@@ -0,0 +1,26 @@
+from parcelo import clock, ids
+from parcelo.errors import DomainError
+from parcelo.models import Voucher
+from parcelo.money import Money
+from parcelo.store import db
+
+# A single voucher may not be worth more than 150.00 (stored in cents).
+MAX_VOUCHER_CENTS = 15000
+
+
+def issue_voucher(customer_id, amount):
+    if customer_id not in db.customers:
+        raise DomainError("E_UNKNOWN_CUSTOMER", customer_id)
+    cents = Money.parse(amount).cents
+    if cents <= 0:
+        raise DomainError("E_BAD_INPUT", f"voucher amount must be positive: {amount}")
+    if cents > MAX_VOUCHER_CENTS:
+        raise DomainError("E_LIMIT", f"voucher amount {amount} exceeds 150.00")
+    voucher = Voucher(
+        id=ids.new_id("vch"),
+        customer_id=customer_id,
+        amount=amount,
+        issued_at=clock.now(),
+    )
+    db.vouchers[voucher.id] = voucher
+    return voucher
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/test_vouchers.py b/tests/test_vouchers.py
--- a/tests/test_vouchers.py	1969-12-31 19:00:00
+++ b/tests/test_vouchers.py	2026-11-12 02:17:55
@@ -0,0 +1,44 @@
+import pytest
+
+from parcelo import customers, vouchers
+from parcelo.errors import DomainError
+from parcelo.store import db
+
+
+def test_issue_voucher_saves_and_returns():
+    c = customers.add_customer("Acme")
+    v = vouchers.issue_voucher(c.id, 25.5)
+    assert v.id.startswith("vch_")
+    assert v.customer_id == c.id
+    assert v.amount == 25.5
+    assert v.issued_at is not None
+    assert db.vouchers[v.id] is v
+
+
+def test_max_amount_allowed():
+    c = customers.add_customer("Acme")
+    assert vouchers.issue_voucher(c.id, 150.00).amount == 150.00
+
+
+def test_over_max_rejected():
+    c = customers.add_customer("Acme")
+    with pytest.raises(DomainError) as err:
+        vouchers.issue_voucher(c.id, 150.01)
+    assert err.value.code == "E_LIMIT"
+    assert db.vouchers == {}
+
+
+@pytest.mark.parametrize("amount", [0, 0.0, -5, -0.01])
+def test_non_positive_rejected(amount):
+    c = customers.add_customer("Acme")
+    with pytest.raises(DomainError) as err:
+        vouchers.issue_voucher(c.id, amount)
+    assert err.value.code == "E_BAD_INPUT"
+    assert db.vouchers == {}
+
+
+def test_unknown_customer_rejected():
+    with pytest.raises(DomainError) as err:
+        vouchers.issue_voucher("nope", 10)
+    assert err.value.code == "E_UNKNOWN_CUSTOMER"
+    assert db.vouchers == {}
