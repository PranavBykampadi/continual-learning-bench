+from datetime import datetime, timedelta, timezone
 
+import pytest
 
+from parcelo import clock, customers, invoices, shipments
+from parcelo.errors import DomainError
+
+
 def test_issue_and_pay():
     c = customers.add_customer("Acme")
     s = shipments.create_shipment(c.id, 2, "local")
     inv = invoices.issue_invoice(s.id)
     assert inv.amount == 7.0
     assert invoices.mark_paid(inv.id).status == "paid"
+
+
+def _invoice_issued_days_ago(days, amount=100.0):
+    from parcelo.models import Invoice
+    from parcelo.store import db
+
+    now = datetime(2026, 11, 12, tzinfo=timezone.utc)
+    clock.set_fixed(now)
+    inv = Invoice(
+        id="INV-TEST",
+        shipment_id="SHP-X",
+        amount=amount,
+        issued_at=now - timedelta(days=days),
+    )
+    db.invoices[inv.id] = inv
+    return inv
+
+
+def test_no_late_fee_before_30_days():
+    inv = _invoice_issued_days_ago(29)
+    assert invoices.late_fee_for(inv.id) == 0.0
+
+
+def test_no_late_fee_exactly_30_days():
+    inv = _invoice_issued_days_ago(30)
+    assert invoices.late_fee_for(inv.id) == 0.0
+
+
+def test_late_fee_one_day_past_30():
+    inv = _invoice_issued_days_ago(31, amount=100.0)
+    assert invoices.late_fee_for(inv.id) == 1.5
+
+
+def test_late_fee_accumulates_per_day():
+    inv = _invoice_issued_days_ago(40, amount=200.0)
+    assert invoices.late_fee_for(inv.id) == 30.0  # 10 days past 30 at 3 per day
+
+
+def test_late_fee_accepts_naive_issue_date():
+    from parcelo.models import Invoice
+    from parcelo.store import db
+
+    clock.set_fixed(datetime(2026, 11, 12, tzinfo=timezone.utc))
+    inv = Invoice(
+        id="INV-NAIVE",
+        shipment_id="SHP-X",
+        amount=100.0,
+        issued_at=datetime(2026, 11, 12) - timedelta(days=32),
+    )
+    db.invoices[inv.id] = inv
+    assert invoices.late_fee_for(inv.id) == 3.0
+
+
+def test_late_fee_unknown_invoice_fails():
+    with pytest.raises(DomainError) as exc:
+        invoices.late_fee_for("INV-MISSING")
+    assert exc.value.code == "E_NOT_FOUND"
