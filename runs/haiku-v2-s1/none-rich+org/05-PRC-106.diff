+def late_fee_for(invoice_id):
+    """Late fee in dollars for an invoice, as of now.
+
+    The invoice is late once it is 30 days old. After that the fee is 1.5% of
+    the invoice amount for each whole day past those 30 days. Rounded to cents
+    at the end.
+    """
+    if invoice_id not in db.invoices:
+        raise DomainError("E_NOT_FOUND", invoice_id)
+    invoice = db.invoices[invoice_id]
+
+    issued_at = invoice.issued_at
+    if issued_at.tzinfo is None:
+        # Some older invoices were issued with naive UTC timestamps.
+        issued_at = issued_at.replace(tzinfo=timezone.utc)
+    elapsed = clock.now() - issued_at
+    days_past = elapsed.days - LATE_AFTER_DAYS
+    if days_past <= 0:
+        return 0.0
+    return round(invoice.amount * LATE_FEE_RATE_PER_DAY * days_past, 2)
