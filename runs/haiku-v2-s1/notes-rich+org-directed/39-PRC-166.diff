 def open_invoices():
     return [i for i in db.invoices.values() if i.status == "open"]
+
+
+def escalate_invoice(invoice_id: str) -> Invoice:
+    """Mark a large unpaid invoice as escalated to the collections team.
+
+    Only open invoices of at least ESCALATION_MIN_CENTS can be escalated. Calling
+    this on an invoice that is already escalated returns it unchanged, with no
+    error and no second event.
+
+    Args:
+        invoice_id: ID of the invoice to escalate.
+
+    Returns:
+        The escalated invoice.
+
+    Raises:
+        DomainError: E_NOT_FOUND if the invoice does not exist; E_BAD_STATE if the
+            invoice is not open or is below the escalation threshold.
+    """
+    if invoice_id not in db.invoices:
+        raise DomainError("E_NOT_FOUND", invoice_id)
+    invoice = db.invoices[invoice_id]
+    if invoice.status == "escalated":
+        return invoice
+    if invoice.status != "open":
+        raise DomainError("E_BAD_STATE", f"invoice {invoice_id} is {invoice.status}")
+    if Money.parse(invoice.amount).cents < ESCALATION_MIN_CENTS:
+        raise DomainError("E_BAD_STATE", f"invoice {invoice_id} is below the escalation minimum")
+    invoice.status = "escalated"
+    events.emit("invoice.escalated", invoice.id, amount=invoice.amount)
+    return invoice
