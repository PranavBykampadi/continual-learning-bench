diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_escalate_invoice.py b/tests/unit/test_escalate_invoice.py
--- a/tests/unit/test_escalate_invoice.py	1969-12-31 19:00:00
+++ b/tests/unit/test_escalate_invoice.py	2026-11-12 02:39:53
@@ -0,0 +1,62 @@
+import pytest
+
+from parcelo import events, invoices
+from parcelo.errors import DomainError
+from parcelo.models import Invoice
+from parcelo.store import db
+
+
+def _add_invoice(invoice_id, amount, status="open"):
+    inv = Invoice(id=invoice_id, shipment_id="shp_000001", amount=amount, status=status)
+    db.invoices[invoice_id] = inv
+    return inv
+
+
+def test_escalate_large_open_invoice():
+    _add_invoice("INV-1", 750.0)
+    inv = invoices.escalate_invoice("INV-1")
+    assert inv.status == "escalated"
+    assert db.invoices["INV-1"].status == "escalated"
+    assert events.OUTBOX[-1]["name"] == "invoice.escalated"
+    assert events.OUTBOX[-1]["entity_id"] == "INV-1"
+
+
+def test_exactly_threshold_can_be_escalated():
+    _add_invoice("INV-2", 500.0)
+    assert invoices.escalate_invoice("INV-2").status == "escalated"
+
+
+def test_repeat_call_is_unchanged_and_emits_nothing_new():
+    _add_invoice("INV-3", 900.0)
+    invoices.escalate_invoice("INV-3")
+    events_before = len(events.OUTBOX)
+    inv = invoices.escalate_invoice("INV-3")
+    assert inv.status == "escalated"
+    assert len(events.OUTBOX) == events_before
+
+
+def test_missing_invoice_fails():
+    with pytest.raises(DomainError) as err:
+        invoices.escalate_invoice("INV-nope")
+    assert err.value.code == "E_NOT_FOUND"
+    assert len(db.invoices) == 0
+    assert events.OUTBOX == []
+
+
+def test_below_threshold_fails_and_nothing_changes():
+    _add_invoice("INV-4", 499.99)
+    with pytest.raises(DomainError) as err:
+        invoices.escalate_invoice("INV-4")
+    assert err.value.code == "E_BAD_STATE"
+    assert db.invoices["INV-4"].status == "open"
+    assert len(db.invoices) == 1
+    assert events.OUTBOX == []
+
+
+def test_paid_invoice_fails_and_nothing_changes():
+    _add_invoice("INV-5", 800.0, status="paid")
+    with pytest.raises(DomainError) as err:
+        invoices.escalate_invoice("INV-5")
+    assert err.value.code == "E_BAD_STATE"
+    assert db.invoices["INV-5"].status == "paid"
+    assert events.OUTBOX == []
