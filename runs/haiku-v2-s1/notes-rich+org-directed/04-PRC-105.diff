@@ -0,0 +1,36 @@
+from decimal import Decimal
+
+from parcelo import audit, clock, ids, invoices
+from parcelo.errors import DomainError
+from parcelo.models import Refund
+from parcelo.money import Money
+from parcelo.store import db
+
+
+def create_refund(invoice_id: str, amount: Money | float | str | Decimal) -> Refund:
+    """Record a refund against a paid invoice.
+
+    Args:
+        invoice_id: ID of the invoice being refunded.
+        amount: Refund amount. A Money is used as is; a float, str or Decimal
+            dollar amount is wrapped with Money.parse.
+
+    Returns:
+        The stored Refund.
+
+    Raises:
+        DomainError: E_NOT_FOUND if the invoice does not exist, or E_BAD_STATE
+            if the invoice is not paid.
+    """
+    invoice = invoices.get_invoice(invoice_id)
+    if invoice.status != "paid":
+        raise DomainError("E_BAD_STATE", invoice_id)
+    refund = Refund(
+        id=ids.new_id("ref"),
+        invoice_id=invoice_id,
+        amount=Money.parse(amount),
+        created_at=clock.now(),
+    )
+    db.refunds[refund.id] = refund
+    audit.record("refund.created", refund.id, invoice_id=invoice_id)
+    return refund
