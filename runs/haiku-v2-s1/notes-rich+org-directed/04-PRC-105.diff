@@ -0,0 +1,83 @@
+from datetime import datetime, timezone
+
+import pytest
+
+from parcelo import audit, clock, customers, invoices, refunds, shipments
+from parcelo.errors import DomainError
+from parcelo.models import Refund
+from parcelo.money import Money
+from parcelo.store import db
+
+FIXED = datetime(2026, 11, 12, 9, 30, tzinfo=timezone.utc)
+
+
+def _paid_invoice():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 2, "local")
+    inv = invoices.issue_invoice(s.id)
+    invoices.mark_paid(inv.id)
+    return inv
+
+
+def test_refund_paid_invoice():
+    clock.set_fixed(FIXED)
+    inv = _paid_invoice()
+    audit.LOG.clear()
+
+    r = refunds.create_refund(inv.id, "2.50")
+
+    assert isinstance(r, Refund)
+    assert r.id.startswith("ref_")
+    assert r.invoice_id == inv.id
+    assert isinstance(r.amount, Money)
+    assert r.amount == Money(250)
+    assert r.created_at == FIXED
+    assert db.refunds[r.id] is r
+    assert audit.LOG[-1]["action"] == "refund.created"
+    assert audit.LOG[-1]["entity_id"] == r.id
+
+
+def test_refund_accepts_money_as_is():
+    inv = _paid_invoice()
+
+    r = refunds.create_refund(inv.id, Money(1234))
+
+    assert r.amount == Money(1234)
+
+
+def test_unknown_invoice_fails_without_audit():
+    before = len(audit.LOG)
+
+    with pytest.raises(DomainError) as err:
+        refunds.create_refund("INV-missing", 1.0)
+
+    assert err.value.code == "E_NOT_FOUND"
+    assert len(audit.LOG) == before
+    assert db.refunds == {}
+
+
+def test_open_invoice_fails_without_audit():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 2, "local")
+    inv = invoices.issue_invoice(s.id)
+    before = len(audit.LOG)
+
+    with pytest.raises(DomainError) as err:
+        refunds.create_refund(inv.id, 1.0)
+
+    assert err.value.code == "E_BAD_STATE"
+    assert len(audit.LOG) == before
+    assert db.refunds == {}
+
+
+def test_get_invoice_returns_invoice():
+    inv = _paid_invoice()
+
+    assert invoices.get_invoice(inv.id) is inv
+
+
