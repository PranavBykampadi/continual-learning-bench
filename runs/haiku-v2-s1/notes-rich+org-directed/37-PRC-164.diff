diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/parcelo/vouchers.py b/parcelo/vouchers.py
--- a/parcelo/vouchers.py	1969-12-31 19:00:00
+++ b/parcelo/vouchers.py	2026-11-12 02:37:51
@@ -0,0 +1,40 @@
+from parcelo import clock, events, ids
+from parcelo.errors import DomainError
+from parcelo.models import Voucher
+from parcelo.money import Money
+from parcelo.settings import VOUCHER_MAX_AMOUNT_CENTS
+from parcelo.store import db
+
+
+def issue_voucher(customer_id, amount):
+    """Issue a goodwill voucher to an existing customer.
+
+    Args:
+        customer_id: Id of the customer receiving the voucher.
+        amount: Voucher value as a dollar amount (float, int, str, Decimal or Money).
+            Must be positive and no more than VOUCHER_MAX_AMOUNT_CENTS.
+
+    Returns:
+        The stored Voucher.
+
+    Raises:
+        DomainError: E_UNKNOWN_CUSTOMER if the customer does not exist, E_BAD_INPUT if the
+            amount is zero or negative, E_LIMIT if the amount is above the per-voucher cap.
+            Nothing is stored or emitted on error.
+    """
+    if customer_id not in db.customers:
+        raise DomainError("E_UNKNOWN_CUSTOMER", customer_id)
+    money = Money.parse(amount)
+    if money.cents <= 0:
+        raise DomainError("E_BAD_INPUT", str(money))
+    if money.cents > VOUCHER_MAX_AMOUNT_CENTS:
+        raise DomainError("E_LIMIT", str(money))
+    voucher = Voucher(
+        id=ids.new_id("vch"),
+        customer_id=customer_id,
+        amount=money,
+        issued_at=clock.now(),
+    )
+    db.vouchers[voucher.id] = voucher
+    events.emit("voucher.issued", voucher.id, customer_id=customer_id, cents=money.cents)
+    return voucher
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_vouchers.py b/tests/unit/test_vouchers.py
--- a/tests/unit/test_vouchers.py	1969-12-31 19:00:00
+++ b/tests/unit/test_vouchers.py	2026-11-12 02:37:54
@@ -0,0 +1,51 @@
+import pytest
+
+from parcelo import customers, events, vouchers
+from parcelo.errors import DomainError
+from parcelo.money import Money
+from parcelo.store import db
+
+
+def test_issue_voucher_stores_and_emits():
+    c = customers.add_customer("Acme")
+    v = vouchers.issue_voucher(c.id, 25)
+    assert v.id.startswith("vch_")
+    assert v.customer_id == c.id
+    assert v.amount == Money(2500)
+    assert v.issued_at is not None
+    assert db.vouchers[v.id] is v
+    assert events.OUTBOX[-1]["name"] == "voucher.issued"
+    assert events.OUTBOX[-1]["entity_id"] == v.id
+
+
+def test_issue_voucher_at_cap_is_allowed():
+    c = customers.add_customer("Acme")
+    v = vouchers.issue_voucher(c.id, "150.00")
+    assert v.amount == Money(15000)
+
+
+def test_unknown_customer():
+    with pytest.raises(DomainError) as err:
+        vouchers.issue_voucher("nope", 10)
+    assert err.value.code == "E_UNKNOWN_CUSTOMER"
+    assert db.vouchers == {}
+    assert events.OUTBOX == []
+
+
+@pytest.mark.parametrize("amount", [0, -5, "0.00", "-0.01"])
+def test_zero_or_negative_amount_rejected(amount):
+    c = customers.add_customer("Acme")
+    with pytest.raises(DomainError) as err:
+        vouchers.issue_voucher(c.id, amount)
+    assert err.value.code == "E_BAD_INPUT"
+    assert db.vouchers == {}
+    assert events.OUTBOX == []
+
+
+def test_amount_over_cap_rejected():
+    c = customers.add_customer("Acme")
+    with pytest.raises(DomainError) as err:
+        vouchers.issue_voucher(c.id, "150.01")
+    assert err.value.code == "E_LIMIT"
+    assert db.vouchers == {}
+    assert events.OUTBOX == []
