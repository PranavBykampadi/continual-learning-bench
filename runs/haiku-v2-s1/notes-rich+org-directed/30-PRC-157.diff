diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_hold_invoice.py b/tests/unit/test_hold_invoice.py
--- a/tests/unit/test_hold_invoice.py	1969-12-31 19:00:00
+++ b/tests/unit/test_hold_invoice.py	2026-11-12 02:27:45
@@ -0,0 +1,76 @@
+from datetime import datetime, timezone
+
+import pytest
+
+from parcelo import clock, customers, events, invoices, shipments
+from parcelo.errors import DomainError
+from parcelo.store import db
+
+HOLD_TIME = datetime(2026, 11, 12, 9, 30, tzinfo=timezone.utc)
+
+
+def _open_invoice():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 2, "local")
+    return invoices.issue_invoice(s.id)
+
+
+@pytest.fixture
+def fixed_clock():
+    clock.set_fixed(HOLD_TIME)
+    yield HOLD_TIME
+    clock.clear_fixed()
+
+
+def test_hold_open_invoice(fixed_clock):
+    inv = _open_invoice()
+    events.OUTBOX.clear()
+
+    held = invoices.hold_invoice(inv.id)
+
+    assert held is inv
+    assert held.status == "on_hold"
+    assert held.held_at == HOLD_TIME
+    assert [(e["name"], e["entity_id"]) for e in events.OUTBOX] == [("invoice.held", inv.id)]
+    assert inv.id not in [i.id for i in invoices.open_invoices()]
+
+
+def test_hold_is_idempotent(fixed_clock):
+    inv = _open_invoice()
+    invoices.hold_invoice(inv.id)
+    events.OUTBOX.clear()
+    first_hold = inv.held_at
+
+    clock.set_fixed(datetime(2026, 11, 13, tzinfo=timezone.utc))
+    again = invoices.hold_invoice(inv.id)
+
+    assert again is inv
+    assert again.status == "on_hold"
+    assert again.held_at == first_hold
+    assert events.OUTBOX == []
+
+
+def test_hold_unknown_invoice_fails():
+    events.OUTBOX.clear()
+    before = dict(db.invoices)
+
+    with pytest.raises(DomainError) as exc:
+        invoices.hold_invoice("INV-missing")
+
+    assert exc.value.code == "E_NOT_FOUND"
+    assert db.invoices == before
+    assert events.OUTBOX == []
+
+
+def test_hold_paid_invoice_fails():
+    inv = _open_invoice()
+    invoices.mark_paid(inv.id)
+    events.OUTBOX.clear()
+
+    with pytest.raises(DomainError) as exc:
+        invoices.hold_invoice(inv.id)
+
+    assert exc.value.code == "E_BAD_STATE"
+    assert inv.status == "paid"
+    assert inv.held_at is None
+    assert events.OUTBOX == []
