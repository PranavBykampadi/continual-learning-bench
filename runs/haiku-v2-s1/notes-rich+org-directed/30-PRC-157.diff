+def hold_invoice(invoice_id):
+    """Put an open invoice on hold so collection pauses.
+
+    Repeating the call on an invoice that is already on hold returns it
+    unchanged and emits no event (callers retry on timeouts).
+
+    Args:
+        invoice_id: ID of the invoice to hold.
+
+    Returns:
+        The invoice, with status "on_hold" and held_at set.
+
+    Raises:
+        DomainError: E_NOT_FOUND if the invoice does not exist, or
+            E_BAD_STATE if it is neither open nor on hold.
+    """
+    if invoice_id not in db.invoices:
+        raise DomainError("E_NOT_FOUND", invoice_id)
+    invoice = db.invoices[invoice_id]
+    if invoice.status == "on_hold":
+        return invoice
+    if invoice.status != "open":
+        raise DomainError("E_BAD_STATE", f"{invoice_id} is {invoice.status}")
+    invoice.status = "on_hold"
+    invoice.held_at = clock.now()
+    events.emit("invoice.held", invoice.id)
     return invoice
 
 
