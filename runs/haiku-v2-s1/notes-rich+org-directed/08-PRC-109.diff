+def add_address(customer_id: str, line: str, city: str) -> Address:
+    """Store a delivery address for an existing customer.
+
+    Args:
+        customer_id: Id of the customer the address belongs to.
+        line: Street line. Must not be empty or whitespace only.
+        city: City. Must not be empty or whitespace only.
+
+    Returns:
+        The stored Address.
+
+    Raises:
+        DomainError: "E_UNKNOWN_CUSTOMER" if the customer does not exist,
+            "E_BAD_INPUT" if the street line or city is empty.
+    """
+    if customer_id not in db.customers:
+        raise DomainError("E_UNKNOWN_CUSTOMER", customer_id)
+    if not line or not line.strip():
+        raise DomainError("E_BAD_INPUT", "line required")
+    if not city or not city.strip():
+        raise DomainError("E_BAD_INPUT", "city required")
+    address = Address(
+        id=ids.new_id("adr"),
+        customer_id=customer_id,
+        line=line,
+        city=city,
+    )
+    db.addresses[address.id] = address
+    audit.record("address.created", address.id, customer_id=customer_id)
+    return address
 
 
