         raise DomainError("E_NOT_FOUND", shipment_id)
     return db.shipments[shipment_id]
+
+
+def list_shipments(customer_id: str) -> list[Shipment]:
+    """Return every shipment booked by a customer, in creation order.
+
+    Args:
+        customer_id: ID of the customer whose shipments to list.
+
+    Returns:
+        The customer's shipments, or an empty list if there are none.
+
+    Raises:
+        DomainError: E_UNKNOWN_CUSTOMER if the customer does not exist.
+    """
+    if customer_id not in db.customers:
+        raise DomainError("E_UNKNOWN_CUSTOMER", customer_id)
+    return [s for s in db.shipments.values() if s.customer_id == customer_id]
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_list_shipments.py b/tests/unit/test_list_shipments.py
--- a/tests/unit/test_list_shipments.py	1969-12-31 19:00:00
+++ b/tests/unit/test_list_shipments.py	2026-11-12 02:22:16
@@ -0,0 +1,54 @@
+import pytest
+
+from parcelo import customers, events, shipments
+from parcelo.errors import DomainError
+from parcelo.store import db
+
+
+def test_lists_only_the_customers_shipments():
+    acme = customers.add_customer("Acme")
+    other = customers.add_customer("Other")
+    a1 = shipments.create_shipment(acme.id, 1.5, "national")
+    a2 = shipments.create_shipment(acme.id, 2.0, "local")
+    shipments.create_shipment(other.id, 3.0, "international")
+
+    events.OUTBOX.clear()
+    result = shipments.list_shipments(acme.id)
+
+    assert [s.id for s in result] == [a1.id, a2.id]
+    assert all(s.customer_id == acme.id for s in result)
+
+
+def test_customer_with_no_shipments_gets_empty_list():
+    c = customers.add_customer("Quiet")
+
+    assert shipments.list_shipments(c.id) == []
+
+
+def test_unknown_customer_raises_and_changes_nothing():
+    c = customers.add_customer("Acme")
+    shipments.create_shipment(c.id, 1.5, "national")
+    before = dict(db.shipments)
+
+    events.OUTBOX.clear()
+    with pytest.raises(DomainError) as err:
+        shipments.list_shipments("nope")
+
+    assert err.value.code == "E_UNKNOWN_CUSTOMER"
+    assert db.shipments == before
+    assert events.OUTBOX == []
+
+
+def test_listing_is_read_only():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 1.5, "national")
+    snapshot = dict(db.shipments)
+
+    events.OUTBOX.clear()
+    result = shipments.list_shipments(c.id)
+
+    assert result == [s]
+    assert db.shipments == snapshot
+    assert s.zone == "national"
+    assert s.status == "created"
+    assert events.OUTBOX == []
