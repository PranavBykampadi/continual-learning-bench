+def insurance_fee(declared_value, zone):
+    """Return the insurance fee for a shipment's declared value.
+
+    The fee is 2% of the declared value plus the zone's fuel surcharge
+    percentage of the declared value, rounded to cents once at the end.
+    The minimum fee is 1.00.
+
+    Args:
+        declared_value: Dollar amount as a Money, float, int, str or Decimal.
+        zone: One of the zones in FUEL_SURCHARGE_PCT.
+
+    Returns:
+        The fee as a Money.
+
+    Raises:
+        DomainError: E_BAD_ZONE if the zone is unknown. E_BAD_INPUT if the
+            declared value is zero, negative or not a number.
+    """
+    if zone not in FUEL_SURCHARGE_PCT:
+        raise DomainError("E_BAD_ZONE", zone)
+    try:
+        value = Money.parse(declared_value)
+    except (ArithmeticError, TypeError, ValueError):
+        raise DomainError("E_BAD_INPUT", str(declared_value))
+    if value.cents <= 0:
+        raise DomainError("E_BAD_INPUT", str(declared_value))
+    pct = INSURANCE_PCT + FUEL_SURCHARGE_PCT[zone]
+    fee = value.scale(pct / 100)
+    if fee < INSURANCE_MIN_FEE:
+        return INSURANCE_MIN_FEE
+    return fee
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_insurance.py b/tests/unit/test_insurance.py
--- a/tests/unit/test_insurance.py	1969-12-31 19:00:00
+++ b/tests/unit/test_insurance.py	2026-11-12 02:13:32
@@ -0,0 +1,66 @@
+import pytest
+
+from parcelo import audit, events, rates
+from parcelo.errors import DomainError
+from parcelo.legacy import billing
+from parcelo.money import Money
+
+
+def test_local_fee_is_two_percent():
+    assert rates.insurance_fee(Money(10000), "local") == Money(200)
+
+
+def test_national_fee_adds_fuel_surcharge():
+    # 2% + 4% of 100.00
+    assert rates.insurance_fee(Money(10000), "national") == Money(600)
+
+
+def test_international_fee_adds_fuel_surcharge():
+    # 2% + 9.5% of 100.00
+    assert rates.insurance_fee(Money(10000), "international") == Money(1150)
+
+
+def test_minimum_fee_applies_to_small_values():
+    # 2% of 10.00 is 0.20, so the 1.00 minimum applies
+    assert rates.insurance_fee(10, "local") == Money(100)
+
+
+def test_rounds_once_at_the_end():
+    # 11.5% of 33.33 is 3.832950, which rounds to 3.83
+    assert rates.insurance_fee("33.33", "international") == Money(383)
+
+
+def test_accepts_float_and_string_values():
+    assert rates.insurance_fee(250.0, "national") == Money(1500)
+    assert rates.insurance_fee("250.00", "national") == Money(1500)
+
+
+def test_surcharge_table_matches_legacy_billing():
+    for zone, pct in rates.FUEL_SURCHARGE_PCT.items():
+        # On a 100.00 base the legacy surcharge in dollars equals its percentage
+        assert billing.fuel_surcharge(100.0, zone) == pytest.approx(pct)
+
+
+def test_unknown_zone_fails_without_side_effects():
+    with pytest.raises(DomainError) as err:
+        rates.insurance_fee(Money(10000), "moon")
+    assert err.value.code == "E_BAD_ZONE"
+    assert audit.LOG == []
+    assert events.OUTBOX == []
+
+
+@pytest.mark.parametrize("value", [0, -5, -0.01, "0", "-1.00"])
+def test_zero_or_negative_value_fails_without_side_effects(value):
+    with pytest.raises(DomainError) as err:
+        rates.insurance_fee(value, "local")
+    assert err.value.code == "E_BAD_INPUT"
+    assert audit.LOG == []
+    assert events.OUTBOX == []
+
+
+def test_unparseable_value_fails_without_side_effects():
+    with pytest.raises(DomainError) as err:
+        rates.insurance_fee("lots", "local")
+    assert err.value.code == "E_BAD_INPUT"
+    assert audit.LOG == []
+    assert events.OUTBOX == []
