+
+def discounted_quote(weight_kg, zone, tier):
+    if tier not in TIER_FACTOR:
+        raise ValueError("unknown tier: %s" % tier)
+    regular = Money.parse(quote(weight_kg, zone))
+    return regular.scale(TIER_FACTOR[tier]).cents / 100
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_gold_discount.py b/tests/unit/test_gold_discount.py
--- a/tests/unit/test_gold_discount.py	1969-12-31 19:00:00
+++ b/tests/unit/test_gold_discount.py	2026-11-12 02:03:26
@@ -0,0 +1,27 @@
+import pytest
+
+from parcelo import rates
+
+
+def test_gold_gets_ten_percent_off():
+    # local, 2 kg: 4.5 + 1.25 * 2 = 7.00 regular
+    assert rates.discounted_quote(2, "local", "gold") == 6.3
+
+
+def test_standard_has_no_discount():
+    assert rates.discounted_quote(2, "local", "standard") == rates.quote(2, "local")
+
+
+def test_gold_discount_rounds_half_up_once():
+    # local, 1 kg: regular 5.75; 5.75 * 0.9 = 5.175 -> 5.18 (half up)
+    assert rates.discounted_quote(1, "local", "gold") == 5.18
+
+
+def test_unknown_tier_fails():
+    with pytest.raises(ValueError):
+        rates.discounted_quote(2, "local", "platinum")
+
+
+def test_unknown_zone_fails():
+    with pytest.raises(ValueError):
+        rates.discounted_quote(2, "moon", "gold")
