+def void_invoice(invoice_id: str) -> Invoice:
+    """Void an invoice that was issued by mistake.
+
+    Args:
+        invoice_id: ID of the invoice to void.
+
+    Returns:
+        The voided invoice.
+
+    Raises:
+        DomainError: E_NOT_FOUND if the invoice does not exist, or
+            E_BAD_STATE if it is already paid or already void.
+    """
+    invoice = get_invoice(invoice_id)
+    if invoice.status == "paid":
+        raise DomainError("E_BAD_STATE", f"{invoice_id} is already paid")
+    if invoice.status == "void":
+        raise DomainError("E_BAD_STATE", f"{invoice_id} is already void")
+    invoice.status = "void"
+    invoice.voided_at = clock.now()
+    audit.record("invoice.voided", invoice_id)
