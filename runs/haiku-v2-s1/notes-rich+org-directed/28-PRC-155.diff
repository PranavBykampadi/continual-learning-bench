+def customers_by_tier(tier):
+    """Return customers whose tier is `tier`, sorted by id. Read-only.
+
+    Raises DomainError("E_BAD_INPUT") if `tier` is not in TIERS.
+    """
+    if tier not in TIERS:
+        raise DomainError("E_BAD_INPUT", f"unknown tier {tier!r}")
+    matches = [c for c in db.customers.values() if c.tier == tier]
+    return sorted(matches, key=lambda c: c.id)
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_customers_by_tier.py b/tests/unit/test_customers_by_tier.py
--- a/tests/unit/test_customers_by_tier.py	1969-12-31 19:00:00
+++ b/tests/unit/test_customers_by_tier.py	2026-11-12 02:25:49
@@ -0,0 +1,39 @@
+import pytest
+
+from parcelo import customers, events
+from parcelo.errors import DomainError
+from parcelo.store import db
+
+
+def test_returns_only_customers_on_tier_sorted_by_id():
+    gold_b = customers.add_customer("Beta", tier="gold")
+    customers.add_customer("Acme", tier="standard")
+    gold_a = customers.add_customer("Alpha", tier="gold")
+    result = customers.customers_by_tier("gold")
+    assert [c.id for c in result] == sorted([gold_a.id, gold_b.id])
+    assert all(c.tier == "gold" for c in result)
+
+
+def test_empty_list_when_no_customers_on_tier():
+    customers.add_customer("Acme", tier="standard")
+    assert customers.customers_by_tier("gold") == []
+
+
+def test_unknown_tier_fails_and_changes_nothing():
+    customers.add_customer("Acme", tier="standard")
+    before = dict(db.customers)
+    with pytest.raises(DomainError) as err:
+        customers.customers_by_tier("platinum")
+    assert err.value.code == "E_BAD_INPUT"
+    assert db.customers == before
+    assert events.OUTBOX == []
+
+
+def test_read_only_no_events_and_no_mutation():
+    c = customers.add_customer("Acme", tier="gold")
+    before = dict(db.customers)
+    events_before = len(events.OUTBOX)
+    result = customers.customers_by_tier("gold")
+    assert result == [c]
+    assert db.customers == before
+    assert len(events.OUTBOX) == events_before
