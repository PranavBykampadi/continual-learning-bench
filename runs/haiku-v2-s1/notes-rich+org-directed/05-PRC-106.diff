+def get_invoice(invoice_id):
+    """Return the invoice with the given ID.
+
+    Args:
+        invoice_id: ID of the invoice to fetch.
+
+    Returns:
+        The stored Invoice.
+
+    Raises:
+        DomainError: E_NOT_FOUND if no invoice has that ID.
+    """
+    if invoice_id not in db.invoices:
+        raise DomainError("E_NOT_FOUND", invoice_id)
+    return db.invoices[invoice_id]
+
+
+def late_fee_for(invoice_id):
+    """Return the late fee an invoice has accrued as of now.
+
+    The invoice becomes late 30 days after it was issued. From then on the fee
+    is 1.5% of the invoice amount for each whole day past those 30 days.
+
+    Args:
+        invoice_id: ID of the invoice to check.
+
+    Returns:
+        A Money amount. Zero if the invoice is not late yet.
+
+    Raises:
+        DomainError: E_NOT_FOUND if no invoice has that ID, or E_BAD_STATE if
+            the invoice has no issue date.
+    """
+    invoice = get_invoice(invoice_id)
+    if invoice.issued_at is None:
+        raise DomainError("E_BAD_STATE", invoice_id)
+    issued = invoice.issued_at
+    if issued.tzinfo is None:
+        # Older invoices store naive UTC from datetime.utcnow().
+        issued = issued.replace(tzinfo=timezone.utc)
+    days_late = (clock.now() - issued).days - LATE_AFTER_DAYS
+    if days_late <= 0:
+        return Money.zero()
+    return Money.parse(invoice.amount).scale(LATE_FEE_PER_DAY * days_late)
