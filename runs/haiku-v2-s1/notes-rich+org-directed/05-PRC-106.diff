@@ -0,0 +1,107 @@
+from datetime import datetime, timedelta, timezone
+
+import pytest
+
+from parcelo import audit, clock, invoices
+from parcelo.errors import DomainError
+from parcelo.models import Invoice
+from parcelo.money import Money
+from parcelo.store import db
+
+ISSUED = datetime(2026, 1, 1, 12, 0, tzinfo=timezone.utc)
+
+
+def _make_invoice(amount=7.0, issued_at=ISSUED):
+    invoice = Invoice(
+        id="INV-test0001",
+        shipment_id="shp_000001",
+        amount=amount,
+        issued_at=issued_at,
+    )
+    db.invoices[invoice.id] = invoice
+    return invoice
+
+
+def _pin_now(after_issue):
+    clock.set_fixed(ISSUED + after_issue)
+
+
+def test_fee_for_days_past_thirty():
+    inv = _make_invoice(amount=7.0)
+    _pin_now(timedelta(days=40))  # 10 days past the 30-day mark
+    fee = invoices.late_fee_for(inv.id)
+    # 1.5% per day x 10 days on 700 cents = 105 cents
+    assert fee == Money(105)
+
+
+def test_returns_money_not_float():
+    inv = _make_invoice(amount=7.0)
+    _pin_now(timedelta(days=31))
+    fee = invoices.late_fee_for(inv.id)
+    assert isinstance(fee, Money)
+    assert isinstance(fee.cents, int)
+
+
+def test_not_late_at_thirty_days():
+    inv = _make_invoice()
+    _pin_now(timedelta(days=30))
+    assert invoices.late_fee_for(inv.id) == Money.zero()
+
+
+def test_not_late_before_thirty_days():
+    inv = _make_invoice()
+    _pin_now(timedelta(days=12))
+    assert invoices.late_fee_for(inv.id) == Money.zero()
+
+
+def test_partial_day_does_not_count():
+    inv = _make_invoice()
+    _pin_now(timedelta(days=30, hours=23))  # 30 whole days elapsed, still 0 late days
+    assert invoices.late_fee_for(inv.id) == Money.zero()
+
+
+def test_one_day_late_rounds_at_the_end():
+    inv = _make_invoice(amount=7.0)
+    _pin_now(timedelta(days=31))
+    # 700 cents x 0.015 = 10.5 cents, rounded half up once at the end
+    assert invoices.late_fee_for(inv.id) == Money(11)
+
+
+def test_naive_issue_date_from_issue_invoice():
+    from parcelo import customers, shipments
+
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 2, "local")
+    inv = invoices.issue_invoice(s.id)
+    # issue_invoice stores a naive UTC datetime; pin "now" 35 days after it
+    naive = inv.issued_at
+    assert naive.tzinfo is None
+    clock.set_fixed(naive.replace(tzinfo=timezone.utc) + timedelta(days=35))
+    # 5 late days x 1.5% = 7.5% of 700 cents = 52.5, rounded half up to 53
+    assert invoices.late_fee_for(inv.id) == Money(53)
+
+
+def test_unknown_invoice_raises_not_found():
+    _make_invoice()
+    before = dict(db.invoices)
+    with pytest.raises(DomainError) as err:
+        invoices.late_fee_for("INV-missing")
+    assert err.value.code == "E_NOT_FOUND"
+    assert audit.LOG == []
+    assert db.invoices == before
+
+
+def test_invoice_without_issue_date_is_bad_state():
+    inv = _make_invoice(issued_at=None)
+    before = dict(db.invoices)
+    with pytest.raises(DomainError) as err:
+        invoices.late_fee_for(inv.id)
+    assert err.value.code == "E_BAD_STATE"
+    assert audit.LOG == []
+    assert db.invoices == before
+
+
