+def reactivate_customer(customer_id: str) -> Customer:
+    """Set a customer's active flag back to True.
+
+    Calling this on a customer that is already active returns it unchanged
+    and emits no event, so retries are safe.
+
+    Args:
+        customer_id: ID of the customer to reactivate.
+
+    Returns:
+        The customer, with ``active`` set to True.
+
+    Raises:
+        DomainError: ``E_UNKNOWN_CUSTOMER`` if no such customer exists.
+    """
+    if customer_id not in db.customers:
+        raise DomainError("E_UNKNOWN_CUSTOMER", customer_id)
+    customer = db.customers[customer_id]
+    if customer.active:
+        return customer
+    customer.active = True
+    events.emit("customer.reactivated", customer.id)
+    return customer
 
 
