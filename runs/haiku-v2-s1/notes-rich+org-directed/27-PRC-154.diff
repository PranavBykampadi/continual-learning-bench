diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_customer_reactivate.py b/tests/unit/test_customer_reactivate.py
--- a/tests/unit/test_customer_reactivate.py	1969-12-31 19:00:00
+++ b/tests/unit/test_customer_reactivate.py	2026-11-12 02:24:53
@@ -0,0 +1,57 @@
+import pytest
+
+from parcelo import customers, events
+from parcelo.errors import DomainError
+from parcelo.store import db
+
+
+def test_reactivates_inactive_customer():
+    c = customers.add_customer("Acme")
+    c.active = False
+    before = len(events.OUTBOX)
+
+    result = customers.reactivate_customer(c.id)
+
+    assert result is c
+    assert result.active is True
+    assert len(events.OUTBOX) == before + 1
+    assert events.OUTBOX[-1]["name"] == "customer.reactivated"
+    assert events.OUTBOX[-1]["entity_id"] == c.id
+
+
+def test_already_active_returns_unchanged_and_emits_nothing():
+    c = customers.add_customer("Acme")
+    before = len(events.OUTBOX)
+
+    result = customers.reactivate_customer(c.id)
+
+    assert result is c
+    assert result.active is True
+    assert len(events.OUTBOX) == before
+
+
+def test_repeat_call_emits_only_once():
+    c = customers.add_customer("Acme")
+    c.active = False
+    customers.reactivate_customer(c.id)
+    before = len(events.OUTBOX)
+
+    result = customers.reactivate_customer(c.id)
+
+    assert result.active is True
+    assert len(events.OUTBOX) == before
+
+
+def test_unknown_customer_fails_and_changes_nothing():
+    other = customers.add_customer("Other")
+    other.active = False
+    before_outbox = len(events.OUTBOX)
+    before_ids = set(db.customers)
+
+    with pytest.raises(DomainError) as err:
+        customers.reactivate_customer("C-missing")
+
+    assert err.value.code == "E_UNKNOWN_CUSTOMER"
+    assert other.active is False
+    assert set(db.customers) == before_ids
+    assert len(events.OUTBOX) == before_outbox
