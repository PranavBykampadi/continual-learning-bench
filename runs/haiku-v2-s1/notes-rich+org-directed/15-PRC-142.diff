diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_reopen_invoice.py b/tests/unit/test_reopen_invoice.py
--- a/tests/unit/test_reopen_invoice.py	1969-12-31 19:00:00
+++ b/tests/unit/test_reopen_invoice.py	2026-11-12 02:10:57
@@ -0,0 +1,66 @@
+from datetime import datetime, timezone
+
+import pytest
+
+from parcelo import clock, customers, events, invoices, shipments
+from parcelo.errors import DomainError
+
+
+def _issued_invoice():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 2, "local")
+    return invoices.issue_invoice(s.id)
+
+
+def test_reopen_paid_invoice_sets_open_clears_paid_at_and_records_time():
+    moment = datetime(2026, 11, 1, 12, 0, tzinfo=timezone.utc)
+    clock.set_fixed(moment)
+    inv = _issued_invoice()
+    invoices.mark_paid(inv.id)
+    events_before = len(events.OUTBOX)
+
+    result = invoices.reopen_invoice(inv.id)
+
+    assert result is inv
+    assert inv.status == "open"
+    assert inv.paid_at is None
+    assert inv.reopened_at == moment
+    assert len(events.OUTBOX) == events_before + 1
+    assert events.OUTBOX[-1]["name"] == "invoice.reopened"
+    assert events.OUTBOX[-1]["entity_id"] == inv.id
+
+
+def test_reopened_invoice_is_open_again():
+    inv = _issued_invoice()
+    invoices.mark_paid(inv.id)
+    invoices.reopen_invoice(inv.id)
+    assert inv in invoices.open_invoices()
+
+
+def test_unknown_invoice_raises_not_found_and_changes_nothing():
+    inv = _issued_invoice()
+    invoices.mark_paid(inv.id)
+    events_before = len(events.OUTBOX)
+
+    with pytest.raises(DomainError) as err:
+        invoices.reopen_invoice("INV-missing")
+
+    assert err.value.code == "E_NOT_FOUND"
+    assert inv.status == "paid"
+    assert inv.reopened_at is None
+    assert len(events.OUTBOX) == events_before
+
+
+def test_open_invoice_raises_bad_state_and_changes_nothing():
+    inv = _issued_invoice()
+    paid_at_before = inv.paid_at
+    events_before = len(events.OUTBOX)
+
+    with pytest.raises(DomainError) as err:
+        invoices.reopen_invoice(inv.id)
+
+    assert err.value.code == "E_BAD_STATE"
+    assert inv.status == "open"
+    assert inv.paid_at == paid_at_before
+    assert inv.reopened_at is None
+    assert len(events.OUTBOX) == events_before
