@@ -32,3 +34,28 @@
 
 def open_invoices():
     return [i for i in db.invoices.values() if i.status == "open"]
+
+
+def reopen_invoice(invoice_id: str) -> Invoice:
+    """Set a paid invoice back to open, clearing paid_at.
+
+    Args:
+        invoice_id: ID of the invoice to reopen.
+
+    Returns:
+        The reopened invoice.
+
+    Raises:
+        DomainError: "E_NOT_FOUND" if the invoice does not exist, or
+            "E_BAD_STATE" if it is not paid. Nothing is changed in either case.
+    """
+    if invoice_id not in db.invoices:
+        raise DomainError("E_NOT_FOUND", invoice_id)
+    invoice = db.invoices[invoice_id]
+    if invoice.status != "paid":
+        raise DomainError("E_BAD_STATE", invoice_id)
+    invoice.status = "open"
+    invoice.paid_at = None
+    invoice.reopened_at = clock.now()
+    events.emit("invoice.reopened", invoice.id)
+    return invoice
