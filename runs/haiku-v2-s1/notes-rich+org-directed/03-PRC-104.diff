+def deactivate_customer(customer_id):
+    """Switch off a customer who has left.
+
+    Args:
+        customer_id: ID of the customer to deactivate.
+
+    Returns:
+        The customer, with its ``active`` flag set to False.
+
+    Raises:
+        DomainError: ``E_NOT_FOUND`` if no customer has this ID, or
+            ``E_BAD_STATE`` if the customer is already inactive.
+    """
+    if customer_id not in db.customers:
+        raise DomainError("E_NOT_FOUND", customer_id)
+    customer = db.customers[customer_id]
+    if not customer.active:
+        raise DomainError("E_BAD_STATE", customer_id)
+    customer.active = False
+    audit.record("customer.deactivated", customer_id)
+    return customer
 
 
