diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_customer_deactivate.py b/tests/unit/test_customer_deactivate.py
--- a/tests/unit/test_customer_deactivate.py	1969-12-31 19:00:00
+++ b/tests/unit/test_customer_deactivate.py	2026-11-12 01:55:48
@@ -0,0 +1,38 @@
+import pytest
+
+from parcelo import audit, customers
+from parcelo.errors import DomainError
+from parcelo.models import Customer
+
+
+def test_deactivate_returns_customer_and_clears_active():
+    c = customers.add_customer("Acme")
+    result = customers.deactivate_customer(c.id)
+    assert isinstance(result, Customer)
+    assert result.id == c.id
+    assert result.active is False
+    assert customers.get_customer(c.id).active is False
+
+
+def test_deactivate_records_audit():
+    c = customers.add_customer("Acme")
+    customers.deactivate_customer(c.id)
+    assert audit.LOG[-1]["action"] == "customer.deactivated"
+    assert audit.LOG[-1]["entity_id"] == c.id
+
+
+def test_deactivate_unknown_customer():
+    with pytest.raises(DomainError) as err:
+        customers.deactivate_customer("nope")
+    assert err.value.code == "E_NOT_FOUND"
+    assert audit.LOG == []
+
+
+def test_deactivate_already_inactive_customer():
+    c = customers.add_customer("Acme")
+    customers.deactivate_customer(c.id)
+    audit_count = len(audit.LOG)
+    with pytest.raises(DomainError) as err:
+        customers.deactivate_customer(c.id)
+    assert err.value.code == "E_BAD_STATE"
+    assert len(audit.LOG) == audit_count
