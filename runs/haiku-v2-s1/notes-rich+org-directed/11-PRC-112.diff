diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_claims.py b/tests/unit/test_claims.py
--- a/tests/unit/test_claims.py	1969-12-31 19:00:00
+++ b/tests/unit/test_claims.py	2026-11-12 02:05:44
@@ -0,0 +1,89 @@
+from datetime import datetime, timezone
+from decimal import Decimal
+
+import pytest
+
+from parcelo import audit, claims, clock, customers, shipments, store
+from parcelo.errors import DomainError
+from parcelo.money import Money
+
+
+def _delivered_shipment():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 2.0, "national")
+    s.status = "delivered"
+    return s
+
+
+def test_file_claim_on_delivered_shipment():
+    clock.set_fixed(datetime(2026, 11, 12, 9, 0, tzinfo=timezone.utc))
+    s = _delivered_shipment()
+    claim = claims.file_claim(s.id, 12.5, "box arrived crushed")
+
+    assert claim.id.startswith("clm_")
+    assert claim.shipment_id == s.id
+    assert claim.amount == Money(1250)
+    assert claim.reason == "box arrived crushed"
+    assert claim.filed_at == datetime(2026, 11, 12, 9, 0, tzinfo=timezone.utc)
+    assert store.db.claims[claim.id] is claim
+    assert audit.LOG[-1]["action"] == "claim.filed"
+    assert audit.LOG[-1]["entity_id"] == claim.id
+
+
+@pytest.mark.parametrize(
+    "amount, cents",
+    [
+        (Money(999), 999),
+        ("3.10", 310),
+        (Decimal("0.07"), 7),
+        (4, 400),
+        (0.1 + 0.2, 30),
+    ],
+)
+def test_amount_accepts_money_and_raw_values(amount, cents):
+    s = _delivered_shipment()
+    claim = claims.file_claim(s.id, amount, "damaged")
+    assert isinstance(claim.amount, Money)
+    assert claim.amount.cents == cents
+
+
+def test_unknown_shipment_is_not_found():
+    with pytest.raises(DomainError) as err:
+        claims.file_claim("shp_nope", 5, "lost")
+    assert err.value.code == "E_NOT_FOUND"
+    assert store.db.claims == {}
+
+
+@pytest.mark.parametrize("status", ["created", "in_transit", "lost"])
+def test_undelivered_shipment_is_bad_state(status):
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 1, "local")
+    s.status = status
+    before = len(audit.LOG)
+    with pytest.raises(DomainError) as err:
+        claims.file_claim(s.id, 5, "late")
+    assert err.value.code == "E_BAD_STATE"
+    assert store.db.claims == {}
+    assert len(audit.LOG) == before
+
+
+@pytest.mark.parametrize("amount", [0, -1, -0.01, "0", "-2.50", 0.004])
+def test_non_positive_amount_is_bad_input(amount):
+    s = _delivered_shipment()
+    before = len(audit.LOG)
+    with pytest.raises(DomainError) as err:
+        claims.file_claim(s.id, amount, "nope")
+    assert err.value.code == "E_BAD_INPUT"
+    assert store.db.claims == {}
+    assert len(audit.LOG) == before
+
+
+@pytest.mark.parametr