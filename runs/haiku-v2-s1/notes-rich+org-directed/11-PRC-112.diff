--- a/parcelo/claims.py	1969-12-31 19:00:00
+++ b/parcelo/claims.py	2026-11-12 02:05:32
@@ -0,0 +1,48 @@
+from decimal import InvalidOperation
+
+from parcelo import audit, clock, ids
+from parcelo.errors import DomainError
+from parcelo.models import Claim
+from parcelo.money import Money
+from parcelo.shipments import get_shipment
+from parcelo.store import db
+
+
+def file_claim(shipment_id, amount, reason):
+    """File a claim against a delivered shipment.
+
+    Args:
+        shipment_id: ID of the shipment the claim is about.
+        amount: Claimed amount as Money, float, int, str or Decimal. Must be positive.
+        reason: Free-text reason for the claim.
+
+    Returns:
+        The stored Claim.
+
+    Raises:
+        DomainError: E_NOT_FOUND if the shipment does not exist, E_BAD_INPUT if the
+            amount is missing, malformed or not positive, E_BAD_STATE if the shipment
+            has not been delivered.
+    """
+    shipment = get_shipment(shipment_id)
+    try:
+        money = Money.parse(amount)
+    except (InvalidOperation, TypeError, ValueError):
+        raise DomainError("E_BAD_INPUT", f"invalid claim amount: {amount!r}") from None
+    if money.cents <= 0:
+        raise DomainError("E_BAD_INPUT", f"claim amount must be positive: {amount!r}")
+    if shipment.status != "delivered":
+        raise DomainError(
+            "E_BAD_STATE",
+            f"shipment {shipment_id} is {shipment.status}, claims need a delivered shipment",
+        )
+    claim = Claim(
+        id=ids.new_id("clm"),
+        shipment_id=shipment_id,
+        amount=money,
+        reason=reason,
+        filed_at=clock.now(),
+    )
+    db.claims[claim.id] = claim
+    audit.record("claim.filed", claim.id, shipment_id=shipment_id)
+    return claim
