+def heavy_quote(weight_kg: float, zone: str) -> Money:
+    """Quote a parcel, adding a surcharge for weight above the heavy threshold.
+
+    Read-only. The surcharge is HEAVY_SURCHARGE_PER_KG for each kg above
+    HEAVY_WEIGHT_KG; parcels at or below the threshold get the normal quote.
+
+    Args:
+        weight_kg: Parcel weight in kilograms. Must be positive.
+        zone: Shipping zone. Must be a key of ZONE_BASE.
+
+    Returns:
+        The normal quote plus the heavy surcharge, as Money.
+
+    Raises:
+        DomainError: E_BAD_ZONE for an unknown zone, E_BAD_WEIGHT for a
+            weight that is not positive.
+    """
+    if zone not in ZONE_BASE:
+        raise DomainError("E_BAD_ZONE", f"unknown zone: {zone}")
+    if weight_kg <= 0:
+        raise DomainError("E_BAD_WEIGHT", "weight must be positive")
+    total = Money.parse(quote(weight_kg, zone))
+    excess_kg = weight_kg - HEAVY_WEIGHT_KG
+    if excess_kg > 0:
+        total = total + Money.parse(HEAVY_SURCHARGE_PER_KG).scale(excess_kg)
+    return total
