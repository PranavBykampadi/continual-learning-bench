@@ -0,0 +1,11 @@
+"""Business thresholds and rates.
+
+Finance or product may ask us to change these. Import them by name; do not
+repeat the numbers in function bodies.
+"""
+
+# Parcels heavier than this many kg pay the heavy surcharge on the excess.
+HEAVY_WEIGHT_KG = 30
+
+# Surcharge in dollars per kg above HEAVY_WEIGHT_KG.
+HEAVY_SURCHARGE_PER_KG = 0.75
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_heavy_quote.py b/tests/unit/test_heavy_quote.py
--- a/tests/unit/test_heavy_quote.py	1969-12-31 19:00:00
+++ b/tests/unit/test_heavy_quote.py	2026-11-12 02:26:50
@@ -0,0 +1,41 @@
+import pytest
+
+from parcelo import events, rates
+from parcelo.errors import DomainError
+from parcelo.money import Money
+
+
+def test_at_threshold_gets_normal_quote():
+    # 4.5 + 1.25 * 30 = 42.00
+    assert rates.heavy_quote(30, "local") == Money.parse(42.0)
+
+
+def test_one_kg_over_adds_surcharge():
+    # 4.5 + 1.25 * 31 = 43.25, plus 0.75 = 44.00
+    assert rates.heavy_quote(31, "local") == Money.parse(44.0)
+
+
+def test_surcharge_scales_with_excess():
+    # 9.0 + 1.25 * 40 = 59.00, plus 0.75 * 10 = 7.50
+    assert rates.heavy_quote(40, "national") == Money.parse(66.5)
+
+
+def test_light_parcel_matches_normal_quote():
+    assert rates.heavy_quote(2, "local") == Money.parse(rates.quote(2, "local"))
+
+
+def test_unknown_zone_fails_and_emits_nothing():
+    before = len(events.OUTBOX)
+    with pytest.raises(DomainError) as err:
+        rates.heavy_quote(40, "moon")
+    assert err.value.code == "E_BAD_ZONE"
+    assert len(events.OUTBOX) == before
+
+
+@pytest.mark.parametrize("weight", [0, -1])
+def test_non_positive_weight_fails_and_emits_nothing(weight):
+    before = len(events.OUTBOX)
+    with pytest.raises(DomainError) as err:
+        rates.heavy_quote(weight, "local")
+    assert err.value.code == "E_BAD_WEIGHT"
+    assert len(events.OUTBOX) == before
