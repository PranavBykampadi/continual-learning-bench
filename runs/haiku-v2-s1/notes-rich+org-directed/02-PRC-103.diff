+def quote_with_surcharge(weight_kg: float, zone: str) -> dict[str, float]:
+    """Quote a shipment and add the fuel surcharge for its zone.
+
+    Args:
+        weight_kg: Shipment weight in kilograms. Must be greater than zero.
+        zone: Shipping zone, one of the keys of ``ZONE_BASE``.
+
+    Returns:
+        A dict with ``quote`` (the normal quote), ``surcharge`` (the fuel
+        surcharge for the zone) and ``total`` (quote plus surcharge). Amounts
+        are in dollars, rounded to cents at the end of the calculation.
+
+    Raises:
+        DomainError: ``E_BAD_ZONE`` if the zone is unknown, or ``E_BAD_WEIGHT``
+            if the weight is zero or negative.
+    """
+    if zone not in ZONE_BASE:
+        raise DomainError("E_BAD_ZONE", zone)
+    if weight_kg <= 0:
+        raise DomainError("E_BAD_WEIGHT", str(weight_kg))
+    unrounded = ZONE_BASE[zone] + PER_KG * weight_kg
+    surcharge_unrounded = unrounded * FUEL_SURCHARGE_PCT[zone] / 100.0
+    return {
+        "quote": quote(weight_kg, zone),
+        "surcharge": round(surcharge_unrounded, 2),
+        "total": round(unrounded + surcharge_unrounded, 2),
+    }
