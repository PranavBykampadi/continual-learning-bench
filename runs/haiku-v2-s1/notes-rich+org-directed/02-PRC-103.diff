--- a/tests/unit/test_quote_with_surcharge.py	1969-12-31 19:00:00
+++ b/tests/unit/test_quote_with_surcharge.py	2026-11-12 01:54:14
@@ -0,0 +1,54 @@
+import pytest
+
+from parcelo import rates
+from parcelo.errors import DomainError
+from parcelo.legacy import billing
+
+
+def test_national_quote_with_surcharge():
+    # base 9.0 + 1.25 * 2 = 11.50, plus 4% = 0.46
+    assert rates.quote_with_surcharge(2, "national") == {
+        "quote": 11.5,
+        "surcharge": 0.46,
+        "total": 11.96,
+    }
+
+
+def test_local_quote_has_no_surcharge():
+    assert rates.quote_with_surcharge(2, "local") == {
+        "quote": 7.0,
+        "surcharge": 0.0,
+        "total": 7.0,
+    }
+
+
+def test_international_quote_with_surcharge():
+    # base 24.0 + 1.25 * 8 = 34.00, plus 9.5% = 3.23
+    assert rates.quote_with_surcharge(8, "international") == {
+        "quote": 34.0,
+        "surcharge": 3.23,
+        "total": 37.23,
+    }
+
+
+def test_quote_field_matches_plain_quote():
+    result = rates.quote_with_surcharge(3.3, "national")
+    assert result["quote"] == rates.quote(3.3, "national")
+
+
+@pytest.mark.parametrize("zone", sorted(rates.ZONE_BASE))
+def test_surcharge_pct_matches_legacy(zone):
+    assert rates.FUEL_SURCHARGE_PCT[zone] == billing.fuel_surcharge(100.0, zone)
+
+
+def test_unknown_zone():
+    with pytest.raises(DomainError) as err:
+        rates.quote_with_surcharge(2, "moon")
+    assert err.value.code == "E_BAD_ZONE"
+
+
+@pytest.mark.parametrize("weight", [0, -1, -0.5])
+def test_non_positive_weight(weight):
+    with pytest.raises(DomainError) as err:
+        rates.quote_with_surcharge(weight, "national")
+    assert err.value.code == "E_BAD_WEIGHT"
