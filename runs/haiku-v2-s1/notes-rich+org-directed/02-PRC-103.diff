+from parcelo.errors import DomainError
+
 ZONE_BASE = {"local": 4.5, "national": 9.0, "international": 24.0}
+# Same percentages as parcelo.legacy.billing.fuel_surcharge.
+FUEL_SURCHARGE_PCT = {"local": 0.0, "national": 4.0, "international": 9.5}
 PER_KG = 1.25
 
 
@@ -12,3 +16,32 @@
