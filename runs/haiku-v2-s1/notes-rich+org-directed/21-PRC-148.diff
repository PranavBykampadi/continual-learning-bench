diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_disputes.py b/tests/unit/test_disputes.py
--- a/tests/unit/test_disputes.py	1969-12-31 19:00:00
+++ b/tests/unit/test_disputes.py	2026-11-12 02:18:53
@@ -0,0 +1,65 @@
+from datetime import datetime, timezone
+
+import pytest
+
+from parcelo import audit, clock, customers, disputes, events, invoices, shipments
+from parcelo.errors import DomainError
+from parcelo.store import db
+
+
+def _make_invoice():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 2, "local")
+    inv = invoices.issue_invoice(s.id)
+    # Setup emits events; clear them so assertions only see the action under test.
+    events.OUTBOX.clear()
+    audit.LOG.clear()
+    return inv
+
+
+def test_open_dispute_creates_and_stores_record():
+    inv = _make_invoice()
+    clock.set_fixed(datetime(2026, 11, 12, 9, 30, tzinfo=timezone.utc))
+
+    dispute = disputes.open_dispute(inv.id, "Wrong weight charged")
+
+    assert dispute.id.startswith("dis_")
+    assert dispute.invoice_id == inv.id
+    assert dispute.reason == "Wrong weight charged"
+    assert dispute.opened_at == datetime(2026, 11, 12, 9, 30, tzinfo=timezone.utc)
+    assert db.disputes[dispute.id] is dispute
+
+
+def test_open_dispute_emits_event():
+    inv = _make_invoice()
+
+    dispute = disputes.open_dispute(inv.id, "Not received")
+
+    assert len(events.OUTBOX) == 1
+    assert events.OUTBOX[-1]["name"] == "dispute.opened"
+    assert events.OUTBOX[-1]["entity_id"] == dispute.id
+    assert events.OUTBOX[-1]["payload"] == {"invoice_id": inv.id}
+
+
+def test_unknown_invoice_fails_and_changes_nothing():
+    with pytest.raises(DomainError) as err:
+        disputes.open_dispute("inv_missing", "Duplicate charge")
+
+    assert err.value.code == "E_NOT_FOUND"
+    assert db.disputes == {}
+    assert events.OUTBOX == []
+    assert audit.LOG == []
+
+
+@pytest.mark.parametrize("reason", ["", "   ", None])
+def test_empty_reason_fails_and_changes_nothing(reason):
+    inv = _make_invoice()
+
+    with pytest.raises(DomainError) as err:
+        disputes.open_dispute(inv.id, reason)
+
+    assert err.value.code == "E_BAD_INPUT"
+    assert db.disputes == {}
+    assert events.OUTBOX == []
+    assert audit.LOG == []
+    assert db.invoices[inv.id].status == "open"
