+"""Business thresholds and limits.
+
+Anything finance or product may ask us to change lives here as an UPPER_CASE
+constant. Functions import these instead of using bare numbers.
+"""
+
+from parcelo.money import Money
+
+# customers.needs_review: flag when open invoices exceed this count.
+REVIEW_OPEN_INVOICE_COUNT = 3
+
+# customers.needs_review: flag when the open invoice total exceeds this amount.
+REVIEW_OPEN_BALANCE = Money.parse("250.00")
