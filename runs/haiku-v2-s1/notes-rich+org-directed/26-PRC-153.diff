+import pytest
+
+from parcelo import customers, events, shipments
+from parcelo.errors import DomainError
+from parcelo.models import Invoice
+from parcelo.store import db
+
+
+def _customer_with_shipment(name="Acme"):
+    c = customers.add_customer(name)
+    s = shipments.create_shipment(c.id, 1.0, "local")
+    return c, s
+
+
+def _add_invoice(shipment, amount, status="open"):
+    invoice = Invoice(
+        id=f"INV-T{len(db.invoices) + 1:04d}",
+        shipment_id=shipment.id,
+        amount=amount,
+        status=status,
+    )
+    db.invoices[invoice.id] = invoice
+    return invoice
+
+
+def test_no_invoices_does_not_need_review():
+    c, _ = _customer_with_shipment()
+    assert customers.needs_review(c.id) is False
+
+
+def test_three_open_invoices_under_limit_does_not_need_review():
+    c, s = _customer_with_shipment()
+    for _ in range(3):
+        _add_invoice(s, 10.00)
+    assert customers.needs_review(c.id) is False
+
+
+def test_four_open_invoices_needs_review():
+    c, s = _customer_with_shipment()
+    for _ in range(4):
+        _add_invoice(s, 10.00)
+    assert customers.needs_review(c.id) is True
+
+
+def test_open_balance_over_limit_needs_review():
+    c, s = _customer_with_shipment()
+    _add_invoice(s, 250.01)
+    assert customers.needs_review(c.id) is True
+
+
+def test_open_balance_exactly_at_limit_does_not_need_review():
+    c, s = _customer_with_shipment()
+    _add_invoice(s, 100.00)
+    _add_invoice(s, 150.00)
+    assert customers.needs_review(c.id) is False
+
+
+def test_float_amounts_are_summed_in_cents():
+    # 0.1 + 0.2 style float drift must not push the total over 250.00.
+    c, s = _customer_with_shipment()
+    for _ in range(3):
+        _add_invoice(s, 83.33)  # 249.99 total
+    assert customers.needs_review(c.id) is False
+
+
+def test_paid_invoices_are_not_counted():
+    c, s = _customer_with_shipment()
+    for _ in range(5):
+        _add_invoice(s, 100.00, status="paid")
+    _add_invoice(s, 10.00)
+    assert customers.needs_review(c.id) is False
+
+
+def test_other_customers_invoices_are_not_counted():
+    c, s = _customer_with_shipment("Acme")
+    other, other_s = _customer_with_shipment("Other")
+    for _ in range(4):
+        _add_invoice(other_s, 100.00)
+    assert customers.needs_review(c.id) is False
+    assert customers.needs_review(other.id) is True
+
+
