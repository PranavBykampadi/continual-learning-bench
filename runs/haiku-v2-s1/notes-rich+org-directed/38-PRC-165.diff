+def shipments_without_invoice():
+    """Return the shipments that no invoice refers to.
+
+    Read-only. Raises no errors.
+
+    Returns:
+        list: Shipment objects with no invoice, sorted by ``id`` ascending.
+    """
+    invoiced = {i.shipment_id for i in db.invoices.values()}
+    return sorted(
+        (s for s in db.shipments.values() if s.id not in invoiced),
+        key=lambda s: s.id,
+    )
+
