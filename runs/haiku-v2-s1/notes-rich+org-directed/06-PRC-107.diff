--- a/parcelo/shipments.py	2026-11-10 12:17:53
+++ b/parcelo/shipments.py	2026-11-12 02:00:13
@@ -28,3 +28,25 @@
     if shipment_id not in db.shipments:
         raise DomainError("E_NOT_FOUND", shipment_id)
     return db.shipments[shipment_id]
+
+
+def mark_delivered(shipment_id: str) -> Shipment:
+    """Mark a shipment as delivered and stamp the delivery time.
+
+    Args:
+        shipment_id: ID of the shipment that was delivered.
+
+    Returns:
+        The updated Shipment with status "delivered" and delivered_at set.
+
+    Raises:
+        DomainError: E_NOT_FOUND if the shipment does not exist, or
+            E_BAD_STATE if it is cancelled or already delivered.
+    """
+    shipment = get_shipment(shipment_id)
+    if shipment.status in ("cancelled", "delivered"):
+        raise DomainError("E_BAD_STATE", shipment_id)
+    shipment.status = "delivered"
+    shipment.delivered_at = clock.now()
+    audit.record("shipment.delivered", shipment.id)
+    return shipment
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_mark_delivered.py b/tests/unit/test_mark_delivered.py
--- a/tests/unit/test_mark_delivered.py	1969-12-31 19:00:00
+++ b/tests/unit/test_mark_delivered.py	2026-11-12 02:00:16
@@ -0,0 +1,63 @@
+from datetime import datetime, timezone
+
+import pytest
+
+from parcelo import audit, clock, customers, shipments
+from parcelo.errors import DomainError
+from parcelo.store import db
+
+DELIVERED_AT = datetime(2026, 11, 12, 9, 30, tzinfo=timezone.utc)
+
+
+def _new_shipment():
+    c = customers.add_customer("Acme")
+    return shipments.create_shipment(c.id, 1.5, "national")
+
+
+def test_mark_delivered_sets_status_and_time():
+    clock.set_fixed(DELIVERED_AT)
+    s = _new_shipment()
+    result = shipments.mark_delivered(s.id)
+    assert result is s
+    assert s.status == "delivered"
+    assert s.delivered_at == DELIVERED_AT
+
+
+def test_mark_delivered_records_audit():
+    s = _new_shipment()
+    shipments.mark_delivered(s.id)
+    assert audit.LOG[-1]["action"] == "shipment.delivered"
+    assert audit.LOG[-1]["entity_id"] == s.id
+
+
+def test_mark_delivered_unknown_id():
+    with pytest.raises(DomainError) as err:
+        shipments.mark_delivered("shp_missing")
+    assert err.value.code == "E_NOT_FOUND"
+    assert audit.LOG == []
+
+
+def test_mark_delivered_cancelled_fails():
+    s = _new_shipment()
+    s.status = "cancelled"
+    audit_before = len(audit.LOG)
+    with pytest.raises(DomainError) as err:
+        shipments.mark_delivered(s.id)
+    assert err.value.code == "E_BAD_STATE"
+    assert s.status == "cancelled"
+    assert s.delivered_at is None
+    assert len(audit.LOG) == audit_before
+
+
+def test_mark_delivered_twice_fails():
+    clock.set_fixed(DELIVERED_AT)
+    s = _new_shipment()
+    shipments.mark_delivered(s.id)
+    audit_before = len(audit.LOG)
+    with pytest.raises(DomainError) as err:
+        shipments.mark_delivered(s.id)
+    assert err.value.code == "E_BAD_STATE"
+    assert s.status == "delivered"
+    assert s.delivered_at == DELIVERED_AT
+    assert len(audit.LOG) == audit_before
+    assert db.shipments[s.id] is s
