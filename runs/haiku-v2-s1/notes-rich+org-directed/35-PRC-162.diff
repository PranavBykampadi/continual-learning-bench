+
+
+def invoices_by_status(status):
+    """Read-only. Return invoices whose status is `status`, in insertion order.
+
+    Raises DomainError("E_BAD_INPUT") if status is not one of INVOICE_STATUSES.
+    """
+    if status not in INVOICE_STATUSES:
+        raise DomainError("E_BAD_INPUT", str(status))
+    return [i for i in db.invoices.values() if i.status == status]
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_invoices_by_status.py b/tests/unit/test_invoices_by_status.py
--- a/tests/unit/test_invoices_by_status.py	1969-12-31 19:00:00
+++ b/tests/unit/test_invoices_by_status.py	2026-11-12 02:33:16
@@ -0,0 +1,51 @@
+import pytest
+
+from parcelo import customers, events, invoices, shipments
+from parcelo.errors import DomainError
+
+
+def _invoice():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 2, "local")
+    return invoices.issue_invoice(s.id)
+
+
+def test_filters_by_open():
+    a = _invoice()
+    b = _invoice()
+    invoices.mark_paid(b.id)
+    result = invoices.invoices_by_status("open")
+    assert [i.id for i in result] == [a.id]
+    assert all(i.status == "open" for i in result)
+
+
+def test_filters_by_paid():
+    a = _invoice()
+    b = _invoice()
+    invoices.mark_paid(b.id)
+    result = invoices.invoices_by_status("paid")
+    assert [i.id for i in result] == [b.id]
+    assert all(i.status == "paid" for i in result)
+
+
+def test_returns_empty_list_when_none_match():
+    _invoice()
+    assert invoices.invoices_by_status("paid") == []
+
+
+def test_returns_empty_list_when_no_invoices():
+    assert invoices.invoices_by_status("open") == []
+
+
+@pytest.mark.parametrize("bad", ["void", "OPEN", "", None, ["open"]])
+def test_bad_status_raises_and_changes_nothing(bad):
+    inv = _invoice()
+    before_status = inv.status
+    before_outbox = len(events.OUTBOX)
+
+    with pytest.raises(DomainError) as err:
+        invoices.invoices_by_status(bad)
+
+    assert err.value.code == "E_BAD_INPUT"
+    assert inv.status == before_status
+    assert len(events.OUTBOX) == before_outbox
