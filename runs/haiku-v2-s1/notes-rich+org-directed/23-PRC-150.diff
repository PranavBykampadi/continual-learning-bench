diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_credit_limit.py b/tests/unit/test_credit_limit.py
--- a/tests/unit/test_credit_limit.py	1969-12-31 19:00:00
+++ b/tests/unit/test_credit_limit.py	2026-11-12 02:21:17
@@ -0,0 +1,60 @@
+import pytest
+
+from parcelo import customers, events
+from parcelo.errors import DomainError
+from parcelo.store import db
+
+
+def test_set_credit_limit_updates_and_returns_new_limit():
+    c = customers.add_customer("Acme")
+    events.OUTBOX.clear()
+
+    result = customers.set_credit_limit(c.id, 1250.5)
+
+    assert result == 1250.5
+    assert db.customers[c.id].credit_limit == 1250.5
+    assert [e["name"] for e in events.OUTBOX] == ["customer.credit_limit_set"]
+    assert events.OUTBOX[0]["entity_id"] == c.id
+    assert events.OUTBOX[0]["payload"] == {"old_limit": 500.0, "new_limit": 1250.5}
+
+
+def test_set_credit_limit_accepts_string_and_rounds_to_cents():
+    c = customers.add_customer("Acme")
+
+    assert customers.set_credit_limit(c.id, "99.999") == 100.0
+    assert db.customers[c.id].credit_limit == 100.0
+
+
+def test_set_credit_limit_unknown_customer_fails_without_side_effects():
+    events.OUTBOX.clear()
+
+    with pytest.raises(DomainError) as err:
+        customers.set_credit_limit("C_missing", 100)
+
+    assert err.value.code == "E_NOT_FOUND"
+    assert "C_missing" not in db.customers
+    assert events.OUTBOX == []
+
+
+def test_set_credit_limit_negative_fails_without_side_effects():
+    c = customers.add_customer("Acme")
+    events.OUTBOX.clear()
+
+    with pytest.raises(DomainError) as err:
+        customers.set_credit_limit(c.id, -1)
+
+    assert err.value.code == "E_BAD_INPUT"
+    assert db.customers[c.id].credit_limit == 500.0
+    assert events.OUTBOX == []
+
+
+def test_set_credit_limit_non_numeric_fails_without_side_effects():
+    c = customers.add_customer("Acme")
+    events.OUTBOX.clear()
+
+    with pytest.raises(DomainError) as err:
+        customers.set_credit_limit(c.id, "lots")
+
+    assert err.value.code == "E_BAD_INPUT"
+    assert db.customers[c.id].credit_limit == 500.0
+    assert events.OUTBOX == []
