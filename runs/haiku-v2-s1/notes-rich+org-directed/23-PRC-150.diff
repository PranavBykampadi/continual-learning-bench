+def set_credit_limit(customer_id: str, amount) -> float:
+    """Set a customer's credit limit and emit a customer.credit_limit_set event.
+
+    Args:
+        customer_id: ID of the customer to update.
+        amount: New limit in dollars, as a float, int, str or Decimal.
+
+    Returns:
+        The new credit limit in dollars.
+
+    Raises:
+        DomainError: E_BAD_INPUT if amount is not a valid number or is negative.
+            E_NOT_FOUND if the customer does not exist. Nothing is changed on error.
+    """
+    try:
+        limit = Money.parse(amount)
+    except (ArithmeticError, TypeError, ValueError) as exc:
+        raise DomainError("E_BAD_INPUT", f"credit limit is not a number: {amount!r}") from exc
+    if limit.cents < 0:
+        raise DomainError("E_BAD_INPUT", f"credit limit must not be negative: {amount}")
+    if customer_id not in db.customers:
+        raise DomainError("E_NOT_FOUND", customer_id)
+    customer = db.customers[customer_id]
+    old_limit = customer.credit_limit
+    # Customer.credit_limit is still a float field; store the cents-rounded value.
+    customer.credit_limit = limit.cents / 100
+    events.emit(
+        "customer.credit_limit_set",
+        customer_id,
+        old_limit=old_limit,
+        new_limit=customer.credit_limit,
+    )
+    return customer.credit_limit
 
 
