@@ -28,3 +28,34 @@
     if shipment_id not in db.shipments:
         raise DomainError("E_NOT_FOUND", shipment_id)
     return db.shipments[shipment_id]
+
+
+def reassign_shipment(shipment_id, new_customer_id):
+    """Move a shipment to another customer.
+
+    Args:
+        shipment_id: ID of the shipment to reassign.
+        new_customer_id: ID of the customer that should own the shipment.
+
+    Returns:
+        The updated Shipment.
+
+    Raises:
+        DomainError: E_NOT_FOUND if the shipment does not exist, E_UNKNOWN_CUSTOMER
+            if the new customer does not exist, E_BAD_STATE if the shipment has
+            already been delivered. Nothing is changed when an error is raised.
+    """
+    shipment = get_shipment(shipment_id)
+    if new_customer_id not in db.customers:
+        raise DomainError("E_UNKNOWN_CUSTOMER", new_customer_id)
+    if shipment.status == "delivered" or shipment.delivered_at is not None:
+        raise DomainError("E_BAD_STATE", shipment_id)
+    old_customer_id = shipment.customer_id
+    shipment.customer_id = new_customer_id
+    events.emit(
+        "shipment.reassigned",
+        shipment.id,
+        from_customer_id=old_customer_id,
+        to_customer_id=new_customer_id,
+    )
+    return shipment
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_reassign_shipment.py b/tests/unit/test_reassign_shipment.py
--- a/tests/unit/test_reassign_shipment.py	1969-12-31 19:00:00
+++ b/tests/unit/test_reassign_shipment.py	2026-11-12 02:09:37
@@ -0,0 +1,78 @@
+import pytest
+
+from parcelo import customers, events, shipments
+from parcelo.errors import DomainError
+
+
+def _setup():
+    old = customers.add_customer("Acme")
+    new = customers.add_customer("Globex")
+    shipment = shipments.create_shipment(old.id, 2.0, "local")
+    return old, new, shipment
+
+
+def test_reassign_changes_customer_and_emits_event():
+    old, new, shipment = _setup()
+    before = len(events.OUTBOX)
+
+    result = shipments.reassign_shipment(shipment.id, new.id)
+
+    assert result is shipment
+    assert shipment.customer_id == new.id
+    assert len(events.OUTBOX) == before + 1
+    event = events.OUTBOX[-1]
+    assert event["name"] == "shipment.reassigned"
+    assert event["entity_id"] == shipment.id
+    assert event["payload"] == {
+        "from_customer_id": old.id,
+        "to_customer_id": new.id,
+    }
+
+
+def test_unknown_shipment_fails_without_event():
+    _, new, _ = _setup()
+    before = len(events.OUTBOX)
+
+    with pytest.raises(DomainError) as err:
+        shipments.reassign_shipment("shp_missing", new.id)
+
+    assert err.value.code == "E_NOT_FOUND"
+    assert len(events.OUTBOX) == before
+
+
+def test_unknown_new_customer_fails_and_nothing_changes():
+    old, _, shipment = _setup()
+    before = len(events.OUTBOX)
+
+    with pytest.raises(DomainError) as err:
+        shipments.reassign_shipment(shipment.id, "C_missing")
+
+    assert err.value.code == "E_UNKNOWN_CUSTOMER"
+    assert shipment.customer_id == old.id
+    assert len(events.OUTBOX) == before
+
+
+def test_delivered_shipment_fails_and_nothing_changes():
+    old, new, shipment = _setup()
+    shipment.status = "delivered"
+    before = len(events.OUTBOX)
+
+    with pytest.raises(DomainError) as err:
+        shipments.reassign_shipment(shipment.id, new.id)
+
+    assert err.value.code == "E_BAD_STATE"
+    assert shipment.customer_id == old.id
+    assert len(events.OUTBOX) == before
+
+
+def test_shipment_with_delivered_at_fails_and_nothing_changes():
+    old, new, shipment = _setup()
+    shipment.delivered_at = shipment.created_at
+    before = len(events.OUTBOX)
+
+    with pytest.raises(DomainError) as err:
+        shipments.reassign_shipment(shipment.id, new.id)
+
+    assert err.value.code == "E_BAD_STATE"
+    assert shipment.customer_id == old.id
+    assert len(events.OUTBOX) == before
