+def mark_returned(shipment_id: str) -> Shipment:
+    """Mark a delivered shipment as returned to the depot.
+
+    Only a shipment in status "delivered" can be returned. Marking a shipment
+    that is already "returned" is a no-op: it returns the shipment unchanged
+    and emits no event or audit entry.
+
+    Args:
+        shipment_id: ID of the shipment to mark.
+
+    Returns:
+        The updated shipment.
+
+    Raises:
+        DomainError: E_NOT_FOUND if the shipment does not exist, or E_BAD_STATE
+            if it is not in status "delivered" or "returned".
+    """
+    shipment = get_shipment(shipment_id)
+    if shipment.status == "returned":
+        return shipment
+    if shipment.status != "delivered":
+        raise DomainError("E_BAD_STATE", shipment.status)
+    shipment.status = "returned"
+    shipment.returned_at = clock.now()
+    audit.record("shipment.returned", shipment.id)
+    events.emit("shipment.returned", shipment.id)
+    return shipment
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_mark_returned.py b/tests/unit/test_mark_returned.py
--- a/tests/unit/test_mark_returned.py	1969-12-31 19:00:00
+++ b/tests/unit/test_mark_returned.py	2026-11-12 02:31:11
@@ -0,0 +1,82 @@
+from datetime import datetime, timezone
+
+import pytest
+
+from parcelo import audit, clock, customers, events, shipments
+from parcelo.errors import DomainError
+from parcelo.store import db
+
+
+def _customer_id():
+    return customers.add_customer("Acme").id
+
+
+def _delivered_shipment():
+    shipment = shipments.create_shipment(_customer_id(), 2.0, "national")
+    shipment.status = "delivered"
+    events.OUTBOX.clear()
+    audit.LOG.clear()
+    return shipment
+
+
+def test_mark_returned_sets_status_and_time():
+    moment = datetime(2026, 11, 1, 9, 30, tzinfo=timezone.utc)
+    clock.set_fixed(moment)
+    shipment = _delivered_shipment()
+
+    result = shipments.mark_returned(shipment.id)
+
+    assert result is shipment
+    assert result.status == "returned"
+    assert result.returned_at == moment
+    assert db.shipments[shipment.id].status == "returned"
+
+
+def test_mark_returned_emits_event_and_audit():
+    shipment = _delivered_shipment()
+
+    shipments.mark_returned(shipment.id)
+
+    assert events.OUTBOX[-1]["name"] == "shipment.returned"
+    assert events.OUTBOX[-1]["entity_id"] == shipment.id
+    assert audit.LOG[-1]["action"] == "shipment.returned"
+    assert audit.LOG[-1]["entity_id"] == shipment.id
+
+
+def test_mark_returned_is_idempotent():
+    shipment = _delivered_shipment()
+    shipments.mark_returned(shipment.id)
+    first_time = shipment.returned_at
+    events.OUTBOX.clear()
+    audit.LOG.clear()
+
+    result = shipments.mark_returned(shipment.id)
+
+    assert result.status == "returned"
+    assert result.returned_at == first_time
+    assert events.OUTBOX == []
+    assert audit.LOG == []
+
+
+def test_created_shipment_cannot_be_returned():
+    shipment = shipments.create_shipment(_customer_id(), 2.0, "national")
+    events.OUTBOX.clear()
+    audit.LOG.clear()
+
+    with pytest.raises(DomainError) as err:
+        shipments.mark_returned(shipment.id)
+
+    assert err.value.code == "E_BAD_STATE"
+    assert db.shipments[shipment.id].status == "created"
+    assert db.shipments[shipment.id].returned_at is None
+    assert events.OUTBOX == []
+    assert audit.LOG == []
+
+
+def test_unknown_shipment_fails():
+    with pytest.raises(DomainError) as err:
+        shipments.mark_returned("shp_missing")
+
+    assert err.value.code == "E_NOT_FOUND"
+    assert events.OUTBOX == []
+    assert audit.LOG == []
