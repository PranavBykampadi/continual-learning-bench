+from parcelo.invoices import open_invoices
+from parcelo.money import Money
+from parcelo.shipments import get_shipment
 from parcelo.store import db
+
+
+def outstanding_by_customer() -> dict[str, Money]:
+    """Return what each customer still owes, from their open invoices.
+
+    Only invoices with status "open" count. Paid and void invoices are
+    excluded. Every customer in the store appears in the result, with a zero
+    balance if they have no open invoices.
+
+    Returns:
+        A dict mapping customer id to the Money total of that customer's open
+        invoices.
+
+    Raises:
+        DomainError: E_NOT_FOUND if an open invoice refers to a missing shipment.
+    """
+    totals = {customer_id: Money.zero() for customer_id in db.customers}
+    for invoice in open_invoices():
+        customer_id = get_shipment(invoice.shipment_id).customer_id
+        owed = Money.parse(invoice.amount)
+        totals[customer_id] = totals.get(customer_id, Money.zero()) + owed
+    return totals
 
 
