--- a/parcelo/shipments.py	2026-11-10 12:20:18
+++ b/parcelo/shipments.py	2026-11-12 02:22:59
@@ -28,3 +28,24 @@
     if shipment_id not in db.shipments:
         raise DomainError("E_NOT_FOUND", shipment_id)
     return db.shipments[shipment_id]
+
+
+def mark_lost(shipment_id: str) -> Shipment:
+    """Mark a shipment as lost in transit.
+
+    Args:
+        shipment_id: ID of the shipment to mark.
+
+    Returns:
+        The updated shipment.
+
+    Raises:
+        DomainError: E_NOT_FOUND if the shipment does not exist, or E_BAD_STATE
+            if it has already been delivered.
+    """
+    shipment = get_shipment(shipment_id)
+    if shipment.status == "delivered" or shipment.delivered_at is not None:
+        raise DomainError("E_BAD_STATE", shipment_id)
+    shipment.status = "lost"
+    events.emit("shipment.lost", shipment.id)
+    return shipment
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_mark_lost.py b/tests/unit/test_mark_lost.py
--- a/tests/unit/test_mark_lost.py	1969-12-31 19:00:00
+++ b/tests/unit/test_mark_lost.py	2026-11-12 02:23:01
@@ -0,0 +1,48 @@
+import pytest
+
+from parcelo import customers, events, shipments
+from parcelo.errors import DomainError
+
+
+def _shipment():
+    c = customers.add_customer("Acme")
+    return shipments.create_shipment(c.id, 1.5, "national")
+
+
+def test_mark_lost_sets_status_and_emits_event():
+    s = _shipment()
+    events.OUTBOX.clear()
+
+    result = shipments.mark_lost(s.id)
+
+    assert result is s
+    assert result.status == "lost"
+    assert [e["name"] for e in events.OUTBOX] == ["shipment.lost"]
+    assert events.OUTBOX[0]["entity_id"] == s.id
+
+
+def test_mark_lost_unknown_shipment_fails():
+    events.OUTBOX.clear()
+
+    with pytest.raises(DomainError) as err:
+        shipments.mark_lost("shp_missing")
+
+    assert err.value.code == "E_NOT_FOUND"
+    assert events.OUTBOX == []
+
+
+@pytest.mark.parametrize("delivered_state", ["status", "delivered_at"])
+def test_mark_lost_delivered_shipment_fails(delivered_state):
+    s = _shipment()
+    if delivered_state == "status":
+        s.status = "delivered"
+    else:
+        s.delivered_at = "2026-11-01T10:00:00+00:00"
+    events.OUTBOX.clear()
+
+    with pytest.raises(DomainError) as err:
+        shipments.mark_lost(s.id)
+
+    assert err.value.code == "E_BAD_STATE"
+    assert shipments.get_shipment(s.id).status != "lost"
+    assert events.OUTBOX == []
