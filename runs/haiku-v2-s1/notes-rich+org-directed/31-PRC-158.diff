+from datetime import datetime, timezone
+
+import pytest
+
+from parcelo import clock, customers, events, shipments, store
+from parcelo.errors import DomainError
+from parcelo.returns import request_return, returns_for
+
+FIXED_NOW = datetime(2026, 11, 12, 9, 0, tzinfo=timezone.utc)
+
+
+@pytest.fixture
+def fixed_clock():
+    clock.set_fixed(FIXED_NOW)
+    yield FIXED_NOW
+    clock.clear_fixed()
+
+
+def _delivered_shipment():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 1.5, "national")
+    s.status = "delivered"
+    return s
+
+
+def test_request_return_creates_and_stores(fixed_clock):
+    s = _delivered_shipment()
+    events.OUTBOX.clear()
+
+    r = request_return(s.id, "damaged")
+
+    assert r.id.startswith("ret_")
+    assert r.shipment_id == s.id
+    assert r.reason == "damaged"
+    assert r.requested_at == FIXED_NOW
+    assert store.db.returns[r.id] is r
+    assert [e["name"] for e in events.OUTBOX] == ["return.requested"]
+    assert events.OUTBOX[0]["entity_id"] == r.id
+
+
+def test_return