+def _tier_label(shipment_count: int) -> str:
+    """Return the volume tier label for a shipment count.
+
+    Mirrors the thresholds of the legacy billing helper; copied here so new
+    code does not depend on the legacy package.
+
+    Args:
+        shipment_count: Number of shipments the customer has.
+
+    Returns:
+        "bulk" for 50 or more, "regular" for 10 to 49, otherwise "starter".
+    """
+    if shipment_count >= 50:
+        return "bulk"
+    if shipment_count >= 10:
+        return "regular"
+    return "starter"
+
+
+def volume_report() -> dict:
+    """Summarize shipment volume for every customer.
+
+    Customers with no shipments are included with a count of zero.
+
+    Returns:
+        Dict keyed by customer id, where each value is
+        {"shipments": <count>, "tier": <label>}.
+    """
+    counts = {customer_id: 0 for customer_id in db.customers}
+    for shipment in db.shipments.values():
+        if shipment.customer_id in counts:
+            counts[shipment.customer_id] += 1
+    return {
+        customer_id: {"shipments": count, "tier": _tier_label(count)}
+        for customer_id, count in counts.items()
+    }
+
+
