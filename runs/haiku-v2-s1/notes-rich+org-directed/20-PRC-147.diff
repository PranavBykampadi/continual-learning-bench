diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_volume_report.py b/tests/unit/test_volume_report.py
--- a/tests/unit/test_volume_report.py	1969-12-31 19:00:00
+++ b/tests/unit/test_volume_report.py	2026-11-12 02:17:47
@@ -0,0 +1,56 @@
+from parcelo import audit, customers, events, reports, shipments
+
+
+def _ship_n(customer_id, n):
+    for _ in range(n):
+        shipments.create_shipment(customer_id, 1.5, "national")
+
+
+def test_includes_customers_with_no_shipments():
+    a = customers.add_customer("Acme")
+    b = customers.add_customer("Globex")
+    _ship_n(a.id, 2)
+
+    report = reports.volume_report()
+
+    assert report == {
+        a.id: {"shipments": 2, "tier": "starter"},
+        b.id: {"shipments": 0, "tier": "starter"},
+    }
+
+
+def test_counts_only_each_customers_shipments():
+    a = customers.add_customer("Acme")
+    b = customers.add_customer("Globex")
+    _ship_n(a.id, 3)
+    _ship_n(b.id, 1)
+
+    report = reports.volume_report()
+
+    assert report[a.id]["shipments"] == 3
+    assert report[b.id]["shipments"] == 1
+
+
+def test_empty_store_returns_empty_dict():
+    assert reports.volume_report() == {}
+
+
+def test_tier_thresholds():
+    cases = [(9, "starter"), (10, "regular"), (49, "regular"), (50, "bulk")]
+    for count, label in cases:
+        c = customers.add_customer(f"Customer {count}")
+        _ship_n(c.id, count)
+        report = reports.volume_report()
+        assert report[c.id] == {"shipments": count, "tier": label}
+
+
+def test_report_is_read_only():
+    c = customers.add_customer("Acme")
+    _ship_n(c.id, 2)
+    events.OUTBOX.clear()
+    audit.LOG.clear()
+
+    reports.volume_report()
+
+    assert events.OUTBOX == []
+    assert audit.LOG == []
