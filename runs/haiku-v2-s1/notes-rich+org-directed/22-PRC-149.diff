+def split_shipment(shipment_id, weights):
+    """Split a created shipment into one new shipment per weight.
+
+    Args:
+        shipment_id: ID of the shipment to split. Must be in status "created".
+        weights: Weights in kg for the new shipments. They must add up to the
+            original shipment's weight.
+
+    Returns:
+        The new shipments, in the same order as ``weights``.
+
+    Raises:
+        DomainError: E_NOT_FOUND if the shipment does not exist, E_BAD_STATE if
+            it is not in status "created", E_BAD_INPUT if ``weights`` is empty,
+            contains a non-number, or does not add up to the original weight,
+            E_BAD_WEIGHT if any weight is zero or negative. Nothing is changed
+            when an error is raised.
+    """
+    shipment = get_shipment(shipment_id)
+    if shipment.status != "created":
+        raise DomainError("E_BAD_STATE", shipment_id)
+
+    weights = list(weights)
+    if not weights:
+        raise DomainError("E_BAD_INPUT", "weights required")
+    for weight in weights:
+        if isinstance(weight, bool) or not isinstance(weight, (int, float)):
+            raise DomainError("E_BAD_INPUT", repr(weight))
+        if weight <= 0:
+            raise DomainError("E_BAD_WEIGHT", str(weight))
+    if not math.isclose(sum(weights), shipment.weight_kg, rel_tol=1e-9):
+        raise DomainError(
+            "E_BAD_INPUT",
+            f"weights sum to {sum(weights)}, expected {shipment.weight_kg}",
+        )
+
+    shipment.status = "split"
+    audit.record("shipment.split", shipment.id, count=len(weights))
+    events.emit("shipment.split", shipment.id, count=len(weights))
+
+    new_shipments = []
+    for weight in weights:
+        new = Shipment(
+            id=ids.new_id("shp"),
+            customer_id=shipment.customer_id,
+            weight_kg=weight,
+            zone=shipment.zone,
+            created_at=clock.now(),
+        )
+        db.shipments[new.id] = new
+        audit.record("shipment.created", new.id, split_from=shipment.id)
+        events.emit("shipment.created", new.id, zone=new.zone)
+        new_shipments.append(new)
+    return new_shipments
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_split_shipment.py b/tests/unit/test_split_shipment.py
--- a/tests/unit/test_split_shipment.py	1969-12-31 19:00:00
+++ b/tests/unit/test_split_shipment.py	2026-11-12 02:20:04
@@ -0,0 +1,127 @@
+import pytest
+
+from parcelo import audit, customers, events, shipments
+from parcelo.errors import DomainError
+from parcelo.store import db
+
+
+def _setup(weight=0.3, zone="national"):
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, weight, zone)
+    events.OUTBOX.clear()
+    audit.LOG.clear()
+    return c, s
+
+
+def _assert_unchanged(shipment, count_before):
+    assert shipment.status == "created"
+    assert len(db.shipments) == count_before
+    assert events.OUTBOX == []
+    assert audit.LOG == []
+
+
+def test_split_returns_new_shipments_in_weight_order():
+    c, s = _setup(weight=3.0, zone="local")
+    new = shipments.split_shipment(s.id, [1.0, 2.0])
+
+    assert [n.weight_kg for n in new] == [1.0, 2.0]
+    for n in new:
+        assert n.id.startswith("shp_")
+        assert n.customer_id == c.id
+        assert n.zone == "local"
+        assert n.status == "created"
+        assert db.shipments[n.id] is n
+
+
+def test_split_marks_original_as_split():
+    _, s = _setup(weight=3.0)
+    shipments.split_shipment(s.id, [1.0, 2.0])
+    assert s.status == "split"
+
+
+def test_split_emits_events_and_audit_entries():
+    _, s = _setup(weight=3.0)
+    new = shipments.split_shipment(s.id, [1.0, 2.0])
+
+    assert [e["name"] for e in events.OUTBOX] == [
+        "shipment.split",
+        "shipment.created",
+        "shipment.created",
+    ]
+    assert [a["action"] for a in audit.LOG] == [
+        "shipment.split",
+        "shipment.created",
+        "shipment.created",
+    ]
+    assert audit.LOG[1]["entity_id"] == new[0].id
+    assert audit.LOG[2]["entity_id"] == new[1].id
+
+
+def test_split_accepts_float_weights_that_sum_to_total():
+    _, s = _setup(weight=0.3)
+    new = shipments.split_shipment(s.id, [0.1, 0.2])
+    assert [n.weight_kg for n in new] == [0.1, 0.2]
+
+
+def test_split_unknown_shipment_fails():
+    with pytest.raises(DomainError) as err:
+        shipments.split_shipment("shp_999999", [1.0])
+    assert err.value.code == "E_NOT_FOUND"
+    assert events.OUTBOX == []
+    assert audit.LOG == []
+
+
+def test_split_already_split_shipment_fails_without_changes():
+    _, s = _setup(weight=3.0)
+    shipments.split_shipment(s.id, [1.0, 2.0])
+    count_before = len(db.shipments)
+    events.OUTBOX.clear()
+    audit.LOG.clear()
+
+    with pytest.raises(DomainError) as err:
+        shipments.split_shipment(s.id, [1.0, 2.0])
+    assert err.value.code == "E_BAD_STATE"
+    assert s.status == "split"
+    assert len(db.shipments) == count_before
+    assert events.OUTBOX == [