+def upgrade_tier(customer_id):
+    """Move a standard customer to the gold tier and return the customer."""
+    if not isinstance(customer_id, str) or not customer_id:
+        raise DomainError("E_BAD_INPUT", "customer_id must be a non-empty string")
+    customer = db.customers.get(customer_id)
+    if customer is None:
+        raise DomainError("E_NOT_FOUND", f"customer {customer_id} not found")
+    if customer.tier != "standard":
+        raise DomainError("E_BAD_STATE", f"customer {customer_id} is already {customer.tier}")
+    previous = customer.tier
+    customer.tier = "gold"
+    events.emit("customer.upgraded", customer.id, from_tier=previous, to_tier="gold")
+    return customer
 
 
