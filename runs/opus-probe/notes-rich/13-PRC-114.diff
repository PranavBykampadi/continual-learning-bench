+AGING_BUCKETS = ("0-30", "31-60", "60+")
+
+
+def _age_days(issued_at, now):
+    # issue_invoice stores naive UTC timestamps; treat naive values as UTC.
+    if issued_at.tzinfo is None:
+        issued_at = issued_at.replace(tzinfo=timezone.utc)
+    return (now - issued_at).days
+
+
+def _aging_bucket(age_days):
+    if age_days <= 30:
+        return "0-30"
+    if age_days <= 60:
+        return "31-60"
+    return "60+"
+
+
+def aging_report():
+    """Total open invoice amounts (Money) by whole days since issue.
+
+    Buckets: "0-30" (0..30 days), "31-60" (31..60 days), "60+" (61+ days).
+    Only invoices with status "open" are included. Invoices with no issue
+    date, or issued in the future, count as age 0.
+    """
+    now = clock.now()
+    totals = {bucket: Money.zero() for bucket in AGING_BUCKETS}
+    for invoice in db.invoices.values():
+        if invoice.status != "open":
+            continue
+        if invoice.issued_at is None:
+            age = 0
+        else:
+            age = max(_age_days(invoice.issued_at, now), 0)
+        bucket = _aging_bucket(age)
+        totals[bucket] = totals[bucket] + Money.parse(invoice.amount)
+    return totals
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_reports_aging.py b/tests/unit/test_reports_aging.py
--- a/tests/unit/test_reports_aging.py	1969-12-31 19:00:00
+++ b/tests/unit/test_reports_aging.py	2026-11-11 17:27:50
@@ -0,0 +1,95 @@
+from datetime import datetime, timedelta, timezone
+
+from parcelo import audit, clock, customers, invoices, reports, shipments
+from parcelo.models import Invoice
+from parcelo.money import Money
+from parcelo.store import db
+
+NOW = datetime(2026, 11, 11, 12, 0, tzinfo=timezone.utc)
+
+
+def _invoice(inv_id, amount, days_ago, status="open", naive=False):
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 2.0, "national")
+    issued = NOW - timedelta(days=days_ago)
+    if naive:
+        issued = issued.replace(tzinfo=None)
+    inv = Invoice(id=inv_id, shipment_id=s.id, amount=amount, status=status, issued_at=issued)
+    db.invoices[inv.id] = inv
+    return inv
+
+
+def test_empty_report_has_all_buckets_zero():
+    clock.set_fixed(NOW)
+    assert reports.aging_report() == {
+        "0-30": Money.zero(),
+        "31-60": Money.zero(),
+        "60+": Money.zero(),
+    }
+
+
+def test_buckets_and_boundaries():
+    clock.set_fixed(NOW)
+    _invoice("i0", 1.00, 0)
+    _invoice("i30", 2.00, 30)
+    _invoice("i31", 4.00, 31)
+    _invoice("i60", 8.00, 60)
+    _invoice("i61", 16.00, 61)
+    _invoice("i200", 32.00, 200)
+    assert reports.aging_report() == {
+        "0-30": Money(300),
+        "31-60": Money(1200),
+        "60+": Money(4800),
+    }
+
+
+def test_partial_day_counts_as_whole_days_only():
+    clock.set_fixed(NOW)
+    inv = _invoice("i", 5.00, 30)
+    inv.issued_at -= timedelta(hours=23)  # 30 days 23 hours -> still 30 days
+    assert reports.aging_report()["0-30"] == Money(500)
+    inv.issued_at -= timedelta(hours=1)  # exactly 31 days
+    assert reports.aging_report()["31-60"] == Money(500)
+
+
+def test_paid_invoices_excluded():
+    clock.set_fixed(NOW)
+    _invoice("paid", 10.00, 5, status="paid")
+    _invoice("open", 3.00, 5)
+    old = _invoice("old", 7.00, 90)
+    invoices.mark_paid(old.id)
+    assert reports.aging_report() == {
+        "0-30": Money(300),
+        "31-60": Money.zero(),
+        "60+": Money.zero(),
+    }
+
+
+def test_float_amounts_summed_exactly_with_half_up_rounding():
+    clock.set_fixed(NOW)
+    _invoice("a", 0.1, 1)
+    _invoice("b", 0.2, 2)
+    _invoice("c", 10.005, 3)  # rounds half-up to 10.01
+    assert reports.aging_report()["0-30"] == Money(1031)
+
+
+def test_naive_issued_at_treated_as_utc():
+    clock.set_fixed(NOW)
+    _invoice("n", 4.00, 45, naive=True)
+    assert reports.aging_report()["31-60"] == Money(400)
+
+
+def test_missing_or_future_issue_date_counts_as_current():
+    clock.set_fixed(NOW)
+    _invoice("future", 1.00, -3)
+    _invoice("none", 2.00, 0).issued_at = None
+    assert reports.aging_report()["0-30"] == Money(300)
+
+
+def test_report_is_read_only():
+    clock.set_fixed(NOW)
+    inv = _invoice("x", 9.99, 70)
+    before = len(audit.LOG)
+    reports.aging_report()
+    assert len(audit.LOG) == before
+    assert inv.status == "open" and inv.amount == 9.99
