+def get_invoice(invoice_id):
+    if invoice_id not in db.invoices:
+        raise DomainError("E_NOT_FOUND", invoice_id)
+    return db.invoices[invoice_id]
+
+
+def void_invoice(invoice_id):
+    invoice = get_invoice(invoice_id)
+    if invoice.status in ("paid", "void"):
+        raise DomainError(
+            "E_BAD_STATE", f"cannot void invoice {invoice_id} in status {invoice.status}"
+        )
+    previous_status = invoice.status
+    invoice.status = "void"
+    invoice.voided_at = clock.now()
+    audit.record("invoice.voided", invoice.id, previous_status=previous_status)
     return invoice
 
 
