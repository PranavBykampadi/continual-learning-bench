diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_void_invoice.py b/tests/unit/test_void_invoice.py
--- a/tests/unit/test_void_invoice.py	1969-12-31 19:00:00
+++ b/tests/unit/test_void_invoice.py	2026-11-11 16:59:59
@@ -0,0 +1,73 @@
+from datetime import datetime, timezone
+
+import pytest
+
+from parcelo import audit, clock, customers, invoices, shipments
+from parcelo.errors import DomainError
+
+
+def _issue():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 2, "local")
+    return invoices.issue_invoice(s.id)
+
+
+def test_void_open_invoice():
+    moment = datetime(2026, 1, 2, 3, 4, 5, tzinfo=timezone.utc)
+    clock.set_fixed(moment)
+    inv = _issue()
+
+    result = invoices.void_invoice(inv.id)
+
+    assert result is inv
+    assert inv.status == "void"
+    assert inv.voided_at == moment
+    entry = audit.LOG[-1]
+    assert entry["action"] == "invoice.voided"
+    assert entry["entity_id"] == inv.id
+    assert entry["details"] == {"previous_status": "open"}
+
+
+def test_void_unknown_invoice():
+    with pytest.raises(DomainError) as err:
+        invoices.void_invoice("INV-missing")
+    assert err.value.code == "E_NOT_FOUND"
+    assert not any(e["action"] == "invoice.voided" for e in audit.LOG)
+
+
+@pytest.mark.parametrize("status", ["paid", "void"])
+def test_void_rejected_states(status):
+    inv = _issue()
+    inv.status = status
+    log_len = len(audit.LOG)
+
+    with pytest.raises(DomainError) as err:
+        invoices.void_invoice(inv.id)
+
+    assert err.value.code == "E_BAD_STATE"
+    assert inv.status == status
+    assert inv.voided_at is None
+    assert len(audit.LOG) == log_len
+
+
+def test_void_twice_keeps_original_timestamp():
+    inv = _issue()
+    invoices.void_invoice(inv.id)
+    first_voided_at = inv.voided_at
+
+    with pytest.raises(DomainError) as err:
+        invoices.void_invoice(inv.id)
+
+    assert err.value.code == "E_BAD_STATE"
+    assert inv.voided_at == first_voided_at
+
+
+def test_void_after_mark_paid_fails():
+    inv = _issue()
+    invoices.mark_paid(inv.id)
+
+    with pytest.raises(DomainError) as err:
+        invoices.void_invoice(inv.id)
+
+    assert err.value.code == "E_BAD_STATE"
+    assert inv.status == "paid"
