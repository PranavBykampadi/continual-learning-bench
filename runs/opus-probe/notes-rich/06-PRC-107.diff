     if shipment_id not in db.shipments:
         raise DomainError("E_NOT_FOUND", shipment_id)
     return db.shipments[shipment_id]
+
+
+def mark_delivered(shipment_id):
+    if shipment_id not in db.shipments:
+        raise DomainError("E_NOT_FOUND", shipment_id)
+    shipment = db.shipments[shipment_id]
+    if shipment.status in ("cancelled", "delivered"):
+        raise DomainError("E_BAD_STATE", shipment.status)
+    previous_status = shipment.status
+    shipment.status = "delivered"
+    shipment.delivered_at = clock.now()
+    audit.record("shipment.delivered", shipment.id, previous_status=previous_status)
+    return shipment
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_mark_delivered.py b/tests/unit/test_mark_delivered.py
--- a/tests/unit/test_mark_delivered.py	1969-12-31 19:00:00
+++ b/tests/unit/test_mark_delivered.py	2026-11-11 17:04:56
@@ -0,0 +1,62 @@
+from datetime import datetime, timezone
+
+import pytest
+
+from parcelo import audit, clock, customers, shipments
+from parcelo.errors import DomainError
+
+MOMENT = datetime(2026, 11, 11, 15, 30, tzinfo=timezone.utc)
+
+
+def _shipment():
+    c = customers.add_customer("Acme")
+    return shipments.create_shipment(c.id, 2.0, "local")
+
+
+def test_mark_delivered_sets_status_and_time():
+    s = _shipment()
+    clock.set_fixed(MOMENT)
+    result = shipments.mark_delivered(s.id)
+    assert result is s
+    assert s.status == "delivered"
+    assert s.delivered_at == MOMENT
+
+
+def test_mark_delivered_records_audit():
+    s = _shipment()
+    shipments.mark_delivered(s.id)
+    entry = audit.LOG[-1]
+    assert entry["action"] == "shipment.delivered"
+    assert entry["entity_id"] == s.id
+    assert entry["details"] == {"previous_status": "created"}
+
+
+def test_mark_delivered_unknown_shipment():
+    with pytest.raises(DomainError) as err:
+        shipments.mark_delivered("shp_missing")
+    assert err.value.code == "E_NOT_FOUND"
+
+
+def test_mark_delivered_twice_fails_without_changes():
+    s = _shipment()
+    clock.set_fixed(MOMENT)
+    shipments.mark_delivered(s.id)
+    log_len = len(audit.LOG)
+    clock.set_fixed(datetime(2026, 11, 12, tzinfo=timezone.utc))
+    with pytest.raises(DomainError) as err:
+        shipments.mark_delivered(s.id)
+    assert err.value.code == "E_BAD_STATE"
+    assert s.delivered_at == MOMENT
+    assert len(audit.LOG) == log_len
+
+
+def test_mark_delivered_cancelled_fails_without_changes():
+    s = _shipment()
+    s.status = "cancelled"
+    log_len = len(audit.LOG)
+    with pytest.raises(DomainError) as err:
+        shipments.mark_delivered(s.id)
+    assert err.value.code == "E_BAD_STATE"
+    assert s.status == "cancelled"
+    assert s.delivered_at is None
+    assert len(audit.LOG) == log_len
