@@ -12,3 +20,26 @@
     if weight_kg <= 0:
         raise ValueError("weight must be positive")
     return round(base_rate(zone) + PER_KG * weight_kg, 2)
+
+
+def insurance_fee(declared_value, zone):
+    """Insurance fee for a declared value.
+
+    2% of the declared value plus the zone's fuel surcharge percentage of the
+    declared value, rounded half-up to cents, with a minimum fee of 1.00.
+    Read-only: emits no events.
+    """
+    if (
+        isinstance(declared_value, bool)
+        or not isinstance(declared_value, (int, float, Decimal))
+        or not Decimal(str(declared_value)).is_finite()
+        or declared_value <= 0
+    ):
+        raise DomainError("E_BAD_INPUT", "declared value must be a positive number")
+    if not isinstance(zone, str) or zone not in FUEL_SURCHARGE_PCT:
+        raise DomainError("E_BAD_INPUT", "unknown zone: %r" % (zone,))
+    pct = INSURANCE_PCT + Decimal(str(FUEL_SURCHARGE_PCT[zone]))
+    fee = (Decimal(str(declared_value)) * pct / 100).quantize(
+        Decimal("0.01"), rounding=ROUND_HALF_UP
+    )
+    return float(max(fee, INSURANCE_MIN_FEE))
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_rates_insurance_fee.py b/tests/unit/test_rates_insurance_fee.py
--- a/tests/unit/test_rates_insurance_fee.py	1969-12-31 19:00:00
+++ b/tests/unit/test_rates_insurance_fee.py	2026-11-11 17:32:21
@@ -0,0 +1,99 @@
+from datetime import datetime, timezone
+from decimal import Decimal
+
+import pytest
+
+from parcelo import clock, events, rates
+from parcelo.errors import DomainError
+from parcelo.legacy import billing
+
+NOW = datetime(2026, 11, 11, 12, 0, tzinfo=timezone.utc)
+
+
+@pytest.fixture(autouse=True)
+def _setup():
+    clock.set_fixed(NOW)
+    events.OUTBOX.clear()
+
+
+def _assert_rejected(declared_value, zone, code):
+    with pytest.raises(DomainError) as err:
+        rates.insurance_fee(declared_value, zone)
+    assert err.value.code == code
+    assert events.OUTBOX == []
+
+
+@pytest.mark.parametrize(
+    "declared_value, zone, expected",
+    [
+        (100, "local", 2.00),  # 2% + 0%
+        (100, "national", 6.00),  # 2% + 4%
+        (100, "international", 11.50),  # 2% + 9.5%
+        (Decimal("200"), "national", 12.00),
+        (1000.0, "international", 115.00),
+    ],
+)
+def test_fee_happy_path(declared_value, zone, expected):
+    assert rates.insurance_fee(declared_value, zone) == expected
+    assert events.OUTBOX == []
+
+
+def test_uses_legacy_fuel_surcharge_percentages():
+    for zone in billing.FUEL_SURCHARGE_PCT:
+        fee = rates.insurance_fee(1000, zone)
+        assert fee == pytest.approx(20.0 + billing.fuel_surcharge(1000, zone))
+
+
+@pytest.mark.parametrize(
+    "declared_value, zone, expected",
+    [
+        (50.25, "local", 1.01),  # 1.005 -> 1.01
+        (25.25, "national", 1.52),  # 1.515 -> 1.52
+        (50.30, "international", 5.78),  # 5.7845 -> 5.78
+        (50.26, "international", 5.78),  # 5.7799 -> 5.78
+    ],
+)
+def test_rounds_half_up_to_cents(declared_value, zone, expected):
+    assert rates.insurance_fee(declared_value, zone) == expected
+
+
+@pytest.mark.parametrize(
+    "declared_value, zone, expected",
+    [
+        (0.01, "local", 1.00),
+        (49.99, "local", 1.00),  # 0.9998 -> minimum
+        (50, "local", 1.00),  # exactly the minimum
+        (50.5, "local", 1.01),  # just above the minimum
+        (16.66, "national", 1.00),  # 0.9996 -> minimum
+        (16.67, "national", 1.00),  # 1.0002 -> 1.00
+        (17, "national", 1.02),
+    ],
+)
+def test_minimum_fee_boundaries(declared_value, zone, expected):
+    assert rates.insurance_fee(declared_value, zone) == expected
+
+
+@pytest.mark.parametrize(
+    "declared_value", [0, 0.0, -0.01, -100, None, "", "100", True, float("nan"), float("inf")]
+)
+def test_rejects_bad_declared_value(declared_value):
+    _assert_rejected(declared_value, "national", "E_BAD_INPUT")
+
+
+@pytest.mark.parametrize("zone", ["mars", "", None, "National", 3])
+def test_rejects_unknown_zone(zone):
+    _assert_rejected(100, zone, "E_BAD_INPUT")
+
+
+def test_validates_declared_value_before_zone():
+    _assert_rejected(0, "mars", "E_BAD_INPUT")
+    with pytest.raises(DomainError) as err:
+        rates.insurance_fee(-1, "mars")
+    assert "declared value" in err.value.message
+
+
+def test_repeat_calls_are_stable_and_emit_nothing():
+    first = rates.insurance_fee(123.45, "international")
+    second = rates.insurance_fee(123.45, "international")