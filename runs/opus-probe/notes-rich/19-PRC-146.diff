+def write_off(invoice_id):
+    """Write off an open invoice; returns the written-off amount as Money."""
+    if not isinstance(invoice_id, str) or not invoice_id.strip():
+        raise DomainError("E_BAD_INPUT", "invoice_id must be a non-empty string")
+    invoice = db.invoices.get(invoice_id)
+    if invoice is None:
+        raise DomainError("E_NOT_FOUND", f"invoice {invoice_id} not found")
+    if invoice.status != "open":
+        raise DomainError("E_BAD_STATE", f"invoice {invoice_id} is {invoice.status}, not open")
+    amount = Money.parse(invoice.amount)
+    previous_status = invoice.status
+    invoice.status = "written_off"
+    invoice.written_off_at = clock.now()
+    events.emit(
+        "invoice.written_off",
+        invoice.id,
+        from_status=previous_status,
+        to_status="written_off",
+        amount=amount,
+    )
+    return amount
