@@ -0,0 +1,135 @@
+from datetime import datetime, timezone
+
+import pytest
+
+from parcelo import clock, customers, events, invoices, shipments, store
+from parcelo.errors import DomainError
+from parcelo.models import Invoice
+from parcelo.money import Money
+from parcelo.store import db
+
+NOW = datetime(2026, 11, 11, 12, 0, tzinfo=timezone.utc)
+ISSUED = datetime(2026, 10, 1, 9, 0, tzinfo=timezone.utc)
+
+
+@pytest.fixture(autouse=True)
+def fixed_clock():
+    clock.set_fixed(NOW)
+    yield
+    clock.clear_fixed()
+
+
+@pytest.fixture
+def shipment():
+    c = customers.add_customer("Acme")
+    return shipments.create_shipment(c.id, 2.0, "national")
+
+
+def _invoice(shipment, inv_id="inv_000001", amount=42.5, status="open"):
+    db.invoices[inv_id] = Invoice(
+        inv_id, shipment.id, amount=amount, status=status, issued_at=ISSUED, paid_at=None
+    )
+    events.OUTBOX.clear()
+    return db.invoices[inv_id]
+
+
+def _snapshot():
+    return {k: (v.status, v.amount, v.written_off_at, v.paid_at) for k, v in db.invoices.items()}
+
+
+def _assert_rejected(invoice_id, code):
+    before = _snapshot()
+    with pytest.raises(DomainError) as err:
+        invoices.write_off(invoice_id)
+    assert err.value.code == code
+    assert _snapshot() == before
+    assert events.OUTBOX == []
+
+
+def test_written_off_at_defaults_to_none(shipment):
+    inv = Invoice("inv_x", shipment.id, amount=1.0)
+    assert inv.written_off_at is None
+
+
+def test_write_off_happy_path(shipment):
+    inv = _invoice(shipment)
+    result = invoices.write_off(inv.id)
+    assert isinstance(result, Money)
+    assert result == Money(4250)
+    stored = db.invoices[inv.id]
+    assert stored is inv
+    assert stored.status == "written_off"
+    assert stored.written_off_at == NOW
+    assert stored.amount == 42.5
+    assert stored.issued_at == ISSUED
+    assert stored.paid_at is None
+    assert events.OUTBOX == [
+        {
+            "name": "invoice.written_off",
+            "entity_id": inv.id,
+            "at": NOW,
+            "payload": {
+                "from_status": "open",
+                "to_status": "written_off",
+                "amount": Money(4250),
+            },
+        }
+    ]
+
+
+def test_other_invoices_untouched(shipment):
+    other = _invoice(shipment, "inv_000002", amount=10.0)
+    target = _invoice(shipment, "inv_000001")
+    invoices.write_off(target.id)
+    assert other.status == "open"
+    assert other.written_off_at is None
+    assert invoices.open_invoices() == [other]
+
+
+@pytest.mark.parametrize(
+    "amount, cents",
+    [(10.005, 1001), (10.004, 1000), (0.015, 2), (19.995, 2000)],
+)
+def test_amount_rounds_half_up(shipment, amount, cents):
+    inv = _invoice(shipment, amount=amount)
+    assert invoices.write_off(inv.id) == Money(cents)
+
+
+@pytest.mark.parametrize("status", ["paid", "written_off", "void"])
+def test_non_open_rejected(shipment, status):
+    inv = _invoice(shipment, status=status)
+    _assert_rejected(inv.id, "E_BAD_STATE")
+
+
+def test_second_write_off_rejected(shipment):
+    inv = _invoice(shipment)
+    invoices.write_off(inv.id)
+    with pytest.raises(DomainError) as err:
+        invoices.write_off(inv.id)
+    assert err.value.code == "E_BAD_STATE"
+    assert len(events.OUTBOX) == 1
+    assert inv.status == "written_off"
+    assert inv.written_off_at == NOW
+
+
+def test_unknown_invoice_rejected(shipment):
+    _invoice(shipment)
+    _assert_rejected("inv_999999", "E_NOT_FOUND")
+
+
+@pytest.mark.parametrize("bad", [None, "", "   ", 123, ["inv_000001"]])
+def test_bad_input_r