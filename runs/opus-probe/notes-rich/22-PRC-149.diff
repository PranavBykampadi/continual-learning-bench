+
+
+def _valid_weight(w):
+    return (
+        isinstance(w, (int, float))
+        and not isinstance(w, bool)
+        and math.isfinite(w)
+        and w > 0
+    )
+
+
+def split_shipment(shipment_id, weights):
+    """Replace a "created" shipment with one new shipment per weight.
+
+    The original is marked "split"; the new shipments are returned in the
+    same order as ``weights``.
+    """
+    if not isinstance(shipment_id, str) or not shipment_id.strip():
+        raise DomainError("E_BAD_INPUT", "shipment_id is required")
+    if not isinstance(weights, (list, tuple)) or len(weights) < 2:
+        raise DomainError("E_BAD_INPUT", "weights must be a list of at least two weights")
+    if not all(_valid_weight(w) for w in weights):
+        raise DomainError("E_BAD_INPUT", "every weight must be a positive number")
+
+    if shipment_id not in db.shipments:
+        raise DomainError("E_NOT_FOUND", shipment_id)
+    original = db.shipments[shipment_id]
+
+    if original.status != "created":
+        raise DomainError("E_BAD_STATE", f"{shipment_id} is {original.status}")
+
+    # Compare as decimals so e.g. 0.1 + 0.2 matches an original of 0.3.
+    total = sum((Decimal(str(w)) for w in weights), Decimal(0))
+    if total != Decimal(str(original.weight_kg)):
+        raise DomainError(
+            "E_BAD_INPUT", f"weights sum to {total}, expected {original.weight_kg}"
+        )
+
+    now = clock.now()
+    parts = []
+    for w in weights:
+        part = Shipment(
+            id=ids.new_id("shp"),
+            customer_id=original.customer_id,
+            weight_kg=w,
+            zone=original.zone,
+            created_at=now,
+            split_from=original.id,
+        )
+        db.shipments[part.id] = part
+        parts.append(part)
+
+    from_status = original.status
+    original.status = "split"
+    original.split_at = now
+
+    for part in parts:
+        events.emit("shipment.created", part.id, zone=part.zone, split_from=original.id)
+    events.emit(
+        "shipment.split",
+        original.id,
+        from_status=from_status,
+        to_status="split",
+        shipment_ids=[p.id for p in parts],
+        weights=list(weights),
+    )
+    return parts
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_shipments_split.py b/tests/unit/test_shipments_split.py
--- a/tests/unit/test_shipments_split.py	1969-12-31 19:00:00
+++ b/tests/unit/test_shipments_split.py	2026-11-11 17:37:43
@@ -0,0 +1,145 @@
+from datetime import datetime, timezone
+
+import pytest
+
+from parcelo import clock, customers, events, shipments
+from parcelo.errors import DomainError
+from parcelo.models import Shipment
+from parcelo.store import db
+
+T0 = datetime(2026, 1, 1, tzinfo=timezone.utc)
+T1 = datetime(2026, 1, 2, tzinfo=timezone.utc)
+
+
+@pytest.fixture
+def ship():
+    clock.set_fixed(T0)
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 10, "national")
+    events.OUTBOX.clear()
+    clock.set_fixed(T1)
+    return s
+
+
+def _code(fn, *args):
+    with pytest.raises(DomainError) as err:
+        fn(*args)
+    return err.value.code
+
+
+def test_happy_path_returns_new_shipments_in_order(ship):
+    parts = shipments.split_shipment(ship.id, [3, 5, 2])
+    assert isinstance(parts, list) and len(parts) == 3
+    assert all(isinstance(p, Shipment) for p in parts)
+    assert [p.weight_kg for p in parts] == [3, 5, 2]
+    assert len({p.id for p in parts} | {ship.id}) == 4
+    for p in parts:
+        assert p.id.startswith("shp_")
+        assert db.shipments[p.id] is p
+        assert p.customer_id == ship.customer_id
+        assert p.zone == ship.zone
+        assert p.status == "created"
+        assert p.created_at == T1
+        assert p.split_from == ship.id
+        assert p.split_at is None
+
+
+def test_original_marked_split_and_kept(ship):
+    shipments.split_shipment(ship.id, [4, 6])
+    orig = db.shipments[ship.id]
+    assert orig is ship
+    assert orig.status == "split"
+    assert orig.split_at == T1
+    assert orig.weight_kg == 10
+    assert orig.created_at == T0
+    assert orig.delivered_at is None
+    assert orig.split_from is None
+
+
+def test_other_shipments_untouched(ship):
+    other = shipments.create_shipment(ship.customer_id, 7, "local")
+    shipments.split_shipment(ship.id, [5, 5])
+    assert other.status == "created" and other.weight_kg == 7 and other.split_at is None
+    assert len(db.shipments) == 4
+
+
+def test_events(ship):
+    parts = shipments.split_shipment(ship.id, [4, 6])
+    assert events.OUTBOX == [
+        {"name": "shipment.created", "entity_id": parts[0].id, "at": T1,
+         "payload"