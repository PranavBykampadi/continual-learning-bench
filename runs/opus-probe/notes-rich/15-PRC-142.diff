+def reopen_invoice(invoice_id):
+    """Set a paid invoice back to open (undo a payment marked by mistake)."""
+    if not invoice_id:
+        raise DomainError("E_BAD_INPUT", "invoice id is required")
+    invoice = db.invoices.get(invoice_id)
+    if invoice is None:
+        raise DomainError("E_NOT_FOUND", f"invoice {invoice_id} not found")
+    if invoice.status != "paid":
+        raise DomainError("E_BAD_STATE", f"invoice {invoice_id} is {invoice.status}, not paid")
+    previous_paid_at = invoice.paid_at
+    invoice.status = "open"
+    invoice.paid_at = None
+    invoice.reopened_at = clock.now()
+    events.emit(
+        "invoice.reopened",
+        invoice.id,
+        shipment_id=invoice.shipment_id,
+        previous_paid_at=previous_paid_at,
+    )
     return invoice
 
 
