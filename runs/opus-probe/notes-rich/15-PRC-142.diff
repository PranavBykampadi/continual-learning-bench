diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_invoices_reopen.py b/tests/unit/test_invoices_reopen.py
--- a/tests/unit/test_invoices_reopen.py	1969-12-31 19:00:00
+++ b/tests/unit/test_invoices_reopen.py	2026-11-11 17:30:06
@@ -0,0 +1,110 @@
+from datetime import datetime, timezone
+
+import pytest
+
+from parcelo import clock, customers, events, invoices, shipments
+from parcelo.errors import DomainError
+from parcelo.models import Invoice
+from parcelo.store import db
+
+NOW = datetime(2026, 11, 11, 12, 0, tzinfo=timezone.utc)
+PAID_AT = datetime(2026, 11, 10, 9, 30)
+
+
+def _make_invoice(status="paid", inv_id="INV-1"):
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 2.0, "national")
+    inv = Invoice(
+        inv_id,
+        s.id,
+        amount=10.0,
+        status=status,
+        issued_at=datetime(2026, 11, 1, 8, 0),
+        paid_at=PAID_AT if status == "paid" else None,
+    )
+    db.invoices[inv_id] = inv
+    events.OUTBOX.clear()
+    return inv
+
+
+def _assert_rejected(invoice_id, code, inv=None):
+    before = None if inv is None else (inv.status, inv.paid_at, inv.reopened_at)
+    with pytest.raises(DomainError) as err:
+        invoices.reopen_invoice(invoice_id)
+    assert err.value.code == code
+    if inv is not None:
+        assert (inv.status, inv.paid_at, inv.reopened_at) == before
+    assert events.OUTBOX == []
+
+
+def test_reopen_paid_invoice():
+    clock.set_fixed(NOW)
+    inv = _make_invoice()
+    result = invoices.reopen_invoice("INV-1")
+    assert result is inv
+    assert inv.status == "open"
+    assert inv.paid_at is None
+    assert inv.reopened_at == NOW
+    assert inv.amount == 10.0
+
+
+def test_reopen_emits_event():
+    clock.set_fixed(NOW)
+    inv = _make_invoice()
+    invoices.reopen_invoice("INV-1")
+    assert len(events.OUTBOX) == 1
+    ev = events.OUTBOX[0]
+    assert ev["name"] == "invoice.reopened"
+    assert ev["entity_id"] == "INV-1"
+    assert ev["at"] == NOW
+    assert ev["payload"] == {"shipment_id": inv.shipment_id, "previous_paid_at": PAID_AT}
+
+
+def test_reopened_invoice_listed_as_open():
+    clock.set_fixed(NOW)
+    inv = _make_invoice()
+    assert inv not in invoices.open_invoices()
+    invoices.reopen_invoice("INV-1")
+    assert inv in invoices.open_invoices()
+
+
+def test_reopened_invoice_can_be_paid_again():
+    clock.set_fixed(NOW)
+    inv = _make_invoice()
+    invoices.reopen_invoice("INV-1")
+    invoices.mark_paid("INV-1")
+    assert inv.status == "paid"
+    assert inv.paid_at is not None
+    assert inv.reopened_at == NOW
+
+
+def test_reopen_missing_invoice_rejected():
+    clock.set_fixed(NOW)
+    _assert_rejected("INV-404", "E_NOT_FOUND")
+
+
+@pytest.mark.parametrize("bad", [None, ""])
+def test_reopen_empty_id_rejected(bad):
+    clock.set_fixed(NOW)
+    _assert_rejected(bad, "E_BAD_INPUT")
+
+
+def test_reopen_open_invoice_rejected():
+    clock.set_fixed(NOW)
+    inv = _make_invoice(status="open")
+    _assert_rejected("INV-1", "E_BAD_STATE", inv)
+
+
+def test_reopen_twice_rejected_second_time():
+    clock.set_fixed(NOW)
+    inv = _make_invoice()
+    invoices.reopen_invoice("INV-1")
+    events.OUTBOX.clear()
+    _assert_rejected("INV-1", "E_BAD_STATE", inv)
+    assert inv.reopened_at == NOW
+
+
+def test_new_invoice_has_no_reopened_at():
+    clock.set_fixed(NOW)
+    inv = _make_invoice(status="open")
+    assert inv.reopened_at is None
