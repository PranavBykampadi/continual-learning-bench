     with pytest.raises(DomainError) as err:
         shipments.create_shipment("nope", 1, "local")
     assert err.value.code == "E_UNKNOWN_CUSTOMER"
+
+
+def test_add_note_records_time():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 1.5, "national")
+    t1 = datetime(2026, 1, 1, 9, 0, tzinfo=timezone.utc)
+    t2 = datetime(2026, 1, 1, 10, 0, tzinfo=timezone.utc)
+    clock.set_fixed(t1)
+    result = shipments.add_note(s.id, "left at door")
+    clock.set_fixed(t2)
+    shipments.add_note(s.id, "customer called")
+    assert result is s
+    assert s.notes == [
+        {"text": "left at door", "at": t1},
+        {"text": "customer called", "at": t2},
+    ]
+
+
+def test_add_note_unknown_shipment():
+    with pytest.raises(DomainError) as err:
+        shipments.add_note("shp_nope", "hello")
+    assert err.value.code == "E_NOT_FOUND"
+
+
+@pytest.mark.parametrize("text", ["", "   ", None, 42])
+def test_add_note_rejects_empty_text(text):
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 1.5, "national")
+    with pytest.raises(DomainError) as err:
+        shipments.add_note(s.id, text)
+    assert err.value.code == "E_BAD_INPUT"
+    assert s.notes == []
