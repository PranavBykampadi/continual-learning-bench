+
+
+def quote_with_surcharge(weight_kg, zone):
+    """Quote for the weight and zone, including the zone's fuel surcharge."""
+    if zone not in ZONE_BASE:
+        raise DomainError("E_BAD_ZONE", str(zone))
+    if weight_kg <= 0:
+        raise DomainError("E_BAD_WEIGHT", str(weight_kg))
+    base = quote(weight_kg, zone)
+    return round(base + fuel_surcharge(base, zone), 2)
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_quote_with_surcharge.py b/tests/unit/test_quote_with_surcharge.py
--- a/tests/unit/test_quote_with_surcharge.py	1969-12-31 19:00:00
+++ b/tests/unit/test_quote_with_surcharge.py	2026-11-11 17:00:55
@@ -0,0 +1,43 @@
+import pytest
+
+from parcelo import rates
+from parcelo.errors import DomainError
+from parcelo.legacy.billing import fuel_surcharge
+
+
+@pytest.mark.parametrize(
+    "weight, zone, expected",
+    [
+        (2, "local", 7.0),  # 7.00 + 0%
+        (2, "national", 11.96),  # 11.50 + 4% (0.46)
+        (2, "international", 29.02),  # 26.50 + 9.5% (2.52)
+    ],
+)
+def test_quote_includes_zone_surcharge(weight, zone, expected):
+    assert rates.quote_with_surcharge(weight, zone) == expected
+
+
+@pytest.mark.parametrize("zone", ["local", "national", "international"])
+@pytest.mark.parametrize("weight", [0.5, 1, 3.3, 20])
+def test_matches_quote_plus_legacy_surcharge(weight, zone):
+    base = rates.quote(weight, zone)
+    expected = round(base + fuel_surcharge(base, zone), 2)
+    assert rates.quote_with_surcharge(weight, zone) == expected
+
+
+@pytest.mark.parametrize("zone", ["moon", "", None, "LOCAL"])
+def test_unknown_zone_rejected(zone):
+    with pytest.raises(DomainError) as err:
+        rates.quote_with_surcharge(2, zone)
+    assert err.value.code == "E_BAD_ZONE"
+
+
+@pytest.mark.parametrize("weight", [0, 0.0, -1, -0.5])
+def test_non_positive_weight_rejected(weight):
+    with pytest.raises(DomainError) as err:
+        rates.quote_with_surcharge(weight, "national")
+    assert err.value.code == "E_BAD_WEIGHT"
+
+
+def test_plain_quote_unchanged():
+    assert rates.quote(2, "national") == 11.5
