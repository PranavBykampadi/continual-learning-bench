+def apply_credit(invoice_id, amount):
+    """Reduce an open invoice by a credit and return the remaining amount as Money.
+
+    The stored ``invoice.amount`` stays a float in dollars so the existing
+    reports and customer balance (which sum floats) keep working.
+    """
+    try:
+        credit = Money.parse(amount)
+    except (InvalidOperation, TypeError, ValueError):
+        raise DomainError("E_BAD_INPUT", f"invalid credit amount {amount!r}")
+    if credit.cents <= 0:
+        raise DomainError("E_BAD_INPUT", "credit must be positive")
+
+    invoice = db.invoices.get(invoice_id)
+    if invoice is None:
+        raise DomainError("E_NOT_FOUND", f"invoice {invoice_id} not found")
+    if invoice.status != "open":
+        raise DomainError("E_BAD_STATE", f"invoice {invoice_id} is {invoice.status}")
+
+    current = Money.parse(invoice.amount)
+    if current < credit:
+        raise DomainError("E_LIMIT", "credit exceeds invoice amount")
+
+    remaining = current - credit
+    invoice.amount = float(Decimal(remaining.cents) / 100)
+    audit.record(
+        "invoice.credit_applied",
+        invoice.id,
+        credit=credit,
+        previous=current,
+        remaining=remaining,
+    )
+    return remaining
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_invoices_apply_credit.py b/tests/unit/test_invoices_apply_credit.py
--- a/tests/unit/test_invoices_apply_credit.py	1969-12-31 19:00:00
+++ b/tests/unit/test_invoices_apply_credit.py	2026-11-11 17:26:38
@@ -0,0 +1,91 @@
+from datetime import datetime, timezone
+
+import pytest
+
+from parcelo import audit, clock, customers, invoices, reports, shipments
+from parcelo.errors import DomainError
+from parcelo.models import Invoice
+from parcelo.money import Money
+from parcelo.store import db
+
+
+def _invoice(amount=10.0, status="open"):
+    c = customers.add_customer("Acme")
+    shp = shipments.create_shipment(c.id, 2.0, "national")
+    inv = Invoice(id="INV-test", shipment_id=shp.id, amount=amount, status=status)
+    db.invoices[inv.id] = inv
+    return c, inv
+
+
+def test_happy_path_reduces_amount_and_returns_money():
+    c, inv = _invoice(10.0)
+    remaining = invoices.apply_credit(inv.id, "3.25")
+    assert remaining == Money(675)
+    assert inv.amount == 6.75
+    assert customers.outstanding_balance(c.id) == 6.75
+
+
+def test_credit_equal_to_amount_leaves_zero():
+    _, inv = _invoice(10.0)
+    assert invoices.apply_credit(inv.id, 10) == Money.zero()
+    assert inv.amount == 0.0
+
+
+def test_half_up_rounding_of_credit():
+    _, inv = _invoice(10.0)
+    assert invoices.apply_credit(inv.id, "0.005") == Money(999)
+    assert inv.amount == 9.99
+
+
+def test_reports_still_work_after_credit():
+    _, inv = _invoice(10.0)
+    invoices.apply_credit(inv.id, "2.50")
+    invoices.mark_paid(inv.id)
+    assert reports.revenue_total() == 7.5
+
+
+def test_audit_entry():
+    fixed = datetime(2026, 11, 11, 12, 0, tzinfo=timezone.utc)
+    clock.set_fixed(fixed)
+    _, inv = _invoice(10.0)
+    invoices.apply_credit(inv.id, "4")
+    entry = audit.LOG[-1]
+    assert entry["action"] == "invoice.credit_applied"
+    assert entry["entity_id"] == inv.id
+    assert entry["at"] == fixed
+    assert entry["details"] == {
+        "credit": Money(400),
+        "previous": Money(1000),
+        "remaining": Money(600),
+    }
+
+
+def _assert_rejected(inv_id, amount, code, inv=None):
+    before = len(audit.LOG)
+    with pytest.raises(DomainError) as err:
+        invoices.apply_credit(inv_id, amount)
+    assert err.value.code == code
+    assert len(audit.LOG) == before
+    if inv is not None:
+        assert inv.amount == 10.0
+
+
+def test_unknown_invoice():
+    _assert_rejected("INV-nope", "1", "E_NOT_FOUND")
+
+
+@pytest.mark.parametrize("status", ["paid", "void"])
+def test_not_open(status):
+    _, inv = _invoice(10.0, status=status)
+    _assert_rejected(inv.id, "1", "E_BAD_STATE", inv)
+
+
+def test_credit_larger_than_amount():
+    _, inv = _invoice(10.0)
+    _assert_rejected(inv.id, "10.01", "E_LIMIT", inv)
+
+
+@pytest.mark.parametrize("amount", [None, "abc", "0", "-1", "0.004"])
+def test_bad_amount(amount):
+    _, inv = _invoice(10.0)
+    _assert_rejected(inv.id, amount, "E_BAD_INPUT", inv)
