+++ b/tests/unit/test_customers_credit_limit.py	2026-11-11 17:38:51
@@ -0,0 +1,70 @@
+import math
+
+import pytest
+
+from parcelo import customers, events
+from parcelo.errors import DomainError
+from parcelo.money import Money
+
+
+def _customer():
+    c = customers.add_customer("Acme")
+    events.OUTBOX.clear()
+    return c
+
+
+def test_sets_limit_and_returns_money():
+    c = _customer()
+    result = customers.set_credit_limit(c.id, 1250.5)
+    assert result == Money(125050)
+    assert customers.get_customer(c.id).credit_limit == 1250.5
+
+
+def test_accepts_money_and_zero():
+    c = _customer()
+    assert customers.set_credit_limit(c.id, Money(9900)) == Money(9900)
+    assert customers.set_credit_limit(c.id, 0) == Money(0)
+    assert c.credit_limit == 0
+
+
+def test_emits_event_with_before_and_after():
+    c = _customer()
+    customers.set_credit_limit(c.id, 800)
+    assert len(events.OUTBOX) == 1
+    entry = events.OUTBOX[0]
+    assert entry["name"] == "customer.credit_limit_changed"
+    assert entry["entity_id"] == c.id
+    assert entry["payload"] == {"from_limit": Money(50000), "to_limit": Money(80000)}
+
+
+def test_same_limit_is_noop_without_event():
+    c = _customer()
+    assert customers.set_credit_limit(c.id, 500) == Money(50000)
+    assert events.OUTBOX == []
+
+
+def test_unknown_customer():
+    with pytest.raises(DomainError) as err:
+        customers.set_credit_limit("nope", 100)
+    assert err.value.code == "E_NOT_FOUND"
+    assert events.OUTBOX == []
+
+
+@pytest.mark.parametrize(
+    "amount", [-1, -0.01, Money(-1), math.inf, math.nan, True, "100", None]
+)
+def test_bad_amount_rejected(amount):
+    c = _customer()
+    with pytest.raises(DomainError) as err:
+        customers.set_credit_limit(c.id, amount)
+    assert err.value.code == "E_BAD_INPUT"
+    assert c.credit_limit == 500.0
+    assert events.OUTBOX == []
+
+
+@pytest.mark.parametrize("cid", ["", None, 5])
+def test_bad_customer_id_rejected(cid):
+    with pytest.raises(DomainError) as err:
+        customers.set_credit_limit(cid, 100)
+    assert err.value.code == "E_BAD_INPUT"
+    assert events.OUTBOX == []
