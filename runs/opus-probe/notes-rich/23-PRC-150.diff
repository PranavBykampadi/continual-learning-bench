+def set_credit_limit(customer_id, amount):
+    """Set a customer's credit limit and return the new limit as Money.
+
+    `amount` is a dollar value (int/float) or a Money. Zero is allowed
+    (no credit); negative values are rejected.
+    """
+    if not isinstance(customer_id, str) or not customer_id:
+        raise DomainError("E_BAD_INPUT", "customer_id must be a non-empty string")
+    if isinstance(amount, Money):
+        new_limit = amount
+    elif isinstance(amount, (int, float)) and not isinstance(amount, bool):
+        if not math.isfinite(amount):
+            raise DomainError("E_BAD_INPUT", f"amount must be finite: {amount}")
+        new_limit = Money.parse(amount)
+    else:
+        raise DomainError("E_BAD_INPUT", f"amount must be a number or Money: {amount!r}")
+    if new_limit.cents < 0:
+        raise DomainError("E_BAD_INPUT", f"amount must not be negative: {amount}")
+
+    customer = db.customers.get(customer_id)
+    if customer is None:
+        raise DomainError("E_NOT_FOUND", customer_id)
+
+    old_limit = Money.parse(customer.credit_limit)
+    if old_limit == new_limit:
+        return new_limit
+
+    # The stored field stays a float dollar amount (see models.Customer).
+    customer.credit_limit = new_limit.cents / 100
+    events.emit(
+        "customer.credit_limit_changed",
+        customer.id,
+        from_limit=old_limit,
+        to_limit=new_limit,
+    )
+    return new_limit
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_customers_credit_limit.py b/tests/unit/test_customers_credit_limit.py
