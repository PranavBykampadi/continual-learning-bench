diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_pickups_schedule.py b/tests/unit/test_pickups_schedule.py
--- a/tests/unit/test_pickups_schedule.py	1969-12-31 19:00:00
+++ b/tests/unit/test_pickups_schedule.py	2026-11-11 17:31:07
@@ -0,0 +1,107 @@
+from datetime import datetime, timedelta, timezone
+
+import pytest
+
+from parcelo import clock, customers, events, pickups, shipments, store
+from parcelo.errors import DomainError
+from parcelo.models import Pickup
+from parcelo.store import db
+
+NOW = datetime(2026, 11, 11, 9, 0, tzinfo=timezone.utc)
+WINDOW = NOW + timedelta(hours=4)
+
+
+def _setup(status="created"):
+    clock.set_fixed(NOW)
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 2.0, "national")
+    s.status = status
+    events.OUTBOX.clear()
+    return s
+
+
+def _assert_rejected(shipment_id, window_start, code, shipment=None):
+    before = dict(db.pickups)
+    status_before = shipment.status if shipment else None
+    with pytest.raises(DomainError) as err:
+        pickups.schedule_pickup(shipment_id, window_start)
+    assert err.value.code == code
+    assert db.pickups == before
+    if shipment:
+        assert shipment.status == status_before
+    assert events.OUTBOX == []
+
+
+def test_schedule_happy_path():
+    s = _setup()
+    result = pickups.schedule_pickup(s.id, WINDOW)
+    assert isinstance(result, Pickup)
+    assert result.id.startswith("pku_")
+    assert result.shipment_id == s.id
+    assert result.window_start == WINDOW
+    assert result.scheduled_at == NOW
+    assert db.pickups[result.id] is result
+    assert s.status == "created"
+
+
+def test_schedule_emits_exact_event():
+    s = _setup()
+    p = pickups.schedule_pickup(s.id, WINDOW)
+    assert events.OUTBOX == [
+        {
+            "name": "pickup.scheduled",
+            "entity_id": p.id,
+            "at": NOW,
+            "payload": {"shipment_id": s.id, "window_start": WINDOW},
+        }
+    ]
+
+
+def test_unknown_shipment_rejected():
+    _setup()
+    _assert_rejected("shp_missing", WINDOW, "E_NOT_FOUND")
+
+
+@pytest.mark.parametrize("status", ["in_transit", "delivered", "cancelled"])
+def test_wrong_status_rejected(status):
+    s = _setup(status)
+    _assert_rejected(s.id, WINDOW, "E_BAD_STATE", shipment=s)
+
+
+@pytest.mark.parametrize("shipment_id", [None, ""])
+def test_empty_shipment_id_rejected(shipment_id):
+    _setup()
+    _assert_rejected(shipment_id, WINDOW, "E_BAD_INPUT")
+
+
+@pytest.mark.parametrize("window_start", [None, "", "2026-11-11T13:00"])
+def test_bad_window_rejected(window_start):
+    s = _setup()
+    _assert_rejected(s.id, window_start, "E_BAD_INPUT", shipment=s)
+
+
+def test_input_validated_before_lookup():
+    _setup()
+    _assert_rejected("shp_missing", None, "E_BAD_INPUT")
+
+
+def test_repeat_schedule_creates_distinct_pickups():
+    s = _setup()
+    p1 = pickups.schedule_pickup(s.id, WINDOW)
+    p2 = pickups.schedule_pickup(s.id, WINDOW + timedelta(days=1))
+    assert p1.id != p2.id
+    assert set(db.pickups) == {p1.id, p2.id}
+    assert [e["entity_id"] for e in events.OUTBOX] == [p1.id, p2.id]
+
+
+def test_pickup_defaults():
+    p = Pickup("pku_x", "shp_x")
+    assert p.window_start is None
+    assert p.scheduled_at is None
+
+
+def test_reset_clears_pickups():
+    s = _setup()
+    pickups.schedule_pickup(s.id, WINDOW)
+    store.reset()
+    assert db.pickups == {}
