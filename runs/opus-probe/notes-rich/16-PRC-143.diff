@@ -0,0 +1,32 @@
+from datetime import datetime
+
+from parcelo import clock, events, ids
+from parcelo.errors import DomainError
+from parcelo.models import Pickup
+from parcelo.store import db
+
+
+def schedule_pickup(shipment_id, window_start):
+    if not shipment_id:
+        raise DomainError("E_BAD_INPUT", "shipment_id is required")
+    if not isinstance(window_start, datetime):
+        raise DomainError("E_BAD_INPUT", "window_start must be a datetime")
+    shipment = db.shipments.get(shipment_id)
+    if shipment is None:
+        raise DomainError("E_NOT_FOUND", shipment_id)
+    if shipment.status != "created":
+        raise DomainError("E_BAD_STATE", f"shipment {shipment_id} is {shipment.status}")
+    pickup = Pickup(
+        id=ids.new_id("pku"),
+        shipment_id=shipment_id,
+        window_start=window_start,
+        scheduled_at=clock.now(),
+    )
+    db.pickups[pickup.id] = pickup
+    events.emit(
+        "pickup.scheduled",
+        pickup.id,
+        shipment_id=shipment_id,
+        window_start=window_start,
+    )
+    return pickup
