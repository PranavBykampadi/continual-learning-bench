@@ -0,0 +1,86 @@
+import copy
+from datetime import datetime, timezone
+
+import pytest
+
+from parcelo import clock, customers, disputes, events, invoices, shipments, store
+from parcelo.errors import DomainError
+from parcelo.models import Dispute
+from parcelo.store import db
+
+NOW = datetime(2026, 11, 11, 12, 0, tzinfo=timezone.utc)
+
+
+@pytest.fixture
+def invoice():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 1.5, "national")
+    inv = invoices.issue_invoice(s.id)
+    events.OUTBOX.clear()
+    clock.set_fixed(NOW)
+    return inv
+
+
+def _snapshot():
+    return copy.deepcopy((db.customers, db.shipments, db.invoices, db.disputes))
+
+
+def _assert_rejected(invoice_id, reason, code):
+    before = _snapshot()
+    with pytest.raises(DomainError) as err:
+        disputes.open_dispute(invoice_id, reason)
+    assert err.value.code == code
+    assert _snapshot() == before
+    assert events.OUTBOX == []
+
+
+def test_open_dispute_happy_path(invoice):
+    before_invoice = copy.deepcopy(invoice)
+    d = disputes.open_dispute(invoice.id, "damaged parcel")
+    assert isinstance(d, Dispute)
+    assert d.id.startswith("dsp_")
+    assert d.invoice_id == invoice.id
+    assert d.reason == "damaged parcel"
+    assert d.opened_at == NOW
+    assert list(db.disputes) == [d.id]
+    assert db.disputes[d.id] is d
+    assert db.invoices[invoice.id] == before_invoice
+
+
+def test_open_dispute_emits_event(invoice):
+    d = disputes.open_dispute(invoice.id, "damaged parcel")
+    assert events.OUTBOX == [
+        {
+            "name": "dispute.opened",
+            "entity_id": d.id,
+            "at": NOW,
+            "payload": {"invoice_id": invoice.id, "reason": "damaged parcel"},
+        }
+    ]
+
+
+def test_unknown_invoice_rejected(invoice):
+    _assert_rejected("INV-nope", "damaged", "E_NOT_FOUND")
+
+
+@pytest.mark.parametrize("reason", ["", "   ", "\n\t", None, 42, ["x"]])
+def test_bad_reason_rejected(invoice, reason):
+    _assert_rejected(invoice.id, reason, "E_BAD_INPUT")
+
+
+def test_reason_validated_before_lookup():
+    _assert_rejected("INV-nope", "", "E_BAD_INPUT")
+
+
+def test_multiple_disputes_get_distinct_ids(invoice):
+    a = disputes.open_dispute(invoice.id, "late")
+    b = disputes.open_dispute(invoice.id, "wrong amount")
+    assert a.id != b.id
+    assert set(db.disputes) == {a.id, b.id}
+    assert len(events.OUTBOX) == 2
+
+
+def test_reset_clears_disputes(invoice):
+    disputes.open_dispute(invoice.id, "late")
+    store.reset()
+    assert db.disputes == {}
