diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_claims_file.py b/tests/unit/test_claims_file.py
--- a/tests/unit/test_claims_file.py	1969-12-31 19:00:00
+++ b/tests/unit/test_claims_file.py	2026-11-11 17:09:38
@@ -0,0 +1,70 @@
+from datetime import datetime, timezone
+
+import pytest
+
+from parcelo import audit, claims, clock, customers, shipments
+from parcelo.errors import DomainError
+from parcelo.money import Money
+from parcelo.store import db
+
+T = datetime(2026, 11, 11, 12, 0, tzinfo=timezone.utc)
+
+
+def _shipment(status="delivered"):
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 2.0, "national")
+    s.status = status
+    return s
+
+
+def test_file_claim_happy_path():
+    clock.set_fixed(T)
+    s = _shipment()
+    claim = claims.file_claim(s.id, "12.50", "damaged")
+    assert claim.id.startswith("clm_")
+    assert claim.shipment_id == s.id
+    assert claim.amount == Money(1250)
+    assert claim.reason == "damaged"
+    assert claim.filed_at == T
+    assert db.claims[claim.id] is claim
+
+
+def test_amount_rounds_half_up():
+    s = _shipment()
+    claim = claims.file_claim(s.id, "10.005", "late")
+    assert claim.amount == Money(1001)
+
+
+def test_records_audit():
+    clock.set_fixed(T)
+    s = _shipment()
+    claim = claims.file_claim(s.id, 5, "lost")
+    entry = audit.LOG[-1]
+    assert entry["action"] == "claim.filed"
+    assert entry["entity_id"] == claim.id
+    assert entry["at"] == T
+    assert entry["details"] == {"shipment_id": s.id, "amount_cents": 500}
+
+
+def test_unknown_shipment():
+    with pytest.raises(DomainError) as err:
+        claims.file_claim("shp_missing", 5, "lost")
+    assert err.value.code == "E_NOT_FOUND"
+
+
+@pytest.mark.parametrize("status", ["created", "cancelled"])
+def test_not_delivered(status):
+    s = _shipment(status)
+    with pytest.raises(DomainError) as err:
+        claims.file_claim(s.id, 5, "lost")
+    assert err.value.code == "E_BAD_STATE"
+    assert db.claims == {}
+
+
+@pytest.mark.parametrize("amount", [0, -1, "0.004", "abc", None])
+def test_bad_amount(amount):
+    s = _shipment()
+    with pytest.raises(DomainError) as err:
+        claims.file_claim(s.id, amount, "lost")
+    assert err.value.code == "E_BAD_INPUT"
+    assert db.claims == {}
