 def open_invoices():
     return [i for i in db.invoices.values() if i.status == "open"]
+
+
+LATE_AFTER_DAYS = 30
+LATE_FEE_DAILY_RATE = Decimal("0.015")
+
+
+def _as_utc(moment):
+    # Legacy invoices store naive UTC timestamps (datetime.utcnow()).
+    if moment.tzinfo is None:
+        return moment.replace(tzinfo=timezone.utc)
+    return moment
+
+
+def late_fee_for(invoice_id):
+    """Late fee accrued by an open invoice as of clock.now().
+
+    An invoice is late 30 days after issue; from then on it accrues 1.5% of
+    the invoice amount per full day past those 30 days.
+    """
+    if invoice_id not in db.invoices:
+        raise DomainError("E_NOT_FOUND", f"invoice {invoice_id} not found")
+    invoice = db.invoices[invoice_id]
+    if invoice.status != "open":
+        raise DomainError("E_BAD_STATE", f"invoice {invoice_id} is {invoice.status}")
+    days_since_issue = (_as_utc(clock.now()) - _as_utc(invoice.issued_at)).days
+    days_late = days_since_issue - LATE_AFTER_DAYS
+    if days_late <= 0:
+        return Money.zero()
+    return Money.parse(invoice.amount).scale(LATE_FEE_DAILY_RATE * days_late)
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_late_fee.py b/tests/unit/test_late_fee.py
--- a/tests/unit/test_late_fee.py	1969-12-31 19:00:00
+++ b/tests/unit/test_late_fee.py	2026-11-11 17:04:08
@@ -0,0 +1,69 @@
+from datetime import datetime, timedelta, timezone
+
+import pytest
+
+from parcelo import audit, clock, invoices
+from parcelo.errors import DomainError
+from parcelo.models import Invoice
+from parcelo.money import Money
+from parcelo.store import db
+
+ISSUED = datetime(2026, 1, 1, 12, 0, tzinfo=timezone.utc)
+
+
+def _invoice(amount=100.0, issued_at=ISSUED, status="open"):
+    inv = Invoice(id="INV-test", shipment_id="shp_x", amount=amount,
+                  status=status, issued_at=issued_at)
+    db.invoices[inv.id] = inv
+    return inv
+
+
+def test_not_late_yet_is_zero():
+    inv = _invoice()
+    clock.set_fixed(ISSUED + timedelta(days=30))
+    assert invoices.late_fee_for(inv.id) == Money.zero()
+
+
+def test_fee_per_day_past_30_days():
+    inv = _invoice(amount=100.0)
+    clock.set_fixed(ISSUED + timedelta(days=33))
+    assert invoices.late_fee_for(inv.id) == Money(450)
+
+
+def test_partial_day_does_not_count():
+    inv = _invoice(amount=100.0)
+    clock.set_fixed(ISSUED + timedelta(days=31, hours=23))
+    assert invoices.late_fee_for(inv.id) == Money(150)
+
+
+def test_rounds_to_cents():
+    inv = _invoice(amount=10.33)
+    clock.set_fixed(ISSUED + timedelta(days=31))
+    assert invoices.late_fee_for(inv.id) == Money(15)  # 0.15495 -> 0.15
+
+
+def test_naive_legacy_issue_time():
+    inv = _invoice(amount=200.0, issued_at=datetime(2026, 1, 1, 12, 0))
+    clock.set_fixed(ISSUED + timedelta(days=32))
+    assert invoices.late_fee_for(inv.id) == Money(600)
+
+
+def test_unknown_invoice():
+    with pytest.raises(DomainError) as err:
+        invoices.late_fee_for("INV-nope")
+    assert err.value.code == "E_NOT_FOUND"
+
+
+def test_paid_invoice_rejected():
+    inv = _invoice(status="paid")
+    clock.set_fixed(ISSUED + timedelta(days=40))
+    with pytest.raises(DomainError) as err:
+        invoices.late_fee_for(inv.id)
+    assert err.value.code == "E_BAD_STATE"
+
+
+def test_read_only_no_audit():
+    inv = _invoice()
+    clock.set_fixed(ISSUED + timedelta(days=40))
+    invoices.late_fee_for(inv.id)
+    assert audit.LOG == []
