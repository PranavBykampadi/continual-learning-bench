         raise ValueError("unknown zone: %s" % zone)
@@ -12,3 +17,17 @@
     if weight_kg <= 0:
         raise ValueError("weight must be positive")
     return round(base_rate(zone) + PER_KG * weight_kg, 2)
+
+
+def insurance_fee(declared_value, zone):
+    """Insurance fee for a shipment's declared value.
+
+    2% of the declared value plus the zone's fuel surcharge percentage of the
+    declared value, with a minimum fee of MIN_INSURANCE_FEE.
+    """
+    if zone not in FUEL_SURCHARGE_PCT:
+        raise ValueError("unknown zone: %s" % zone)
+    if declared_value <= 0:
+        raise ValueError("declared value must be positive")
+    pct = INSURANCE_PCT + FUEL_SURCHARGE_PCT[zone]
+    return max(round(declared_value * pct / 100.0, 2), MIN_INSURANCE_FEE)
