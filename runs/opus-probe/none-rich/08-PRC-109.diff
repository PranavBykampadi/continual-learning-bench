diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_addresses.py b/tests/unit/test_addresses.py
--- a/tests/unit/test_addresses.py	1969-12-31 19:00:00
+++ b/tests/unit/test_addresses.py	2026-11-11 17:04:22
@@ -0,0 +1,32 @@
+import pytest
+
+from parcelo import customers
+from parcelo.errors import DomainError
+from parcelo.store import db
+
+
+def test_add_address_stores_and_returns():
+    c = customers.add_customer("Acme")
+    a = customers.add_address(c.id, "1 Main St", "Springfield")
+    assert a.id.startswith("adr_")
+    assert (a.customer_id, a.line, a.city) == (c.id, "1 Main St", "Springfield")
+    assert db.addresses[a.id] is a
+
+
+def test_add_address_unknown_customer():
+    with pytest.raises(DomainError) as err:
+        customers.add_address("nope", "1 Main St", "Springfield")
+    assert err.value.code == "E_UNKNOWN_CUSTOMER"
+    assert db.addresses == {}
+
+
+@pytest.mark.parametrize(
+    "line,city",
+    [("", "Springfield"), ("1 Main St", ""), ("   ", "Springfield"), ("1 Main St", None)],
+)
+def test_add_address_requires_line_and_city(line, city):
+    c = customers.add_customer("Acme")
+    with pytest.raises(DomainError) as err:
+        customers.add_address(c.id, line, city)
+    assert err.value.code == "E_BAD_INPUT"
+    assert db.addresses == {}
