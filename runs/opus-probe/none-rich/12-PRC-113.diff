@@ -1,9 +1,64 @@
-from parcelo import customers, invoices, shipments
+import pytest
 
+from parcelo import audit, customers, invoices, reports, shipments
+from parcelo.errors import DomainError
 
+
 def test_issue_and_pay():
     c = customers.add_customer("Acme")
     s = shipments.create_shipment(c.id, 2, "local")
     inv = invoices.issue_invoice(s.id)
     assert inv.amount == 7.0
     assert invoices.mark_paid(inv.id).status == "paid"
+
+
+def _open_invoice():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 2, "local")
+    return c, invoices.issue_invoice(s.id)
+
+
+def test_apply_credit_reduces_amount():
+    c, inv = _open_invoice()
+    assert invoices.apply_credit(inv.id, 2.5) == 4.5
+    assert inv.amount == 4.5
+    assert isinstance(inv.amount, float)
+    assert customers.outstanding_balance(c.id) == 4.5
+    assert audit.LOG[-1]["action"] == "invoice.credit_applied"
+    invoices.mark_paid(inv.id)
+    assert reports.revenue_total() == 4.5
+
+
+def test_apply_credit_is_exact_to_the_cent():
+    _, inv = _open_invoice()
+    assert invoices.apply_credit(inv.id, 0.1) == 6.9
+    assert invoices.apply_credit(inv.id, 0.2) == 6.7
+
+
+def test_apply_full_credit_leaves_zero():
+    _, inv = _open_invoice()
+    assert invoices.apply_credit(inv.id, 7) == 0.0
+
+
+def test_apply_credit_unknown_invoice():
+    with pytest.raises(DomainError) as e:
+        invoices.apply_credit("INV-missing", 1)
+    assert e.value.code == "E_NOT_FOUND"
+
+
+def test_apply_credit_not_open():
+    _, inv = _open_invoice()
+    invoices.mark_paid(inv.id)
+    with pytest.raises(DomainError) as e:
+        invoices.apply_credit(inv.id, 1)
+    assert e.value.code == "E_BAD_STATE"
+    assert inv.amount == 7.0
+
+
+@pytest.mark.parametrize("credit", [7.01, 0, -1, "abc", None, True])
+def test_apply_credit_rejects_bad_amounts(credit):
+    _, inv = _open_invoice()
+    with pytest.raises(DomainError) as e:
+        invoices.apply_credit(inv.id, credit)
+    assert e.value.code == "E_BAD_INPUT"
+    assert inv.amount == 7.0
