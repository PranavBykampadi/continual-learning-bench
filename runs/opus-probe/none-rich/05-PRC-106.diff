-from parcelo import customers, invoices, shipments
+from datetime import datetime, timedelta, timezone
 
+import pytest
 
+from parcelo import clock, customers, invoices, shipments
+from parcelo.errors import DomainError
+
+
 def test_issue_and_pay():
     c = customers.add_customer("Acme")
     s = shipments.create_shipment(c.id, 2, "local")
     inv = invoices.issue_invoice(s.id)
     assert inv.amount == 7.0
     assert invoices.mark_paid(inv.id).status == "paid"
+
+
+def _invoice_issued_days_ago(days):
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 2, "local")
+    inv = invoices.issue_invoice(s.id)
+    now = datetime(2026, 3, 1, 12, tzinfo=timezone.utc)
+    # issue_invoice stores naive UTC timestamps
+    inv.issued_at = (now - timedelta(days=days)).replace(tzinfo=None)
+    clock.set_fixed(now)
+    return inv
+
+
+@pytest.mark.parametrize(
+    "days,fee",
+    [(0, 0.0), (29, 0.0), (30, 0.0), (31, 0.11), (40, 1.05)],
+)
+def test_late_fee_for(days, fee):
+    inv = _invoice_issued_days_ago(days)
+    assert inv.amount == 7.0
+    assert invoices.late_fee_for(inv.id) == fee
+
+
+def test_late_fee_for_unknown_invoice():
+    with pytest.raises(DomainError) as e:
+        invoices.late_fee_for("INV-missing")
+    assert e.value.code == "E_NOT_FOUND"
