@@ -0,0 +1,33 @@
+from parcelo import customers, invoices, reports, shipments
+
+
+def _invoice(customer, weight=2, zone="local"):
+    s = shipments.create_shipment(customer.id, weight, zone)
+    return invoices.issue_invoice(s.id)
+
+
+def test_outstanding_by_customer_sums_open_invoices_only():
+    acme = customers.add_customer("Acme")
+    globex = customers.add_customer("Globex")
+    idle = customers.add_customer("Idle")
+
+    a1 = _invoice(acme)
+    a2 = _invoice(acme)
+    paid = _invoice(acme)
+    invoices.mark_paid(paid.id)
+    void = _invoice(globex)
+    void.status = "void"
+    g1 = _invoice(globex)
+
+    result = reports.outstanding_by_customer()
+
+    assert result == {
+        acme.id: round(a1.amount + a2.amount, 2),
+        globex.id: g1.amount,
+        idle.id: 0.0,
+    }
+    assert result[acme.id] == customers.outstanding_balance(acme.id)
+
+
+def test_outstanding_by_customer_empty():
+    assert reports.outstanding_by_customer() == {}
