+def _as_utc(moment):
+    # Invoices are issued with naive UTC timestamps (datetime.utcnow()), while
+    # clock.now() is timezone-aware UTC. Treat naive values as UTC so the
+    # subtraction is valid and not skewed by the host's local UTC offset.
+    if moment.tzinfo is None:
+        return moment.replace(tzinfo=timezone.utc)
+    return moment.astimezone(timezone.utc)
+
+
+def aging_report():
+    """Total open (unpaid) invoice amounts, bucketed by whole days since issue.
+
+    Buckets: "0-30" (0 to 30 days), "31-60" (31 to 60 days), "60+" (more than 60).
+    """
+    totals = {"0-30": Money.zero(), "31-60": Money.zero(), "60+": Money.zero()}
+    now = _as_utc(clock.now())
+    for invoice in db.invoices.values():
+        if invoice.status == "paid" or invoice.issued_at is None:
+            continue
+        # Pass `now` explicitly: days_between's default end is naive local
+        # time, which would be off by the host's UTC offset.
+        age = days_between(_as_utc(invoice.issued_at), now)
+        if age <= 30:
+            bucket = "0-30"
+        elif age <= 60:
+            bucket = "31-60"
+        else:
+            bucket = "60+"
+        totals[bucket] = totals[bucket] + Money.parse(invoice.amount)
+    return {bucket: total.cents / 100 for bucket, total in totals.items()}
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/test_reports.py b/tests/test_reports.py
--- a/tests/test_reports.py	1969-12-31 19:00:00
+++ b/tests/test_reports.py	2026-11-11 17:27:21
@@ -0,0 +1,38 @@
+from datetime import datetime, timedelta, timezone
+
+from parcelo import clock, reports
+from parcelo.models import Invoice
+from parcelo.store import db
+
+NOW = datetime(2026, 6, 1, 12, 0, tzinfo=timezone.utc)
+
+
+def _add(inv_id, amount, days_ago, status="open", naive=True):
+    issued = NOW - timedelta(days=days_ago)
+    if naive:
+        issued = issued.replace(tzinfo=None)
+    db.invoices[inv_id] = Invoice(inv_id, "S", amount, status=status, issued_at=issued)
+
+
+def test_empty_report_has_zero_buckets():
+    clock.set_fixed(NOW)
+    assert reports.aging_report() == {"0-30": 0, "31-60": 0, "60+": 0}
+
+
+def test_bucket_boundaries_and_paid_excluded():
+    clock.set_fixed(NOW)
+    _add("a", 10.10, 0)
+    _add("b", 20.20, 30)
+    _add("c", 1.00, 31, naive=False)
+    _add("d", 2.00, 60)
+    _add("e", 5.00, 61)
+    _add("f", 100.0, 90, status="paid")
+    assert reports.aging_report() == {"0-30": 30.30, "31-60": 3.00, "60+": 5.00}
+
+
+def test_partial_day_rounds_down():
+    clock.set_fixed(NOW)
+    db.invoices["x"] = Invoice(
+        "x", "S", 4.0, issued_at=(NOW - timedelta(days=30, hours=23)).replace(tzinfo=None)
+    )
+    assert reports.aging_report()["0-30"] == 4.0
