+from parcelo import customers, reports, shipments
+
+
+def test_volume_report_counts_and_tiers():
+    small = customers.add_customer("Small")
+    mid = customers.add_customer("Mid")
+    big = customers.add_customer("Big")
+    idle = customers.add_customer("Idle")
+    for _ in range(9):
+        shipments.create_shipment(small.id, 1, "local")
+    for _ in range(10):
+        shipments.create_shipment(mid.id, 1, "local")
+    for _ in range(50):
+        shipments.create_shipment(big.id, 1, "national")
+
+    report = reports.volume_report()
+
+    assert report == {
+        small.id: {"shipments": 9, "tier": "starter"},
+        mid.id: {"shipments": 10, "tier": "regular"},
+        big.id: {"shipments": 50, "tier": "bulk"},
+        idle.id: {"shipments": 0, "tier": "starter"},
+    }
+
+
+def test_volume_report_empty():
+    assert reports.volume_report() == {}
