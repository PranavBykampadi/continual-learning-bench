@@ -0,0 +1,35 @@
+import pytest
+from parcelo.customers import add_customer, add_address
+from parcelo.store import reset, db
+from parcelo.errors import DomainError
+
+def test_add_address_success():
+    reset()
+    customer = add_customer("John Doe")
+    address = add_address(customer.id, "123 Main St", "Springfield")
+    
+    assert address.id.startswith("addr")
+    assert address.customer_id == customer.id
+    assert address.line == "123 Main St"
+    assert address.city == "Springfield"
+    assert db.addresses[address.id] == address
+
+def test_add_address_unknown_customer():
+    reset()
+    with pytest.raises(DomainError) as excinfo:
+        add_address("nonexistent", "123 Main St", "Springfield")
+    assert excinfo.value.code == "E_UNKNOWN_CUSTOMER"
+
+def test_add_address_empty_line():
+    reset()
+    customer = add_customer("John Doe")
+    with pytest.raises(DomainError) as excinfo:
+        add_address(customer.id, "", "Springfield")
+    assert excinfo.value.code == "E_BAD_INPUT"
+
+def test_add_address_empty_city():
+    reset()
+    customer = add_customer("John Doe")
+    with pytest.raises(DomainError) as excinfo:
+        add_address(customer.id, "123 Main St", "")
+    assert excinfo.value.code == "E_BAD_INPUT"
