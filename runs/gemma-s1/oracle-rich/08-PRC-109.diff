+def add_address(customer_id, line, city):
+    if customer_id not in db.customers:
+        raise DomainError("E_UNKNOWN_CUSTOMER", f"Customer {customer_id} not found")
+    if not line or not city:
+        raise DomainError("E_BAD_INPUT", "Street line and city are required")
+    
+    address = Address(
+        id=new_id("addr"),
+        customer_id=customer_id,
+        line=line,
+        city=city
+    )
+    db.addresses[address.id] = address
+    record("add_address", address.id, customer_id=customer_id)
+    return address
