+from parcelo.models import Dispute
+from parcelo.store import db
+from parcelo.ids import new_id
+from parcelo.clock import now
+from parcelo.errors import DomainError
+from parcelo.events import emit
+
+def open_dispute(invoice_id, reason):
+    if not reason:
+        raise DomainError("E_BAD_INPUT", "Reason is required")
+    
+    if invoice_id not in db.invoices:
+        raise DomainError("E_NOT_FOUND", f"Invoice {invoice_id} not found")
+    
+    dispute = Dispute(
+        id=new_id("dsp"),
+        invoice_id=invoice_id,
+        reason=reason,
+        opened_at=now()
+    )
+    
+    db.disputes[dispute.id] = dispute
+    emit("dispute_opened", dispute.id, invoice_id=invoice_id)
+    
+    return dispute
