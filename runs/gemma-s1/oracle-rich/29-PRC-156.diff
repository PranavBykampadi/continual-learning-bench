+
 ZONE_BASE = {"local": 4.5, "national": 9.0, "international": 24.0}
 PER_KG = 1.25
 
@@ -12,3 +16,20 @@
     if weight_kg <= 0:
         raise ValueError("weight must be positive")
     return round(base_rate(zone) + PER_KG * weight_kg, 2)
+
+
+def heavy_quote(weight_kg, zone):
+    if weight_kg <= 0:
+        raise DomainError("E_BAD_WEIGHT", "weight must be positive")
+    if zone not in ZONE_BASE:
+        raise DomainError("E_BAD_ZONE", f"unknown zone: {zone}")
+
+    normal_price = quote(weight_kg, zone)
+    amount = Money.parse(normal_price)
+
+    if weight_kg > HEAVY_WEIGHT_THRESHOLD_KG:
+        extra_kg = weight_kg - HEAVY_WEIGHT_THRESHOLD_KG
+        surcharge = Money.parse(extra_kg * HEAVY_SURCHARGE_PER_KG)
+        amount = amount + surcharge
+
+    return amount
