+++ b/tests/unit/test_heavy_quote.py	2026-11-12 01:41:28
@@ -0,0 +1,39 @@
+import pytest
+from parcelo.rates import heavy_quote
+from parcelo.money import Money
+from parcelo.errors import DomainError
+
+def test_heavy_quote_normal_weight():
+    # Weight <= 30kg: just the normal quote
+    # weight 10, zone local: 4.5 + (1.25 * 10) = 17.00
+    assert heavy_quote(10, "local") == Money.parse(17.00)
+    # weight 30, zone local: 4.5 + (1.25 * 30) = 42.00
+    assert heavy_quote(30, "local") == Money.parse(42.00)
+
+def test_heavy_quote_heavy_weight():
+    # Weight > 30kg: normal quote + 0.75 * (weight - 30)
+    # weight 31, zone local: 
+    # normal: 4.5 + (1.25 * 31) = 43.25
+    # surcharge: 1 * 0.75 = 0.75
+    # total: 44.00
+    assert heavy_quote(31, "local") == Money.parse(44.00)
+    
+    # weight 40, zone national:
+    # normal: 9.0 + (1.25 * 40) = 59.00
+    # surcharge: 10 * 0.75 = 7.50
+    # total: 66.50
+    assert heavy_quote(40, "national") == Money.parse(66.50)
+
+def test_heavy_quote_invalid_weight():
+    with pytest.raises(DomainError) as exc:
+        heavy_quote(0, "local")
+    assert exc.value.code == "E_BAD_WEIGHT"
+    
+    with pytest.raises(DomainError) as exc:
+        heavy_quote(-1, "local")
+    assert exc.value.code == "E_BAD_WEIGHT"
+
+def test_heavy_quote_invalid_zone():
+    with pytest.raises(DomainError) as exc:
+        heavy_quote(10, "mars")
+    assert exc.value.code == "E_BAD_ZONE"
