+
+def quote_with_surcharge(weight_kg, zone):
+    if weight_kg <= 0:
+        raise DomainError("E_BAD_WEIGHT", "weight must be positive")
+    
+    if zone not in ZONE_BASE:
+        raise DomainError("E_BAD_ZONE", f"unknown zone: {zone}")
+
+    surcharges = {"local": 0.0, "national": 0.04, "international": 0.095}
+    
+    base_val = base_rate(zone) + PER_KG * weight_kg
+    money_base = Money.parse(base_val)
+    
+    surcharge_factor = surcharges[zone]
+    surcharge_amount = money_base.scale(surcharge_factor)
+    
+    return money_base + surcharge_amount
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_rates_surcharge.py b/tests/unit/test_rates_surcharge.py
--- a/tests/unit/test_rates_surcharge.py	1969-12-31 19:00:00
+++ b/tests/unit/test_rates_surcharge.py	2026-11-11 17:38:38
@@ -0,0 +1,33 @@
+from parcelo.rates import quote_with_surcharge
+from parcelo.money import Money
+from parcelo.errors import DomainError
+import pytest
+
+def test_quote_with_surcharge_local():
+    # weight 1kg, local: 4.5 + 1.25 * 1 = 5.75. Surcharge 0% = 5.75
+    res = quote_with_surcharge(1, "local")
+    assert res == Money(575)
+
+def test_quote_with_surcharge_national():
+    # weight 2kg, national: 9.0 + 1.25 * 2 = 11.50. Surcharge 4% = 0.46. Total = 11.96
+    res = quote_with_surcharge(2, "national")
+    assert res == Money(1196)
+
+def test_quote_with_surcharge_international():
+    # weight 10kg, international: 24.0 + 1.25 * 10 = 36.50. Surcharge 9.5% = 3.4675 -> 3.47. Total = 39.97
+    res = quote_with_surcharge(10, "international")
+    assert res == Money(3997)
+
+def test_quote_with_surcharge_invalid_zone():
+    with pytest.raises(DomainError) as exc:
+        quote_with_surcharge(1, "mars")
+    assert exc.value.code == "E_BAD_ZONE"
+
+def test_quote_with_surcharge_invalid_weight():
+    with pytest.raises(DomainError) as exc:
+        quote_with_surcharge(0, "local")
+    assert exc.value.code == "E_BAD_WEIGHT"
+    
+    with pytest.raises(DomainError) as exc:
+        quote_with_surcharge(-1, "local")
+    assert exc.value.code == "E_BAD_WEIGHT"
