@@ -0,0 +1,52 @@
+import pytest
+from parcelo import store, customers, vouchers, money, errors
+
+def test_issue_voucher_success():
+    store.reset()
+    customer = customers.add_customer("John Doe")
+    customer_id = customer.id
+    
+    amount = money.Money.parse("50.00")
+    voucher = vouchers.issue_voucher(customer_id, amount)
+    
+    assert voucher.customer_id == customer_id
+    assert voucher.amount == amount
+    assert voucher.id.startswith("vch_")
+    assert store.db.vouchers[voucher.id] == voucher
+
+def test_issue_voucher_customer_not_found():
+    store.reset()
+    amount = money.Money.parse("10.00")
+    with pytest.raises(errors.DomainError) as excinfo:
+        vouchers.issue_voucher("non_existent", amount)
+    assert excinfo.value.code == "E_UNKNOWN_CUSTOMER"
+
+def test_issue_voucher_too_high():
+    store.reset()
+    customer = customers.add_customer("John Doe")
+    customer_id = customer.id
+    
+    amount = money.Money.parse("150.01")
+    with pytest.raises(errors.DomainError) as excinfo:
+        vouchers.issue_voucher(customer_id, amount)
+    assert excinfo.value.code == "E_LIMIT"
+
+def test_issue_voucher_zero_amount():
+    store.reset()
+    customer = customers.add_customer("John Doe")
+    customer_id = customer.id
+    
+    amount = money.Money.parse("0.00")
+    with pytest.raises(errors.DomainError) as excinfo:
+        vouchers.issue_voucher(customer_id, amount)
+    assert excinfo.value.code == "E_BAD_INPUT"
