diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/parcelo/vouchers.py b/parcelo/vouchers.py
--- a/parcelo/vouchers.py	1969-12-31 19:00:00
+++ b/parcelo/vouchers.py	2026-11-12 01:55:47
@@ -0,0 +1,29 @@
+from . import store, ids, clock, events, errors
+from .models import Voucher
+from .money import Money
+from .settings import MAX_VOUCHER_AMOUNT
+from .customers import get_customer
+
+def issue_voucher(customer_id: str, amount: Money) -> Voucher:
+    if amount.cents <= 0:
+        raise errors.DomainError("E_BAD_INPUT", "Voucher amount must be positive")
+    
+    if amount.cents > MAX_VOUCHER_AMOUNT:
+        raise errors.DomainError("E_LIMIT", f"Voucher amount cannot exceed {MAX_VOUCHER_AMOUNT/100:.2f}")
+    
+    try:
+        get_customer(customer_id)
+    except KeyError:
+        raise errors.DomainError("E_UNKNOWN_CUSTOMER", f"Customer {customer_id} not found")
+    
+    voucher = Voucher(
+        id=ids.new_id("vch"),
+        customer_id=customer_id,
+        amount=amount,
+        issued_at=clock.now()
+    )
+    
+    store.db.vouchers[voucher.id] = voucher
+    events.emit("voucher_issued", voucher.id, customer_id=customer_id, amount=amount.cents)
+    
+    return voucher
