diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/parcelo/refunds.py b/parcelo/refunds.py
--- a/parcelo/refunds.py	1969-12-31 19:00:00
+++ b/parcelo/refunds.py	2026-11-11 17:41:14
@@ -0,0 +1,27 @@
+from parcelo.models import Refund
+from parcelo.store import db
+from parcelo.ids import new_id
+from parcelo.clock import now
+from parcelo.money import Money
+from parcelo.errors import DomainError
+from parcelo.audit import record
+
+def create_refund(invoice_id: str, amount: Money) -> Refund:
+    invoice = db.invoices.get(invoice_id)
+    if not invoice:
+        raise DomainError("E_NOT_FOUND", f"Invoice {invoice_id} not found")
+    
+    if invoice.status != "paid":
+        raise DomainError("E_NOT_PAID", f"Invoice {invoice_id} is not paid")
+    
+    refund = Refund(
+        id=new_id("ref"),
+        invoice_id=invoice_id,
+        amount=amount,
+        created_at=now()
+    )
+    
+    db.refunds[refund.id] = refund
+    record("create_refund", refund.id, invoice_id=invoice_id, amount=amount)
+    
+    return refund
