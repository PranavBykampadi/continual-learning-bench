diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_refunds.py b/tests/unit/test_refunds.py
--- a/tests/unit/test_refunds.py	1969-12-31 19:00:00
+++ b/tests/unit/test_refunds.py	2026-11-11 17:41:34
@@ -0,0 +1,34 @@
+import pytest
+from parcelo.store import db, reset
+from parcelo.models import Invoice
+from parcelo.money import Money
+from parcelo.refunds import create_refund
+from parcelo.errors import DomainError
+
+def test_create_refund_success():
+    reset()
+    invoice_id = "inv_123"
+    db.invoices[invoice_id] = Invoice(id=invoice_id, shipment_id="sh_1", amount=100.0, status="paid")
+    
+    amount = Money.parse(50.0)
+    refund = create_refund(invoice_id, amount)
+    
+    assert refund.id.startswith("ref_")
+    assert refund.invoice_id == invoice_id
+    assert refund.amount == amount
+    assert refund.id in db.refunds
+
+def test_create_refund_not_found():
+    reset()
+    with pytest.raises(DomainError) as exc:
+        create_refund("nonexistent", Money.parse(10.0))
+    assert exc.value.code == "E_NOT_FOUND"
+
+def test_create_refund_not_paid():
+    reset()
+    invoice_id = "inv_123"
+    db.invoices[invoice_id] = Invoice(id=invoice_id, shipment_id="sh_1", amount=100.0, status="open")
+    
+    with pytest.raises(DomainError) as exc:
+        create_refund(invoice_id, Money.parse(10.0))
+    assert exc.value.code == "E_NOT_PAID"
