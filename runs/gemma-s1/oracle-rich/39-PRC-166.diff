diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_escalate_invoice.py b/tests/unit/test_escalate_invoice.py
--- a/tests/unit/test_escalate_invoice.py	1969-12-31 19:00:00
+++ b/tests/unit/test_escalate_invoice.py	2026-11-12 01:59:47
@@ -0,0 +1,83 @@
+import pytest
+from parcelo.store import db, reset
+from parcelo.models import Invoice
+from parcelo.invoices import escalate_invoice
+from parcelo.errors import DomainError
+import parcelo.events
+
+def test_escalate_invoice_success(monkeypatch):
+    reset()
+    events = []
+    def mock_emit(name, entity_id, **kwargs):
+        events.append((name, entity_id))
+    
+    # Patch in the module where it is imported/used
+    monkeypatch.setattr("parcelo.invoices.emit", mock_emit)
+    
+    invoice_id = "INV-123"
+    db.invoices[invoice_id] = Invoice(
+        id=invoice_id,
+        shipment_id="SHIP-1",
+        amount=500.00,
+        status="open"
+    )
+    
+    result = escalate_invoice(invoice_id)
+    
+    assert result.status == "escalated"
+    assert ("invoice_escalated", invoice_id) in events
+
+def test_escalate_invoice_not_found():
+    reset()
+    with pytest.raises(DomainError) as excinfo:
+        escalate_invoice("NON-EXISTENT")
+    assert excinfo.value.code == "E_NOT_FOUND"
+
+def test_escalate_invoice_too_small():
+    reset()
+    invoice_id = "INV-123"
+    db.invoices[invoice_id] = Invoice(
+        id=invoice_id,
+        shipment_id="SHIP-1",
+        amount=499.99,
+        status="open"
+    )
+    
+    with pytest.raises(DomainError) as excinfo:
+        escalate_invoice(invoice_id)
+    assert excinfo.value.code == "E_INELIGIBLE_FOR_ESCALATION"
+
+def test_escalate_invoice_wrong_status():
+    reset()
+    invoice_id = "INV-123"
+    db.invoices[invoice_id] = Invoice(
+        id=invoice_id,
+        shipment_id="SHIP-1",
+        amount=600.00,
+        status="paid"
+    )
+    
+    with pytest.raises(DomainError) as excinfo:
+        escalate_invoice(invoice_id)
+    assert excinfo.value.code == "E_BAD_STATE"
+
+def test_escalate_invoice_idempotency(monkeypatch):
+    reset()
+    events = []
+    def mock_emit(name, entity_id, **kwargs):
+        events.append((name, entity_id))
+    
+    monkeypatch.setattr("parcelo.invoices.emit", mock_emit)
+    
+    invoice_id = "INV-123"
+    db.invoices[invoice_id] = Invoice(
+        id=invoice_id,
+        shipment_id="SHIP-1",
+        amount=600.00,
+        status="escalated"
+    )
+    
+    result = escalate_invoice(invoice_id)
+    
+    assert result.status == "escalated"
+    assert len(events) == 0
