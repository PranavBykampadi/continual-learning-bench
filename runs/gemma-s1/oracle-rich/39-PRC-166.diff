@@ -32,3 +36,27 @@
 
 def open_invoices():
     return [i for i in db.invoices.values() if i.status == "open"]
+
+
+def escalate_invoice(invoice_id):
+    if invoice_id not in db.invoices:
+        raise DomainError("E_NOT_FOUND", f"Invoice {invoice_id} not found")
+
+    invoice = db.invoices[invoice_id]
+
+    if invoice.status == "escalated":
+        return invoice
+
+    if invoice.status != "open":
+        raise DomainError("E_BAD_STATE", "Only open invoices can be escalated")
+
+    amount = Money.parse(invoice.amount)
+    threshold = Money.parse(ESCALATION_THRESHOLD)
+
+    if amount < threshold:
+        raise DomainError("E_INELIGIBLE_FOR_ESCALATION", f"Invoice amount {amount} is below threshold {threshold}")
+
+    invoice.status = "escalated"
+    emit("invoice_escalated", invoice.id)
+
+    return invoice
