diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_cancel_shipment.py b/tests/unit/test_cancel_shipment.py
--- a/tests/unit/test_cancel_shipment.py	1969-12-31 19:00:00
+++ b/tests/unit/test_cancel_shipment.py	2026-11-11 17:35:54
@@ -0,0 +1,46 @@
+import pytest
+from parcelo.shipments import create_shipment, cancel_shipment, get_shipment
+from parcelo.errors import DomainError
+from parcelo.store import db
+
+def test_cancel_shipment_success():
+    db.customers.clear()
+    db.shipments.clear()
+    db.customers["cust1"] = type('Customer', (), {"id": "cust1"})()
+    
+    shipment = create_shipment("cust1", 1.0, "local")
+    cancelled_shp = cancel_shipment(shipment.id, "Customer changed mind")
+    
+    assert cancelled_shp.status == "cancelled"
+    assert "Customer changed mind" in cancelled_shp.notes
+    assert get_shipment(shipment.id).status == "cancelled"
+
+def test_cancel_non_existent_shipment():
+    db.shipments.clear()
+    with pytest.raises(DomainError) as exc:
+        cancel_shipment("non-existent", "reason")
+    assert exc.value.code == "E_NOT_FOUND"
+
+def test_cancel_already_cancelled_shipment():
+    db.customers.clear()
+    db.shipments.clear()
+    db.customers["cust1"] = type('Customer', (), {"id": "cust1"})()
+    
+    shipment = create_shipment("cust1", 1.0, "local")
+    cancel_shipment(shipment.id, "First reason")
+    
+    with pytest.raises(DomainError) as exc:
+        cancel_shipment(shipment.id, "Second reason")
+    assert exc.value.code == "E_INVALID_SHIPMENT_STATUS"
+
+def test_cancel_delivered_shipment():
+    db.customers.clear()
+    db.shipments.clear()
+    db.customers["cust1"] = type('Customer', (), {"id": "cust1"})()
+    
+    shipment = create_shipment("cust1", 1.0, "local")
+    shipment.status = "delivered"
+    
+    with pytest.raises(DomainError) as exc:
+        cancel_shipment(shipment.id, "Too late")
+    assert exc.value.code == "E_INVALID_SHIPMENT_STATUS"
