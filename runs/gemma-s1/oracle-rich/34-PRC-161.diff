diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_rebates.py b/tests/unit/test_rebates.py
--- a/tests/unit/test_rebates.py	1969-12-31 19:00:00
+++ b/tests/unit/test_rebates.py	2026-11-12 01:50:46
@@ -0,0 +1,70 @@
+import pytest
+from parcelo.store import reset, db
+from parcelo.customers import add_customer, rebate_for
+from parcelo.shipments import create_shipment
+from parcelo.invoices import issue_invoice, mark_paid
+from parcelo.money import Money
+from parcelo.errors import DomainError
+
+def test_rebate_for_non_existent_customer():
+    reset()
+    with pytest.raises(DomainError) as exc:
+        rebate_for("non-existent")
+    assert exc.value.code == "E_UNKNOWN_CUSTOMER"
+
+def test_rebate_zero_for_low_volume():
+    reset()
+    c = add_customer("Low Vol")
+    for _ in range(9):
+        s = create_shipment(c.id, 1.0, "local")
+        inv = issue_invoice(s.id)
+        mark_paid(inv.id)
+    
+    rebate = rebate_for(c.id)
+    assert rebate.cents == 0
+
+def test_rebate_low_tier():
+    reset()
+    c = add_customer("Mid Vol")
+    # 10 shipments, each 100.00 paid
+    for _ in range(10):
+        # We can't easily control the quote price, but we know it's positive
+        s = create_shipment(c.id, 1.0, "local")
+        inv = issue_invoice(s.id)
+        mark_paid(inv.id)
+    
+    total_paid_cents = sum(Money.parse(i.amount).cents for i in db.invoices.values())
+    expected_cents = Money(total_paid_cents, "USD").scale(0.03).cents
+    
+    rebate = rebate_for(c.id)
+    assert rebate.cents == expected_cents
+
+def test_rebate_high_tier():
+    reset()
+    c = add_customer("High Vol")
+    for _ in range(50):
+        s = create_shipment(c.id, 1.0, "local")
+        inv = issue_invoice(s.id)
+        mark_paid(inv.id)
+    
+    total_paid_cents = sum(Money.parse(i.amount).cents for i in db.invoices.values())
+    expected_cents = Money(total_paid_cents, "USD").scale(0.06).cents
+    
+    rebate = rebate_for(c.id)
+    assert rebate.cents == expected_cents
+
+def test_rebate_only_counts_paid_invoices():
+    reset()
+    c = add_customer("Mixed")
+    for _ in range(10):
+        s = create_shipment(c.id, 1.0, "local")
+        inv = issue_invoice(s.id)
+        if _ < 5:
+            mark_paid(inv.id)
+    
+    # 10 shipments, but only 5 paid
+    total_paid_cents = sum(Money.parse(i.amount).cents for i in db.invoices.values() if i.status == "paid")
+    expected_cents = Money(total_paid_cents, "USD").scale(0.03).cents
+    
+    rebate = rebate_for(c.id)
+    assert rebate.cents == expected_cents
