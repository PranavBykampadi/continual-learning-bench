+
+def rebate_for(customer_id):
+    if customer_id not in db.customers:
+        raise DomainError("E_UNKNOWN_CUSTOMER", customer_id)
+
+    shipments = [s for s in db.shipments.values() if s.customer_id == customer_id]
+    shipment_count = len(shipments)
+
+    total_paid_cents = 0
+    for invoice in db.invoices.values():
+        shipment = db.shipments[invoice.shipment_id]
+        if shipment.customer_id == customer_id and invoice.status == "paid":
+            # legacy invoice.amount is float, use Money.parse
+            total_paid_cents += Money.parse(invoice.amount).cents
+
+    total_paid = Money(total_paid_cents, "USD")
+
+    if shipment_count >= REBATE_TIER_HIGH:
+        return total_paid.scale(REBATE_RATE_HIGH)
+    if shipment_count >= REBATE_TIER_LOW:
+        return total_paid.scale(REBATE_RATE_LOW)
+
+    return Money(0, "USD")
