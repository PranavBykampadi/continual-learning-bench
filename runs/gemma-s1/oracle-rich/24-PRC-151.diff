@@ -0,0 +1,42 @@
+import pytest
+from parcelo.store import reset
+from parcelo.customers import add_customer
+from parcelo.shipments import create_shipment, list_shipments
+from parcelo.errors import DomainError
+
+def test_list_shipments_success():
+    reset()
+    customer = add_customer("Alice")
+    # Create shipments in random order (ids are generated)
+    s1 = create_shipment(customer.id, 1.0, "local")
+    s2 = create_shipment(customer.id, 2.0, "local")
+    
+    shipments = list_shipments(customer.id)
+    assert len(shipments) == 2
+    assert shipments == sorted([s1, s2], key=lambda s: s.id)
+
+def test_list_shipments_empty():
+    reset()
+    customer = add_customer("Bob")
+    shipments = list_shipments(customer.id)
+    assert shipments == []
+
+def test_list_shipments_unknown_customer():
+    reset()
+    with pytest.raises(DomainError) as exc:
+        list_shipments("non-existent")
+    assert exc.value.code == "E_UNKNOWN_CUSTOMER"
+
+def test_list_shipments_filters_by_customer():
+    reset()
+    c1 = add_customer("C1")
+    c2 = add_customer("C2")
+    
+    create_shipment(c1.id, 1.0, "local")
+    create_shipment(c1.id, 2.0, "local")
+    create_shipment(c2.id, 3.0, "local")
+    
+    shipments_c1 = list_shipments(c1.id)
+    assert len(shipments_c1) == 2
+    for s in shipments_c1:
+        assert s.customer_id == c1.id
