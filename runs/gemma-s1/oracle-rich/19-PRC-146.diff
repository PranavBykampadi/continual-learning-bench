diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_write_off.py b/tests/unit/test_write_off.py
--- a/tests/unit/test_write_off.py	1969-12-31 19:00:00
+++ b/tests/unit/test_write_off.py	2026-11-11 18:07:34
@@ -0,0 +1,52 @@
+import pytest
+from parcelo.store import db
+from parcelo.models import Invoice
+from parcelo.invoices import write_off
+from parcelo.errors import DomainError
+from parcelo.money import Money
+from parcelo.events import OUTBOX
+
+def test_write_off_open_invoice():
+    # Arrange
+    invoice_id = "inv_123"
+    db.invoices[invoice_id] = Invoice(
+        id=invoice_id, 
+        shipment_id="ship_1", 
+        amount=100.50, 
+        status="open"
+    )
+    OUTBOX.clear()
+
+    # Act
+    amount = write_off(invoice_id)
+
+    # Assert
+    invoice = db.invoices[invoice_id]
+    assert invoice.status == "written_off"
+    assert invoice.written_off_at is not None
+    assert amount == Money.parse(100.50)
+    assert len(OUTBOX) == 1
+    assert OUTBOX[0]["name"] == "invoice_written_off"
+    assert OUTBOX[0]["entity_id"] == invoice_id
+    assert OUTBOX[0]["payload"]["amount"] == amount
+
+def test_write_off_non_open_invoice():
+    # Arrange
+    invoice_id = "inv_paid"
+    db.invoices[invoice_id] = Invoice(
+        id=invoice_id, 
+        shipment_id="ship_1", 
+        amount=100.50, 
+        status="paid"
+    )
+
+    # Act & Assert
+    with pytest.raises(DomainError) as exc:
+        write_off(invoice_id)
+    assert exc.value.code == "E_INVOICE_NOT_WRITABLE"
+
+def test_write_off_missing_invoice():
+    # Act & Assert
+    with pytest.raises(DomainError) as exc:
+        write_off("non_existent")
+    assert exc.value.code == "E_NOT_FOUND"
