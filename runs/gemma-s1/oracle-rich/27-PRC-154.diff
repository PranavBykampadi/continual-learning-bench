--- a/tests/unit/test_customers.py	1969-12-31 19:00:00
+++ b/tests/unit/test_customers.py	2026-11-12 01:39:22
@@ -0,0 +1,32 @@
+import pytest
+from parcelo.customers import add_customer, reactivate_customer
+from parcelo.store import reset
+from parcelo.errors import DomainError
+
+def test_reactivate_customer_success():
+    reset()
+    customer = add_customer("Alice")
+    customer.active = False
+    
+    reactivated = reactivate_customer(customer.id)
+    
+    assert reactivated.active is True
+    assert reactivated.id == customer.id
+
+def test_reactivate_customer_idempotency():
+    reset()
+    customer = add_customer("Bob")
+    customer.active = True
+    
+    # Should return unchanged and not crash
+    reactivated = reactivate_customer(customer.id)
+    
+    assert reactivated.active is True
+    assert reactivated.id == customer.id
+
+def test_reactivate_customer_not_found():
+    reset()
+    with pytest.raises(DomainError) as exc:
+        reactivate_customer("non-existent")
+    
+    assert exc.value.code == "E_NOT_FOUND"
