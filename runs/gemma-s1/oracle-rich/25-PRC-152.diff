     if shipment_id not in db.shipments:
         raise DomainError("E_NOT_FOUND", shipment_id)
     return db.shipments[shipment_id]
+
+
+def mark_lost(shipment_id):
+    shipment = get_shipment(shipment_id)
+    if shipment.status == "lost":
+        return shipment
+    if shipment.status == "delivered":
+        raise DomainError("E_SHIPMENT_DELIVERED", shipment_id)
+    shipment.status = "lost"
+    events.emit("shipment.lost", shipment.id)
+    return shipment
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_mark_lost.py b/tests/unit/test_mark_lost.py
--- a/tests/unit/test_mark_lost.py	1969-12-31 19:00:00
+++ b/tests/unit/test_mark_lost.py	2026-11-12 01:36:38
@@ -0,0 +1,42 @@
+import pytest
+from parcelo.shipments import create_shipment, mark_lost
+from parcelo.errors import DomainError
+from parcelo.store import db
+
+def test_mark_lost_success():
+    db.customers.clear()
+    db.shipments.clear()
+    db.customers["c1"] = type("Customer", (), {"id": "c1"})()
+    shp = create_shipment("c1", 1.0, "local")
+    
+    marked = mark_lost(shp.id)
+    assert marked.status == "lost"
+    assert db.shipments[shp.id].status == "lost"
+
+def test_mark_lost_idempotent():
+    db.customers.clear()
+    db.shipments.clear()
+    db.customers["c1"] = type("Customer", (), {"id": "c1"})()
+    shp = create_shipment("c1", 1.0, "local")
+    
+    mark_lost(shp.id)
+    # Second call should return unchanged shipment without error
+    marked = mark_lost(shp.id)
+    assert marked.status == "lost"
+
+def test_mark_lost_not_found():
+    db.shipments.clear()
+    with pytest.raises(DomainError) as exc:
+        mark_lost("non-existent")
+    assert exc.value.code == "E_NOT_FOUND"
+
+def test_mark_lost_already_delivered():
+    db.customers.clear()
+    db.shipments.clear()
+    db.customers["c1"] = type("Customer", (), {"id": "c1"})()
+    shp = create_shipment("c1", 1.0, "local")
+    shp.status = "delivered"
+    
+    with pytest.raises(DomainError) as exc:
+        mark_lost(shp.id)
+    assert exc.value.code == "E_SHIPMENT_DELIVERED"
