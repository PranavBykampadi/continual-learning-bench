+
+def mark_delivered(shipment_id):
+    shipment = get_shipment(shipment_id)
+    if shipment.status in ("delivered", "cancelled"):
+        raise DomainError("E_BAD_STATE", f"Shipment {shipment_id} is {shipment.status}")
+    
+    shipment.status = "delivered"
+    shipment.delivered_at = clock.now()
+    audit.record("shipment.delivered", shipment.id)
+    return shipment
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_mark_delivered.py b/tests/unit/test_mark_delivered.py
--- a/tests/unit/test_mark_delivered.py	1969-12-31 19:00:00
+++ b/tests/unit/test_mark_delivered.py	2026-11-11 17:44:50
@@ -0,0 +1,45 @@
+import pytest
+from parcelo import shipments, store
+from parcelo.errors import DomainError
+
+def test_mark_delivered_success():
+    store.db.customers.clear()
+    store.db.shipments.clear()
+    store.db.customers["c1"] = "customer1"
+    
+    shipment = shipments.create_shipment("c1", 1.0, "local")
+    delivered = shipments.mark_delivered(shipment.id)
+    
+    assert delivered.status == "delivered"
+    assert delivered.delivered_at is not None
+    assert delivered.id == shipment.id
+
+def test_mark_delivered_not_found():
+    store.db.shipments.clear()
+    with pytest.raises(DomainError) as exc:
+        shipments.mark_delivered("non-existent")
+    assert exc.value.code == "E_NOT_FOUND"
+
+def test_mark_delivered_already_delivered():
+    store.db.customers.clear()
+    store.db.shipments.clear()
+    store.db.customers["c1"] = "customer1"
+    
+    shipment = shipments.create_shipment("c1", 1.0, "local")
+    shipments.mark_delivered(shipment.id)
+    
+    with pytest.raises(DomainError) as exc:
+        shipments.mark_delivered(shipment.id)
+    assert exc.value.code == "E_BAD_STATE"
+
+def test_mark_delivered_cancelled():
+    store.db.customers.clear()
+    store.db.shipments.clear()
+    store.db.customers["c1"] = "customer1"
+    
+    shipment = shipments.create_shipment("c1", 1.0, "local")
+    shipment.status = "cancelled"
+    
+    with pytest.raises(DomainError) as exc:
+        shipments.mark_delivered(shipment.id)
+    assert exc.value.code == "E_BAD_STATE"
