+def shipments_without_invoice():
+    invoiced_shipment_ids = {inv.shipment_id for inv in db.invoices.values()}
+    shipments = [
+        shp for shp in db.shipments.values()
+        if shp.id not in invoiced_shipment_ids
+    ]
+    return sorted(shipments, key=lambda x: x.id)
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_reports.py b/tests/unit/test_reports.py
