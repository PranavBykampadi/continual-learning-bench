@@ -0,0 +1,47 @@
+from parcelo.store import db, reset
+from parcelo.reports import shipments_without_invoice
+from parcelo.models import Shipment, Invoice
+
+def test_shipments_without_invoice():
+    reset()
+    
+    # Setup shipments
+    s1 = Shipment(id="shp_1", customer_id="c1", weight_kg=1.0, zone="A")
+    s2 = Shipment(id="shp_2", customer_id="c1", weight_kg=2.0, zone="B")
+    s3 = Shipment(id="shp_3", customer_id="c2", weight_kg=3.0, zone="C")
+    
+    db.shipments[s1.id] = s1
+    db.shipments[s2.id] = s2
+    db.shipments[s3.id] = s3
+    
+    # Case 1: No invoices yet
+    result = shipments_without_invoice()
+    assert result == [s1, s2, s3]
+    
+    # Case 2: Some shipments have invoices
+    inv1 = Invoice(id="inv_1", shipment_id="shp_1", amount=10.0)
+    inv2 = Invoice(id="inv_2", shipment_id="shp_3", amount=30.0)
+    db.invoices[inv1.id] = inv1
+    db.invoices[inv2.id] = inv2
+    
+    result = shipments_without_invoice()
+    assert result == [s2]
+    
+    # Case 3: All shipments have invoices
+    inv3 = Invoice(id="inv_3", shipment_id="shp_2", amount=20.0)
+    db.invoices[inv3.id] = inv3
+    
+    result = shipments_without_invoice()
+    assert result == []
+
+def test_shipments_without_invoice_sorting():
+    reset()
+    s2 = Shipment(id="shp_2", customer_id="c1", weight_kg=2.0, zone="B")
+    s1 = Shipment(id="shp_1", customer_id="c1", weight_kg=1.0, zone="A")
+    
+    # Insert in non-sorted order
+    db.shipments[s2.id] = s2
+    db.shipments[s1.id] = s1
+    
+    result = shipments_without_invoice()
+    assert result == [s1, s2]
