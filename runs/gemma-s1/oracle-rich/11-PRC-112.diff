diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_claims.py b/tests/unit/test_claims.py
--- a/tests/unit/test_claims.py	1969-12-31 19:00:00
+++ b/tests/unit/test_claims.py	2026-11-11 17:56:06
@@ -0,0 +1,63 @@
+import pytest
+from parcelo import store, money, claims, errors
+
+def test_file_claim_success():
+    store.reset()
+    shipment_id = "sh_123"
+    # Mocking shipment object
+    class Shipment:
+        def __init__(self, status):
+            self.status = status
+    
+    store.db.shipments[shipment_id] = Shipment(status="delivered")
+    
+    amount = money.Money.parse("10.00")
+    reason = "Damaged goods"
+    
+    claim = claims.file_claim(shipment_id, amount, reason)
+    
+    assert claim.id.startswith("clm_")
+    assert claim.shipment_id == shipment_id
+    assert claim.amount == amount
+    assert claim.reason == reason
+    assert store.db.claims[claim.id] == claim
+
+def test_file_claim_shipment_not_found():
+    store.reset()
+    amount = money.Money.parse("10.00")
+    with pytest.raises(errors.DomainError) as exc:
+        claims.file_claim("non_existent", amount, "reason")
+    assert exc.value.code == "E_NOT_FOUND"
+
+def test_file_claim_not_delivered():
+    store.reset()
+    shipment_id = "sh_123"
+    class Shipment:
+        def __init__(self, status):
+            self.status = status
+    
+    store.db.shipments[shipment_id] = Shipment(status="pending")
+    
+    amount = money.Money.parse("10.00")
+    with pytest.raises(errors.DomainError) as exc:
+        claims.file_claim(shipment_id, amount, "reason")
+    assert exc.value.code == "E_INVALID_SHIPMENT_STATE"
+
+def test_file_claim_non_positive_amount():
+    store.reset()
+    shipment_id = "sh_123"
+    class Shipment:
+        def __init__(self, status):
+            self.status = status
+    
+    store.db.shipments[shipment_id] = Shipment(status="delivered")
+    
+    amount = money.Money.parse("0.00")
+    with pytest.raises(errors.DomainError) as exc:
+        claims.file_claim(shipment_id, amount, "reason")
+    assert exc.value.code == "E_INVALID_AMOUNT"
+
+    amount_neg = money.Money.parse("-1.00")
+    with pytest.raises(errors.DomainError) as exc:
+        claims.file_claim(shipment_id, amount_neg, "reason")
+    assert exc.value.code == "E_INVALID_AMOUNT"
