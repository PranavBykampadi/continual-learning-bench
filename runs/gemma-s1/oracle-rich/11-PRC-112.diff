diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/parcelo/claims.py b/parcelo/claims.py
--- a/parcelo/claims.py	1969-12-31 19:00:00
+++ b/parcelo/claims.py	2026-11-11 17:55:33
@@ -0,0 +1,37 @@
+from dataclasses import dataclass
+from datetime import datetime
+
+from parcelo import store, clock, ids, errors, audit
+from parcelo.money import Money
+
+@dataclass
+class Claim:
+    id: str
+    shipment_id: str
+    amount: Money
+    reason: str
+    filed_at: datetime
+
+def file_claim(shipment_id: str, amount: Money, reason: str) -> Claim:
+    shipment = store.db.shipments.get(shipment_id)
+    if not shipment:
+        raise errors.DomainError("E_NOT_FOUND", f"Shipment {shipment_id} not found")
+
+    if getattr(shipment, 'status', None) != 'delivered':
+        raise errors.DomainError("E_INVALID_SHIPMENT_STATE", "Only delivered shipments can have claims")
+
+    if amount.cents <= 0:
+        raise errors.DomainError("E_INVALID_AMOUNT", "Claim amount must be positive")
+
+    claim = Claim(
+        id=ids.new_id("clm"),
+        shipment_id=shipment_id,
+        amount=amount,
+        reason=reason,
+        filed_at=clock.now()
+    )
+
+    store.db.claims[claim.id] = claim
+    audit.record("file_claim", claim.id, shipment_id=shipment_id, amount=amount.cents)
+
+    return claim
