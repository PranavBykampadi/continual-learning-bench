 def open_invoices():
     return [i for i in db.invoices.values() if i.status == "open"]
+
+
+def late_fee_for(invoice_id):
+    if invoice_id not in db.invoices:
+        raise DomainError("E_NOT_FOUND", f"Invoice {invoice_id} not found")
+
+    invoice = db.invoices[invoice_id]
+    today = now()
+    days_since_issued = (today - invoice.issued_at).days
+    days_late = days_since_issued - 30
+
+    if days_late <= 0:
+        return Money.zero()
+
+    amount = Money.parse(invoice.amount)
+    # Fee is 1.5% (0.015) per day late
+    return amount.scale(0.015 * days_late)
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_late_fees.py b/tests/unit/test_late_fees.py
--- a/tests/unit/test_late_fees.py	1969-12-31 19:00:00
+++ b/tests/unit/test_late_fees.py	2026-11-11 17:43:24
@@ -0,0 +1,70 @@
+import pytest
+from datetime import datetime, timedelta
+from parcelo.store import db
+from parcelo.clock import set_fixed
+from parcelo.money import Money
+from parcelo.errors import DomainError
+from parcelo.invoices import late_fee_for
+from parcelo.models import Invoice
+
+def test_late_fee_not_found():
+    with pytest.raises(DomainError) as exc:
+        late_fee_for("non-existent")
+    assert exc.value.code == "E_NOT_FOUND"
+
+def test_late_fee_not_late():
+    # Issued today
+    now = datetime(2023, 1, 1)
+    set_fixed(now)
+    
+    db.invoices["inv1"] = Invoice(
+        id="inv1", shipment_id="sh1", amount=100.0, issued_at=now
+    )
+    
+    # 0 days since issued, not late
+    assert late_fee_for("inv1") == Money.zero()
+    
+    # 29 days since issued, still not late
+    set_fixed(now + timedelta(days=29))
+    assert late_fee_for("inv1") == Money.zero()
+
+def test_late_fee_exactly_30_days():
+    now = datetime(2023, 1, 1)
+    set_fixed(now)
+    db.invoices["inv1"] = Invoice(
+        id="inv1", shipment_id="sh1", amount=100.0, issued_at=now
+    )
+    
+    set_fixed(now + timedelta(days=30))
+    assert late_fee_for("inv1") == Money.zero()
+
+def test_late_fee_calculation():
+    now = datetime(2023, 1, 1)
+    set_fixed(now)
+    # 100.00 USD
+    db.invoices["inv1"] = Invoice(
+        id="inv1", shipment_id="sh1", amount=100.0, issued_at=now
+    )
+    
+    # 31 days since issued -> 1 day late
+    # 100 * 0.015 * 1 = 1.50
+    set_fixed(now + timedelta(days=31))
+    assert late_fee_for("inv1") == Money.parse(1.50)
+    
+    # 40 days since issued -> 10 days late
+    # 100 * 0.015 * 10 = 15.00
+    set_fixed(now + timedelta(days=40))
+    assert late_fee_for("inv1") == Money.parse(15.00)
+
+def test_late_fee_rounding():
+    now = datetime(2023, 1, 1)
+    set_fixed(now)
+    # 100.55 USD
+    db.invoices["inv1"] = Invoice(
+        id="inv1", shipment_id="sh1", amount=100.55, issued_at=now
+    )
+    
+    # 31 days since issued -> 1 day late
+    # 100.55 * 0.015 * 1 = 1.50825 -> 1.51
+    set_fixed(now + timedelta(days=31))
+    assert late_fee_for("inv1") == Money.parse(1.51)
