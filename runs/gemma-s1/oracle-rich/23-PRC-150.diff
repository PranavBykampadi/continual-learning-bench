diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_customers.py b/tests/unit/test_customers.py
--- a/tests/unit/test_customers.py	1969-12-31 19:00:00
+++ b/tests/unit/test_customers.py	2026-11-11 18:12:46
@@ -0,0 +1,33 @@
+import pytest
+from parcelo.customers import add_customer, set_credit_limit
+from parcelo.errors import DomainError
+from parcelo.money import Money
+from parcelo.store import db
+from parcelo.events import OUTBOX
+
+def test_set_credit_limit_success():
+    db.customers.clear()
+    OUTBOX.clear()
+    customer = add_customer("Alice")
+    
+    new_limit = set_credit_limit(customer.id, 1000.50)
+    
+    assert new_limit == Money(100050)
+    assert customer.credit_limit == Money(100050)
+    assert len(OUTBOX) == 1
+    assert OUTBOX[0]["name"] == "customer_credit_limit_set"
+    assert OUTBOX[0]["entity_id"] == customer.id
+    assert OUTBOX[0]["payload"]["limit"] == Money(100050)
+
+def test_set_credit_limit_customer_not_found():
+    db.customers.clear()
+    with pytest.raises(DomainError) as exc:
+        set_credit_limit("NONEXISTENT", 100)
+    assert exc.value.code == "E_UNKNOWN_CUSTOMER"
+
+def test_set_credit_limit_negative_amount():
+    db.customers.clear()
+    customer = add_customer("Bob")
+    with pytest.raises(DomainError) as exc:
+        set_credit_limit(customer.id, -10.00)
+    assert exc.value.code == "E_NEGATIVE_AMOUNT"
