+def upgrade_tier(customer_id):
+    customer = db.customers.get(customer_id)
+    if not customer:
+        raise DomainError("E_NOT_FOUND", f"Customer {customer_id} not found")
+    
+    if customer.tier == "gold":
+        raise DomainError("E_ALREADY_GOLD", f"Customer {customer_id} is already gold")
+    
+    customer.tier = "gold"
+    emit("customer_upgraded", customer.id, new_tier="gold")
+    return customer
 
 
