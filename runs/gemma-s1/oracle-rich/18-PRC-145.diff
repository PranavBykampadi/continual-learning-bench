diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_customers.py b/tests/unit/test_customers.py
--- a/tests/unit/test_customers.py	1969-12-31 19:00:00
+++ b/tests/unit/test_customers.py	2026-11-11 18:05:21
@@ -0,0 +1,35 @@
+import pytest
+from parcelo.customers import add_customer, upgrade_tier
+from parcelo.errors import DomainError
+from parcelo.store import db
+from parcelo.events import OUTBOX
+
+def test_upgrade_tier_success():
+    OUTBOX.clear()
+    db.customers.clear()
+    
+    customer = add_customer("Alice")
+    customer_id = customer.id
+    
+    upgraded = upgrade_tier(customer_id)
+    
+    assert upgraded.tier == "gold"
+    assert db.customers[customer_id].tier == "gold"
+    assert len(OUTBOX) == 1
+    assert OUTBOX[0]["name"] == "customer_upgraded"
+    assert OUTBOX[0]["entity_id"] == customer_id
+
+def test_upgrade_tier_not_found():
+    db.customers.clear()
+    with pytest.raises(DomainError) as excinfo:
+        upgrade_tier("nonexistent")
+    assert excinfo.value.code == "E_NOT_FOUND"
+
+def test_upgrade_tier_already_gold():
+    db.customers.clear()
+    customer = add_customer("Bob", tier="gold")
+    customer_id = customer.id
+    
+    with pytest.raises(DomainError) as excinfo:
+        upgrade_tier(customer_id)
+    assert excinfo.value.code == "E_ALREADY_GOLD"
