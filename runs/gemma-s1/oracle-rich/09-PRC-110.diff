+from parcelo.money import Money
+from parcelo.errors import DomainError
+
 ZONE_BASE = {"local": 4.5, "national": 9.0, "international": 24.0}
 PER_KG = 1.25
 
 
 def base_rate(zone):
     if zone not in ZONE_BASE:
-        raise ValueError("unknown zone: %s" % zone)
+        raise DomainError("E_BAD_ZONE", f"unknown zone: {zone}")
     return ZONE_BASE[zone]
 
 
 def quote(weight_kg, zone):
     if weight_kg <= 0:
-        raise ValueError("weight must be positive")
+        raise DomainError("E_BAD_WEIGHT", "weight must be positive")
     return round(base_rate(zone) + PER_KG * weight_kg, 2)
+
+
+def discounted_quote(weight_kg, zone, tier):
+    if tier not in ("standard", "gold"):
+        raise DomainError("E_UNKNOWN_TIER", f"unknown tier: {tier}")
+
+    amount = quote(weight_kg, zone)
+    money_amount = Money.parse(amount)
+
+    if tier == "gold":
+        # 10% discount means multiplying by 0.9
+        # legacy apply_discount uses round(amount * (1 - 10/100), 2)
+        # Money.scale uses ROUND_HALF_UP which matches round(x, 2) behavior for 2 decimal places
+        return money_amount.scale(0.9)
+
+    return money_amount
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_discounted_quote.py b/tests/unit/test_discounted_quote.py
--- a/tests/unit/test_discounted_quote.py	1969-12-31 19:00:00
+++ b/tests/unit/test_discounted_quote.py	2026-11-11 17:52:02
@@ -0,0 +1,31 @@
+import pytest
+from parcelo.rates import discounted_quote
+from parcelo.errors import DomainError
+from parcelo.money import Money
+
+def test_discounted_quote_standard():
+    # weight=10, zone=local -> 4.5 + 1.25*10 = 17.0
+    result = discounted_quote(10, "local", "standard")
+    assert result == Money.parse(17.0)
+
+def test_discounted_quote_gold():
+    # weight=10, zone=local -> 17.0. Gold discount 10% -> 17.0 * 0.9 = 15.3
+    result = discounted_quote(10, "local", "gold")
+    assert result == Money.parse(15.3)
+
+def test_discounted_quote_rounding():
+    # weight=1, zone=local -> 4.5 + 1.25*1 = 5.75
+    # Gold: 5.75 * 0.9 = 5.175. 
+    # round(5.175, 2) usually is 5.18 (ROUND_HALF_UP)
+    result = discounted_quote(1, "local", "gold")
+    assert result == Money.parse(5.18)
+
+def test_discounted_quote_unknown_tier():
+    with pytest.raises(DomainError) as exc:
+        discounted_quote(10, "local", "platinum")
+    assert exc.value.code == "E_UNKNOWN_TIER"
+
+def test_discounted_quote_unknown_zone():
+    with pytest.raises(DomainError) as exc:
+        discounted_quote(10, "mars", "gold")
+    assert exc.value.code == "E_BAD_ZONE"
