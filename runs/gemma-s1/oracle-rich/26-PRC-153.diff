diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_customers_review.py b/tests/unit/test_customers_review.py
--- a/tests/unit/test_customers_review.py	1969-12-31 19:00:00
+++ b/tests/unit/test_customers_review.py	2026-11-12 01:38:26
@@ -0,0 +1,51 @@
+import pytest
+from parcelo.store import db
+from parcelo.customers import add_customer, needs_review
+from parcelo.models import Invoice, Shipment
+from parcelo.errors import DomainError
+
+def setup_function():
+    db.customers.clear()
+    db.invoices.clear()
+    db.shipments.clear()
+
+def create_open_invoice(customer_id, amount):
+    ship_id = f"S{len(db.shipments)+1}"
+    db.shipments[ship_id] = Shipment(id=ship_id, customer_id=customer_id, weight_kg=1.0, zone="A")
+    inv_id = f"I{len(db.invoices)+1}"
+    db.invoices[inv_id] = Invoice(id=inv_id, shipment_id=ship_id, amount=amount, status="open")
+
+def test_needs_review_not_found():
+    with pytest.raises(DomainError) as exc:
+        needs_review("NONEXISTENT")
+    assert exc.value.code == "E_UNKNOWN_CUSTOMER"
+
+def test_needs_review_false_under_limits():
+    cust = add_customer("Alice")
+    create_open_invoice(cust.id, 100.00)
+    create_open_invoice(cust.id, 100.00)
+    assert needs_review(cust.id) is False
+
+def test_needs_review_true_too_many_invoices():
+    cust = add_customer("Bob")
+    for _ in range(4):
+        create_open_invoice(cust.id, 10.00)
+    assert needs_review(cust.id) is True
+
+def test_needs_review_true_too_much_balance():
+    cust = add_customer("Charlie")
+    create_open_invoice(cust.id, 250.01)
+    assert needs_review(cust.id) is True
+
+def test_needs_review_false_at_exact_limits():
+    cust = add_customer("Dave")
+    # 3 open invoices
+    for _ in range(3):
+        create_open_invoice(cust.id, 83.33) # 249.99 total
+    assert needs_review(cust.id) is False
+    
+    # Test exactly 250.00
+    db.invoices.clear()
+    db.shipments.clear()
+    create_open_invoice(cust.id, 250.00)
+    assert needs_review(cust.id) is False
