+
+def needs_review(customer_id):
+    if customer_id not in db.customers:
+        raise DomainError("E_UNKNOWN_CUSTOMER", f"Customer {customer_id} not found")
+
+    open_invoices_count = 0
+    total_cents = 0
+
+    for invoice in db.invoices.values():
+        shipment = db.shipments[invoice.shipment_id]
+        if shipment.customer_id == customer_id and invoice.status == "open":
+            open_invoices_count += 1
+            total_cents += Money.parse(invoice.amount).cents
+
+    if open_invoices_count > REVIEW_MAX_OPEN_INVOICES:
+        return True
+    if total_cents > REVIEW_MAX_OUTSTANDING_BALANCE_CENTS:
+        return True
+    return False
