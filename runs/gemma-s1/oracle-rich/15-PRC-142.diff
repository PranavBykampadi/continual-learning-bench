 def open_invoices():
     return [i for i in db.invoices.values() if i.status == "open"]
+
+
+def reopen_invoice(invoice_id):
+    if invoice_id not in db.invoices:
+        raise DomainError("E_NOT_FOUND", f"Invoice {invoice_id} not found")
+    
+    invoice = db.invoices[invoice_id]
+    if invoice.status != "paid":
+        raise DomainError("E_INVOICE_NOT_PAID", f"Invoice {invoice_id} is not paid")
+    
+    invoice.status = "open"
+    invoice.paid_at = None
+    invoice.reopened_at = now()
+    
+    emit("invoice_reopened", invoice.id)
+    
+    return invoice
