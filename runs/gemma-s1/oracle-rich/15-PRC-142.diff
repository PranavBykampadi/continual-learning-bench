+++ b/tests/unit/test_reopen_invoice.py	2026-11-11 18:01:09
@@ -0,0 +1,29 @@
+import pytest
+from parcelo.store import db
+from parcelo.invoices import mark_paid, reopen_invoice
+from parcelo.models import Invoice
+from parcelo.errors import DomainError
+
+def test_reopen_paid_invoice():
+    inv_id = "INV-123"
+    db.invoices[inv_id] = Invoice(id=inv_id, shipment_id="SHP-1", amount=10.0, status="paid", paid_at="2023-01-01")
+    
+    invoice = reopen_invoice(inv_id)
+    
+    assert invoice.status == "open"
+    assert invoice.paid_at is None
+    assert invoice.reopened_at is not None
+    assert db.invoices[inv_id].status == "open"
+
+def test_reopen_non_existent_invoice():
+    with pytest.raises(DomainError) as excinfo:
+        reopen_invoice("NON-EXISTENT")
+    assert excinfo.value.code == "E_NOT_FOUND"
+
+def test_reopen_unpaid_invoice():
+    inv_id = "INV-456"
+    db.invoices[inv_id] = Invoice(id=inv_id, shipment_id="SHP-2", amount=20.0, status="open")
+    
+    with pytest.raises(DomainError) as excinfo:
+        reopen_invoice(inv_id)
+    assert excinfo.value.code == "E_INVOICE_NOT_PAID"
