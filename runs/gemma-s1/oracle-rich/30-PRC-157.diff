 def open_invoices():
     return [i for i in db.invoices.values() if i.status == "open"]
+
+
+def hold_invoice(invoice_id):
+    if invoice_id not in db.invoices:
+        raise DomainError("E_NOT_FOUND", f"Invoice {invoice_id} not found")
+    
+    invoice = db.invoices[invoice_id]
+    
+    if invoice.status == "on_hold":
+        return invoice
+        
+    if invoice.status != "open":
+        raise DomainError("E_BAD_STATE", f"Invoice {invoice_id} cannot be put on hold from state {invoice.status}")
+    
+    invoice.status = "on_hold"
+    invoice.held_at = now()
+    
+    emit("invoice_held", invoice.id, held_at=invoice.held_at)
+    
+    return invoice
