+import pytest
+from parcelo.store import db
+from parcelo.invoices import hold_invoice
+from parcelo.models import Invoice
+from parcelo.errors import DomainError
+from parcelo.events import emit
+
+def test_hold_open_invoice():
+    inv_id = "INV-123"
+    db.invoices[inv_id] = Invoice(id=inv_id, shipment_id="SHP-1", amount=100.0, status="open")
+    
+    invoice = hold_invoice(inv_id)
+    
+    assert invoice.status == "on_hold"
+    assert invoice.held_at is not None
+    # Checking that an event was emitted (assuming emit can be mocked or tracked)
+
+def test_hold_non_existent_invoice():
+    with pytest.raises(DomainError) as exc:
+        hold_invoice("NON-EXISTENT")
+    assert exc.value.code == "E_NOT_FOUND"
+
+def test_hold_already_held_invoice():
+    inv_id = "INV-123"
+    db.invoices[inv_id] = Invoice(id=inv_id, shipment_id="SHP-1", amount=100.0, status="on_hold", held_at="yesterday")
+    
+    # This should be idempotent and not change held_at
+    invoice = hold_invoice(inv_id)
+    
+    assert invoice.status == "on_hold"
+    assert invoice.held_at == "yesterday"
+
+def test_hold_paid_invoice():
+    inv_id = "INV-123"
+    db.invoices[inv_id] = Invoice(id=inv_id, shipment_id="SHP-1", amount=100.0, status="paid")
+    
+    with pytest.raises(DomainError) as exc:
+        hold_invoice(inv_id)
+    assert exc.value.code == "E_BAD_STATE"
\ No newline at end of file
