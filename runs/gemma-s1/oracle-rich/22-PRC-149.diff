diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/parcelo/shipments.py b/parcelo/shipments.py
--- a/parcelo/shipments.py	2026-11-11 17:34:25
+++ b/parcelo/shipments.py	2026-11-11 18:10:04
@@ -28,3 +28,30 @@
     if shipment_id not in db.shipments:
         raise DomainError("E_NOT_FOUND", shipment_id)
     return db.shipments[shipment_id]
+
+
+def split_shipment(shipment_id, weights):
+    shipment = get_shipment(shipment_id)
+    if shipment.status != "created":
+        raise DomainError("E_BAD_STATE", f"Shipment {shipment_id} is {shipment.status}")
+    
+    if sum(weights) != shipment.weight_kg:
+        raise DomainError("E_BAD_INPUT", "Weights must add up to original shipment weight")
+
+    shipment.status = "split"
+    events.emit("shipment.split", shipment.id)
+
+    new_shipments = []
+    for weight in weights:
+        new_shp = Shipment(
+            id=ids.new_id("shp"),
+            customer_id=shipment.customer_id,
+            weight_kg=weight,
+            zone=shipment.zone,
+            created_at=clock.now(),
+        )
+        db.shipments[new_shp.id] = new_shp
+        events.emit("shipment.created", new_shp.id, zone=new_shp.zone)
+        new_shipments.append(new_shp)
+    
+    return new_shipments
