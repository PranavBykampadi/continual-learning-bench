diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_split_shipment.py b/tests/unit/test_split_shipment.py
--- a/tests/unit/test_split_shipment.py	1969-12-31 19:00:00
+++ b/tests/unit/test_split_shipment.py	2026-11-11 18:11:00
@@ -0,0 +1,41 @@
+import pytest
+from parcelo.store import db, reset
+from parcelo.shipments import create_shipment, split_shipment, get_shipment
+from parcelo.errors import DomainError
+
+@pytest.fixture(autouse=True)
+def clean_db():
+    reset()
+    db.customers["cust_1"] = type('obj', (object,), {'id': 'cust_1'})
+
+def test_split_shipment_success():
+    shp = create_shipment("cust_1", 10.0, "local")
+    weights = [3.0, 7.0]
+    
+    new_shps = split_shipment(shp.id, weights)
+    
+    assert len(new_shps) == 2
+    assert new_shps[0].weight_kg == 3.0
+    assert new_shps[1].weight_kg == 7.0
+    assert new_shps[0].customer_id == shp.customer_id
+    assert new_shps[0].zone == shp.zone
+    assert shp.status == "split"
+    assert get_shipment(new_shps[0].id).status == "created"
+
+def test_split_shipment_not_found():
+    with pytest.raises(DomainError) as exc:
+        split_shipment("nonexistent", [5.0])
+    assert exc.value.code == "E_NOT_FOUND"
+
+def test_split_shipment_wrong_status():
+    shp = create_shipment("cust_1", 10.0, "local")
+    shp.status = "delivered"
+    with pytest.raises(DomainError) as exc:
+        split_shipment(shp.id, [5.0, 5.0])
+    assert exc.value.code == "E_BAD_STATE"
+
+def test_split_shipment_weight_mismatch():
+    shp = create_shipment("cust_1", 10.0, "local")
+    with pytest.raises(DomainError) as exc:
+        split_shipment(shp.id, [5.0, 4.0])
+    assert exc.value.code == "E_BAD_INPUT"
