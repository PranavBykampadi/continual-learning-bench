+def customers_by_tier(tier):
+    if tier not in TIERS:
+        raise DomainError("E_INVALID_TIER", f"Tier {tier} is not recognized")
+    
+    customers = [c for c in db.customers.values() if c.tier == tier]
+    return sorted(customers, key=lambda c: c.id)
