+++ b/tests/unit/test_customers_by_tier.py	2026-11-12 01:40:21
@@ -0,0 +1,30 @@
+from parcelo.store import db, reset
+from parcelo.customers import add_customer, customers_by_tier
+from parcelo.errors import DomainError
+import pytest
+
+def test_customers_by_tier_returns_matching_customers_sorted():
+    reset()
+    # Creating customers in non-sorted order to verify sorting
+    # add_customer uses random IDs, so we will manually set them for predictability
+    # but the helper function doesn't allow that. We'll just create several.
+    c1 = add_customer("Alice", "gold")
+    c2 = add_customer("Bob", "gold")
+    c3 = add_customer("Charlie", "standard")
+    
+    gold_customers = customers_by_tier("gold")
+    assert len(gold_customers) == 2
+    assert gold_customers == sorted(gold_customers, key=lambda c: c.id)
+    assert all(c.tier == "gold" for c in gold_customers)
+
+def test_customers_by_tier_returns_empty_list_when_none_match():
+    reset()
+    add_customer("Alice", "standard")
+    gold_customers = customers_by_tier("gold")
+    assert gold_customers == []
+
+def test_customers_by_tier_raises_domain_error_for_invalid_tier():
+    reset()
+    with pytest.raises(DomainError) as excinfo:
+        customers_by_tier("platinum")
+    assert excinfo.value.code == "E_INVALID_TIER"
\ No newline at end of file
