diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_shipment_notes.py b/tests/unit/test_shipment_notes.py
--- a/tests/unit/test_shipment_notes.py	1969-12-31 19:00:00
+++ b/tests/unit/test_shipment_notes.py	2026-11-11 17:54:33
@@ -0,0 +1,47 @@
+import pytest
+from parcelo.shipments import create_shipment, add_note, get_shipment
+from parcelo.errors import DomainError
+from parcelo.store import db
+from parcelo import clock
+from parcelo.models import Customer
+from parcelo.rates import ZONE_BASE
+
+def test_add_note_success():
+    db.customers["cust_1"] = Customer(id="cust_1", name="Test")
+    zone = list(ZONE_BASE.keys())[0]
+    shp = create_shipment("cust_1", 1.0, zone)
+    
+    note_text = "Test note"
+    result = add_note(shp.id, note_text)
+    
+    assert result.id == shp.id
+    assert len(result.notes) == 1
+    assert result.notes[0]["text"] == note_text
+    assert result.notes[0]["at"] is not None
+
+def test_add_note_not_found():
+    with pytest.raises(DomainError) as exc:
+        add_note("non_existent", "Hello")
+    assert exc.value.code == "E_NOT_FOUND"
+
+def test_add_note_empty_text():
+    db.customers["cust_2"] = Customer(id="cust_2", name="Test")
+    zone = list(ZONE_BASE.keys())[0]
+    shp = create_shipment("cust_2", 1.0, zone)
+    
+    with pytest.raises(DomainError) as exc:
+        add_note(shp.id, "")
+    assert exc.value.code == "E_EMPTY_NOTE"
+
+def test_add_note_persistence():
+    db.customers["cust_3"] = Customer(id="cust_3", name="Test")
+    zone = list(ZONE_BASE.keys())[0]
+    shp = create_shipment("cust_3", 1.0, zone)
+    
+    add_note(shp.id, "First note")
+    add_note(shp.id, "Second note")
+    
+    updated_shp = get_shipment(shp.id)
+    assert len(updated_shp.notes) == 2
+    assert updated_shp.notes[0]["text"] == "First note"
+    assert updated_shp.notes[1]["text"] == "Second note"
