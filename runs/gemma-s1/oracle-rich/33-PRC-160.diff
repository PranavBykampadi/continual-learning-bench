@@ -28,3 +28,15 @@
     if shipment_id not in db.shipments:
         raise DomainError("E_NOT_FOUND", shipment_id)
     return db.shipments[shipment_id]
+
+
+def mark_returned(shipment_id):
+    shipment = get_shipment(shipment_id)
+    if shipment.status == "returned":
+        return shipment
+    if shipment.status == "created":
+        raise DomainError("E_BAD_STATE", shipment_id)
+    shipment.status = "returned"
+    shipment.returned_at = clock.now()
+    events.emit("shipment.returned", shipment.id)
+    return shipment
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_mark_returned.py b/tests/unit/test_mark_returned.py
--- a/tests/unit/test_mark_returned.py	1969-12-31 19:00:00
+++ b/tests/unit/test_mark_returned.py	2026-11-12 01:47:27
@@ -0,0 +1,53 @@
+import pytest
+from parcelo.shipments import create_shipment, mark_returned
+from parcelo.errors import DomainError
+from parcelo.store import db
+from parcelo import clock
+
+def test_mark_returned_success():
+    db.customers.clear()
+    db.shipments.clear()
+    db.customers["cust_1"] = "Customer 1"
+    
+    shipment = create_shipment("cust_1", 1.0, "local")
+    shipment.status = "delivered" # Manually set to simulate progression
+    
+    returned = mark_returned(shipment.id)
+    
+    assert returned.status == "returned"
+    assert returned.returned_at is not None
+    assert returned.id == shipment.id
+
+def test_mark_returned_idempotency():
+    db.customers.clear()
+    db.shipments.clear()
+    db.customers["cust_1"] = "Customer 1"
+    
+    shipment = create_shipment("cust_1", 1.0, "local")
+    shipment.status = "delivered"
+    
+    mark_returned(shipment.id)
+    timestamp = shipment.returned_at
+    
+    # Second call should be idempotent
+    returned = mark_returned(shipment.id)
+    assert returned.status == "returned"
+    assert returned.returned_at == timestamp
+
+def test_mark_returned_fails_if_created():
+    db.customers.clear()
+    db.shipments.clear()
+    db.customers["cust_1"] = "Customer 1"
+    
+    shipment = create_shipment("cust_1", 1.0, "local")
+    # shipment.status is "created" by default
+    
+    with pytest.raises(DomainError) as excinfo:
+        mark_returned(shipment.id)
+    assert excinfo.value.code == "E_BAD_STATE"
+
+def test_mark_returned_fails_if_not_found():
+    db.shipments.clear()
+    with pytest.raises(DomainError) as excinfo:
+        mark_returned("non_existent")
+    assert excinfo.value.code == "E_NOT_FOUND"
