+def invoices_by_status(status):
+    if status not in VALID_INVOICE_STATUSES:
+        raise DomainError("E_BAD_INPUT", f"Invalid status: {status}")
+    
+    invoices = [i for i in db.invoices.values() if i.status == status]
+    return sorted(invoices, key=lambda i: i.id)
