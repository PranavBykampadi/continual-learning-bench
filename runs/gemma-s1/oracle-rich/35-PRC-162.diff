diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_invoices_by_status.py b/tests/unit/test_invoices_by_status.py
--- a/tests/unit/test_invoices_by_status.py	1969-12-31 19:00:00
+++ b/tests/unit/test_invoices_by_status.py	2026-11-12 01:51:55
@@ -0,0 +1,40 @@
+from parcelo.store import db
+from parcelo.models import Invoice
+from parcelo.invoices import invoices_by_status
+from parcelo.errors import DomainError
+import pytest
+
+def test_invoices_by_status_filters_correctly():
+    db.invoices.clear()
+    inv1 = Invoice(id="INV-1", shipment_id="S1", amount=100, status="open")
+    inv2 = Invoice(id="INV-2", shipment_id="S2", amount=200, status="paid")
+    inv3 = Invoice(id="INV-3", shipment_id="S3", amount=300, status="open")
+    db.invoices = {inv.id: inv for inv in [inv1, inv2, inv3]}
+
+    open_invoices = invoices_by_status("open")
+    assert open_invoices == [inv1, inv3]
+    
+    paid_invoices = invoices_by_status("paid")
+    assert paid_invoices == [inv2]
+
+def test_invoices_by_status_returns_sorted_by_id():
+    db.invoices.clear()
+    inv1 = Invoice(id="INV-1", shipment_id="S1", amount=100, status="open")
+    inv2 = Invoice(id="INV-2", shipment_id="S2", amount=200, status="open")
+    # Store in reverse order
+    db.invoices = {"INV-2": inv2, "INV-1": inv1}
+
+    result = invoices_by_status("open")
+    assert result == [inv1, inv2]
+
+def test_invoices_by_status_empty_list_when_none_found():
+    db.invoices.clear()
+    inv1 = Invoice(id="INV-1", shipment_id="S1", amount=100, status="paid")
+    db.invoices = {"INV-1": inv1}
+
+    assert invoices_by_status("open") == []
+
+def test_invoices_by_status_raises_domain_error_for_invalid_status():
+    with pytest.raises(DomainError) as excinfo:
+        invoices_by_status("cancelled")
+    assert excinfo.value.code == "E_BAD_INPUT"
