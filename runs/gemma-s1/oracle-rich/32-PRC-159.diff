@@ -0,0 +1,37 @@
+import pytest
+from parcelo.shipments import create_shipment, shipments_in_zone
+from parcelo.errors import DomainError
+from parcelo.store import db
+
+def test_shipments_in_zone_filters_correctly():
+    db.customers.clear()
+    db.shipments.clear()
+    db.customers["cust_1"] = "Customer 1"
+    
+    # Create shipments in different zones
+    # Using explicit IDs to test sorting if possible, 
+    # but create_shipment uses ids.new_id. 
+    # We can just verify the result is sorted by id.
+    s1 = create_shipment("cust_1", 1.0, "local")
+    s2 = create_shipment("cust_1", 2.0, "national")
+    s3 = create_shipment("cust_1", 3.0, "local")
+    
+    local_shipments = shipments_in_zone("local")
+    assert len(local_shipments) == 2
+    assert set(s.id for s in local_shipments) == {s1.id, s3.id}
+    assert local_shipments == sorted(local_shipments, key=lambda s: s.id)
+
+def test_shipments_in_zone_empty_result():
+    db.customers.clear()
+    db.shipments.clear()
+    db.customers["cust_1"] = "Customer 1"
+    
+    create_shipment("cust_1", 1.0, "national")
+    
+    local_shipments = shipments_in_zone("local")
+    assert local_shipments == []
+
+def test_shipments_in_zone_invalid_zone():
+    with pytest.raises(DomainError) as exc:
+        shipments_in_zone("mars")
+    assert exc.value.code == "E_BAD_ZONE"
