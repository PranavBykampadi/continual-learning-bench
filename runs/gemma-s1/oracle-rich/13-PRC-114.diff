+
+
+def aging_report():
+    today = now()
+    buckets = {
+        "0-30": Money.zero(),
+        "31-60": Money.zero(),
+        "60+": Money.zero(),
+    }
+
+    for invoice in db.invoices.values():
+        if invoice.status != "open":
+            continue
+
+        age = (today - invoice.issued_at).days
+        amount = Money.parse(invoice.amount)
+
+        if age <= 30:
+            buckets["0-30"] += amount
+        elif age <= 60:
+            buckets["31-60"] += amount
+        else:
+            buckets["60+"] += amount
+
+    return buckets
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_aging_report.py b/tests/unit/test_aging_report.py
--- a/tests/unit/test_aging_report.py	1969-12-31 19:00:00
+++ b/tests/unit/test_aging_report.py	2026-11-11 17:58:17
@@ -0,0 +1,49 @@
+from datetime import datetime, timezone, timedelta
+from parcelo.clock import set_fixed
+from parcelo.money import Money
+from parcelo.models import Invoice
+from parcelo.reports import aging_report
+from parcelo.store import db, reset
+
+
+def test_aging_report_buckets():
+    reset()
+    now_date = datetime(2023, 10, 1, tzinfo=timezone.utc)
+    set_fixed(now_date)
+
+    # 0-30 days: issued 10 days ago
+    db.invoices["INV-1"] = Invoice(
+        id="INV-1", shipment_id="S1", amount=100.0, 
+        status="open", issued_at=now_date - timedelta(days=10)
+    )
+    # 31-60 days: issued 45 days ago
+    db.invoices["INV-2"] = Invoice(
+        id="INV-2", shipment_id="S2", amount=200.0, 
+        status="open", issued_at=now_date - timedelta(days=45)
+    )
+    # 60+ days: issued 70 days ago
+    db.invoices["INV-3"] = Invoice(
+        id="INV-3", shipment_id="S3", amount=300.0, 
+        status="open", issued_at=now_date - timedelta(days=70)
+    )
+    # Paid invoice: should be ignored
+    db.invoices["INV-4"] = Invoice(
+        id="INV-4", shipment_id="S4", amount=400.0, 
+        status="paid", issued_at=now_date - timedelta(days=5)
+    )
+
+    report = aging_report()
+    
+    assert report["0-30"] == Money.parse(100.0)
+    assert report["31-60"] == Money.parse(200.0)
+    assert report["60+"] == Money.parse(300.0)
+
+def test_aging_report_empty():
+    reset()
+    set_fixed(datetime(2023, 10, 1, tzinfo=timezone.utc))
+    
+    report = aging_report()
+    
+    assert report["0-30"] == Money.zero()
+    assert report["31-60"] == Money.zero()
+    assert report["60+"] == Money.zero()
