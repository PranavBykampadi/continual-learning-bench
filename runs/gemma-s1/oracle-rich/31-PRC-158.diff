diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/parcelo/returns.py b/parcelo/returns.py
--- a/parcelo/returns.py	1969-12-31 19:00:00
+++ b/parcelo/returns.py	2026-11-12 01:43:29
@@ -0,0 +1,35 @@
+from parcelo import clock, events, ids
+from parcelo.errors import DomainError
+from parcelo.models import ReturnRequest
+from parcelo.store import db
+from parcelo.settings import MAX_RETURN_REQUESTS_PER_SHIPMENT
+
+
+def request_return(shipment_id, reason):
+    if shipment_id not in db.shipments:
+        raise DomainError("E_NOT_FOUND", shipment_id)
+
+    shipment = db.shipments[shipment_id]
+    if shipment.status != "delivered":
+        raise DomainError("E_BAD_STATE", f"Shipment {shipment_id} is not delivered")
+
+    existing_returns = returns_for(shipment_id)
+    if len(existing_returns) >= MAX_RETURN_REQUESTS_PER_SHIPMENT:
+        raise DomainError("E_LIMIT", f"Maximum of {MAX_RETURN_REQUESTS_PER_SHIPMENT} return requests reached")
+
+    return_req = ReturnRequest(
+        id=ids.new_id("ret"),
+        shipment_id=shipment_id,
+        reason=reason,
+        requested_at=clock.now(),
+    )
+    db.returns[return_req.id] = return_req
+    events.emit("return.requested", return_req.id, shipment_id=shipment_id)
+    return return_req
+
+
+def returns_for(shipment_id):
+    results = [
+        r for r in db.returns.values() if r.shipment_id == shipment_id
+    ]
+    return sorted(results, key=lambda r: r.id)
