+import pytest
+from parcelo import store, shipments, returns
+from parcelo.errors import DomainError
+
+def test_request_return_success():
+    store.reset()
+    store.db.customers["cust_1"] = type('Obj', (), {'id': 'cust_1'})()
+    shipment = shipments.create_shipment("cust_1", 1.0, "local")
+    shipment.status = "delivered"
+    
+    req = returns.request_return(shipment.id, "damaged")
+    assert req.shipment_id == shipment.id
+    assert req.reason == "damaged"
+    assert len(returns.returns_for(shipment.id)) == 1
+
+def test_request_return_not_found():
+    store.reset()
+    with pytest.raises(DomainError) as exc:
+        returns.request_return("nonexistent", "reason")
+    assert exc.value.code == "E_NOT_FOUND"
+
+def test_request_return_not_delivered():
+    store.reset()
+    store.db.customers["cust_1"] = type('Obj', (), {'id': 'cust_1'})()
+    shipment = shipments.create_shipment("cust_1", 1.0, "local")
+    # status is "created", not "delivered"
+    with pytest.raises(DomainError) as exc:
+        returns.request_return(shipment.id, "reason")
+    assert exc.value.code == "E_BAD_STATE"
+
+def test_request_return_limit():
+    store.reset()
+    store.db.customers["cust_1"] = type('Obj', (), {'id': 'cust_1'})()
+    shipment = shipments.create_shipment("cust_1", 1.0, "local")
+    shipment.status = "delivered"
+    
+    for i in range(3):
+        returns.request_return(shipment.id, f"reason {i}")
+    
+    with pytest.raises(DomainError) as exc:
+        returns.request_return(shipment.id, "reason 4")
+    assert exc.value.code == "E_LIMIT"
+
