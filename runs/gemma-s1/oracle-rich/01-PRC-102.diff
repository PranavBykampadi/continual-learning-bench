 def open_invoices():
     return [i for i in db.invoices.values() if i.status == "open"]
+
+
+def void_invoice(invoice_id):
+    if invoice_id not in db.invoices:
+        raise DomainError("E_NOT_FOUND", f"Invoice {invoice_id} not found")
+    
+    invoice = db.invoices[invoice_id]
+    
+    if invoice.status in ("paid", "void"):
+        raise DomainError("E_INVALID_INVOICE_STATE", f"Cannot void invoice in status {invoice.status}")
+    
+    invoice.status = "void"
+    invoice.voided_at = now()
+    
+    record("void_invoice", invoice.id)
+    
+    return invoice
