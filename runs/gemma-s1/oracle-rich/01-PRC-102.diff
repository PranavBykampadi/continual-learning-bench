diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_void_invoice.py b/tests/unit/test_void_invoice.py
--- a/tests/unit/test_void_invoice.py	1969-12-31 19:00:00
+++ b/tests/unit/test_void_invoice.py	2026-11-11 17:37:44
@@ -0,0 +1,43 @@
+import pytest
+from parcelo.store import db
+from parcelo.invoices import void_invoice, issue_invoice
+from parcelo.errors import DomainError
+from parcelo.models import Shipment, Invoice
+
+def test_void_invoice_success():
+    db.shipments.clear()
+    db.invoices.clear()
+    
+    shipment_id = "sh_1"
+    db.shipments[shipment_id] = Shipment(id=shipment_id, customer_id="c1", weight_kg=1.0, zone="local")
+    invoice = issue_invoice(shipment_id)
+    
+    voided = void_invoice(invoice.id)
+    
+    assert voided.status == "void"
+    assert voided.voided_at is not None
+    assert db.invoices[invoice.id].status == "void"
+
+def test_void_non_existent_invoice():
+    db.invoices.clear()
+    with pytest.raises(DomainError) as excinfo:
+        void_invoice("non_existent")
+    assert excinfo.value.code == "E_NOT_FOUND"
+
+def test_void_already_paid_invoice():
+    db.invoices.clear()
+    inv_id = "inv_paid"
+    db.invoices[inv_id] = Invoice(id=inv_id, shipment_id="s1", amount=10.0, status="paid")
+    
+    with pytest.raises(DomainError) as excinfo:
+        void_invoice(inv_id)
+    assert excinfo.value.code == "E_INVALID_INVOICE_STATE"
+
+def test_void_already_voided_invoice():
+    db.invoices.clear()
+    inv_id = "inv_void"
+    db.invoices[inv_id] = Invoice(id=inv_id, shipment_id="s1", amount=10.0, status="void")
+    
+    with pytest.raises(DomainError) as excinfo:
+        void_invoice(inv_id)
+    assert excinfo.value.code == "E_INVALID_INVOICE_STATE"
