diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_pickups.py b/tests/unit/test_pickups.py
--- a/tests/unit/test_pickups.py	1969-12-31 19:00:00
+++ b/tests/unit/test_pickups.py	2026-11-11 18:03:36
@@ -0,0 +1,35 @@
+import pytest
+from parcelo import store, shipments
+from parcelo.pickups import schedule_pickup
+from parcelo.errors import DomainError
+
+def test_schedule_pickup_success():
+    store.reset()
+    from parcelo.models import Customer
+    store.db.customers["c1"] = Customer(id="c1", name="Test")
+    shp = shipments.create_shipment("c1", 1.0, "local")
+    
+    window_start = "2023-10-27T10:00:00"
+    pickup = schedule_pickup(shp.id, window_start)
+    
+    assert pickup.id.startswith("pck")
+    assert pickup.shipment_id == shp.id
+    assert pickup.window_start == window_start
+    assert store.db.pickups[pickup.id] == pickup
+
+def test_schedule_pickup_not_found():
+    store.reset()
+    with pytest.raises(DomainError) as exc:
+        schedule_pickup("nonexistent", "2023-10-27T10:00:00")
+    assert exc.value.code == "E_NOT_FOUND"
+
+def test_schedule_pickup_bad_state():
+    store.reset()
+    from parcelo.models import Customer
+    store.db.customers["c1"] = Customer(id="c1", name="Test")
+    shp = shipments.create_shipment("c1", 1.0, "local")
+    shp.status = "shipped"
+    
+    with pytest.raises(DomainError) as exc:
+        schedule_pickup(shp.id, "2023-10-27T10:00:00")
+    assert exc.value.code == "E_BAD_STATE"
