diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/parcelo/disputes.py b/parcelo/disputes.py
--- a/parcelo/disputes.py	1969-12-31 19:00:00
+++ b/parcelo/disputes.py	2026-11-11 17:47:59
@@ -0,0 +1,21 @@
+from parcelo.models import Dispute
+from parcelo.store import db
+from parcelo.ids import next_id
+from parcelo.clock import now
+
+
+def open_dispute(invoice_id: str, reason: str) -> Dispute:
+    if not reason:
+        raise ValueError("Reason is required")
+
+    if invoice_id not in db.invoices:
+        raise ValueError("Invoice not found")
+
+    dispute = Dispute(
+        id=next_id(),
+        invoice_id=invoice_id,
+        reason=reason,
+        opened_at=now(),
+    )
+    db.disputes[dispute.id] = dispute
+    return dispute
\ No newline at end of file
