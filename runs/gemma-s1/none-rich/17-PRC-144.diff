+def insurance_fee(declared_value, zone):
+    if declared_value <= 0:
+        raise ValueError("declared value must be positive")
+    
+    fuel_pcts = {"local": 0.0, "national": 4.0, "international": 9.5}
+    if zone not in fuel_pcts:
+        raise ValueError("unknown zone: %s" % zone)
+    
+    fee = (declared_value * 0.02) + (declared_value * fuel_pcts[zone] / 100.0)
+    return max(1.00, round(fee, 2))
