+def quote_with_surcharge(weight_kg, zone):
+    # Use the same surcharge percentages as in legacy billing
+    surcharge_pcts = {"local": 0.0, "national": 4.0, "international": 9.5}
+    if zone not in surcharge_pcts:
+        raise ValueError("unknown zone: %s" % zone)
+
+    amount = quote(weight_kg, zone)
+    surcharge = round(amount * surcharge_pcts[zone] / 100.0, 2)
+    return round(amount + surcharge, 2)
