--- a/parcelo/vouchers.py	1969-12-31 19:00:00
+++ b/parcelo/vouchers.py	2026-11-12 01:44:13
@@ -0,0 +1,24 @@
+import uuid
+from datetime import datetime
+from parcelo.models import Voucher
+from parcelo.store import db
+from parcelo.customers import get_customer
+
+def issue_voucher(customer_id, amount):
+    if amount <= 0:
+        raise ValueError("voucher amount must be positive")
+    if amount > 150.00:
+        raise ValueError("voucher amount cannot exceed 150.00")
+    
+    # This will raise KeyError if customer doesn't exist, 
+    # which effectively fails the operation as requested.
+    get_customer(customer_id)
+    
+    voucher = Voucher(
+        id="V" + uuid.uuid4().hex[:6],
+        customer_id=customer_id,
+        amount=amount,
+        issued_at=datetime.now()
+    )
+    db.vouchers[voucher.id] = voucher
+    return voucher
