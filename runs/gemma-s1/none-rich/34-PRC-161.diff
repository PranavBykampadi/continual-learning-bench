+def rebate_for(customer_id):
+    if customer_id not in db.customers:
+        raise KeyError(f"Customer {customer_id} not found")
+
+    shipment_count = 0
+    total_paid = 0.0
+
+    for shipment in db.shipments.values():
+        if shipment.customer_id == customer_id:
+            shipment_count += 1
+
+    for invoice in db.invoices.values():
+        shipment = db.shipments[invoice.shipment_id]
+        if shipment.customer_id == customer_id and invoice.status == "paid":
+            total_paid += invoice.amount
+
+    if shipment_count >= 50:
+        rate = 0.06
+    elif shipment_count >= 10:
+        rate = 0.03
+    else:
+        rate = 0.0
+
+    return round(total_paid * rate, 2)
