+def aging_report():
+    report = {"0-30": 0.0, "31-60": 0.0, "60+": 0.0}
+    for invoice in db.invoices.values():
+        if invoice.status != "open":
+            continue
+        
+        age = days_between(invoice.issued_at)
+        if age <= 30:
+            report["0-30"] += invoice.amount
+        elif age <= 60:
+            report["31-60"] += invoice.amount
+        else:
+            report["60+"] += invoice.amount
+            
+    return report
