+def quote_with_surcharge(weight_kg, zone):
+    # Fuel surcharge percentages from parcelo/legacy/billing.py
+    surcharges = {"local": 0.0, "national": 4.0, "international": 9.5}
+    
+    if zone not in surcharges:
+        raise ValueError("unknown zone: %s" % zone)
+        
+    amount = quote(weight_kg, zone)
+    pct = surcharges[zone]
+    surcharge_amount = round(amount * pct / 100.0, 2)
+    
+    return round(amount + surcharge_amount, 2)
