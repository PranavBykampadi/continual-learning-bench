--- a/parcelo/vouchers.py	1969-12-31 19:00:00
+++ b/parcelo/vouchers.py	2026-11-12 04:39:16
@@ -0,0 +1,28 @@
+from decimal import Decimal
+from datetime import datetime
+from .models import Voucher
+from .store import db
+from .ids import next_id
+from .customers import get_customer
+
+def issue_voucher(customer_id, amount):
+    amount = Decimal(str(amount))
+    
+    if amount <= 0:
+        raise ValueError("Voucher amount must be positive")
+    if amount > 150:
+        raise ValueError("Voucher amount cannot exceed 150.00")
+    
+    customer = get_customer(customer_id)
+    if customer is None:
+        raise ValueError("Customer does not exist")
+    
+    voucher = Voucher(
+        id=next_id(),
+        customer_id=customer_id,
+        amount=amount,
+        issued_at=datetime.now()
+    )
+    
+    db.vouchers[voucher.id] = voucher
+    return voucher
