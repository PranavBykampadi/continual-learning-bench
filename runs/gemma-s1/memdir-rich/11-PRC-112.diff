diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/parcelo/claims.py b/parcelo/claims.py
--- a/parcelo/claims.py	1969-12-31 19:00:00
+++ b/parcelo/claims.py	2026-11-12 04:20:44
@@ -0,0 +1,24 @@
+from parcelo.store import db
+from parcelo.models import Claim
+from parcelo.ids import next_id
+from parcelo.clock import now
+
+
+def file_claim(shipment_id: str, amount: float, reason: str) -> Claim:
+    shipment = db.shipments.get(shipment_id)
+    if shipment is None:
+        raise ValueError("Shipment not found")
+    if shipment.status != "delivered":
+        raise ValueError("Only delivered shipments can have claims")
+    if amount <= 0:
+        raise ValueError("Amount must be positive")
+
+    claim = Claim(
+        id=next_id(),
+        shipment_id=shipment_id,
+        amount=amount,
+        reason=reason,
+        filed_at=now(),
+    )
+    db.claims[claim.id] = claim
+    return claim
\ No newline at end of file
