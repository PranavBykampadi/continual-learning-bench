+def insurance_fee(declared_value, zone):
+    if declared_value <= 0:
+        raise ValueError("declared value must be positive")
+    
+    surcharges = {"local": 0.0, "national": 4.0, "international": 9.5}
+    if zone not in surcharges:
+        raise ValueError("unknown zone: %s" % zone)
+    
+    pct = surcharges[zone]
+    fee = (declared_value * 0.02) + (declared_value * pct / 100.0)
+    return max(1.0, round(fee, 2))
