diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_customers.py b/tests/unit/test_customers.py
--- a/tests/unit/test_customers.py	1969-12-31 19:00:00
+++ b/tests/unit/test_customers.py	2026-11-12 04:25:24
@@ -0,0 +1,23 @@
+from parcelo.customers import add_customer, upgrade_tier, get_customer
+from parcelo.store import db
+from parcelo.errors import DomainError
+import pytest
+
+def test_upgrade_tier_success():
+    db.customers.clear()
+    c = add_customer("Test User", tier="standard")
+    upgraded = upgrade_tier(c.id)
+    assert upgraded.tier == "gold"
+    assert get_customer(c.id).tier == "gold"
+
+def test_upgrade_tier_already_gold():
+    db.customers.clear()
+    c = add_customer("Gold User", tier="gold")
+    with pytest.raises(DomainError) as excinfo:
+        upgrade_tier(c.id)
+    assert excinfo.value.code == "E_BAD_INPUT"
+
+def test_upgrade_tier_non_existent():
+    db.customers.clear()
+    with pytest.raises(KeyError):
+        upgrade_tier("NONEXISTENT")
