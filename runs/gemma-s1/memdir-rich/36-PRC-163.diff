+++ b/tests/test_lock_customer.py	2026-11-12 04:38:35
@@ -0,0 +1,14 @@
+import pytest
+from parcelo.customers import add_customer, lock_customer
+
+def test_lock_customer():
+    customer = add_customer("Test User")
+    assert customer.locked is False
+    
+    locked_customer = lock_customer(customer.id)
+    assert locked_customer.locked is True
+    assert customer.locked is True
+
+def test_lock_non_existent_customer():
+    with pytest.raises(KeyError):
+        lock_customer("non-existent-id")
