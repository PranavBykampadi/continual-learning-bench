diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/parcelo/shipments.py b/parcelo/shipments.py
--- a/parcelo/shipments.py	2026-11-10 12:20:18
+++ b/parcelo/shipments.py	2026-11-12 04:28:07
@@ -28,3 +28,28 @@
     if shipment_id not in db.shipments:
         raise DomainError("E_NOT_FOUND", shipment_id)
     return db.shipments[shipment_id]
+
+
+def split_shipment(shipment_id, weights):
+    shipment = get_shipment(shipment_id)
+    if shipment.status != "created":
+        raise DomainError("E_INVALID_STATUS", shipment.status)
+    if sum(weights) != shipment.weight_kg:
+        raise DomainError("E_WEIGHT_MISMATCH", f"Expected {shipment.weight_kg}, got {sum(weights)}")
+
+    shipment.status = "split"
+    
+    new_shipments = []
+    for weight in weights:
+        new_shp = Shipment(
+            id=ids.new_id("shp"),
+            customer_id=shipment.customer_id,
+            weight_kg=weight,
+            zone=shipment.zone,
+            created_at=clock.now(),
+        )
+        db.shipments[new_shp.id] = new_shp
+        events.emit("shipment.created", new_shp.id, zone=new_shp.zone)
+        new_shipments.append(new_shp)
+        
+    return new_shipments
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_shipments.py b/tests/unit/test_shipments.py
--- a/tests/unit/test_shipments.py	2026-11-10 12:20:18
+++ b/tests/unit/test_shipments.py	2026-11-12 04:28:30
@@ -15,3 +15,38 @@
     with pytest.raises(DomainError) as err:
         shipments.create_shipment("nope", 1, "local")
     assert err.value.code == "E_UNKNOWN_CUSTOMER"
+
+def test_split_shipment_success():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 10.0, "national")
+    
+    weights = [3.0, 3.0, 4.0]
+    new_shps = shipments.split_shipment(s.id, weights)
+    
+    assert len(new_shps) == 3
+    assert s.status == "split"
+    assert [shp.weight_kg for shp in new_shps] == weights
+    assert all(shp.customer_id == c.id for shp in new_shps)
+    assert all(shp.zone == "national" for shp in new_shps)
+
+def test_split_shipment_not_found():
+    with pytest.raises(DomainError) as err:
+        shipments.split_shipment("nonexistent", [1.0])
+    assert err.value.code == "E_NOT_FOUND"
+
+def test_split_shipment_invalid_status():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 10.0, "national")
+    s.status = "delivered"
+    
+    with pytest.raises(DomainError) as err:
+        shipments.split_shipment(s.id, [5.0, 5.0])
+    assert err.value.code == "E_INVALID_STATUS"
+
+def test_split_shipment_weight_mismatch():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 10.0, "national")
+    
+    with pytest.raises(DomainError) as err:
+        shipments.split_shipment(s.id, [5.0, 4.0])
+    assert err.value.code == "E_WEIGHT_MISMATCH"
