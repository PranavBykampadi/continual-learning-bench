diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/parcelo/refunds.py b/parcelo/refunds.py
--- a/parcelo/refunds.py	1969-12-31 19:00:00
+++ b/parcelo/refunds.py	2026-11-12 04:15:00
@@ -0,0 +1,22 @@
+from parcelo.models import Refund
+from parcelo.store import db
+from parcelo.ids import next_id
+from parcelo.clock import now
+
+def create_refund(invoice_id: str, amount: float) -> Refund:
+    invoice = db.invoices.get(invoice_id)
+    if invoice is None:
+        raise ValueError(f"Invoice {invoice_id} not found")
+    
+    if invoice.status != "paid":
+        raise ValueError(f"Invoice {invoice_id} is not paid")
+    
+    refund = Refund(
+        id=next_id(),
+        invoice_id=invoice_id,
+        amount=amount,
+        created_at=now()
+    )
+    
+    db.refunds[refund.id] = refund
+    return refund
\ No newline at end of file
