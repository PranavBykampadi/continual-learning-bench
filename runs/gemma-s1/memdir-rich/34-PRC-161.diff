+
+
+def rebate_for(customer_id):
+    if customer_id not in db.customers:
+        raise KeyError(customer_id)
+
+    shipments_count = 0
+    total_paid = 0.0
+    for invoice in db.invoices.values():
+        shipment = db.shipments[invoice.shipment_id]
+        if shipment.customer_id == customer_id:
+            shipments_count += 1
+            if invoice.status == "paid":
+                total_paid += invoice.amount
+
+    if shipments_count >= 50:
+        pct = 0.06
+    elif shipments_count >= 10:
+        pct = 0.03
+    else:
+        pct = 0.0
+
+    return round(total_paid * pct, 2)
