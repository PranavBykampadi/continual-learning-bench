diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_shipments_zone.py b/tests/unit/test_shipments_zone.py
--- a/tests/unit/test_shipments_zone.py	1969-12-31 19:00:00
+++ b/tests/unit/test_shipments_zone.py	2026-11-12 02:02:01
@@ -0,0 +1,40 @@
+import pytest
+from parcelo.shipments import create_shipment, shipments_in_zone
+from parcelo.errors import DomainError
+from parcelo.store import db
+
+def test_shipments_in_zone_returns_filtered_and_sorted_shipments():
+    db.customers.clear()
+    db.shipments.clear()
+    
+    # Setup customer
+    cust_id = "cust_1"
+    db.customers[cust_id] = True
+    
+    # Create shipments in different zones
+    # We use create_shipment which generates IDs. 
+    # We need to ensure we can verify sorting, but since ids.new_id is sequential, 
+    # they should naturally be sorted if created in order.
+    s1 = create_shipment(cust_id, 1.0, "local")
+    s2 = create_shipment(cust_id, 2.0, "national")
+    s3 = create_shipment(cust_id, 3.0, "local")
+    
+    local_shipments = shipments_in_zone("local")
+    assert len(local_shipments) == 2
+    assert local_shipments == [s1, s3]
+    
+    national_shipments = shipments_in_zone("national")
+    assert len(national_shipments) == 1
+    assert national_shipments == [s2]
+
+def test_shipments_in_zone_empty_list():
+    db.customers.clear()
+    db.shipments.clear()
+    
+    # Zone exists but no shipments
+    assert shipments_in_zone("international") == []
+
+def test_shipments_in_zone_invalid_zone():
+    with pytest.raises(DomainError) as excinfo:
+        shipments_in_zone("mars")
+    assert excinfo.value.code == "E_BAD_ZONE"
