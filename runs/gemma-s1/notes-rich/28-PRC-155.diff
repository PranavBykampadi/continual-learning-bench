diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_customers_by_tier.py b/tests/unit/test_customers_by_tier.py
--- a/tests/unit/test_customers_by_tier.py	1969-12-31 19:00:00
+++ b/tests/unit/test_customers_by_tier.py	2026-11-12 01:43:32
@@ -0,0 +1,43 @@
+from parcelo.customers import add_customer, customers_by_tier, TIERS
+from parcelo.store import reset
+from parcelo.errors import DomainError
+import pytest
+
+def setup_function():
+    reset()
+
+def test_customers_by_tier_returns_filtered_list():
+    # Create customers of different tiers
+    c1 = add_customer("Alice", "gold")
+    c2 = add_customer("Bob", "standard")
+    c3 = add_customer("Charlie", "gold")
+    
+    # Ensure we know the IDs for sorting check
+    # since they are random uuid-based in the current implementation
+    gold_customers = customers_by_tier("gold")
+    
+    assert len(gold_customers) == 2
+    assert c1 in gold_customers
+    assert c3 in gold_customers
+    assert gold_customers == sorted(gold_customers, key=lambda x: x.id)
+
+def test_customers_by_tier_returns_empty_list_when_none_found():
+    add_customer("Alice", "standard")
+    
+    gold_customers = customers_by_tier("gold")
+    assert gold_customers == []
+
+def test_customers_by_tier_raises_domain_error_for_invalid_tier():
+    with pytest.raises(DomainError) as excinfo:
+        customers_by_tier("platinum")
+    assert excinfo.value.code == "E_BAD_INPUT"
+
+def test_customers_by_tier_sorting():
+    # We can't easily control IDs because add_customer uses uuid.uuid4().hex[:6]
+    # but we can verify that the returned list is indeed sorted.
+    for _ in range(5):
+        add_customer(f"User{_}", "gold")
+    
+    results = customers_by_tier("gold")
+    ids = [c.id for c in results]
+    assert ids == sorted(ids)
