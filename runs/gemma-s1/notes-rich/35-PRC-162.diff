+
+
+def invoices_by_status(status):
+    if status not in ("open", "paid"):
+        raise DomainError("E_BAD_INPUT", f"Invalid status: {status}")
+    
+    items = [i for i in db.invoices.values() if i.status == status]
+    return sorted(items, key=lambda x: x.id)
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_invoices_status.py b/tests/unit/test_invoices_status.py
--- a/tests/unit/test_invoices_status.py	1969-12-31 19:00:00
+++ b/tests/unit/test_invoices_status.py	2026-11-12 02:12:38
@@ -0,0 +1,42 @@
+import pytest
+from parcelo.store import db, reset
+from parcelo.models import Invoice
+from parcelo.invoices import invoices_by_status
+from parcelo.errors import DomainError
+
+def setup_function():
+    reset()
+
+def test_invoices_by_status_open():
+    db.invoices["INV-2"] = Invoice(id="INV-2", shipment_id="S2", amount=10.0, status="open")
+    db.invoices["INV-1"] = Invoice(id="INV-1", shipment_id="S1", amount=20.0, status="open")
+    db.invoices["INV-3"] = Invoice(id="INV-3", shipment_id="S3", amount=30.0, status="paid")
+    
+    result = invoices_by_status("open")
+    
+    assert len(result) == 2
+    assert result[0].id == "INV-1"
+    assert result[1].id == "INV-2"
+
+def test_invoices_by_status_paid():
+    db.invoices["INV-2"] = Invoice(id="INV-2", shipment_id="S2", amount=10.0, status="paid")
+    db.invoices["INV-1"] = Invoice(id="INV-1", shipment_id="S1", amount=20.0, status="paid")
+    db.invoices["INV-3"] = Invoice(id="INV-3", shipment_id="S3", amount=30.0, status="open")
+    
+    result = invoices_by_status("paid")
+    
+    assert len(result) == 2
+    assert result[0].id == "INV-1"
+    assert result[1].id == "INV-2"
+
+def test_invoices_by_status_empty():
+    db.invoices["INV-1"] = Invoice(id="INV-1", shipment_id="S1", amount=20.0, status="paid")
+    
+    result = invoices_by_status("open")
+    
+    assert result == []
+
+def test_invoices_by_status_invalid():
+    with pytest.raises(DomainError) as excinfo:
+        invoices_by_status("cancelled")
+    assert excinfo.value.code == "E_BAD_INPUT"
