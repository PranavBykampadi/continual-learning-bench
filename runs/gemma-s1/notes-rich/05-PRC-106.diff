diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_late_fees.py b/tests/unit/test_late_fees.py
--- a/tests/unit/test_late_fees.py	1969-12-31 19:00:00
+++ b/tests/unit/test_late_fees.py	2026-11-11 17:45:22
@@ -0,0 +1,63 @@
+import pytest
+from datetime import datetime, timedelta
+from parcelo.clock import set_fixed, clear_fixed
+from parcelo.invoices import late_fee_for, issue_invoice
+from parcelo.store import db
+from parcelo.money import Money
+from parcelo.errors import DomainError
+
+def test_late_fee_not_late():
+    db.invoices.clear()
+    db.shipments.clear()
+    
+    # Setup shipment for invoice
+    shipment_id = "SHIP-1"
+    db.shipments[shipment_id] = type('Shipment', (), {'weight_kg': 10, 'zone': 'local'})
+    
+    fixed_now = datetime(2023, 1, 1)
+    set_fixed(fixed_now)
+    
+    invoice = issue_invoice(shipment_id)
+    
+    # 29 days later - not late
+    set_fixed(fixed_now + timedelta(days=29))
+    assert late_fee_for(invoice.id) == Money.zero()
+    
+    # 30 days later - still not late (becomes late AFTER 30 days)
+    set_fixed(fixed_now + timedelta(days=30))
+    assert late_fee_for(invoice.id) == Money.zero()
+    
+    clear_fixed()
+
+def test_late_fee_calculation():
+    db.invoices.clear()
+    db.shipments.clear()
+    
+    shipment_id = "SHIP-1"
+    db.shipments[shipment_id] = type('Shipment', (), {'weight_kg': 10, 'zone': 'local'})
+    
+    fixed_now = datetime(2023, 1, 1)
+    set_fixed(fixed_now)
+    
+    invoice = issue_invoice(shipment_id)
+    amount = invoice.amount # e.g. 100.0
+    
+    # 31 days later - 1 day late
+    # Fee = 1.5% * 1 * amount
+    set_fixed(fixed_now + timedelta(days=31))
+    expected = Money.parse(amount).scale(0.015 * 1)
+    assert late_fee_for(invoice.id) == expected
+    
+    # 35 days later - 5 days late
+    # Fee = 1.5% * 5 * amount
+    set_fixed(fixed_now + timedelta(days=35))
+    expected = Money.parse(amount).scale(0.015 * 5)
+    assert late_fee_for(invoice.id) == expected
+    
+    clear_fixed()
+
+def test_late_fee_non_existent_invoice():
+    db.invoices.clear()
+    with pytest.raises(DomainError) as excinfo:
+        late_fee_for("NON-EXISTENT")
+    assert excinfo.value.code == "E_NOT_FOUND"
