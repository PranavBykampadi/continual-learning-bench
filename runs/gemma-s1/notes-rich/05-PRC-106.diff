+def late_fee_for(invoice_id):
+    if invoice_id not in db.invoices:
+        raise DomainError("E_NOT_FOUND", f"Invoice {invoice_id} not found")
+    
+    invoice = db.invoices[invoice_id]
+    amount = Money.parse(invoice.amount)
+    
+    # An invoice becomes late 30 days after it was issued.
+    due_date = invoice.issued_at + timedelta(days=30)
+    today = now()
+    
+    if today <= due_date:
+        return Money.zero()
+    
+    days_late = (today - due_date).days
+    # 1.5% of the invoice amount for each day past those 30 days.
+    daily_rate = 0.015
+    total_rate = daily_rate * days_late
+    
+    return amount.scale(total_rate)
