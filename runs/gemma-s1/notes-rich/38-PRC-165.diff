+
+def shipments_without_invoice():
+    invoiced_shipment_ids = {i.shipment_id for i in db.invoices.values()}
+    shipments = [
+        s for s in db.shipments.values()
+        if s.id not in invoiced_shipment_ids
+    ]
+    return sorted(shipments, key=lambda x: x.id)
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_reports_prc165.py b/tests/unit/test_reports_prc165.py
--- a/tests/unit/test_reports_prc165.py	1969-12-31 19:00:00
+++ b/tests/unit/test_reports_prc165.py	2026-11-12 02:18:44
@@ -0,0 +1,25 @@
+from parcelo.store import db
+from parcelo.reports import shipments_without_invoice
+from parcelo.models import Shipment, Invoice
+
+def test_shipments_without_invoice():
+    db.shipments.clear()
+    db.invoices.clear()
+    
+    s1 = Shipment(id="shp_001", customer_id="c1", weight_kg=1.0, zone="A")
+    s2 = Shipment(id="shp_002", customer_id="c1", weight_kg=2.0, zone="B")
+    s3 = Shipment(id="shp_003", customer_id="c2", weight_kg=3.0, zone="C")
+    
+    db.shipments[s1.id] = s1
+    db.shipments[s2.id] = s2
+    db.shipments[s3.id] = s3
+    
+    # Only s2 has an invoice
+    i1 = Invoice(id="inv_001", shipment_id="shp_002", amount=10.0)
+    db.invoices[i1.id] = i1
+    
+    result = shipments_without_invoice()
+    
+    assert len(result) == 2
+    assert result[0].id == "shp_001"
+    assert result[1].id == "shp_003"
