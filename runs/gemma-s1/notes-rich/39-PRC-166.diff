diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_escalate_invoice.py b/tests/unit/test_escalate_invoice.py
--- a/tests/unit/test_escalate_invoice.py	1969-12-31 19:00:00
+++ b/tests/unit/test_escalate_invoice.py	2026-11-12 02:20:46
@@ -0,0 +1,47 @@
+import pytest
+from parcelo.store import db
+from parcelo.models import Invoice
+from parcelo.invoices import escalate_invoice
+from parcelo.errors import DomainError
+from parcelo.events import OUTBOX
+
+def test_escalate_valid_invoice():
+    invoice_id = "INV-123"
+    db.invoices[invoice_id] = Invoice(id=invoice_id, shipment_id="SHP-1", amount=600.00, status="open")
+    OUTBOX.clear()
+    
+    invoice = escalate_invoice(invoice_id)
+    
+    assert invoice.status == "escalated"
+    assert any(e["name"] == "invoice_escalated" and e["entity_id"] == invoice_id for e in OUTBOX)
+
+def test_escalate_invoice_not_found():
+    with pytest.raises(DomainError) as excinfo:
+        escalate_invoice("NON-EXISTENT")
+    assert excinfo.value.code == "E_NOT_FOUND"
+
+def test_escalate_invoice_below_threshold():
+    invoice_id = "INV-LOW"
+    db.invoices[invoice_id] = Invoice(id=invoice_id, shipment_id="SHP-1", amount=100.00, status="open")
+    
+    with pytest.raises(DomainError) as excinfo:
+        escalate_invoice(invoice_id)
+    assert excinfo.value.code == "E_INELIGIBLE_FOR_ESCALATION"
+
+def test_escalate_invoice_wrong_status():
+    invoice_id = "INV-PAID"
+    db.invoices[invoice_id] = Invoice(id=invoice_id, shipment_id="SHP-1", amount=600.00, status="paid")
+    
+    with pytest.raises(DomainError) as excinfo:
+        escalate_invoice(invoice_id)
+    assert excinfo.value.code == "E_BAD_STATE"
+
+def test_escalate_invoice_idempotency():
+    invoice_id = "INV-ESC"
+    db.invoices[invoice_id] = Invoice(id=invoice_id, shipment_id="SHP-1", amount=600.00, status="escalated")
+    OUTBOX.clear()
+    
+    invoice = escalate_invoice(invoice_id)
+    
+    assert invoice.status == "escalated"
+    assert len(OUTBOX) == 0
