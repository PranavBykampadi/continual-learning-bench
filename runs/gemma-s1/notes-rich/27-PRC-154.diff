--- a/tests/unit/test_customers.py	1969-12-31 19:00:00
+++ b/tests/unit/test_customers.py	2026-11-12 01:41:16
@@ -0,0 +1,33 @@
+import pytest
+from parcelo.store import reset
+from parcelo.customers import add_customer, reactivate_customer
+from parcelo.errors import DomainError
+from parcelo.events import OUTBOX
+
+def test_reactivate_customer_success():
+    reset()
+    customer = add_customer("Test Customer")
+    customer.active = False
+    
+    reactivate_customer(customer.id)
+    
+    assert customer.active is True
+    assert any(e["name"] == "customer_reactivated" and e["entity_id"] == customer.id for e in OUTBOX)
+
+def test_reactivate_customer_idempotent():
+    reset()
+    customer = add_customer("Test Customer")
+    customer.active = True
+    
+    OUTBOX.clear()
+    reactivate_customer(customer.id)
+    
+    assert customer.active is True
+    assert len(OUTBOX) == 0
+
+def test_reactivate_customer_not_found():
+    reset()
+    with pytest.raises(DomainError) as excinfo:
+        reactivate_customer("C_NON_EXISTENT")
+    
+    assert excinfo.value.code == "E_UNKNOWN_CUSTOMER"
