+from parcelo.money import Money
+from parcelo.errors import DomainError
+from parcelo import settings
+
 ZONE_BASE = {"local": 4.5, "national": 9.0, "international": 24.0}
 PER_KG = 1.25
 
 
 def base_rate(zone):
     if zone not in ZONE_BASE:
-        raise ValueError("unknown zone: %s" % zone)
-    return ZONE_BASE[zone]
+        raise DomainError("E_BAD_ZONE", f"unknown zone: {zone}")
+    return Money.parse(ZONE_BASE[zone])
 
 
 def quote(weight_kg, zone):
     if weight_kg <= 0:
-        raise ValueError("weight must be positive")
-    return round(base_rate(zone) + PER_KG * weight_kg, 2)
+        raise DomainError("E_BAD_WEIGHT", "weight must be positive")
+    
+    base = base_rate(zone)
+    weight_cost = Money.parse(PER_KG * weight_kg)
+    total = base + weight_cost
+    
+    # Return float to maintain compatibility with existing frozen tests
+    return float(total.cents / 100)
+
+
+def heavy_quote(weight_kg, zone):
+    """
+    Calculates the quote for a parcel, including a surcharge for heavy parcels.
+    """
+    if weight_kg <= 0:
+        raise DomainError("E_BAD_WEIGHT", "weight must be positive")
+    
+    # quote() returns a float, wrap it in Money for internal logic
+    total = Money.parse(quote(weight_kg, zone))
+    
+    if weight_kg > settings.HEAVY_THRESHOLD_KG:
+        extra_weight = weight_kg - settings.HEAVY_THRESHOLD_KG
+        surcharge = Money.parse(extra_weight * settings.HEAVY_SURCHARGE_PER_KG)
+        total += surcharge
+        
+    return total
