+++ b/tests/unit/test_heavy_quote.py	2026-11-12 01:46:20
@@ -0,0 +1,31 @@
+import pytest
+from parcelo.rates import heavy_quote
+from parcelo.errors import DomainError
+from parcelo.money import Money
+
+def test_heavy_quote_normal_weight():
+    # weight <= 30kg: 4.5 + 1.25 * 10 = 17.0
+    assert heavy_quote(10, "local") == Money.parse(17.0)
+
+def test_heavy_quote_at_threshold():
+    # weight = 30kg: 4.5 + 1.25 * 30 = 42.0
+    assert heavy_quote(30, "local") == Money.parse(42.0)
+
+def test_heavy_quote_heavy_weight():
+    # weight = 40kg: (4.5 + 1.25 * 40) + (10 * 0.75) = 54.5 + 7.5 = 62.0
+    assert heavy_quote(40, "local") == Money.parse(62.0)
+
+def test_heavy_quote_invalid_zone():
+    with pytest.raises(DomainError) as excinfo:
+        heavy_quote(10, "mars")
+    assert excinfo.value.code == "E_BAD_ZONE"
+
+def test_heavy_quote_invalid_weight():
+    with pytest.raises(DomainError) as excinfo:
+        heavy_quote(-1, "local")
+    assert excinfo.value.code == "E_BAD_WEIGHT"
+
+def test_heavy_quote_zero_weight():
+    with pytest.raises(DomainError) as excinfo:
+        heavy_quote(0, "local")
+    assert excinfo.value.code == "E_BAD_WEIGHT"
