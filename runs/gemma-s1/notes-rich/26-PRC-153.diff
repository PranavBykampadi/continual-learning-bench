+    threshold = Money.parse(250.00)
+    
+    return threshold < balance
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_customers_review.py b/tests/unit/test_customers_review.py
--- a/tests/unit/test_customers_review.py	1969-12-31 19:00:00
+++ b/tests/unit/test_customers_review.py	2026-11-12 01:39:45
@@ -0,0 +1,72 @@
+import pytest
+from parcelo.store import db
+from parcelo.customers import add_customer, needs_review
+from parcelo.models import Shipment, Invoice
+from parcelo.errors import DomainError
+
+def setup_function():
+    db.customers.clear()
+    db.shipments.clear()
+    db.invoices.clear()
+
+def create_open_invoice(customer, amount):
+    shipment_id = "S123"
+    db.shipments[shipment_id] = Shipment(id=shipment_id, customer_id=customer.id, weight_kg=1.0, zone="1")
+    invoice_id = "I123"
+    db.invoices[invoice_id] = Invoice(id=invoice_id, shipment_id=shipment_id, amount=amount, status="open")
+    return invoice_id
+
+def test_needs_review_customer_not_found():
+    with pytest.raises(DomainError) as excinfo:
+        needs_review("NONEXISTENT")
+    assert excinfo.value.code == "E_UNKNOWN_CUSTOMER"
+
+def test_needs_review_false_below_limits():
+    cust = add_customer("Alice")
+    # 2 open invoices, total 100.00 (< 3 and < 250)
+    db.shipments["S1"] = Shipment("S1", cust.id, 1.0, "1")
+    db.invoices["I1"] = Invoice("I1", "S1", 50.0, "open")
+    db.shipments["S2"] = Shipment("S2", cust.id, 1.0, "1")
+    db.invoices["I2"] = Invoice("I2", "S2", 50.0, "open")
+    
+    assert needs_review(cust.id) is False
+
+def test_needs_review_true_too_many_invoices():
+    cust = add_customer("Bob")
+    # 4 open invoices, total 40.00 (< 250, but > 3 invoices)
+    for i in range(4):
+        sid, iid = f"S{i}", f"I{i}"
+        db.shipments[sid] = Shipment(sid, cust.id, 1.0, "1")
+        db.invoices[iid] = Invoice(iid, sid, 10.0, "open")
+        
+    assert needs_review(cust.id) is True
+
+def test_needs_review_true_too_high_balance():
+    cust = add_customer("Charlie")
+    # 1 open invoice, total 250.01 (> 250)
+    db.shipments["S1"] = Shipment("S1", cust.id, 1.0, "1")
+    db.invoices["I1"] = Invoice("I1", "S1", 250.01, "open")
+    
+    assert needs_review(cust.id) is True
+
+def test_needs_review_false_at_boundary():
+    cust = add_customer("Dave")
+    # 3 open invoices, total 250.00 (exactly limits)
+    db.shipments["S1"] = Shipment("S1", cust.id, 1.0, "1")
+    db.invoices["I1"] = Invoice("I1", "S1", 100.0, "open")
+    db.shipments["S2"] = Shipment("S2", cust.id, 1.0, "1")
+    db.invoices["I2"] = Invoice("I2", "S2", 100.0, "open")
+    db.shipments["S3"] = Shipment("S3", cust.id, 1.0, "1")
+    db.invoices["I3"] = Invoice("I3", "S3", 50.0, "open")
+    
+    assert needs_review(cust.id) is False
+
+def test_needs_review_ignores_paid_invoices():
+    cust = add_customer("Eve")
+    # 5 invoices, but all paid
+    for i in range(5):
+        sid, iid = f"S{i}", f"I{i}"
+        db.shipments[sid] = Shipment(sid, cust.id, 1.0, "1")
+        db.invoices[iid] = Invoice(iid, sid, 1000.0, "paid")
+        
+    assert needs_review(cust.id) is False
