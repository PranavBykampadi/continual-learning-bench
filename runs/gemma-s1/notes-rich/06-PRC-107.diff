diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_mark_delivered.py b/tests/unit/test_mark_delivered.py
--- a/tests/unit/test_mark_delivered.py	1969-12-31 19:00:00
+++ b/tests/unit/test_mark_delivered.py	2026-11-11 17:46:38
@@ -0,0 +1,38 @@
+import pytest
+from parcelo import shipments, store
+from parcelo.errors import DomainError
+from parcelo.models import Shipment
+
+def test_mark_delivered_success():
+    shipment_id = "shp_123"
+    shipment = Shipment(id=shipment_id, customer_id="c1", weight_kg=1.0, zone="A")
+    store.db.shipments[shipment_id] = shipment
+    
+    result = shipments.mark_delivered(shipment_id)
+    
+    assert result.status == "delivered"
+    assert result.delivered_at is not None
+    assert result.id == shipment_id
+
+def test_mark_delivered_not_found():
+    with pytest.raises(DomainError) as excinfo:
+        shipments.mark_delivered("non_existent")
+    assert excinfo.value.code == "E_NOT_FOUND"
+
+def test_mark_delivered_already_delivered():
+    shipment_id = "shp_123"
+    shipment = Shipment(id=shipment_id, customer_id="c1", weight_kg=1.0, zone="A", status="delivered")
+    store.db.shipments[shipment_id] = shipment
+    
+    with pytest.raises(DomainError) as excinfo:
+        shipments.mark_delivered(shipment_id)
+    assert excinfo.value.code == "E_BAD_STATE"
+
+def test_mark_delivered_cancelled():
+    shipment_id = "shp_123"
+    shipment = Shipment(id=shipment_id, customer_id="c1", weight_kg=1.0, zone="A", status="cancelled")
+    store.db.shipments[shipment_id] = shipment
+    
+    with pytest.raises(DomainError) as excinfo:
+        shipments.mark_delivered(shipment_id)
+    assert excinfo.value.code == "E_BAD_STATE"
