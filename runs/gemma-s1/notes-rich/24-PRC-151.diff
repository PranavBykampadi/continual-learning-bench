diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_shipments_list.py b/tests/unit/test_shipments_list.py
--- a/tests/unit/test_shipments_list.py	1969-12-31 19:00:00
+++ b/tests/unit/test_shipments_list.py	2026-11-12 01:34:53
@@ -0,0 +1,35 @@
+import pytest
+from parcelo import store
+from parcelo.shipments import create_shipment, list_shipments
+from parcelo.customers import add_customer
+from parcelo.errors import DomainError
+
+def test_list_shipments_success():
+    store.reset()
+    customer = add_customer("Test Customer")
+    
+    # Create multiple shipments for the customer
+    s1 = create_shipment(customer.id, 1.0, "local")
+    s2 = create_shipment(customer.id, 2.0, "national")
+    
+    # Create a shipment for another customer
+    other = add_customer("Other Customer")
+    create_shipment(other.id, 3.0, "international")
+    
+    shipments = list_shipments(customer.id)
+    assert len(shipments) == 2
+    assert s1 in shipments
+    assert s2 in shipments
+
+def test_list_shipments_empty():
+    store.reset()
+    customer = add_customer("No Shipments Customer")
+    
+    shipments = list_shipments(customer.id)
+    assert shipments == []
+
+def test_list_shipments_unknown_customer():
+    store.reset()
+    with pytest.raises(DomainError) as excinfo:
+        list_shipments("non_existent_id")
+    assert excinfo.value.code == "E_UNKNOWN_CUSTOMER"
