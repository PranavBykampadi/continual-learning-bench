diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/parcelo/shipments.py b/parcelo/shipments.py
--- a/parcelo/shipments.py	2026-11-10 12:20:18
+++ b/parcelo/shipments.py	2026-11-12 02:06:43
@@ -28,3 +28,16 @@
     if shipment_id not in db.shipments:
         raise DomainError("E_NOT_FOUND", shipment_id)
     return db.shipments[shipment_id]
+
+
+def mark_returned(shipment_id):
+    shipment = get_shipment(shipment_id)
+    if shipment.status == "returned":
+        return shipment
+    if shipment.status == "created":
+        raise DomainError("E_BAD_STATE", f"Shipment {shipment_id} is still in created state")
+    
+    shipment.status = "returned"
+    shipment.returned_at = clock.now()
+    events.emit("shipment.returned", shipment.id, returned_at=shipment.returned_at)
+    return shipment
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_mark_returned.py b/tests/unit/test_mark_returned.py
--- a/tests/unit/test_mark_returned.py	1969-12-31 19:00:00
+++ b/tests/unit/test_mark_returned.py	2026-11-12 02:08:05
@@ -0,0 +1,49 @@
+import pytest
+from parcelo import clock
+from parcelo.store import db
+from parcelo.shipments import create_shipment, mark_returned
+from parcelo.errors import DomainError
+
+def test_mark_returned_success():
+    # Setup: create and deliver a shipment
+    customer_id = "cust_123"
+    db.customers[customer_id] = type('Customer', (), {'id': customer_id})()
+    
+    shipment = create_shipment(customer_id, 1.0, "local")
+    shipment.status = "delivered"
+    
+    returned_shipment = mark_returned(shipment.id)
+    
+    assert returned_shipment.status == "returned"
+    assert returned_shipment.returned_at is not None
+
+def test_mark_returned_idempotency():
+    customer_id = "cust_123"
+    db.customers[customer_id] = type('Customer', (), {'id': customer_id})()
+    
+    shipment = create_shipment(customer_id, 1.0, "local")
+    shipment.status = "delivered"
+    
+    mark_returned(shipment.id)
+    first_returned_at = shipment.returned_at
+    
+    # Second call should return shipment unchanged
+    returned_shipment = mark_returned(shipment.id)
+    assert returned_shipment.status == "returned"
+    assert returned_shipment.returned_at == first_returned_at
+
+def test_mark_returned_fails_for_created_status():
+    customer_id = "cust_123"
+    db.customers[customer_id] = type('Customer', (), {'id': customer_id})()
+    
+    shipment = create_shipment(customer_id, 1.0, "local")
+    # status is "created" by default
+    
+    with pytest.raises(DomainError) as excinfo:
+        mark_returned(shipment.id)
+    assert excinfo.value.code == "E_BAD_STATE"
+
+def test_mark_returned_fails_for_non_existent_shipment():
+    with pytest.raises(DomainError) as excinfo:
+        mark_returned("non_existent_id")
+    assert excinfo.value.code == "E_NOT_FOUND"
