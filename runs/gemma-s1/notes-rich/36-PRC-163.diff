+def lock_customer(customer_id):
+    customer = db.customers.get(customer_id)
+    if not customer:
+        raise DomainError("E_UNKNOWN_CUSTOMER", f"Customer {customer_id} not found")
+    
+    if not customer.locked:
+        customer.locked = True
+        emit("customer_locked", customer_id)
+        
+    return customer
