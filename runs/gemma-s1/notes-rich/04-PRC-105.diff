@@ -0,0 +1,29 @@
+from parcelo.models import Refund
+from parcelo.store import db
+from parcelo.errors import DomainError
+from parcelo.ids import new_id
+from parcelo.clock import now
+from parcelo.money import Money
+import parcelo.audit as audit
+
+def create_refund(invoice_id: str, amount):
+    invoice = db.invoices.get(invoice_id)
+    if not invoice:
+        raise DomainError("E_NOT_FOUND", f"Invoice {invoice_id} not found")
+    
+    if invoice.status != "paid":
+        raise DomainError("E_INVOICE_NOT_PAID", f"Invoice {invoice_id} is not paid")
+    
+    money_amount = amount if isinstance(amount, Money) else Money.parse(amount)
+    
+    refund = Refund(
+        id=new_id("ref"),
+        invoice_id=invoice_id,
+        amount=money_amount,
+        created_at=now()
+    )
+    
+    db.refunds[refund.id] = refund
+    audit.record("create_refund", refund.id, amount=str(money_amount))
+    
+    return refund
