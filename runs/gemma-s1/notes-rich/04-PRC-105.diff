diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_refunds.py b/tests/unit/test_refunds.py
--- a/tests/unit/test_refunds.py	1969-12-31 19:00:00
+++ b/tests/unit/test_refunds.py	2026-11-11 17:42:29
@@ -0,0 +1,32 @@
+import pytest
+from parcelo.store import db, reset
+from parcelo.models import Invoice
+from parcelo.refunds import create_refund
+from parcelo.errors import DomainError
+from parcelo.money import Money
+
+def test_create_refund_success():
+    reset()
+    inv_id = "inv_1"
+    db.invoices[inv_id] = Invoice(id=inv_id, shipment_id="sh_1", amount=100.0, status="paid")
+    
+    refund = create_refund(inv_id, "50.00")
+    
+    assert refund.invoice_id == inv_id
+    assert refund.amount == Money.parse("50.00")
+    assert refund.id in db.refunds
+
+def test_create_refund_invoice_not_found():
+    reset()
+    with pytest.raises(DomainError) as exc:
+        create_refund("non_existent", "10.00")
+    assert exc.value.code == "E_NOT_FOUND"
+
+def test_create_refund_invoice_not_paid():
+    reset()
+    inv_id = "inv_1"
+    db.invoices[inv_id] = Invoice(id=inv_id, shipment_id="sh_1", amount=100.0, status="open")
+    
+    with pytest.raises(DomainError) as exc:
+        create_refund(inv_id, "10.00")
+    assert exc.value.code == "E_INVOICE_NOT_PAID"
