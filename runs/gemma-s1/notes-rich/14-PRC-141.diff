+
+
+def reassign_shipment(shipment_id, new_customer_id):
+    shipment = get_shipment(shipment_id)
+
+    if new_customer_id not in db.customers:
+        raise DomainError("E_UNKNOWN_CUSTOMER", new_customer_id)
+
+    if shipment.status == "delivered":
+        raise DomainError("E_SHIPMENT_DELIVERED", shipment_id)
+
+    old_customer_id = shipment.customer_id
+    shipment.customer_id = new_customer_id
+
+    audit.record(
+        "shipment.reassigned",
+        shipment_id,
+        old_customer_id=old_customer_id,
+        new_customer_id=new_customer_id,
+    )
+
+    return shipment
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_reassign_shipment.py b/tests/unit/test_reassign_shipment.py
--- a/tests/unit/test_reassign_shipment.py	1969-12-31 19:00:00
+++ b/tests/unit/test_reassign_shipment.py	2026-11-11 18:06:16
@@ -0,0 +1,40 @@
+import pytest
+from parcelo import customers, shipments, store
+from parcelo.errors import DomainError
+
+def test_reassign_shipment_success():
+    store.reset()
+    c1 = customers.add_customer("Customer 1")
+    c2 = customers.add_customer("Customer 2")
+    s = shipments.create_shipment(c1.id, 1.0, "national")
+    
+    reassigned = shipments.reassign_shipment(s.id, c2.id)
+    
+    assert reassigned.customer_id == c2.id
+    assert shipments.get_shipment(s.id).customer_id == c2.id
+
+def test_reassign_non_existent_shipment():
+    store.reset()
+    c1 = customers.add_customer("Customer 1")
+    with pytest.raises(DomainError) as err:
+        shipments.reassign_shipment("non-existent", c1.id)
+    assert err.value.code == "E_NOT_FOUND"
+
+def test_reassign_to_non_existent_customer():
+    store.reset()
+    c1 = customers.add_customer("Customer 1")
+    s = shipments.create_shipment(c1.id, 1.0, "national")
+    with pytest.raises(DomainError) as err:
+        shipments.reassign_shipment(s.id, "non-existent")
+    assert err.value.code == "E_UNKNOWN_CUSTOMER"
+
+def test_reassign_delivered_shipment():
+    store.reset()
+    c1 = customers.add_customer("Customer 1")
+    c2 = customers.add_customer("Customer 2")
+    s = shipments.create_shipment(c1.id, 1.0, "national")
+    s.status = "delivered"
+    
+    with pytest.raises(DomainError) as err:
+        shipments.reassign_shipment(s.id, c2.id)
+    assert err.value.code == "E_SHIPMENT_DELIVERED"
