+import pytest
+from parcelo import store, shipments, returns, models
+from parcelo.errors import DomainError
+
+def test_request_return_success():
+    store.reset()
+    # Setup: create a delivered shipment
+    customer_id = "cust_1"
+    store.db.customers[customer_id] = models.Customer(id=customer_id, name="Test")
+    shp = shipments.create_shipment(customer_id, 1.0, "local")
+    shp.status = "delivered"
+    
+    ret = returns.request_return(shp.id, "Damaged item")
+    
+    assert ret.id.startswith("ret_")
+    assert ret.shipment_id == shp.id
+    assert ret.reason == "Damaged item"
+    assert returns.returns_for(shp.id) == [ret]
+
+def test_request_return_not_found():
+    store.reset()
+    with pytest.raises(DomainError) as exc:
+        returns.request_return("nonexistent", "Reason")
+    assert exc.value.code == "E_NOT_FOUND"
+
+def test_request_return_not_delivered():
+    store.reset()
+    customer_id = "cust_1"
+    store.db.customers[customer_id] = models.Customer(id=customer_id, name="Test")
+    shp = shipments.create_shipment(customer_id, 1.0, "local")
+    # status is 'created', not 'delivered'
+    
+    with pytest.raises(DomainError) as exc:
+        returns.request_return(shp.id, "Reason")
+    assert exc.value.code == "E_BAD_STATE"
+
+def test_request_return_limit():
+    store.reset()
+    customer_id = "cust_1"
+    store.db.customers[customer_id] = models.Customer(id=customer_id, name="Test")
+    shp = shipments.create_shipment(customer_id, 1.0, "local")
+    shp.status = "delivered"
+    
+    # Use up the limit
+    returns.request_return(shp.id, "R1")
+    returns.request_return(shp.id, "R2")
+    returns.request_return(shp.id, "R3")
+    
+    with pytest.raises(DomainError) as exc:
+        returns.request_return(shp.id, "R4")
+    assert exc.value.code == "E_LIMIT"
+
