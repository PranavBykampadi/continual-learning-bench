diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/parcelo/returns.py b/parcelo/returns.py
--- a/parcelo/returns.py	1969-12-31 19:00:00
+++ b/parcelo/returns.py	2026-11-12 01:58:13
@@ -0,0 +1,35 @@
+from parcelo import clock, events, ids
+from parcelo.errors import DomainError
+from parcelo.models import ReturnRequest
+from parcelo.store import db
+
+MAX_RETURNS_PER_SHIPMENT = 3
+
+def request_return(shipment_id, reason):
+    if shipment_id not in db.shipments:
+        raise DomainError("E_NOT_FOUND", shipment_id)
+    
+    shipment = db.shipments[shipment_id]
+    
+    if shipment.status != "delivered":
+        raise DomainError("E_BAD_STATE", f"Shipment {shipment_id} must be delivered to be returned")
+    
+    existing_returns = returns_for(shipment_id)
+    if len(existing_returns) >= MAX_RETURNS_PER_SHIPMENT:
+        raise DomainError("E_LIMIT", f"Shipment {shipment_id} has reached the maximum number of return requests")
+    
+    return_request = ReturnRequest(
+        id=ids.new_id("ret"),
+        shipment_id=shipment_id,
+        reason=reason,
+        requested_at=clock.now()
+    )
+    
+    db.returns[return_request.id] = return_request
+    events.emit("return.requested", return_request.id, shipment_id=shipment_id)
+    
+    return return_request
+
+def returns_for(shipment_id):
+    items = [r for r in db.returns.values() if r.shipment_id == shipment_id]
+    return sorted(items, key=lambda x: x.id)
