@@ -0,0 +1,52 @@
+import pytest
+from parcelo.store import db
+from parcelo.models import Invoice
+from parcelo.invoices import hold_invoice
+from parcelo.errors import DomainError
+from parcelo import clock, events
+
+def test_hold_invoice_success():
+    db.invoices.clear()
+    inv = Invoice(id="INV_001", shipment_id="SHP_001", amount=100.0, status="open")
+    db.invoices[inv.id] = inv
+    
+    # Use fixed clock to avoid race condition / microsecond diffs
+    frozen_now = clock.now()
+    clock.set_fixed(frozen_now)
+    
+    try:
+        result = hold_invoice(inv.id)
+        assert result.status == "on_hold"
+        assert result.held_at == frozen_now
+        assert len(events.OUTBOX) == 1
+        assert events.OUTBOX[0]["name"] == "invoice_held"
+        assert events.OUTBOX[0]["entity_id"] == inv.id
+    finally:
+        clock.clear_fixed()
+
+def test_hold_invoice_not_found():
+    db.invoices.clear()
+    with pytest.raises(DomainError) as exc:
+        hold_invoice("NONEXISTENT")
+    assert exc.value.code == "E_NOT_FOUND"
+
+def test_hold_invoice_invalid_state():
+    db.invoices.clear()
+    inv = Invoice(id="INV_001", shipment_id="SHP_001", amount=100.0, status="paid")
+    db.invoices[inv.id] = inv
+    
+    with pytest.raises(DomainError) as exc:
+        hold_invoice(inv.id)
+    assert exc.value.code == "E_BAD_STATE"
+
+def test_hold_invoice_idempotency():
+    db.invoices.clear()
+    events.OUTBOX.clear()
+    inv = Invoice(id="INV_001", shipment_id="SHP_001", amount=100.0, status="on_hold", held_at="some-time")
+    db.invoices[inv.id] = inv
+    
+    result = hold_invoice(inv.id)
+    
+    assert result.status == "on_hold"
+    assert result.held_at == "some-time"
+    assert len(events.OUTBOX) == 0
\ No newline at end of file
