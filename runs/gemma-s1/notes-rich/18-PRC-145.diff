@@ -0,0 +1,30 @@
+import pytest
+from parcelo.customers import add_customer, upgrade_tier
+from parcelo.store import db, reset
+from parcelo.errors import DomainError
+
+@pytest.fixture(autouse=True)
+def clear_db():
+    reset()
+
+def test_upgrade_tier_success():
+    customer = add_customer("Alice")
+    assert customer.tier == "standard"
+    
+    upgraded = upgrade_tier(customer.id)
+    
+    assert upgraded.id == customer.id
+    assert upgraded.tier == "gold"
+    assert db.customers[customer.id].tier == "gold"
+
+def test_upgrade_tier_not_found():
+    with pytest.raises(DomainError) as exc:
+        upgrade_tier("non-existent")
+    assert exc.value.code == "E_UNKNOWN_CUSTOMER"
+
+def test_upgrade_tier_already_gold():
+    customer = add_customer("Bob", tier="gold")
+    
+    with pytest.raises(DomainError) as exc:
+        upgrade_tier(customer.id)
+    assert exc.value.code == "E_ALREADY_GOLD"
