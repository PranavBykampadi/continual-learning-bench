+def add_address(customer_id, line, city):
+    if customer_id not in db.customers:
+        raise DomainError("E_UNKNOWN_CUSTOMER", "customer not found")
+    if not line or not city:
+        raise DomainError("E_BAD_INPUT", "line and city are required")
+
+    address = Address(
+        id="A" + uuid.uuid4().hex[:6],
+        customer_id=customer_id,
+        line=line,
+        city=city
+    )
+    db.addresses[address.id] = address
+    return address
