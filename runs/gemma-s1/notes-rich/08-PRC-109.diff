@@ -0,0 +1,33 @@
+import pytest
+from parcelo.customers import add_customer, add_address
+from parcelo.store import reset
+from parcelo.errors import DomainError
+
+def test_add_address_success():
+    reset()
+    customer = add_customer("John Doe")
+    address = add_address(customer.id, "123 Main St", "New York")
+    assert address.id.startswith("A")
+    assert address.customer_id == customer.id
+    assert address.line == "123 Main St"
+    assert address.city == "New York"
+
+def test_add_address_customer_not_found():
+    reset()
+    with pytest.raises(DomainError) as excinfo:
+        add_address("NONEXISTENT", "123 Main St", "New York")
+    assert excinfo.value.code == "E_UNKNOWN_CUSTOMER"
+
+def test_add_address_missing_line():
+    reset()
+    customer = add_customer("John Doe")
+    with pytest.raises(DomainError) as excinfo:
+        add_address(customer.id, "", "New York")
+    assert excinfo.value.code == "E_BAD_INPUT"
+
+def test_add_address_missing_city():
+    reset()
+    customer = add_customer("John Doe")
+    with pytest.raises(DomainError) as excinfo:
+        add_address(customer.id, "123 Main St", "")
+    assert excinfo.value.code == "E_BAD_INPUT"
