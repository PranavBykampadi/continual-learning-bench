diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_pickups.py b/tests/unit/test_pickups.py
--- a/tests/unit/test_pickups.py	1969-12-31 19:00:00
+++ b/tests/unit/test_pickups.py	2026-11-11 18:09:19
@@ -0,0 +1,32 @@
+import pytest
+from parcelo.store import db, reset
+from parcelo.models import Shipment
+from parcelo.pickups import schedule_pickup
+from parcelo.errors import DomainError
+
+def test_schedule_pickup_success():
+    reset()
+    shipment_id = "ship_123"
+    db.shipments[shipment_id] = Shipment(id=shipment_id, customer_id="cust_1", weight_kg=1.0, zone="A")
+    
+    window_start = "2023-10-27T10:00:00Z"
+    pickup = schedule_pickup(shipment_id, window_start)
+    
+    assert pickup.shipment_id == shipment_id
+    assert pickup.window_start == window_start
+    assert pickup.id in db.pickups
+
+def test_schedule_pickup_shipment_not_found():
+    reset()
+    with pytest.raises(DomainError) as excinfo:
+        schedule_pickup("non_existent", "2023-10-27T10:00:00Z")
+    assert excinfo.value.code == "E_NOT_FOUND"
+
+def test_schedule_pickup_invalid_status():
+    reset()
+    shipment_id = "ship_123"
+    db.shipments[shipment_id] = Shipment(id=shipment_id, customer_id="cust_1", weight_kg=1.0, zone="A", status="shipped")
+    
+    with pytest.raises(DomainError) as excinfo:
+        schedule_pickup(shipment_id, "2023-10-27T10:00:00Z")
+    assert excinfo.value.code == "E_PICKUP_NOT_ALLOWED"
