diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/parcelo/pickups.py b/parcelo/pickups.py
--- a/parcelo/pickups.py	1969-12-31 19:00:00
+++ b/parcelo/pickups.py	2026-11-11 18:08:57
@@ -0,0 +1,26 @@
+from parcelo.models import Pickup
+from parcelo.store import db
+from parcelo.errors import DomainError
+from parcelo.ids import new_id
+from parcelo.clock import now
+from parcelo.events import emit
+
+def schedule_pickup(shipment_id, window_start):
+    shipment = db.shipments.get(shipment_id)
+    if not shipment:
+        raise DomainError("E_NOT_FOUND", f"Shipment {shipment_id} not found")
+    
+    if shipment.status != "created":
+        raise DomainError("E_PICKUP_NOT_ALLOWED", f"Shipment {shipment_id} is in status {shipment.status}, only 'created' shipments can be picked up")
+    
+    pickup = Pickup(
+        id=new_id("pickup"),
+        shipment_id=shipment_id,
+        window_start=window_start,
+        scheduled_at=now()
+    )
+    
+    db.pickups[pickup.id] = pickup
+    emit("pickup_scheduled", pickup.id, shipment_id=shipment_id)
+    
+    return pickup
