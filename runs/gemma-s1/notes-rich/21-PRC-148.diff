diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_disputes.py b/tests/unit/test_disputes.py
--- a/tests/unit/test_disputes.py	1969-12-31 19:00:00
+++ b/tests/unit/test_disputes.py	2026-11-11 18:17:06
@@ -0,0 +1,35 @@
+import pytest
+from parcelo.store import db, reset
+from parcelo.models import Invoice
+from parcelo.disputes import open_dispute
+from parcelo.errors import DomainError
+
+def test_open_dispute_success():
+    reset()
+    invoice_id = "inv_123"
+    db.invoices[invoice_id] = Invoice(id=invoice_id, shipment_id="sh_1", amount=100.0)
+    
+    reason = "Incorrect amount charged"
+    dispute = open_dispute(invoice_id, reason)
+    
+    assert dispute.id.startswith("dispute_")
+    assert dispute.invoice_id == invoice_id
+    assert dispute.reason == reason
+    assert dispute.opened_at is not None
+    assert db.disputes[dispute.id] == dispute
+
+def test_open_dispute_invoice_not_found():
+    reset()
+    with pytest.raises(DomainError) as excinfo:
+        open_dispute("non_existent", "Reason")
+    assert excinfo.value.code == "E_NOT_FOUND"
+
+def test_open_dispute_empty_reason():
+    reset()
+    invoice_id = "inv_123"
+    db.invoices[invoice_id] = Invoice(id=invoice_id, shipment_id="sh_1", amount=100.0)
+    
+    for reason in ["", "   ", None]:
+        with pytest.raises(DomainError) as excinfo:
+            open_dispute(invoice_id, reason)
+        assert excinfo.value.code == "E_BAD_INPUT"
