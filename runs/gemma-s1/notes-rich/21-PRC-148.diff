diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/parcelo/disputes.py b/parcelo/disputes.py
--- a/parcelo/disputes.py	1969-12-31 19:00:00
+++ b/parcelo/disputes.py	2026-11-11 18:16:47
@@ -0,0 +1,26 @@
+from parcelo.models import Dispute
+from parcelo.store import db
+from parcelo.errors import DomainError
+from parcelo.ids import new_id
+from parcelo.clock import now
+from parcelo.events import emit
+
+def open_dispute(invoice_id: str, reason: str) -> Dispute:
+    if not reason or not reason.strip():
+        raise DomainError("E_BAD_INPUT", "Reason is required to open a dispute")
+
+    if invoice_id not in db.invoices:
+        raise DomainError("E_NOT_FOUND", f"Invoice {invoice_id} not found")
+
+    dispute_id = new_id("dispute")
+    dispute = Dispute(
+        id=dispute_id,
+        invoice_id=invoice_id,
+        reason=reason,
+        opened_at=now()
+    )
+
+    db.disputes[dispute_id] = dispute
+    emit("dispute_opened", dispute_id, invoice_id=invoice_id)
+
+    return dispute
