diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_rebates.py b/tests/unit/test_rebates.py
--- a/tests/unit/test_rebates.py	1969-12-31 19:00:00
+++ b/tests/unit/test_rebates.py	2026-11-12 02:10:54
@@ -0,0 +1,75 @@
+import pytest
+from parcelo.store import db
+from parcelo.customers import add_customer, rebate_for
+from parcelo.shipments import create_shipment
+from parcelo.invoices import issue_invoice, mark_paid
+from parcelo.money import Money
+from parcelo.errors import DomainError
+
+def test_rebate_zero_for_few_shipments():
+    customer = add_customer("Alice")
+    for _ in range(5):
+        shp = create_shipment(customer.id, 1.0, "local")
+        inv = issue_invoice(shp.id)
+        mark_paid(inv.id)
+    
+    assert rebate_for(customer.id) == Money.zero()
+
+def test_rebate_tier_1():
+    customer = add_customer("Bob")
+    # 10 shipments
+    for _ in range(10):
+        shp = create_shipment(customer.id, 1.0, "local")
+        inv = issue_invoice(shp.id)
+        mark_paid(inv.id)
+    
+    total_paid = Money.zero()
+    for inv in db.invoices.values():
+        shp = db.shipments[inv.shipment_id]
+        if shp.customer_id == customer.id:
+            total_paid += Money.parse(inv.amount)
+            
+    expected = total_paid.scale(0.03)
+    assert rebate_for(customer.id) == expected
+
+def test_rebate_tier_2():
+    customer = add_customer("Charlie")
+    # 50 shipments
+    for _ in range(50):
+        shp = create_shipment(customer.id, 1.0, "local")
+        inv = issue_invoice(shp.id)
+        mark_paid(inv.id)
+    
+    total_paid = Money.zero()
+    for inv in db.invoices.values():
+        shp = db.shipments[inv.shipment_id]
+        if shp.customer_id == customer.id:
+            total_paid += Money.parse(inv.amount)
+            
+    expected = total_paid.scale(0.06)
+    assert rebate_for(customer.id) == expected
+
+def test_rebate_unknown_customer():
+    with pytest.raises(DomainError) as excinfo:
+        rebate_for("NONEXISTENT")
+    assert excinfo.value.code == "E_UNKNOWN_CUSTOMER"
+
+def test_rebate_only_paid_invoices_count():
+    customer = add_customer("Dave")
+    # 10 shipments, but only 5 paid
+    for i in range(10):
+        shp = create_shipment(customer.id, 1.0, "local")
+        inv = issue_invoice(shp.id)
+        if i < 5:
+            mark_paid(inv.id)
+    
+    # 10 shipments = tier 1 (3%)
+    # But only 5 invoices are paid.
+    total_paid = Money.zero()
+    for inv in db.invoices.values():
+        shp = db.shipments[inv.shipment_id]
+        if shp.customer_id == customer.id and inv.status == "paid":
+            total_paid += Money.parse(inv.amount)
+            
+    expected = total_paid.scale(0.03)
+    assert rebate_for(customer.id) == expected
