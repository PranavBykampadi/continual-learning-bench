@@ -0,0 +1,34 @@
+from parcelo.money import Money
+from parcelo.errors import DomainError
+from parcelo.ids import new_id
+from parcelo.clock import now
+from parcelo.store import db
+from parcelo.models import Voucher
+from parcelo.settings import MAX_VOUCHER_AMOUNT
+from parcelo.events import emit
+
+def issue_voucher(customer_id: str, amount: float) -> Voucher:
+    money_amount = Money.parse(amount)
+    max_money = Money.parse(MAX_VOUCHER_AMOUNT)
+    
+    if customer_id not in db.customers:
+        raise DomainError("E_UNKNOWN_CUSTOMER", f"Customer {customer_id} not found")
+    
+    if money_amount.cents <= 0:
+        raise DomainError("E_BAD_INPUT", "Voucher amount must be positive")
+        
+    if money_amount > max_money:
+        raise DomainError("E_LIMIT", f"Voucher amount exceeds maximum limit of {MAX_VOUCHER_AMOUNT}")
+
+    voucher_id = new_id("vouch")
+    voucher = Voucher(
+        id=voucher_id,
+        customer_id=customer_id,
+        amount=money_amount,
+        issued_at=now()
+    )
+    
+    db.vouchers[voucher_id] = voucher
+    emit("voucher_issued", voucher_id, customer_id=customer_id, amount=money_amount.cents / 100)
+    
+    return voucher
