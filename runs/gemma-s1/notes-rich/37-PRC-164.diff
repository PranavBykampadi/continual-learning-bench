+import pytest
+from parcelo.store import db, reset
+from parcelo.vouchers import issue_voucher
+from parcelo.errors import DomainError
+from parcelo.money import Money
+
+def test_issue_voucher_success():
+    reset()
+    customer_id = "cust_123"
+    db.customers[customer_id] = type('Customer', (), {'id': customer_id})()
+    
+    amount = 50.0
+    voucher = issue_voucher(customer_id, amount)
+    
+    assert voucher.customer_id == customer_id
+    assert voucher.amount == Money.parse(amount)
+    assert voucher.id.startswith("vouch_")
+    assert voucher.id in db.vouchers
+
+def test_issue_voucher_unknown_customer():
+    reset()
+    with pytest.raises(DomainError) as exc:
+        issue_voucher("nonexistent", 50.0)
+    assert exc.value.code == "E_UNKNOWN_CUSTOMER"
+
+def test_issue_voucher_too_high():
+    reset()
+    customer_id = "cust_123"
+    db.customers[customer_id] = type('Customer', (), {'id': customer_id})()
+    
+    with pytest.raises(DomainError) as exc:
+        issue_voucher(customer_id, 150.01)
+    assert exc.value.code == "E_LIMIT"
+
+def test_issue_voucher_zero_amount():
+    reset()
+    customer_id = "cust_123"
+    db.customers[customer_id] = type('Customer', (), {'id': customer_id})()
+    
+    with pytest.raises(DomainError) as exc:
+        issue_voucher(customer_id, 0.0)
+    assert exc.value.code == "E_BAD_INPUT"
+
