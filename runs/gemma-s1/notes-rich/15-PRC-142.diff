@@ -0,0 +1,30 @@
+import pytest
+from parcelo.store import db
+from parcelo.invoices import mark_paid, reopen_invoice
+from parcelo.models import Invoice
+from parcelo.errors import DomainError
+
+def test_reopen_paid_invoice():
+    inv_id = "INV-123"
+    invoice = Invoice(id=inv_id, shipment_id="SHP-1", amount=100.0, status="paid")
+    db.invoices[inv_id] = invoice
+
+    reopened = reopen_invoice(inv_id)
+    
+    assert reopened.status == "open"
+    assert reopened.paid_at is None
+    assert reopened.reopened_at is not None
+
+def test_reopen_non_existent_invoice():
+    with pytest.raises(DomainError) as excinfo:
+        reopen_invoice("NON-EXISTENT")
+    assert excinfo.value.code == "E_NOT_FOUND"
+
+def test_reopen_unpaid_invoice():
+    inv_id = "INV-456"
+    invoice = Invoice(id=inv_id, shipment_id="SHP-2", amount=100.0, status="open")
+    db.invoices[inv_id] = invoice
+
+    with pytest.raises(DomainError) as excinfo:
+        reopen_invoice(inv_id)
+    assert excinfo.value.code == "E_BAD_STATE"
