diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_claims.py b/tests/unit/test_claims.py
--- a/tests/unit/test_claims.py	1969-12-31 19:00:00
+++ b/tests/unit/test_claims.py	2026-11-11 18:00:11
@@ -0,0 +1,58 @@
+import pytest
+from parcelo import store, shipments, customers
+from parcelo.claims import file_claim
+from parcelo.errors import DomainError
+from parcelo.money import Money
+
+def test_file_claim_success():
+    store.reset()
+    cust = customers.add_customer("Alice")
+    shp = shipments.create_shipment(cust.id, 1.0, "local")
+    shp.status = "delivered"
+    store.db.shipments[shp.id] = shp
+
+    claim = file_claim(shp.id, 10.50, "Damaged item")
+    
+    assert claim.id.startswith("clm_")
+    assert claim.shipment_id == shp.id
+    assert claim.amount == Money.parse(10.50)
+    assert claim.reason == "Damaged item"
+    assert claim.id in store.db.claims
+
+def test_file_claim_shipment_not_found():
+    store.reset()
+    with pytest.raises(DomainError) as exc:
+        file_claim("nonexistent", 10.0, "reason")
+    assert exc.value.code == "E_NOT_FOUND"
+
+def test_file_claim_not_delivered():
+    store.reset()
+    cust = customers.add_customer("Alice")
+    shp = shipments.create_shipment(cust.id, 1.0, "local")
+    # status is 'created' by default
+    
+    with pytest.raises(DomainError) as exc:
+        file_claim(shp.id, 10.0, "reason")
+    assert exc.value.code == "E_BAD_STATE"
+
+def test_file_claim_negative_amount():
+    store.reset()
+    cust = customers.add_customer("Alice")
+    shp = shipments.create_shipment(cust.id, 1.0, "local")
+    shp.status = "delivered"
+    store.db.shipments[shp.id] = shp
+
+    with pytest.raises(DomainError) as exc:
+        file_claim(shp.id, -5.0, "reason")
+    assert exc.value.code == "E_INVALID_CLAIM"
+
+def test_file_claim_zero_amount():
+    store.reset()
+    cust = customers.add_customer("Alice")
+    shp = shipments.create_shipment(cust.id, 1.0, "local")
+    shp.status = "delivered"
+    store.db.shipments[shp.id] = shp
+
+    with pytest.raises(DomainError) as exc:
+        file_claim(shp.id, 0, "reason")
+    assert exc.value.code == "E_INVALID_CLAIM"
