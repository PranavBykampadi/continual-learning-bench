@@ -0,0 +1,31 @@
+from parcelo import audit, clock, ids
+from parcelo.errors import DomainError
+from parcelo.models import Claim
+from parcelo.money import Money
+from parcelo.store import db
+
+
+def file_claim(shipment_id, amount, reason):
+    shipment = db.shipments.get(shipment_id)
+    if not shipment:
+        raise DomainError("E_NOT_FOUND", shipment_id)
+
+    if shipment.status != "delivered":
+        raise DomainError("E_BAD_STATE", f"Shipment {shipment_id} is not delivered")
+
+    money_amount = Money.parse(amount) if not isinstance(amount, Money) else amount
+    if money_amount.cents <= 0:
+        raise DomainError("E_INVALID_CLAIM", "Amount must be positive")
+
+    claim = Claim(
+        id=ids.new_id("clm"),
+        shipment_id=shipment_id,
+        amount=money_amount,
+        reason=reason,
+        filed_at=clock.now(),
+    )
+
+    db.claims[claim.id] = claim
+    audit.record("claim.filed", claim.id, shipment_id=shipment_id, amount=money_amount.cents)
+
+    return claim
