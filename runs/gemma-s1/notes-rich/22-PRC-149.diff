@@ -28,3 +28,30 @@
     if shipment_id not in db.shipments:
         raise DomainError("E_NOT_FOUND", shipment_id)
     return db.shipments[shipment_id]
+
+
+def split_shipment(shipment_id, weights):
+    shipment = get_shipment(shipment_id)
+    if shipment.status != "created":
+        raise DomainError("E_BAD_STATE", f"Shipment {shipment_id} must be in created status to be split")
+    
+    if sum(weights) != shipment.weight_kg:
+        raise DomainError("E_BAD_INPUT", f"Split weights must sum up to {shipment.weight_kg}")
+
+    shipment.status = "split"
+    events.emit("shipment.split", shipment.id)
+
+    new_shipments = []
+    for w in weights:
+        new_shp = Shipment(
+            id=ids.new_id("shp"),
+            customer_id=shipment.customer_id,
+            weight_kg=w,
+            zone=shipment.zone,
+            created_at=clock.now(),
+        )
+        db.shipments[new_shp.id] = new_shp
+        events.emit("shipment.created", new_shp.id, zone=new_shp.zone)
+        new_shipments.append(new_shp)
+    
+    return new_shipments
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_split_shipment.py b/tests/unit/test_split_shipment.py
--- a/tests/unit/test_split_shipment.py	1969-12-31 19:00:00
+++ b/tests/unit/test_split_shipment.py	2026-11-11 18:19:05
@@ -0,0 +1,42 @@
+import pytest
+from parcelo.shipments import create_shipment, split_shipment, get_shipment
+from parcelo.errors import DomainError
+from parcelo.store import db
+
+def test_split_shipment_success():
+    db.customers["cust_1"] = type('obj', (object,), {'id': 'cust_1'})
+    shipment = create_shipment("cust_1", 10.0, "local")
+    
+    weights = [3.0, 4.0, 3.0]
+    new_shipments = split_shipment(shipment.id, weights)
+    
+    assert len(new_shipments) == 3
+    assert [s.weight_kg for s in new_shipments] == weights
+    assert all(s.customer_id == shipment.customer_id for s in new_shipments)
+    assert all(s.zone == shipment.zone for s in new_shipments)
+    assert shipment.status == "split"
+    
+    for s in new_shipments:
+        assert get_shipment(s.id).weight_kg == s.weight_kg
+
+def test_split_shipment_not_found():
+    with pytest.raises(DomainError) as exc:
+        split_shipment("non_existent", [5.0])
+    assert exc.value.code == "E_NOT_FOUND"
+
+def test_split_shipment_wrong_status():
+    db.customers["cust_1"] = type('obj', (object,), {'id': 'cust_1'})
+    shipment = create_shipment("cust_1", 10.0, "local")
+    shipment.status = "delivered"
+    
+    with pytest.raises(DomainError) as exc:
+        split_shipment(shipment.id, [5.0, 5.0])
+    assert exc.value.code == "E_BAD_STATE"
+
+def test_split_shipment_weight_mismatch():
+    db.customers["cust_1"] = type('obj', (object,), {'id': 'cust_1'})
+    shipment = create_shipment("cust_1", 10.0, "local")
+    
+    with pytest.raises(DomainError) as exc:
+        split_shipment(shipment.id, [5.0, 4.0])
+    assert exc.value.code == "E_BAD_INPUT"
