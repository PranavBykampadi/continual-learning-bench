         raise DomainError("E_NOT_FOUND", shipment_id)
     return db.shipments[shipment_id]
+
+
+def add_note(shipment_id, text):
+    if not text:
+        raise DomainError("E_BAD_INPUT", "Note text cannot be empty")
+    shipment = get_shipment(shipment_id)
+    note = {"text": text, "at": clock.now()}
+    shipment.notes.append(note)
+    audit.record("shipment.note_added", shipment.id, text=text)
+    return shipment
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_shipment_notes.py b/tests/unit/test_shipment_notes.py
--- a/tests/unit/test_shipment_notes.py	1969-12-31 19:00:00
+++ b/tests/unit/test_shipment_notes.py	2026-11-11 17:54:05
@@ -0,0 +1,30 @@
+import pytest
+from parcelo import store, clock
+from parcelo.shipments import create_shipment, add_note
+from parcelo.errors import DomainError
+from parcelo.models import Customer
+
+def test_add_note_success():
+    store.db.customers["cust_1"] = Customer(id="cust_1", name="Test")
+    shipment = create_shipment("cust_1", 1.0, "local")
+    
+    # To avoid race conditions with clock.now(), 
+    # we verify the note exists and was created at a plausible time.
+    add_note(shipment.id, "First note")
+    
+    assert len(shipment.notes) == 1
+    assert shipment.notes[0]["text"] == "First note"
+    assert shipment.notes[0]["at"] is not None
+
+def test_add_note_empty_text():
+    store.db.customers["cust_1"] = Customer(id="cust_1", name="Test")
+    shipment = create_shipment("cust_1", 1.0, "local")
+    
+    with pytest.raises(DomainError) as excinfo:
+        add_note(shipment.id, "")
+    assert excinfo.value.code == "E_BAD_INPUT"
+
+def test_add_note_non_existent_shipment():
+    with pytest.raises(DomainError) as excinfo:
+        add_note("non_existent", "Hello")
+    assert excinfo.value.code == "E_NOT_FOUND"
