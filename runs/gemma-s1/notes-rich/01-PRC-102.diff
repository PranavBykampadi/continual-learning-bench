diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_void_invoice.py b/tests/unit/test_void_invoice.py
--- a/tests/unit/test_void_invoice.py	1969-12-31 19:00:00
+++ b/tests/unit/test_void_invoice.py	2026-11-11 17:36:40
@@ -0,0 +1,48 @@
+import pytest
+from datetime import datetime
+from parcelo.store import db
+from parcelo.invoices import issue_invoice, void_invoice, mark_paid
+from parcelo.errors import DomainError
+
+def test_void_invoice_success():
+    # Setup
+    shipment_id = "SHP-1"
+    db.shipments[shipment_id] = type('obj', (object,), {'weight_kg': 1, 'zone': 'local'})
+    invoice = issue_invoice(shipment_id)
+    
+    # Action
+    voided = void_invoice(invoice.id)
+    
+    # Assert
+    assert voided.status == "void"
+    assert isinstance(voided.voided_at, datetime)
+    assert db.invoices[invoice.id].status == "void"
+
+def test_void_invoice_not_found():
+    with pytest.raises(DomainError) as excinfo:
+        void_invoice("NON-EXISTENT")
+    assert excinfo.value.code == "E_NOT_FOUND"
+
+def test_void_already_paid():
+    # Setup
+    shipment_id = "SHP-2"
+    db.shipments[shipment_id] = type('obj', (object,), {'weight_kg': 1, 'zone': 'local'})
+    invoice = issue_invoice(shipment_id)
+    mark_paid(invoice.id)
+    
+    # Action & Assert
+    with pytest.raises(DomainError) as excinfo:
+        void_invoice(invoice.id)
+    assert excinfo.value.code == "E_INVALID_INVOICE_STATE"
+
+def test_void_already_void():
+    # Setup
+    shipment_id = "SHP-3"
+    db.shipments[shipment_id] = type('obj', (object,), {'weight_kg': 1, 'zone': 'local'})
+    invoice = issue_invoice(shipment_id)
+    void_invoice(invoice.id)
+    
+    # Action & Assert
+    with pytest.raises(DomainError) as excinfo:
+        void_invoice(invoice.id)
+    assert excinfo.value.code == "E_INVALID_INVOICE_STATE"
