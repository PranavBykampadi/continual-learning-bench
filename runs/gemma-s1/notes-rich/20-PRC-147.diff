+def volume_report():
+    def get_tier(count):
+        if count >= 50:
+            return "bulk"
+        if count >= 10:
+            return "regular"
+        return "starter"
+
+    # Map shipments to customer IDs
+    counts = {}
+    for shipment in db.shipments.values():
+        cid = shipment.customer_id
+        counts[cid] = counts.get(cid, 0) + 1
+
+    # Ensure every customer is included
+    report = {}
+    for cid in db.customers:
+        count = counts.get(cid, 0)
+        report[cid] = {
+            "shipments": count,
+            "tier": get_tier(count)
+        }
+    return report
