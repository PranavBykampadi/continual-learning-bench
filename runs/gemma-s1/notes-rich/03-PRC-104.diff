+++ b/tests/unit/test_customers_deactivation.py	2026-11-11 17:38:31
@@ -0,0 +1,29 @@
+import pytest
+from parcelo.customers import add_customer, deactivate_customer
+from parcelo.store import db
+from parcelo.errors import DomainError
+
+def test_deactivate_customer_success():
+    db.customers.clear()
+    customer = add_customer("Alice")
+    
+    deactivated = deactivate_customer(customer.id)
+    
+    assert deactivated.id == customer.id
+    assert deactivated.active is False
+    assert db.customers[customer.id].active is False
+
+def test_deactivate_non_existent_customer():
+    db.customers.clear()
+    with pytest.raises(DomainError) as excinfo:
+        deactivate_customer("NONEXISTENT")
+    assert excinfo.value.code == "E_NOT_FOUND"
+
+def test_deactivate_already_inactive_customer():
+    db.customers.clear()
+    customer = add_customer("Bob")
+    deactivate_customer(customer.id)
+    
+    with pytest.raises(DomainError) as excinfo:
+        deactivate_customer(customer.id)
+    assert excinfo.value.code == "E_BAD_STATE"
\ No newline at end of file
