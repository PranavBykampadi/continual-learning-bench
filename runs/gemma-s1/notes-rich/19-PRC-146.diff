 def open_invoices():
     return [i for i in db.invoices.values() if i.status == "open"]
+
+
+def write_off(invoice_id):
+    if invoice_id not in db.invoices:
+        raise DomainError("E_NOT_FOUND", f"Invoice {invoice_id} not found")
+    
+    invoice = db.invoices[invoice_id]
+    if invoice.status != "open":
+        raise DomainError("E_INVOICE_NOT_OPEN", "Only open invoices can be written off")
+    
+    amount_written_off = Money.parse(invoice.amount)
+    
+    invoice.status = "written_off"
+    invoice.written_off_at = now()
+    
+    emit("invoice_written_off", invoice.id, amount=float(amount_written_off.cents / 100))
+    
+    return amount_written_off
