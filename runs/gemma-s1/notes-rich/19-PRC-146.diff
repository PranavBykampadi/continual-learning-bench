diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_write_off.py b/tests/unit/test_write_off.py
--- a/tests/unit/test_write_off.py	1969-12-31 19:00:00
+++ b/tests/unit/test_write_off.py	2026-11-11 18:13:37
@@ -0,0 +1,38 @@
+import pytest
+from parcelo.store import db
+from parcelo.models import Invoice
+from parcelo.invoices import write_off
+from parcelo.errors import DomainError
+from parcelo.money import Money
+from parcelo.events import OUTBOX
+
+def test_write_off_success():
+    db.invoices.clear()
+    OUTBOX.clear()
+    inv_id = "INV-123"
+    db.invoices[inv_id] = Invoice(id=inv_id, shipment_id="SHP-1", amount=100.50, status="open")
+    
+    amount = write_off(inv_id)
+    
+    invoice = db.invoices[inv_id]
+    assert invoice.status == "written_off"
+    assert invoice.written_off_at is not None
+    assert amount == Money.parse(100.50)
+    assert len(OUTBOX) == 1
+    assert OUTBOX[0]["name"] == "invoice_written_off"
+    assert OUTBOX[0]["entity_id"] == inv_id
+
+def test_write_off_not_open():
+    db.invoices.clear()
+    inv_id = "INV-123"
+    db.invoices[inv_id] = Invoice(id=inv_id, shipment_id="SHP-1", amount=100.50, status="paid")
+    
+    with pytest.raises(DomainError) as excinfo:
+        write_off(inv_id)
+    assert excinfo.value.code == "E_INVOICE_NOT_OPEN"
+
+def test_write_off_not_found():
+    db.invoices.clear()
+    with pytest.raises(DomainError) as excinfo:
+        write_off("NON-EXISTENT")
+    assert excinfo.value.code == "E_NOT_FOUND"
