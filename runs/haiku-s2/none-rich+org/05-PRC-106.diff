 def open_invoices():
     return [i for i in db.invoices.values() if i.status == "open"]
+
+
+def late_fee_for(invoice_id):
+    """Late fee picked up by an invoice so far, as Money.
+
+    The invoice is late LATE_AFTER_DAYS days after it was issued. From then on
+    the fee is 1.5% of the invoice amount for each full day past that point.
+    """
+    if invoice_id not in db.invoices:
+        raise DomainError("E_NOT_FOUND", "no invoice %s" % invoice_id)
+    invoice = db.invoices[invoice_id]
+
+    issued = invoice.issued_at
+    if issued.tzinfo is None:
+        # issue_invoice still stores naive UTC timestamps; clock.now() is aware.
+        issued = issued.replace(tzinfo=timezone.utc)
+    elapsed_days = (clock.now() - issued).days
+    days_late = elapsed_days - LATE_AFTER_DAYS
+    if days_late <= 0:
+        return Money.zero()
+
+    amount = Money.parse(invoice.amount)
+    return amount.scale(LATE_FEE_PER_DAY * days_late)
