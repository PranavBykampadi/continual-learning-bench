-from parcelo import customers, invoices, shipments
+from datetime import datetime, timedelta, timezone
 
+import pytest
 
+from parcelo import clock, customers, invoices, shipments
+from parcelo.errors import DomainError
+from parcelo.money import Money
+
+
 def test_issue_and_pay():
     c = customers.add_customer("Acme")
     s = shipments.create_shipment(c.id, 2, "local")
     inv = invoices.issue_invoice(s.id)
     assert inv.amount == 7.0
     assert invoices.mark_paid(inv.id).status == "paid"
+
+
+def _issued_invoice(days_after_issue):
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 2, "local")
+    inv = invoices.issue_invoice(s.id)
+    inv.issued_at = datetime(2026, 1, 1, tzinfo=timezone.utc)
+    clock.set_fixed(inv.issued_at + timedelta(days=days_after_issue))
+    return inv
+
+
+def test_late_fee_zero_before_thirty_days():
+    inv = _issued_invoice(29)
+    assert invoices.late_fee_for(inv.id) == Money.zero()
+
+
+def test_late_fee_zero_on_day_thirty():
+    inv = _issued_invoice(30)
+    assert invoices.late_fee_for(inv.id) == Money.zero()
+
+
+def test_late_fee_one_day_past_thirty():
+    inv = _issued_invoice(31)
+    # 7.00 * 1.5% * 1 day
+    assert invoices.late_fee_for(inv.id) == Money(11)
+
+
+def test_late_fee_accumulates_per_day():
+    inv = _issued_invoice(32)
+    # 7.00 * 1.5% * 2 days = 0.21
+    assert invoices.late_fee_for(inv.id) == Money(21)
+
+
+def test_late_fee_accepts_naive_issued_at():
+    inv = _issued_invoice(32)
+    inv.issued_at = inv.issued_at.replace(tzinfo=None)
+    assert invoices.late_fee_for(inv.id) == Money(21)
+
+
+def test_late_fee_unknown_invoice_raises():
+    with pytest.raises(DomainError) as exc:
+        invoices.late_fee_for("INV-missing")
+    assert exc.value.code == "E_NOT_FOUND"
