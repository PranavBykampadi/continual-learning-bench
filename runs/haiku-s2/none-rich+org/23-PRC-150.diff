diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_customers.py b/tests/unit/test_customers.py
--- a/tests/unit/test_customers.py	1969-12-31 19:00:00
+++ b/tests/unit/test_customers.py	2026-11-10 14:58:45
@@ -0,0 +1,34 @@
+import pytest
+
+from parcelo import audit, customers
+from parcelo.errors import DomainError
+from parcelo.store import db
+
+
+def test_set_credit_limit_updates_and_returns_new_limit():
+    c = customers.add_customer("Acme")
+    assert customers.set_credit_limit(c.id, 1200) == 1200
+    assert db.customers[c.id].credit_limit == 1200
+
+
+def test_set_credit_limit_is_audited():
+    c = customers.add_customer("Acme")
+    customers.set_credit_limit(c.id, 900)
+    assert audit.LOG[-1]["action"] == "customer.credit_limit_set"
+    assert audit.LOG[-1]["entity_id"] == c.id
+    assert audit.LOG[-1]["details"] == {"credit_limit": 900}
+
+
+def test_set_credit_limit_unknown_customer():
+    with pytest.raises(DomainError) as err:
+        customers.set_credit_limit("nope", 100)
+    assert err.value.code == "E_UNKNOWN_CUSTOMER"
+
+
+def test_set_credit_limit_negative_amount_rejected():
+    c = customers.add_customer("Acme")
+    before = db.customers[c.id].credit_limit
+    with pytest.raises(DomainError) as err:
+        customers.set_credit_limit(c.id, -1)
+    assert err.value.code == "E_BAD_INPUT"
+    assert db.customers[c.id].credit_limit == before
