+def set_credit_limit(customer_id, amount):
+    """Set a customer's credit limit.
+
+    Args:
+        customer_id: ID of the customer to update.
+        amount: New credit limit in dollars. Must not be negative.
+
+    Returns:
+        The customer's new credit limit.
+
+    Raises:
+        DomainError: E_UNKNOWN_CUSTOMER if the customer does not exist,
+            E_BAD_INPUT if the amount is negative.
+    """
+    if customer_id not in db.customers:
+        raise DomainError("E_UNKNOWN_CUSTOMER", customer_id)
+    if amount < 0:
+        raise DomainError("E_BAD_INPUT", "credit limit must not be negative")
+    customer = db.customers[customer_id]
+    customer.credit_limit = amount
+    audit.record("customer.credit_limit_set", customer_id, credit_limit=amount)
+    return customer.credit_limit
 
 
