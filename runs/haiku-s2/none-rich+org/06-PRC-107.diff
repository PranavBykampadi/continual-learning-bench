+from parcelo import audit, clock, customers, shipments
 from parcelo.errors import DomainError
 
 
@@ -15,3 +17,39 @@
     with pytest.raises(DomainError) as err:
         shipments.create_shipment("nope", 1, "local")
     assert err.value.code == "E_UNKNOWN_CUSTOMER"
+
+
+def test_mark_delivered_sets_status_and_time():
+    clock.set_fixed(datetime(2026, 11, 10, 12, 0, tzinfo=timezone.utc))
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 1, "local")
+    result = shipments.mark_delivered(s.id)
+    assert result is s
+    assert s.status == "delivered"
+    assert s.delivered_at == datetime(2026, 11, 10, 12, 0, tzinfo=timezone.utc)
+    assert audit.LOG[-1]["action"] == "shipment.delivered"
+
+
+def test_mark_delivered_unknown_shipment():
+    with pytest.raises(DomainError) as err:
+        shipments.mark_delivered("shp_missing")
+    assert err.value.code == "E_NOT_FOUND"
+
+
+def test_mark_delivered_twice_fails():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 1, "local")
+    shipments.mark_delivered(s.id)
+    with pytest.raises(DomainError) as err:
+        shipments.mark_delivered(s.id)
+    assert err.value.code == "E_BAD_STATE"
+
+
+def test_mark_delivered_cancelled_fails():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 1, "local")
+    s.status = "cancelled"
+    with pytest.raises(DomainError) as err:
+        shipments.mark_delivered(s.id)
+    assert err.value.code == "E_BAD_STATE"
+    assert s.delivered_at is None
