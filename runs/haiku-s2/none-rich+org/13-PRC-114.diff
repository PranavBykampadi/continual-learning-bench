diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/test_reports.py b/tests/test_reports.py
--- a/tests/test_reports.py	1969-12-31 19:00:00
+++ b/tests/test_reports.py	2026-11-10 14:53:22
@@ -0,0 +1,35 @@
+from datetime import datetime, timedelta, timezone
+
+from parcelo import clock, reports, store
+from parcelo.models import Invoice
+
+NOW = datetime(2026, 11, 10, 12, 0, tzinfo=timezone.utc)
+
+
+def _invoice(inv_id, amount, days_old, status="open"):
+    issued = NOW.replace(tzinfo=None) - timedelta(days=days_old)
+    store.db.invoices[inv_id] = Invoice(
+        id=inv_id, shipment_id="S", amount=amount, status=status, issued_at=issued
+    )
+
+
+def test_aging_report_buckets_open_invoices():
+    clock.set_fixed(NOW)
+    _invoice("a", 10.0, 0)
+    _invoice("b", 20.0, 30)
+    _invoice("c", 5.0, 31)
+    _invoice("d", 7.5, 60)
+    _invoice("e", 100.0, 61)
+    assert reports.aging_report() == {"0-30": 30.0, "31-60": 12.5, "60+": 100.0}
+
+
+def test_aging_report_skips_paid_and_empty_buckets_are_zero():
+    clock.set_fixed(NOW)
+    _invoice("paid-old", 999.0, 90, status="paid")
+    _invoice("new", 4.0, 2)
+    assert reports.aging_report() == {"0-30": 4.0, "31-60": 0.0, "60+": 0.0}
+
+
+def test_aging_report_empty():
+    clock.set_fixed(NOW)
+    assert reports.aging_report() == {"0-30": 0.0, "31-60": 0.0, "60+": 0.0}
