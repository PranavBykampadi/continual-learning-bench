+def aging_report():
+    """Total open invoice amounts bucketed by age in whole days since issue."""
+    # Invoices are stamped with naive UTC (datetime.utcnow), so compare against
+    # naive UTC too; passing `end` explicitly avoids days_between's local-time default.
+    now = clock.now().replace(tzinfo=None)
+    buckets = {"0-30": 0.0, "31-60": 0.0, "60+": 0.0}
+    for invoice in db.invoices.values():
+        if invoice.status == "paid":
+            continue
+        age = max(days_between(invoice.issued_at, now), 0)
+        if age <= 30:
+            key = "0-30"
+        elif age <= 60:
+            key = "31-60"
+        else:
+            key = "60+"
+        buckets[key] += invoice.amount
+    return {key: round(total, 2) for key, total in buckets.items()}
 
 
