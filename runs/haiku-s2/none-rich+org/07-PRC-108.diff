+from parcelo import customers, invoices, reports, shipments
+
+
+def test_outstanding_by_customer_counts_only_open_invoices():
+    acme = customers.add_customer("Acme")
+    globex = customers.add_customer("Globex")
+
+    s1 = shipments.create_shipment(acme.id, 2, "local")
+    s2 = shipments.create_shipment(acme.id, 2, "local")
+    s3 = shipments.create_shipment(globex.id, 2, "local")
+
+    open_inv = invoices.issue_invoice(s1.id)
+    paid_inv = invoices.issue_invoice(s2.id)
+    globex_inv = invoices.issue_invoice(s3.id)
+    invoices.mark_paid(paid_inv.id)
+
+    result = reports.outstanding_by_customer()
+
+    assert result[acme.id] == open_inv.amount
+    assert result[globex.id] == globex_inv.amount
+
+
+def test_outstanding_by_customer_includes_customers_with_nothing_open():
+    acme = customers.add_customer("Acme")
+    s = shipments.create_shipment(acme.id, 2, "local")
+    invoices.mark_paid(invoices.issue_invoice(s.id).id)
+
+    assert reports.outstanding_by_customer() == {acme.id: 0.0}
+
+
+def test_outstanding_by_customer_sums_multiple_open_invoices():
+    acme = customers.add_customer("Acme")
+    s1 = shipments.create_shipment(acme.id, 2, "local")
+    s2 = shipments.create_shipment(acme.id, 2, "local")
+    a = invoices.issue_invoice(s1.id)
+    b = invoices.issue_invoice(s2.id)
+
+    assert reports.outstanding_by_customer()[acme.id] == round(a.amount + b.amount, 2)
