@@ -0,0 +1,40 @@
+"""Customer claims against delivered shipments."""
+from parcelo import audit, clock, ids
+from parcelo.errors import DomainError
+from parcelo.models import Claim
+from parcelo.shipments import get_shipment
+from parcelo.store import db
+
+
+def file_claim(shipment_id: str, amount: float, reason: str) -> Claim:
+    """File a claim against a delivered shipment.
+
+    Args:
+        shipment_id: Id of the delivered shipment the claim is about.
+        amount: Amount claimed back, in dollars. Must be positive.
+        reason: Free-text reason for the claim. Must not be blank.
+
+    Returns:
+        The stored Claim.
+
+    Raises:
+        DomainError: E_NOT_FOUND if the shipment does not exist, E_BAD_STATE if
+            it has not been delivered, E_BAD_INPUT if amount or reason is invalid.
+    """
+    shipment = get_shipment(shipment_id)
+    if shipment.status != "delivered":
+        raise DomainError("E_BAD_STATE", f"{shipment_id} is {shipment.status}")
+    if isinstance(amount, bool) or not isinstance(amount, (int, float)) or amount <= 0:
+        raise DomainError("E_BAD_INPUT", f"amount must be positive: {amount!r}")
+    if not isinstance(reason, str) or not reason.strip():
+        raise DomainError("E_BAD_INPUT", "reason required")
+    claim = Claim(
+        id=ids.new_id("clm"),
+        shipment_id=shipment_id,
+        amount=amount,
+        reason=reason,
+        filed_at=clock.now(),
+    )
+    db.claims[claim.id] = claim
+    audit.record("claim.filed", claim.id, shipment_id=shipment_id, amount=amount)
+    return claim
