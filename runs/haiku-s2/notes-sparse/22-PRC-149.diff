@@ -15,3 +15,61 @@
     with pytest.raises(DomainError) as err:
         shipments.create_shipment("nope", 1, "local")
     assert err.value.code == "E_UNKNOWN_CUSTOMER"
+
+
+def test_split_creates_parts_and_marks_original():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 3.0, "national")
+    parts = shipments.split_shipment(s.id, [1.0, 2.0])
+    assert [p.weight_kg for p in parts] == [1.0, 2.0]
+    assert all(p.customer_id == c.id and p.zone == "national" for p in parts)
+    assert all(p.status == "created" for p in parts)
+    assert s.status == "split"
+
+
+def test_split_float_weights_sum_check():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 0.3, "local")
+    assert len(shipments.split_shipment(s.id, [0.1, 0.2])) == 2
+
+
+def test_split_unknown_shipment():
+    with pytest.raises(DomainError) as err:
+        shipments.split_shipment("shp_999999", [1])
+    assert err.value.code == "E_NOT_FOUND"
+
+
+def test_split_requires_created_status():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 2, "local")
+    s.status = "delivered"
+    with pytest.raises(DomainError) as err:
+        shipments.split_shipment(s.id, [1, 1])
+    assert err.value.code == "E_BAD_STATE"
+
+
+def test_split_weight_mismatch_creates_nothing():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 2, "local")
+    with pytest.raises(DomainError) as err:
+        shipments.split_shipment(s.id, [1, 0.5])
+    assert err.value.code == "E_BAD_WEIGHT"
+    assert len(store.db.shipments) == 1
+    assert s.status == "created"
+
+
+def test_split_bad_weight_creates_nothing():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 2, "local")
+    with pytest.raises(DomainError) as err:
+        shipments.split_shipment(s.id, [3, -1])
+    assert err.value.code == "E_BAD_WEIGHT"
+    assert len(store.db.shipments) == 1
+
+
+def test_split_empty_weights():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 2, "local")
+    with pytest.raises(DomainError) as err:
+        shipments.split_shipment(s.id, [])
+    assert err.value.code == "E_BAD_INPUT"
