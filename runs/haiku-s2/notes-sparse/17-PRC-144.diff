diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/parcelo/rates.py b/parcelo/rates.py
--- a/parcelo/rates.py	2026-11-10 12:17:53
+++ b/parcelo/rates.py	2026-11-10 13:02:04
@@ -12,3 +12,19 @@
     if weight_kg <= 0:
         raise ValueError("weight must be positive")
     return round(base_rate(zone) + PER_KG * weight_kg, 2)
+
+
+# Same percentages as legacy.billing.fuel_surcharge.
+FUEL_SURCHARGE_PCT = {"local": 0.0, "national": 4.0, "international": 9.5}
+INSURANCE_PCT = 2.0
+INSURANCE_MIN_FEE = 1.00
+
+
+def insurance_fee(declared_value, zone):
+    if zone not in FUEL_SURCHARGE_PCT:
+        raise ValueError("unknown zone: %s" % zone)
+    if declared_value <= 0:
+        raise ValueError("declared value must be positive")
+    pct = INSURANCE_PCT + FUEL_SURCHARGE_PCT[zone]
+    fee = round(declared_value * pct / 100.0, 2)
+    return max(fee, INSURANCE_MIN_FEE)
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/test_rates.py b/tests/test_rates.py
--- a/tests/test_rates.py	2026-11-10 12:17:53
+++ b/tests/test_rates.py	2026-11-10 13:02:08
@@ -10,3 +10,41 @@
 def test_unknown_zone():
     with pytest.raises(ValueError):
         rates.base_rate("moon")
+
+
+def test_insurance_fee_local():
+    # 2% of 1000 with no fuel surcharge
+    assert rates.insurance_fee(1000, "local") == 20.0
+
+
+def test_insurance_fee_international_includes_fuel_surcharge():
+    # 2% + 9.5% of 1000 = 115.00
+    assert rates.insurance_fee(1000, "international") == 115.0
+
+
+def test_insurance_fee_national():
+    # 2% + 4% of 250 = 15.00
+    assert rates.insurance_fee(250, "national") == 15.0
+
+
+def test_insurance_fee_minimum():
+    # 2% of 10 is 0.20, so the 1.00 minimum applies
+    assert rates.insurance_fee(10, "local") == 1.0
+
+
+def test_insurance_fee_rounds_to_cents():
+    # 2% of 33.33 = 0.6666 -> 0.67, minimum applies -> 1.00
+    assert rates.insurance_fee(33.33, "local") == 1.0
+    # 2% of 1234.56 = 24.6912 -> 24.69
+    assert rates.insurance_fee(1234.56, "local") == 24.69
+
+
+def test_insurance_fee_unknown_zone():
+    with pytest.raises(ValueError):
+        rates.insurance_fee(100, "moon")
+
+
+@pytest.mark.parametrize("value", [0, -5])
+def test_insurance_fee_non_positive_value(value):
+    with pytest.raises(ValueError):
+        rates.insurance_fee(value, "local")
