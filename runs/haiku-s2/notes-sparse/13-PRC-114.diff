+def aging_report():
+    """Total amount of open invoices per age bucket, by whole days since issue.
+
+    issued_at is stored as naive UTC (see invoices.issue_invoice), so the
+    current time is taken as naive UTC as well to keep the subtraction valid.
+    """
+    now = clock.now()
+    if now.tzinfo is not None:
+        now = now.replace(tzinfo=None)
+
+    buckets = {"0-30": [], "31-60": [], "60+": []}
+    for invoice in db.invoices.values():
+        if invoice.status != "open":
+            continue
+        age = days_between(invoice.issued_at, now)
+        if age <= 30:
+            buckets["0-30"].append(invoice.amount)
+        elif age <= 60:
+            buckets["31-60"].append(invoice.amount)
+        else:
+            buckets["60+"].append(invoice.amount)
+
+    return {key: round(sum(amounts), 2) for key, amounts in buckets.items()}
 
 
