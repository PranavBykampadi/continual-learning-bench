diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/test_reports.py b/tests/test_reports.py
--- a/tests/test_reports.py	1969-12-31 19:00:00
+++ b/tests/test_reports.py	2026-11-10 12:59:09
@@ -0,0 +1,45 @@
+from datetime import datetime, timedelta
+
+from parcelo import clock, reports
+from parcelo.models import Invoice
+from parcelo.store import db
+
+NOW = datetime(2026, 11, 10, 12, 0, 0)
+
+
+def _add(inv_id, amount, days_old, status="open"):
+    db.invoices[inv_id] = Invoice(
+        id=inv_id,
+        shipment_id="SHP-1",
+        amount=amount,
+        status=status,
+        issued_at=NOW - timedelta(days=days_old),
+    )
+
+
+def test_aging_report_empty():
+    clock.set_fixed(NOW)
+    assert reports.aging_report() == {"0-30": 0, "31-60": 0, "60+": 0}
+
+
+def test_aging_report_buckets():
+    clock.set_fixed(NOW)
+    _add("a", 10.0, 0)
+    _add("b", 5.5, 30)
+    _add("c", 20.0, 31)
+    _add("d", 7.25, 60)
+    _add("e", 100.0, 61)
+    _add("f", 1.0, 400)
+    assert reports.aging_report() == {
+        "0-30": 15.5,
+        "31-60": 27.25,
+        "60+": 101.0,
+    }
+
+
+def test_aging_report_excludes_paid_and_void():
+    clock.set_fixed(NOW)
+    _add("open1", 10.0, 5)
+    _add("paid1", 50.0, 5, status="paid")
+    _add("void1", 75.0, 90, status="void")
+    assert reports.aging_report() == {"0-30": 10.0, "31-60": 0, "60+": 0}
