@@ -1,4 +1,7 @@
+import pytest
+
 from parcelo import customers, invoices, shipments
+from parcelo.errors import DomainError
 
 
 def test_issue_and_pay():
@@ -7,3 +10,66 @@
     inv = invoices.issue_invoice(s.id)
     assert inv.amount == 7.0
     assert invoices.mark_paid(inv.id).status == "paid"
+
+
+def _open_invoice(weight=2, zone="local"):
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, weight, zone)
+    return c, invoices.issue_invoice(s.id)
+
+
+def test_apply_credit_reduces_open_invoice():
+    c, inv = _open_invoice()
+    assert invoices.apply_credit(inv.id, 2.5) == 4.5
+    assert inv.amount == 4.5
+    assert inv.status == "open"
+    assert customers.outstanding_balance(c.id) == 4.5
+
+
+def test_apply_credit_flows_into_revenue_once_paid():
+    from parcelo import reports
+
+    _, inv = _open_invoice()
+    invoices.apply_credit(inv.id, 1)
+    invoices.mark_paid(inv.id)
+    assert reports.revenue_total() == 6.0
+
+
+def test_apply_credit_missing_invoice_fails():
+    with pytest.raises(DomainError) as err:
+        invoices.apply_credit("INV-missing", 1)
+    assert err.value.code == "E_NOT_FOUND"
+
+
+def test_apply_credit_to_paid_invoice_fails():
+    _, inv = _open_invoice()
+    invoices.mark_paid(inv.id)
+    with pytest.raises(DomainError) as err:
+        invoices.apply_credit(inv.id, 1)
+    assert err.value.code == "E_BAD_STATE"
+    assert inv.amount == 7.0
+
+
+def test_apply_credit_to_void_invoice_fails():
+    _, inv = _open_invoice()
+    inv.status = "void"
+    with pytest.raises(DomainError) as err:
+        invoices.apply_credit(inv.id, 1)
+    assert err.value.code == "E_BAD_STATE"
+
+
+def test_apply_credit_larger_than_amount_fails():
+    _, inv = _open_invoice()
+    with pytest.raises(DomainError) as err:
+        invoices.apply_credit(inv.id, 7.01)
+    assert err.value.code == "E_BAD_INPUT"
+    assert inv.amount == 7.0
+
+
+def test_apply_credit_non_positive_fails():
+    _, inv = _open_invoice()
+    for bad in (0, -1):
+        with pytest.raises(DomainError) as err:
+            invoices.apply_credit(inv.id, bad)
+        assert err.value.code == "E_BAD_INPUT"
+    assert inv.amount == 7.0
