diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/test_refunds.py b/tests/test_refunds.py
--- a/tests/test_refunds.py	1969-12-31 19:00:00
+++ b/tests/test_refunds.py	2026-11-10 12:52:36
@@ -0,0 +1,49 @@
+import pytest
+
+from parcelo import audit, customers, invoices, refunds, shipments, store
+from parcelo.errors import DomainError
+
+
+def _paid_invoice():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 2, "local")
+    inv = invoices.issue_invoice(s.id)
+    invoices.mark_paid(inv.id)
+    return inv
+
+
+def test_refund_paid_invoice():
+    inv = _paid_invoice()
+    r = refunds.create_refund(inv.id, 3.5)
+    assert r.invoice_id == inv.id
+    assert r.amount == 3.5
+    assert r.id
+    assert r.created_at is not None
+    assert store.db.refunds[r.id] is r
+    assert audit.LOG[-1]["action"] == "refund.created"
+
+
+def test_refund_unknown_invoice_fails():
+    with pytest.raises(DomainError) as err:
+        refunds.create_refund("INV-missing", 1.0)
+    assert err.value.code == "E_NOT_FOUND"
+    assert store.db.refunds == {}
+
+
+def test_refund_unpaid_invoice_fails():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 2, "local")
+    inv = invoices.issue_invoice(s.id)
+    with pytest.raises(DomainError) as err:
+        refunds.create_refund(inv.id, 1.0)
+    assert err.value.code == "E_BAD_STATE"
+    assert store.db.refunds == {}
+
+
+def test_refund_nonpositive_amount_fails():
+    inv = _paid_invoice()
+    for bad in (0, -1.0):
+        with pytest.raises(DomainError) as err:
+            refunds.create_refund(inv.id, bad)
+        assert err.value.code == "E_BAD_INPUT"
+    assert store.db.refunds == {}
