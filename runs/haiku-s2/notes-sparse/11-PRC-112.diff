diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_claims.py b/tests/unit/test_claims.py
--- a/tests/unit/test_claims.py	1969-12-31 19:00:00
+++ b/tests/unit/test_claims.py	2026-11-10 12:57:29
@@ -0,0 +1,55 @@
+import pytest
+
+from parcelo import audit, claims, customers, shipments
+from parcelo.errors import DomainError
+from parcelo.store import db
+
+
+def _delivered_shipment():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 1.5, "national")
+    # There is no delivery API yet, so set the state directly.
+    s.status = "delivered"
+    return s
+
+
+def test_file_claim_on_delivered_shipment():
+    s = _delivered_shipment()
+    claim = claims.file_claim(s.id, 25.0, "damaged in transit")
+    assert claim.id.startswith("clm_")
+    assert claim.shipment_id == s.id
+    assert claim.amount == 25.0
+    assert claim.reason == "damaged in transit"
+    assert claim.filed_at is not None
+    assert db.claims[claim.id] is claim
+
+
+def test_file_claim_records_audit():
+    s = _delivered_shipment()
+    claim = claims.file_claim(s.id, 10, "late")
+    assert audit.LOG[-1]["action"] == "claim.filed"
+    assert audit.LOG[-1]["entity_id"] == claim.id
+
+
+def test_unknown_shipment():
+    with pytest.raises(DomainError) as err:
+        claims.file_claim("shp_missing", 10, "lost")
+    assert err.value.code == "E_NOT_FOUND"
+
+
+def test_shipment_not_delivered():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 1.5, "national")
+    with pytest.raises(DomainError) as err:
+        claims.file_claim(s.id, 10, "lost")
+    assert err.value.code == "E_BAD_STATE"
+    assert db.claims == {}
+
+
+@pytest.mark.parametrize("amount", [0, -5, -0.01, float("nan"), float("inf"), None, "10", True])
+def test_non_positive_or_invalid_amount(amount):
+    s = _delivered_shipment()
+    with pytest.raises(DomainError) as err:
+        claims.file_claim(s.id, amount, "bad")
+    assert err.value.code == "E_BAD_INPUT"
+    assert db.claims == {}
