+def write_off(invoice_id):
+    if invoice_id not in db.invoices:
+        raise KeyError(invoice_id)
+    invoice = db.invoices[invoice_id]
+    if invoice.status != "open":
+        raise DomainError(
+            "E_BAD_STATE",
+            f"invoice {invoice_id} is {invoice.status}, only open invoices can be written off",
+        )
+    invoice.status = "written_off"
+    invoice.written_off_at = datetime.utcnow()
+    return invoice.amount
 
 
