 def open_invoices():
     return [i for i in db.invoices.values() if i.status == "open"]
+
+
+def late_fee_for(invoice_id):
+    """Late fee for an invoice: 1.5% of its amount per day past the 30-day grace period.
+
+    Returns 0.0 if the invoice is not late yet. Raises DomainError(E_NOT_FOUND)
+    if the invoice does not exist.
+    """
+    if invoice_id not in db.invoices:
+        raise DomainError("E_NOT_FOUND", invoice_id)
+    invoice = db.invoices[invoice_id]
+    # issued_at is stored as naive UTC (see issue_invoice), so compare in naive UTC.
+    age = datetime.utcnow() - invoice.issued_at
+    days_late = age.days - LATE_AFTER_DAYS
+    return late_fee(invoice.amount, days_late)
