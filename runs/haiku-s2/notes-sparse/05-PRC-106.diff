+
+def _issued_days_ago(days):
+    c = customers.add_customer("Late Co")
+    s = shipments.create_shipment(c.id, 2, "local")
+    inv = invoices.issue_invoice(s.id)
+    inv.issued_at = datetime.utcnow() - timedelta(days=days)
+    return inv
+
+
+def test_late_fee_zero_before_grace_period():
+    inv = _issued_days_ago(10)
+    assert invoices.late_fee_for(inv.id) == 0.0
+
+
+def test_late_fee_zero_on_day_30():
+    inv = _issued_days_ago(30)
+    assert invoices.late_fee_for(inv.id) == 0.0
+
+
+def test_late_fee_accrues_per_day_after_30():
+    inv = _issued_days_ago(40)  # 10 days late
+    # amount 7.0 * 1.5% * 10 days = 1.05
+    assert invoices.late_fee_for(inv.id) == pytest.approx(1.05)
+
+
+def test_late_fee_unknown_invoice_raises():
+    with pytest.raises(DomainError) as err:
+        invoices.late_fee_for("INV-missing")
+    assert err.value.code == "E_NOT_FOUND"
