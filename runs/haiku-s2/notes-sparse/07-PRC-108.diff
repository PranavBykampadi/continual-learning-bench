+def outstanding_by_customer():
+    """Map each customer id to the total of their open invoices.
+
+    Invoices don't reference a customer directly, so each one is resolved
+    through its shipment. Every known customer appears in the result, with
+    0.0 when they have no open invoices. Paid and void invoices are excluded.
+    """
+    totals = {customer_id: 0.0 for customer_id in db.customers}
+    for invoice in db.invoices.values():
+        if invoice.status != "open":
+            continue
+        customer_id = db.shipments[invoice.shipment_id].customer_id
+        totals[customer_id] = totals.get(customer_id, 0.0) + invoice.amount
+    return {customer_id: round(total, 2) for customer_id, total in totals.items()}
+
