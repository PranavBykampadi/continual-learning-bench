diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/test_reports.py b/tests/test_reports.py
--- a/tests/test_reports.py	1969-12-31 19:00:00
+++ b/tests/test_reports.py	2026-11-10 12:54:30
@@ -0,0 +1,53 @@
+from parcelo import customers, invoices, reports, shipments
+
+
+def _invoice_for(customer_id, weight, zone="local"):
+    s = shipments.create_shipment(customer_id, weight, zone)
+    return invoices.issue_invoice(s.id)
+
+
+def test_outstanding_excludes_paid_and_void():
+    c = customers.add_customer("Acme")
+    open_inv = _invoice_for(c.id, 2)
+    paid_inv = _invoice_for(c.id, 2)
+    void_inv = _invoice_for(c.id, 2)
+    invoices.mark_paid(paid_inv.id)
+    void_inv.status = "void"
+
+    result = reports.outstanding_by_customer()
+
+    assert result[c.id] == round(open_inv.amount, 2)
+
+
+def test_outstanding_sums_multiple_open_invoices_per_customer():
+    c = customers.add_customer("Acme")
+    a = _invoice_for(c.id, 2)
+    b = _invoice_for(c.id, 2)
+
+    result = reports.outstanding_by_customer()
+
+    assert result[c.id] == round(a.amount + b.amount, 2)
+
+
+def test_customers_are_kept_separate():
+    a = customers.add_customer("Acme")
+    b = customers.add_customer("Globex")
+    inv_a = _invoice_for(a.id, 2)
+    inv_b = _invoice_for(b.id, 5)
+
+    result = reports.outstanding_by_customer()
+
+    assert result[a.id] == round(inv_a.amount, 2)
+    assert result[b.id] == round(inv_b.amount, 2)
+
+
+def test_customer_without_open_invoices_reports_zero():
+    c = customers.add_customer("Acme")
+    inv = _invoice_for(c.id, 2)
+    invoices.mark_paid(inv.id)
+
+    assert reports.outstanding_by_customer() == {c.id: 0.0}
+
+
+def test_empty_when_no_customers():
+    assert reports.outstanding_by_customer() == {}
