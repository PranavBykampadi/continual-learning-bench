+def aging_report():
+    """Total open invoice amounts bucketed by age in whole days since issue."""
+    # Invoices are stamped with naive UTC (see invoices.issue_invoice), so measure
+    # against naive UTC too; the default end of days_between is local time.
+    now = datetime.utcnow()
+    buckets = {"0-30": 0.0, "31-60": 0.0, "60+": 0.0}
+    for invoice in db.invoices.values():
+        if invoice.status != "open":
+            continue
+        age = days_between(invoice.issued_at, now)
+        if age <= 30:
+            key = "0-30"
+        elif age <= 60:
+            key = "31-60"
+        else:
+            key = "60+"
+        buckets[key] += invoice.amount
+    return {key: round(total, 2) for key, total in buckets.items()}
 
 
