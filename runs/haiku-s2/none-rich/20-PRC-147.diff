diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/test_reports.py b/tests/test_reports.py
--- a/tests/test_reports.py	1969-12-31 19:00:00
+++ b/tests/test_reports.py	2026-11-10 12:58:21
@@ -0,0 +1,36 @@
+from parcelo import reports
+from parcelo.models import Customer, Shipment
+from parcelo.store import db
+
+
+def _add_customer(customer_id):
+    db.customers[customer_id] = Customer(id=customer_id, name=customer_id)
+
+
+def _add_shipments(customer_id, n):
+    for i in range(n):
+        sid = customer_id + "-s" + str(i)
+        db.shipments[sid] = Shipment(
+            id=sid, customer_id=customer_id, weight_kg=1.0, zone="local"
+        )
+
+
+def test_volume_report_includes_customers_without_shipments():
+    _add_customer("C1")
+    report = reports.volume_report()
+    assert report == {"C1": {"shipments": 0, "tier": "starter"}}
+
+
+def test_volume_report_counts_and_tiers():
+    _add_customer("A")
+    _add_customer("B")
+    _add_customer("C")
+    _add_shipments("A", 3)
+    _add_shipments("B", 10)
+    _add_shipments("C", 50)
+    report = reports.volume_report()
+    assert report == {
+        "A": {"shipments": 3, "tier": "starter"},
+        "B": {"shipments": 10, "tier": "regular"},
+        "C": {"shipments": 50, "tier": "bulk"},
+    }
