diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/parcelo/rates.py b/parcelo/rates.py
--- a/parcelo/rates.py	2026-11-10 12:17:53
+++ b/parcelo/rates.py	2026-11-10 12:50:21
@@ -1,3 +1,5 @@
+from parcelo.legacy.billing import FUEL_SURCHARGE_PCT
+
 ZONE_BASE = {"local": 4.5, "national": 9.0, "international": 24.0}
 PER_KG = 1.25
 
@@ -12,3 +14,15 @@
     if weight_kg <= 0:
         raise ValueError("weight must be positive")
     return round(base_rate(zone) + PER_KG * weight_kg, 2)
+
+
+def quote_with_surcharge(weight_kg, zone):
+    """Return the quote for weight and zone plus the zone's fuel surcharge.
+
+    The surcharge is a percentage of the quote, using the same percentages as
+    parcelo.legacy.billing.fuel_surcharge. Raises ValueError for an unknown
+    zone or a non-positive weight.
+    """
+    base = quote(weight_kg, zone)  # validates weight and zone
+    surcharge = round(base * FUEL_SURCHARGE_PCT[zone] / 100.0, 2)
+    return {"quote": base, "fuel_surcharge": surcharge}
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/test_rates.py b/tests/test_rates.py
--- a/tests/test_rates.py	2026-11-10 12:17:53
+++ b/tests/test_rates.py	2026-11-10 12:50:26
@@ -10,3 +10,31 @@
 def test_unknown_zone():
     with pytest.raises(ValueError):
         rates.base_rate("moon")
+
+
+def test_quote_with_surcharge_local_has_no_surcharge():
+    assert rates.quote_with_surcharge(2, "local") == {"quote": 7.0, "fuel_surcharge": 0.0}
+
+
+def test_quote_with_surcharge_national():
+    # quote = 9.0 + 1.25 * 2 = 11.5; 4% of 11.5 = 0.46
+    assert rates.quote_with_surcharge(2, "national") == {"quote": 11.5, "fuel_surcharge": 0.46}
+
+
+def test_quote_with_surcharge_international():
+    # quote = 24.0 + 1.25 * 4 = 29.0; 9.5% of 29.0 = 2.755, which rounds to 2.75 or 2.76
+    # depending on float representation, so allow either.
+    result = rates.quote_with_surcharge(4, "international")
+    assert result["quote"] == 29.0
+    assert result["fuel_surcharge"] == pytest.approx(2.755, abs=0.01)
+
+
+def test_quote_with_surcharge_unknown_zone():
+    with pytest.raises(ValueError):
+        rates.quote_with_surcharge(2, "moon")
+
+
+@pytest.mark.parametrize("weight", [0, -1])
+def test_quote_with_surcharge_non_positive_weight(weight):
+    with pytest.raises(ValueError):
+        rates.quote_with_surcharge(weight, "local")
