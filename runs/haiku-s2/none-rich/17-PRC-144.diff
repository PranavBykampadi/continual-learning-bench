         rates.base_rate("moon")
+
+
+def test_insurance_fee_local_applies_no_surcharge():
+    # 2% of 1000 = 20.00, local surcharge is 0%
+    assert rates.insurance_fee(1000, "local") == 20.0
+
+
+def test_insurance_fee_international_adds_surcharge():
+    # 2% of 1000 = 20.00, plus 9.5% of 1000 = 95.00
+    assert rates.insurance_fee(1000, "international") == 115.0
+
+
+def test_insurance_fee_minimum():
+    # 2% of 10 = 0.20, below the 1.00 minimum
+    assert rates.insurance_fee(10, "local") == 1.0
+
+
+def test_insurance_fee_unknown_zone():
+    with pytest.raises(ValueError):
+        rates.insurance_fee(100, "moon")
+
+
+@pytest.mark.parametrize("value", [0, -5])
+def test_insurance_fee_rejects_non_positive_value(value):
