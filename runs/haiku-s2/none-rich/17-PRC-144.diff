+
 ZONE_BASE = {"local": 4.5, "national": 9.0, "international": 24.0}
 PER_KG = 1.25
+INSURANCE_PCT = 2.0
+INSURANCE_MIN_FEE = 1.00
 
 
 def base_rate(zone):
@@ -12,3 +16,19 @@
     if weight_kg <= 0:
         raise ValueError("weight must be positive")
     return round(base_rate(zone) + PER_KG * weight_kg, 2)
+
+
+def insurance_fee(declared_value, zone):
+    """Insurance fee for a shipment with a declared value.
+
+    2% of the declared value plus the zone's fuel surcharge percentage of the
+    declared value, with a minimum fee of INSURANCE_MIN_FEE.
+    """
+    if declared_value <= 0:
+        raise ValueError("declared value must be positive")
+    try:
+        surcharge = fuel_surcharge(declared_value, zone)
+    except KeyError:
+        raise ValueError("unknown zone: %s" % zone)
+    fee = round(declared_value * INSURANCE_PCT / 100.0 + surcharge, 2)
+    return max(fee, INSURANCE_MIN_FEE)
