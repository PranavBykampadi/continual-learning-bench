diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/test_reports.py b/tests/test_reports.py
--- a/tests/test_reports.py	1969-12-31 19:00:00
+++ b/tests/test_reports.py	2026-11-10 12:52:55
@@ -0,0 +1,32 @@
+from parcelo import customers, invoices, reports, shipments
+from parcelo.store import db
+
+
+def test_outstanding_by_customer_counts_only_open_invoices():
+    a = customers.add_customer("Acme")
+    b = customers.add_customer("Bolt")
+    c = customers.add_customer("Cask")
+
+    s1 = shipments.create_shipment(a.id, 2, "local")
+    s2 = shipments.create_shipment(a.id, 2, "local")
+    s3 = shipments.create_shipment(b.id, 2, "local")
+
+    open_a = invoices.issue_invoice(s1.id)
+    paid_a = invoices.issue_invoice(s2.id)
+    invoices.mark_paid(paid_a.id)
+    open_b = invoices.issue_invoice(s3.id)
+
+    void_b = invoices.issue_invoice(s3.id)
+    db.invoices[void_b.id].status = "void"
+
+    result = reports.outstanding_by_customer()
+
+    assert result == {
+        a.id: round(open_a.amount, 2),
+        b.id: round(open_b.amount, 2),
+        c.id: 0.0,
+    }
+
+
+def test_outstanding_by_customer_empty():
+    assert reports.outstanding_by_customer() == {}
