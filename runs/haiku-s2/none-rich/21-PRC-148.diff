diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/test_disputes.py b/tests/test_disputes.py
--- a/tests/test_disputes.py	1969-12-31 19:00:00
+++ b/tests/test_disputes.py	2026-11-10 12:58:56
@@ -0,0 +1,36 @@
+import pytest
+
+from parcelo.disputes import open_dispute
+from parcelo.errors import DomainError
+from parcelo.models import Invoice
+from parcelo.store import db
+
+
+def _add_invoice(invoice_id="INV-1"):
+    db.invoices[invoice_id] = Invoice(id=invoice_id, shipment_id="shp_1", amount=10.0)
+    return invoice_id
+
+
+def test_open_dispute_saves_and_returns():
+    inv = _add_invoice()
+    d = open_dispute(inv, "wrong weight")
+    assert d.invoice_id == inv
+    assert d.reason == "wrong weight"
+    assert d.opened_at is not None
+    assert db.disputes[d.id] is d
+
+
+def test_missing_invoice_fails():
+    with pytest.raises(DomainError) as exc:
+        open_dispute("INV-missing", "reason")
+    assert exc.value.code == "E_NOT_FOUND"
+    assert db.disputes == {}
+
+
+@pytest.mark.parametrize("reason", ["", "   ", None])
+def test_empty_reason_fails(reason):
+    inv = _add_invoice()
+    with pytest.raises(DomainError) as exc:
+        open_dispute(inv, reason)
+    assert exc.value.code == "E_BAD_INPUT"
+    assert db.disputes == {}
