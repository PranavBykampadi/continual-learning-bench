@@ -1,3 +1,5 @@
+import math
+
 from parcelo import clock, events, ids
 from parcelo.errors import DomainError
 from parcelo.models import Shipment
@@ -28,3 +30,31 @@
     if shipment_id not in db.shipments:
         raise DomainError("E_NOT_FOUND", shipment_id)
     return db.shipments[shipment_id]
+
+
+def split_shipment(shipment_id, weights):
+    """Replace a "created" shipment with one new shipment per weight.
+
+    All validation happens before any state changes, so a failed split
+    leaves the original shipment and the store untouched.
+    """
+    shipment = get_shipment(shipment_id)
+    if shipment.status != "created":
+        raise DomainError("E_BAD_STATE", f"{shipment_id} is {shipment.status}")
+    weights = list(weights)
+    if not weights:
+        raise DomainError("E_BAD_INPUT", "no weights given")
+    for w in weights:
+        if w <= 0:
+            raise DomainError("E_BAD_WEIGHT", str(w))
+    if not math.isclose(sum(weights), shipment.weight_kg, rel_tol=1e-9, abs_tol=1e-9):
+        raise DomainError(
+            "E_BAD_WEIGHT",
+            f"weights sum to {sum(weights)}, expected {shipment.weight_kg}",
+        )
+
+    new_shipments = [
+        create_shipment(shipment.customer_id, w, shipment.zone) for w in weights
+    ]
+    shipment.status = "split"
+    return new_shipments
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_shipments.py b/tests/unit/test_shipments.py
--- a/tests/unit/test_shipments.py	2026-11-10 12:20:18
+++ b/tests/unit/test_shipments.py	2026-11-10 12:59:23
@@ -15,3 +15,40 @@
     with pytest.raises(DomainError) as err:
         shipments.create_shipment("nope", 1, "local")
     assert err.value.code == "E_UNKNOWN_CUSTOMER"
+
+
+def test_split_creates_shipments_in_weight_order():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 5, "national")
+    parts = shipments.split_shipment(s.id, [2, 3])
+    assert [p.weight_kg for p in parts] == [2, 3]
+    assert all(p.customer_id == c.id and p.zone == "national" for p in parts)
+    assert all(p.status == "created" for p in parts)
+    assert shipments.get_shipment(s.id).status == "split"
+
+
+def test_split_unknown_shipment():
+    with pytest.raises(DomainError) as err:
+        shipments.split_shipment("nope", [1])
+    assert err.value.code == "E_NOT_FOUND"
+
+
+def test_split_requires_created_status():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 4, "local")
+    shipments.split_shipment(s.id, [1, 3])
+    with pytest.raises(DomainError) as err:
+        shipments.split_shipment(s.id, [1, 3])
+    assert err.value.code == "E_BAD_STATE"
+
+
+def test_split_weights_must_sum_to_original():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 4, "local")
+    n_before = len(shipments.db.shipments)
+    with pytest.raises(DomainError) as err:
+        shipments.split_shipment(s.id, [1, 2])
+    assert err.value.code == "E_BAD_WEIGHT"
+    # a failed split must not leave partial state behind
+    assert len(shipments.db.shipments) == n_before
+    assert shipments.get_shipment(s.id).status == "created"
