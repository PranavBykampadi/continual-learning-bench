diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_customers.py b/tests/unit/test_customers.py
--- a/tests/unit/test_customers.py	1969-12-31 19:00:00
+++ b/tests/unit/test_customers.py	2026-11-10 12:50:46
@@ -0,0 +1,32 @@
+import pytest
+
+from parcelo import customers
+from parcelo.errors import DomainError
+from parcelo.models import Customer
+from parcelo.store import db
+
+
+def _add(customer_id="C000001", active=True):
+    db.customers[customer_id] = Customer(id=customer_id, name="Acme", active=active)
+    return db.customers[customer_id]
+
+
+def test_deactivate_sets_active_false_and_returns_customer():
+    _add("C000001")
+    result = customers.deactivate_customer("C000001")
+    assert result.id == "C000001"
+    assert result.active is False
+    assert db.customers["C000001"].active is False
+
+
+def test_deactivate_unknown_customer_fails():
+    with pytest.raises(DomainError) as err:
+        customers.deactivate_customer("C999999")
+    assert err.value.code == "E_NOT_FOUND"
+
+
+def test_deactivate_already_inactive_customer_fails():
+    _add("C000002", active=False)
+    with pytest.raises(DomainError) as err:
+        customers.deactivate_customer("C000002")
+    assert err.value.code == "E_BAD_STATE"
