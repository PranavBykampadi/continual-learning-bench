+def set_credit_limit(customer_id, amount):
+    """Set a customer's credit limit and return the new limit.
+
+    Raises DomainError E_NOT_FOUND if the customer does not exist and
+    E_BAD_INPUT if the amount is negative.
+    """
+    customer = db.customers.get(customer_id)
+    if customer is None:
+        raise DomainError("E_NOT_FOUND", customer_id)
+    if amount < 0:
+        raise DomainError("E_BAD_INPUT", f"credit limit must not be negative: {amount}")
+    customer.credit_limit = amount
+    return customer.credit_limit
 
 
