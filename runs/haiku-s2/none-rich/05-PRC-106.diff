+def late_fee_for(invoice_id):
+    """Late fee picked up so far by an invoice.
+
+    The invoice is late 30 days after it was issued; from then on the fee is
+    1.5% of the invoice amount for each full day past those 30 days.
+    """
+    if invoice_id not in db.invoices:
+        raise DomainError("E_NOT_FOUND", invoice_id)
+    invoice = db.invoices[invoice_id]
+
+    now = clock.now()
+    issued = invoice.issued_at
+    # issue_invoice stores naive UTC timestamps; clock.now() is timezone-aware.
+    # Normalise so the two can be subtracted.
+    if issued.tzinfo is None and now.tzinfo is not None:
+        now = now.replace(tzinfo=None)
+    elif issued.tzinfo is not None and now.tzinfo is None:
+        now = now.replace(tzinfo=issued.tzinfo)
+
+    elapsed_days = (now - issued).days
+    days_late = elapsed_days - LATE_AFTER_DAYS
+    return _late_fee(invoice.amount, days_late)
