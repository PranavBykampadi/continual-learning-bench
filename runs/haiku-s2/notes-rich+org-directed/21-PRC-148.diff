diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_disputes.py b/tests/unit/test_disputes.py
--- a/tests/unit/test_disputes.py	1969-12-31 19:00:00
+++ b/tests/unit/test_disputes.py	2026-11-10 15:08:26
@@ -0,0 +1,47 @@
+from datetime import datetime, timezone
+
+import pytest
+
+from parcelo import clock, customers, disputes, invoices, shipments
+from parcelo.errors import DomainError
+from parcelo.store import db
+
+
+def _invoice():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 2, "local")
+    return invoices.issue_invoice(s.id)
+
+
+def test_open_dispute_stores_and_returns_it():
+    clock.set_fixed(datetime(2026, 11, 10, 9, 0, tzinfo=timezone.utc))
+    inv = _invoice()
+    d = disputes.open_dispute(inv.id, "wrong weight")
+    assert d.id.startswith("dsp_")
+    assert d.invoice_id == inv.id
+    assert d.reason == "wrong weight"
+    assert d.opened_at == datetime(2026, 11, 10, 9, 0, tzinfo=timezone.utc)
+    assert db.disputes[d.id] is d
+
+
+def test_unknown_invoice_fails():
+    with pytest.raises(DomainError) as err:
+        disputes.open_dispute("INV-missing", "wrong weight")
+    assert err.value.code == "E_NOT_FOUND"
+    assert db.disputes == {}
+
+
+@pytest.mark.parametrize("reason", ["", "   ", None, 42])
+def test_blank_or_non_text_reason_fails(reason):
+    inv = _invoice()
+    with pytest.raises(DomainError) as err:
+        disputes.open_dispute(inv.id, reason)
+    assert err.value.code == "E_BAD_INPUT"
+    assert db.disputes == {}
+
+
+def test_missing_invoice_id_fails():
+    with pytest.raises(DomainError) as err:
+        disputes.open_dispute(None, "wrong weight")
+    assert err.value.code == "E_BAD_INPUT"
+    assert db.disputes == {}
