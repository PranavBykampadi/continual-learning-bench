diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/parcelo/disputes.py b/parcelo/disputes.py
--- a/parcelo/disputes.py	1969-12-31 19:00:00
+++ b/parcelo/disputes.py	2026-11-10 15:08:24
@@ -0,0 +1,34 @@
+from parcelo import clock, ids
+from parcelo.errors import DomainError
+from parcelo.models import Dispute
+from parcelo.store import db
+
+
+def open_dispute(invoice_id, reason):
+    """Open a dispute against an invoice so finance can track it.
+
+    Args:
+        invoice_id: Id of the invoice being contested.
+        reason: Non-blank text explaining the dispute.
+
+    Returns:
+        The newly created Dispute, which is also stored in db.disputes.
+
+    Raises:
+        DomainError: E_BAD_INPUT if invoice_id or reason is missing, blank, or not text.
+        DomainError: E_NOT_FOUND if the invoice does not exist.
+    """
+    if not isinstance(invoice_id, str) or not invoice_id.strip():
+        raise DomainError("E_BAD_INPUT", "invoice_id required")
+    if not isinstance(reason, str) or not reason.strip():
+        raise DomainError("E_BAD_INPUT", "reason required")
+    if invoice_id not in db.invoices:
+        raise DomainError("E_NOT_FOUND", invoice_id)
+    dispute = Dispute(
+        id=ids.new_id("dsp"),
+        invoice_id=invoice_id,
+        reason=reason,
+        opened_at=clock.now(),
+    )
+    db.disputes[dispute.id] = dispute
+    return dispute
