+def write_off(invoice_id):
+    """Write off an open invoice that will never be collected.
+
+    Args:
+        invoice_id: Id of the invoice to write off.
+
+    Returns:
+        Money: The amount that was written off.
+
+    Raises:
+        DomainError: E_BAD_INPUT if invoice_id is missing, blank or not a string;
+            E_NOT_FOUND if no invoice has that id;
+            E_BAD_STATE if the invoice is not open.
+    """
+    if invoice_id is None or not isinstance(invoice_id, str) or not invoice_id.strip():
+        raise DomainError("E_BAD_INPUT", "invoice_id")
+    if invoice_id not in db.invoices:
+        raise DomainError("E_NOT_FOUND", invoice_id)
+    invoice = db.invoices[invoice_id]
+    if invoice.status != "open":
+        raise DomainError("E_BAD_STATE", invoice.status)
+    amount = Money.parse(invoice.amount)
+    invoice.status = "written_off"
+    invoice.written_off_at = clock.now()
+    events.emit("invoice.written_off", invoice.id, cents=amount.cents)
+    return amount
