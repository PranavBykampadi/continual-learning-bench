diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_invoices_write_off.py b/tests/unit/test_invoices_write_off.py
--- a/tests/unit/test_invoices_write_off.py	1969-12-31 19:00:00
+++ b/tests/unit/test_invoices_write_off.py	2026-11-10 15:06:54
@@ -0,0 +1,71 @@
+from datetime import datetime, timezone
+
+import pytest
+
+from parcelo import clock, customers, events, invoices, shipments
+from parcelo.errors import DomainError
+from parcelo.money import Money
+
+
+def _open_invoice():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 2, "local")
+    return invoices.issue_invoice(s.id)
+
+
+def test_write_off_open_invoice_sets_status_and_timestamp():
+    now = datetime(2026, 11, 10, 12, 0, tzinfo=timezone.utc)
+    clock.set_fixed(now)
+    inv = _open_invoice()
+    amount = invoices.write_off(inv.id)
+    assert inv.status == "written_off"
+    assert inv.written_off_at == now
+    assert amount == Money.parse(7.0)
+    assert amount.cents == 700
+
+
+def test_write_off_emits_event():
+    inv = _open_invoice()
+    events.OUTBOX.clear()
+    invoices.write_off(inv.id)
+    assert [e["name"] for e in events.OUTBOX] == ["invoice.written_off"]
+    assert events.OUTBOX[0]["entity_id"] == inv.id
+
+
+def test_write_off_paid_invoice_is_bad_state():
+    inv = _open_invoice()
+    invoices.mark_paid(inv.id)
+    with pytest.raises(DomainError) as exc:
+        invoices.write_off(inv.id)
+    assert exc.value.code == "E_BAD_STATE"
+    assert "paid" in exc.value.message
+    assert inv.status == "paid"
+
+
+def test_write_off_twice_is_bad_state():
+    inv = _open_invoice()
+    invoices.write_off(inv.id)
+    with pytest.raises(DomainError) as exc:
+        invoices.write_off(inv.id)
+    assert exc.value.code == "E_BAD_STATE"
+    assert "written_off" in exc.value.message
+
+
+def test_write_off_unknown_invoice_is_not_found():
+    with pytest.raises(DomainError) as exc:
+        invoices.write_off("INV-missing")
+    assert exc.value.code == "E_NOT_FOUND"
+
+
+@pytest.mark.parametrize("bad", [None, "", "   ", 42])
+def test_write_off_bad_input(bad):
+    with pytest.raises(DomainError) as exc:
+        invoices.write_off(bad)
+    assert exc.value.code == "E_BAD_INPUT"
+
+
+def test_failed_write_off_does_not_emit():
+    events.OUTBOX.clear()
+    with pytest.raises(DomainError):
+        invoices.write_off("INV-missing")
+    assert events.OUTBOX == []
