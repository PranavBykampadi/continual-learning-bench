diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_reports_volume.py b/tests/unit/test_reports_volume.py
--- a/tests/unit/test_reports_volume.py	1969-12-31 19:00:00
+++ b/tests/unit/test_reports_volume.py	2026-11-10 15:07:32
@@ -0,0 +1,33 @@
+from parcelo import customers, reports, shipments
+from parcelo.store import db
+
+
+def test_volume_report_counts_and_includes_idle_customers():
+    busy = customers.add_customer("Busy")
+    idle = customers.add_customer("Idle")
+    for _ in range(3):
+        shipments.create_shipment(busy.id, 1.0, "local")
+
+    report = reports.volume_report()
+
+    assert report[busy.id] == {"shipments": 3, "tier": "starter"}
+    assert report[idle.id] == {"shipments": 0, "tier": "starter"}
+    assert set(report) == set(db.customers)
+
+
+def test_volume_report_tier_thresholds():
+    regular = customers.add_customer("Regular")
+    bulk = customers.add_customer("Bulk")
+    for _ in range(10):
+        shipments.create_shipment(regular.id, 1.0, "local")
+    for _ in range(50):
+        shipments.create_shipment(bulk.id, 1.0, "local")
+
+    report = reports.volume_report()
+
+    assert report[regular.id] == {"shipments": 10, "tier": "regular"}
+    assert report[bulk.id] == {"shipments": 50, "tier": "bulk"}
+
+
+def test_volume_report_empty():
+    assert reports.volume_report() == {}
