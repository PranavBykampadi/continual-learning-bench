+def _volume_tier(shipment_count):
+    # Mirrors volume_tier in parcelo/legacy/billing.py. Not imported: legacy is slated for deletion.
+    if shipment_count >= 50:
+        return "bulk"
+    if shipment_count >= 10:
+        return "regular"
+    return "starter"
+
+
+def volume_report():
+    """Summarise shipment volume per customer.
+
+    Every customer is included, including those with no shipments.
+
+    Returns:
+        dict: maps customer id to ``{"shipments": <count>, "tier": <label>}``,
+        where the label is one of ``"bulk"``, ``"regular"`` or ``"starter"``.
+
+    Raises:
+        None: this function does not raise ``DomainError``.
+    """
+    counts = {customer_id: 0 for customer_id in db.customers}
+    for shipment in db.shipments.values():
+        if shipment.customer_id in counts:
+            counts[shipment.customer_id] += 1
+    return {
+        customer_id: {"shipments": count, "tier": _volume_tier(count)}
+        for customer_id, count in counts.items()
+    }
+
+
