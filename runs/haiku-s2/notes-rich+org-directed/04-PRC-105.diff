diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/parcelo/refunds.py b/parcelo/refunds.py
--- a/parcelo/refunds.py	1969-12-31 19:00:00
+++ b/parcelo/refunds.py	2026-11-10 14:49:10
@@ -0,0 +1,37 @@
+from parcelo import audit, clock, ids
+from parcelo.errors import DomainError
+from parcelo.models import Refund
+from parcelo.money import Money
+from parcelo.store import db
+
+
+def create_refund(invoice_id: str, amount: "Money | float | int | str") -> Refund:
+    """Record a refund against a paid invoice.
+
+    Args:
+        invoice_id: Id of the invoice being refunded. Must be paid.
+        amount: Refund amount. Floats, ints and strings are wrapped with
+            ``Money.parse``; ``Money`` values are used as-is.
+
+    Returns:
+        The stored Refund, with its id and creation time set.
+
+    Raises:
+        DomainError: ``E_NOT_FOUND`` if the invoice does not exist, or
+            ``E_BAD_STATE`` if the invoice is not paid. Nothing is stored or
+            audited on failure.
+    """
+    if invoice_id not in db.invoices:
+        raise DomainError("E_NOT_FOUND", invoice_id)
+    invoice = db.invoices[invoice_id]
+    if invoice.status != "paid":
+        raise DomainError("E_BAD_STATE", f"{invoice_id} is {invoice.status}")
+    refund = Refund(
+        id=ids.new_id("ref"),
+        invoice_id=invoice_id,
+        amount=Money.parse(amount),
+        created_at=clock.now(),
+    )
+    db.refunds[refund.id] = refund
+    audit.record("refund.created", refund.id, invoice_id=invoice_id)
+    return refund
