diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_refunds_create.py b/tests/unit/test_refunds_create.py
--- a/tests/unit/test_refunds_create.py	1969-12-31 19:00:00
+++ b/tests/unit/test_refunds_create.py	2026-11-10 14:49:17
@@ -0,0 +1,74 @@
+import pytest
+
+from parcelo import audit, clock, customers, invoices, refunds, shipments, store
+from parcelo.errors import DomainError
+from parcelo.money import Money
+
+
+@pytest.fixture
+def paid_invoice():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 2.0, "national")
+    inv = invoices.issue_invoice(s.id)
+    invoices.mark_paid(inv.id)
+    return inv
+
+
+@pytest.fixture
+def open_invoice():
+    c = customers.add_customer("Beta")
+    s = shipments.create_shipment(c.id, 1.0, "local")
+    return invoices.issue_invoice(s.id)
+
+
+def test_create_refund_happy_path(paid_invoice):
+    fixed = clock.now()
+    clock.set_fixed(fixed)
+    r = refunds.create_refund(paid_invoice.id, "12.50")
+    assert r.id.startswith("ref_")
+    assert r.invoice_id == paid_invoice.id
+    assert r.amount == Money(1250)
+    assert r.created_at == fixed
+    assert store.db.refunds[r.id] is r
+
+
+def test_create_refund_accepts_money(paid_invoice):
+    r = refunds.create_refund(paid_invoice.id, Money(999))
+    assert r.amount == Money(999)
+
+
+def test_create_refund_records_audit(paid_invoice):
+    r = refunds.create_refund(paid_invoice.id, 5)
+    assert audit.LOG[-1]["action"] == "refund.created"
+    assert audit.LOG[-1]["entity_id"] == r.id
+    assert audit.LOG[-1]["details"] == {"invoice_id": paid_invoice.id}
+
+
+def test_unknown_invoice_not_found():
+    with pytest.raises(DomainError) as err:
+        refunds.create_refund("INV-nope", 5)
+    assert err.value.code == "E_NOT_FOUND"
+    assert store.db.refunds == {}
+    assert audit.LOG == []
+
+
+def test_open_invoice_rejected(open_invoice):
+    audit_before = len(audit.LOG)
+    with pytest.raises(DomainError) as err:
+        refunds.create_refund(open_invoice.id, 5)
+    assert err.value.code == "E_BAD_STATE"
+    assert store.db.refunds == {}
+    assert len(audit.LOG) == audit_before
+    assert open_invoice.status == "open"
+
+
+def test_rejected_refund_leaves_audit_log_unchanged(paid_invoice):
+    refunds.create_refund(paid_invoice.id, 5)
+    last_before = audit.LOG[-1]
+    count_before = len(audit.LOG)
+    with pytest.raises(DomainError) as err:
+        refunds.create_refund("INV-nope", 5)
+    assert err.value.code == "E_NOT_FOUND"
+    assert len(audit.LOG) == count_before
+    assert audit.LOG[-1] is last_before
+    assert len(store.db.refunds) == 1
