     if shipment_id not in db.shipments:
         raise DomainError("E_NOT_FOUND", shipment_id)
     return db.shipments[shipment_id]
+
+
+def mark_delivered(shipment_id):
+    """Mark a shipment as delivered.
+
+    Sets the shipment status to "delivered" and stamps ``delivered_at`` with
+    the current time from ``clock.now()``. Records a ``shipment.delivered``
+    audit entry.
+
+    Args:
+        shipment_id: ID of the shipment to mark as delivered.
+
+    Returns:
+        The updated Shipment.
+
+    Raises:
+        DomainError: ``E_NOT_FOUND`` if the shipment does not exist, or
+            ``E_BAD_STATE`` if it is already delivered or cancelled. On
+            failure the shipment and the audit log are left unchanged.
+    """
+    if shipment_id not in db.shipments:
+        raise DomainError("E_NOT_FOUND", shipment_id)
+    shipment = db.shipments[shipment_id]
+    if shipment.status in ("delivered", "cancelled"):
+        raise DomainError("E_BAD_STATE", f"{shipment_id} is {shipment.status}")
+    shipment.status = "delivered"
+    shipment.delivered_at = clock.now()
+    audit.record("shipment.delivered", shipment.id)
+    return shipment
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_shipments_mark_delivered.py b/tests/unit/test_shipments_mark_delivered.py
--- a/tests/unit/test_shipments_mark_delivered.py	1969-12-31 19:00:00
+++ b/tests/unit/test_shipments_mark_delivered.py	2026-11-10 14:51:48
@@ -0,0 +1,79 @@
+from datetime import datetime, timezone
+
+import pytest
+
+from parcelo import audit, clock, customers, shipments
+from parcelo.errors import DomainError
+from parcelo.store import db
+
+
+def _new_shipment():
+    c = customers.add_customer("Acme")
+    return shipments.create_shipment(c.id, 1.5, "national")
+
+
+def test_mark_delivered_sets_status_and_timestamp():
+    moment = datetime(2026, 11, 10, 12, 30, tzinfo=timezone.utc)
+    clock.set_fixed(moment)
+    s = _new_shipment()
+
+    result = shipments.mark_delivered(s.id)
+
+    assert result is s
+    assert s.status == "delivered"
+    assert s.delivered_at == moment
+
+
+def test_mark_delivered_records_audit():
+    s = _new_shipment()
+
+    shipments.mark_delivered(s.id)
+
+    assert audit.LOG[-1]["action"] == "shipment.delivered"
+    assert audit.LOG[-1]["entity_id"] == s.id
+
+
+def test_mark_delivered_is_visible_via_get_shipment():
+    s = _new_shipment()
+
+    shipments.mark_delivered(s.id)
+
+    assert shipments.get_shipment(s.id).status == "delivered"
+    assert db.shipments[s.id].delivered_at is not None
+
+
+def test_mark_delivered_not_found():
+    with pytest.raises(DomainError) as err:
+        shipments.mark_delivered("shp_missing")
+    assert err.value.code == "E_NOT_FOUND"
+
+
+def test_mark_delivered_twice_fails_and_leaves_state_unchanged():
+    s = _new_shipment()
+    shipments.mark_delivered(s.id)
+    first_time = s.delivered_at
+    log_len = len(audit.LOG)
+    last_entry = audit.LOG[-1]
+
+    with pytest.raises(DomainError) as err:
+        shipments.mark_delivered(s.id)
+
+    assert err.value.code == "E_BAD_STATE"
+    assert s.status == "delivered"
+    assert s.delivered_at == first_time
+    assert len(audit.LOG) == log_len
+    assert audit.LOG[-1] is last_entry
+
+
+def test_mark_delivered_cancelled_fails_and_leaves_state_unchanged():
+    s = _new_shipment()
+    s.status = "cancelled"
+    log_len = len(audit.LOG)
+
+    with pytest.raises(DomainError) as err:
+        shipments.mark_delivered(s.id)
+
+    assert err.value.code == "E_BAD_STATE"
+    assert s.status == "cancelled"
+    assert s.delivered_at is None
+    assert len(audit.LOG) == log_len
