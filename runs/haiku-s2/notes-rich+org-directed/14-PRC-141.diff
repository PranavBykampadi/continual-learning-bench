@@ -28,3 +28,32 @@
     if shipment_id not in db.shipments:
         raise DomainError("E_NOT_FOUND", shipment_id)
     return db.shipments[shipment_id]
+
+
+def reassign_shipment(shipment_id, new_customer_id):
+    """Move a shipment to another customer and return it.
+
+    Raises E_BAD_INPUT for blank or non-string ids, E_NOT_FOUND for an unknown
+    shipment, E_UNKNOWN_CUSTOMER for an unknown customer, and E_BAD_STATE if the
+    shipment has already been delivered. Nothing changes when an error is raised.
+    """
+    if not isinstance(shipment_id, str) or not shipment_id.strip():
+        raise DomainError("E_BAD_INPUT", "shipment_id")
+    if not isinstance(new_customer_id, str) or not new_customer_id.strip():
+        raise DomainError("E_BAD_INPUT", "new_customer_id")
+    if shipment_id not in db.shipments:
+        raise DomainError("E_NOT_FOUND", shipment_id)
+    if new_customer_id not in db.customers:
+        raise DomainError("E_UNKNOWN_CUSTOMER", new_customer_id)
+    shipment = db.shipments[shipment_id]
+    if shipment.status == "delivered":
+        raise DomainError("E_BAD_STATE", shipment.status)
+    old_customer_id = shipment.customer_id
+    shipment.customer_id = new_customer_id
+    events.emit(
+        "shipment.reassigned",
+        shipment.id,
+        from_customer_id=old_customer_id,
+        to_customer_id=new_customer_id,
+    )
+    return shipment
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_shipments.py b/tests/unit/test_shipments.py
--- a/tests/unit/test_shipments.py	2026-11-10 12:20:18
+++ b/tests/unit/test_shipments.py	2026-11-10 15:00:55
@@ -15,3 +15,56 @@
     with pytest.raises(DomainError) as err:
         shipments.create_shipment("nope", 1, "local")
     assert err.value.code == "E_UNKNOWN_CUSTOMER"
+
+
+def test_reassign_moves_shipment_and_emits_event():
+    a = customers.add_customer("Acme")
+    b = customers.add_customer("Beta")
+    s = shipments.create_shipment(a.id, 1.5, "national")
+    events.OUTBOX.clear()
+    result = shipments.reassign_shipment(s.id, b.id)
+    assert result is s
+    assert s.customer_id == b.id
+    assert events.OUTBOX[-1]["name"] == "shipment.reassigned"
+    assert events.OUTBOX[-1]["entity_id"] == s.id
+    assert events.OUTBOX[-1]["payload"] == {
+        "from_customer_id": a.id,
+        "to_customer_id": b.id,
+    }
+
+
+def test_reassign_unknown_shipment():
+    b = customers.add_customer("Beta")
+    with pytest.raises(DomainError) as err:
+        shipments.reassign_shipment("shp_missing", b.id)
+    assert err.value.code == "E_NOT_FOUND"
+
+
+def test_reassign_unknown_customer_leaves_shipment_unchanged():
+    a = customers.add_customer("Acme")
+    s = shipments.create_shipment(a.id, 1.5, "national")
+    with pytest.raises(DomainError) as err:
+        shipments.reassign_shipment(s.id, "cus_missing")
+    assert err.value.code == "E_UNKNOWN_CUSTOMER"
+    assert s.customer_id == a.id
+
+
+def test_reassign_delivered_shipment_fails():
+    a = customers.add_customer("Acme")
+    b = customers.add_customer("Beta")
+    s = shipments.create_shipment(a.id, 1.5, "national")
+    s.status = "delivered"
+    with pytest.raises(DomainError) as err:
+        shipments.reassign_shipment(s.id, b.id)
+    assert err.value.code == "E_BAD_STATE"
+    assert s.customer_id == a.id
+
+
+@pytest.mark.parametrize("bad", ["", "   ", None, 42])
+def test_reassign_bad_customer_id_is_bad_input(bad):
+    a = customers.add_customer("Acme")
+    s = shipments.create_shipment(a.id, 1.5, "national")
+    with pytest.raises(DomainError) as err:
+        shipments.reassign_shipment(s.id, bad)
+    assert err.value.code == "E_BAD_INPUT"
+    assert s.customer_id == a.id
