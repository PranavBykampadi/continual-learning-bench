diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_customers_addresses.py b/tests/unit/test_customers_addresses.py
--- a/tests/unit/test_customers_addresses.py	1969-12-31 19:00:00
+++ b/tests/unit/test_customers_addresses.py	2026-11-10 14:54:07
@@ -0,0 +1,46 @@
+import pytest
+
+from parcelo import audit, customers, store
+from parcelo.errors import DomainError
+
+
+def test_add_address_stores_and_returns_address():
+    c = customers.add_customer("Acme")
+    addr = customers.add_address(c.id, "1 Main St", "Springfield")
+    assert addr.id.startswith("adr_")
+    assert addr.customer_id == c.id
+    assert addr.line == "1 Main St"
+    assert addr.city == "Springfield"
+    assert store.db.addresses[addr.id] is addr
+
+
+def test_add_address_records_audit():
+    c = customers.add_customer("Acme")
+    addr = customers.add_address(c.id, "1 Main St", "Springfield")
+    assert audit.LOG[-1]["action"] == "address.added"
+    assert audit.LOG[-1]["entity_id"] == addr.id
+
+
+def test_unknown_customer():
+    with pytest.raises(DomainError) as err:
+        customers.add_address("nope", "1 Main St", "Springfield")
+    assert err.value.code == "E_UNKNOWN_CUSTOMER"
+    assert store.db.addresses == {}
+
+
+@pytest.mark.parametrize("line", ["", "   "])
+def test_empty_line_rejected(line):
+    c = customers.add_customer("Acme")
+    with pytest.raises(DomainError) as err:
+        customers.add_address(c.id, line, "Springfield")
+    assert err.value.code == "E_BAD_INPUT"
+    assert store.db.addresses == {}
+
+
+@pytest.mark.parametrize("city", ["", "  "])
+def test_empty_city_rejected(city):
+    c = customers.add_customer("Acme")
+    with pytest.raises(DomainError) as err:
+        customers.add_address(c.id, "1 Main St", city)
+    assert err.value.code == "E_BAD_INPUT"
+    assert store.db.addresses == {}
