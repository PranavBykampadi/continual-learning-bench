+def reopen_invoice(invoice_id):
+    """Move a paid invoice back to open, undoing an accidental payment.
+
+    Args:
+        invoice_id: Id of the invoice to reopen.
+
+    Returns:
+        The reopened invoice.
+
+    Raises:
+        DomainError: E_BAD_INPUT if the id is blank or not a string,
+            E_NOT_FOUND if no such invoice exists, and E_BAD_STATE if the
+            invoice is not currently paid.
+    """
+    if not isinstance(invoice_id, str) or not invoice_id.strip():
+        raise DomainError("E_BAD_INPUT", repr(invoice_id))
+    if invoice_id not in db.invoices:
+        raise DomainError("E_NOT_FOUND", invoice_id)
+    invoice = db.invoices[invoice_id]
+    if invoice.status != "paid":
+        raise DomainError(
+            "E_BAD_STATE", f"{invoice_id} is {invoice.status}, expected paid"
+        )
+    invoice.status = "open"
+    invoice.paid_at = None
+    invoice.reopened_at = clock.now()
+    events.emit("invoice.reopened", invoice.id)
     return invoice
 
 
