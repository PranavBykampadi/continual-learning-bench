diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_invoices_reopen.py b/tests/unit/test_invoices_reopen.py
--- a/tests/unit/test_invoices_reopen.py	1969-12-31 19:00:00
+++ b/tests/unit/test_invoices_reopen.py	2026-11-10 15:02:05
@@ -0,0 +1,88 @@
+from datetime import datetime, timezone
+
+import pytest
+
+from parcelo import clock, customers, events, invoices, shipments
+from parcelo.errors import DomainError
+
+
+def _issued_invoice():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 2, "local")
+    return invoices.issue_invoice(s.id)
+
+
+def _paid_invoice():
+    inv = _issued_invoice()
+    return invoices.mark_paid(inv.id)
+
+
+def test_reopen_sets_open_clears_paid_at_and_records_time():
+    moment = datetime(2026, 11, 10, 12, 0, tzinfo=timezone.utc)
+    clock.set_fixed(moment)
+    inv = _paid_invoice()
+    assert inv.paid_at is not None
+
+    result = invoices.reopen_invoice(inv.id)
+
+    assert result is inv
+    assert inv.status == "open"
+    assert inv.paid_at is None
+    assert inv.reopened_at == moment
+
+
+def test_reopen_emits_event():
+    inv = _paid_invoice()
+    events.OUTBOX.clear()
+
+    invoices.reopen_invoice(inv.id)
+
+    assert events.OUTBOX[-1]["name"] == "invoice.reopened"
+    assert events.OUTBOX[-1]["entity_id"] == inv.id
+
+
+def test_reopened_invoice_is_listed_as_open_and_can_be_paid_again():
+    inv = _paid_invoice()
+    invoices.reopen_invoice(inv.id)
+
+    assert inv in invoices.open_invoices()
+    assert invoices.mark_paid(inv.id).status == "paid"
+
+
+def test_reopen_missing_invoice_fails():
+    with pytest.raises(DomainError) as err:
+        invoices.reopen_invoice("INV-missing")
+    assert err.value.code == "E_NOT_FOUND"
+    assert events.OUTBOX == []
+
+
+@pytest.mark.parametrize("bad_id", ["", "   ", None, 42])
+def test_reopen_bad_id_fails(bad_id):
+    with pytest.raises(DomainError) as err:
+        invoices.reopen_invoice(bad_id)
+    assert err.value.code == "E_BAD_INPUT"
+    assert events.OUTBOX == []
+
+
+def test_reopen_unpaid_invoice_fails_and_leaves_it_unchanged():
+    inv = _issued_invoice()
+
+    with pytest.raises(DomainError) as err:
+        invoices.reopen_invoice(inv.id)
+
+    assert err.value.code == "E_BAD_STATE"
+    assert "open" in err.value.message
+    assert inv.status == "open"
+    assert inv.reopened_at is None
+    assert events.OUTBOX == []
+
+
+def test_reopen_twice_fails_the_second_time():
+    inv = _paid_invoice()
+    invoices.reopen_invoice(inv.id)
+
+    with pytest.raises(DomainError) as err:
+        invoices.reopen_invoice(inv.id)
+
+    assert err.value.code == "E_BAD_STATE"
+    assert inv.status == "open"
