diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_customers_upgrade.py b/tests/unit/test_customers_upgrade.py
--- a/tests/unit/test_customers_upgrade.py	1969-12-31 19:00:00
+++ b/tests/unit/test_customers_upgrade.py	2026-11-10 15:05:55
@@ -0,0 +1,59 @@
+import pytest
+
+from parcelo import customers, events
+from parcelo.errors import DomainError
+
+
+def test_upgrade_standard_to_gold():
+    c = customers.add_customer("Acme")
+    assert c.tier == "standard"
+    result = customers.upgrade_tier(c.id)
+    assert result is c
+    assert customers.get_customer(c.id).tier == "gold"
+
+
+def test_upgrade_keeps_other_fields():
+    c = customers.add_customer("Acme")
+    before = (c.id, c.name, c.credit_limit, c.active)
+    customers.upgrade_tier(c.id)
+    assert (c.id, c.name, c.credit_limit, c.active) == before
+
+
+def test_upgrade_unknown_customer():
+    with pytest.raises(DomainError) as err:
+        customers.upgrade_tier("C000000")
+    assert err.value.code == "E_UNKNOWN_CUSTOMER"
+
+
+def test_upgrade_already_gold_fails():
+    c = customers.add_customer("Acme", tier="gold")
+    with pytest.raises(DomainError) as err:
+        customers.upgrade_tier(c.id)
+    assert err.value.code == "E_BAD_STATE"
+    assert "gold" in err.value.message
+    assert customers.get_customer(c.id).tier == "gold"
+
+
+def test_upgrade_twice_fails_second_time():
+    c = customers.add_customer("Acme")
+    customers.upgrade_tier(c.id)
+    with pytest.raises(DomainError) as err:
+        customers.upgrade_tier(c.id)
+    assert err.value.code == "E_BAD_STATE"
+
+
+@pytest.mark.parametrize("bad_id", [None, "", "   ", 42])
+def test_upgrade_bad_id_is_bad_input(bad_id):
+    c = customers.add_customer("Acme")
+    with pytest.raises(DomainError) as err:
+        customers.upgrade_tier(bad_id)
+    assert err.value.code == "E_BAD_INPUT"
+    assert customers.get_customer(c.id).tier == "standard"
+
+
+def test_upgrade_emits_no_events_on_failure():
+    c = customers.add_customer("Acme", tier="gold")
+    events.OUTBOX.clear()
+    with pytest.raises(DomainError):
+        customers.upgrade_tier(c.id)
+    assert events.OUTBOX == []
