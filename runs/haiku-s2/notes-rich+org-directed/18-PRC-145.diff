+def upgrade_tier(customer_id):
+    """Move a standard customer to the gold tier.
+
+    Args:
+        customer_id: Id of the customer to upgrade.
+
+    Returns:
+        The upgraded Customer.
+
+    Raises:
+        DomainError: E_BAD_INPUT if customer_id is missing, blank, or not a string.
+            E_UNKNOWN_CUSTOMER if no customer has that id.
+            E_BAD_STATE if the customer is not on the standard tier (for example,
+            already gold).
+    """
+    if not isinstance(customer_id, str) or not customer_id.strip():
+        raise DomainError("E_BAD_INPUT", "customer_id must be a non-empty string")
+    if customer_id not in db.customers:
+        raise DomainError("E_UNKNOWN_CUSTOMER", f"no customer {customer_id}")
+    customer = db.customers[customer_id]
+    if customer.tier != "standard":
+        raise DomainError(
+            "E_BAD_STATE",
+            f"customer {customer_id} is {customer.tier}, expected standard",
+        )
+    customer.tier = "gold"
+    return customer
 
 
