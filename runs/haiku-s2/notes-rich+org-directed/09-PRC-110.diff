+def discounted_quote(weight_kg, zone, tier):
+    """Return the shipping quote for a weight and zone with the tier discount applied.
+
+    Gold customers get 10% off the regular quote. Standard customers pay the
+    regular quote. The discounted amount is rounded half up to the cent using
+    Money.scale. This is a pure calculation: no state is changed and no audit
+    record is written.
+
+    Args:
+        weight_kg: Parcel weight in kilograms. Must be positive.
+        zone: Shipping zone, one of the keys of ZONE_BASE.
+        tier: Customer tier, either "standard" or "gold".
+
+    Returns:
+        Money: The quote after the tier discount.
+
+    Raises:
+        DomainError: E_BAD_ZONE if the zone is unknown, E_BAD_INPUT if the tier
+            is unknown, or E_BAD_WEIGHT if weight_kg is not positive. All checks
+            run before any computation, so nothing is returned on failure.
+    """
+    if zone not in ZONE_BASE:
+        raise DomainError("E_BAD_ZONE", zone)
+    if tier not in TIER_FACTOR:
+        raise DomainError("E_BAD_INPUT", "unknown tier: %s" % tier)
+    if weight_kg <= 0:
+        raise DomainError("E_BAD_WEIGHT", str(weight_kg))
+    regular = Money.parse(quote(weight_kg, zone))
+    return regular.scale(TIER_FACTOR[tier])
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_rates_gold_tier.py b/tests/unit/test_rates_gold_tier.py
