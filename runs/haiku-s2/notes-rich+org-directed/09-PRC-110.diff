+++ b/tests/unit/test_rates_gold_tier.py	2026-11-10 14:55:25
@@ -0,0 +1,41 @@
+import pytest
+
+from parcelo import rates
+from parcelo.errors import DomainError
+from parcelo.money import Money
+
+
+def test_gold_gets_ten_percent_off():
+    # local 2 kg: 4.50 + 1.25 * 2 = 7.00 -> 10% off = 6.30
+    assert rates.discounted_quote(2, "local", "gold") == Money(630)
+
+
+def test_standard_pays_regular_quote():
+    assert rates.discounted_quote(2, "local", "standard") == Money(700)
+
+
+def test_gold_discount_rounds_half_up_to_cent():
+    # national 3 kg: 9.00 + 1.25 * 3 = 12.75 -> 10% off = 11.475 -> 11.48
+    assert rates.discounted_quote(3, "national", "gold") == Money(1148)
+
+
+def test_returns_money_not_float():
+    assert isinstance(rates.discounted_quote(2, "local", "gold"), Money)
+
+
+def test_unknown_zone_fails():
+    with pytest.raises(DomainError) as exc:
+        rates.discounted_quote(2, "moon", "gold")
+    assert exc.value.code == "E_BAD_ZONE"
+
+
+def test_unknown_tier_fails():
+    with pytest.raises(DomainError) as exc:
+        rates.discounted_quote(2, "local", "platinum")
+    assert exc.value.code == "E_BAD_INPUT"
+
+
+def test_non_positive_weight_fails():
+    with pytest.raises(DomainError) as exc:
+        rates.discounted_quote(0, "local", "gold")
+    assert exc.value.code == "E_BAD_WEIGHT"
