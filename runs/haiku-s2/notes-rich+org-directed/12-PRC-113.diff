+from decimal import Decimal
+
+import pytest
+
+from parcelo import audit, customers, invoices, reports, shipments
+from parcelo.errors import DomainError
+from parcelo.money import Money
+from parcelo.store import db, reset
+
+
+@pytest.fixture(autouse=True)
+def clean_state():
+    reset()
+    audit.LOG.clear()
+    yield
+    reset()
+    audit.LOG.clear()
+
+
+def _open_invoice(amount_weight=1.5):
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, amount_weight, "national")
+    return c, invoices.issue_invoice(s.id)
+
+
+def test_credit_reduces_open_invoice_and_returns_remaining():
+    c, inv = _open_invoice()
+    before = inv.amount
+    remaining = invoices.apply_credit(inv.id, "2.50")
+    assert isinstance(remaining, Money)
+    assert remaining == Money.parse(before) - Money.parse("2.50")
+    assert db.invoices[inv.id].amount == pytest.approx(before - 2.5)
+    assert db.invoices[inv.id].status == "open"
+
+
+def test_credit_is_audited():
+    _, inv = _open_invoice()
+    invoices.apply_credit(inv.id, 1)
+    assert audit.LOG[-1]["action"] == "invoice.credit_applied"
+    assert audit.LOG[-1]["entity_id"] == inv.id
+
+
+def test_credit_flows_into_balance_and_reports():
+    c, inv = _open_invoice()
+    other = invoices.issue_invoice(shipments.create_shipment(c.id, 2.0, "local").id)
+    balance_before = customers.outstanding_balance(c.id)
+    invoices.apply_credit(inv.id, 1.25)
+    assert customers.outstanding_balance(c.id) == pytest.approx(balance_before - 1.25, abs=0.005)
+
+    invoices.mark_paid(other.id)
+    assert reports.revenue_total() == pytest.approx(other.amount, abs=0.005)
+
+
+def test_credit_equal_to_amount_leaves_zero():
+    _, inv = _open_invoice()
+    remaining = invoices.apply_credit(inv.id, inv.amount)
+    assert remaining == Money.zero()
+    assert db.invoices[inv.id].amount == 0
+
+
+@pytest.mark.parametrize(
+    "bad_id",
+    ["", "   ", None, 42],
+)
+def test_rejects_blank_or_non_string_invoice_id(bad_id):
+    _, inv = _open_invoice()
+    before = db.invoices[inv.id].amount
+    log_len = len(audit.LOG)
+    with pytest.raises(DomainError) as err:
+        invoices.apply_credit(bad_id, 1)
+    assert err.value.code == "E_BAD_INPUT"
+    assert db.invoices[inv.id].amount == before
+    assert len(audit.LOG) == log_len
+
+
+@pytest.mark.parametrize(
+    "bad_amount",
+    ["abc", "", None, True, float("nan"), float("inf"), 0, -1, "-0.50", Decimal("0")],
+)
+def test_rejects_bad_credit_amount(bad_amount):
+    _, inv = _open_invoice()
+    before = db.invoices[inv.id].amount
+    log_len = len(audit.LOG)
+    with pytest.raises(DomainError) as err:
+        invoices.apply_credit(inv.id, bad_amount)
+    assert err.value.code == "E_BAD_INPUT"
+    assert db.invoices[inv.id].amount == before
+    assert len(audit.LOG) == log_len
+
+
+def test_rejects_unknown_invoice():
+    with pytest.raises(DomainError) as err:
+        invoices.apply_credit("INV-missing", 1)
+    assert err.value.code == "E_NOT_FOUND"
+    assert len(audit.LOG) == 0
+
+
