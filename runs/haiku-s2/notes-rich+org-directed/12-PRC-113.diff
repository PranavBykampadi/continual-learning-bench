+def apply_credit(invoice_id: str, amount) -> Money:
+    """Reduce an open invoice's amount by a credit.
+
+    Args:
+        invoice_id: Id of the invoice to credit.
+        amount: Credit to apply, as a dollar amount (float, int, str, Decimal or Money).
+
+    Returns:
+        The invoice's remaining amount after the credit.
+
+    Raises:
+        DomainError: E_BAD_INPUT for a blank id or a credit that is not a positive
+            amount, or larger than the invoice's amount; E_NOT_FOUND if the invoice
+            does not exist; E_BAD_STATE if the invoice is not open.
+    """
+    # Validate all inputs before any lookup, mutation or audit record.
+    if not isinstance(invoice_id, str) or not invoice_id.strip():
+        raise DomainError("E_BAD_INPUT", "invoice_id must be a non-blank string")
+    try:
+        credit = Money.parse(amount)
+    except (ArithmeticError, TypeError, ValueError):
+        raise DomainError("E_BAD_INPUT", f"bad credit amount: {amount!r}")
+    if credit.cents <= 0:
+        raise DomainError("E_BAD_INPUT", f"credit must be positive: {credit}")
+
+    if invoice_id not in db.invoices:
+        raise DomainError("E_NOT_FOUND", invoice_id)
+    invoice = db.invoices[invoice_id]
+    if invoice.status != "open":
+        raise DomainError("E_BAD_STATE", f"invoice is {invoice.status}, not open")
+
+    # invoice.amount is still a float (see PR-226): wrap on read, store the remainder as float.
+    current = Money.parse(invoice.amount)
+    if current < credit:
+        raise DomainError("E_BAD_INPUT", f"credit {credit} exceeds invoice amount {current}")
+    remaining = current - credit
+    invoice.amount = round(remaining.cents / 100, 2)
+    audit.record(
+        "invoice.credit_applied",
+        invoice.id,
+        credit=str(credit),
+        remaining=str(remaining),
+    )
+    return remaining
