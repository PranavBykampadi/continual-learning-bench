+def _as_utc(moment):
+    """Return an aware UTC datetime. Naive values are taken to be UTC.
+
+    issue_invoice() stores naive UTC timestamps, so naive input is expected.
+    """
+    if moment.tzinfo is None:
+        return moment.replace(tzinfo=timezone.utc)
+    return moment.astimezone(timezone.utc)
+
+
+def late_fee_for(invoice_id):
+    """Return the late fee an invoice has accrued as of now.
+
+    The invoice is late 30 days after it was issued. Each whole day past
+    that point adds 1.5% of the invoice amount. The fee is rounded half up
+    to the cent. This is a read-only lookup: the store and audit log are not
+    changed, and nothing is changed on failure.
+
+    Args:
+        invoice_id: Id of the invoice to price.
+
+    Returns:
+        Money: The late fee so far. Zero if the invoice is not late yet.
+
+    Raises:
+        DomainError: E_NOT_FOUND if no invoice has this id.
+    """
+    if invoice_id not in db.invoices:
+        raise DomainError("E_NOT_FOUND", f"invoice {invoice_id}")
+    invoice = db.invoices[invoice_id]
+    amount = Money.parse(invoice.amount)  # stored as a float by issue_invoice
+    elapsed = _as_utc(clock.now()) - _as_utc(invoice.issued_at)
+    days_late = (elapsed - timedelta(days=LATE_AFTER_DAYS)).days
+    if days_late <= 0:
+        return Money.zero()
+    return amount.scale(LATE_FEE_RATE_PER_DAY * days_late)
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_invoices_late_fee.py b/tests/unit/test_invoices_late_fee.py
--- a/tests/unit/test_invoices_late_fee.py	1969-12-31 19:00:00
+++ b/tests/unit/test_invoices_late_fee.py	2026-11-10 14:50:48
@@ -0,0 +1,78 @@
+from datetime import datetime, timedelta, timezone
+
+import pytest
+
+from parcelo import audit, clock, customers, invoices, shipments, store
+from parcelo.errors import DomainError
+from parcelo.money import Money
+
+NOW = datetime(2026, 11, 10, 12, 0, tzinfo=timezone.utc)
+
+
+@pytest.fixture
+def pinned_now():
+    clock.set_fixed(NOW)
+    return NOW
+
+
+def _open_invoice(issued_at):
+    """Issue an invoice of 7.00 (local, 2 kg) and pin its issue time."""
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 2, "local")
+    inv = invoices.issue_invoice(s.id)
+    inv.issued_at = issued_at
+    return inv
+
+
+def test_not_late_before_30_days(pinned_now):
+    inv = _open_invoice((NOW - timedelta(days=29)).replace(tzinfo=None))
+    assert invoices.late_fee_for(inv.id) == Money.zero()
+
+
+def test_exactly_30_days_is_not_yet_a_fee(pinned_now):
+    inv = _open_invoice((NOW - timedelta(days=30)).replace(tzinfo=None))
+    assert invoices.late_fee_for(inv.id) == Money.zero()
+
+
+def test_partial_day_past_30_days_is_not_charged(pinned_now):
+    inv = _open_invoice((NOW - timedelta(days=30, hours=23)).replace(tzinfo=None))
+    assert invoices.late_fee_for(inv.id) == Money.zero()
+
+
+def test_one_full_day_late(pinned_now):
+    # 700 cents * 1.5% = 10.5 cents, rounded half up to 11 cents
+    inv = _open_invoice((NOW - timedelta(days=31)).replace(tzinfo=None))
+    assert invoices.late_fee_for(inv.id) == Money(11)
+
+
+def test_fee_scales_per_whole_day(pinned_now):
+    # 10 whole days past the grace period: 7.00 * 15% = 1.05 USD
+    inv = _open_invoice((NOW - timedelta(days=40, hours=5)).replace(tzinfo=None))
+    assert invoices.late_fee_for(inv.id) == Money(105)
+
+
+def test_aware_issued_at_is_accepted(pinned_now):
+    inv = _open_invoice(NOW - timedelta(days=40))
+    assert invoices.late_fee_for(inv.id) == Money(105)
+
+
+def test_rounds_half_up_to_the_cent(pinned_now):
+    inv = _open_invoice((NOW - timedelta(days=31)).replace(tzinfo=None))
+    inv.amount = 0.5  # 50 cents * 1.5% = 0.75 cents -> 1 cent
+    assert invoices.late_fee_for(inv.id) == Money(1)
+
+
+def test_unknown_invoice_raises_not_found(pinned_now):
+    with pytest.raises(DomainError) as err:
+        invoices.late_fee_for("INV-missing")
+    assert err.value.code == "E_NOT_FOUND"
+
+
+def test_lookup_leaves_store_and_audit_unchanged(pinned_now):
+    inv = _open_invoice((NOW - timedelta(days=40)).replace(tzinfo=None))
+    before_status = inv.status
+    before_count = len(audit.LOG)
+    invoices.late_fee_for(inv.id)
+    assert inv.status == before_status
+    assert len(audit.LOG) == before_count
+    assert set(store.db.invoices) == {inv.id}
