 ZONE_BASE = {"local": 4.5, "national": 9.0, "international": 24.0}
 PER_KG = 1.25
 
+# Same percentages as fuel_surcharge in parcelo/legacy/billing.py.
+FUEL_SURCHARGE_PCT = {"local": 0.0, "national": 4.0, "international": 9.5}
+INSURANCE_PCT = 2.0
+MIN_INSURANCE_FEE = Money(100)
 
