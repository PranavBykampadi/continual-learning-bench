+def quote_with_surcharge(weight_kg: float, zone: str) -> dict[str, float]:
+    """Return the quote for a weight and zone, including the fuel surcharge.
+
+    Args:
+        weight_kg: Parcel weight in kilograms. Must be greater than zero.
+        zone: One of "local", "national" or "international".
+
+    Returns:
+        A dict with "quote" (the normal quote), "fuel_surcharge" (the surcharge
+        for the zone) and "total" (quote plus surcharge). All values are rounded
+        to the cent.
+
+    Raises:
+        DomainError: With code E_BAD_ZONE if the zone is unknown, or E_BAD_WEIGHT
+            if the weight is zero or negative.
+    """
+    if zone not in ZONE_BASE:
+        raise DomainError("E_BAD_ZONE", zone)
+    if weight_kg <= 0:
+        raise DomainError("E_BAD_WEIGHT", str(weight_kg))
+    base = quote(weight_kg, zone)
+    surcharge = round(base * FUEL_SURCHARGE_PCT[zone] / 100.0, 2)
+    return {
+        "quote": base,
+        "fuel_surcharge": surcharge,
+        "total": round(base + surcharge, 2),
+    }
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_rates_surcharge.py b/tests/unit/test_rates_surcharge.py
--- a/tests/unit/test_rates_surcharge.py	1969-12-31 19:00:00
+++ b/tests/unit/test_rates_surcharge.py	2026-11-10 14:47:10
@@ -0,0 +1,37 @@
+import pytest
+
+from parcelo import rates
+from parcelo.errors import DomainError
+
+
+def test_quote_with_surcharge_local_has_no_surcharge():
+    result = rates.quote_with_surcharge(2, "local")
+    assert result == {"quote": 7.0, "fuel_surcharge": 0.0, "total": 7.0}
+
+
+def test_quote_with_surcharge_national():
+    result = rates.quote_with_surcharge(2, "national")
+    assert result == {"quote": 11.5, "fuel_surcharge": 0.46, "total": 11.96}
+
+
+def test_quote_with_surcharge_international():
+    result = rates.quote_with_surcharge(2, "international")
+    assert result == {"quote": 26.5, "fuel_surcharge": 2.52, "total": 29.02}
+
+
+def test_quote_with_surcharge_total_matches_quote_plus_surcharge():
+    result = rates.quote_with_surcharge(3.5, "national")
+    assert result["total"] == round(result["quote"] + result["fuel_surcharge"], 2)
+
+
+def test_quote_with_surcharge_unknown_zone():
+    with pytest.raises(DomainError) as err:
+        rates.quote_with_surcharge(2, "moon")
+    assert err.value.code == "E_BAD_ZONE"
+
+
+@pytest.mark.parametrize("weight", [0, -1, -0.5])
+def test_quote_with_surcharge_non_positive_weight(weight):
+    with pytest.raises(DomainError) as err:
+        rates.quote_with_surcharge(weight, "local")
+    assert err.value.code == "E_BAD_WEIGHT"
