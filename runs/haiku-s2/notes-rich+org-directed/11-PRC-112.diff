@@ -0,0 +1,55 @@
+from parcelo import audit, clock, ids
+from parcelo.errors import DomainError
+from parcelo.models import Claim
+from parcelo.money import Money
+from parcelo.store import db
+
+
+def file_claim(shipment_id: str, amount, reason: str) -> Claim:
+    """File a claim against a delivered shipment.
+
+    Inputs are validated before any lookup or mutation. Only shipments with
+    status ``delivered`` can have claims.
+
+    Args:
+        shipment_id: Id of the delivered shipment the claim is about.
+        amount: Positive refund amount. Anything ``Money.parse`` accepts
+            (Money, int, float, str or Decimal), interpreted in dollars.
+        reason: Non-blank text describing the problem.
+
+    Returns:
+        The stored Claim, with ``amount`` as a Money value.
+
+    Raises:
+        DomainError: ``E_BAD_INPUT`` if ``reason`` is not a non-blank string or
+            ``amount`` is not a valid, positive amount; ``E_NOT_FOUND`` if the
+            shipment does not exist; ``E_BAD_STATE`` if the shipment is not
+            delivered. On any failure nothing is stored and no audit record is
+            written.
+    """
+    if not isinstance(reason, str) or not reason.strip():
+        raise DomainError("E_BAD_INPUT", "reason must be non-blank text")
+    try:
+        money = Money.parse(amount)
+    except (ArithmeticError, TypeError, ValueError) as exc:
+        raise DomainError("E_BAD_INPUT", f"invalid amount: {amount!r}") from exc
+    if money.cents <= 0:
+        raise DomainError("E_BAD_INPUT", f"amount must be positive: {money}")
+    if shipment_id not in db.shipments:
+        raise DomainError("E_NOT_FOUND", shipment_id)
+    shipment = db.shipments[shipment_id]
+    if shipment.status != "delivered":
+        raise DomainError(
+            "E_BAD_STATE",
+            f"claims need a delivered shipment, status is {shipment.status}",
+        )
+    claim = Claim(
+        id=ids.new_id("clm"),
+        shipment_id=shipment_id,
+        amount=money,
+        reason=reason,
+        filed_at=clock.now(),
+    )
+    db.claims[claim.id] = claim
+    audit.record("claim.filed", claim.id, shipment_id=shipment_id, amount_cents=money.cents)
+    return claim
