diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_claims.py b/tests/unit/test_claims.py
--- a/tests/unit/test_claims.py	1969-12-31 19:00:00
+++ b/tests/unit/test_claims.py	2026-11-10 14:57:50
@@ -0,0 +1,87 @@
+import pytest
+
+from parcelo import audit, claims, customers, shipments
+from parcelo.errors import DomainError
+from parcelo.money import Money
+from parcelo.store import db
+
+
+def _delivered_shipment():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 1.5, "national")
+    s.status = "delivered"
+    return s
+
+
+def test_file_claim_on_delivered_shipment():
+    s = _delivered_shipment()
+    claim = claims.file_claim(s.id, "12.50", "box arrived crushed")
+    assert claim.id.startswith("clm_")
+    assert claim.shipment_id == s.id
+    assert claim.amount == Money(1250)
+    assert claim.reason == "box arrived crushed"
+    assert claim.filed_at is not None
+    assert db.claims[claim.id] is claim
+    assert audit.LOG[-1]["action"] == "claim.filed"
+    assert audit.LOG[-1]["entity_id"] == claim.id
+
+
+@pytest.mark.parametrize("amount", [Money(500), 5, 5.0, "5.00"])
+def test_amount_accepts_money_and_plain_values(amount):
+    s = _delivered_shipment()
+    assert claims.file_claim(s.id, amount, "damaged").amount == Money(500)
+
+
+@pytest.mark.parametrize("amount", [0, -1, "0", "-3.00", Money(0), Money(-5)])
+def test_non_positive_amount_rejected(amount):
+    s = _delivered_shipment()
+    with pytest.raises(DomainError) as err:
+        claims.file_claim(s.id, amount, "damaged")
+    assert err.value.code == "E_BAD_INPUT"
+    assert db.claims == {}
+    assert not any(e["action"] == "claim.filed" for e in audit.LOG)
+
+
+@pytest.mark.parametrize("amount", ["abc", None, True, float("nan"), float("inf"), [5]])
+def test_unparseable_amount_rejected(amount):
+    s = _delivered_shipment()
+    with pytest.raises(DomainError) as err:
+        claims.file_claim(s.id, amount, "damaged")
+    assert err.value.code == "E_BAD_INPUT"
+    assert db.claims == {}
+
+
+@pytest.mark.parametrize("reason", ["", "   ", None, 42])
+def test_blank_or_non_text_reason_rejected(reason):
