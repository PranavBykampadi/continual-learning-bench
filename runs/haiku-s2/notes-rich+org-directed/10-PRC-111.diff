     if shipment_id not in db.shipments:
         raise DomainError("E_NOT_FOUND", shipment_id)
     return db.shipments[shipment_id]
+
+
+def add_note(shipment_id, text):
+    """Append a timestamped note to a shipment.
+
+    The note is stored as ``{"text": text, "at": <time>}``, where ``at`` is
+    the current UTC time from ``clock.now()``.
+
+    Args:
+        shipment_id: Id of the shipment to annotate.
+        text: Note text. Must contain at least one non-whitespace character.
+
+    Returns:
+        The updated Shipment.
+
+    Raises:
+        DomainError: With code ``E_BAD_INPUT`` if ``text`` is not a string or
+            is empty or whitespace-only, or ``E_NOT_FOUND`` if the shipment
+            does not exist. On failure, nothing is changed and no audit
+            record is written.
+    """
+    if not isinstance(text, str) or not text.strip():
+        raise DomainError("E_BAD_INPUT", "note text must not be empty")
+    if shipment_id not in db.shipments:
+        raise DomainError("E_NOT_FOUND", shipment_id)
+    shipment = db.shipments[shipment_id]
+    shipment.notes.append({"text": text, "at": clock.now()})
+    audit.record("shipment.note_added", shipment_id)
+    return shipment
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_shipment_notes.py b/tests/unit/test_shipment_notes.py
--- a/tests/unit/test_shipment_notes.py	1969-12-31 19:00:00
+++ b/tests/unit/test_shipment_notes.py	2026-11-10 14:56:28
@@ -0,0 +1,57 @@
+from datetime import datetime, timezone
+
+import pytest
+
+from parcelo import audit, clock, customers, shipments
+from parcelo.errors import DomainError
+
+
+def _shipment():
+    c = customers.add_customer("Acme")
+    return shipments.create_shipment(c.id, 1.5, "national")
+
+
+def test_add_note_appends_text_and_timestamp():
+    moment = datetime(2026, 11, 10, 12, 30, tzinfo=timezone.utc)
+    clock.set_fixed(moment)
+    s = _shipment()
+    result = shipments.add_note(s.id, "customer asked about delay")
+    assert result is s
+    assert s.notes == [{"text": "customer asked about delay", "at": moment}]
+
+
+def test_notes_keep_order_and_their_own_times():
+    s = _shipment()
+    first = datetime(2026, 11, 10, 9, 0, tzinfo=timezone.utc)
+    second = datetime(2026, 11, 10, 9, 5, tzinfo=timezone.utc)
+    clock.set_fixed(first)
+    shipments.add_note(s.id, "first")
+    clock.set_fixed(second)
+    shipments.add_note(s.id, "second")
+    assert [n["text"] for n in s.notes] == ["first", "second"]
+    assert [n["at"] for n in s.notes] == [first, second]
+
+
+def test_add_note_records_audit():
+    s = _shipment()
+    shipments.add_note(s.id, "hello")
+    assert audit.LOG[-1]["action"] == "shipment.note_added"
+    assert audit.LOG[-1]["entity_id"] == s.id
+
+
+def test_unknown_shipment_fails():
+    with pytest.raises(DomainError) as err:
+        shipments.add_note("shp_missing", "hello")
+    assert err.value.code == "E_NOT_FOUND"
+    assert audit.LOG == []
+
+
+@pytest.mark.parametrize("text", ["", "   ", "\n\t"])
+def test_empty_text_fails_and_changes_nothing(text):
+    s = _shipment()
+    audit_count = len(audit.LOG)
+    with pytest.raises(DomainError) as err:
+        shipments.add_note(s.id, text)
+    assert err.value.code == "E_BAD_INPUT"
+    assert s.notes == []
+    assert len(audit.LOG) == audit_count
