+def set_credit_limit(customer_id: str, amount) -> float:
+    """Set a customer's credit limit.
+
+    Args:
+        customer_id: Id of the customer to update.
+        amount: New limit in dollars. An int, float, Decimal or numeric
+            string. Must be positive. Rounded to the cent.
+
+    Returns:
+        The new credit limit in dollars.
+
+    Raises:
+        DomainError: E_BAD_INPUT if customer_id is missing or blank, or if
+            amount is missing, a bool, not a number, or not positive.
+            E_UNKNOWN_CUSTOMER if the customer does not exist.
+    """
+    if not isinstance(customer_id, str) or not customer_id.strip():
+        raise DomainError("E_BAD_INPUT", "customer_id required")
+    if amount is None or isinstance(amount, bool):
+        raise DomainError("E_BAD_INPUT", "amount must be a number")
+    try:
+        limit = Money.parse(amount)
+    except (ArithmeticError, TypeError, ValueError):
+        raise DomainError("E_BAD_INPUT", f"amount must be a number: {amount!r}") from None
+    if limit.cents <= 0:
+        raise DomainError("E_BAD_INPUT", f"credit limit must be positive: {amount!r}")
+    if customer_id not in db.customers:
+        raise DomainError("E_UNKNOWN_CUSTOMER", customer_id)
+    new_limit = limit.cents / 100
+    db.customers[customer_id].credit_limit = new_limit
+    events.emit("customer.credit_limit_set", customer_id, limit=new_limit)
+    return new_limit
 
 
