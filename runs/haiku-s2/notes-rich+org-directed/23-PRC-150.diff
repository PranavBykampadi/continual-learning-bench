+++ b/tests/unit/test_customers_credit_limit.py	2026-11-10 15:11:00
@@ -0,0 +1,66 @@
+import pytest
+
+from parcelo import customers, events
+from parcelo.errors import DomainError
+from parcelo.store import db
+
+
+def test_set_credit_limit_updates_and_returns_new_limit():
+    events.OUTBOX.clear()
+    c = customers.add_customer("Acme")
+    assert customers.set_credit_limit(c.id, 750) == 750.0
+    assert db.customers[c.id].credit_limit == 750.0
+
+
+def test_set_credit_limit_rounds_to_cent():
+    c = customers.add_customer("Acme")
+    assert customers.set_credit_limit(c.id, "1234.567") == 1234.57
+
+
+def test_set_credit_limit_emits_event():
+    events.OUTBOX.clear()
+    c = customers.add_customer("Acme")
+    customers.set_credit_limit(c.id, 900)
+    assert events.OUTBOX[-1]["name"] == "customer.credit_limit_set"
+    assert events.OUTBOX[-1]["entity_id"] == c.id
+    assert events.OUTBOX[-1]["payload"] == {"limit": 900.0}
+
+
+def test_unknown_customer_fails():
+    events.OUTBOX.clear()
+    with pytest.raises(DomainError) as err:
+        customers.set_credit_limit("C_nope", 100)
+    assert err.value.code == "E_UNKNOWN_CUSTOMER"
+    assert events.OUTBOX == []
+
+
+def test_negative_amount_fails_without_change():
+    events.OUTBOX.clear()
+    c = customers.add_customer("Acme")
+    before = db.customers[c.id].credit_limit
+    with pytest.raises(DomainError) as err:
+        customers.set_credit_limit(c.id, -50)
+    assert err.value.code == "E_BAD_INPUT"
+    assert db.customers[c.id].credit_limit == before
+    assert events.OUTBOX == []
+
+
+@pytest.mark.parametrize("amount", [0, -0.004, None, True, "abc", float("nan"), float("inf")])
+def test_bad_amount_fails(amount):
+    c = customers.add_customer("Acme")
+    with pytest.raises(DomainError) as err:
+        customers.set_credit_limit(c.id, amount)
+    assert err.value.code == "E_BAD_INPUT"
+
+
+def test_amount_checked_before_existence():
+    with pytest.raises(DomainError) as err:
+        customers.set_credit_limit("C_nope", -1)
+    assert err.value.code == "E_BAD_INPUT"
+
+
+@pytest.mark.parametrize("customer_id", [None, "", "   "])
+def test_missing_customer_id_fails(customer_id):
+    with pytest.raises(DomainError) as err:
+        customers.set_credit_limit(customer_id, 100)
+    assert err.value.code == "E_BAD_INPUT"
