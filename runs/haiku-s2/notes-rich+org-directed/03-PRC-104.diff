diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_customers_deactivate.py b/tests/unit/test_customers_deactivate.py
--- a/tests/unit/test_customers_deactivate.py	1969-12-31 19:00:00
+++ b/tests/unit/test_customers_deactivate.py	2026-11-10 14:48:13
@@ -0,0 +1,55 @@
+import pytest
+
+from parcelo import audit, customers
+from parcelo.errors import DomainError
+from parcelo.store import db
+
+
+def test_deactivate_returns_customer_and_clears_active():
+    c = customers.add_customer("Acme")
+    result = customers.deactivate_customer(c.id)
+    assert result is c
+    assert result.active is False
+    assert db.customers[c.id].active is False
+
+
+def test_deactivate_records_audit():
+    c = customers.add_customer("Acme")
+    before = len(audit.LOG)
+    customers.deactivate_customer(c.id)
+    assert len(audit.LOG) == before + 1
+    assert audit.LOG[-1]["action"] == "customer.deactivated"
+    assert audit.LOG[-1]["entity_id"] == c.id
+
+
+def test_deactivate_unknown_customer_raises_not_found():
+    with pytest.raises(DomainError) as err:
+        customers.deactivate_customer("C_missing")
+    assert err.value.code == "E_NOT_FOUND"
+
+
+def test_deactivate_already_inactive_raises_bad_state():
+    c = customers.add_customer("Acme")
+    customers.deactivate_customer(c.id)
+    with pytest.raises(DomainError) as err:
+        customers.deactivate_customer(c.id)
+    assert err.value.code == "E_BAD_STATE"
+
+
+def test_rejected_call_leaves_customer_and_audit_unchanged():
+    c = customers.add_customer("Acme")
+    customers.deactivate_customer(c.id)
+    before_len = len(audit.LOG)
+    before_last = audit.LOG[-1]
+    with pytest.raises(DomainError):
+        customers.deactivate_customer(c.id)
+    assert db.customers[c.id].active is False
+    assert len(audit.LOG) == before_len
+    assert audit.LOG[-1] is before_last
+
+
+def test_not_found_rejected_call_writes_no_audit():
+    before = len(audit.LOG)
+    with pytest.raises(DomainError):
+        customers.deactivate_customer("C_missing")
+    assert len(audit.LOG) == before
