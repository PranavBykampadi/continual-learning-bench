@@ -0,0 +1,40 @@
+from parcelo import clock, events, ids
+from parcelo.errors import DomainError
+from parcelo.models import Pickup
+from parcelo.store import db
+
+
+def schedule_pickup(shipment_id: str, window_start: object) -> Pickup:
+    """Book a pickup for a shipment that is ready to go.
+
+    Args:
+        shipment_id: Id of the shipment to pick up. Must exist and be in status "created".
+        window_start: Start of the pickup window requested by the driver.
+
+    Returns:
+        The stored Pickup.
+
+    Raises:
+        DomainError: E_BAD_INPUT for a blank id or missing window, E_NOT_FOUND for an
+            unknown shipment, E_BAD_STATE if the shipment is not in status "created".
+    """
+    if not isinstance(shipment_id, str) or not shipment_id.strip():
+        raise DomainError("E_BAD_INPUT", "shipment_id")
+    if window_start is None:
+        raise DomainError("E_BAD_INPUT", "window_start")
+    if shipment_id not in db.shipments:
+        raise DomainError("E_NOT_FOUND", shipment_id)
+    shipment = db.shipments[shipment_id]
+    if shipment.status != "created":
+        raise DomainError(
+            "E_BAD_STATE", f"shipment {shipment_id} is {shipment.status}, expected created"
+        )
+    pickup = Pickup(
+        id=ids.new_id("pck"),
+        shipment_id=shipment_id,
+        window_start=window_start,
+        scheduled_at=clock.now(),
+    )
+    db.pickups[pickup.id] = pickup
+    events.emit("pickup.scheduled", pickup.id, shipment_id=shipment_id)
+    return pickup
