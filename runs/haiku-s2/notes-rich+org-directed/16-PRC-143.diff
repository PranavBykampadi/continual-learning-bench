diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_pickups_schedule.py b/tests/unit/test_pickups_schedule.py
--- a/tests/unit/test_pickups_schedule.py	1969-12-31 19:00:00
+++ b/tests/unit/test_pickups_schedule.py	2026-11-10 15:03:13
@@ -0,0 +1,71 @@
+from datetime import datetime, timezone
+
+import pytest
+
+from parcelo import clock, customers, events, pickups, shipments, store
+from parcelo.errors import DomainError
+
+WINDOW = datetime(2026, 11, 11, 9, 0, tzinfo=timezone.utc)
+
+
+def _created_shipment():
+    c = customers.add_customer("Acme")
+    return shipments.create_shipment(c.id, 2.0, "national")
+
+
+def test_schedule_creates_and_stores_pickup():
+    clock.set_fixed(datetime(2026, 11, 10, 12, 0, tzinfo=timezone.utc))
+    s = _created_shipment()
+    p = pickups.schedule_pickup(s.id, WINDOW)
+    assert p.id.startswith("pck_")
+    assert p.shipment_id == s.id
+    assert p.window_start == WINDOW
+    assert p.scheduled_at == clock.now()
+    assert store.db.pickups[p.id] is p
+
+
+def test_schedule_emits_event():
+    s = _created_shipment()
+    events.OUTBOX.clear()
+    p = pickups.schedule_pickup(s.id, WINDOW)
+    assert len(events.OUTBOX) == 1
+    assert events.OUTBOX[-1]["name"] == "pickup.scheduled"
+    assert events.OUTBOX[-1]["entity_id"] == p.id
+
+
+def test_unknown_shipment_not_found():
+    events.OUTBOX.clear()
+    with pytest.raises(DomainError) as err:
+        pickups.schedule_pickup("shp_nope", WINDOW)
+    assert err.value.code == "E_NOT_FOUND"
+    assert store.db.pickups == {}
+    assert events.OUTBOX == []
+
+
+@pytest.mark.parametrize("status", ["delivered", "in_transit"])
+def test_shipment_not_created_is_bad_state(status):
+    s = _created_shipment()
+    s.status = status
+    events.OUTBOX.clear()
+    with pytest.raises(DomainError) as err:
+        pickups.schedule_pickup(s.id, WINDOW)
+    assert err.value.code == "E_BAD_STATE"
+    assert status in err.value.message
+    assert store.db.pickups == {}
+    assert events.OUTBOX == []
+
+
+@pytest.mark.parametrize("bad_id", ["", "   ", None, 42])
+def test_blank_or_non_string_shipment_id_is_bad_input(bad_id):
+    with pytest.raises(DomainError) as err:
+        pickups.schedule_pickup(bad_id, WINDOW)
+    assert err.value.code == "E_BAD_INPUT"
+    assert store.db.pickups == {}
+
+
+def test_missing_window_is_bad_input():
+    s = _created_shipment()
+    with pytest.raises(DomainError) as err:
+        pickups.schedule_pickup(s.id, None)
+    assert err.value.code == "E_BAD_INPUT"
+    assert store.db.pickups == {}
