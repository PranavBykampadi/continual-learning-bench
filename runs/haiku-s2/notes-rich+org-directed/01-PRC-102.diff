diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_invoices_void.py b/tests/unit/test_invoices_void.py
--- a/tests/unit/test_invoices_void.py	1969-12-31 19:00:00
+++ b/tests/unit/test_invoices_void.py	2026-11-10 14:46:04
@@ -0,0 +1,66 @@
+from datetime import datetime, timezone
+
+import pytest
+
+from parcelo import audit, clock, customers, invoices, shipments
+from parcelo.errors import DomainError
+
+
+def _open_invoice():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 2, "local")
+    return invoices.issue_invoice(s.id)
+
+
+def test_void_sets_status_and_timestamp():
+    moment = datetime(2026, 11, 10, 12, 0, tzinfo=timezone.utc)
+    clock.set_fixed(moment)
+    inv = _open_invoice()
+    result = invoices.void_invoice(inv.id)
+    assert result is inv
+    assert result.status == "void"
+    assert result.voided_at == moment
+
+
+def test_void_records_audit():
+    inv = _open_invoice()
+    invoices.void_invoice(inv.id)
+    assert audit.LOG[-1]["action"] == "invoice.voided"
+    assert audit.LOG[-1]["entity_id"] == inv.id
+
+
+def test_voided_invoice_leaves_open_list():
+    inv = _open_invoice()
+    invoices.void_invoice(inv.id)
+    assert inv not in invoices.open_invoices()
+
+
+def test_void_unknown_invoice():
+    with pytest.raises(DomainError) as err:
+        invoices.void_invoice("INV-missing")
+    assert err.value.code == "E_NOT_FOUND"
+
+
+def test_void_paid_invoice_fails_and_leaves_it_unchanged():
+    inv = _open_invoice()
+    invoices.mark_paid(inv.id)
+    audit_count = len(audit.LOG)
+    with pytest.raises(DomainError) as err:
+        invoices.void_invoice(inv.id)
+    assert err.value.code == "E_BAD_STATE"
+    assert inv.status == "paid"
+    assert inv.voided_at is None
+    assert len(audit.LOG) == audit_count
+
+
+def test_void_twice_fails_and_keeps_first_timestamp():
+    first = datetime(2026, 11, 10, 9, 0, tzinfo=timezone.utc)
+    clock.set_fixed(first)
+    inv = _open_invoice()
+    invoices.void_invoice(inv.id)
+    clock.set_fixed(datetime(2026, 11, 10, 10, 0, tzinfo=timezone.utc))
+    with pytest.raises(DomainError) as err:
+        invoices.void_invoice(inv.id)
+    assert err.value.code == "E_BAD_STATE"
+    assert inv.status == "void"
+    assert inv.voided_at == first
