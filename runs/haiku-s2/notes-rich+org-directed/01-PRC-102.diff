+def void_invoice(invoice_id: str) -> Invoice:
+    """Void an open invoice that was issued by mistake.
+
+    Only open invoices can be voided. Paid and already-void invoices are
+    terminal and are rejected without being changed.
+
+    Args:
+        invoice_id: ID of the invoice to void.
+
+    Returns:
+        The voided invoice.
+
+    Raises:
+        DomainError: ``E_NOT_FOUND`` if the invoice does not exist, or
+            ``E_BAD_STATE`` if it is already paid or void.
+    """
+    if invoice_id not in db.invoices:
+        raise DomainError("E_NOT_FOUND", invoice_id)
+    invoice = db.invoices[invoice_id]
+    if invoice.status != "open":
+        raise DomainError("E_BAD_STATE", f"{invoice_id} is {invoice.status}")
+    invoice.status = "void"
+    invoice.voided_at = clock.now()
+    audit.record("invoice.voided", invoice_id)
     return invoice
 
 
