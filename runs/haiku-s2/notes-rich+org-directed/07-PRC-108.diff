+from parcelo.money import Money
 from parcelo.store import db
+
+
+def outstanding_by_customer():
+    """Return the total open-invoice balance for every customer.
+
+    Only invoices with status "open" count; paid and void invoices are
+    ignored. Every customer is included, with a zero balance if they have
+    no open invoices. Amounts are Money. Invoice amounts stored as floats
+    are wrapped with Money.parse as they are read. This is read-only: no
+    state is changed and no audit record is written.
+
+    Returns:
+        dict: maps customer id to Money owed on open invoices.
+    """
+    totals = {customer_id: Money.zero() for customer_id in db.customers}
+    for invoice in db.invoices.values():
+        if invoice.status != "open":
+            continue
+        customer_id = db.shipments[invoice.shipment_id].customer_id
+        amount = Money.parse(invoice.amount)
+        totals[customer_id] = totals.get(customer_id, Money.zero()) + amount
+    return totals
 
 
