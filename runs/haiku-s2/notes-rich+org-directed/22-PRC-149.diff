+def split_shipment(shipment_id: str, weights: list[float]) -> list[Shipment]:
+    """Split a created shipment into new shipments, one per weight.
+
+    The new shipments copy the customer and zone of the original. The original
+    is kept with status "split". All validation runs before any change is made.
+
+    Args:
+        shipment_id: Id of the shipment to split. Must be in status "created".
+        weights: Non-empty list of positive weights in kg. They must add up to
+            the original shipment's weight.
+
+    Returns:
+        list[Shipment]: The new shipments, in the same order as ``weights``.
+
+    Raises:
+        DomainError: E_BAD_INPUT if ``shipment_id`` is blank or not a string, or
+            ``weights`` is not a non-empty list of numbers. E_NOT_FOUND if the
+            shipment does not exist. E_BAD_STATE if the shipment is not in status
+            "created". E_BAD_WEIGHT if a weight is not positive, or the weights
+            do not add up to the original shipment's weight.
+    """
+    if not isinstance(shipment_id, str) or not shipment_id.strip():
+        raise DomainError("E_BAD_INPUT", "shipment_id must be a non-blank string")
+    if not isinstance(weights, (list, tuple)) or len(weights) == 0:
+        raise DomainError("E_BAD_INPUT", "weights must be a non-empty list")
+    for weight in weights:
+        if isinstance(weight, bool) or not isinstance(weight, (int, float)):
+            raise DomainError("E_BAD_INPUT", f"weight is not a number: {weight!r}")
+        if weight <= 0:
+            raise DomainError("E_BAD_WEIGHT", str(weight))
+
+    if shipment_id not in db.shipments:
+        raise DomainError("E_NOT_FOUND", shipment_id)
+    original = db.shipments[shipment_id]
+    if original.status != "created":
+        raise DomainError(
+            "E_BAD_STATE",
+            f"shipment {shipment_id} is {original.status}, expected created",
+        )
+    total = sum(weights)
+    if not math.isclose(total, original.weight_kg):
+        raise DomainError(
+            "E_BAD_WEIGHT",
+            f"weights sum to {total}, shipment weighs {original.weight_kg}",
+        )
+
+    now = clock.now()
+    new_shipments = []
+    for weight in weights:
+        shipment = Shipment(
+            id=ids.new_id("shp"),
+            customer_id=original.customer_id,
+            weight_kg=weight,
+            zone=original.zone,
+            created_at=now,
+        )
+        db.shipments[shipment.id] = shipment
+        events.emit("shipment.created", shipment.id, zone=shipment.zone)
+        new_shipments.append(shipment)
+
+    original.status = "split"
+    events.emit(
+        "shipment.split",
+        original.id,
+        new_ids=[s.id for s in new_shipments],
+    )
+    return new_shipments
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_shipments_split.py b/tests/unit/test_shipments_split.py
