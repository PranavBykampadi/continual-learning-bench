+++ b/tests/unit/test_shipments_split.py	2026-11-10 15:09:30
@@ -0,0 +1,105 @@
+import pytest
+
+from parcelo import customers, events, shipments
+from parcelo.errors import DomainError
+from parcelo.store import db
+
+
+def _created(weight=10.0, zone="national"):
+    c = customers.add_customer("Acme")
+    return shipments.create_shipment(c.id, weight, zone)
+
+
+def test_split_creates_one_shipment_per_weight_in_order():
+    s = _created(weight=10.0, zone="international")
+    parts = shipments.split_shipment(s.id, [4.0, 6.0])
+
+    assert [p.weight_kg for p in parts] == [4.0, 6.0]
+    for p in parts:
+        assert p.id.startswith("shp_")
+        assert p.id != s.id
+        assert p.customer_id == s.customer_id
+        assert p.zone == "international"
+        assert p.status == "created"
+        assert db.shipments[p.id] is p
+
+
+def test_split_marks_original_as_split():
+    s = _created(weight=10.0)
+    shipments.split_shipment(s.id, [5.0, 5.0])
+
+    assert db.shipments[s.id].status == "split"
+
+
+def test_split_emits_events():
+    s = _created(weight=3.0)
+    events.OUTBOX.clear()
+    parts = shipments.split_shipment(s.id, [1.0, 2.0])
+
+    names = [e["name"] for e in events.OUTBOX]
+    assert names == ["shipment.created", "shipment.created", "shipment.split"]
+    assert events.OUTBOX[-1]["entity_id"] == s.id
+    assert events.OUTBOX[-1]["payload"]["new_ids"] == [p.id for p in parts]
+
+
+def test_split_accepts_float_weights_that_add_up():
+    s = _created(weight=0.3)
+    parts = shipments.split_shipment(s.id, [0.1, 0.2])
+
+    assert [p.weight_kg for p in parts] == [0.1, 0.2]
+
+
+def test_split_unknown_shipment_fails():
+    with pytest.raises(DomainError) as err:
+        shipments.split_shipment("shp_missing", [1.0])
+    assert err.value.code == "E_NOT_FOUND"
+
+
+def test_split_shipment_not_in_created_status_fails():
+    s = _created(weight=4.0)
+    shipments.split_shipment(s.id, [2.0, 2.0])
+
+    with pytest.raises(DomainError) as err:
+        shipments.split_shipment(s.id, [2.0, 2.0])
+    assert err.value.code == "E_BAD_STATE"
+    assert "split" in err.value.message
+
+
