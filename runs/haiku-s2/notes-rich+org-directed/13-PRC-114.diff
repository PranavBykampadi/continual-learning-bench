+def _naive_utc(moment):
+    # Stored timestamps are naive UTC; clock.now() is aware UTC. Normalize before subtracting.
+    if moment.tzinfo is not None:
+        return moment.astimezone(timezone.utc).replace(tzinfo=None)
+    return moment
+
+
+def _age_days(issued_at, today):
+    # Same arithmetic as legacy/billing.days_between. Reimplemented because
+    # parcelo/legacy is scheduled for deletion.
+    return (today - issued_at).days
+
+
+def aging_report():
+    """Total open invoice amounts bucketed by age in whole days since issue.
+
+    Only invoices with status "open" are counted; paid and void invoices are left out.
+    Read-only: no state change, no audit record.
+    """
+    today = _naive_utc(clock.now())
+    buckets = {"0-30": Money.zero(), "31-60": Money.zero(), "60+": Money.zero()}
+    for invoice in db.invoices.values():
+        if invoice.status != "open":
+            continue
+        age = _age_days(_naive_utc(invoice.issued_at), today)
+        amount = Money.parse(invoice.amount)
+        if age <= 30:
+            key = "0-30"
+        elif age <= 60:
+            key = "31-60"
+        else:
+            key = "60+"
+        buckets[key] = buckets[key] + amount
+    return buckets
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_reports.py b/tests/unit/test_reports.py
--- a/tests/unit/test_reports.py	1969-12-31 19:00:00
+++ b/tests/unit/test_reports.py	2026-11-10 14:59:57
@@ -0,0 +1,74 @@
+from datetime import datetime, timedelta, timezone
+
+from parcelo import clock, reports
+from parcelo.models import Invoice
+from parcelo.money import Money
+from parcelo.store import db
+
+TODAY = datetime(2026, 11, 10, 12, 0, 0, tzinfo=timezone.utc)
+
+
+def _add(inv_id, amount, days_old, status="open"):
+    # Stored timestamps are naive UTC.
+    issued = (TODAY - timedelta(days=days_old)).replace(tzinfo=None)
+    db.invoices[inv_id] = Invoice(
+        id=inv_id, shipment_id="shp_x", amount=amount, status=status, issued_at=issued
+    )
+
+
+def test_empty_report_is_all_zero():
+    clock.set_fixed(TODAY)
+    assert reports.aging_report() == {
+        "0-30": Money.zero(),
+        "31-60": Money.zero(),
+        "60+": Money.zero(),
+    }
+
+
+def test_bucket_boundaries():
+    clock.set_fixed(TODAY)
+    _add("a", 1.00, 0)
+    _add("b", 2.00, 30)   # still 0-30
+    _add("c", 4.00, 31)   # first day of 31-60
+    _add("d", 8.00, 60)   # last day of 31-60
+    _add("e", 16.00, 61)  # 60+
+    report = reports.aging_report()
+    assert report["0-30"] == Money(300)
+    assert report["31-60"] == Money(1200)
+    assert report["60+"] == Money(1600)
+
+
+def test_partial_day_is_not_counted_as_extra_day():
+    clock.set_fixed(TODAY)
+    issued = (TODAY - timedelta(days=30, hours=23)).replace(tzinfo=None)
+    db.invoices["x"] = Invoice(id="x", shipment_id="shp_x", amount=5.0, issued_at=issued)
+    assert reports.aging_report()["0-30"] == Money(500)
+
+
+def test_paid_and_void_invoices_are_left_out():
+    clock.set_fixed(TODAY)
+    _add("paid", 100.0, 10, status="paid")
+    _add("void", 50.0, 10, status="void")
+    _add("open", 7.5, 10)
+    report = reports.aging_report()
+    assert report["0-30"] == Money(750)
+    assert report["31-60"] == Money.zero()
+    assert report["60+"] == Money.zero()
+
+
+def test_sums_multiple_invoices_in_same_bucket():
+    clock.set_fixed(TODAY)
+    _add("a", 10.10, 5)
+    _add("b", 0.20, 6)
+    assert reports.aging_report()["0-30"] == Money(1030)
+
+
+def test_does_not_mutate_state_or_audit():
+    from parcelo import audit
+
+    clock.set_fixed(TODAY)
+    _add("a", 3.0, 45)
+    before = db.invoices["a"].status
+    reports.aging_report()
+    assert db.invoices["a"].status == before == "open"
+    assert audit.LOG == []
