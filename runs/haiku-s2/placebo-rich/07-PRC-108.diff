+def outstanding_by_customer():
+    balances = {customer_id: 0.0 for customer_id in db.customers}
+    for invoice in db.invoices.values():
+        if invoice.status != "open":
+            continue
+        shipment = db.shipments.get(invoice.shipment_id)
+        if shipment is None:
+            continue
+        balances[shipment.customer_id] = balances.get(shipment.customer_id, 0.0) + invoice.amount
+    return {customer_id: round(total, 2) for customer_id, total in balances.items()}
