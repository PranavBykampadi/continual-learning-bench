diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/test_reports.py b/tests/test_reports.py
--- a/tests/test_reports.py	1969-12-31 19:00:00
+++ b/tests/test_reports.py	2026-11-10 12:51:59
@@ -0,0 +1,17 @@
+from parcelo import reports
+from parcelo.models import Customer, Invoice, Shipment
+from parcelo.store import db
+
+
+def test_outstanding_by_customer_counts_only_open_invoices():
+    db.customers["C1"] = Customer(id="C1", name="A")
+    db.customers["C2"] = Customer(id="C2", name="B")
+    db.shipments["S1"] = Shipment(id="S1", customer_id="C1", weight_kg=1, zone="local")
+    db.shipments["S2"] = Shipment(id="S2", customer_id="C1", weight_kg=1, zone="local")
+    db.shipments["S3"] = Shipment(id="S3", customer_id="C2", weight_kg=1, zone="local")
+    db.invoices["I1"] = Invoice(id="I1", shipment_id="S1", amount=10.0, status="open")
+    db.invoices["I2"] = Invoice(id="I2", shipment_id="S2", amount=5.5, status="open")
+    db.invoices["I3"] = Invoice(id="I3", shipment_id="S2", amount=99.0, status="paid")
+    db.invoices["I4"] = Invoice(id="I4", shipment_id="S3", amount=42.0, status="void")
+
+    assert reports.outstanding_by_customer() == {"C1": 15.5, "C2": 0.0}
