--- a/parcelo/shipments.py	2026-11-10 12:17:53
+++ b/parcelo/shipments.py	2026-11-10 12:52:51
@@ -28,3 +28,11 @@
     if shipment_id not in db.shipments:
         raise DomainError("E_NOT_FOUND", shipment_id)
     return db.shipments[shipment_id]
+
+
+def add_note(shipment_id, text):
+    shipment = get_shipment(shipment_id)
+    if not isinstance(text, str) or not text.strip():
+        raise DomainError("E_BAD_INPUT", "note text must be non-empty")
+    shipment.notes.append({"text": text, "at": clock.now()})
+    return shipment
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_shipments.py b/tests/unit/test_shipments.py
--- a/tests/unit/test_shipments.py	2026-11-10 12:17:53
+++ b/tests/unit/test_shipments.py	2026-11-10 12:52:52
@@ -11,6 +11,30 @@
     assert audit.LOG[-1]["action"] == "shipment.created"
 
 
+def test_add_note_is_timestamped():
+    clock.set_fixed("2026-11-10T00:00:00+00:00")
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 1.5, "national")
+    result = shipments.add_note(s.id, "left at door")
+    assert result is s
+    assert s.notes == [{"text": "left at door", "at": "2026-11-10T00:00:00+00:00"}]
+
+
+def test_add_note_unknown_shipment():
+    with pytest.raises(DomainError) as err:
+        shipments.add_note("shp_missing", "hi")
+    assert err.value.code == "E_NOT_FOUND"
+
+
+def test_add_note_empty_text():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 1.5, "national")
+    with pytest.raises(DomainError) as err:
+        shipments.add_note(s.id, "   ")
+    assert err.value.code == "E_BAD_INPUT"
+    assert s.notes == []
+
+
