+def _as_utc(moment):
+    # issue_invoice stores naive UTC timestamps; clock.now() is timezone-aware.
+    if moment.tzinfo is None:
+        return moment.replace(tzinfo=timezone.utc)
+    return moment
+
+
+def late_fee_for(invoice_id):
+    """Late fee accrued by an invoice as of now.
+
+    The invoice is late 30 days after issue. From then on the fee is 1.5% of
+    the invoice amount for each full day past those 30 days. Returns Money.
+    """
+    if invoice_id not in db.invoices:
+        raise DomainError("E_NOT_FOUND", invoice_id)
+    invoice = db.invoices[invoice_id]
+    elapsed = _as_utc(clock.now()) - _as_utc(invoice.issued_at)
+    days_late = (elapsed - LATE_AFTER).days
+    if days_late <= 0:
+        return Money.zero()
+    amount = Money.parse(invoice.amount)
+    return amount.scale(LATE_FEE_RATE_PER_DAY * days_late)
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_late_fee.py b/tests/unit/test_late_fee.py
--- a/tests/unit/test_late_fee.py	1969-12-31 19:00:00
+++ b/tests/unit/test_late_fee.py	2026-11-10 12:51:54
@@ -0,0 +1,60 @@
+from datetime import datetime, timedelta, timezone
+
+import pytest
+
+from parcelo import clock, invoices
+from parcelo.errors import DomainError
+from parcelo.models import Invoice
+from parcelo.money import Money
+from parcelo.store import db
+
+ISSUED = datetime(2026, 1, 1, tzinfo=timezone.utc)
+
+
+def _invoice(amount=100.0, issued_at=ISSUED):
+    inv = Invoice(id="INV-TEST", shipment_id="shp_x", amount=amount, issued_at=issued_at)
+    db.invoices[inv.id] = inv
+    return inv
+
+
+def _at(days_after_issue):
+    clock.set_fixed(ISSUED + timedelta(days=days_after_issue))
+
+
+def test_not_late_before_30_days_is_zero():
+    _invoice()
+    _at(29)
+    assert invoices.late_fee_for("INV-TEST") == Money.zero()
+
+
+def test_exactly_30_days_is_zero():
+    _invoice()
+    _at(30)
+    assert invoices.late_fee_for("INV-TEST") == Money.zero()
+
+
+def test_fee_is_1_5_percent_per_day_past_30():
+    _invoice(amount=100.0)
+    _at(33)
+    fee = invoices.late_fee_for("INV-TEST")
+    assert isinstance(fee, Money)
+    assert fee == Money(450)  # 3 days * 1.5% of $100.00 = $4.50
+
+
+def test_partial_day_past_30_does_not_count():
+    _invoice(amount=100.0)
+    _at(30)
+    clock.set_fixed(ISSUED + timedelta(days=30, hours=23))
+    assert invoices.late_fee_for("INV-TEST") == Money.zero()
+
+
+def test_naive_issued_at_is_treated_as_utc():
+    _invoice(amount=100.0, issued_at=datetime(2026, 1, 1))
+    _at(32)
+    assert invoices.late_fee_for("INV-TEST") == Money(300)
+
+
+def test_unknown_invoice_fails():
+    with pytest.raises(DomainError) as err:
+        invoices.late_fee_for("INV-missing")
+    assert err.value.code == "E_NOT_FOUND"
