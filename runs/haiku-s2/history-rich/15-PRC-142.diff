diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_invoice_reopen.py b/tests/unit/test_invoice_reopen.py
--- a/tests/unit/test_invoice_reopen.py	1969-12-31 19:00:00
+++ b/tests/unit/test_invoice_reopen.py	2026-11-10 12:56:56
@@ -0,0 +1,49 @@
+import pytest
+
+from parcelo import customers, events, invoices, shipments, store
+from parcelo.errors import DomainError
+
+
+def _paid_invoice():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 2, "local")
+    inv = invoices.issue_invoice(s.id)
+    return invoices.mark_paid(inv.id)
+
+
+def test_reopen_paid_invoice():
+    inv = _paid_invoice()
+    result = invoices.reopen_invoice(inv.id)
+    assert result is inv
+    assert inv.status == "open"
+    assert inv.paid_at is None
+    assert inv.reopened_at is not None
+    assert inv in invoices.open_invoices()
+
+
+def test_reopen_emits_event():
+    inv = _paid_invoice()
+    events.OUTBOX.clear()
+    invoices.reopen_invoice(inv.id)
+    assert events.OUTBOX[-1]["name"] == "invoice.reopened"
+    assert events.OUTBOX[-1]["entity_id"] == inv.id
+
+
+def test_reopen_missing_invoice_fails():
+    with pytest.raises(DomainError) as err:
+        invoices.reopen_invoice("INV-missing")
+    assert err.value.code == "E_NOT_FOUND"
+    assert "INV-missing" not in store.db.invoices
+
+
+def test_reopen_unpaid_invoice_fails_and_is_unchanged():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 2, "local")
+    inv = invoices.issue_invoice(s.id)
+    events.OUTBOX.clear()
+    with pytest.raises(DomainError) as err:
+        invoices.reopen_invoice(inv.id)
+    assert err.value.code == "E_BAD_STATE"
+    assert inv.status == "open"
+    assert inv.reopened_at is None
+    assert not any(e["name"] == "invoice.reopened" for e in events.OUTBOX)
