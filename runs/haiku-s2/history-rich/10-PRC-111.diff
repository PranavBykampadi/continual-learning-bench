     if shipment_id not in db.shipments:
         raise DomainError("E_NOT_FOUND", shipment_id)
     return db.shipments[shipment_id]
+
+
+def add_note(shipment_id, text):
+    shipment = get_shipment(shipment_id)
+    if not isinstance(text, str) or not text.strip():
+        raise DomainError("E_BAD_INPUT", "note text must not be empty")
+    at = clock.now()
+    shipment.notes.append({"text": text, "at": at})
+    audit.record("shipment.note_added", shipment.id, at=at)
+    return shipment
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_shipment_notes.py b/tests/unit/test_shipment_notes.py
--- a/tests/unit/test_shipment_notes.py	1969-12-31 19:00:00
+++ b/tests/unit/test_shipment_notes.py	2026-11-10 12:54:22
@@ -0,0 +1,60 @@
+from datetime import datetime, timezone
+
+import pytest
+
+from parcelo import audit, clock, customers, shipments
+from parcelo.errors import DomainError
+
+
+def _shipment():
+    c = customers.add_customer("Acme")
+    return shipments.create_shipment(c.id, 1.5, "national")
+
+
+def test_add_note_appends_text_and_timestamp():
+    moment = datetime(2026, 11, 10, 12, 0, tzinfo=timezone.utc)
+    clock.set_fixed(moment)
+    s = _shipment()
+
+    result = shipments.add_note(s.id, "fragile")
+
+    assert result is s
+    assert s.notes == [{"text": "fragile", "at": moment}]
+
+
+def test_add_note_keeps_order_and_each_timestamp():
+    first = datetime(2026, 11, 10, 12, 0, tzinfo=timezone.utc)
+    second = datetime(2026, 11, 10, 13, 0, tzinfo=timezone.utc)
+    s = _shipment()
+
+    clock.set_fixed(first)
+    shipments.add_note(s.id, "one")
+    clock.set_fixed(second)
+    shipments.add_note(s.id, "two")
+
+    assert [n["text"] for n in s.notes] == ["one", "two"]
+    assert [n["at"] for n in s.notes] == [first, second]
+
+
+def test_add_note_records_audit_with_shipment_id():
+    s = _shipment()
+
+    shipments.add_note(s.id, "hello")
+
+    assert audit.LOG[-1]["action"] == "shipment.note_added"
+    assert audit.LOG[-1]["entity_id"] == s.id
+
+
+def test_add_note_unknown_shipment_fails():
+    with pytest.raises(DomainError) as err:
+        shipments.add_note("shp_missing", "hello")
+    assert err.value.code == "E_NOT_FOUND"
+
+
+@pytest.mark.parametrize("text", ["", "   "])
+def test_add_note_empty_text_fails(text):
+    s = _shipment()
+    with pytest.raises(DomainError) as err:
+        shipments.add_note(s.id, text)
+    assert err.value.code == "E_BAD_INPUT"
+    assert s.notes == []
