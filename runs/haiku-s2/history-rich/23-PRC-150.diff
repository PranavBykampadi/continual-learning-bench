+def set_credit_limit(customer_id, amount):
+    """Set a customer's credit limit and return the new limit as Money."""
+    customer = db.customers.get(customer_id)
+    if customer is None:
+        raise DomainError("E_UNKNOWN_CUSTOMER", f"no customer {customer_id}")
+    try:
+        limit = Money.parse(amount)
+    except (ArithmeticError, TypeError, ValueError, InvalidOperation):
+        raise DomainError("E_BAD_INPUT", f"invalid amount {amount!r}")
+    if limit.cents < 0:
+        raise DomainError("E_BAD_INPUT", "credit limit cannot be negative")
+    previous = customer.credit_limit
+    customer.credit_limit = limit
+    events.emit(
+        "customer.credit_limit_set",
+        customer_id,
+        previous_cents=previous.cents,
+        new_cents=limit.cents,
+    )
+    return limit
 
 
