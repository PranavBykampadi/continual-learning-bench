 ZONE_BASE = {"local": 4.5, "national": 9.0, "international": 24.0}
 PER_KG = 1.25
 
@@ -12,3 +14,19 @@
     if weight_kg <= 0:
         raise ValueError("weight must be positive")
     return round(base_rate(zone) + PER_KG * weight_kg, 2)
+
+
+def quote_with_surcharge(weight_kg, zone):
+    """Quote plus the zone's fuel surcharge.
+
+    Returns a dict with ``quote`` (base quote), ``surcharge`` (fuel surcharge
+    on that quote) and ``total`` (quote + surcharge). Raises ValueError for an
+    unknown zone or a non-positive weight.
+    """
+    base = quote(weight_kg, zone)
+    surcharge = billing.fuel_surcharge(base, zone)
+    return {
+        "quote": base,
+        "surcharge": surcharge,
+        "total": round(base + surcharge, 2),
+    }
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_rates_surcharge.py b/tests/unit/test_rates_surcharge.py
--- a/tests/unit/test_rates_surcharge.py	1969-12-31 19:00:00
+++ b/tests/unit/test_rates_surcharge.py	2026-11-10 12:50:09
@@ -0,0 +1,33 @@
+import pytest
+
+from parcelo import rates
+
+
+def test_local_has_no_surcharge():
+    result = rates.quote_with_surcharge(2, "local")
+    assert result == {"quote": 7.0, "surcharge": 0.0, "total": 7.0}
+
+
+def test_national_adds_four_percent():
+    result = rates.quote_with_surcharge(2, "national")
+    assert result["quote"] == 11.5
+    assert result["surcharge"] == 0.46
+    assert result["total"] == 11.96
+
+
+def test_international_adds_nine_point_five_percent():
+    result = rates.quote_with_surcharge(1, "international")
+    assert result["quote"] == 25.25
+    assert result["surcharge"] == 2.4
+    assert result["total"] == 27.65
+
+
+def test_unknown_zone_raises():
+    with pytest.raises(ValueError):
+        rates.quote_with_surcharge(1, "moon")
+
+
+@pytest.mark.parametrize("weight", [0, -1, -0.5])
+def test_non_positive_weight_raises(weight):
+    with pytest.raises(ValueError):
+        rates.quote_with_surcharge(weight, "national")
