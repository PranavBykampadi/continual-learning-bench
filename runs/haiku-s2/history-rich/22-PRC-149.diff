+++ b/tests/unit/test_shipment_split.py	2026-11-10 13:00:41
@@ -0,0 +1,80 @@
+import pytest
+
+from parcelo import customers, events, shipments
+from parcelo.errors import DomainError
+
+
+def _shipment(weight=3.0, zone="national"):
+    c = customers.add_customer("Acme")
+    return shipments.create_shipment(c.id, weight, zone)
+
+
+def test_split_creates_one_shipment_per_weight_in_order():
+    s = _shipment(3.0, "international")
+    parts = shipments.split_shipment(s.id, [1.0, 0.5, 1.5])
+
+    assert [p.weight_kg for p in parts] == [1.0, 0.5, 1.5]
+    for p in parts:
+        assert p.id != s.id
+        assert p.status == "created"
+        assert p.customer_id == s.customer_id
+        assert p.zone == "international"
+
+
+def test_split_marks_original_as_split():
+    s = _shipment(2.0)
+    shipments.split_shipment(s.id, [1.0, 1.0])
+    assert shipments.get_shipment(s.id).status == "split"
+
+
+def test_split_emits_events():
+    s = _shipment(2.0)
+    events.OUTBOX.clear()
+    parts = shipments.split_shipment(s.id, [1.0, 1.0])
+    names = [e["name"] for e in events.OUTBOX]
+    assert names == ["shipment.split", "shipment.created", "shipment.created"]
+    assert events.OUTBOX[0]["entity_id"] == s.id
+    assert [e["entity_id"] for e in events.OUTBOX[1:]] == [p.id for p in parts]
+
+
+def test_split_unknown_shipment_fails():
+    with pytest.raises(DomainError) as err:
+        shipments.split_shipment("shp_999999", [1.0])
+    assert err.value.code == "E_NOT_FOUND"
+
+
+def test_split_non_created_shipment_fails_and_is_unchanged():
+    s = _shipment(2.0)
+    s.status = "delivered"
+    before = len(shipments.db.shipments)
+    with pytest.raises(DomainError) as err:
+        shipments.split_shipment(s.id, [1.0, 1.0])
+    assert err.value.code == "E_BAD_STATE"
+    assert len(shipments.db.shipments) == before
+    assert s.status == "delivered"
+
+
+def test_split_weights_not_summing_to_original_fails_and_is_unchanged():
+    s = _shipment(2.0)
+    before = len(shipments.db.shipments)
+    with pytest.raises(DomainError) as err:
+        shipments.split_shipment(s.id, [1.0, 0.5])
+    assert err.value.code == "E_BAD_INPUT"
+    assert len(shipments.db.shipments) == before
+    assert shipments.get_shipment(s.id).status == "created"
+
+
+def test_split_non_positive_weight_fails_and_is_unchanged():
+    s = _shipment(2.0)
+    with pytest.raises(DomainError) as err:
+        shipments.split_shipment(s.id, [3.0, -1.0])
+    assert err.value.code == "E_BAD_WEIGHT"
+    assert shipments.get_shipment(s.id).status == "created"
+
+
+def test_split_empty_weights_fails():
+    s = _shipment(2.0)
+    with pytest.raises(DomainError) as err:
+        shipments.split_shipment(s.id, [])
+    assert err.value.code == "E_BAD_INPUT"
+    assert shipments.get_shipment(s.id).status == "created"
