+def split_shipment(shipment_id, weights):
+    """Replace a shipment in status "created" with one new shipment per weight.
+
+    Returns the new shipments in the same order as ``weights``. The original
+    is kept with status "split". All validation happens before any change.
+    """
+    original = get_shipment(shipment_id)
+    if original.status != "created":
+        raise DomainError("E_BAD_STATE", shipment_id)
+    weights = list(weights)
+    if not weights:
+        raise DomainError("E_BAD_INPUT", "no weights given")
+    for weight in weights:
+        if weight <= 0:
+            raise DomainError("E_BAD_WEIGHT", str(weight))
+    # Compare as decimals so float rounding does not reject valid splits.
+    if sum(Decimal(str(w)) for w in weights) != Decimal(str(original.weight_kg)):
+        raise DomainError("E_BAD_INPUT", "weights must add up to the shipment weight")
+
+    children = []
+    for weight in weights:
+        child = Shipment(
+            id=ids.new_id("shp"),
+            customer_id=original.customer_id,
+            weight_kg=weight,
+            zone=original.zone,
+            created_at=clock.now(),
+        )
+        db.shipments[child.id] = child
+        children.append(child)
+
+    original.status = "split"
+    events.emit("shipment.split", original.id, children=[c.id for c in children])
+    for child in children:
+        events.emit("shipment.created", child.id, zone=child.zone)
+    return children
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_shipment_split.py b/tests/unit/test_shipment_split.py
