diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_aging_report.py b/tests/unit/test_aging_report.py
--- a/tests/unit/test_aging_report.py	1969-12-31 19:00:00
+++ b/tests/unit/test_aging_report.py	2026-11-10 12:56:07
@@ -0,0 +1,76 @@
+from datetime import datetime, timedelta, timezone
+
+from parcelo import clock, reports
+from parcelo.models import Invoice
+from parcelo.money import Money
+from parcelo.store import db
+
+NOW = datetime(2026, 11, 10, 12, 0, tzinfo=timezone.utc)
+
+
+def _add(inv_id, amount, days_old, status="open"):
+    db.invoices[inv_id] = Invoice(
+        id=inv_id,
+        shipment_id="shp_x",
+        amount=amount,
+        status=status,
+        issued_at=NOW - timedelta(days=days_old),
+    )
+
+
+def _cents(report):
+    return {k: v.cents for k, v in report.items()}
+
+
+def test_empty_report_is_all_zero():
+    clock.set_fixed(NOW)
+    report = reports.aging_report()
+    assert list(report) == ["0-30", "31-60", "60+"]
+    assert all(v == Money.zero() for v in report.values())
+
+
+def test_bucket_boundaries():
+    clock.set_fixed(NOW)
+    _add("a", 1.0, 0)
+    _add("b", 2.0, 30)
+    _add("c", 4.0, 31)
+    _add("d", 8.0, 60)
+    _add("e", 16.0, 61)
+    assert _cents(reports.aging_report()) == {
+        "0-30": 300,
+        "31-60": 1200,
+        "60+": 1600,
+    }
+
+
+def test_paid_invoices_are_excluded():
+    clock.set_fixed(NOW)
+    _add("open_new", 5.0, 3)
+    _add("paid_old", 50.0, 90, status="paid")
+    assert _cents(reports.aging_report()) == {"0-30": 500, "31-60": 0, "60+": 0}
+
+
+def test_naive_issued_at_is_treated_as_utc():
+    clock.set_fixed(NOW)
+    db.invoices["naive"] = Invoice(
+        id="naive",
+        shipment_id="shp_x",
+        amount=12.0,
+        issued_at=datetime(2026, 9, 1, 12, 0),  # 70 days before NOW, naive
+    )
+    assert _cents(reports.aging_report())["60+"] == 1200
+
+
+def test_amounts_are_summed_as_money_not_floats():
+    clock.set_fixed(NOW)
+    _add("a", 10.10, 5)
+    _add("b", 0.20, 5)
+    report = reports.aging_report()
+    assert report["0-30"] == Money(1030)
+    assert isinstance(report["0-30"], Money)
+
+
+def test_invoice_without_issue_date_is_skipped():
+    clock.set_fixed(NOW)
+    db.invoices["no_date"] = Invoice(id="no_date", shipment_id="shp_x", amount=99.0)
+    assert _cents(reports.aging_report()) == {"0-30": 0, "31-60": 0, "60+": 0}
