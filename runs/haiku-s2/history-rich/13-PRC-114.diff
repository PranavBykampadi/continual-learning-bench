-from datetime import datetime
+from datetime import datetime, timezone
 
+from parcelo import clock
+from parcelo.money import Money
 from parcelo.store import db
+
+
+def _as_utc(moment):
+    if moment.tzinfo is None:
+        return moment.replace(tzinfo=timezone.utc)
+    return moment
+
+
+def _whole_days_between(start, end):
+    return (_as_utc(end) - _as_utc(start)).days
+
+
+def aging_report():
+    """Total unpaid invoice amounts grouped by age in whole days since issue."""
+    now = clock.now()
+    buckets = {"0-30": Money.zero(), "31-60": Money.zero(), "60+": Money.zero()}
+    for invoice in db.invoices.values():
+        if invoice.status == "paid" or invoice.issued_at is None:
+            continue
+        age = _whole_days_between(invoice.issued_at, now)
+        if age <= 30:
+            key = "0-30"
+        elif age <= 60:
+            key = "31-60"
+        else:
+            key = "60+"
+        buckets[key] = buckets[key] + Money.parse(invoice.amount)
+    return buckets
 
 
