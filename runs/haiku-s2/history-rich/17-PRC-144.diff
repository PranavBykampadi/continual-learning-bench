 ZONE_BASE = {"local": 4.5, "national": 9.0, "international": 24.0}
 PER_KG = 1.25
 
+# Fuel surcharge percentage per zone (same values as the legacy billing table,
+# copied here so new code does not depend on parcelo.legacy).
+ZONE_FUEL_SURCHARGE_PCT = {"local": Decimal("0.0"), "national": Decimal("4.0"), "international": Decimal("9.5")}
+INSURANCE_RATE = Decimal("0.02")
+INSURANCE_MIN_FEE = Money(100)
 
+
 def base_rate(zone):
     if zone not in ZONE_BASE:
         raise ValueError("unknown zone: %s" % zone)
@@ -12,3 +23,18 @@
     if weight_kg <= 0:
         raise ValueError("weight must be positive")
     return round(base_rate(zone) + PER_KG * weight_kg, 2)
+
+
+def insurance_fee(declared_value, zone):
+    """Insurance fee as Money: 2% of declared value plus the zone's fuel
+    surcharge percentage of declared value, with a minimum fee of 1.00."""
+    if zone not in ZONE_FUEL_SURCHARGE_PCT:
+        raise DomainError("E_BAD_ZONE", "unknown zone: %s" % zone)
+    value = Money.parse(declared_value)
+    if value.cents <= 0:
+        raise DomainError("E_BAD_INPUT", "declared value must be positive")
+    factor = INSURANCE_RATE + ZONE_FUEL_SURCHARGE_PCT[zone] / Decimal("100")
+    fee = value.scale(factor)
+    if fee < INSURANCE_MIN_FEE:
+        return INSURANCE_MIN_FEE
+    return fee
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_insurance_fee.py b/tests/unit/test_insurance_fee.py
--- a/tests/unit/test_insurance_fee.py	1969-12-31 19:00:00
+++ b/tests/unit/test_insurance_fee.py	2026-11-10 12:58:03
@@ -0,0 +1,41 @@
+import pytest
+
+from parcelo.errors import DomainError
+from parcelo.money import Money
+from parcelo.rates import insurance_fee
+
+
+def test_local_fee_is_two_percent():
+    assert insurance_fee(1000, "local") == Money(2000)
+
+
+def test_national_fee_adds_fuel_surcharge():
+    # 2% + 4% of 1000.00
+    assert insurance_fee(1000, "national") == Money(6000)
+
+
+def test_international_fee_adds_fuel_surcharge():
+    # 2% + 9.5% of 1000.00
+    assert insurance_fee(1000, "international") == Money(11500)
+
+
+def test_minimum_fee_applies():
+    # 2% of 10.00 is 0.20, so the 1.00 minimum applies
+    assert insurance_fee(10, "local") == Money(100)
+
+
+def test_accepts_money_input():
+    assert insurance_fee(Money(100000), "local") == Money(2000)
+
+
+@pytest.mark.parametrize("value", [0, -5, -0.01])
+def test_non_positive_value_fails(value):
+    with pytest.raises(DomainError) as err:
+        insurance_fee(value, "local")
+    assert err.value.code == "E_BAD_INPUT"
+
+
+def test_unknown_zone_fails():
+    with pytest.raises(DomainError) as err:
+        insurance_fee(100, "mars")
+    assert err.value.code == "E_BAD_ZONE"
