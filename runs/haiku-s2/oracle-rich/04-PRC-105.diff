diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_refunds.py b/tests/unit/test_refunds.py
--- a/tests/unit/test_refunds.py	1969-12-31 19:00:00
+++ b/tests/unit/test_refunds.py	2026-11-10 12:51:06
@@ -0,0 +1,56 @@
+import pytest
+
+from parcelo import audit, refunds
+from parcelo.errors import DomainError
+from parcelo.models import Invoice
+from parcelo.money import Money
+from parcelo.store import db
+
+
+def _invoice(invoice_id="INV-1", status="paid"):
+    inv = Invoice(id=invoice_id, shipment_id="shp_x", amount=10.0, status=status)
+    db.invoices[inv.id] = inv
+    return inv
+
+
+def test_refund_paid_invoice_is_stored_and_audited():
+    _invoice()
+    r = refunds.create_refund("INV-1", "4.50")
+    assert r.id.startswith("ref_")
+    assert r.invoice_id == "INV-1"
+    assert r.amount == Money(450)
+    assert r.created_at is not None
+    assert db.refunds[r.id] is r
+    assert audit.LOG[-1]["action"] == "refund.created"
+    assert audit.LOG[-1]["entity_id"] == r.id
+
+
+def test_refund_accepts_money_and_float():
+    _invoice()
+    assert refunds.create_refund("INV-1", Money(100)).amount == Money(100)
+    assert refunds.create_refund("INV-1", 2.5).amount == Money(250)
+
+
+def test_unknown_invoice_fails():
+    with pytest.raises(DomainError) as err:
+        refunds.create_refund("INV-missing", 1)
+    assert err.value.code == "E_NOT_FOUND"
+    assert db.refunds == {}
+
+
+@pytest.mark.parametrize("status", ["open", "void"])
+def test_unpaid_invoice_fails(status):
+    _invoice(status=status)
+    with pytest.raises(DomainError) as err:
+        refunds.create_refund("INV-1", 1)
+    assert err.value.code == "E_BAD_STATE"
+    assert db.refunds == {}
+
+
+@pytest.mark.parametrize("amount", [0, -1, "0"])
+def test_non_positive_amount_fails(amount):
+    _invoice()
+    with pytest.raises(DomainError) as err:
+        refunds.create_refund("INV-1", amount)
+    assert err.value.code == "E_BAD_INPUT"
+    assert db.refunds == {}
