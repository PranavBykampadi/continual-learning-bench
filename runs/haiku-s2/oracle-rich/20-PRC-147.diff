diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_volume_report.py b/tests/unit/test_volume_report.py
--- a/tests/unit/test_volume_report.py	1969-12-31 19:00:00
+++ b/tests/unit/test_volume_report.py	2026-11-10 12:59:22
@@ -0,0 +1,44 @@
+from parcelo import customers, reports, shipments
+
+
+def _ship(customer_id, n):
+    for _ in range(n):
+        shipments.create_shipment(customer_id, 1.0, "local")
+
+
+def test_customer_without_shipments_is_included():
+    c = customers.add_customer("Idle")
+    assert reports.volume_report() == {c.id: {"shipments": 0, "tier": "starter"}}
+
+
+def test_empty_database_gives_empty_report():
+    assert reports.volume_report() == {}
+
+
+def test_counts_only_that_customers_shipments():
+    a = customers.add_customer("Acme")
+    b = customers.add_customer("Bolt")
+    _ship(a.id, 3)
+    _ship(b.id, 1)
+    report = reports.volume_report()
+    assert report[a.id] == {"shipments": 3, "tier": "starter"}
+    assert report[b.id] == {"shipments": 1, "tier": "starter"}
+
+
+def test_tier_boundaries():
+    low = customers.add_customer("Low")
+    mid = customers.add_customer("Mid")
+    high = customers.add_customer("High")
+    _ship(low.id, 9)
+    _ship(mid.id, 10)
+    _ship(high.id, 50)
+    report = reports.volume_report()
+    assert report[low.id] == {"shipments": 9, "tier": "starter"}
+    assert report[mid.id] == {"shipments": 10, "tier": "regular"}
+    assert report[high.id] == {"shipments": 50, "tier": "bulk"}
+
+
+def test_below_bulk_threshold_is_regular():
+    c = customers.add_customer("Almost")
+    _ship(c.id, 49)
+    assert reports.volume_report()[c.id] == {"shipments": 49, "tier": "regular"}
