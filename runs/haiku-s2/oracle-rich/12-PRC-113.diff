+def apply_credit(invoice_id, amount):
+    """Reduce an open invoice by a credit and return the remaining amount as Money.
+
+    The invoice's stored amount stays a float because reports and the customer
+    balance sum that field; it is written from exact integer-cents arithmetic.
+    """
+    if invoice_id not in db.invoices:
+        raise DomainError("E_NOT_FOUND", f"invoice {invoice_id}")
+    invoice = db.invoices[invoice_id]
+    if invoice.status != "open":
+        raise DomainError("E_BAD_STATE", f"invoice {invoice_id} is {invoice.status}")
+    try:
+        credit = Money.parse(amount)
+    except (ArithmeticError, TypeError, ValueError):
+        raise DomainError("E_BAD_INPUT", "credit amount is not a number") from None
+    current = Money.parse(invoice.amount)
+    if credit.currency != current.currency:
+        raise DomainError("E_BAD_INPUT", f"credit currency {credit.currency} does not match")
+    if credit.cents <= 0:
+        raise DomainError("E_BAD_INPUT", "credit must be positive")
+    if current < credit:
+        raise DomainError("E_LIMIT", f"credit exceeds invoice amount {current}")
+    remaining = current - credit
+    invoice.amount = remaining.cents / 100
+    record(
+        "invoice.credit_applied",
+        invoice.id,
+        credit_cents=credit.cents,
+        remaining_cents=remaining.cents,
+    )
+    return remaining
