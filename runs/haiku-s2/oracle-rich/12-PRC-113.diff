+++ b/tests/unit/test_invoice_credit.py	2026-11-10 12:55:42
@@ -0,0 +1,79 @@
+import pytest
+
+from parcelo import audit, customers, invoices, reports, shipments
+from parcelo.errors import DomainError
+from parcelo.money import Money
+
+
+def _open_invoice():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 2, "local")
+    return c, invoices.issue_invoice(s.id)
+
+
+def test_credit_reduces_open_invoice_and_returns_money():
+    _, inv = _open_invoice()
+    remaining = invoices.apply_credit(inv.id, 2.5)
+    assert isinstance(remaining, Money)
+    assert remaining == Money(450)
+    assert inv.amount == 4.5
+    assert inv.status == "open"
+
+
+def test_credit_for_full_amount_leaves_zero():
+    _, inv = _open_invoice()
+    remaining = invoices.apply_credit(inv.id, Money.parse(7.0))
+    assert remaining.cents == 0
+    assert inv.amount == 0.0
+
+
+def test_reports_and_balance_work_after_credit():
+    c, inv = _open_invoice()
+    invoices.apply_credit(inv.id, 2)
+    assert customers.outstanding_balance(c.id) == 5.0
+    invoices.mark_paid(inv.id)
+    assert reports.revenue_total() == 5.0
+    assert customers.outstanding_balance(c.id) == 0.0
+
+
+def test_credit_is_audited_against_invoice():
+    _, inv = _open_invoice()
+    invoices.apply_credit(inv.id, 1)
+    entry = audit.LOG[-1]
+    assert entry["action"] == "invoice.credit_applied"
+    assert entry["entity_id"] == inv.id
+    assert entry["details"] == {"credit_cents": 100, "remaining_cents": 600}
+
+
+def test_unknown_invoice_fails():
+    with pytest.raises(DomainError) as err:
+        invoices.apply_credit("INV-missing", 1)
+    assert err.value.code == "E_NOT_FOUND"
+
+
+def test_paid_invoice_fails():
+    _, inv = _open_invoice()
+    invoices.mark_paid(inv.id)
+    with pytest.raises(DomainError) as err:
+        invoices.apply_credit(inv.id, 1)
+    assert err.value.code == "E_BAD_STATE"
+    assert inv.amount == 7.0
+
+
+def test_credit_larger_than_invoice_fails():
+    _, inv = _open_invoice()
+    audit_before = len(audit.LOG)
+    with pytest.raises(DomainError) as err:
+        invoices.apply_credit(inv.id, 7.01)
+    assert err.value.code == "E_LIMIT"
+    assert inv.amount == 7.0
+    assert len(audit.LOG) == audit_before
+
+
+@pytest.mark.parametrize("bad", [0, -1, "abc", None, float("nan"), float("inf")])
+def test_non_positive_or_invalid_credit_fails(bad):
+    _, inv = _open_invoice()
+    with pytest.raises(DomainError) as err:
+        invoices.apply_credit(inv.id, bad)
+    assert err.value.code == "E_BAD_INPUT"
+    assert inv.amount == 7.0
