+def set_credit_limit(customer_id, amount):
+    """Set a customer's credit limit to `amount` (dollars) and return it as Money."""
+    try:
+        limit = Money.parse(amount)
+    except (ArithmeticError, TypeError, ValueError):
+        raise DomainError("E_BAD_INPUT", f"credit limit not a number: {amount!r}")
+    if limit.cents < 0:
+        raise DomainError("E_BAD_INPUT", f"credit limit must not be negative: {amount!r}")
+    customer = db.customers.get(customer_id)
+    if customer is None:
+        raise DomainError("E_UNKNOWN_CUSTOMER", customer_id)
+    customer.credit_limit = limit
+    events.emit("customer.credit_limit_set", customer_id, cents=limit.cents)
+    return limit
 
 
