diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_customer_credit_limit.py b/tests/unit/test_customer_credit_limit.py
--- a/tests/unit/test_customer_credit_limit.py	1969-12-31 19:00:00
+++ b/tests/unit/test_customer_credit_limit.py	2026-11-10 13:01:06
@@ -0,0 +1,50 @@
+import pytest
+
+from parcelo import customers, events
+from parcelo.errors import DomainError
+from parcelo.money import Money
+from parcelo.store import db
+
+
+def test_set_credit_limit_updates_customer_and_returns_money():
+    c = customers.add_customer("Acme")
+    result = customers.set_credit_limit(c.id, 1250.50)
+    assert result == Money(125050)
+    assert db.customers[c.id].credit_limit == Money(125050)
+
+
+def test_set_credit_limit_emits_event():
+    c = customers.add_customer("Acme")
+    customers.set_credit_limit(c.id, 100)
+    assert events.OUTBOX[-1]["name"] == "customer.credit_limit_set"
+    assert events.OUTBOX[-1]["entity_id"] == c.id
+    assert events.OUTBOX[-1]["payload"] == {"cents": 10000}
+
+
+def test_set_credit_limit_accepts_zero():
+    c = customers.add_customer("Acme")
+    assert customers.set_credit_limit(c.id, 0) == Money(0)
+
+
+def test_set_credit_limit_unknown_customer():
+    with pytest.raises(DomainError) as err:
+        customers.set_credit_limit("C-missing", 100)
+    assert err.value.code == "E_UNKNOWN_CUSTOMER"
+    assert events.OUTBOX == []
+
+
+def test_set_credit_limit_rejects_negative_amount():
+    c = customers.add_customer("Acme")
+    before = db.customers[c.id].credit_limit
+    with pytest.raises(DomainError) as err:
+        customers.set_credit_limit(c.id, -5)
+    assert err.value.code == "E_BAD_INPUT"
+    assert db.customers[c.id].credit_limit == before
+    assert events.OUTBOX == []
+
+
+def test_set_credit_limit_rejects_non_numeric_amount():
+    c = customers.add_customer("Acme")
+    with pytest.raises(DomainError) as err:
+        customers.set_credit_limit(c.id, "lots")
+    assert err.value.code == "E_BAD_INPUT"
