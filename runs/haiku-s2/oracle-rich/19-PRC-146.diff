diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_invoice_write_off.py b/tests/unit/test_invoice_write_off.py
--- a/tests/unit/test_invoice_write_off.py	1969-12-31 19:00:00
+++ b/tests/unit/test_invoice_write_off.py	2026-11-10 12:58:58
@@ -0,0 +1,58 @@
+import pytest
+
+from parcelo import clock, customers, events, invoices, shipments
+from parcelo.errors import DomainError
+from parcelo.money import Money
+
+
+@pytest.fixture
+def open_invoice():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 2, "local")
+    return invoices.issue_invoice(s.id)
+
+
+def test_write_off_open_invoice(open_invoice):
+    amount = invoices.write_off(open_invoice.id)
+    assert isinstance(amount, Money)
+    assert amount == Money(700)
+    assert open_invoice.status == "written_off"
+    assert open_invoice.written_off_at is not None
+    assert open_invoice not in invoices.open_invoices()
+
+
+def test_write_off_stores_fixed_time(open_invoice):
+    moment = clock.now()
+    clock.set_fixed(moment)
+    try:
+        invoices.write_off(open_invoice.id)
+    finally:
+        clock.clear_fixed()
+    assert open_invoice.written_off_at == moment
+
+
+def test_write_off_emits_event(open_invoice):
+    invoices.write_off(open_invoice.id)
+    assert events.OUTBOX[-1]["name"] == "invoice.written_off"
+    assert events.OUTBOX[-1]["entity_id"] == open_invoice.id
+
+
+def test_write_off_paid_invoice_fails(open_invoice):
+    invoices.mark_paid(open_invoice.id)
+    with pytest.raises(DomainError) as err:
+        invoices.write_off(open_invoice.id)
+    assert err.value.code == "E_BAD_STATE"
+    assert open_invoice.status == "paid"
+
+
+def test_write_off_twice_fails(open_invoice):
+    invoices.write_off(open_invoice.id)
+    with pytest.raises(DomainError) as err:
+        invoices.write_off(open_invoice.id)
+    assert err.value.code == "E_BAD_STATE"
+
+
+def test_write_off_unknown_invoice_fails():
+    with pytest.raises(DomainError) as err:
+        invoices.write_off("INV-missing")
+    assert err.value.code == "E_NOT_FOUND"
