+from parcelo.errors import DomainError
+from parcelo.money import Money
+
 ZONE_BASE = {"local": 4.5, "national": 9.0, "international": 24.0}
 PER_KG = 1.25
 
+# Multiplier applied to the regular quote for each customer tier.
+TIER_FACTOR = {"standard": "1", "gold": "0.9"}
 
+
 def base_rate(zone):
     if zone not in ZONE_BASE:
         raise ValueError("unknown zone: %s" % zone)
@@ -12,3 +18,19 @@
     if weight_kg <= 0:
         raise ValueError("weight must be positive")
     return round(base_rate(zone) + PER_KG * weight_kg, 2)
+
+
+def discounted_quote(weight_kg, zone, tier):
+    """Return the quote for weight and zone as Money, with the tier discount applied.
+
+    Gold customers get 10% off; standard customers pay the regular quote.
+    Rounds to the nearest cent (half up).
+    """
+    if zone not in ZONE_BASE:
+        raise DomainError("E_BAD_ZONE", "unknown zone: %s" % zone)
+    if tier not in TIER_FACTOR:
+        raise DomainError("E_BAD_INPUT", "unknown tier: %s" % tier)
+    if weight_kg <= 0:
+        raise DomainError("E_BAD_WEIGHT", "weight must be positive")
+    regular = Money.parse(quote(weight_kg, zone))
+    return regular.scale(TIER_FACTOR[tier])
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_rates_discount.py b/tests/unit/test_rates_discount.py
--- a/tests/unit/test_rates_discount.py	1969-12-31 19:00:00
+++ b/tests/unit/test_rates_discount.py	2026-11-10 12:53:31
@@ -0,0 +1,42 @@
+import pytest
+
+from parcelo import rates
+from parcelo.errors import DomainError
+from parcelo.money import Money
+
+
+def test_standard_tier_pays_regular_quote():
+    # local, 2 kg: 4.5 + 1.25 * 2 = 7.00
+    assert rates.discounted_quote(2, "local", "standard") == Money(700)
+
+
+def test_gold_tier_gets_ten_percent_off():
+    # 7.00 * 0.9 = 6.30
+    assert rates.discounted_quote(2, "local", "gold") == Money(630)
+
+
+def test_gold_rounds_to_nearest_cent_half_up():
+    # national, 1 kg: 9.0 + 1.25 = 10.25; * 0.9 = 9.225 -> 9.23
+    assert rates.discounted_quote(1, "national", "gold") == Money(923)
+
+
+def test_returns_money_not_float():
+    assert isinstance(rates.discounted_quote(2, "local", "gold"), Money)
+
+
+def test_unknown_zone_fails():
+    with pytest.raises(DomainError) as err:
+        rates.discounted_quote(2, "moon", "gold")
+    assert err.value.code == "E_BAD_ZONE"
+
+
+def test_unknown_tier_fails():
+    with pytest.raises(DomainError) as err:
+        rates.discounted_quote(2, "local", "platinum")
+    assert err.value.code == "E_BAD_INPUT"
+
+
+def test_non_positive_weight_fails():
+    with pytest.raises(DomainError) as err:
+        rates.discounted_quote(0, "local", "gold")
+    assert err.value.code == "E_BAD_WEIGHT"
