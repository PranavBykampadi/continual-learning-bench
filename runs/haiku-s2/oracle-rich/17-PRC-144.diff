+def insurance_fee(declared_value, zone):
+    """Insurance fee for a declared shipment value.
+
+    Fee = 2% of declared value + zone fuel surcharge % of declared value,
+    never less than 1.00. Returns Money.
+    """
+    if zone not in _FUEL_SURCHARGE_PCT:
+        raise DomainError("E_BAD_ZONE", "unknown zone: %s" % zone)
+    try:
+        value = Money.parse(declared_value)
+    except (InvalidOperation, TypeError, ValueError):
+        raise DomainError("E_BAD_INPUT", "declared value must be a number")
+    if value.cents <= 0:
+        raise DomainError("E_BAD_INPUT", "declared value must be positive")
+    pct = INSURANCE_RATE_PCT + _FUEL_SURCHARGE_PCT[zone]
+    fee = value.scale(pct / Decimal("100"))
+    if fee < INSURANCE_MIN_FEE:
+        return INSURANCE_MIN_FEE
+    return fee
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_insurance_fee.py b/tests/unit/test_insurance_fee.py
--- a/tests/unit/test_insurance_fee.py	1969-12-31 19:00:00
+++ b/tests/unit/test_insurance_fee.py	2026-11-10 12:58:06
@@ -0,0 +1,52 @@
+import pytest
+
+from parcelo import rates
+from parcelo.errors import DomainError
+from parcelo.money import Money
+
+
+def test_insurance_fee_national_above_minimum():
+    # 2% + 4% of 1000.00 = 60.00
+    assert rates.insurance_fee(1000, "national") == Money(6000)
+
+
+def test_insurance_fee_international():
+    # 2% + 9.5% of 200.00 = 23.00
+    assert rates.insurance_fee(200, "international") == Money(2300)
+
+
+def test_insurance_fee_local_has_no_surcharge():
+    # 2% of 300.00 = 6.00
+    assert rates.insurance_fee("300.00", "local") == Money(600)
+
+
+def test_insurance_fee_minimum_applies():
+    # 2% of 10.00 = 0.20, raised to the 1.00 minimum
+    assert rates.insurance_fee(10, "local") == Money(100)
+
+
+def test_insurance_fee_accepts_money():
+    assert rates.insurance_fee(Money(100000), "local") == Money(2000)
+
+
+def test_insurance_fee_returns_money_not_float():
+    assert isinstance(rates.insurance_fee(50, "national"), Money)
+
+
+def test_insurance_fee_unknown_zone():
+    with pytest.raises(DomainError) as err:
+        rates.insurance_fee(100, "moon")
+    assert err.value.code == "E_BAD_ZONE"
+
+
+@pytest.mark.parametrize("value", [0, -5, "-0.01"])
+def test_insurance_fee_rejects_non_positive(value):
+    with pytest.raises(DomainError) as err:
+        rates.insurance_fee(value, "local")
+    assert err.value.code == "E_BAD_INPUT"
+
+
+def test_insurance_fee_rejects_garbage():
+    with pytest.raises(DomainError) as err:
+        rates.insurance_fee("abc", "local")
+    assert err.value.code == "E_BAD_INPUT"
