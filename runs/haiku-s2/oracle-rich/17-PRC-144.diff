+from decimal import Decimal, InvalidOperation
+
+from parcelo.errors import DomainError
+from parcelo.money import Money
+
 ZONE_BASE = {"local": 4.5, "national": 9.0, "international": 24.0}
 PER_KG = 1.25
 
+# Fuel surcharge percentages per zone (same values as legacy fuel_surcharge).
+_FUEL_SURCHARGE_PCT = {
+    "local": Decimal("0"),
+    "national": Decimal("4.0"),
+    "international": Decimal("9.5"),
+}
+INSURANCE_RATE_PCT = Decimal("2")
+INSURANCE_MIN_FEE = Money(100)  # 1.00 USD
 
+
 def base_rate(zone):
     if zone not in ZONE_BASE:
         raise ValueError("unknown zone: %s" % zone)
@@ -12,3 +26,24 @@
     if weight_kg <= 0:
         raise ValueError("weight must be positive")
     return round(base_rate(zone) + PER_KG * weight_kg, 2)
+
