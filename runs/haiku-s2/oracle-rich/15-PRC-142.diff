diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_invoice_reopen.py b/tests/unit/test_invoice_reopen.py
--- a/tests/unit/test_invoice_reopen.py	1969-12-31 19:00:00
+++ b/tests/unit/test_invoice_reopen.py	2026-11-10 12:56:58
@@ -0,0 +1,46 @@
+from datetime import datetime, timezone
+
+import pytest
+
+from parcelo import clock, events, invoices
+from parcelo.errors import DomainError
+from parcelo.models import Invoice
+from parcelo.store import db
+
+
+def _paid_invoice(invoice_id="INV-test0001"):
+    inv = Invoice(id=invoice_id, shipment_id="shp_1", amount=10.0, status="paid", paid_at="2026-01-01")
+    db.invoices[inv.id] = inv
+    return inv
+
+
+def test_reopen_paid_invoice_sets_open_and_records_time():
+    moment = datetime(2026, 11, 10, 12, 0, tzinfo=timezone.utc)
+    clock.set_fixed(moment)
+    try:
+        inv = _paid_invoice()
+        result = invoices.reopen_invoice(inv.id)
+    finally:
+        clock.clear_fixed()
+    assert result is inv
+    assert inv.status == "open"
+    assert inv.paid_at is None
+    assert inv.reopened_at == moment
+    assert events.OUTBOX[-1]["name"] == "invoice.reopened"
+    assert events.OUTBOX[-1]["entity_id"] == inv.id
+
+
+def test_reopen_missing_invoice_fails():
+    with pytest.raises(DomainError) as err:
+        invoices.reopen_invoice("INV-missing")
+    assert err.value.code == "E_NOT_FOUND"
+
+
+def test_reopen_unpaid_invoice_fails():
+    inv = Invoice(id="INV-open0001", shipment_id="shp_1", amount=10.0)
+    db.invoices[inv.id] = inv
+    with pytest.raises(DomainError) as err:
+        invoices.reopen_invoice(inv.id)
+    assert err.value.code == "E_BAD_STATE"
+    assert inv.status == "open"
+    assert inv.reopened_at is None
