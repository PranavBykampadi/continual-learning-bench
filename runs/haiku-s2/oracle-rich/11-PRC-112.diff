diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/parcelo/claims.py b/parcelo/claims.py
--- a/parcelo/claims.py	1969-12-31 19:00:00
+++ b/parcelo/claims.py	2026-11-10 12:54:29
@@ -0,0 +1,32 @@
+from decimal import InvalidOperation
+
+from parcelo import audit, clock, ids
+from parcelo.errors import DomainError
+from parcelo.models import Claim
+from parcelo.money import Money
+from parcelo.shipments import get_shipment
+from parcelo.store import db
+
+
+def file_claim(shipment_id, amount, reason):
+    try:
+        money = Money.parse(amount)
+    except (InvalidOperation, ValueError, TypeError):
+        raise DomainError("E_BAD_INPUT", f"amount {amount!r}")
+    if money.cents <= 0:
+        raise DomainError("E_BAD_INPUT", f"amount must be positive, got {money}")
+    shipment = get_shipment(shipment_id)
+    if shipment.status != "delivered":
+        raise DomainError(
+            "E_BAD_STATE", f"shipment {shipment_id} is {shipment.status}, not delivered"
+        )
+    claim = Claim(
+        id=ids.new_id("clm"),
+        shipment_id=shipment_id,
+        amount=money,
+        reason=reason,
+        filed_at=clock.now(),
+    )
+    db.claims[claim.id] = claim
+    audit.record("claim.filed", claim.id, shipment_id=shipment_id, cents=money.cents)
+    return claim
