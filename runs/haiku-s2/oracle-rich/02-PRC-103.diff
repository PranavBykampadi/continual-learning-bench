+from parcelo.errors import DomainError
+from parcelo.money import Money
+
 ZONE_BASE = {"local": 4.5, "national": 9.0, "international": 24.0}
 PER_KG = 1.25
 
+# Same percentages as the legacy fuel_surcharge helper, reimplemented here
+# because new code must not import from parcelo.legacy.
+FUEL_SURCHARGE_PCT = {"local": 0.0, "national": 4.0, "international": 9.5}
 
+
 def base_rate(zone):
     if zone not in ZONE_BASE:
         raise ValueError("unknown zone: %s" % zone)
@@ -12,3 +19,14 @@
     if weight_kg <= 0:
         raise ValueError("weight must be positive")
     return round(base_rate(zone) + PER_KG * weight_kg, 2)
+
+
+def quote_with_surcharge(weight_kg, zone):
+    """Return the quote for weight and zone including the zone's fuel surcharge, as Money."""
+    if zone not in FUEL_SURCHARGE_PCT:
+        raise DomainError("E_BAD_ZONE", "unknown zone: %s" % zone)
+    if weight_kg <= 0:
+        raise DomainError("E_BAD_WEIGHT", "weight must be positive")
+    base = Money.parse(quote(weight_kg, zone))
+    surcharge = base.scale(FUEL_SURCHARGE_PCT[zone] / 100.0)
+    return base + surcharge
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_rates_surcharge.py b/tests/unit/test_rates_surcharge.py
--- a/tests/unit/test_rates_surcharge.py	1969-12-31 19:00:00
+++ b/tests/unit/test_rates_surcharge.py	2026-11-10 12:50:18
@@ -0,0 +1,37 @@
+import pytest
+
+from parcelo import rates
+from parcelo.errors import DomainError
+from parcelo.money import Money
+
+
+def test_local_has_no_surcharge():
+    # 4.50 + 1.25 * 2 = 7.00, surcharge 0%
+    assert rates.quote_with_surcharge(2, "local") == Money(700)
+
+
+def test_national_adds_four_percent():
+    # 9.00 + 1.25 * 2 = 11.50, plus 4% = 0.46
+    assert rates.quote_with_surcharge(2, "national") == Money(1196)
+
+
+def test_international_adds_nine_point_five_percent():
+    # 24.00 + 1.25 * 1 = 25.25, plus 9.5% = 2.39875 -> 2.40 (half up)
+    assert rates.quote_with_surcharge(1, "international") == Money(2765)
+
+
+def test_returns_money_not_float():
+    assert isinstance(rates.quote_with_surcharge(1, "local"), Money)
+
+
+def test_unknown_zone_raises_domain_error():
+    with pytest.raises(DomainError) as err:
+        rates.quote_with_surcharge(1, "moon")
+    assert err.value.code == "E_BAD_ZONE"
+
+
+@pytest.mark.parametrize("weight", [0, -1, -0.5])
+def test_non_positive_weight_raises_domain_error(weight):
+    with pytest.raises(DomainError) as err:
+        rates.quote_with_surcharge(weight, "national")
+    assert err.value.code == "E_BAD_WEIGHT"
