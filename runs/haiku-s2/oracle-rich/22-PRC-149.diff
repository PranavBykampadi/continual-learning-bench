+def split_shipment(shipment_id, weights):
+    """Replace a 'created' shipment with one new shipment per weight.
+
+    The original is marked 'split'. Returns the new shipments in the order
+    of ``weights``. All checks run before anything is changed.
+    """
+    original = get_shipment(shipment_id)
+    if original.status != "created":
+        raise DomainError("E_BAD_STATE", f"{shipment_id} is {original.status}")
+    weights = list(weights)
+    if not weights:
+        raise DomainError("E_BAD_INPUT", "no weights given")
+    for w in weights:
+        if w <= 0:
+            raise DomainError("E_BAD_WEIGHT", str(w))
+    # Decimal of the string form so float weights like 0.1 + 0.2 add up exactly.
+    total = sum(Decimal(str(w)) for w in weights)
+    if total != Decimal(str(original.weight_kg)):
+        raise DomainError(
+            "E_BAD_INPUT", f"weights sum to {total}, expected {original.weight_kg}"
+        )
+
+    new_shipments = []
+    for w in weights:
+        shipment = Shipment(
+            id=ids.new_id("shp"),
+            customer_id=original.customer_id,
+            weight_kg=w,
+            zone=original.zone,
+            created_at=clock.now(),
+        )
+        db.shipments[shipment.id] = shipment
+        events.emit("shipment.created", shipment.id, zone=original.zone)
+        new_shipments.append(shipment)
+
+    original.status = "split"
+    events.emit("shipment.split", original.id, into=[s.id for s in new_shipments])
+    return new_shipments
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_split_shipment.py b/tests/unit/test_split_shipment.py
--- a/tests/unit/test_split_shipment.py	1969-12-31 19:00:00
+++ b/tests/unit/test_split_shipment.py	2026-11-10 13:00:25
@@ -0,0 +1,75 @@
+import pytest
+
+from parcelo import customers, events, shipments
+from parcelo.errors import DomainError
+from parcelo.store import db
+
+
+def _make(weight=10.0):
+    c = customers.add_customer("Acme")
+    return shipments.create_shipment(c.id, weight, "national")
+
+
+def test_split_creates_shipments_in_weight_order():
+    s = _make(10.0)
+    new = shipments.split_shipment(s.id, [6.0, 4.0])
+    assert [n.weight_kg for n in new] == [6.0, 4.0]
+    assert all(n.customer_id == s.customer_id and n.zone == s.zone for n in new)
+    assert all(n.status == "created" and n.id.startswith("shp_") for n in new)
+    assert db.shipments[s.id].status == "split"
+
+
+def test_split_emits_events():
+    s = _make(3.0)
+    events.OUTBOX.clear()
+    new = shipments.split_shipment(s.id, [1.0, 2.0])
+    names = [e["name"] for e in events.OUTBOX]
+    assert names == ["shipment.created", "shipment.created", "shipment.split"]
+    assert events.OUTBOX[-1]["entity_id"] == s.id
+    assert events.OUTBOX[-1]["payload"]["into"] == [n.id for n in new]
+
+
+def test_float_weights_sum_exactly():
+    s = _make(0.3)
+    new = shipments.split_shipment(s.id, [0.1, 0.2])
+    assert len(new) == 2
+
+
+def test_unknown_shipment_fails():
+    with pytest.raises(DomainError) as err:
+        shipments.split_shipment("shp_nope", [1.0])
+    assert err.value.code == "E_NOT_FOUND"
+
+
+def test_non_created_shipment_fails():
+    s = _make(5.0)
+    shipments.split_shipment(s.id, [5.0])
+    with pytest.raises(DomainError) as err:
+        shipments.split_shipment(s.id, [2.5, 2.5])
+    assert err.value.code == "E_BAD_STATE"
+
+
+def test_weights_must_add_up():
+    s = _make(10.0)
+    with pytest.raises(DomainError) as err:
+        shipments.split_shipment(s.id, [6.0, 3.0])
+    assert err.value.code == "E_BAD_INPUT"
+    # failed split leaves the original untouched
+    assert db.shipments[s.id].status == "created"
+    assert len(db.shipments) == 1
+
+
+def test_empty_weights_fail():
+    s = _make(10.0)
+    with pytest.raises(DomainError) as err:
+        shipments.split_shipment(s.id, [])
+    assert err.value.code == "E_BAD_INPUT"
+
+
+def test_non_positive_weight_fails_without_changes():
+    s = _make(10.0)
+    with pytest.raises(DomainError) as err:
+        shipments.split_shipment(s.id, [12.0, -2.0])
+    assert err.value.code == "E_BAD_WEIGHT"
+    assert db.shipments[s.id].status == "created"
+    assert len(db.shipments) == 1
