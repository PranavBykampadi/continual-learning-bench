diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_void_invoice.py b/tests/unit/test_void_invoice.py
--- a/tests/unit/test_void_invoice.py	1969-12-31 19:00:00
+++ b/tests/unit/test_void_invoice.py	2026-11-10 12:49:44
@@ -0,0 +1,53 @@
+import datetime
+
+import pytest
+
+from parcelo import audit, clock, customers, invoices, shipments
+from parcelo.errors import DomainError
+
+
+def _open_invoice():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 2, "local")
+    return invoices.issue_invoice(s.id)
+
+
+def test_void_sets_status_and_timestamp():
+    moment = datetime.datetime(2026, 1, 2, 3, 4, 5, tzinfo=datetime.timezone.utc)
+    clock.set_fixed(moment)
+    inv = _open_invoice()
+    result = invoices.void_invoice(inv.id)
+    assert result is inv
+    assert inv.status == "void"
+    assert inv.voided_at == moment
+
+
+def test_void_records_audit():
+    inv = _open_invoice()
+    invoices.void_invoice(inv.id)
+    assert audit.LOG[-1]["action"] == "invoice.voided"
+    assert audit.LOG[-1]["entity_id"] == inv.id
+
+
+def test_void_unknown_invoice_fails():
+    with pytest.raises(DomainError) as err:
+        invoices.void_invoice("INV-missing")
+    assert err.value.code == "E_NOT_FOUND"
+
+
+def test_void_paid_invoice_fails():
+    inv = _open_invoice()
+    invoices.mark_paid(inv.id)
+    with pytest.raises(DomainError) as err:
+        invoices.void_invoice(inv.id)
+    assert err.value.code == "E_BAD_STATE"
+    assert inv.status == "paid"
+    assert inv.voided_at is None
+
+
+def test_void_twice_fails():
+    inv = _open_invoice()
+    invoices.void_invoice(inv.id)
+    with pytest.raises(DomainError) as err:
+        invoices.void_invoice(inv.id)
+    assert err.value.code == "E_BAD_STATE"
