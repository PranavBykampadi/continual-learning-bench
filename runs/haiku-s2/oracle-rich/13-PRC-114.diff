-from datetime import datetime
+from datetime import datetime, timezone
 
+from parcelo import clock
+from parcelo.errors import DomainError
+from parcelo.money import Money
 from parcelo.store import db
+
+
+def _as_utc(moment):
+    # Invoices issued by older code carry naive UTC timestamps; treat them as UTC.
+    if moment.tzinfo is None:
+        return moment.replace(tzinfo=timezone.utc)
+    return moment
+
+
+def aging_report():
+    """Total unpaid invoices into age buckets, measured in whole days since issue."""
+    now = _as_utc(clock.now())
+    buckets = {"0-30": Money.zero(), "31-60": Money.zero(), "60+": Money.zero()}
+    for invoice in db.invoices.values():
+        if invoice.status == "paid":
+            continue
+        if invoice.issued_at is None:
+            raise DomainError("E_BAD_STATE", f"invoice {invoice.id} has no issue date")
+        age_days = (now - _as_utc(invoice.issued_at)).days
+        amount = Money.parse(invoice.amount)
+        if age_days <= 30:
+            key = "0-30"
+        elif age_days <= 60:
+            key = "31-60"
+        else:
+            key = "60+"
+        buckets[key] = buckets[key] + amount
+    return buckets
 
 
