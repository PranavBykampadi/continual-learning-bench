diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_aging_report.py b/tests/unit/test_aging_report.py
--- a/tests/unit/test_aging_report.py	1969-12-31 19:00:00
+++ b/tests/unit/test_aging_report.py	2026-11-10 12:56:09
@@ -0,0 +1,89 @@
+from datetime import datetime, timedelta, timezone
+
+from parcelo import clock, reports
+from parcelo.errors import DomainError
+from parcelo.models import Invoice
+from parcelo.money import Money
+from parcelo.store import db
+
+NOW = datetime(2026, 11, 10, 12, 0, tzinfo=timezone.utc)
+
+
+def _add(inv_id, amount, days_old, status="open"):
+    db.invoices[inv_id] = Invoice(
+        id=inv_id,
+        shipment_id="shp_x",
+        amount=amount,
+        status=status,
+        issued_at=NOW - timedelta(days=days_old),
+    )
+
+
+def test_empty_buckets_are_zero():
+    clock.set_fixed(NOW)
+    assert reports.aging_report() == {
+        "0-30": Money.zero(),
+        "31-60": Money.zero(),
+        "60+": Money.zero(),
+    }
+
+
+def test_bucket_boundaries():
+    clock.set_fixed(NOW)
+    _add("INV-0", 1.00, 0)
+    _add("INV-30", 2.00, 30)
+    _add("INV-31", 3.00, 31)
+    _add("INV-60", 4.00, 60)
+    _add("INV-61", 5.00, 61)
+    report = reports.aging_report()
+    assert report["0-30"] == Money(300)
+    assert report["31-60"] == Money(700)
+    assert report["60+"] == Money(500)
+
+
+def test_partial_days_are_floored():
+    clock.set_fixed(NOW)
+    db.invoices["INV-a"] = Invoice(
+        id="INV-a", shipment_id="s", amount=1.00,
+        issued_at=NOW - timedelta(days=30, hours=23),
+    )
+    assert reports.aging_report()["0-30"] == Money(100)
+
+
+def test_paid_invoices_are_excluded():
+    clock.set_fixed(NOW)
+    _add("INV-paid", 9.99, 10, status="paid")
+    _add("INV-open", 1.25, 10)
+    report = reports.aging_report()
+    assert report["0-30"] == Money(125)
+    assert report["31-60"] == Money.zero()
+    assert report["60+"] == Money.zero()
+
+
+def test_naive_issue_timestamps_from_legacy_code():
+    clock.set_fixed(NOW)
+    db.invoices["INV-naive"] = Invoice(
+        id="INV-naive", shipment_id="s", amount=2.50,
+        issued_at=datetime(2026, 9, 1, 12, 0),  # naive UTC, 70 days before NOW
+    )
+    assert reports.aging_report()["60+"] == Money(250)
+
+
+def test_amounts_are_money_not_floats():
+    clock.set_fixed(NOW)
+    _add("INV-1", 0.1, 5)
+    _add("INV-2", 0.2, 5)
+    report = reports.aging_report()
+    assert all(isinstance(v, Money) for v in report.values())
+    assert report["0-30"] == Money(30)
+
+
+def test_invoice_without_issue_date_raises():
+    clock.set_fixed(NOW)
+    db.invoices["INV-bad"] = Invoice(id="INV-bad", shipment_id="s", amount=1.0)
+    try:
+        reports.aging_report()
+    except DomainError as err:
+        assert err.code == "E_BAD_STATE"
+    else:
+        raise AssertionError("expected DomainError")
