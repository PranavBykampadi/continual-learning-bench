 from datetime import datetime
 
+from parcelo.errors import DomainError
+from parcelo.money import Money
 from parcelo.store import db
+
+
+def outstanding_by_customer():
+    """Map each customer id to the total Money of their open invoices.
+
+    Paid and void invoices are excluded. Every known customer appears in the
+    result, with Money.zero() if they owe nothing.
+    """
+    totals = {customer_id: Money.zero() for customer_id in db.customers}
+    for invoice in db.invoices.values():
+        if invoice.status != "open":
+            continue
+        shipment = db.shipments.get(invoice.shipment_id)
+        if shipment is None:
+            raise DomainError("E_NOT_FOUND", f"shipment {invoice.shipment_id} for invoice {invoice.id}")
+        current = totals.get(shipment.customer_id, Money.zero())
+        totals[shipment.customer_id] = current + Money.parse(invoice.amount)
+    return totals
 
 
