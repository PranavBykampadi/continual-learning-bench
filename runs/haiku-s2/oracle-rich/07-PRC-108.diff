--- a/tests/unit/test_outstanding.py	1969-12-31 19:00:00
+++ b/tests/unit/test_outstanding.py	2026-11-10 12:52:35
@@ -0,0 +1,62 @@
+from parcelo import reports
+from parcelo.models import Customer, Invoice, Shipment
+from parcelo.money import Money
+from parcelo.store import db
+
+
+def _setup():
+    db.customers["cus_a"] = Customer(id="cus_a", name="Acme")
+    db.customers["cus_b"] = Customer(id="cus_b", name="Birch")
+    db.shipments["shp_1"] = Shipment(id="shp_1", customer_id="cus_a", weight_kg=1.0, zone="local")
+    db.shipments["shp_2"] = Shipment(id="shp_2", customer_id="cus_a", weight_kg=2.0, zone="local")
+    db.shipments["shp_3"] = Shipment(id="shp_3", customer_id="cus_b", weight_kg=3.0, zone="local")
+
+
+def _invoice(inv_id, shipment_id, amount, status):
+    db.invoices[inv_id] = Invoice(
+        id=inv_id, shipment_id=shipment_id, amount=amount, status=status
+    )
+
+
+def test_sums_open_invoices_per_customer():
+    _setup()
+    _invoice("INV-1", "shp_1", 10.25, "open")
+    _invoice("INV-2", "shp_2", 4.50, "open")
+    _invoice("INV-3", "shp_3", 7.00, "open")
+
+    result = reports.outstanding_by_customer()
+
+    assert result["cus_a"] == Money(1475)
+    assert result["cus_b"] == Money(700)
+
+
+def test_excludes_paid_and_void_invoices():
+    _setup()
+    _invoice("INV-1", "shp_1", 10.00, "open")
+    _invoice("INV-2", "shp_1", 99.00, "paid")
+    _invoice("INV-3", "shp_2", 50.00, "void")
+
+    result = reports.outstanding_by_customer()
+
+    assert result["cus_a"] == Money(1000)
+
+
+def test_customer_with_no_open_invoices_is_zero():
+    _setup()
+    _invoice("INV-1", "shp_3", 12.00, "paid")
+
+    result = reports.outstanding_by_customer()
+
+    assert result["cus_b"] == Money.zero()
+    assert result["cus_a"] == Money.zero()
+
+
+def test_values_are_money_not_floats():
+    _setup()
+    _invoice("INV-1", "shp_1", 0.1, "open")
+    _invoice("INV-2", "shp_1", 0.2, "open")
+
+    result = reports.outstanding_by_customer()
+
+    assert all(isinstance(v, Money) for v in result.values())
+    assert result["cus_a"] == Money(30)
