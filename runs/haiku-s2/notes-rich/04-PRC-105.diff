diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_refunds.py b/tests/unit/test_refunds.py
--- a/tests/unit/test_refunds.py	1969-12-31 19:00:00
+++ b/tests/unit/test_refunds.py	2026-11-10 12:51:43
@@ -0,0 +1,63 @@
+import pytest
+
+from parcelo import audit, clock, customers, invoices, refunds, shipments, store
+from parcelo.errors import DomainError
+from parcelo.money import Money
+
+
+def _paid_invoice():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 2, "local")
+    inv = invoices.issue_invoice(s.id)
+    invoices.mark_paid(inv.id)
+    return inv
+
+
+def test_create_refund_for_paid_invoice():
+    inv = _paid_invoice()
+    r = refunds.create_refund(inv.id, 3.5)
+    assert r.id.startswith("RFD-")
+    assert r.invoice_id == inv.id
+    assert r.amount == Money(350)
+    assert isinstance(r.amount, Money)
+    assert store.db.refunds[r.id] is r
+
+
+def test_refund_uses_clock_and_records_audit():
+    inv = _paid_invoice()
+    moment = clock.now()
+    clock.set_fixed(moment)
+    try:
+        r = refunds.create_refund(inv.id, Money(100))
+    finally:
+        clock.clear_fixed()
+    assert r.created_at == moment
+    assert r.amount == Money(100)
+    assert audit.LOG[-1]["action"] == "refund.created"
+    assert audit.LOG[-1]["entity_id"] == r.id
+
+
+def test_refund_unknown_invoice():
+    with pytest.raises(DomainError) as err:
+        refunds.create_refund("INV-missing", 1.0)
+    assert err.value.code == "E_NOT_FOUND"
+    assert store.db.refunds == {}
+    assert audit.LOG == []
+
+
+def test_refund_open_invoice_fails():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 2, "local")
+    inv = invoices.issue_invoice(s.id)
+    with pytest.raises(DomainError) as err:
+        refunds.create_refund(inv.id, 1.0)
+    assert err.value.code == "E_BAD_STATE"
+    assert store.db.refunds == {}
+    assert audit.LOG == []
+
+
+def test_store_reset_clears_refunds():
+    inv = _paid_invoice()
+    refunds.create_refund(inv.id, 1.0)
+    store.reset()
+    assert store.db.refunds == {}
