+# Volume tier thresholds copied from parcelo/legacy/billing.py::volume_tier.
+# Copied rather than imported because parcelo.legacy is being deleted.
+BULK_TIER_MIN_SHIPMENTS = 50
+REGULAR_TIER_MIN_SHIPMENTS = 10
+
+
+def _volume_tier(shipment_count):
+    if shipment_count >= BULK_TIER_MIN_SHIPMENTS:
+        return "bulk"
+    if shipment_count >= REGULAR_TIER_MIN_SHIPMENTS:
+        return "regular"
+    return "starter"
+
+
+def volume_report():
+    counts = {customer_id: 0 for customer_id in db.customers}
+    for shipment in db.shipments.values():
+        if shipment.customer_id in counts:
+            counts[shipment.customer_id] += 1
+    return {
+        customer_id: {"shipments": count, "tier": _volume_tier(count)}
+        for customer_id, count in counts.items()
+    }
+
+
