diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_reports_volume.py b/tests/unit/test_reports_volume.py
--- a/tests/unit/test_reports_volume.py	1969-12-31 19:00:00
+++ b/tests/unit/test_reports_volume.py	2026-11-10 13:04:22
@@ -0,0 +1,49 @@
+import pytest
+
+from parcelo import customers, reports, shipments
+
+
+def test_includes_customers_with_no_shipments():
+    c = customers.add_customer("Acme")
+    assert reports.volume_report() == {c.id: {"shipments": 0, "tier": "starter"}}
+
+
+def test_counts_shipments_per_customer():
+    a = customers.add_customer("Acme")
+    b = customers.add_customer("Beta")
+    shipments.create_shipment(a.id, 1.0, "local")
+    shipments.create_shipment(a.id, 2.0, "national")
+    shipments.create_shipment(b.id, 3.0, "local")
+    report = reports.volume_report()
+    assert report[a.id] == {"shipments": 2, "tier": "starter"}
+    assert report[b.id] == {"shipments": 1, "tier": "starter"}
+
+
+def test_empty_when_no_customers():
+    assert reports.volume_report() == {}
+
+
+@pytest.mark.parametrize(
+    "count, tier",
+    [
+        (0, "starter"),
+        (9, "starter"),
+        (10, "regular"),
+        (49, "regular"),
+        (50, "bulk"),
+        (75, "bulk"),
+    ],
+)
+def test_tier_thresholds_match_legacy(count, tier):
+    c = customers.add_customer("Acme")
+    for _ in range(count):
+        shipments.create_shipment(c.id, 1.0, "local")
+    assert reports.volume_report()[c.id] == {"shipments": count, "tier": tier}
+
+
+def test_does_not_mutate_state():
+    c = customers.add_customer("Acme")
+    shipments.create_shipment(c.id, 1.0, "local")
+    before = dict(reports.db.shipments)
+    reports.volume_report()
+    assert reports.db.shipments == before
