diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_pickups.py b/tests/unit/test_pickups.py
--- a/tests/unit/test_pickups.py	1969-12-31 19:00:00
+++ b/tests/unit/test_pickups.py	2026-11-10 13:01:23
@@ -0,0 +1,65 @@
+import copy
+from datetime import datetime, timezone
+
+import pytest
+
+from parcelo import clock, customers, events, pickups, shipments
+from parcelo.errors import DomainError
+from parcelo.store import db
+
+WINDOW = datetime(2026, 11, 12, 9, 0, tzinfo=timezone.utc)
+NOW = datetime(2026, 11, 10, 12, 0, tzinfo=timezone.utc)
+
+
+def _new_shipment():
+    c = customers.add_customer("Acme")
+    return shipments.create_shipment(c.id, 2.0, "national")
+
+
+def test_schedule_pickup_creates_and_stores():
+    clock.set_fixed(NOW)
+    s = _new_shipment()
+    before = len(events.OUTBOX)
+    p = pickups.schedule_pickup(s.id, WINDOW)
+    assert p.id.startswith("pck_")
+    assert p.shipment_id == s.id
+    assert p.window_start == WINDOW
+    assert p.scheduled_at == NOW
+    assert db.pickups[p.id] is p
+    assert len(events.OUTBOX) == before + 1
+    assert events.OUTBOX[-1]["name"] == "pickup.scheduled"
+
+
+@pytest.mark.parametrize(
+    "make_shipment_id, status_override, code",
+    [
+        (lambda: "shp_missing", None, "E_NOT_FOUND"),
+        (lambda: _new_shipment().id, "delivered", "E_BAD_STATE"),
+        (lambda: _new_shipment().id, "in_transit", "E_BAD_STATE"),
+    ],
+)
+def test_schedule_pickup_rejected(make_shipment_id, status_override, code):
+    clock.set_fixed(NOW)
+    shipment_id = make_shipment_id()
+    if status_override is not None:
+        db.shipments[shipment_id].status = status_override
+    snapshot = copy.deepcopy(db.pickups)
+    before = len(events.OUTBOX)
+    with pytest.raises(DomainError) as err:
+        pickups.schedule_pickup(shipment_id, WINDOW)
+    assert err.value.code == code
+    assert db.pickups == snapshot
+    assert len(events.OUTBOX) == before
+
+
+@pytest.mark.parametrize("bad_window", [None, "2026-11-12", 1700000000])
+def test_schedule_pickup_bad_window(bad_window):
+    clock.set_fixed(NOW)
+    s = _new_shipment()
+    snapshot = copy.deepcopy(db.pickups)
+    before = len(events.OUTBOX)
+    with pytest.raises(DomainError) as err:
+        pickups.schedule_pickup(s.id, bad_window)
+    assert err.value.code == "E_BAD_INPUT"
+    assert db.pickups == snapshot
+    assert len(events.OUTBOX) == before
