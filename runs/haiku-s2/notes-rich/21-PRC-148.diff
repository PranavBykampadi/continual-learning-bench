diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_disputes.py b/tests/unit/test_disputes.py
--- a/tests/unit/test_disputes.py	1969-12-31 19:00:00
+++ b/tests/unit/test_disputes.py	2026-11-10 13:05:05
@@ -0,0 +1,48 @@
+from datetime import datetime, timezone
+
+import pytest
+
+from parcelo import clock, customers, disputes, invoices, shipments, store
+from parcelo.errors import DomainError
+from parcelo.models import Dispute
+from parcelo.store import db
+
+
+@pytest.fixture
+def invoice():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 2, "national")
+    return invoices.issue_invoice(s.id)
+
+
+def test_open_dispute_saves_and_returns_dispute(invoice):
+    pinned = datetime(2026, 11, 10, 12, 0, tzinfo=timezone.utc)
+    clock.set_fixed(pinned)
+    d = disputes.open_dispute(invoice.id, "wrong weight")
+    assert isinstance(d, Dispute)
+    assert d.id.startswith("dsp_")
+    assert d.invoice_id == invoice.id
+    assert d.reason == "wrong weight"
+    assert d.opened_at == pinned
+    assert db.disputes[d.id] is d
+
+
+def test_unknown_invoice_fails():
+    with pytest.raises(DomainError) as err:
+        disputes.open_dispute("INV-missing", "wrong weight")
+    assert err.value.code == "E_NOT_FOUND"
+    assert db.disputes == {}
+
+
+@pytest.mark.parametrize("reason", ["", "   ", None])
+def test_empty_reason_fails(invoice, reason):
+    with pytest.raises(DomainError) as err:
+        disputes.open_dispute(invoice.id, reason)
+    assert err.value.code == "E_BAD_INPUT"
+    assert db.disputes == {}
+
+
+def test_reset_clears_disputes(invoice):
+    disputes.open_dispute(invoice.id, "wrong weight")
+    store.reset()
+    assert db.disputes == {}
