+
+def add_note(shipment_id, text):
+    shipment = get_shipment(shipment_id)
+    if not isinstance(text, str) or not text.strip():
+        raise DomainError("E_BAD_INPUT", "note text must not be blank")
+    shipment.notes.append({"text": text, "at": clock.now()})
+    audit.record("shipment.note_added", shipment.id)
+    return shipment
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_shipment_notes.py b/tests/unit/test_shipment_notes.py
--- a/tests/unit/test_shipment_notes.py	1969-12-31 19:00:00
+++ b/tests/unit/test_shipment_notes.py	2026-11-10 12:56:16
@@ -0,0 +1,51 @@
+from datetime import datetime, timezone
+
+import pytest
+
+from parcelo import audit, clock, customers, shipments
+from parcelo.errors import DomainError
+from parcelo.store import db
+
+
+def _make_shipment():
+    c = customers.add_customer("Acme")
+    return shipments.create_shipment(c.id, 1.5, "national")
+
+
+def test_add_note_appends_timestamped_entry():
+    s = _make_shipment()
+    moment = datetime(2026, 11, 10, 12, 0, tzinfo=timezone.utc)
+    clock.set_fixed(moment)
+    try:
+        result = shipments.add_note(s.id, "fragile")
+    finally:
+        clock.clear_fixed()
+    assert result is s
+    assert s.notes == [{"text": "fragile", "at": moment}]
+
+
+def test_add_note_records_audit():
+    s = _make_shipment()
+    shipments.add_note(s.id, "call before delivery")
+    assert audit.LOG[-1]["action"] == "shipment.note_added"
+    assert audit.LOG[-1]["entity_id"] == s.id
+
+
+def test_add_note_unknown_shipment():
+    before = len(audit.LOG)
+    with pytest.raises(DomainError) as err:
+        shipments.add_note("shp_missing", "hello")
+    assert err.value.code == "E_NOT_FOUND"
+    assert db.shipments == {}
+    assert len(audit.LOG) == before
+
+
+@pytest.mark.parametrize("text", ["", "   ", None])
+def test_add_note_rejects_blank_text(text):
+    s = _make_shipment()
+    before = len(audit.LOG)
+    with pytest.raises(DomainError) as err:
+        shipments.add_note(s.id, text)
+    assert err.value.code == "E_BAD_INPUT"
+    assert s.notes == []
+    assert len(audit.LOG) == before
