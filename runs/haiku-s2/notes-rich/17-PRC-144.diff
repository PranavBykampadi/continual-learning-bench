+from decimal import Decimal
+
+from parcelo.errors import DomainError
+from parcelo.money import Money
+
 ZONE_BASE = {"local": 4.5, "national": 9.0, "international": 24.0}
 PER_KG = 1.25
 
+# Fuel surcharge percentages per zone (same values as legacy billing.fuel_surcharge).
+# Duplicated here on purpose: new code must not import from parcelo.legacy.
+FUEL_SURCHARGE_PCT = {"local": Decimal("0.0"), "national": Decimal("4.0"), "international": Decimal("9.5")}
+INSURANCE_RATE = Decimal("0.02")
+INSURANCE_MIN = Money(100)
 
+
 def base_rate(zone):
     if zone not in ZONE_BASE:
         raise ValueError("unknown zone: %s" % zone)
@@ -12,3 +23,21 @@
     if weight_kg <= 0:
         raise ValueError("weight must be positive")
     return round(base_rate(zone) + PER_KG * weight_kg, 2)
+
+
+def insurance_fee(declared_value, zone):
+    """Insurance fee for a shipment with a declared value.
+
+    2% of the declared value, plus the zone's fuel surcharge percentage of the
+    declared value, with a minimum fee of 1.00.
+    """
+    if zone not in FUEL_SURCHARGE_PCT:
+        raise DomainError("E_BAD_ZONE", "unknown zone: %s" % zone)
+    declared = Money.parse(declared_value)
+    if declared.cents <= 0:
+        raise DomainError("E_BAD_INPUT", "declared value must be positive")
+    rate = INSURANCE_RATE + FUEL_SURCHARGE_PCT[zone] / Decimal("100")
+    fee = declared.scale(rate)
+    if fee < INSURANCE_MIN:
+        return INSURANCE_MIN
+    return fee
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_insurance_fee.py b/tests/unit/test_insurance_fee.py
--- a/tests/unit/test_insurance_fee.py	1969-12-31 19:00:00
+++ b/tests/unit/test_insurance_fee.py	2026-11-10 13:02:08
@@ -0,0 +1,45 @@
+import pytest
+
+from parcelo import rates
+from parcelo.errors import DomainError
+from parcelo.money import Money
+
+
+def test_local_fee_is_two_percent():
+    assert rates.insurance_fee(100, "local") == Money(200)
+
+
+def test_national_adds_fuel_surcharge():
+    # 2% + 4% of 100.00 = 6.00
+    assert rates.insurance_fee(100, "national") == Money(600)
+
+
+def test_international_adds_fuel_surcharge():
+    # 2% + 9.5% of 1000.00 = 115.00
+    assert rates.insurance_fee(1000, "international") == Money(11500)
+
+
+def test_minimum_fee_applies():
+    # 2% of 10.00 is 0.20, so the 1.00 minimum applies
+    assert rates.insurance_fee(10, "local") == Money(100)
+
+
+def test_accepts_money_value():
+    assert rates.insurance_fee(Money(10000), "national") == Money(600)
+
+
+def test_returns_money():
+    assert isinstance(rates.insurance_fee(50, "local"), Money)
+
+
+def test_unknown_zone():
+    with pytest.raises(DomainError) as err:
+        rates.insurance_fee(100, "moon")
+    assert err.value.code == "E_BAD_ZONE"
+
+
+@pytest.mark.parametrize("value", [0, -5, -0.01])
+def test_non_positive_value(value):
+    with pytest.raises(DomainError) as err:
+        rates.insurance_fee(value, "local")
+    assert err.value.code == "E_BAD_INPUT"
