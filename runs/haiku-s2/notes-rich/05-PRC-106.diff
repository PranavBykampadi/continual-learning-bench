+def _as_utc(moment):
+    # issue_invoice stores naive UTC datetimes; clock.now() is timezone-aware.
+    if moment.tzinfo is None:
+        return moment.replace(tzinfo=timezone.utc)
+    return moment.astimezone(timezone.utc)
+
+
+def late_fee_for(invoice_id):
+    """Late fee on an invoice: 1.5% of the amount per whole day past day 30."""
+    if invoice_id not in db.invoices:
+        raise DomainError("E_NOT_FOUND", invoice_id)
+    invoice = db.invoices[invoice_id]
+    elapsed = _as_utc(clock.now()) - _as_utc(invoice.issued_at)
+    days_late = elapsed.days - LATE_AFTER_DAYS
+    if days_late <= 0:
+        return Money.zero()
+    return Money.parse(invoice.amount).scale(LATE_FEE_RATE * days_late)
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_late_fee.py b/tests/unit/test_late_fee.py
--- a/tests/unit/test_late_fee.py	1969-12-31 19:00:00
+++ b/tests/unit/test_late_fee.py	2026-11-10 12:52:38
@@ -0,0 +1,64 @@
+from datetime import timedelta, timezone
+
+import pytest
+
+from parcelo import clock, customers, invoices, shipments
+from parcelo.errors import DomainError
+from parcelo.money import Money
+
+
+def _invoice_100_usd():
+    # local base 4.5 + 1.25 * 76.4 = 100.00
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 76.4, "local")
+    inv = invoices.issue_invoice(s.id)
+    assert inv.amount == 100.0
+    return inv
+
+
+def _fee_after(inv, extra):
+    issued = inv.issued_at.replace(tzinfo=timezone.utc)
+    clock.set_fixed(issued + extra)
+    try:
+        return invoices.late_fee_for(inv.id)
+    finally:
+        clock.clear_fixed()
+
+
+def test_not_late_before_day_30():
+    inv = _invoice_100_usd()
+    assert _fee_after(inv, timedelta(days=10)) == Money.zero()
+
+
+def test_zero_at_exactly_30_days():
+    inv = _invoice_100_usd()
+    assert _fee_after(inv, timedelta(days=30)) == Money.zero()
+
+
+def test_partial_day_past_30_is_not_charged():
+    inv = _invoice_100_usd()
+    assert _fee_after(inv, timedelta(days=30, hours=23)) == Money.zero()
+
+
+def test_one_day_past_30():
+    inv = _invoice_100_usd()
+    # 1.5% of $100.00 = $1.50
+    assert _fee_after(inv, timedelta(days=31)).cents == 150
+
+
+def test_fee_accumulates_per_day():
+    inv = _invoice_100_usd()
+    assert _fee_after(inv, timedelta(days=40)).cents == 1500
+
+
+def test_returns_money_not_float():
+    inv = _invoice_100_usd()
+    fee = _fee_after(inv, timedelta(days=35))
+    assert isinstance(fee, Money)
+    assert fee.cents == 750
+
+
+def test_unknown_invoice_raises():
+    with pytest.raises(DomainError) as err:
+        invoices.late_fee_for("INV-missing")
+    assert err.value.code == "E_NOT_FOUND"
