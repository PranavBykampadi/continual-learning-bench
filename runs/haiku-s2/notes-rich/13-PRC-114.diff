-from datetime import datetime
+from datetime import datetime, timezone
 
+from parcelo import clock
+from parcelo.money import Money
 from parcelo.store import db
+
+
+def _as_utc(moment):
+    # invoices.issue_invoice stores naive UTC datetimes; clock.now() is aware.
+    if moment.tzinfo is None:
+        return moment.replace(tzinfo=timezone.utc)
+    return moment
+
+
+def aging_report():
+    """Total open invoice amounts bucketed by whole days since issue."""
+    now = _as_utc(clock.now())
+    totals = {"0-30": Money.zero(), "31-60": Money.zero(), "60+": Money.zero()}
+    for invoice in db.invoices.values():
+        if invoice.status != "open":
+            continue
+        age_days = max(0, (now - _as_utc(invoice.issued_at)).days)
+        if age_days <= 30:
+            bucket = "0-30"
+        elif age_days <= 60:
+            bucket = "31-60"
+        else:
+            bucket = "60+"
+        totals[bucket] = totals[bucket] + Money.parse(invoice.amount)
+    return totals
 
 
