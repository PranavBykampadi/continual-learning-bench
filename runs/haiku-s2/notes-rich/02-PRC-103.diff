+from parcelo.errors import DomainError
+from parcelo.legacy.billing import fuel_surcharge
+
 ZONE_BASE = {"local": 4.5, "national": 9.0, "international": 24.0}
 PER_KG = 1.25
 
@@ -12,3 +15,13 @@
     if weight_kg <= 0:
         raise ValueError("weight must be positive")
     return round(base_rate(zone) + PER_KG * weight_kg, 2)
+
+
+def quote_with_surcharge(weight_kg, zone):
+    """Return the quote for weight and zone including the fuel surcharge."""
+    if zone not in ZONE_BASE:
+        raise DomainError("E_BAD_ZONE", zone)
+    if weight_kg <= 0:
+        raise DomainError("E_BAD_WEIGHT", str(weight_kg))
+    base = quote(weight_kg, zone)
+    return round(base + fuel_surcharge(base, zone), 2)
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_rates_surcharge.py b/tests/unit/test_rates_surcharge.py
--- a/tests/unit/test_rates_surcharge.py	1969-12-31 19:00:00
+++ b/tests/unit/test_rates_surcharge.py	2026-11-10 12:50:40
@@ -0,0 +1,32 @@
+import pytest
+
+from parcelo import rates
+from parcelo.errors import DomainError
+
+
+def test_local_has_no_surcharge():
+    # local surcharge is 0%, so total equals the plain quote
+    assert rates.quote_with_surcharge(2, "local") == rates.quote(2, "local")
+
+
+def test_national_adds_four_percent():
+    # quote(2, national) = 11.5; 4% of 11.5 = 0.46
+    assert rates.quote_with_surcharge(2, "national") == 11.96
+
+
+def test_international_adds_nine_point_five_percent():
+    # quote(0.4, international) = 24.5; 9.5% of 24.5 = 2.3275 -> 2.33
+    assert rates.quote_with_surcharge(0.4, "international") == 26.83
+
+
+def test_unknown_zone_fails():
+    with pytest.raises(DomainError) as err:
+        rates.quote_with_surcharge(2, "moon")
+    assert err.value.code == "E_BAD_ZONE"
+
+
+@pytest.mark.parametrize("weight", [0, -1, -0.5])
+def test_non_positive_weight_fails(weight):
+    with pytest.raises(DomainError) as err:
+        rates.quote_with_surcharge(weight, "national")
+    assert err.value.code == "E_BAD_WEIGHT"
