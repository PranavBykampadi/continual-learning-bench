diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_claims.py b/tests/unit/test_claims.py
--- a/tests/unit/test_claims.py	1969-12-31 19:00:00
+++ b/tests/unit/test_claims.py	2026-11-10 12:56:51
@@ -0,0 +1,64 @@
+import pytest
+
+from parcelo import audit, claims, customers, shipments
+from parcelo.errors import DomainError
+from parcelo.money import Money
+from parcelo.store import db
+
+
+def _delivered_shipment():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 1.5, "national")
+    s.status = "delivered"
+    return s
+
+
+def test_file_claim_stores_and_audits():
+    s = _delivered_shipment()
+    claim = claims.file_claim(s.id, 12.5, "box damaged")
+    assert claim.id.startswith("clm_")
+    assert claim.shipment_id == s.id
+    assert claim.amount == Money.parse(12.5)
+    assert claim.reason == "box damaged"
+    assert claim.filed_at is not None
+    assert db.claims[claim.id] is claim
+    assert audit.LOG[-1]["action"] == "claim.filed"
+    assert audit.LOG[-1]["entity_id"] == claim.id
+
+
+@pytest.mark.parametrize(
+    "shipment_id, amount, reason, code",
+    [
+        ("shp_missing", 5, "lost", "E_NOT_FOUND"),
+        ("SHIP", 0, "lost", "E_BAD_INPUT"),
+        ("SHIP", -1, "lost", "E_BAD_INPUT"),
+        ("SHIP", "abc", "lost", "E_BAD_INPUT"),
+        ("SHIP", None, "lost", "E_BAD_INPUT"),
+        ("SHIP", True, "lost", "E_BAD_INPUT"),
+        ("SHIP", float("nan"), "lost", "E_BAD_INPUT"),
+        ("SHIP", 5, "", "E_BAD_INPUT"),
+        ("SHIP", 5, "   ", "E_BAD_INPUT"),
+        ("SHIP", 5, None, "E_BAD_INPUT"),
+    ],
+)
+def test_rejected_inputs(shipment_id, amount, reason, code):
+    s = _delivered_shipment()
+    if shipment_id == "SHIP":
+        shipment_id = s.id
+    before = len(audit.LOG)
+    with pytest.raises(DomainError) as err:
+        claims.file_claim(shipment_id, amount, reason)
+    assert err.value.code == code
+    assert db.claims == {}
+    assert len(audit.LOG) == before
+
+
+def test_shipment_not_delivered():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 1.5, "national")
+    before = len(audit.LOG)
+    with pytest.raises(DomainError) as err:
+        claims.file_claim(s.id, 5, "lost")
+    assert err.value.code == "E_BAD_STATE"
+    assert db.claims == {}
+    assert len(audit.LOG) == before
