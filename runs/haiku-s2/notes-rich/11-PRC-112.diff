diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/parcelo/claims.py b/parcelo/claims.py
--- a/parcelo/claims.py	1969-12-31 19:00:00
+++ b/parcelo/claims.py	2026-11-10 12:56:48
@@ -0,0 +1,46 @@
+from decimal import Decimal
+
+from parcelo import audit, clock, ids
+from parcelo.errors import DomainError
+from parcelo.models import Claim
+from parcelo.money import Money
+from parcelo.shipments import get_shipment
+from parcelo.store import db
+
+
+def _parse_amount(amount):
+    if isinstance(amount, bool) or not isinstance(
+        amount, (int, float, Decimal, str, Money)
+    ):
+        raise DomainError("E_BAD_INPUT", "amount")
+    try:
+        money = Money.parse(amount)
+    except (ArithmeticError, ValueError, TypeError):
+        raise DomainError("E_BAD_INPUT", "amount")
+    if money.cents <= 0:
+        raise DomainError("E_BAD_INPUT", "amount")
+    return money
+
+
+def _validate_reason(reason):
+    if not isinstance(reason, str) or not reason.strip():
+        raise DomainError("E_BAD_INPUT", "reason")
+    return reason
+
+
+def file_claim(shipment_id, amount, reason):
+    shipment = get_shipment(shipment_id)
+    money = _parse_amount(amount)
+    reason = _validate_reason(reason)
+    if shipment.status != "delivered":
+        raise DomainError("E_BAD_STATE", shipment_id)
+    claim = Claim(
+        id=ids.new_id("clm"),
+        shipment_id=shipment_id,
+        amount=money,
+        reason=reason,
+        filed_at=clock.now(),
+    )
+    db.claims[claim.id] = claim
+    audit.record("claim.filed", claim.id, shipment_id=shipment_id)
+    return claim
