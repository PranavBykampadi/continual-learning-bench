+def set_credit_limit(customer_id, amount):
+    """Set a customer's credit limit and return it as Money.
+
+    Existence is checked before the amount. Zero is a valid limit; negative
+    amounts are rejected with E_BAD_INPUT.
+    """
+    if customer_id not in db.customers:
+        raise DomainError("E_NOT_FOUND", customer_id)
+    if isinstance(amount, bool):
+        raise DomainError("E_BAD_INPUT", repr(amount))
+    try:
+        limit = Money.parse(amount)
+    except (ArithmeticError, TypeError, ValueError):
+        raise DomainError("E_BAD_INPUT", repr(amount))
+    if limit.cents < 0:
+        raise DomainError("E_BAD_INPUT", repr(amount))
+    # The Customer.credit_limit field is a legacy float; store the dollar value.
+    db.customers[customer_id].credit_limit = limit.cents / 100
+    return limit
 
 
