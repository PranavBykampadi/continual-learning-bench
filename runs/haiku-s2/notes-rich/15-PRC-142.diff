diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_invoice_reopen.py b/tests/unit/test_invoice_reopen.py
--- a/tests/unit/test_invoice_reopen.py	1969-12-31 19:00:00
+++ b/tests/unit/test_invoice_reopen.py	2026-11-10 13:00:19
@@ -0,0 +1,59 @@
+import copy
+from datetime import datetime, timezone
+
+import pytest
+
+from parcelo import clock, events, invoices
+from parcelo.errors import DomainError
+from parcelo.models import Invoice
+from parcelo.store import db
+
+FIXED = datetime(2026, 11, 10, 12, 0, tzinfo=timezone.utc)
+
+
+def _add(invoice_id, status):
+    db.invoices[invoice_id] = Invoice(
+        id=invoice_id,
+        shipment_id="shp_000001",
+        amount=10.0,
+        status=status,
+        issued_at=datetime(2026, 11, 1, 9, 0),
+        paid_at=datetime(2026, 11, 2, 9, 0) if status == "paid" else None,
+    )
+
+
+def test_reopen_paid_invoice():
+    clock.set_fixed(FIXED)
+    _add("INV-1", "paid")
+    before = len(events.OUTBOX)
+
+    inv = invoices.reopen_invoice("INV-1")
+
+    assert inv is db.invoices["INV-1"]
+    assert inv.status == "open"
+    assert inv.paid_at is None
+    assert inv.reopened_at == FIXED
+    assert events.OUTBOX[-1]["name"] == "invoice.reopened"
+    assert len(events.OUTBOX) == before + 1
+
+
+@pytest.mark.parametrize(
+    "invoice_id, status, code",
+    [
+        ("INV-missing", None, "E_NOT_FOUND"),
+        ("INV-open", "open", "E_BAD_STATE"),
+    ],
+)
+def test_reopen_rejected(invoice_id, status, code):
+    clock.set_fixed(FIXED)
+    if status is not None:
+        _add(invoice_id, status)
+    snapshot = copy.deepcopy(db.invoices)
+    before = len(events.OUTBOX)
+
+    with pytest.raises(DomainError) as err:
+        invoices.reopen_invoice(invoice_id)
+
+    assert err.value.code == code
+    assert db.invoices == snapshot
+    assert len(events.OUTBOX) == before
