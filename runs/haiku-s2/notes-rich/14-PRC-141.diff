+
+def reassign_shipment(shipment_id, new_customer_id):
+    shipment = get_shipment(shipment_id)
+    if new_customer_id not in db.customers:
+        raise DomainError("E_UNKNOWN_CUSTOMER", new_customer_id)
+    if shipment.status == "delivered" or shipment.delivered_at is not None:
+        raise DomainError("E_BAD_STATE", shipment_id)
+    old_customer_id = shipment.customer_id
+    shipment.customer_id = new_customer_id
+    audit.record(
+        "shipment.reassigned",
+        shipment_id,
+        old_customer_id=old_customer_id,
+        new_customer_id=new_customer_id,
+    )
+    return shipment
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_reassign_shipment.py b/tests/unit/test_reassign_shipment.py
--- a/tests/unit/test_reassign_shipment.py	1969-12-31 19:00:00
+++ b/tests/unit/test_reassign_shipment.py	2026-11-10 12:59:36
@@ -0,0 +1,128 @@
+import copy
+from datetime import datetime, timezone
+
+import pytest
+
+from parcelo import audit, clock, customers, shipments
+from parcelo.errors import DomainError
+from parcelo.store import db
+
+FIXED = datetime(2026, 11, 10, 12, 0, tzinfo=timezone.utc)
+
+
+@pytest.fixture(autouse=True)
+def pinned_clock():
+    clock.set_fixed(FIXED)
+    yield
+
+
+def test_reassign_changes_customer_and_returns_shipment():
+    a = customers.add_customer("Acme")
+    b = customers.add_customer("Globex")
+    s = shipments.create_shipment(a.id, 2.0, "national")
+
+    result = shipments.reassign_shipment(s.id, b.id)
+
+    assert result is s
+    assert result.customer_id == b.id
+    assert db.shipments[s.id].customer_id == b.id
+    assert audit.LOG[-1]["action"] == "shipment.reassigned"
+    assert audit.LOG[-1]["entity_id"] == s.id
+    assert audit.LOG[-1]["details"] == {
+        "old_customer_id": a.id,
+        "new_customer_id": b.id,
+    }
+
+
+def test_reassign_to_same_customer_is_allowed():
+    a = customers.add_customer("Acme")
+    s = shipments.create_shipment(a.id, 2.0, "national")
+
+    shipments.reassign_shipment(s.id, a.id)
+
+    assert db.shipments[s.id].customer_id == a.id
+
+
+def test_reassign_delivered_by_status_is_rejected():
+    a = customers.add_customer("Acme")
+    b = customers.add_customer("Globex")
+    s = shipments.create_shipment(a.id, 2.0, "national")
+    s.status = "delivered"
+
+    with pytest.raises(DomainError) as err:
+        shipments.reassign_shipment(s.id, b.id)
+
+    assert err.value.code == "E_BAD_STATE"
+    assert db.shipments[s.id].customer_id == a.id
+
+
+def test_reassign_delivered_by_timestamp_is_rejected():
+    a = customers.add_customer("Acme")
+    b = customers.add_customer("Globex")
+    s = shipments.create_shipment(a.id, 2.0, "national")
+    s.delivered_at = FIXED
+
+    with pytest.raises(DomainError) as err:
+        shipments.reassign_shipment(s.id, b.id)
+
+    assert err.value.code == "E_BAD_STATE"
+    assert db.shipments[s.id].customer_id == a.id
+
+
+def test_reassign_unknown_shipment_is_rejected():
+    b = customers.add_customer("Globex")
+    before = copy.deepcopy(db.shipments)
+    audit_before = len(audit.LOG)
+
+    with pytest.raises(DomainError) as err:
+        shipments.reassign_shipment("shp_999999", b.id)
+
+    assert err.value.code == "E_NOT_FOUND"
+    assert db.shipments == before
+    assert len(audit.LOG) == audit_before
+
+
+def test_reassign_to_unknown_customer_is_rejected():
+    a = customers.add_customer("Acme")
+    s = shipments.create_shipment(a.id, 2.0, "national")
+    before = copy.deepcopy(db.shipments)
+    audit_before = len(audit.LOG)
+
+    with pytest.raises(DomainError) as err:
+        shipments.reassign_shipment(s.id, "C_missing")
+
+    assert err.value.code == "E_UNKNOWN_CUSTOMER"
+    assert db.shipments == before
+    assert len(audit.LOG) == audit_before
+
+
+def test_reassign_checks_shipment_before_customer():
+    before = copy.deepcopy(db.shipments)
+    audit_before = len(audit.LOG)
+
+    with pytest.raises(DomainError) as err:
+        shipments.reassign_shipment("shp_999999", "C_missing")
+
+    assert err.value.code == "E_NOT_FOUND"
+    assert db.shipments == before
+    assert len(audit.LOG) == audit_before
+
+
+@pytest.mark.parametrize("delivered_by", ["status", "timestamp"])
+def test_reassign_delivered_failure_leaves_state_unchanged(delivered_by):
+    a = customers.add_customer("Acme")
+    b = customers.add_customer("Globex")
+    s = shipments.create_shipment(a.id, 2.0, "national")
+    if delivered_by == "status":
+        s.status = "delivered"
+    else:
+        s.delivered_at = FIXED
+    before = copy.deepcopy(db.shipments)
+    audit_before = len(audit.LOG)
+
+    with pytest.raises(DomainError) as err:
+        shipments.reassign_shipment(s.id, b.id)
+
+    assert err.value.code == "E_BAD_STATE"
+    assert db.shipments == before
+    assert len(audit.LOG) == audit_before
