diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_void_invoice.py b/tests/unit/test_void_invoice.py
--- a/tests/unit/test_void_invoice.py	1969-12-31 19:00:00
+++ b/tests/unit/test_void_invoice.py	2026-11-10 12:49:56
@@ -0,0 +1,57 @@
+import pytest
+
+from parcelo import audit, clock, customers, invoices, shipments, store
+from parcelo.errors import DomainError
+
+
+def _open_invoice():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 2, "local")
+    return invoices.issue_invoice(s.id)
+
+
+def test_void_open_invoice():
+    inv = _open_invoice()
+    moment = clock.now()
+    clock.set_fixed(moment)
+    try:
+        result = invoices.void_invoice(inv.id)
+    finally:
+        clock.clear_fixed()
+    assert result is inv
+    assert result.status == "void"
+    assert result.voided_at == moment
+    assert audit.LOG[-1]["action"] == "invoice.voided"
+
+
+def test_void_missing_invoice_fails():
+    with pytest.raises(DomainError) as err:
+        invoices.void_invoice("INV-nope")
+    assert err.value.code == "E_NOT_FOUND"
+    assert "INV-nope" not in store.db.invoices
+
+
+def test_void_paid_invoice_fails_and_state_unchanged():
+    inv = _open_invoice()
+    invoices.mark_paid(inv.id)
+    with pytest.raises(DomainError) as err:
+        invoices.void_invoice(inv.id)
+    assert err.value.code == "E_BAD_STATE"
+    assert store.db.invoices[inv.id].status == "paid"
+    assert store.db.invoices[inv.id].voided_at is None
+
+
+def test_void_already_void_invoice_fails_and_keeps_original_time():
+    inv = _open_invoice()
+    clock.set_fixed(clock.now())
+    try:
+        invoices.void_invoice(inv.id)
+        first = store.db.invoices[inv.id].voided_at
+        clock.set_fixed(clock.now())
+        with pytest.raises(DomainError) as err:
+            invoices.void_invoice(inv.id)
+    finally:
+        clock.clear_fixed()
+    assert err.value.code == "E_BAD_STATE"
+    assert store.db.invoices[inv.id].status == "void"
+    assert store.db.invoices[inv.id].voided_at == first
