+def split_shipment(shipment_id, weights):
+    """Replace a "created" shipment with one new shipment per weight.
+
+    The new shipments keep the original customer and zone and are returned in
+    the same order as ``weights``. The original is kept with status "split".
+    Everything is validated before any state changes or events are emitted.
+    """
+    shipment = get_shipment(shipment_id)
+    weights = list(weights)
+    if not weights:
+        raise DomainError("E_BAD_INPUT", "weights must not be empty")
+    for w in weights:
+        if isinstance(w, bool) or not isinstance(w, (int, float, Decimal)) or w <= 0:
+            raise DomainError("E_BAD_WEIGHT", str(w))
+    if shipment.status != "created":
+        raise DomainError("E_BAD_STATE", shipment.status)
+    # Compare via Decimal(str(...)) so float rounding in the inputs does not
+    # cause a spurious mismatch.
+    total = sum(Decimal(str(w)) for w in weights)
+    original = Decimal(str(shipment.weight_kg))
+    if total != original:
+        raise DomainError("E_BAD_WEIGHT", f"weights sum to {total}, expected {original}")
+
+    now = clock.now()
+    new_shipments = [
+        Shipment(
+            id=ids.new_id("shp"),
+            customer_id=shipment.customer_id,
+            weight_kg=w,
+            zone=shipment.zone,
+            created_at=now,
+        )
+        for w in weights
+    ]
+    for new in new_shipments:
+        db.shipments[new.id] = new
+    shipment.status = "split"
+    events.emit(
+        "shipment.split",
+        shipment.id,
+        new_ids=[new.id for new in new_shipments],
+    )
+    return new_shipments
