+from datetime import datetime, timezone
+
+import pytest
+
+from parcelo import clock, customers, events, shipments
+from parcelo.errors import DomainError
+from parcelo.store import db
+
+FIXED = datetime(2026, 11, 10, 12, 0, tzinfo=timezone.utc)
+
+
+@pytest.fixture
+def pinned_clock():
+    clock.set_fixed(FIXED)
+    yield FIXED
+    clock.clear_fixed()
+
+
+def _make(weight=10.0, zone="national"):
+    c = customers.add_customer("Acme")
+    return shipments.create_shipment(c.id, weight, zone)
+
+
+def test_split_returns_new_shipments_in_weight_order(pinned_clock):
+    s = _make(10.0, "national")
+    result = shipments.split_shipment(s.id, [3.0, 7.0])
+    assert [r.weight_kg for r in result] == [3.0, 7.0]
+    for r in result:
+        assert r.id.startswith("shp_")
+        assert r.id != s.id
+        assert r.customer_id == s.customer_id
+        assert r.zone == "national"
+        assert r.status == "created"
+        assert r.created_at == FIXED
+        assert db.shipments[r.id] is r
+
+
+def test_original_is_marked_split(pinned_clock):
+    s = _make(10.0)
+    shipments.split_shipment(s.id, [4.0, 6.0])
+    assert db.shipments[s.id].status == "split"
+
+
+def test_split_emits_event(pinned_clock):
+    s = _make(10.0)
+    events.OUTBOX.clear()
+    result = shipments.split_shipment(s.id, [5.0, 5.0])
+    assert events.OUTBOX[-1]["name"] == "shipment.split"
+    assert events.OUTBOX[-1]["entity_id"] == s.id
+    assert events.OUTBOX[-1]["payload"]["new_ids"] == [r.id for r in result]
+    assert len(events.OUTBOX) == 1
+
+
+def test_split_not_found_fails():
+    events.OUTBOX.clear()
+    with pytest.raises(DomainError) as err:
+        shipments.split_shipment("shp_missing", [1.0])
+    assert err.value.code == "E_NOT_FOUND"
+    assert events.OUTBOX == []
+
+
+@pytest.mark.parametrize("bad_status", ["split", "delivered", "cancelled"])
+def test_split_bad_state_fails(bad_status, pinned_clock):
+    s = _make(10.0)
+    db.shipments[s.id].status = bad_status
+    before = dict(db.shipments)
+    events.OUTBOX.clear()
+    with pytest.raises(DomainError) as err:
+        shipments.split_shipment(s.id, [5.0, 5.0])
+    assert err.value.code == "E_BAD_STATE"
+    assert db.shipments[s.id].status == bad_status
+    assert dict(db.shipments) == before
+    assert events.OUTBOX == []
+
+
+@pytest.mark.parametrize(
+    "weights, code",
+    [
+        ([], "E_BAD_INPUT"),
+        ([4.0, 5.0], "E_BAD_WEIGHT"),
+        ([4.0, 7.0], "E_BAD_WEIGHT"),
+        ([0.0, 10.0], "E_BAD_WEIGHT"),
+        ([-2.0, 12.0], "E_BAD_WEIGHT"),
+        ([10.0, True], "E_BAD_WEIGHT"),
+    ],
+)
+def test_split_bad_input_fails(weights, code, pinned_clock):
+    s = _make(10.0)
+    before = dict(db.shipments)
+    events.OUTBOX.clear()
+    with pytest.raises(DomainError) as err:
+        shipments.split_shipment(s.id, weights)
+    assert err.value.code == code
+    assert db.shipments[s.id].status == "created"
+    assert dict(db.shipments) == before
+    assert events.OUTBOX == []
+
+
