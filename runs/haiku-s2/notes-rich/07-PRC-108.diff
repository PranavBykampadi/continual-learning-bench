+++ b/tests/unit/test_reports_outstanding.py	2026-11-10 12:54:11
@@ -0,0 +1,47 @@
+from parcelo import customers, invoices, reports, shipments
+from parcelo.money import Money
+
+
+def test_outstanding_counts_only_open_invoices():
+    c = customers.add_customer("Acme")
+    s1 = shipments.create_shipment(c.id, 2, "local")
+    s2 = shipments.create_shipment(c.id, 2, "local")
+    s3 = shipments.create_shipment(c.id, 2, "local")
+    inv1 = invoices.issue_invoice(s1.id)
+    inv2 = invoices.issue_invoice(s2.id)
+    inv3 = invoices.issue_invoice(s3.id)
+    invoices.mark_paid(inv1.id)
+    inv3.status = "void"
+
+    result = reports.outstanding_by_customer()
+
+    assert result[c.id] == Money.parse(inv2.amount)
+
+
+def test_outstanding_sums_multiple_open_invoices_per_customer():
+    a = customers.add_customer("Acme")
+    b = customers.add_customer("Globex")
+    sa1 = shipments.create_shipment(a.id, 2, "local")
+    sa2 = shipments.create_shipment(a.id, 2, "local")
+    sb = shipments.create_shipment(b.id, 2, "local")
+    inv_a1 = invoices.issue_invoice(sa1.id)
+    inv_a2 = invoices.issue_invoice(sa2.id)
+    inv_b = invoices.issue_invoice(sb.id)
+    invoices.mark_paid(inv_b.id)
+
+    result = reports.outstanding_by_customer()
+
+    assert result[a.id] == Money.parse(inv_a1.amount) + Money.parse(inv_a2.amount)
+    assert result[b.id] == Money.zero()
+
+
+def test_customer_without_invoices_maps_to_zero():
+    c = customers.add_customer("Initech")
+
+    result = reports.outstanding_by_customer()
+
+    assert result == {c.id: Money.zero()}
+
+
+def test_no_customers_gives_empty_dict():
+    assert reports.outstanding_by_customer() == {}
