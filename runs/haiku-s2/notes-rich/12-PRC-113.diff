+++ b/tests/unit/test_invoice_credit.py	2026-11-10 12:58:09
@@ -0,0 +1,93 @@
+import copy
+from decimal import Decimal
+
+import pytest
+
+from parcelo import audit, customers, invoices, reports, shipments
+from parcelo.errors import DomainError
+from parcelo.store import db
+
+
+def _open_invoice(weight=2, zone="local"):
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, weight, zone)
+    return invoices.issue_invoice(s.id)
+
+
+def test_credit_reduces_amount_and_returns_remaining():
+    inv = _open_invoice()  # 2 kg local -> 7.0
+    remaining = invoices.apply_credit(inv.id, 2.5)
+    assert remaining == 4.5
+    assert db.invoices[inv.id].amount == 4.5
+    assert db.invoices[inv.id].status == "open"
+    assert audit.LOG[-1]["action"] == "invoice.credit_applied"
+    assert audit.LOG[-1]["entity_id"] == inv.id
+
+
+def test_credit_equal_to_amount_leaves_zero():
+    inv = _open_invoice()
+    assert invoices.apply_credit(inv.id, 7.0) == 0.0
+    assert db.invoices[inv.id].amount == 0.0
+
+
+def test_credit_keeps_reports_and_balance_working():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 2, "local")
+    inv = invoices.issue_invoice(s.id)
+    invoices.apply_credit(inv.id, 1.25)
+    assert customers.outstanding_balance(c.id) == 5.75
+    invoices.mark_paid(inv.id)
+    assert reports.revenue_total() == 5.75
+
+
+def test_credit_rounding_is_exact_in_cents():
+    inv = _open_invoice()
+    assert invoices.apply_credit(inv.id, Decimal("0.10")) == 6.9
+    assert invoices.apply_credit(inv.id, 0.2) == 6.7
+
+
+def test_unknown_invoice_not_found():
+    with pytest.raises(DomainError) as err:
+        invoices.apply_credit("INV-missing", 1)
+    assert err.value.code == "E_NOT_FOUND"
+
+
+@pytest.mark.parametrize("status", ["paid", "void"])
+def test_non_open_invoice_rejected(status):
+    inv = _open_invoice()
+    db.invoices[inv.id].status = status
+    before = copy.deepcopy(db.invoices)
+    log_len = len(audit.LOG)
+    with pytest.raises(DomainError) as err:
+        invoices.apply_credit(inv.id, 1)
+    assert err.value.code == "E_BAD_STATE"
+    assert db.invoices == before
+    assert len(audit.LOG) == log_len
+
+
+@pytest.mark.parametrize(
+    "credit",
+    [
+        7.01,  # larger than the invoice amount
+        100,
+        0,
+        -1,
+        -0.5,
+        0.001,  # rounds to zero cents
+        True,
+        False,
+        "1",
+        None,
+        float("nan"),
+        float("inf"),
+    ],
+)
+def test_rejected_credit_leaves_invoice_unchanged(credit):
+    inv = _open_invoice()
+    before = copy.deepcopy(db.invoices)
+    log_len = len(audit.LOG)
+    with pytest.raises(DomainError) as err:
+        invoices.apply_credit(inv.id, credit)
+    assert err.value.code == "E_BAD_INPUT"
+    assert db.invoices == before
+    assert len(audit.LOG) == log_len
