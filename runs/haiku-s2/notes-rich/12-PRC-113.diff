+def _validate_credit(credit):
+    """Return the credit as Money, or raise E_BAD_INPUT."""
+    if isinstance(credit, bool) or not isinstance(credit, (int, float, Decimal)):
+        raise DomainError("E_BAD_INPUT", "credit must be a number")
+    if not math.isfinite(credit):
+        raise DomainError("E_BAD_INPUT", "credit must be finite")
+    if credit <= 0:
+        raise DomainError("E_BAD_INPUT", "credit must be positive")
+    money = Money.parse(credit)
+    if money.cents <= 0:
+        raise DomainError("E_BAD_INPUT", "credit must be at least one cent")
+    return money
+
+
+def apply_credit(invoice_id, amount):
+    """Reduce an open invoice by ``amount`` and return the remaining amount."""
+    if invoice_id not in db.invoices:
+        raise DomainError("E_NOT_FOUND", invoice_id)
+    credit = _validate_credit(amount)
+    invoice = db.invoices[invoice_id]
+    if invoice.status != "open":
+        raise DomainError("E_BAD_STATE", f"invoice is {invoice.status}")
+    current = Money.parse(invoice.amount)
+    if current < credit:
+        raise DomainError("E_BAD_INPUT", "credit exceeds invoice amount")
+    remaining = current - credit
+    # Invoice.amount is still a float; store the exact cents value as dollars.
+    invoice.amount = remaining.cents / 100
+    audit.record(
+        "invoice.credit_applied",
+        invoice.id,
+        credit=str(credit),
+        remaining=str(remaining),
+    )
+    return invoice.amount
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_invoice_credit.py b/tests/unit/test_invoice_credit.py
