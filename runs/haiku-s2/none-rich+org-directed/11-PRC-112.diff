@@ -0,0 +1,45 @@
+"""Customer claims against delivered shipments."""
+
+from parcelo import audit, clock, ids
+from parcelo.errors import DomainError
+from parcelo.models import Claim
+from parcelo.money import Money
+from parcelo.shipments import get_shipment
+from parcelo.store import db
+
+
+def file_claim(shipment_id, amount, reason):
+    """File a claim for money back on a delivered shipment.
+
+    Args:
+        shipment_id: ID of the shipment being claimed against. Must exist and be delivered.
+        amount: Dollar amount to claim. Accepts float, int, str or Decimal and is stored
+            as Money. Must be positive to the cent.
+        reason: Free-text reason for the claim.
+
+    Returns:
+        The stored Claim.
+
+    Raises:
+        DomainError: E_NOT_FOUND if the shipment does not exist, E_BAD_STATE if it has
+            not been delivered, E_BAD_INPUT if the amount is malformed or not positive.
+    """
+    shipment = get_shipment(shipment_id)
+    if shipment.status != "delivered":
+        raise DomainError("E_BAD_STATE", f"{shipment_id} is {shipment.status}, not delivered")
+    try:
+        money = Money.parse(amount)
+    except (ArithmeticError, TypeError, ValueError) as exc:
+        raise DomainError("E_BAD_INPUT", f"bad amount {amount!r}") from exc
+    if money.cents <= 0:
+        raise DomainError("E_BAD_INPUT", f"amount must be positive, got {amount!r}")
+    claim = Claim(
+        id=ids.new_id("clm"),
+        shipment_id=shipment_id,
+        amount=money,
+        reason=reason,
+        filed_at=clock.now(),
+    )
+    db.claims[claim.id] = claim
+    audit.record("claim.filed", claim.id, shipment_id=shipment_id, amount_cents=money.cents)
+    return claim
