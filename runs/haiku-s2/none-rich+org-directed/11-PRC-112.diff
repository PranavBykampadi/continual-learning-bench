diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_claims.py b/tests/unit/test_claims.py
--- a/tests/unit/test_claims.py	1969-12-31 19:00:00
+++ b/tests/unit/test_claims.py	2026-11-10 14:54:29
@@ -0,0 +1,53 @@
+import pytest
+
+from parcelo import audit, claims, customers, shipments
+from parcelo.errors import DomainError
+from parcelo.money import Money
+from parcelo.store import db
+
+
+def _delivered_shipment():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 2, "local")
+    s.status = "delivered"
+    return s
+
+
+def test_file_claim_on_delivered_shipment():
+    s = _delivered_shipment()
+    claim = claims.file_claim(s.id, 12.5, "box arrived crushed")
+    assert claim.shipment_id == s.id
+    assert claim.amount == Money(1250)
+    assert claim.reason == "box arrived crushed"
+    assert claim.filed_at is not None
+    assert db.claims[claim.id] is claim
+    assert any(e["action"] == "claim.filed" and e["entity_id"] == claim.id for e in audit.LOG)
+
+
+def test_amount_accepts_string_and_decimal_values():
+    s = _delivered_shipment()
+    assert claims.file_claim(s.id, "3.10", "late").amount == Money(310)
+
+
+def test_rejects_undelivered_shipment():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 2, "local")
+    with pytest.raises(DomainError) as err:
+        claims.file_claim(s.id, 5, "lost")
+    assert err.value.code == "E_BAD_STATE"
+    assert db.claims == {}
+
+
+def test_rejects_unknown_shipment():
+    with pytest.raises(DomainError) as err:
+        claims.file_claim("shp_missing", 5, "lost")
+    assert err.value.code == "E_NOT_FOUND"
+
+
+@pytest.mark.parametrize("amount", [0, -1, -0.5, 0.001, "abc", None])
+def test_rejects_non_positive_or_malformed_amount(amount):
+    s = _delivered_shipment()
+    with pytest.raises(DomainError) as err:
+        claims.file_claim(s.id, amount, "damaged")
+    assert err.value.code == "E_BAD_INPUT"
+    assert db.claims == {}
