diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/test_reports.py b/tests/test_reports.py
--- a/tests/test_reports.py	1969-12-31 19:00:00
+++ b/tests/test_reports.py	2026-11-10 15:02:52
@@ -0,0 +1,29 @@
+from parcelo import customers, reports, shipments
+
+
+def test_volume_report_includes_customers_without_shipments():
+    c = customers.add_customer("Empty Co")
+    assert reports.volume_report() == {
+        c.id: {"shipments": 0, "tier": "starter"},
+    }
+
+
+def test_volume_report_counts_per_customer():
+    a = customers.add_customer("Acme")
+    b = customers.add_customer("Globex")
+    for _ in range(3):
+        shipments.create_shipment(a.id, 1, "local")
+    shipments.create_shipment(b.id, 2, "national")
+
+    report = reports.volume_report()
+    assert report[a.id] == {"shipments": 3, "tier": "starter"}
+    assert report[b.id] == {"shipments": 1, "tier": "starter"}
+
+
+def test_volume_report_tier_boundaries():
+    cases = {9: "starter", 10: "regular", 49: "regular", 50: "bulk"}
+    for count, expected in cases.items():
+        c = customers.add_customer(f"Cust {count}")
+        for _ in range(count):
+            shipments.create_shipment(c.id, 1, "local")
+        assert reports.volume_report()[c.id] == {"shipments": count, "tier": expected}
