+def _volume_tier(shipment_count):
+    """Return the volume tier label for a shipment count.
+
+    Mirrors the thresholds of ``parcelo.legacy.billing.volume_tier``. Kept local
+    so new code does not depend on the legacy package, which is being removed.
+
+    Args:
+        shipment_count: Number of shipments the customer has.
+
+    Returns:
+        One of ``"bulk"``, ``"regular"`` or ``"starter"``.
+    """
+    if shipment_count >= 50:
+        return "bulk"
+    if shipment_count >= 10:
+        return "regular"
+    return "starter"
+
+
+def volume_report():
+    """Return per-customer shipment counts with their volume tier.
+
+    Every customer in the store is included, even those with no shipments.
+    Shipments whose customer id is unknown are ignored.
+
+    Returns:
+        dict: Maps each customer id to ``{"shipments": int, "tier": str}``.
+    """
+    counts = {customer_id: 0 for customer_id in db.customers}
+    for shipment in db.shipments.values():
+        if shipment.customer_id in counts:
+            counts[shipment.customer_id] += 1
+    return {
+        customer_id: {"shipments": count, "tier": _volume_tier(count)}
+        for customer_id, count in counts.items()
+    }
+
