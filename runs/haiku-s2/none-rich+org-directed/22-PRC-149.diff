+
+
+def _created(weight=10.0, zone="national"):
+    c = customers.add_customer("Acme")
+    return shipments.create_shipment(c.id, weight, zone)
+
+
+def test_split_creates_one_shipment_per_weight_in_order():
+    s = _created(10.0, "international")
+    parts = shipments.split_shipment(s.id, [2.5, 7.5])
+    assert [p.weight_kg for p in parts] == [2.5, 7.5]
+    assert all(p.customer_id == s.customer_id and p.zone == "international" for p in parts)
+    assert all(p.status == "created" for p in parts)
+    assert s.status == "split"
+    names = [e["name"] for e in events.OUTBOX]
+    assert names[-1] == "shipment.split"
+    assert events.OUTBOX[-1]["entity_id"] == s.id
+
+
+def test_split_missing_shipment():
+    with pytest.raises(DomainError) as err:
+        shipments.split_shipment("shp_nope", [1])
+    assert err.value.code == "E_NOT_FOUND"
+
+
+def test_split_requires_created_status():
+    s = _created(4.0)
+    s.status = "delivered"
+    with pytest.raises(DomainError) as err:
+        shipments.split_shipment(s.id, [2, 2])
+    assert err.value.code == "E_BAD_STATE"
+    assert s.status == "delivered"
+
+
+def test_split_weights_must_match_total():
+    s = _created(10.0)
+    with pytest.raises(DomainError) as err:
+        shipments.split_shipment(s.id, [4, 4])
+    assert err.value.code == "E_BAD_INPUT"
+    assert s.status == "created"
+
+
+def test_split_rejects_non_positive_weight_without_mutating():
+    s = _created(10.0)
+    with pytest.raises(DomainError) as err:
+        shipments.split_shipment(s.id, [12, -2])
+    assert err.value.code == "E_BAD_WEIGHT"
+    assert s.status == "created"
+    assert len(store.db.shipments) == 1
