+def split_shipment(shipment_id, weights):
+    """Replace a shipment in status "created" with one new shipment per weight.
+
+    The new shipments keep the original's customer and zone. The original is
+    marked with status "split" and kept for history.
+
+    Args:
+        shipment_id: Id of the shipment to split.
+        weights: Iterable of weights in kg, one per new shipment.
+
+    Returns:
+        list[Shipment]: The new shipments, in the same order as ``weights``.
+
+    Raises:
+        DomainError: E_NOT_FOUND if the shipment does not exist, E_BAD_STATE if
+            it is not in status "created", E_BAD_WEIGHT if any weight is not
+            positive, E_BAD_INPUT if the weights do not add up to the original
+            weight.
+    """
+    original = get_shipment(shipment_id)
+    if original.status != "created":
+        raise DomainError("E_BAD_STATE", f"{shipment_id} is {original.status}")
+
+    weights = list(weights)
+    if not weights:
+        raise DomainError("E_BAD_INPUT", "no weights given")
+    for weight in weights:
+        if weight <= 0:
+            raise DomainError("E_BAD_WEIGHT", str(weight))
+    if not math.isclose(sum(weights), original.weight_kg, rel_tol=1e-9, abs_tol=1e-9):
+        raise DomainError(
+            "E_BAD_INPUT",
+            f"weights sum to {sum(weights)}, expected {original.weight_kg}",
+        )
+
+    # All checks passed; create the children, then retire the original.
+    new_shipments = [
+        create_shipment(original.customer_id, weight, original.zone) for weight in weights
+    ]
+    original.status = "split"
+    events.emit("shipment.split", original.id, parts=[s.id for s in new_shipments])
+    return new_shipments
