+from dataclasses import dataclass
+from decimal import Decimal
+
+from parcelo.errors import DomainError
+from parcelo.money import Money
+
 ZONE_BASE = {"local": 4.5, "national": 9.0, "international": 24.0}
 PER_KG = 1.25
 
+# Fuel surcharge percent per zone. Same values as parcelo.legacy.billing.fuel_surcharge,
+# reimplemented here because new code must not import from parcelo.legacy.
+FUEL_SURCHARGE_PCT = {
+    "local": Decimal("0"),
+    "national": Decimal("4.0"),
+    "international": Decimal("9.5"),
+}
 
+
+@dataclass(frozen=True)
+class QuoteWithSurcharge:
+    """A quote split into base price and fuel surcharge, both as Money.
+
+    Attributes:
+        quote: The normal quote for the weight and zone.
+        surcharge: The fuel surcharge for the zone, rounded half up to the cent.
+    """
+
+    quote: Money
+    surcharge: Money
+
+    @property
+    def total(self) -> Money:
+        """Quote plus surcharge."""
+        return self.quote + self.surcharge
+
+
 def base_rate(zone):
     if zone not in ZONE_BASE:
         raise ValueError("unknown zone: %s" % zone)
@@ -12,3 +44,28 @@
     if weight_kg <= 0:
         raise ValueError("weight must be positive")
     return round(base_rate(zone) + PER_KG * weight_kg, 2)
+
+
+def quote_with_surcharge(weight_kg: float, zone: str) -> QuoteWithSurcharge:
+    """Price a shipment and add the fuel surcharge for its zone.
+
+    Args:
+        weight_kg: Shipment weight in kilograms. Must be positive.
+        zone: One of "local", "national" or "international".
+
+    Returns:
+        A QuoteWithSurcharge with the base quote and the surcharge as Money.
+
+    Raises:
+        DomainError: E_BAD_ZONE if the zone is unknown, E_BAD_WEIGHT if the
+            weight is zero or negative.
+    """
+    if zone not in ZONE_BASE:
+        raise DomainError("E_BAD_ZONE", zone)
+    if weight_kg <= 0:
+        raise DomainError("E_BAD_WEIGHT", str(weight_kg))
+    # quote() returns a float; wrap it at the edge as the team decided.
+    base = Money.parse(quote(weight_kg, zone))
+    pct = FUEL_SURCHARGE_PCT[zone]
+    surcharge = base.scale(pct / Decimal(100))
+    return QuoteWithSurcharge(quote=base, surcharge=surcharge)
