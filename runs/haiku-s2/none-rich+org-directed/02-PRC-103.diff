+def test_quote_with_surcharge_local_has_no_surcharge():
+    result = rates.quote_with_surcharge(2, "local")
+    assert result.quote == Money(700)
+    assert result.surcharge == Money(0)
+    assert result.total == Money(700)
+
+
+def test_quote_with_surcharge_national():
+    # base 9.00 + 1.25 * 2 = 11.50; 4% = 0.46
+    result = rates.quote_with_surcharge(2, "national")
+    assert result.quote == Money(1150)
+    assert result.surcharge == Money(46)
+    assert result.total == Money(1196)
+
+
+def test_quote_with_surcharge_international_rounds_half_up():
+    # base 24.00 + 1.25 = 25.25; 9.5% = 2.39875 -> 2.40
+    result = rates.quote_with_surcharge(1, "international")
+    assert result.quote == Money(2525)
+    assert result.surcharge == Money(240)
+    assert result.total == Money(2765)
+
