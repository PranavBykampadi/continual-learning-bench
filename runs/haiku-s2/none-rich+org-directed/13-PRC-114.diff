+def _as_aware_utc(moment):
+    # Legacy invoices store naive UTC datetimes (see invoices.issue_invoice).
+    # Naive and aware datetimes can't be subtracted, so tag them as UTC.
+    if moment.tzinfo is None:
+        return moment.replace(tzinfo=timezone.utc)
+    return moment
+
+
+def aging_report():
+    """Total open (unpaid) invoices by age in whole days since issue."""
+    now = clock.now()
+    buckets = {"0-30": Money.zero(), "31-60": Money.zero(), "60+": Money.zero()}
+    for invoice in db.invoices.values():
+        if invoice.status == "paid":
+            continue
+        age = days_between(_as_aware_utc(invoice.issued_at), now)
+        if age <= 30:
+            key = "0-30"
+        elif age <= 60:
+            key = "31-60"
+        else:
+            key = "60+"
+        buckets[key] = buckets[key] + Money.parse(invoice.amount)
+    return buckets
 
 
