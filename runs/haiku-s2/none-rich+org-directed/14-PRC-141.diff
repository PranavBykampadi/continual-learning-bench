@@ -1,6 +1,6 @@
 import pytest
 
-from parcelo import customers, events, shipments
+from parcelo import customers, events, shipments, store
 from parcelo.errors import DomainError
 
 
@@ -15,3 +15,41 @@
     with pytest.raises(DomainError) as err:
         shipments.create_shipment("nope", 1, "local")
     assert err.value.code == "E_UNKNOWN_CUSTOMER"
+
+
+def test_reassign_moves_shipment_and_emits_event():
+    a = customers.add_customer("Acme")
+    b = customers.add_customer("Bolt")
+    s = shipments.create_shipment(a.id, 1, "local")
+    result = shipments.reassign_shipment(s.id, b.id)
+    assert result is s
+    assert store.db.shipments[s.id].customer_id == b.id
+    assert events.OUTBOX[-1]["name"] == "shipment.reassigned"
+    assert events.OUTBOX[-1]["payload"] == {"from_customer_id": a.id, "to_customer_id": b.id}
+
+
+def test_reassign_unknown_shipment():
+    b = customers.add_customer("Bolt")
+    with pytest.raises(DomainError) as err:
+        shipments.reassign_shipment("shp_999999", b.id)
+    assert err.value.code == "E_NOT_FOUND"
+
+
+def test_reassign_to_unknown_customer():
+    a = customers.add_customer("Acme")
+    s = shipments.create_shipment(a.id, 1, "local")
+    with pytest.raises(DomainError) as err:
+        shipments.reassign_shipment(s.id, "C_nope")
+    assert err.value.code == "E_UNKNOWN_CUSTOMER"
+    assert store.db.shipments[s.id].customer_id == a.id
+
+
+def test_reassign_delivered_shipment_fails():
+    a = customers.add_customer("Acme")
+    b = customers.add_customer("Bolt")
+    s = shipments.create_shipment(a.id, 1, "local")
+    s.status = "delivered"
+    with pytest.raises(DomainError) as err:
+        shipments.reassign_shipment(s.id, b.id)
+    assert err.value.code == "E_BAD_STATE"
+    assert store.db.shipments[s.id].customer_id == a.id
