+def apply_credit(invoice_id, amount):
+    """Reduce an open invoice by a credit.
+
+    The invoice amount is stored as a float (reports and customer balances
+    still sum it), so the arithmetic is done in ``Money`` and written back.
+
+    Args:
+        invoice_id: ID of the invoice to credit.
+        amount: Credit to apply, as a float, int, str, Decimal or Money.
+
+    Returns:
+        Money: The invoice amount remaining after the credit.
+
+    Raises:
+        DomainError: ``E_NOT_FOUND`` if the invoice does not exist,
+            ``E_BAD_STATE`` if it is not open, and ``E_BAD_INPUT`` if the
+            credit is not a positive amount or is larger than the invoice.
+    """
+    invoice = db.invoices.get(invoice_id)
+    if invoice is None:
+        raise DomainError("E_NOT_FOUND", invoice_id)
+    if invoice.status != "open":
+        raise DomainError("E_BAD_STATE", f"{invoice_id} is {invoice.status}")
+    try:
+        credit = Money.parse(amount)
+    except (ValueError, ArithmeticError):
+        raise DomainError("E_BAD_INPUT", f"bad credit amount {amount!r}")
+    if credit.cents <= 0:
+        raise DomainError("E_BAD_INPUT", f"credit must be positive, got {amount!r}")
+    current = Money.parse(invoice.amount)
+    if current < credit:
+        raise DomainError("E_BAD_INPUT", f"credit {credit} exceeds invoice {current}")
+    remaining = current - credit
+    invoice.amount = remaining.cents / 100
+    audit.record(
+        "invoice.credit_applied",
+        invoice_id,
+        credit=str(credit),
+        remaining=str(remaining),
+    )
+    return remaining
