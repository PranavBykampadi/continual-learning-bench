-from parcelo import customers, invoices, shipments
+import pytest
 
+from parcelo import audit, customers, invoices, reports, shipments
+from parcelo.errors import DomainError
+from parcelo.money import Money
 
+
 def test_issue_and_pay():
     c = customers.add_customer("Acme")
     s = shipments.create_shipment(c.id, 2, "local")
     inv = invoices.issue_invoice(s.id)
     assert inv.amount == 7.0
     assert invoices.mark_paid(inv.id).status == "paid"
+
+
+def _open_invoice():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 2, "local")
+    return c, invoices.issue_invoice(s.id)
+
+
+def test_apply_credit_reduces_open_invoice():
+    c, inv = _open_invoice()
+    remaining = invoices.apply_credit(inv.id, 2.5)
+    assert remaining == Money.parse(4.5)
+    assert inv.amount == 4.5
+    assert inv.status == "open"
+    assert customers.outstanding_balance(c.id) == 4.5
+    assert audit.LOG[-1]["action"] == "invoice.credit_applied"
+
+
+def test_apply_credit_equal_to_amount_leaves_zero():
+    _, inv = _open_invoice()
+    assert invoices.apply_credit(inv.id, "7.00") == Money.zero()
+    assert inv.amount == 0.0
+
+
+def test_credit_keeps_reports_working():
+    _, inv = _open_invoice()
+    invoices.apply_credit(inv.id, 1.25)
+    invoices.mark_paid(inv.id)
+    assert reports.revenue_total() == 5.75
+
+
+def test_apply_credit_unknown_invoice_fails():
+    with pytest.raises(DomainError) as err:
+        invoices.apply_credit("INV-missing", 1)
+    assert err.value.code == "E_NOT_FOUND"
+
+
+def test_apply_credit_to_paid_invoice_fails():
+    _, inv = _open_invoice()
+    invoices.mark_paid(inv.id)
+    with pytest.raises(DomainError) as err:
+        invoices.apply_credit(inv.id, 1)
+    assert err.value.code == "E_BAD_STATE"
+    assert inv.amount == 7.0
+
+
+def test_apply_credit_larger_than_invoice_fails():
+    _, inv = _open_invoice()
+    with pytest.raises(DomainError) as err:
+        invoices.apply_credit(inv.id, 7.01)
+    assert err.value.code == "E_BAD_INPUT"
+    assert inv.amount == 7.0
+
+
+@pytest.mark.parametrize("bad", [0, -1, "nope"])
+def test_apply_credit_rejects_non_positive_or_garbage(bad):
+    _, inv = _open_invoice()
+    with pytest.raises(DomainError) as err:
+        invoices.apply_credit(inv.id, bad)
+    assert err.value.code == "E_BAD_INPUT"
+    assert inv.amount == 7.0
