+from parcelo.money import Money
 from parcelo.store import db
+
+
+def outstanding_by_customer() -> dict[str, Money]:
+    """Return the total amount each customer still owes on open invoices.
+
+    Every customer is included; customers with no open invoices map to zero.
+    Paid and void invoices are not counted.
+
+    Returns:
+        A dict mapping customer id to the sum of that customer's open
+        invoice amounts, as Money.
+    """
+    balances = {customer_id: Money.zero() for customer_id in db.customers}
+    for invoice in db.invoices.values():
+        if invoice.status != "open":
+            continue
+        customer_id = db.shipments[invoice.shipment_id].customer_id
+        balances[customer_id] = balances.get(customer_id, Money.zero()) + Money.parse(
+            invoice.amount
+        )
+    return balances
 
 
