 def open_invoices():
     return [i for i in db.invoices.values() if i.status == "open"]
+
+
+def late_fee_for(invoice_id):
+    """Return the late fee on an invoice as Money.
+
+    An invoice is late 30 days after it was issued. Each full day past that
+    point adds 1.5% of the invoice amount. Not late yet means zero.
+    Raises DomainError (E_NOT_FOUND) if the invoice does not exist.
+    """
+    if invoice_id not in db.invoices:
+        raise DomainError("E_NOT_FOUND", invoice_id)
+    invoice = db.invoices[invoice_id]
+
+    issued = invoice.issued_at
+    if issued.tzinfo is None:
+        # issue_invoice stores naive UTC times; make them aware before comparing.
+        issued = issued.replace(tzinfo=timezone.utc)
+    elapsed = clock.now() - issued
+    days_past_due = elapsed.days - LATE_AFTER.days
+    if days_past_due <= 0:
+        return Money.zero()
+
+    amount = Money.parse(invoice.amount)
+    return amount.scale(LATE_FEE_PER_DAY * days_past_due)
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/test_invoices.py b/tests/test_invoices.py
