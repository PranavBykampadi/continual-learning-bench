@@ -1,9 +1,52 @@
-from parcelo import customers, invoices, shipments
+from datetime import datetime, timedelta, timezone
 
+import pytest
 
+from parcelo import clock, customers, invoices, shipments
+from parcelo.errors import DomainError
+from parcelo.money import Money
+
+
 def test_issue_and_pay():
     c = customers.add_customer("Acme")
     s = shipments.create_shipment(c.id, 2, "local")
     inv = invoices.issue_invoice(s.id)
     assert inv.amount == 7.0
     assert invoices.mark_paid(inv.id).status == "paid"
+
+
+def _invoice_issued_days_ago(days):
+    now = datetime(2026, 11, 10, tzinfo=timezone.utc)
+    clock.set_fixed(now)
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 2, "local")
+    inv = invoices.issue_invoice(s.id)
+    inv.issued_at = now - timedelta(days=days)
+    return inv
+
+
+def test_late_fee_zero_before_thirty_days():
+    inv = _invoice_issued_days_ago(29)
+    assert invoices.late_fee_for(inv.id) == Money.zero()
+
+
+def test_late_fee_zero_exactly_at_thirty_days():
+    inv = _invoice_issued_days_ago(30)
+    assert invoices.late_fee_for(inv.id) == Money.zero()
+
+
+def test_late_fee_is_one_and_a_half_percent_per_day_past_thirty():
+    inv = _invoice_issued_days_ago(40)  # 10 days late on a 7.00 invoice
+    assert invoices.late_fee_for(inv.id) == Money(105)  # 7.00 * 1.5% * 10 = 1.05
+
+
+def test_late_fee_ignores_partial_days():
+    inv = _invoice_issued_days_ago(30)
+    inv.issued_at = inv.issued_at - timedelta(hours=12)  # 30.5 days elapsed
+    assert invoices.late_fee_for(inv.id) == Money.zero()
+
+
+def test_late_fee_unknown_invoice_raises():
+    with pytest.raises(DomainError) as err:
+        invoices.late_fee_for("INV-missing")
+    assert err.value.code == "E_NOT_FOUND"
