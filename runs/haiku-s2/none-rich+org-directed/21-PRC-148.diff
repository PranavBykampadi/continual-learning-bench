@@ -0,0 +1,36 @@
+"""Customer disputes raised against invoices."""
+
+from parcelo import clock, events, ids
+from parcelo.errors import DomainError
+from parcelo.models import Dispute
+from parcelo.store import db
+
+
+def open_dispute(invoice_id: str, reason: str) -> Dispute:
+    """Open a dispute against an existing invoice.
+
+    Args:
+        invoice_id: Id of the invoice being contested.
+        reason: Why the customer contests the invoice. Must not be blank.
+
+    Returns:
+        The newly created Dispute, which is also saved in the store.
+
+    Raises:
+        DomainError: With code E_NOT_FOUND if the invoice does not exist, or
+            E_BAD_INPUT if the reason is empty or only whitespace.
+    """
+    if invoice_id not in db.invoices:
+        raise DomainError("E_NOT_FOUND", invoice_id)
+    reason = (reason or "").strip()
+    if not reason:
+        raise DomainError("E_BAD_INPUT", "reason is required")
+    dispute = Dispute(
+        id=ids.new_id("dsp"),
+        invoice_id=invoice_id,
+        reason=reason,
+        opened_at=clock.now(),
+    )
+    db.disputes[dispute.id] = dispute
+    events.emit("dispute.opened", dispute.id, invoice_id=invoice_id)
+    return dispute
