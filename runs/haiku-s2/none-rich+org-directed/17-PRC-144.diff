+
+
+def insurance_fee(declared_value, zone) -> Money:
+    """Return the insurance fee for a shipment with a declared value.
+
+    The fee is 2% of the declared value plus the zone's fuel surcharge
+    percentage of the declared value, with a minimum fee of 1.00. The total
+    is rounded half up to the cent once.
+
+    Args:
+        declared_value: Declared value in dollars (float, int, str or Decimal).
+        zone: One of the zones in FUEL_SURCHARGE_PCT.
+
+    Returns:
+        Money: The insurance fee.
+
+    Raises:
+        ValueError: If the zone is unknown or the declared value is not positive.
+    """
+    if zone not in FUEL_SURCHARGE_PCT:
+        raise ValueError(f"unknown zone: {zone}")
+    value = Money.parse(declared_value)
+    if value.cents <= 0:
+        raise ValueError("declared value must be positive")
+    surcharge_pct = Decimal(str(FUEL_SURCHARGE_PCT[zone]))
+    factor = (INSURANCE_RATE_PCT + surcharge_pct) / 100
+    fee = value.scale(factor)
+    if fee < INSURANCE_MIN_FEE:
+        return INSURANCE_MIN_FEE
+    return fee
