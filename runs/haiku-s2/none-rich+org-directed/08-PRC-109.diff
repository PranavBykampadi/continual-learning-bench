diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_addresses.py b/tests/unit/test_addresses.py
--- a/tests/unit/test_addresses.py	1969-12-31 19:00:00
+++ b/tests/unit/test_addresses.py	2026-11-10 14:51:45
@@ -0,0 +1,48 @@
+import pytest
+
+from parcelo import audit, customers
+from parcelo.errors import DomainError
+from parcelo.store import db
+
+
+def test_add_address_stores_and_returns():
+    c = customers.add_customer("Acme")
+    a = customers.add_address(c.id, "12 Main St", "Springfield")
+    assert a.id.startswith("adr_")
+    assert a.customer_id == c.id
+    assert a.line == "12 Main St"
+    assert a.city == "Springfield"
+    assert db.addresses[a.id] is a
+
+
+def test_add_address_records_audit():
+    c = customers.add_customer("Acme")
+    a = customers.add_address(c.id, "12 Main St", "Springfield")
+    assert audit.LOG[-1]["action"] == "address.created"
+    assert audit.LOG[-1]["entity_id"] == a.id
+
+
+def test_add_address_unknown_customer():
+    with pytest.raises(DomainError) as err:
+        customers.add_address("nope", "12 Main St", "Springfield")
+    assert err.value.code == "E_UNKNOWN_CUSTOMER"
+    assert db.addresses == {}
+
+
+@pytest.mark.parametrize("line, city", [("", "Springfield"), ("   ", "Springfield"),
+                                        ("12 Main St", ""), ("12 Main St", "  ")])
+def test_add_address_empty_fields(line, city):
+    c = customers.add_customer("Acme")
+    with pytest.raises(DomainError) as err:
+        customers.add_address(c.id, line, city)
+    assert err.value.code == "E_BAD_INPUT"
+    assert db.addresses == {}
+
+
+def test_reset_clears_addresses():
+    from parcelo import store
+
+    c = customers.add_customer("Acme")
+    customers.add_address(c.id, "12 Main St", "Springfield")
+    store.reset()
+    assert db.addresses == {}
