diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_disputes.py b/tests/unit/test_disputes.py
--- a/tests/unit/test_disputes.py	1969-12-31 19:00:00
+++ b/tests/unit/test_disputes.py	2026-11-12 04:23:13
@@ -0,0 +1,49 @@
+from datetime import datetime, timezone
+
+import pytest
+
+from parcelo import clock, customers, disputes, events, invoices, shipments
+from parcelo.errors import DomainError
+from parcelo.store import db, reset
+
+
+def _invoice():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 2, "local")
+    return invoices.issue_invoice(s.id)
+
+
+def test_open_dispute():
+    inv = _invoice()
+    moment = datetime(2026, 11, 12, 9, 0, tzinfo=timezone.utc)
+    clock.set_fixed(moment)
+    d = disputes.open_dispute(inv.id, "charged twice")
+    assert d.id.startswith("dsp_")
+    assert d.invoice_id == inv.id
+    assert d.reason == "charged twice"
+    assert d.opened_at == moment
+    assert db.disputes[d.id] is d
+    assert events.OUTBOX[-1]["name"] == "dispute.opened"
+
+
+def test_unknown_invoice():
+    with pytest.raises(DomainError) as err:
+        disputes.open_dispute("nope", "wrong amount")
+    assert err.value.code == "E_NOT_FOUND"
+    assert db.disputes == {}
+
+
+@pytest.mark.parametrize("reason", ["", "   ", None])
+def test_empty_reason(reason):
+    inv = _invoice()
+    with pytest.raises(DomainError) as err:
+        disputes.open_dispute(inv.id, reason)
+    assert err.value.code == "E_BAD_INPUT"
+    assert db.disputes == {}
+
+
+def test_reset_clears_disputes():
+    inv = _invoice()
+    disputes.open_dispute(inv.id, "late")
+    reset()
+    assert db.disputes == {}
