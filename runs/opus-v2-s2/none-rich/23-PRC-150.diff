+def set_credit_limit(customer_id, amount):
+    """Set a customer's credit limit to ``amount`` and return the new limit."""
+    if customer_id not in db.customers:
+        raise DomainError("E_UNKNOWN_CUSTOMER", customer_id)
+    if (
+        isinstance(amount, bool)
+        or not isinstance(amount, numbers.Real)
+        or not math.isfinite(amount)
+    ):
+        raise DomainError("E_BAD_INPUT", f"credit limit must be a number, got {amount!r}")
+    if amount < 0:
+        raise DomainError("E_BAD_INPUT", f"credit limit must not be negative, got {amount}")
+    customer = db.customers[customer_id]
+    old_limit = customer.credit_limit
+    customer.credit_limit = round(float(amount), 2)
+    audit.record(
+        "customer.credit_limit_set",
+        customer_id,
+        old_limit=old_limit,
+        new_limit=customer.credit_limit,
+    )
+    events.emit("customer.credit_limit_changed", customer_id, credit_limit=customer.credit_limit)
+    return customer.credit_limit
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_customers.py b/tests/unit/test_customers.py
--- a/tests/unit/test_customers.py	1969-12-31 19:00:00
+++ b/tests/unit/test_customers.py	2026-11-12 04:24:26
@@ -0,0 +1,41 @@
+import pytest
+
+from parcelo import audit, customers, events
+from parcelo.errors import DomainError
+
+
+def test_set_credit_limit_updates_and_returns_new_limit():
+    c = customers.add_customer("Acme")
+    assert customers.set_credit_limit(c.id, 1200) == 1200.0
+    assert customers.get_customer(c.id).credit_limit == 1200.0
+    assert audit.LOG[-1]["details"] == {"old_limit": 500.0, "new_limit": 1200.0}
+    assert events.OUTBOX[-1]["name"] == "customer.credit_limit_changed"
+
+
+def test_set_credit_limit_zero_allowed():
+    c = customers.add_customer("Acme")
+    assert customers.set_credit_limit(c.id, 0) == 0.0
+
+
+def test_set_credit_limit_unknown_customer():
+    with pytest.raises(DomainError) as err:
+        customers.set_credit_limit("nope", 100)
+    assert err.value.code == "E_UNKNOWN_CUSTOMER"
+
+
+@pytest.mark.parametrize("amount", [-0.01, -100])
+def test_set_credit_limit_negative_rejected(amount):
+    c = customers.add_customer("Acme")
+    with pytest.raises(DomainError) as err:
+        customers.set_credit_limit(c.id, amount)
+    assert err.value.code == "E_BAD_INPUT"
+    assert customers.get_customer(c.id).credit_limit == 500.0
+    assert audit.LOG == []
+
+
+@pytest.mark.parametrize("amount", ["100", None, True, float("nan"), float("inf")])
+def test_set_credit_limit_non_numeric_rejected(amount):
+    c = customers.add_customer("Acme")
+    with pytest.raises(DomainError) as err:
+        customers.set_credit_limit(c.id, amount)
+    assert err.value.code == "E_BAD_INPUT"
