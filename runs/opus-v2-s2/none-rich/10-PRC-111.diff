+from parcelo import audit, clock, customers, shipments
 from parcelo.errors import DomainError
 
 
@@ -15,3 +17,36 @@
     with pytest.raises(DomainError) as err:
         shipments.create_shipment("nope", 1, "local")
     assert err.value.code == "E_UNKNOWN_CUSTOMER"
+
+
+def test_add_note_records_time():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 1.5, "national")
+    first = datetime(2026, 1, 1, tzinfo=timezone.utc)
+    second = datetime(2026, 1, 2, tzinfo=timezone.utc)
+    clock.set_fixed(first)
+    shipments.add_note(s.id, "left at door")
+    clock.set_fixed(second)
+    result = shipments.add_note(s.id, "customer called")
+    assert result is s
+    assert s.notes == [
+        {"text": "left at door", "at": first},
+        {"text": "customer called", "at": second},
+    ]
+    assert audit.LOG[-1]["action"] == "shipment.note_added"
+
+
+def test_add_note_unknown_shipment():
+    with pytest.raises(DomainError) as err:
+        shipments.add_note("shp_nope", "hello")
+    assert err.value.code == "E_NOT_FOUND"
+
+
+@pytest.mark.parametrize("text", ["", "   ", None])
+def test_add_note_empty_text(text):
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 1.5, "national")
+    with pytest.raises(DomainError) as err:
+        shipments.add_note(s.id, text)
+    assert err.value.code == "E_BAD_INPUT"
+    assert s.notes == []
