@@ -1,9 +1,58 @@
-from parcelo import customers, invoices, shipments
+from datetime import datetime, timezone
 
+import pytest
 
+from parcelo import audit, clock, customers, invoices, shipments
+from parcelo.errors import DomainError
+
+
 def test_issue_and_pay():
     c = customers.add_customer("Acme")
     s = shipments.create_shipment(c.id, 2, "local")
     inv = invoices.issue_invoice(s.id)
     assert inv.amount == 7.0
     assert invoices.mark_paid(inv.id).status == "paid"
+
+
+def _issue():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 2, "local")
+    return invoices.issue_invoice(s.id)
+
+
+def test_void_invoice():
+    moment = datetime(2026, 1, 2, 3, 4, 5, tzinfo=timezone.utc)
+    clock.set_fixed(moment)
+    inv = _issue()
+    voided = invoices.void_invoice(inv.id)
+    assert voided is inv
+    assert voided.status == "void"
+    assert voided.voided_at == moment
+    assert inv not in invoices.open_invoices()
+    assert audit.LOG[-1]["action"] == "invoice.voided"
+    assert audit.LOG[-1]["entity_id"] == inv.id
+
+
+def test_void_unknown_invoice_fails():
+    with pytest.raises(DomainError) as e:
+        invoices.void_invoice("INV-missing")
+    assert e.value.code == "E_NOT_FOUND"
+
+
+def test_void_paid_invoice_fails():
+    inv = _issue()
+    invoices.mark_paid(inv.id)
+    with pytest.raises(DomainError) as e:
+        invoices.void_invoice(inv.id)
+    assert e.value.code == "E_BAD_STATE"
+    assert inv.status == "paid"
+    assert inv.voided_at is None
+
+
+def test_void_already_void_invoice_fails():
+    inv = _issue()
+    first = invoices.void_invoice(inv.id).voided_at
+    with pytest.raises(DomainError) as e:
+        invoices.void_invoice(inv.id)
+    assert e.value.code == "E_BAD_STATE"
+    assert inv.voided_at == first
