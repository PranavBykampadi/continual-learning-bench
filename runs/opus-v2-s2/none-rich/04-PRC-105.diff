diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/parcelo/refunds.py b/parcelo/refunds.py
--- a/parcelo/refunds.py	1969-12-31 19:00:00
+++ b/parcelo/refunds.py	2026-11-12 04:13:08
@@ -0,0 +1,41 @@
+from parcelo import audit, clock, ids
+from parcelo.errors import DomainError
+from parcelo.models import Refund
+from parcelo.money import Money
+from parcelo.store import db
+
+
+def refunded_total(invoice_id):
+    """Total already refunded against an invoice, as Money."""
+    total = Money.zero()
+    for refund in db.refunds.values():
+        if refund.invoice_id == invoice_id:
+            total = total + Money.parse(refund.amount)
+    return total
+
+
+def create_refund(invoice_id, amount):
+    if invoice_id not in db.invoices:
+        raise DomainError("E_NOT_FOUND", invoice_id)
+    invoice = db.invoices[invoice_id]
+    if invoice.status != "paid":
+        raise DomainError("E_BAD_STATE", f"invoice {invoice_id} is {invoice.status}")
+    if isinstance(amount, bool) or not isinstance(amount, (int, float)):
+        raise DomainError("E_BAD_INPUT", f"amount must be a number: {amount!r}")
+    requested = Money.parse(amount)
+    if requested.cents <= 0:
+        raise DomainError("E_BAD_INPUT", f"amount must be positive: {amount}")
+    remaining = Money.parse(invoice.amount) - refunded_total(invoice_id)
+    if remaining < requested:
+        raise DomainError(
+            "E_LIMIT", f"refund {requested} exceeds refundable {remaining}"
+        )
+    refund = Refund(
+        id=ids.new_id("ref"),
+        invoice_id=invoice_id,
+        amount=amount,
+        created_at=clock.now(),
+    )
+    db.refunds[refund.id] = refund
+    audit.record("refund.created", refund.id, invoice_id=invoice_id, amount=amount)
+    return refund
