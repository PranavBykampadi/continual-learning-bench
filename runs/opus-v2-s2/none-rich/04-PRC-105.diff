diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_refunds.py b/tests/unit/test_refunds.py
--- a/tests/unit/test_refunds.py	1969-12-31 19:00:00
+++ b/tests/unit/test_refunds.py	2026-11-12 04:13:08
@@ -0,0 +1,69 @@
+from datetime import datetime, timezone
+
+import pytest
+
+from parcelo import audit, clock, customers, invoices, refunds, shipments, store
+from parcelo.errors import DomainError
+from parcelo.store import db
+
+
+def _invoice(paid=True):
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 2, "local")  # 7.00
+    inv = invoices.issue_invoice(s.id)
+    if paid:
+        invoices.mark_paid(inv.id)
+    return inv
+
+
+def test_create_refund_for_paid_invoice():
+    moment = datetime(2026, 1, 2, tzinfo=timezone.utc)
+    clock.set_fixed(moment)
+    inv = _invoice()
+    r = refunds.create_refund(inv.id, 3.5)
+    assert r.id.startswith("ref_")
+    assert r.invoice_id == inv.id
+    assert r.amount == 3.5
+    assert r.created_at == moment
+    assert db.refunds[r.id] is r
+    assert audit.LOG[-1]["action"] == "refund.created"
+
+
+def test_unknown_invoice_fails():
+    with pytest.raises(DomainError) as err:
+        refunds.create_refund("INV-nope", 1)
+    assert err.value.code == "E_NOT_FOUND"
+    assert db.refunds == {}
+
+
+def test_unpaid_invoice_fails():
+    inv = _invoice(paid=False)
+    with pytest.raises(DomainError) as err:
+        refunds.create_refund(inv.id, 1)
+    assert err.value.code == "E_BAD_STATE"
+    assert db.refunds == {}
+
+
+@pytest.mark.parametrize("amount", [0, -1, "5", None, True])
+def test_bad_amount_fails(amount):
+    inv = _invoice()
+    with pytest.raises(DomainError) as err:
+        refunds.create_refund(inv.id, amount)
+    assert err.value.code == "E_BAD_INPUT"
+
+
+def test_cannot_refund_more_than_paid():
+    inv = _invoice()
+    refunds.create_refund(inv.id, 4.0)
+    refunds.create_refund(inv.id, 3.0)  # exactly the full 7.00
+    with pytest.raises(DomainError) as err:
+        refunds.create_refund(inv.id, 0.01)
+    assert err.value.code == "E_LIMIT"
+    assert len(db.refunds) == 2
+
+
+def test_reset_clears_refunds():
+    inv = _invoice()
+    refunds.create_refund(inv.id, 1)
+    store.reset()
+    assert db.refunds == {}
