         rates.base_rate("moon")
+
+
+@pytest.mark.parametrize(
+    "weight, zone, expected",
+    [
+        (2, "local", 7.0),            # 7.00 + 0%
+        (2, "national", 11.96),       # 11.50 + 4% (0.46)
+        (2, "international", 29.02),  # 26.50 + 9.5% (2.52)
+    ],
+)
+def test_quote_with_surcharge(weight, zone, expected):
+    assert rates.quote_with_surcharge(weight, zone) == expected
+
+
+def test_quote_with_surcharge_unknown_zone():
+    with pytest.raises(ValueError):
+        rates.quote_with_surcharge(2, "moon")
+
+
+@pytest.mark.parametrize("weight", [0, -1])
+def test_quote_with_surcharge_rejects_non_positive_weight(weight):
+    with pytest.raises(ValueError):
+        rates.quote_with_surcharge(weight, "national")
