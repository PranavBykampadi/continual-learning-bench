--- a/tests/unit/test_customers.py	1969-12-31 19:00:00
+++ b/tests/unit/test_customers.py	2026-11-12 04:29:21
@@ -0,0 +1,28 @@
+import pytest
+
+from parcelo import customers
+from parcelo.errors import DomainError
+
+
+def test_new_customer_is_not_locked():
+    c = customers.add_customer("Acme")
+    assert c.locked is False
+
+
+def test_lock_customer():
+    c = customers.add_customer("Acme")
+    locked = customers.lock_customer(c.id)
+    assert locked is c
+    assert customers.get_customer(c.id).locked is True
+
+
+def test_lock_customer_is_idempotent():
+    c = customers.add_customer("Acme")
+    customers.lock_customer(c.id)
+    assert customers.lock_customer(c.id).locked is True
+
+
+def test_lock_unknown_customer():
+    with pytest.raises(DomainError) as err:
+        customers.lock_customer("nope")
+    assert err.value.code == "E_UNKNOWN_CUSTOMER"
