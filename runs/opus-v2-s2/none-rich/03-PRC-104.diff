diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_customers.py b/tests/unit/test_customers.py
--- a/tests/unit/test_customers.py	1969-12-31 19:00:00
+++ b/tests/unit/test_customers.py	2026-11-12 04:12:39
@@ -0,0 +1,31 @@
+import pytest
+
+from parcelo import audit, customers
+from parcelo.errors import DomainError
+
+
+def test_deactivate_customer():
+    c = customers.add_customer("Acme")
+    result = customers.deactivate_customer(c.id)
+    assert result is c
+    assert c.active is False
+    assert customers.get_customer(c.id).active is False
+    assert audit.LOG[-1]["action"] == "customer.deactivated"
+    assert audit.LOG[-1]["entity_id"] == c.id
+
+
+def test_deactivate_unknown_customer():
+    with pytest.raises(DomainError) as err:
+        customers.deactivate_customer("nope")
+    assert err.value.code == "E_UNKNOWN_CUSTOMER"
+
+
+def test_deactivate_already_inactive():
+    c = customers.add_customer("Acme")
+    customers.deactivate_customer(c.id)
+    n = len(audit.LOG)
+    with pytest.raises(DomainError) as err:
+        customers.deactivate_customer(c.id)
+    assert err.value.code == "E_BAD_STATE"
+    assert c.active is False
+    assert len(audit.LOG) == n
