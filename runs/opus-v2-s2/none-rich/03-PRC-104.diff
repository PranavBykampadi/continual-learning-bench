+def deactivate_customer(customer_id):
+    if customer_id not in db.customers:
+        raise DomainError("E_UNKNOWN_CUSTOMER", customer_id)
+    customer = db.customers[customer_id]
+    if not customer.active:
+        raise DomainError("E_BAD_STATE", f"customer {customer_id} is already inactive")
+    customer.active = False
+    audit.record("customer.deactivated", customer.id)
+    return customer
 
 
