+def outstanding_by_customer():
+    """Map every customer id to the total of that customer's open invoices.
+
+    Paid and void invoices are excluded. Customers with nothing open map to 0.0.
+    Amounts are summed in cents so the totals don't pick up float drift.
+    """
+    totals = {customer_id: Money.zero() for customer_id in db.customers}
+    for invoice in db.invoices.values():
+        if invoice.status != "open":
+            continue
+        customer_id = db.shipments[invoice.shipment_id].customer_id
+        totals[customer_id] = totals.get(customer_id, Money.zero()) + Money.parse(invoice.amount)
+    return {customer_id: total.cents / 100 for customer_id, total in totals.items()}
 
 
