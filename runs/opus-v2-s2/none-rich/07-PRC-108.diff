--- a/tests/test_reports.py	1969-12-31 19:00:00
+++ b/tests/test_reports.py	2026-11-12 04:15:04
@@ -0,0 +1,40 @@
+from parcelo import customers, invoices, reports, shipments
+
+
+def _invoice(customer_id, weight=2, zone="local"):
+    s = shipments.create_shipment(customer_id, weight, zone)
+    return invoices.issue_invoice(s.id)
+
+
+def test_outstanding_by_customer_sums_only_open_invoices():
+    acme = customers.add_customer("Acme")
+    globex = customers.add_customer("Globex")
+    idle = customers.add_customer("Idle")
+
+    a1 = _invoice(acme.id)
+    a2 = _invoice(acme.id)
+    a3 = _invoice(acme.id)
+    g1 = _invoice(globex.id)
+
+    invoices.mark_paid(a2.id)
+    a3.status = "void"
+
+    result = reports.outstanding_by_customer()
+
+    assert result == {
+        acme.id: a1.amount,
+        globex.id: g1.amount,
+        idle.id: 0.0,
+    }
+
+
+def test_outstanding_by_customer_avoids_float_drift():
+    acme = customers.add_customer("Acme")
+    for _ in range(3):
+        inv = _invoice(acme.id)
+        inv.amount = 0.1
+    assert reports.outstanding_by_customer()[acme.id] == 0.3
+
+
+def test_outstanding_by_customer_empty():
+    assert reports.outstanding_by_customer() == {}
