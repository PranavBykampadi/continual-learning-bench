+def _as_utc(moment):
+    # Invoices are issued with naive UTC timestamps; clock.now() is aware UTC.
+    if moment.tzinfo is None:
+        return moment.replace(tzinfo=timezone.utc)
+    return moment.astimezone(timezone.utc)
+
+
+def aging_report():
+    """Total open (unpaid) invoice amounts, bucketed by whole days since issue."""
+    today = _as_utc(clock.now())
+    totals = {"0-30": Money.zero(), "31-60": Money.zero(), "60+": Money.zero()}
+    for invoice in db.invoices.values():
+        if invoice.status != "open":
+            continue
+        # Pass `end` explicitly: days_between's default is naive local time.
+        age = days_between(_as_utc(invoice.issued_at), today)
+        if age <= 30:
+            bucket = "0-30"
+        elif age <= 60:
+            bucket = "31-60"
+        else:
+            bucket = "60+"
+        totals[bucket] = totals[bucket] + Money.parse(invoice.amount)
+    return {bucket: total.cents / 100 for bucket, total in totals.items()}
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/test_reports.py b/tests/test_reports.py
--- a/tests/test_reports.py	1969-12-31 19:00:00
+++ b/tests/test_reports.py	2026-11-12 04:19:06
@@ -0,0 +1,38 @@
+from datetime import datetime, timedelta, timezone
+
+from parcelo import clock, reports
+from parcelo.models import Invoice
+from parcelo.store import db
+
+NOW = datetime(2026, 11, 12, 12, 0, tzinfo=timezone.utc)
+
+
+def _add(inv_id, amount, age, status="open", naive=True):
+    issued = NOW - age
+    if naive:
+        issued = issued.replace(tzinfo=None)
+    db.invoices[inv_id] = Invoice(inv_id, "shp", amount, status=status, issued_at=issued)
+
+
+def test_aging_report_empty():
+    clock.set_fixed(NOW)
+    assert reports.aging_report() == {"0-30": 0, "31-60": 0, "60+": 0}
+
+
+def test_aging_report_buckets_and_boundaries():
+    clock.set_fixed(NOW)
+    _add("a", 10.10, timedelta(days=0))
+    _add("b", 20.20, timedelta(days=30))
+    _add("c", 5.00, timedelta(days=31), naive=False)
+    _add("d", 7.00, timedelta(days=60))
+    _add("e", 3.00, timedelta(days=61))
+    _add("f", 100.00, timedelta(days=5), status="paid")
+    _add("g", 100.00, timedelta(days=90), status="paid")
+    assert reports.aging_report() == {"0-30": 30.30, "31-60": 12.00, "60+": 3.00}
+
+
+def test_aging_report_partial_days_round_down():
+    clock.set_fixed(NOW)
+    _add("x", 1.00, timedelta(days=30, hours=23))
+    _add("y", 2.00, timedelta(days=60, hours=23))
+    assert reports.aging_report() == {"0-30": 1.00, "31-60": 2.00, "60+": 0}
