+def write_off(invoice_id):
+    """Write off an open invoice we will never collect; return the amount written off."""
+    if invoice_id not in db.invoices:
+        raise DomainError("E_NOT_FOUND", invoice_id)
+    invoice = db.invoices[invoice_id]
+    if invoice.status != "open":
+        raise DomainError("E_BAD_STATE", f"cannot write off {invoice.status} invoice {invoice_id}")
+    invoice.status = "written_off"
+    invoice.written_off_at = clock.now()
+    audit.record("invoice.written_off", invoice.id, amount=invoice.amount)
+    events.emit("invoice.written_off", invoice.id, amount=invoice.amount)
+    return invoice.amount
 
 
