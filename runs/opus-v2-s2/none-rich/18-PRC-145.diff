+def upgrade_tier(customer_id):
+    """Promote a standard customer to the gold tier."""
+    if customer_id not in db.customers:
+        raise DomainError("E_UNKNOWN_CUSTOMER", customer_id)
+    customer = db.customers[customer_id]
+    if customer.tier == "gold":
+        raise DomainError("E_BAD_STATE", f"{customer_id} is already gold")
+    previous = customer.tier
+    customer.tier = "gold"
+    events.emit("customer.tier_upgraded", customer.id, from_tier=previous, to_tier="gold")
+    return customer
 
 
