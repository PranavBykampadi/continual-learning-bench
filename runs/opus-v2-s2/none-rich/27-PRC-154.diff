diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/test_customers.py b/tests/test_customers.py
--- a/tests/test_customers.py	1969-12-31 19:00:00
+++ b/tests/test_customers.py	2026-11-12 04:25:44
@@ -0,0 +1,29 @@
+import pytest
+
+from parcelo import events
+from parcelo.customers import add_customer, get_customer, reactivate_customer
+from parcelo.errors import DomainError
+
+
+def test_reactivate_customer_sets_active():
+    customer = add_customer("Acme")
+    customer.active = False
+
+    result = reactivate_customer(customer.id)
+
+    assert result is customer
+    assert get_customer(customer.id).active is True
+    assert events.OUTBOX[-1]["name"] == "customer.reactivated"
+    assert events.OUTBOX[-1]["entity_id"] == customer.id
+
+
+def test_reactivate_already_active_customer_is_noop():
+    customer = add_customer("Acme")
+
+    assert reactivate_customer(customer.id).active is True
+
+
+def test_reactivate_unknown_customer_fails():
+    with pytest.raises(DomainError) as exc:
+        reactivate_customer("C-missing")
+    assert exc.value.code == "E_UNKNOWN_CUSTOMER"
