@@ -32,3 +36,23 @@
 
 def open_invoices():
     return [i for i in db.invoices.values() if i.status == "open"]
+
+
+LATE_AFTER_DAYS = 30
+LATE_FEE_DAILY_RATE = Decimal("0.015")
+
+
+def late_fee_for(invoice_id):
+    """Late fee accrued on an invoice: 1.5% of the amount per full day past 30 days from issue."""
+    if invoice_id not in db.invoices:
+        raise DomainError("E_NOT_FOUND", invoice_id)
+    invoice = db.invoices[invoice_id]
+    issued_at = invoice.issued_at
+    if issued_at.tzinfo is None:
+        # issue_invoice stores naive UTC timestamps; clock.now() is UTC-aware.
+        issued_at = issued_at.replace(tzinfo=timezone.utc)
+    days_late = (clock.now() - issued_at).days - LATE_AFTER_DAYS
+    if days_late <= 0:
+        return 0.0
+    fee = Money.parse(invoice.amount).scale(LATE_FEE_DAILY_RATE * days_late)
+    return fee.cents / 100
