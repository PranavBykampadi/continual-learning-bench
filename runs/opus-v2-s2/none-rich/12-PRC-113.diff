+def apply_credit(invoice_id, amount):
+    """Reduce an open invoice's amount by a credit; return the remaining amount.
+
+    The amount stays a float in dollars so reports and customer balances
+    keep working; the subtraction is done in cents to avoid float drift.
+    """
+    if invoice_id not in db.invoices:
+        raise DomainError("E_NOT_FOUND", invoice_id)
+    invoice = db.invoices[invoice_id]
+    if invoice.status != "open":
+        raise DomainError("E_BAD_STATE", f"invoice {invoice_id} is {invoice.status}")
+    if isinstance(amount, bool) or not isinstance(amount, (int, float, str, Decimal, Money)):
+        raise DomainError("E_BAD_INPUT", f"invalid credit {amount!r}")
+    try:
+        credit = Money.parse(amount)
+    except (ArithmeticError, ValueError):
+        raise DomainError("E_BAD_INPUT", f"invalid credit {amount!r}")
+    if credit.cents <= 0:
+        raise DomainError("E_BAD_INPUT", f"credit must be positive: {amount!r}")
+    current = Money.parse(invoice.amount)
+    if current < credit:
+        raise DomainError("E_LIMIT", f"credit {credit} exceeds invoice amount {current}")
+    remaining = current - credit
+    invoice.amount = remaining.cents / 100
+    audit.record("invoice.credited", invoice.id, credit=credit.cents / 100,
+                 remaining=invoice.amount)
+    return invoice.amount
