+
+import pytest
+
+from parcelo import reports
+from parcelo.errors import DomainError
+
+
+def _open_invoice(weight=2, zone="local"):
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, weight, zone)
+    return c, invoices.issue_invoice(s.id)
+
+
+def test_apply_credit_reduces_amount():
+    c, inv = _open_invoice()  # 7.00
+    assert invoices.apply_credit(inv.id, 2.5) == 4.5
+    assert inv.amount == 4.5
+    assert customers.outstanding_balance(c.id) == 4.5
+    invoices.mark_paid(inv.id)
+    assert reports.revenue_total() == 4.5
+
+
+def test_apply_credit_exact_cents():
+    _, inv = _open_invoice(weight=1.2, zone="national")  # 10.50
+    assert invoices.apply_credit(inv.id, 0.1) == 10.4
+    assert invoices.apply_credit(inv.id, 10.4) == 0.0
+
+
+def test_apply_credit_unknown_invoice():
+    with pytest.raises(DomainError) as err:
+        invoices.apply_credit("INV-nope", 1)
+    assert err.value.code == "E_NOT_FOUND"
+
+
+def test_apply_credit_paid_invoice():
+    _, inv = _open_invoice()
+    invoices.mark_paid(inv.id)
+    with pytest.raises(DomainError) as err:
+        invoices.apply_credit(inv.id, 1)
+    assert err.value.code == "E_BAD_STATE"
+    assert inv.amount == 7.0
+
+
+def test_apply_credit_larger_than_amount():
+    _, inv = _open_invoice()
+    with pytest.raises(DomainError) as err:
+        invoices.apply_credit(inv.id, 7.01)
+    assert err.value.code == "E_LIMIT"
+    assert inv.amount == 7.0
+
+
+@pytest.mark.parametrize("bad", [0, -1, "abc", None, True, float("nan")])
+def test_apply_credit_rejects_bad_amount(bad):
+    _, inv = _open_invoice()
+    with pytest.raises(DomainError) as err:
+        invoices.apply_credit(inv.id, bad)
+    assert err.value.code == "E_BAD_INPUT"
+    assert inv.amount == 7.0
