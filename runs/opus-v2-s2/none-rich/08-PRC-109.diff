diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_addresses.py b/tests/unit/test_addresses.py
--- a/tests/unit/test_addresses.py	1969-12-31 19:00:00
+++ b/tests/unit/test_addresses.py	2026-11-12 04:15:38
@@ -0,0 +1,41 @@
+import pytest
+
+from parcelo import store
+from parcelo.customers import add_address, add_customer
+from parcelo.errors import DomainError
+from parcelo.store import db
+
+
+def test_add_address_stores_and_returns():
+    c = add_customer("Ada")
+    a = add_address(c.id, "1 Main St", "Springfield")
+    assert a.id
+    assert a.customer_id == c.id
+    assert a.line == "1 Main St"
+    assert a.city == "Springfield"
+    assert db.addresses[a.id] is a
+
+
+def test_unknown_customer_fails():
+    with pytest.raises(DomainError) as e:
+        add_address("nope", "1 Main St", "Springfield")
+    assert e.value.code == "E_UNKNOWN_CUSTOMER"
+    assert db.addresses == {}
+
+
+@pytest.mark.parametrize(
+    "line,city", [("", "X"), ("1 Main", ""), ("   ", "X"), ("1 Main", "  "), (None, "X")]
+)
+def test_empty_line_or_city_fails(line, city):
+    c = add_customer("Ada")
+    with pytest.raises(DomainError) as e:
+        add_address(c.id, line, city)
+    assert e.value.code == "E_BAD_INPUT"
+    assert db.addresses == {}
+
+
+def test_reset_clears_addresses():
+    c = add_customer("Ada")
+    add_address(c.id, "1 Main St", "Springfield")
+    store.reset()
+    assert db.addresses == {}
