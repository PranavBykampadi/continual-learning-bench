+def needs_review(customer_id):
+    """True if the customer has more than 3 open invoices or owes over 250.00."""
+    if customer_id not in db.customers:
+        raise DomainError("E_UNKNOWN_CUSTOMER", customer_id)
+    open_count = sum(
+        1
+        for invoice in db.invoices.values()
+        if invoice.status == "open"
+        and db.shipments[invoice.shipment_id].customer_id == customer_id
+    )
+    if open_count > REVIEW_MAX_OPEN_INVOICES:
+        return True
+    return REVIEW_BALANCE_LIMIT < Money.parse(outstanding_balance(customer_id))
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_customers.py b/tests/unit/test_customers.py
--- a/tests/unit/test_customers.py	1969-12-31 19:00:00
+++ b/tests/unit/test_customers.py	2026-11-12 04:25:23
@@ -0,0 +1,57 @@
+import pytest
+
+from parcelo import customers
+from parcelo.errors import DomainError
+from parcelo.models import Invoice, Shipment
+from parcelo.store import db
+
+
+def _invoice(customer_id, amount, status="open"):
+    n = len(db.invoices)
+    sid = f"shp_t{n}"
+    db.shipments[sid] = Shipment(id=sid, customer_id=customer_id, weight_kg=1, zone="local")
+    db.invoices[f"INV-t{n}"] = Invoice(id=f"INV-t{n}", shipment_id=sid, amount=amount, status=status)
+
+
+def test_no_invoices():
+    c = customers.add_customer("Acme")
+    assert customers.needs_review(c.id) is False
+
+
+def test_three_open_invoices_is_fine_four_is_not():
+    c = customers.add_customer("Acme")
+    for _ in range(3):
+        _invoice(c.id, 10.0)
+    assert customers.needs_review(c.id) is False
+    _invoice(c.id, 10.0)
+    assert customers.needs_review(c.id) is True
+
+
+def test_paid_invoices_ignored():
+    c = customers.add_customer("Acme")
+    for _ in range(5):
+        _invoice(c.id, 100.0, status="paid")
+    assert customers.needs_review(c.id) is False
+
+
+def test_balance_threshold():
+    c = customers.add_customer("Acme")
+    _invoice(c.id, 150.0)
+    _invoice(c.id, 100.0)
+    assert customers.needs_review(c.id) is False  # exactly 250.00
+    _invoice(c.id, 0.01)
+    assert customers.needs_review(c.id) is True
+
+
+def test_other_customers_invoices_ignored():
+    a = customers.add_customer("A")
+    b = customers.add_customer("B")
+    _invoice(b.id, 500.0)
+    assert customers.needs_review(a.id) is False
+    assert customers.needs_review(b.id) is True
+
+
+def test_unknown_customer():
+    with pytest.raises(DomainError) as err:
+        customers.needs_review("nope")
+    assert err.value.code == "E_UNKNOWN_CUSTOMER"
