--- a/tests/test_reports.py	1969-12-31 19:00:00
+++ b/tests/test_reports.py	2026-11-12 04:22:45
@@ -0,0 +1,29 @@
+from parcelo import customers, reports, shipments
+
+
+def test_volume_report_counts_and_tiers():
+    a = customers.add_customer("Acme")
+    b = customers.add_customer("Beta")
+    idle = customers.add_customer("Idle")
+    for _ in range(10):
+        shipments.create_shipment(a.id, 1, "local")
+    shipments.create_shipment(b.id, 1, "local")
+
+    report = reports.volume_report()
+
+    assert report == {
+        a.id: {"shipments": 10, "tier": "regular"},
+        b.id: {"shipments": 1, "tier": "starter"},
+        idle.id: {"shipments": 0, "tier": "starter"},
+    }
+
+
+def test_volume_report_bulk_threshold():
+    c = customers.add_customer("Big")
+    for _ in range(50):
+        shipments.create_shipment(c.id, 1, "local")
+    assert reports.volume_report()[c.id] == {"shipments": 50, "tier": "bulk"}
+
+
+def test_volume_report_empty():
+    assert reports.volume_report() == {}
