+def upgrade_tier(customer_id):
+    """Move a standard customer to the gold tier.
+
+    Raises DomainError E_UNKNOWN_CUSTOMER if the customer does not exist and
+    E_BAD_STATE if the customer is already gold.
+    """
+    customer = db.customers.get(customer_id)
+    if customer is None:
+        raise DomainError("E_UNKNOWN_CUSTOMER", customer_id)
+    if customer.tier == "gold":
+        raise DomainError("E_BAD_STATE", f"customer {customer_id} is already gold")
+    previous = customer.tier
+    customer.tier = "gold"
+    events.emit("customer.tier_upgraded", customer.id, previous_tier=previous, tier="gold")
+    return customer
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_customers_upgrade.py b/tests/unit/test_customers_upgrade.py
--- a/tests/unit/test_customers_upgrade.py	1969-12-31 19:00:00
+++ b/tests/unit/test_customers_upgrade.py	2026-11-12 04:21:55
@@ -0,0 +1,29 @@
+import pytest
+
+from parcelo import customers, events
+from parcelo.errors import DomainError
+
+
+def test_upgrade_standard_to_gold():
+    c = customers.add_customer("Acme")
+    result = customers.upgrade_tier(c.id)
+    assert result is c
+    assert customers.get_customer(c.id).tier == "gold"
+    assert events.OUTBOX[-1]["name"] == "customer.tier_upgraded"
+    assert events.OUTBOX[-1]["entity_id"] == c.id
+
+
+def test_upgrade_unknown_customer_fails():
+    with pytest.raises(DomainError) as err:
+        customers.upgrade_tier("nope")
+    assert err.value.code == "E_UNKNOWN_CUSTOMER"
+    assert events.OUTBOX == []
+
+
+def test_upgrade_already_gold_fails_without_event():
+    c = customers.add_customer("Acme", tier="gold")
+    with pytest.raises(DomainError) as err:
+        customers.upgrade_tier(c.id)
+    assert err.value.code == "E_BAD_STATE"
+    assert c.tier == "gold"
+    assert events.OUTBOX == []
