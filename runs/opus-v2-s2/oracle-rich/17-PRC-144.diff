+def insurance_fee(declared_value, zone):
+    """Insurance fee for a shipment with a declared value, as Money.
+
+    The fee is INSURANCE_RATE_PCT plus the zone's fuel surcharge percentage
+    of the declared value, with a minimum of INSURANCE_MIN_FEE.
+    `declared_value` may be Money or a dollar amount from older float code.
+    """
+    if zone not in FUEL_SURCHARGE_PCT:
+        raise DomainError("E_BAD_ZONE", "unknown zone: %s" % zone)
+    try:
+        value = Money.parse(declared_value)
+    except (InvalidOperation, TypeError, ValueError):
+        raise DomainError("E_BAD_INPUT", "invalid declared value: %r" % (declared_value,))
+    if value.cents <= 0:
+        raise DomainError("E_BAD_INPUT", "declared value must be positive")
+    pct = INSURANCE_RATE_PCT + FUEL_SURCHARGE_PCT[zone]
+    fee = value.scale(pct / Decimal(100))
+    minimum = Money.parse(INSURANCE_MIN_FEE)
+    return minimum if fee < minimum else fee
