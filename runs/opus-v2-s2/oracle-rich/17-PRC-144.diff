+++ b/parcelo/settings.py	2026-11-12 04:21:09
@@ -0,0 +1,13 @@
+"""Business thresholds, limits and rates."""
+from decimal import Decimal
+
+# Insurance (PRC-144): percentage of the declared value, and minimum fee in dollars.
+INSURANCE_RATE_PCT = Decimal("2")
+INSURANCE_MIN_FEE = "1.00"
+
+# Fuel surcharge percentage per zone (same values as legacy billing.fuel_surcharge).
+FUEL_SURCHARGE_PCT = {
+    "local": Decimal("0.0"),
+    "national": Decimal("4.0"),
+    "international": Decimal("9.5"),
+}
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_insurance_fee.py b/tests/unit/test_insurance_fee.py
--- a/tests/unit/test_insurance_fee.py	1969-12-31 19:00:00
+++ b/tests/unit/test_insurance_fee.py	2026-11-12 04:21:19
@@ -0,0 +1,40 @@
+import pytest
+
+from parcelo import rates
+from parcelo.errors import DomainError
+from parcelo.money import Money
+
+
+def test_local_fee_is_two_percent():
+    assert rates.insurance_fee(Money.parse(200), "local") == Money(400)
+
+
+def test_national_includes_fuel_surcharge():
+    # 2% + 4% of 100.00 = 6.00
+    assert rates.insurance_fee(Money.parse(100), "national") == Money(600)
+
+
+def test_international_includes_fuel_surcharge():
+    # 2% + 9.5% of 100.00 = 11.50
+    assert rates.insurance_fee(Money.parse(100), "international") == Money(1150)
+
+
+def test_accepts_float_from_older_code():
+    assert rates.insurance_fee(100.0, "national") == Money(600)
+
+
+def test_minimum_fee():
+    assert rates.insurance_fee(Money.parse(10), "local") == Money(100)
+
+
+def test_unknown_zone():
+    with pytest.raises(DomainError) as err:
+        rates.insurance_fee(Money.parse(100), "mars")
+    assert err.value.code == "E_BAD_ZONE"
+
+
+@pytest.mark.parametrize("value", [0, -5, Money(0), Money(-100)])
+def test_non_positive_value(value):
+    with pytest.raises(DomainError) as err:
+        rates.insurance_fee(value, "local")
+    assert err.value.code == "E_BAD_INPUT"
