diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_shipment_notes.py b/tests/unit/test_shipment_notes.py
--- a/tests/unit/test_shipment_notes.py	1969-12-31 19:00:00
+++ b/tests/unit/test_shipment_notes.py	2026-11-12 04:16:11
@@ -0,0 +1,49 @@
+from datetime import datetime, timedelta, timezone
+
+import pytest
+
+from parcelo import audit, clock, customers, shipments
+from parcelo.errors import DomainError
+
+
+def _shipment():
+    c = customers.add_customer("Acme")
+    return shipments.create_shipment(c.id, 1.0, "local")
+
+
+def test_add_note_appends_text_and_time():
+    s = _shipment()
+    t1 = datetime(2026, 11, 12, 9, 0, tzinfo=timezone.utc)
+    clock.set_fixed(t1)
+    result = shipments.add_note(s.id, "customer called")
+    t2 = t1 + timedelta(hours=2)
+    clock.set_fixed(t2)
+    shipments.add_note(s.id, "left at door")
+
+    assert result is s
+    assert shipments.get_shipment(s.id).notes == [
+        {"text": "customer called", "at": t1},
+        {"text": "left at door", "at": t2},
+    ]
+
+
+def test_add_note_records_audit():
+    s = _shipment()
+    shipments.add_note(s.id, "hello")
+    assert audit.LOG[-1]["action"] == "shipment.note_added"
+    assert audit.LOG[-1]["entity_id"] == s.id
+
+
+def test_add_note_unknown_shipment():
+    with pytest.raises(DomainError) as err:
+        shipments.add_note("shp_missing", "hi")
+    assert err.value.code == "E_NOT_FOUND"
+
+
+@pytest.mark.parametrize("text", ["", "   ", None])
+def test_add_note_empty_text(text):
+    s = _shipment()
+    with pytest.raises(DomainError) as err:
+        shipments.add_note(s.id, text)
+    assert err.value.code == "E_BAD_INPUT"
+    assert s.notes == []
