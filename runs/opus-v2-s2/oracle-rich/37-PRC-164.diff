diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/parcelo/vouchers.py b/parcelo/vouchers.py
--- a/parcelo/vouchers.py	1969-12-31 19:00:00
+++ b/parcelo/vouchers.py	2026-11-12 04:32:12
@@ -0,0 +1,39 @@
+from decimal import InvalidOperation
+
+from parcelo import clock, events, ids
+from parcelo.errors import DomainError
+from parcelo.models import Voucher
+from parcelo.money import Money
+from parcelo.settings import MAX_VOUCHER_AMOUNT
+from parcelo.store import db
+
+
+def _to_money(amount):
+    if isinstance(amount, bool):
+        raise DomainError("E_BAD_INPUT", f"invalid amount {amount!r}")
+    try:
+        return Money.parse(amount)
+    except (InvalidOperation, TypeError, ValueError):
+        raise DomainError("E_BAD_INPUT", f"invalid amount {amount!r}") from None
+
+
+def issue_voucher(customer_id, amount):
+    """Issue a goodwill voucher worth `amount` (Money or dollar value) to a customer."""
+    if customer_id not in db.customers:
+        raise DomainError("E_UNKNOWN_CUSTOMER", customer_id)
+    money = _to_money(amount)
+    if money.currency != MAX_VOUCHER_AMOUNT.currency:
+        raise DomainError("E_BAD_INPUT", f"unsupported currency {money.currency}")
+    if money.cents <= 0:
+        raise DomainError("E_BAD_INPUT", f"voucher amount must be positive, got {money}")
+    if MAX_VOUCHER_AMOUNT < money:
+        raise DomainError("E_LIMIT", f"voucher amount {money} exceeds {MAX_VOUCHER_AMOUNT}")
+    voucher = Voucher(
+        id=ids.new_id("vch"),
+        customer_id=customer_id,
+        amount=money,
+        issued_at=clock.now(),
+    )
+    db.vouchers[voucher.id] = voucher
+    events.emit("voucher.issued", voucher.id, customer_id=customer_id, amount_cents=money.cents)
+    return voucher
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_vouchers.py b/tests/unit/test_vouchers.py
--- a/tests/unit/test_vouchers.py	1969-12-31 19:00:00
+++ b/tests/unit/test_vouchers.py	2026-11-12 04:32:19
@@ -0,0 +1,72 @@
+from datetime import datetime, timezone
+
+import pytest
+
+from parcelo import clock, customers, events, store, vouchers
+from parcelo.errors import DomainError
+from parcelo.money import Money
+
+
+def test_issue_voucher_saves_and_emits():
+    moment = datetime(2026, 11, 12, 9, 0, tzinfo=timezone.utc)
+    clock.set_fixed(moment)
+    c = customers.add_customer("Acme")
+    v = vouchers.issue_voucher(c.id, Money.parse("25.50"))
+    assert v.id.startswith("vch_")
+    assert v.customer_id == c.id
+    assert v.amount == Money(2550)
+    assert v.issued_at == moment
+    assert store.db.vouchers[v.id] is v
+    assert events.OUTBOX[-1]["name"] == "voucher.issued"
+    assert events.OUTBOX[-1]["entity_id"] == v.id
+
+
+def test_float_amount_is_converted_to_money():
+    c = customers.add_customer("Acme")
+    v = vouchers.issue_voucher(c.id, 10.1)
+    assert v.amount == Money(1010)
+
+
+def test_exactly_max_is_allowed():
+    c = customers.add_customer("Acme")
+    assert vouchers.issue_voucher(c.id, Money(15000)).amount == Money(15000)
+
+
+def test_over_max_fails():
+    c = customers.add_customer("Acme")
+    with pytest.raises(DomainError) as err:
+        vouchers.issue_voucher(c.id, Money(15001))
+    assert err.value.code == "E_LIMIT"
+    assert store.db.vouchers == {}
+    assert not [e for e in events.OUTBOX if e["name"] == "voucher.issued"]
+
+
+@pytest.mark.parametrize("amount", [Money(0), Money(-100), 0, -5.0])
+def test_zero_or_negative_fails(amount):
+    c = customers.add_customer("Acme")
+    with pytest.raises(DomainError) as err:
+        vouchers.issue_voucher(c.id, amount)
+    assert err.value.code == "E_BAD_INPUT"
+    assert store.db.vouchers == {}
+
+
+@pytest.mark.parametrize("amount", ["abc", None, True])
+def test_invalid_amount_fails(amount):
+    c = customers.add_customer("Acme")
+    with pytest.raises(DomainError) as err:
+        vouchers.issue_voucher(c.id, amount)
+    assert err.value.code == "E_BAD_INPUT"
+
+
