@@ -0,0 +1,76 @@
+from datetime import datetime, timezone
+
+import pytest
+
+from parcelo import clock, customers, events, returns, shipments, store
+from parcelo.errors import DomainError
+from parcelo.settings import MAX_RETURNS_PER_SHIPMENT
+from parcelo.store import db
+
+
+def _shipment(status="delivered"):
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 1.0, "national")
+    s.status = status
+    return s
+
+
+def test_request_return_creates_and_stores():
+    moment = datetime(2026, 11, 12, 9, 0, tzinfo=timezone.utc)
+    clock.set_fixed(moment)
+    s = _shipment()
+    r = returns.request_return(s.id, "damaged")
+    assert r.id.startswith("ret_")
+    assert r.shipment_id == s.id
+    assert r.reason == "damaged"
+    assert r.requested_at == moment
+    assert db.returns[r.id] is r
+    assert events.OUTBOX[-1]["name"] == "return.requested"
+    assert events.OUTBOX[-1]["entity_id"] == r.id
+
+
+def test_unknown_shipment_fails():
+    with pytest.raises(DomainError) as err:
+        returns.request_return("shp_missing", "x")
+    assert err.value.code == "E_NOT_FOUND"
+
+
+def test_not_delivered_fails():
+    s = _shipment(status="created")
+    with pytest.raises(DomainError) as err:
+        returns.request_return(s.id, "x")
+    assert err.value.code == "E_BAD_STATE"
+    assert db.returns == {}
+
+
+def test_fourth_request_fails():
+    s = _shipment()
+    for i in range(MAX_RETURNS_PER_SHIPMENT):
+        returns.request_return(s.id, f"r{i}")
+    emitted = len(events.OUTBOX)
+    with pytest.raises(DomainError) as err:
+        returns.request_return(s.id, "one too many")
+    assert err.value.code == "E_LIMIT"
+    assert len(returns.returns_for(s.id)) == MAX_RETURNS_PER_SHIPMENT
+    assert len(events.OUTBOX) == emitted
+
+
+def test_returns_for_filters_and_sorts_by_id():
+    a = _shipment()
+    b = _shipment()
+    r1 = returns.request_return(a.id, "one")
+    returns.request_return(b.id, "other")
+    r2 = returns.request_return(a.id, "two")
+    # scramble storage order
+    items = list(db.returns.items())
+    db.returns.clear()
+    db.returns.update(reversed(items))
+    assert [r.id for r in returns.returns_for(a.id)] == sorted([r1.id, r2.id])
+    assert returns.returns_for("shp_none") == []
+
+
