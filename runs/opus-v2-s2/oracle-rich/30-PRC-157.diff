 def open_invoices():
     return [i for i in db.invoices.values() if i.status == "open"]
+
+
+def hold_invoice(invoice_id):
+    """Put an open invoice on hold. Idempotent for invoices already on hold."""
+    invoice = db.invoices.get(invoice_id)
+    if invoice is None:
+        raise DomainError("E_NOT_FOUND", f"invoice {invoice_id} not found")
+    if invoice.status == "on_hold":
+        return invoice
+    if invoice.status != "open":
+        raise DomainError(
+            "E_BAD_STATE", f"invoice {invoice_id} is {invoice.status}, only open invoices can be held"
+        )
+    invoice.status = "on_hold"
+    invoice.held_at = clock.now()
+    events.emit("invoice.held", invoice.id)
+    return invoice
