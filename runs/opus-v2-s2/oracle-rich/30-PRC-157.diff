diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_hold_invoice.py b/tests/unit/test_hold_invoice.py
--- a/tests/unit/test_hold_invoice.py	1969-12-31 19:00:00
+++ b/tests/unit/test_hold_invoice.py	2026-11-12 04:28:27
@@ -0,0 +1,54 @@
+from datetime import datetime, timezone
+
+import pytest
+
+from parcelo import clock, events, invoices
+from parcelo.errors import DomainError
+from parcelo.models import Invoice
+from parcelo.store import db
+
+MOMENT = datetime(2026, 11, 12, 9, 30, tzinfo=timezone.utc)
+
+
+def _invoice(status="open"):
+    inv = Invoice(id="inv_1", shipment_id="shp_1", amount=10.0, status=status)
+    db.invoices[inv.id] = inv
+    return inv
+
+
+def test_hold_open_invoice():
+    clock.set_fixed(MOMENT)
+    _invoice()
+    inv = invoices.hold_invoice("inv_1")
+    assert inv.status == "on_hold"
+    assert inv.held_at == MOMENT
+    assert db.invoices["inv_1"] is inv
+    assert events.OUTBOX[-1]["name"] == "invoice.held"
+    assert events.OUTBOX[-1]["entity_id"] == "inv_1"
+
+
+def test_hold_is_idempotent():
+    clock.set_fixed(MOMENT)
+    _invoice()
+    invoices.hold_invoice("inv_1")
+    clock.set_fixed(datetime(2026, 11, 13, tzinfo=timezone.utc))
+    inv = invoices.hold_invoice("inv_1")
+    assert inv.status == "on_hold"
+    assert inv.held_at == MOMENT
+    assert len(events.OUTBOX) == 1
+
+
+def test_hold_missing_invoice():
+    with pytest.raises(DomainError) as err:
+        invoices.hold_invoice("nope")
+    assert err.value.code == "E_NOT_FOUND"
+
+
+def test_hold_paid_invoice_fails():
+    inv = _invoice(status="paid")
+    with pytest.raises(DomainError) as err:
+        invoices.hold_invoice("inv_1")
+    assert err.value.code == "E_BAD_STATE"
+    assert inv.status == "paid"
+    assert inv.held_at is None
+    assert events.OUTBOX == []
