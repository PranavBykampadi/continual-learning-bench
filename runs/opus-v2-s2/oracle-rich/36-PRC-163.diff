+def lock_customer(customer_id):
+    """Lock a customer account. Idempotent: an already locked customer is returned unchanged."""
+    customer = db.customers.get(customer_id)
+    if customer is None:
+        raise DomainError("E_UNKNOWN_CUSTOMER", customer_id)
+    if customer.locked:
+        return customer
+    customer.locked = True
+    events.emit("customer.locked", customer.id)
+    return customer
