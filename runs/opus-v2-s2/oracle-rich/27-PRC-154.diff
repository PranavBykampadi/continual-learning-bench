+def reactivate_customer(customer_id):
+    customer = db.customers.get(customer_id)
+    if customer is None:
+        raise DomainError("E_UNKNOWN_CUSTOMER", customer_id)
+    if customer.active:
+        return customer
+    customer.active = True
+    events.emit("customer.reactivated", customer.id)
+    return customer
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_customers_reactivate.py b/tests/unit/test_customers_reactivate.py
--- a/tests/unit/test_customers_reactivate.py	1969-12-31 19:00:00
+++ b/tests/unit/test_customers_reactivate.py	2026-11-12 04:27:13
@@ -0,0 +1,28 @@
+import pytest
+
+from parcelo import customers, events
+from parcelo.errors import DomainError
+
+
+def test_reactivate_sets_active_and_emits():
+    c = customers.add_customer("Acme")
+    c.active = False
+    result = customers.reactivate_customer(c.id)
+    assert result is c
+    assert c.active is True
+    assert events.OUTBOX[-1]["name"] == "customer.reactivated"
+    assert events.OUTBOX[-1]["entity_id"] == c.id
+
+
+def test_reactivate_already_active_is_noop():
+    c = customers.add_customer("Acme")
+    before = len(events.OUTBOX)
+    assert customers.reactivate_customer(c.id) is c
+    assert c.active is True
+    assert len(events.OUTBOX) == before
+
+
+def test_reactivate_unknown_customer():
+    with pytest.raises(DomainError) as err:
+        customers.reactivate_customer("nope")
+    assert err.value.code == "E_UNKNOWN_CUSTOMER"
