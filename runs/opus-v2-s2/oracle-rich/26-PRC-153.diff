@@ -0,0 +1,7 @@
+"""Business thresholds, limits and rates."""
+
+from parcelo.money import Money
+
+# A customer needs a manual review above either of these.
+REVIEW_MAX_OPEN_INVOICES = 3
+REVIEW_MAX_OPEN_BALANCE = Money(25000)
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_customers_review.py b/tests/unit/test_customers_review.py
--- a/tests/unit/test_customers_review.py	1969-12-31 19:00:00
+++ b/tests/unit/test_customers_review.py	2026-11-12 04:26:55
@@ -0,0 +1,68 @@
+import pytest
+
+from parcelo import customers, shipments
+from parcelo.errors import DomainError
+from parcelo.models import Invoice
+from parcelo.store import db
+
+
+def _invoice(customer_id, amount, status="open"):
+    s = shipments.create_shipment(customer_id, 1, "local")
+    inv = Invoice(id=f"inv_{len(db.invoices)}", shipment_id=s.id, amount=amount, status=status)
+    db.invoices[inv.id] = inv
+    return inv
+
+
+def test_no_invoices_is_false():
+    c = customers.add_customer("Acme")
+    assert customers.needs_review(c.id) is False
+
+
+def test_three_open_invoices_is_false():
+    c = customers.add_customer("Acme")
+    for _ in range(3):
+        _invoice(c.id, 10.0)
+    assert customers.needs_review(c.id) is False
+
+
+def test_four_open_invoices_is_true():
+    c = customers.add_customer("Acme")
+    for _ in range(4):
+        _invoice(c.id, 10.0)
+    assert customers.needs_review(c.id) is True
+
+
+def test_paid_invoices_not_counted():
+    c = customers.add_customer("Acme")
+    for _ in range(3):
+        _invoice(c.id, 10.0)
+    _invoice(c.id, 500.0, status="paid")
+    assert customers.needs_review(c.id) is False
+
+
+def test_balance_exactly_250_is_false():
+    c = customers.add_customer("Acme")
+    _invoice(c.id, 200.0)
+    _invoice(c.id, 50.0)
+    assert customers.needs_review(c.id) is False
+
+
+def test_balance_over_250_is_true():
+    c = customers.add_customer("Acme")
+    _invoice(c.id, 200.0)
+    _invoice(c.id, 50.01)
+    assert customers.needs_review(c.id) is True
+
+
+def test_other_customers_invoices_ignored():
+    c = customers.add_customer("Acme")
+    other = customers.add_customer("Other")
+    for _ in range(5):
+        _invoice(other.id, 100.0)
+    assert customers.needs_review(c.id) is False
+
+
+def test_unknown_customer_fails():
+    with pytest.raises(DomainError) as err:
+        customers.needs_review("nope")
+    assert err.value.code == "E_UNKNOWN_CUSTOMER"
