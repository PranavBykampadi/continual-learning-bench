diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_customers_rebate.py b/tests/unit/test_customers_rebate.py
--- a/tests/unit/test_customers_rebate.py	1969-12-31 19:00:00
+++ b/tests/unit/test_customers_rebate.py	2026-11-12 04:31:04
@@ -0,0 +1,55 @@
+import pytest
+
+from parcelo import customers
+from parcelo.errors import DomainError
+from parcelo.models import Invoice, Shipment
+from parcelo.money import Money
+from parcelo.store import db
+
+
+def _add_shipments(customer_id, count, paid_amount=None, open_amount=None):
+    for i in range(count):
+        sid = f"shp_{customer_id}_{i}"
+        db.shipments[sid] = Shipment(id=sid, customer_id=customer_id, weight_kg=1.0, zone="local")
+        if paid_amount is not None:
+            db.invoices[f"inv_p_{sid}"] = Invoice(
+                id=f"inv_p_{sid}", shipment_id=sid, amount=paid_amount, status="paid"
+            )
+        if open_amount is not None:
+            db.invoices[f"inv_o_{sid}"] = Invoice(
+                id=f"inv_o_{sid}", shipment_id=sid, amount=open_amount, status="open"
+            )
+
+
+def test_unknown_customer_fails():
+    with pytest.raises(DomainError) as err:
+        customers.rebate_for("nope")
+    assert err.value.code == "E_UNKNOWN_CUSTOMER"
+
+
+def test_below_threshold_is_zero():
+    c = customers.add_customer("Acme")
+    _add_shipments(c.id, 9, paid_amount=100.0)
+    assert customers.rebate_for(c.id) == Money.zero()
+
+
+def test_regular_tier_three_percent_of_paid_only():
+    c = customers.add_customer("Acme")
+    _add_shipments(c.id, 10, paid_amount=10.10, open_amount=500.0)
+    # paid total 101.00 -> 3% = 3.03; open invoices ignored
+    assert customers.rebate_for(c.id) == Money(303)
+
+
+def test_bulk_tier_six_percent():
+    c = customers.add_customer("Acme")
+    _add_shipments(c.id, 50, paid_amount=20.0)
+    # paid total 1000.00 -> 6% = 60.00
+    assert customers.rebate_for(c.id) == Money(6000)
+
+
+def test_other_customers_not_counted():
+    c = customers.add_customer("Acme")
+    other = customers.add_customer("Other")
+    _add_shipments(other.id, 60, paid_amount=50.0)
+    _add_shipments(c.id, 5, paid_amount=50.0)
+    assert customers.rebate_for(c.id) == Money.zero()
