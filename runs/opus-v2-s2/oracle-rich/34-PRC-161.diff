+def _rebate_rate(shipment_count):
+    if shipment_count >= REBATE_BULK_MIN_SHIPMENTS:
+        return REBATE_BULK_RATE
+    if shipment_count >= REBATE_REGULAR_MIN_SHIPMENTS:
+        return REBATE_REGULAR_RATE
+    return None
+
+
+def rebate_for(customer_id):
+    """Volume rebate earned by a customer, as Money, based on their paid invoices."""
+    if customer_id not in db.customers:
+        raise DomainError("E_UNKNOWN_CUSTOMER", f"no customer {customer_id}")
+    shipment_ids = {s.id for s in db.shipments.values() if s.customer_id == customer_id}
+    rate = _rebate_rate(len(shipment_ids))
+    if rate is None:
+        return Money.zero()
+    paid_total = Money.zero()
+    for invoice in db.invoices.values():
+        if invoice.shipment_id in shipment_ids and invoice.status == "paid":
+            paid_total = paid_total + Money.parse(invoice.amount)
+    return paid_total.scale(rate)
