diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_customers_by_tier.py b/tests/unit/test_customers_by_tier.py
--- a/tests/unit/test_customers_by_tier.py	1969-12-31 19:00:00
+++ b/tests/unit/test_customers_by_tier.py	2026-11-12 04:27:29
@@ -0,0 +1,29 @@
+import pytest
+
+from parcelo import customers
+from parcelo.errors import DomainError
+from parcelo.store import db
+
+
+def test_returns_only_matching_tier_sorted_by_id():
+    a = customers.add_customer("Acme", tier="gold")
+    customers.add_customer("Bolt", tier="standard")
+    b = customers.add_customer("Cargo", tier="gold")
+    # insert out of id order to check sorting, not storage order
+    items = list(db.customers.items())
+    db.customers.clear()
+    db.customers.update(reversed(items))
+    result = customers.customers_by_tier("gold")
+    assert [c.id for c in result] == sorted([a.id, b.id])
+    assert all(c.tier == "gold" for c in result)
+
+
+def test_empty_when_no_customers_on_tier():
+    customers.add_customer("Acme", tier="standard")
+    assert customers.customers_by_tier("gold") == []
+
+
+def test_unknown_tier_fails():
+    with pytest.raises(DomainError) as err:
+        customers.customers_by_tier("platinum")
+    assert err.value.code == "E_BAD_TIER"
