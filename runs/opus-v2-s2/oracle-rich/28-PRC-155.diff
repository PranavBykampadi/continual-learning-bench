+def customers_by_tier(tier):
+    """Return the customers on `tier`, sorted by id ascending."""
+    if tier not in TIERS:
+        raise DomainError("E_BAD_TIER", f"unknown tier {tier!r}")
+    matches = [c for c in db.customers.values() if c.tier == tier]
+    return sorted(matches, key=lambda c: c.id)
