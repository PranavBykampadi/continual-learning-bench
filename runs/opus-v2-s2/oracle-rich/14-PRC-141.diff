diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/parcelo/shipments.py b/parcelo/shipments.py
--- a/parcelo/shipments.py	2026-11-10 12:20:18
+++ b/parcelo/shipments.py	2026-11-12 04:19:22
@@ -28,3 +28,22 @@
     if shipment_id not in db.shipments:
         raise DomainError("E_NOT_FOUND", shipment_id)
     return db.shipments[shipment_id]
+
+
+def reassign_shipment(shipment_id, new_customer_id):
+    shipment = get_shipment(shipment_id)
+    if new_customer_id not in db.customers:
+        raise DomainError("E_UNKNOWN_CUSTOMER", new_customer_id)
+    if shipment.customer_id == new_customer_id:
+        return shipment
+    if shipment.status == "delivered":
+        raise DomainError("E_BAD_STATE", f"shipment {shipment_id} already delivered")
+    old_customer_id = shipment.customer_id
+    shipment.customer_id = new_customer_id
+    events.emit(
+        "shipment.reassigned",
+        shipment.id,
+        from_customer_id=old_customer_id,
+        to_customer_id=new_customer_id,
+    )
+    return shipment
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_reassign_shipment.py b/tests/unit/test_reassign_shipment.py
--- a/tests/unit/test_reassign_shipment.py	1969-12-31 19:00:00
+++ b/tests/unit/test_reassign_shipment.py	2026-11-12 04:19:28
@@ -0,0 +1,60 @@
+import pytest
+
+from parcelo import customers, events, shipments
+from parcelo.errors import DomainError
+
+
+def _setup():
+    a = customers.add_customer("Acme")
+    b = customers.add_customer("Beta")
+    s = shipments.create_shipment(a.id, 1.5, "national")
+    return a, b, s
+
+
+def test_reassign_changes_customer_and_emits_event():
+    a, b, s = _setup()
+    result = shipments.reassign_shipment(s.id, b.id)
+    assert result is s
+    assert shipments.get_shipment(s.id).customer_id == b.id
+    event = events.OUTBOX[-1]
+    assert event["name"] == "shipment.reassigned"
+    assert event["entity_id"] == s.id
+    assert event["payload"] == {"from_customer_id": a.id, "to_customer_id": b.id}
+
+
+def test_reassign_is_idempotent():
+    _, b, s = _setup()
+    shipments.reassign_shipment(s.id, b.id)
+    count = len(events.OUTBOX)
+    result = shipments.reassign_shipment(s.id, b.id)
+    assert result is s
+    assert result.customer_id == b.id
+    assert len(events.OUTBOX) == count
+
+
+def test_reassign_unknown_shipment():
+    _, b, _ = _setup()
+    with pytest.raises(DomainError) as err:
+        shipments.reassign_shipment("shp_missing", b.id)
+    assert err.value.code == "E_NOT_FOUND"
+
+
+def test_reassign_unknown_customer():
+    a, _, s = _setup()
+    count = len(events.OUTBOX)
+    with pytest.raises(DomainError) as err:
+        shipments.reassign_shipment(s.id, "nope")
+    assert err.value.code == "E_UNKNOWN_CUSTOMER"
+    assert s.customer_id == a.id
+    assert len(events.OUTBOX) == count
+
+
+def test_reassign_delivered_shipment():
+    a, b, s = _setup()
+    s.status = "delivered"
+    count = len(events.OUTBOX)
+    with pytest.raises(DomainError) as err:
+        shipments.reassign_shipment(s.id, b.id)
+    assert err.value.code == "E_BAD_STATE"
+    assert s.customer_id == a.id
+    assert len(events.OUTBOX) == count
