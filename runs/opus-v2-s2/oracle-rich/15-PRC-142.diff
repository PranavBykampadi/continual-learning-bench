 def open_invoices():
     return [i for i in db.invoices.values() if i.status == "open"]
+
+
+def reopen_invoice(invoice_id):
+    """Undo a mistaken payment: move a paid invoice back to "open".
+
+    Idempotent: an invoice that was already reopened (open with
+    ``reopened_at`` set) is returned unchanged without a new event.
+    """
+    invoice = db.invoices.get(invoice_id)
+    if invoice is None:
+        raise DomainError("E_NOT_FOUND", invoice_id)
+    if invoice.status == "open" and invoice.reopened_at is not None:
+        return invoice
+    if invoice.status != "paid":
+        raise DomainError("E_BAD_STATE", f"invoice {invoice_id} is not paid")
+    invoice.status = "open"
+    invoice.paid_at = None
+    invoice.reopened_at = clock.now()
+    events.emit("invoice.reopened", invoice.id)
+    return invoice
