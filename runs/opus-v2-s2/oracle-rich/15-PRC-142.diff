diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_reopen_invoice.py b/tests/unit/test_reopen_invoice.py
--- a/tests/unit/test_reopen_invoice.py	1969-12-31 19:00:00
+++ b/tests/unit/test_reopen_invoice.py	2026-11-12 04:19:58
@@ -0,0 +1,55 @@
+from datetime import datetime, timezone
+
+import pytest
+
+from parcelo import clock, events, invoices
+from parcelo.errors import DomainError
+from parcelo.models import Invoice
+from parcelo.store import db
+
+
+def _invoice(status="open", paid_at=None):
+    inv = Invoice(id="inv_1", shipment_id="shp_1", amount=10.0, status=status, paid_at=paid_at)
+    db.invoices[inv.id] = inv
+    return inv
+
+
+def test_reopen_paid_invoice():
+    moment = datetime(2026, 11, 12, 9, 0, tzinfo=timezone.utc)
+    clock.set_fixed(moment)
+    _invoice(status="paid", paid_at=datetime(2026, 11, 1, tzinfo=timezone.utc))
+
+    inv = invoices.reopen_invoice("inv_1")
+
+    assert inv.status == "open"
+    assert inv.paid_at is None
+    assert inv.reopened_at == moment
+    assert events.OUTBOX[-1]["name"] == "invoice.reopened"
+    assert events.OUTBOX[-1]["entity_id"] == "inv_1"
+
+
+def test_reopen_is_idempotent():
+    _invoice(status="paid")
+    first = invoices.reopen_invoice("inv_1")
+    reopened_at = first.reopened_at
+    count = len(events.OUTBOX)
+
+    again = invoices.reopen_invoice("inv_1")
+
+    assert again is first
+    assert again.reopened_at == reopened_at
+    assert len(events.OUTBOX) == count
+
+
+def test_reopen_unknown_invoice():
+    with pytest.raises(DomainError) as err:
+        invoices.reopen_invoice("nope")
+    assert err.value.code == "E_NOT_FOUND"
+
+
+def test_reopen_never_paid_invoice():
+    _invoice(status="open")
+    with pytest.raises(DomainError) as err:
+        invoices.reopen_invoice("inv_1")
+    assert err.value.code == "E_BAD_STATE"
+    assert events.OUTBOX == []
