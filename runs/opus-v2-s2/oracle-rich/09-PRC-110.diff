+from decimal import Decimal
+
+from parcelo.errors import DomainError
+from parcelo.money import Money
+
 ZONE_BASE = {"local": 4.5, "national": 9.0, "international": 24.0}
 PER_KG = 1.25
 
+# Percentage off the regular quote, by customer tier.
+TIER_DISCOUNT_PCT = {"standard": 0, "gold": 10}
 
+
 def base_rate(zone):
     if zone not in ZONE_BASE:
         raise ValueError("unknown zone: %s" % zone)
@@ -12,3 +20,20 @@
     if weight_kg <= 0:
         raise ValueError("weight must be positive")
     return round(base_rate(zone) + PER_KG * weight_kg, 2)
+
+
+def discounted_quote(weight_kg, zone, tier):
+    """Regular quote for weight and zone with the tier discount applied, as Money.
+
+    Same percentage math as the old billing discount (amount * (1 - pct/100)),
+    rounded to whole cents, half-up.
+    """
+    if zone not in ZONE_BASE:
+        raise DomainError("E_BAD_ZONE", f"unknown zone: {zone}")
+    if tier not in TIER_DISCOUNT_PCT:
+        raise DomainError("E_BAD_TIER", f"unknown tier: {tier}")
+    if weight_kg <= 0:
+        raise DomainError("E_BAD_WEIGHT", "weight must be positive")
+    regular = Money.parse(quote(weight_kg, zone))
+    pct = Decimal(TIER_DISCOUNT_PCT[tier])
+    return regular.scale((Decimal(100) - pct) / Decimal(100))
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_rates_discount.py b/tests/unit/test_rates_discount.py
--- a/tests/unit/test_rates_discount.py	1969-12-31 19:00:00
+++ b/tests/unit/test_rates_discount.py	2026-11-12 04:15:34
@@ -0,0 +1,42 @@
+import pytest
+
+from parcelo import rates
+from parcelo.errors import DomainError
+from parcelo.money import Money
+
+
+def test_standard_tier_is_regular_quote():
+    # 9.0 + 1.25 * 2 = 11.50
+    assert rates.discounted_quote(2, "national", "standard") == Money(1150)
+
+
+def test_gold_tier_gets_ten_percent_off():
+    # 11.50 * 0.9 = 10.35
+    assert rates.discounted_quote(2, "national", "gold") == Money(1035)
+
+
+def test_gold_discount_rounds_half_up_to_cents():
+    # 4.5 + 1.25 * 1 = 5.75; * 0.9 = 5.175 -> 5.18
+    assert rates.discounted_quote(1, "local", "gold") == Money(518)
+
+
+def test_returns_money():
+    assert isinstance(rates.discounted_quote(1, "international", "gold"), Money)
+
+
+def test_unknown_zone_fails():
+    with pytest.raises(DomainError) as err:
+        rates.discounted_quote(1, "mars", "gold")
+    assert err.value.code == "E_BAD_ZONE"
+
+
+def test_unknown_tier_fails():
+    with pytest.raises(DomainError) as err:
+        rates.discounted_quote(1, "local", "platinum")
+    assert err.value.code == "E_BAD_TIER"
+
+
+def test_non_positive_weight_fails():
+    with pytest.raises(DomainError) as err:
+        rates.discounted_quote(0, "local", "gold")
+    assert err.value.code == "E_BAD_WEIGHT"
