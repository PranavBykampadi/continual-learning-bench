     if shipment_id not in db.shipments:
         raise DomainError("E_NOT_FOUND", shipment_id)
     return db.shipments[shipment_id]
+
+
+def list_shipments(customer_id):
+    if customer_id not in db.customers:
+        raise DomainError("E_UNKNOWN_CUSTOMER", customer_id)
+    owned = [s for s in db.shipments.values() if s.customer_id == customer_id]
+    return sorted(owned, key=lambda s: s.id)
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_list_shipments.py b/tests/unit/test_list_shipments.py
--- a/tests/unit/test_list_shipments.py	1969-12-31 19:00:00
+++ b/tests/unit/test_list_shipments.py	2026-11-12 04:25:56
@@ -0,0 +1,25 @@
+import pytest
+
+from parcelo import customers, shipments
+from parcelo.errors import DomainError
+
+
+def test_lists_only_customer_shipments_sorted_by_id():
+    a = customers.add_customer("Acme")
+    b = customers.add_customer("Other")
+    s1 = shipments.create_shipment(a.id, 1, "local")
+    shipments.create_shipment(b.id, 2, "local")
+    s2 = shipments.create_shipment(a.id, 3, "national")
+    result = shipments.list_shipments(a.id)
+    assert [s.id for s in result] == sorted([s1.id, s2.id])
+
+
+def test_empty_list_when_no_shipments():
+    c = customers.add_customer("Acme")
+    assert shipments.list_shipments(c.id) == []
+
+
+def test_unknown_customer_fails():
+    with pytest.raises(DomainError) as err:
+        shipments.list_shipments("nope")
+    assert err.value.code == "E_UNKNOWN_CUSTOMER"
