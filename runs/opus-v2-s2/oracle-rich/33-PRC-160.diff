--- a/parcelo/shipments.py	2026-11-10 12:20:18
+++ b/parcelo/shipments.py	2026-11-12 04:30:14
@@ -28,3 +28,15 @@
     if shipment_id not in db.shipments:
         raise DomainError("E_NOT_FOUND", shipment_id)
     return db.shipments[shipment_id]
+
+
+def mark_returned(shipment_id):
+    shipment = get_shipment(shipment_id)
+    if shipment.status == "returned":
+        return shipment
+    if shipment.status == "created":
+        raise DomainError("E_BAD_STATE", f"{shipment_id} has not been shipped yet")
+    shipment.status = "returned"
+    shipment.returned_at = clock.now()
+    events.emit("shipment.returned", shipment.id)
+    return shipment
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_mark_returned.py b/tests/unit/test_mark_returned.py
--- a/tests/unit/test_mark_returned.py	1969-12-31 19:00:00
+++ b/tests/unit/test_mark_returned.py	2026-11-12 04:30:22
@@ -0,0 +1,56 @@
+from datetime import datetime, timezone
+
+import pytest
+
+from parcelo import clock, customers, events, shipments
+from parcelo.errors import DomainError
+
+MOMENT = datetime(2026, 11, 12, 9, 30, tzinfo=timezone.utc)
+
+
+def _shipment(status):
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 2.0, "national")
+    s.status = status
+    return s
+
+
+def test_mark_returned_sets_status_and_time():
+    clock.set_fixed(MOMENT)
+    s = _shipment("delivered")
+    result = shipments.mark_returned(s.id)
+    assert result is s
+    assert s.status == "returned"
+    assert s.returned_at == MOMENT
+    assert events.OUTBOX[-1]["name"] == "shipment.returned"
+    assert events.OUTBOX[-1]["entity_id"] == s.id
+
+
+def test_mark_returned_is_idempotent():
+    s = _shipment("delivered")
+    shipments.mark_returned(s.id)
+    first_at = s.returned_at
+    count = len(events.OUTBOX)
+    clock.set_fixed(MOMENT)
+    again = shipments.mark_returned(s.id)
+    assert again is s
+    assert s.status == "returned"
+    assert s.returned_at == first_at
+    assert len(events.OUTBOX) == count
+
+
+def test_created_shipment_cannot_be_returned():
+    s = _shipment("created")
+    count = len(events.OUTBOX)
+    with pytest.raises(DomainError) as err:
+        shipments.mark_returned(s.id)
+    assert err.value.code == "E_BAD_STATE"
+    assert s.status == "created"
+    assert s.returned_at is None
+    assert len(events.OUTBOX) == count
+
+
+def test_unknown_shipment():
+    with pytest.raises(DomainError) as err:
+        shipments.mark_returned("shp_missing")
+    assert err.value.code == "E_NOT_FOUND"
