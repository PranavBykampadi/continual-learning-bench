 def open_invoices():
     return [i for i in db.invoices.values() if i.status == "open"]
+
+
+def apply_credit(invoice_id, amount):
+    """Reduce an open invoice by a credit and return the remaining amount as Money.
+
+    After a credit the invoice's amount is stored as Money; reports and
+    customer balances accept both Money and legacy float amounts.
+    """
+    if invoice_id not in db.invoices:
+        raise DomainError("E_NOT_FOUND", invoice_id)
+    invoice = db.invoices[invoice_id]
+    if invoice.status != "open":
+        raise DomainError("E_BAD_STATE", f"invoice {invoice_id} is {invoice.status}")
+    try:
+        credit = Money.parse(amount)
+    except Exception:
+        raise DomainError("E_BAD_INPUT", f"invalid credit amount {amount!r}")
+    if credit.cents <= 0:
+        raise DomainError("E_BAD_INPUT", "credit must be positive")
+    current = Money.parse(invoice.amount)
+    if current < credit:
+        raise DomainError("E_LIMIT", f"credit {credit} exceeds invoice amount {current}")
+    remaining = current - credit
+    invoice.amount = remaining
+    audit.record(
+        "invoice.credit_applied",
+        invoice.id,
+        credit_cents=credit.cents,
+        remaining_cents=remaining.cents,
+    )
+    return remaining
