diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_invoice_credits.py b/tests/unit/test_invoice_credits.py
--- a/tests/unit/test_invoice_credits.py	1969-12-31 19:00:00
+++ b/tests/unit/test_invoice_credits.py	2026-11-12 04:18:02
@@ -0,0 +1,84 @@
+import pytest
+
+from parcelo import audit, customers, invoices, reports, shipments
+from parcelo.errors import DomainError
+from parcelo.money import Money
+
+
+def _invoice():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 2, "local")
+    return c, invoices.issue_invoice(s.id)  # local, 2kg -> 7.00
+
+
+def test_apply_credit_returns_remaining_money():
+    _, inv = _invoice()
+    remaining = invoices.apply_credit(inv.id, Money.parse("2.50"))
+    assert remaining == Money(450)
+    assert inv.amount == Money(450)
+
+
+def test_apply_credit_accepts_legacy_float():
+    _, inv = _invoice()
+    assert invoices.apply_credit(inv.id, 1.1) == Money(590)
+
+
+def test_apply_credit_records_audit():
+    _, inv = _invoice()
+    invoices.apply_credit(inv.id, Money(100))
+    entry = audit.LOG[-1]
+    assert entry["action"] == "invoice.credit_applied"
+    assert entry["entity_id"] == inv.id
+    assert entry["details"] == {"credit_cents": 100, "remaining_cents": 600}
+
+
+def test_credit_equal_to_amount_leaves_zero():
+    _, inv = _invoice()
+    assert invoices.apply_credit(inv.id, Money(700)) == Money.zero()
+
+
+def test_multiple_credits_accumulate():
+    _, inv = _invoice()
+    invoices.apply_credit(inv.id, Money(100))
+    assert invoices.apply_credit(inv.id, Money(200)) == Money(400)
+
+
+def test_balance_and_reports_after_credit():
+    c, inv = _invoice()
+    invoices.apply_credit(inv.id, Money(250))
+    assert customers.outstanding_balance(c.id) == 4.5
+    invoices.mark_paid(inv.id)
+    assert customers.outstanding_balance(c.id) == 0
+    assert reports.revenue_total() == 4.5
+    assert reports.daily_summary()["revenue"] == 4.5
+
+
+def test_unknown_invoice():
+    with pytest.raises(DomainError) as err:
+        invoices.apply_credit("nope", Money(100))
+    assert err.value.code == "E_NOT_FOUND"
+
+
+def test_paid_invoice_rejected():
+    _, inv = _invoice()
+    invoices.mark_paid(inv.id)
+    with pytest.raises(DomainError) as err:
+        invoices.apply_credit(inv.id, Money(100))
+    assert err.value.code == "E_BAD_STATE"
+
+
