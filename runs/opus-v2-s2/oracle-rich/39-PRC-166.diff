+def escalate_invoice(invoice_id):
+    """Send a large open invoice to collections by setting its status to "escalated"."""
+    invoice = db.invoices.get(invoice_id)
+    if invoice is None:
+        raise DomainError("E_NOT_FOUND", invoice_id)
+    if invoice.status == "escalated":
+        return invoice
+    if invoice.status != "open":
+        raise DomainError("E_BAD_STATE", f"invoice {invoice_id} is {invoice.status}")
+    amount = Money.parse(invoice.amount)
+    if amount < ESCALATION_MIN_AMOUNT:
+        raise DomainError(
+            "E_LIMIT", f"invoice {invoice_id} amount {amount} is below {ESCALATION_MIN_AMOUNT}"
+        )
+    invoice.status = "escalated"
+    events.emit("invoice.escalated", invoice.id, amount_cents=amount.cents)
+    return invoice
