diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_invoices_escalation.py b/tests/unit/test_invoices_escalation.py
--- a/tests/unit/test_invoices_escalation.py	1969-12-31 19:00:00
+++ b/tests/unit/test_invoices_escalation.py	2026-11-12 04:33:13
@@ -0,0 +1,60 @@
+import pytest
+
+from parcelo import events
+from parcelo.errors import DomainError
+from parcelo.invoices import escalate_invoice
+from parcelo.models import Invoice
+from parcelo.store import db
+
+
+def _invoice(amount, status="open", invoice_id="inv_1"):
+    invoice = Invoice(id=invoice_id, shipment_id="shp_1", amount=amount, status=status)
+    db.invoices[invoice.id] = invoice
+    return invoice
+
+
+def test_escalates_open_invoice_at_threshold():
+    _invoice(500.00)
+    invoice = escalate_invoice("inv_1")
+    assert invoice.status == "escalated"
+    assert db.invoices["inv_1"].status == "escalated"
+    assert events.OUTBOX[-1]["name"] == "invoice.escalated"
+    assert events.OUTBOX[-1]["entity_id"] == "inv_1"
+
+
+def test_escalates_large_invoice():
+    _invoice(1234.56)
+    assert escalate_invoice("inv_1").status == "escalated"
+
+
+def test_below_threshold_fails():
+    _invoice(499.99)
+    with pytest.raises(DomainError) as err:
+        escalate_invoice("inv_1")
+    assert err.value.code == "E_LIMIT"
+    assert db.invoices["inv_1"].status == "open"
+    assert events.OUTBOX == []
+
+
+def test_not_open_fails():
+    _invoice(800.0, status="paid")
+    with pytest.raises(DomainError) as err:
+        escalate_invoice("inv_1")
+    assert err.value.code == "E_BAD_STATE"
+    assert db.invoices["inv_1"].status == "paid"
+    assert events.OUTBOX == []
+
+
+def test_missing_invoice_fails():
+    with pytest.raises(DomainError) as err:
+        escalate_invoice("nope")
+    assert err.value.code == "E_NOT_FOUND"
+
+
+def test_idempotent():
+    _invoice(600.0)
+    first = escalate_invoice("inv_1")
+    second = escalate_invoice("inv_1")
+    assert second is first
+    assert second.status == "escalated"
+    assert len(events.OUTBOX) == 1
