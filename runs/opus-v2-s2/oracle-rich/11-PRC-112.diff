diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_claims.py b/tests/unit/test_claims.py
--- a/tests/unit/test_claims.py	1969-12-31 19:00:00
+++ b/tests/unit/test_claims.py	2026-11-12 04:16:46
@@ -0,0 +1,68 @@
+from datetime import datetime, timezone
+
+import pytest
+
+from parcelo import audit, claims, clock, customers, shipments
+from parcelo.errors import DomainError
+from parcelo.money import Money
+from parcelo.store import db
+
+
+def _shipment(status="delivered"):
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 1.5, "national")
+    s.status = status
+    return s
+
+
+def test_file_claim_on_delivered_shipment():
+    moment = datetime(2026, 11, 12, 9, 0, tzinfo=timezone.utc)
+    clock.set_fixed(moment)
+    s = _shipment()
+    claim = claims.file_claim(s.id, Money(1250), "damaged")
+    assert claim.id.startswith("clm_")
+    assert claim.shipment_id == s.id
+    assert claim.amount == Money(1250)
+    assert claim.reason == "damaged"
+    assert claim.filed_at == moment
+    assert db.claims[claim.id] is claim
+    assert audit.LOG[-1]["action"] == "claim.filed"
+    assert audit.LOG[-1]["entity_id"] == claim.id
+
+
+def test_float_amount_is_converted_to_money():
+    s = _shipment()
+    claim = claims.file_claim(s.id, 12.5, "lost item")
+    assert claim.amount == Money(1250)
+
+
+def test_unknown_shipment():
+    with pytest.raises(DomainError) as err:
+        claims.file_claim("shp_nope", Money(100), "x")
+    assert err.value.code == "E_NOT_FOUND"
+
+
+@pytest.mark.parametrize("status", ["created", "in_transit", "cancelled"])
+def test_not_delivered_rejected(status):
+    s = _shipment(status)
+    with pytest.raises(DomainError) as err:
+        claims.file_claim(s.id, Money(100), "x")
+    assert err.value.code == "E_BAD_STATE"
+    assert db.claims == {}
+
+
+@pytest.mark.parametrize("amount", [Money(0), Money(-1), 0, -5.0, 0.001, None, "abc"])
+def test_non_positive_or_invalid_amount_rejected(amount):
+    s = _shipment()
+    with pytest.raises(DomainError) as err:
+        claims.file_claim(s.id, amount, "x")
+    assert err.value.code == "E_BAD_INPUT"
+    assert db.claims == {}
+
+
+def test_reset_clears_claims():
+    from parcelo import store
+    s = _shipment()
+    claims.file_claim(s.id, Money(100), "x")
+    store.reset()
+    assert db.claims == {}
