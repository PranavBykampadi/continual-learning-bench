diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/parcelo/claims.py b/parcelo/claims.py
--- a/parcelo/claims.py	1969-12-31 19:00:00
+++ b/parcelo/claims.py	2026-11-12 04:16:46
@@ -0,0 +1,35 @@
+from parcelo import audit, clock, ids
+from parcelo.errors import DomainError
+from parcelo.models import Claim
+from parcelo.money import Money
+from parcelo.store import db
+
+
+def file_claim(shipment_id, amount, reason):
+    """File a claim for money back on a delivered shipment.
+
+    `amount` may be a Money or a dollar value from older float code.
+    """
+    shipment = db.shipments.get(shipment_id)
+    if shipment is None:
+        raise DomainError("E_NOT_FOUND", shipment_id)
+    if shipment.status != "delivered":
+        raise DomainError("E_BAD_STATE", f"{shipment_id} is {shipment.status}")
+    if amount is None or isinstance(amount, bool):
+        raise DomainError("E_BAD_INPUT", f"invalid amount {amount!r}")
+    try:
+        money = Money.parse(amount)
+    except Exception:
+        raise DomainError("E_BAD_INPUT", f"invalid amount {amount!r}") from None
+    if money.cents <= 0:
+        raise DomainError("E_BAD_INPUT", f"amount must be positive, got {money}")
+    claim = Claim(
+        id=ids.new_id("clm"),
+        shipment_id=shipment_id,
+        amount=money,
+        reason=reason,
+        filed_at=clock.now(),
+    )
+    db.claims[claim.id] = claim
+    audit.record("claim.filed", claim.id, shipment_id=shipment_id, amount_cents=money.cents)
+    return claim
