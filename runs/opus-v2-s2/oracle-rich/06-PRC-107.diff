@@ -28,3 +28,15 @@
     if shipment_id not in db.shipments:
         raise DomainError("E_NOT_FOUND", shipment_id)
     return db.shipments[shipment_id]
+
+
+def mark_delivered(shipment_id):
+    shipment = get_shipment(shipment_id)
+    if shipment.status in ("cancelled", "delivered"):
+        raise DomainError(
+            "E_BAD_STATE", f"{shipment_id} is {shipment.status}, cannot mark delivered"
+        )
+    shipment.status = "delivered"
+    shipment.delivered_at = clock.now()
+    audit.record("shipment.delivered", shipment.id)
+    return shipment
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_mark_delivered.py b/tests/unit/test_mark_delivered.py
--- a/tests/unit/test_mark_delivered.py	1969-12-31 19:00:00
+++ b/tests/unit/test_mark_delivered.py	2026-11-12 04:13:47
@@ -0,0 +1,55 @@
+from datetime import datetime, timezone
+
+import pytest
+
+from parcelo import audit, clock, customers, shipments
+from parcelo.errors import DomainError
+
+
+@pytest.fixture
+def shipment():
+    c = customers.add_customer("Acme")
+    return shipments.create_shipment(c.id, 2, "national")
+
+
+def test_mark_delivered_sets_status_and_time(shipment):
+    moment = datetime(2026, 11, 12, 15, 30, tzinfo=timezone.utc)
+    clock.set_fixed(moment)
+    result = shipments.mark_delivered(shipment.id)
+    assert result is shipment
+    assert result.status == "delivered"
+    assert result.delivered_at == moment
+    assert shipments.get_shipment(shipment.id).status == "delivered"
+
+
+def test_mark_delivered_records_audit(shipment):
+    shipments.mark_delivered(shipment.id)
+    entry = audit.LOG[-1]
+    assert entry["action"] == "shipment.delivered"
+    assert entry["entity_id"] == shipment.id
+
+
+def test_mark_delivered_unknown_shipment():
+    with pytest.raises(DomainError) as err:
+        shipments.mark_delivered("shp_missing")
+    assert err.value.code == "E_NOT_FOUND"
+
+
+def test_mark_delivered_twice_fails(shipment):
+    shipments.mark_delivered(shipment.id)
+    first_time = shipment.delivered_at
+    log_len = len(audit.LOG)
+    with pytest.raises(DomainError) as err:
+        shipments.mark_delivered(shipment.id)
+    assert err.value.code == "E_BAD_STATE"
+    assert shipment.delivered_at == first_time
+    assert len(audit.LOG) == log_len
+
+
+def test_mark_delivered_cancelled_fails(shipment):
+    shipment.status = "cancelled"
+    with pytest.raises(DomainError) as err:
+        shipments.mark_delivered(shipment.id)
+    assert err.value.code == "E_BAD_STATE"
+    assert shipment.status == "cancelled"
+    assert shipment.delivered_at is None
