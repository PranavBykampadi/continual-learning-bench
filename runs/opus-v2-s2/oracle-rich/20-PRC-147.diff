+"""Business thresholds, limits and rates used by parcelo."""
+
+# Minimum shipment counts for each customer volume tier.
+VOLUME_TIER_BULK_MIN_SHIPMENTS = 50
+VOLUME_TIER_REGULAR_MIN_SHIPMENTS = 10
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_volume_report.py b/tests/unit/test_volume_report.py
--- a/tests/unit/test_volume_report.py	1969-12-31 19:00:00
+++ b/tests/unit/test_volume_report.py	2026-11-12 04:23:25
@@ -0,0 +1,57 @@
+from parcelo import customers, reports, shipments
+from parcelo.settings import (
+    VOLUME_TIER_BULK_MIN_SHIPMENTS,
+    VOLUME_TIER_REGULAR_MIN_SHIPMENTS,
+)
+
+
+def _ship(customer_id, n):
+    for _ in range(n):
+        shipments.create_shipment(customer_id, 1, "local")
+
+
+def test_empty_store():
+    assert reports.volume_report() == {}
+
+
+def test_customer_without_shipments_is_included():
+    c = customers.add_customer("Idle")
+    assert reports.volume_report() == {c.id: {"shipments": 0, "tier": "starter"}}
+
+
+def test_counts_and_tiers_at_thresholds():
+    starter = customers.add_customer("Small")
+    regular = customers.add_customer("Mid")
+    bulk = customers.add_customer("Big")
+    almost_bulk = customers.add_customer("Almost")
+    _ship(starter.id, 1)
+    _ship(regular.id, VOLUME_TIER_REGULAR_MIN_SHIPMENTS)
+    _ship(bulk.id, VOLUME_TIER_BULK_MIN_SHIPMENTS)
+    _ship(almost_bulk.id, VOLUME_TIER_BULK_MIN_SHIPMENTS - 1)
+
+    report = reports.volume_report()
+
+    assert report[starter.id] == {"shipments": 1, "tier": "starter"}
+    assert report[regular.id] == {
+        "shipments": VOLUME_TIER_REGULAR_MIN_SHIPMENTS,
+        "tier": "regular",
+    }
+    assert report[bulk.id] == {
+        "shipments": VOLUME_TIER_BULK_MIN_SHIPMENTS,
+        "tier": "bulk",
+    }
+    assert report[almost_bulk.id] == {
+        "shipments": VOLUME_TIER_BULK_MIN_SHIPMENTS - 1,
+        "tier": "regular",
+    }
+
+
+def test_just_below_regular_is_starter():
+    c = customers.add_customer("Edge")
+    _ship(c.id, VOLUME_TIER_REGULAR_MIN_SHIPMENTS - 1)
+    assert reports.volume_report()[c.id]["tier"] == "starter"
+
+
+def test_keys_sorted_by_customer_id():
+    ids = [customers.add_customer("C%d" % i).id for i in range(5)]
+    assert list(reports.volume_report()) == sorted(ids)
