+def _age_in_days(issued_at, now):
+    # Older code stores naive UTC timestamps (datetime.utcnow()); treat naive
+    # values as UTC so they can be compared with the timezone-aware clock.
+    if issued_at.tzinfo is None:
+        issued_at = issued_at.replace(tzinfo=timezone.utc)
+    if now.tzinfo is None:
+        now = now.replace(tzinfo=timezone.utc)
+    return (now - issued_at).days
+
+
+def aging_report():
+    """Total open (unpaid) invoice amounts, bucketed by whole days since issue."""
+    now = clock.now()
+    buckets = {"0-30": Money.zero(), "31-60": Money.zero(), "60+": Money.zero()}
+    for invoice in db.invoices.values():
+        if invoice.status == "paid":
+            continue
+        if invoice.issued_at is None:
+            raise DomainError("E_BAD_STATE", f"invoice {invoice.id} has no issue date")
+        age = _age_in_days(invoice.issued_at, now)
+        if age <= 30:
+            key = "0-30"
+        elif age <= 60:
+            key = "31-60"
+        else:
+            key = "60+"
+        buckets[key] = buckets[key] + Money.parse(invoice.amount)
+    return buckets
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_aging_report.py b/tests/unit/test_aging_report.py
--- a/tests/unit/test_aging_report.py	1969-12-31 19:00:00
+++ b/tests/unit/test_aging_report.py	2026-11-12 04:18:51
@@ -0,0 +1,70 @@
+from datetime import datetime, timedelta, timezone
+
+import pytest
+
+from parcelo import clock, reports
+from parcelo.errors import DomainError
+from parcelo.models import Invoice
+from parcelo.money import Money
+from parcelo.store import db
+
+NOW = datetime(2026, 11, 12, 12, 0, tzinfo=timezone.utc)
+
+
+def _add(inv_id, amount, days_ago, status="open", naive=False):
+    issued = NOW - timedelta(days=days_ago)
+    if naive:
+        issued = issued.replace(tzinfo=None)
+    db.invoices[inv_id] = Invoice(inv_id, "shp_1", amount, status=status, issued_at=issued)
+
+
+@pytest.fixture(autouse=True)
+def fixed_now():
+    clock.set_fixed(NOW)
+
+
+def test_empty_report_is_all_zero():
+    assert reports.aging_report() == {
+        "0-30": Money.zero(),
+        "31-60": Money.zero(),
+        "60+": Money.zero(),
+    }
+
+
+def test_buckets_and_boundaries():
+    _add("a", 10.10, 0)
+    _add("b", 20.20, 30)
+    _add("c", 1.00, 31)
+    _add("d", 2.00, 60)
+    _add("e", 5.55, 61)
+    _add("f", 0.45, 400)
+    report = reports.aging_report()
+    assert report["0-30"] == Money(3030)
+    assert report["31-60"] == Money(300)
+    assert report["60+"] == Money(600)
+
+
+def test_paid_invoices_excluded():
+    _add("a", 10.00, 5)
+    _add("b", 99.00, 5, status="paid")
+    _add("c", 99.00, 90, status="paid")
+    report = reports.aging_report()
+    assert report["0-30"] == Money(1000)
+    assert report["60+"] == Money.zero()
+
+
+def test_partial_days_round_down():
+    db.invoices["a"] = Invoice("a", "shp_1", 1.0, issued_at=NOW - timedelta(days=30, hours=23))
+    assert reports.aging_report()["0-30"] == Money(100)
+
+
+def test_naive_issued_at_treated_as_utc():
+    _add("a", 3.00, 45, naive=True)
+    assert reports.aging_report()["31-60"] == Money(300)
+
+
+def test_missing_issue_date_raises():
+    db.invoices["a"] = Invoice("a", "shp_1", 1.0, issued_at=None)
+    with pytest.raises(DomainError) as err:
+        reports.aging_report()
+    assert err.value.code == "E_BAD_STATE"
