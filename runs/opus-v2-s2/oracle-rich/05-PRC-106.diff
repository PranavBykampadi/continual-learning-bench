 def open_invoices():
     return [i for i in db.invoices.values() if i.status == "open"]
+
+
+def late_fee_for(invoice_id):
+    """Late fee an invoice has accrued as of now, as Money.
+
+    An invoice is late 30 days after it was issued; each full day past that
+    adds 1.5% of the invoice amount.
+    """
+    invoice = db.invoices.get(invoice_id)
+    if invoice is None:
+        raise DomainError("E_NOT_FOUND", f"invoice {invoice_id} not found")
+    amount = Money.parse(invoice.amount)
+    issued_at = invoice.issued_at
+    if issued_at.tzinfo is None:
+        # Older code stores naive UTC timestamps (datetime.utcnow()).
+        issued_at = issued_at.replace(tzinfo=timezone.utc)
+    days_late = (clock.now() - issued_at).days - LATE_AFTER_DAYS
+    if days_late <= 0:
+        return Money.zero()
+    return amount.scale(LATE_FEE_RATE_PER_DAY * days_late)
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_late_fee.py b/tests/unit/test_late_fee.py
--- a/tests/unit/test_late_fee.py	1969-12-31 19:00:00
+++ b/tests/unit/test_late_fee.py	2026-11-12 04:13:26
@@ -0,0 +1,62 @@
+from datetime import datetime, timedelta, timezone
+
+import pytest
+
+from parcelo import clock
+from parcelo.errors import DomainError
+from parcelo.invoices import late_fee_for
+from parcelo.models import Invoice
+from parcelo.money import Money
+from parcelo.store import db
+
+ISSUED = datetime(2026, 1, 1, 12, 0, tzinfo=timezone.utc)
+
+
+def _invoice(amount=100.0, issued_at=ISSUED):
+    inv = Invoice(id="inv_1", shipment_id="shp_1", amount=amount, issued_at=issued_at)
+    db.invoices[inv.id] = inv
+    return inv
+
+
+def test_not_late_yet_is_zero():
+    _invoice()
+    clock.set_fixed(ISSUED + timedelta(days=10))
+    assert late_fee_for("inv_1") == Money.zero()
+
+
+def test_exactly_thirty_days_is_zero():
+    _invoice()
+    clock.set_fixed(ISSUED + timedelta(days=30))
+    assert late_fee_for("inv_1") == Money.zero()
+
+
+def test_fee_per_day_past_thirty():
+    _invoice(amount=100.0)
+    clock.set_fixed(ISSUED + timedelta(days=34))
+    # 4 days late * 1.5% of 100.00 = 6.00
+    assert late_fee_for("inv_1") == Money(600)
+
+
+def test_partial_day_does_not_count():
+    _invoice(amount=100.0)
+    clock.set_fixed(ISSUED + timedelta(days=31, hours=23))
+    assert late_fee_for("inv_1") == Money(150)
+
+
+def test_rounds_to_cents():
+    _invoice(amount=12.34)
+    clock.set_fixed(ISSUED + timedelta(days=31))
+    # 12.34 * 0.015 = 0.1851 -> 0.19
+    assert late_fee_for("inv_1") == Money(19)
+
+
+def test_naive_issued_at_treated_as_utc():
+    _invoice(amount=100.0, issued_at=ISSUED.replace(tzinfo=None))
+    clock.set_fixed(ISSUED + timedelta(days=32))
+    assert late_fee_for("inv_1") == Money(300)
+
+
+def test_unknown_invoice_fails():
+    with pytest.raises(DomainError) as err:
+        late_fee_for("nope")
+    assert err.value.code == "E_NOT_FOUND"
