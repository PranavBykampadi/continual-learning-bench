diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_refunds.py b/tests/unit/test_refunds.py
--- a/tests/unit/test_refunds.py	1969-12-31 19:00:00
+++ b/tests/unit/test_refunds.py	2026-11-12 04:12:42
@@ -0,0 +1,59 @@
+from datetime import datetime, timezone
+
+import pytest
+
+from parcelo import audit, clock, refunds
+from parcelo.errors import DomainError
+from parcelo.models import Invoice
+from parcelo.money import Money
+from parcelo.store import db
+
+
+def _invoice(status):
+    inv = Invoice(id="inv_test", shipment_id="shp_x", amount=20.0, status=status)
+    db.invoices[inv.id] = inv
+    return inv
+
+
+def test_refund_paid_invoice():
+    moment = datetime(2026, 1, 2, tzinfo=timezone.utc)
+    clock.set_fixed(moment)
+    inv = _invoice("paid")
+    r = refunds.create_refund(inv.id, Money(500))
+    assert r.id.startswith("rfd_")
+    assert r.invoice_id == inv.id
+    assert r.amount == Money(500)
+    assert r.created_at == moment
+    assert db.refunds[r.id] is r
+    assert audit.LOG[-1]["action"] == "refund.created"
+    assert audit.LOG[-1]["entity_id"] == r.id
+
+
+def test_refund_parses_float_amount():
+    inv = _invoice("paid")
+    r = refunds.create_refund(inv.id, 12.34)
+    assert r.amount == Money(1234)
+
+
+def test_unknown_invoice():
+    with pytest.raises(DomainError) as err:
+        refunds.create_refund("nope", Money(100))
+    assert err.value.code == "E_NOT_FOUND"
+    assert db.refunds == {}
+
+
+def test_unpaid_invoice():
+    inv = _invoice("open")
+    with pytest.raises(DomainError) as err:
+        refunds.create_refund(inv.id, Money(100))
+    assert err.value.code == "E_BAD_STATE"
+    assert db.refunds == {}
+    assert audit.LOG == []
+
+
+@pytest.mark.parametrize("amount", [Money(0), Money(-100), "abc"])
+def test_bad_amount(amount):
+    inv = _invoice("paid")
+    with pytest.raises(DomainError) as err:
+        refunds.create_refund(inv.id, amount)
+    assert err.value.code == "E_BAD_INPUT"
