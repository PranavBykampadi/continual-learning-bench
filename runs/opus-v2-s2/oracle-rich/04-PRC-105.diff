diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/parcelo/refunds.py b/parcelo/refunds.py
--- a/parcelo/refunds.py	1969-12-31 19:00:00
+++ b/parcelo/refunds.py	2026-11-12 04:12:42
@@ -0,0 +1,33 @@
+from parcelo import audit, clock
+from parcelo.errors import DomainError
+from parcelo.ids import new_id
+from parcelo.models import Refund
+from parcelo.money import Money
+from parcelo.store import db
+
+
+def create_refund(invoice_id, amount):
+    """Record a refund against a paid invoice and return it."""
+    invoice = db.invoices.get(invoice_id)
+    if invoice is None:
+        raise DomainError("E_NOT_FOUND", f"invoice {invoice_id} not found")
+    if invoice.status != "paid":
+        raise DomainError(
+            "E_BAD_STATE", f"invoice {invoice_id} is {invoice.status}, not paid"
+        )
+    try:
+        amount = Money.parse(amount)
+    except Exception:
+        raise DomainError("E_BAD_INPUT", f"invalid refund amount {amount!r}")
+    if amount.cents <= 0:
+        raise DomainError("E_BAD_INPUT", "refund amount must be positive")
+
+    refund = Refund(
+        id=new_id("rfd"),
+        invoice_id=invoice_id,
+        amount=amount,
+        created_at=clock.now(),
+    )
+    db.refunds[refund.id] = refund
+    audit.record("refund.created", refund.id, invoice_id=invoice_id, amount=str(amount))
+    return refund
