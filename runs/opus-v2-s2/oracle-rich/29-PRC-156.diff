@@ -0,0 +1,6 @@
+"""Business thresholds, limits and rates."""
+
+# Parcels heavier than this (in kg) pay a surcharge on top of the normal quote.
+HEAVY_THRESHOLD_KG = 30
+# Surcharge in dollars per kilogram above HEAVY_THRESHOLD_KG.
+HEAVY_SURCHARGE_PER_KG = "0.75"
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_heavy_quote.py b/tests/unit/test_heavy_quote.py
--- a/tests/unit/test_heavy_quote.py	1969-12-31 19:00:00
+++ b/tests/unit/test_heavy_quote.py	2026-11-12 04:28:05
@@ -0,0 +1,38 @@
+import pytest
+
+from parcelo import rates
+from parcelo.errors import DomainError
+from parcelo.money import Money
+
+
+def test_at_or_below_threshold_is_normal_quote():
+    assert rates.heavy_quote(30, "local") == Money.parse(rates.quote(30, "local"))
+    assert rates.heavy_quote(2.5, "national") == Money.parse(rates.quote(2.5, "national"))
+
+
+def test_above_threshold_adds_surcharge():
+    # 9.00 + 1.25*40 = 59.00, plus 0.75*10 = 7.50
+    assert rates.heavy_quote(40, "national") == Money(6650)
+
+
+def test_fractional_excess_is_pro_rata():
+    # 4.50 + 1.25*30.5 = 42.625 -> 42.62 (float round), plus 0.75*0.5 = 0.375 -> 0.38
+    expected = Money.parse(rates.quote(30.5, "local")) + Money(38)
+    assert rates.heavy_quote(30.5, "local") == expected
+
+
+def test_returns_money():
+    assert isinstance(rates.heavy_quote(31, "international"), Money)
+
+
+def test_unknown_zone():
+    with pytest.raises(DomainError) as err:
+        rates.heavy_quote(40, "mars")
+    assert err.value.code == "E_BAD_ZONE"
+
+
+@pytest.mark.parametrize("weight", [0, -1, -35.5])
+def test_non_positive_weight(weight):
+    with pytest.raises(DomainError) as err:
+        rates.heavy_quote(weight, "local")
+    assert err.value.code == "E_BAD_WEIGHT"
