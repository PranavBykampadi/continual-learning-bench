 def open_invoices():
     return [i for i in db.invoices.values() if i.status == "open"]
+
+
+def write_off(invoice_id):
+    """Write off an open invoice and return the written-off amount as Money.
+
+    Idempotent: writing off an invoice that is already written off returns its
+    amount again without changing it or emitting another event.
+    """
+    invoice = db.invoices.get(invoice_id)
+    if invoice is None:
+        raise DomainError("E_NOT_FOUND", f"invoice {invoice_id} not found")
+    amount = Money.parse(invoice.amount)
+    if invoice.status == "written_off":
+        return amount
+    if invoice.status != "open":
+        raise DomainError(
+            "E_BAD_STATE",
+            f"invoice {invoice_id} is {invoice.status}; only open invoices can be written off",
+        )
+    invoice.status = "written_off"
+    invoice.written_off_at = clock.now()
+    events.emit("invoice.written_off", invoice.id, amount_cents=amount.cents)
+    return amount
