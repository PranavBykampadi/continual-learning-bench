diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_invoice_write_off.py b/tests/unit/test_invoice_write_off.py
--- a/tests/unit/test_invoice_write_off.py	1969-12-31 19:00:00
+++ b/tests/unit/test_invoice_write_off.py	2026-11-12 04:22:41
@@ -0,0 +1,55 @@
+from datetime import datetime, timezone
+
+import pytest
+
+from parcelo import clock, events, invoices
+from parcelo.errors import DomainError
+from parcelo.models import Invoice
+from parcelo.money import Money
+from parcelo.store import db
+
+MOMENT = datetime(2026, 11, 12, 9, 30, tzinfo=timezone.utc)
+
+
+def _invoice(status="open", amount=12.34):
+    inv = Invoice(id="inv_1", shipment_id="shp_1", amount=amount, status=status)
+    db.invoices[inv.id] = inv
+    return inv
+
+
+def test_write_off_open_invoice():
+    clock.set_fixed(MOMENT)
+    inv = _invoice()
+    result = invoices.write_off(inv.id)
+    assert result == Money(1234)
+    assert inv.status == "written_off"
+    assert inv.written_off_at == MOMENT
+    assert events.OUTBOX[-1]["name"] == "invoice.written_off"
+    assert events.OUTBOX[-1]["entity_id"] == inv.id
+
+
+def test_write_off_is_idempotent():
+    clock.set_fixed(MOMENT)
+    inv = _invoice()
+    invoices.write_off(inv.id)
+    clock.set_fixed(datetime(2027, 1, 1, tzinfo=timezone.utc))
+    assert invoices.write_off(inv.id) == Money(1234)
+    assert inv.status == "written_off"
+    assert inv.written_off_at == MOMENT
+    assert len(events.OUTBOX) == 1
+
+
+def test_write_off_paid_invoice_rejected():
+    inv = _invoice(status="paid")
+    with pytest.raises(DomainError) as err:
+        invoices.write_off(inv.id)
+    assert err.value.code == "E_BAD_STATE"
+    assert inv.status == "paid"
+    assert inv.written_off_at is None
+    assert events.OUTBOX == []
+
+
+def test_write_off_unknown_invoice():
+    with pytest.raises(DomainError) as err:
+        invoices.write_off("inv_missing")
+    assert err.value.code == "E_NOT_FOUND"
