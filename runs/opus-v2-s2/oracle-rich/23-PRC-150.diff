diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_customers_credit_limit.py b/tests/unit/test_customers_credit_limit.py
--- a/tests/unit/test_customers_credit_limit.py	1969-12-31 19:00:00
+++ b/tests/unit/test_customers_credit_limit.py	2026-11-12 04:25:26
@@ -0,0 +1,52 @@
+import pytest
+
+from parcelo import customers, events
+from parcelo.errors import DomainError
+from parcelo.money import Money
+
+
+def test_sets_and_returns_new_limit():
+    c = customers.add_customer("Acme")
+    limit = customers.set_credit_limit(c.id, 1250.5)
+    assert limit == Money(125050)
+    assert customers.get_customer(c.id).credit_limit == Money(125050)
+
+
+def test_accepts_money_and_zero():
+    c = customers.add_customer("Acme")
+    assert customers.set_credit_limit(c.id, Money(9900)) == Money(9900)
+    assert customers.set_credit_limit(c.id, 0) == Money(0)
+
+
+def test_emits_event():
+    c = customers.add_customer("Acme")
+    customers.set_credit_limit(c.id, "300")
+    event = events.OUTBOX[-1]
+    assert event["name"] == "customer.credit_limit_set"
+    assert event["entity_id"] == c.id
+    assert event["payload"] == {"credit_limit_cents": 30000}
+
+
+def test_unknown_customer_fails():
+    with pytest.raises(DomainError) as err:
+        customers.set_credit_limit("nope", 100)
+    assert err.value.code == "E_UNKNOWN_CUSTOMER"
+    assert events.OUTBOX == []
+
+
+@pytest.mark.parametrize("amount", [-1, -0.01, Money(-5)])
+def test_negative_amount_fails(amount):
+    c = customers.add_customer("Acme")
+    with pytest.raises(DomainError) as err:
+        customers.set_credit_limit(c.id, amount)
+    assert err.value.code == "E_BAD_INPUT"
+    assert customers.get_customer(c.id).credit_limit == 500.0
+    assert events.OUTBOX == []
+
+
+@pytest.mark.parametrize("amount", [None, "abc", True])
+def test_invalid_amount_fails(amount):
+    c = customers.add_customer("Acme")
+    with pytest.raises(DomainError) as err:
+        customers.set_credit_limit(c.id, amount)
+    assert err.value.code == "E_BAD_INPUT"
