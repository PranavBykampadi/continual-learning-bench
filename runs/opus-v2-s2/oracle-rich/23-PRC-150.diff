+def set_credit_limit(customer_id, amount):
+    """Set a customer's credit limit and return the new limit as Money."""
+    customer = db.customers.get(customer_id)
+    if customer is None:
+        raise DomainError("E_UNKNOWN_CUSTOMER", f"no customer {customer_id}")
+    if amount is None or isinstance(amount, bool):
+        raise DomainError("E_BAD_INPUT", "credit limit amount required")
+    try:
+        limit = Money.parse(amount)
+    except (InvalidOperation, ValueError, TypeError):
+        raise DomainError("E_BAD_INPUT", f"invalid credit limit {amount!r}") from None
+    if limit.cents < MIN_CREDIT_LIMIT_CENTS:
+        raise DomainError("E_BAD_INPUT", "credit limit must not be negative")
+    customer.credit_limit = limit
+    events.emit("customer.credit_limit_set", customer.id, credit_limit_cents=limit.cents)
+    return limit
