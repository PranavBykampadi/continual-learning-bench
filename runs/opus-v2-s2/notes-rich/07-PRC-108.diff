+import copy
+
+import pytest
+
+from parcelo import audit, reports
+from parcelo.models import Customer, Invoice, Shipment
+from parcelo.money import Money
+from parcelo.store import db
+
+
+def _seed_customer(cid):
+    db.customers[cid] = Customer(id=cid, name=cid)
+
+
+def _seed_invoice(iid, customer_id, amount, status="open"):
+    sid = "shp_" + iid
+    db.shipments[sid] = Shipment(id=sid, customer_id=customer_id, weight_kg=1.0, zone="local")
+    db.invoices[iid] = Invoice(id=iid, shipment_id=sid, amount=amount, status=status)
+
+
+def test_empty_store_returns_empty_dict():
+    assert reports.outstanding_by_customer() == {}
+    assert audit.LOG == []
+
+
+def test_sums_open_invoices_per_customer():
+    _seed_customer("cus_a")
+    _seed_customer("cus_b")
+    _seed_invoice("inv_1", "cus_a", 10.10)
+    _seed_invoice("inv_2", "cus_a", 0.20)
+    _seed_invoice("inv_3", "cus_b", 5.00)
+
+    assert reports.outstanding_by_customer() == {
+        "cus_a": Money(1030),
+        "cus_b": Money(500),
+    }
+
+
+@pytest.mark.parametrize("status", ["paid", "void"])
+def test_closed_invoices_are_excluded(status):
+    _seed_customer("cus_a")
+    _seed_invoice("inv_1", "cus_a", 12.00)
+    _seed_invoice("inv_2", "cus_a", 99.99, status=status)
+
+    assert reports.outstanding_by_customer() == {"cus_a": Money(1200)}
+
+
+def test_customer_without_open_invoices_owes_zero():
+    _seed_customer("cus_a")
+    _seed_customer("cus_b")
+    _seed_invoice("inv_1", "cus_a", 3.00, status="paid")
+
+    assert reports.outstanding_by_customer() == {
+        "cus_a": Money.zero(),
+        "cus_b": Money.zero(),
+    }
+
+
+def test_is_read_only():
+    _seed_customer("cus_a")
+    _seed_invoice("inv_1", "cus_a", 7.50)
+    _seed_invoice("inv_2", "cus_a", 2.50, status="paid")
+    before = copy.deepcopy((db.customers, db.shipments, db.invoices))
+
+    reports.outstanding_by_customer()
+
+    assert (db.customers, db.shipments, db.invoices) == before
+    assert audit.LOG == []
