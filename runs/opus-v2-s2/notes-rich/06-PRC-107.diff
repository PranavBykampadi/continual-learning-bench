diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/parcelo/shipments.py b/parcelo/shipments.py
--- a/parcelo/shipments.py	2026-11-10 12:17:53
+++ b/parcelo/shipments.py	2026-11-12 04:15:37
@@ -28,3 +28,24 @@
     if shipment_id not in db.shipments:
         raise DomainError("E_NOT_FOUND", shipment_id)
     return db.shipments[shipment_id]
+
+
+UNDELIVERABLE_STATUSES = ("cancelled", "delivered")
+
+
+def mark_delivered(shipment_id):
+    """Mark a shipment as delivered at the current time.
+
+    Raises E_NOT_FOUND if the shipment does not exist and E_BAD_STATE if it is
+    cancelled or already delivered.
+    """
+    shipment = get_shipment(shipment_id)
+    if shipment.status in UNDELIVERABLE_STATUSES:
+        raise DomainError(
+            "E_BAD_STATE",
+            f"shipment {shipment_id} cannot be delivered: status is {shipment.status}",
+        )
+    shipment.status = "delivered"
+    shipment.delivered_at = clock.now()
+    audit.record("shipment.delivered", shipment.id)
+    return shipment
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_mark_delivered_shipment.py b/tests/unit/test_mark_delivered_shipment.py
--- a/tests/unit/test_mark_delivered_shipment.py	1969-12-31 19:00:00
+++ b/tests/unit/test_mark_delivered_shipment.py	2026-11-12 04:15:44
@@ -0,0 +1,64 @@
+from datetime import datetime, timezone
+
+import pytest
+
+from parcelo import audit, clock, shipments
+from parcelo.errors import DomainError
+from parcelo.models import Shipment
+from parcelo.store import db
+
+NOW = datetime(2026, 11, 12, 9, 30, tzinfo=timezone.utc)
+
+
+def _seed(status="created"):
+    db.shipments["shp_1"] = Shipment(
+        id="shp_1", customer_id="cus_1", weight_kg=2.0, zone="local", status=status
+    )
+    return db.shipments["shp_1"]
+
+
+@pytest.mark.parametrize("status", ["created", "in_transit"])
+def test_marks_shipment_delivered(status):
+    clock.set_fixed(NOW)
+    seeded = _seed(status)
+
+    result = shipments.mark_delivered("shp_1")
+
+    assert result is seeded
+    assert result.status == "delivered"
+    assert result.delivered_at == NOW
+    assert db.shipments["shp_1"].status == "delivered"
+
+
+def test_records_audit_entry():
+    clock.set_fixed(NOW)
+    _seed()
+
+    shipments.mark_delivered("shp_1")
+
+    assert audit.LOG == [
+        {"action": "shipment.delivered", "entity_id": "shp_1", "at": NOW, "details": {}}
+    ]
+
+
+def test_unknown_shipment_fails():
+    with pytest.raises(DomainError) as err:
+        shipments.mark_delivered("shp_missing")
+
+    assert err.value.code == "E_NOT_FOUND"
+    assert db.shipments == {}
+    assert audit.LOG == []
+
+
+@pytest.mark.parametrize("status", ["cancelled", "delivered"])
+def test_bad_state_fails(status):
+    clock.set_fixed(NOW)
+    seeded = _seed(status)
+
+    with pytest.raises(DomainError) as err:
+        shipments.mark_delivered("shp_1")
+
+    assert err.value.code == "E_BAD_STATE"
+    assert seeded.status == status
+    assert seeded.delivered_at is None
+    assert audit.LOG == []
