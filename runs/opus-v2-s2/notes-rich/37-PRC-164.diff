diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/parcelo/vouchers.py b/parcelo/vouchers.py
--- a/parcelo/vouchers.py	1969-12-31 19:00:00
+++ b/parcelo/vouchers.py	2026-11-12 04:48:02
@@ -0,0 +1,48 @@
+from decimal import Decimal, InvalidOperation
+
+from parcelo import clock, events, ids, settings
+from parcelo.errors import DomainError
+from parcelo.models import Voucher
+from parcelo.money import Money
+from parcelo.store import db
+
+
+def _parse_amount(amount):
+    if isinstance(amount, Money):
+        return amount
+    if isinstance(amount, bool) or not isinstance(amount, (int, float, Decimal, str)):
+        raise DomainError("E_BAD_INPUT", repr(amount))
+    if isinstance(amount, str) and not amount.strip():
+        raise DomainError("E_BAD_INPUT", repr(amount))
+    try:
+        money = Money.parse(amount.strip() if isinstance(amount, str) else amount)
+    except (InvalidOperation, ValueError, OverflowError):
+        raise DomainError("E_BAD_INPUT", repr(amount))
+    return money
+
+
+def issue_voucher(customer_id, amount):
+    """Issue a goodwill voucher worth ``amount`` to a customer.
+
+    Not idempotent: every successful call creates a new voucher and emits
+    ``voucher.issued``. Failed calls create nothing and emit no event.
+    The amount must be positive and at most ``settings.VOUCHER_MAX``.
+    """
+    if not isinstance(customer_id, str) or not customer_id.strip():
+        raise DomainError("E_BAD_INPUT", repr(customer_id))
+    money = _parse_amount(amount)
+    if customer_id not in db.customers:
+        raise DomainError("E_UNKNOWN_CUSTOMER", customer_id)
+    if money.cents <= 0:
+        raise DomainError("E_BAD_INPUT", repr(amount))
+    if settings.VOUCHER_MAX < money:
+        raise DomainError("E_LIMIT", f"{money} exceeds {settings.VOUCHER_MAX}")
+    voucher = Voucher(
+        id=ids.new_id("vch"),
+        customer_id=customer_id,
+        amount=money,
+        issued_at=clock.now(),
+    )
+    db.vouchers[voucher.id] = voucher
+    events.emit("voucher.issued", voucher.id)
+    return voucher
