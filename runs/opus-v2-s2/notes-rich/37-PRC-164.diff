+from datetime import datetime, timezone
+from decimal import Decimal
+
+import pytest
+
+from parcelo import clock, events, settings, store, vouchers
+from parcelo.errors import DomainError
+from parcelo.models import Customer, Voucher
+from parcelo.money import Money
+from parcelo.store import db
+
+NOW = datetime(2026, 11, 12, 9, 0, tzinfo=timezone.utc)
+
+
+@pytest.fixture
+def cust():
+    clock.set_fixed(NOW)
+    db.customers["C1"] = Customer(id="C1", name="Acme")
+    db.customers["C2"] = Customer(id="C2", name="Other")
+    return db.customers["C1"]
+
+
+def test_happy_path(cust):
+    v = vouchers.issue_voucher("C1", Money(2500))
+    assert isinstance(v, Voucher)
+    assert v.id.startswith("vch_")
+    assert v.customer_id == "C1"
+    assert v.amount == Money(2500)
+    assert v.issued_at == NOW
+    assert db.vouchers == {v.id: v}
+    assert events.OUTBOX[-1]["name"] == "voucher.issued"
+    assert events.OUTBOX[-1]["entity_id"] == v.id
+
+
+def test_model_defaults():
+    v = Voucher(id="v", customer_id="C1")
+    assert v.amount is None and v.issued_at is None
+
+
+def test_store_starts_empty_and_reset_clears(cust):
+    assert db.vouchers == {}
+    vouchers.issue_voucher("C1", 10)
+    store.reset()
+    assert db.vouchers == {}
+
+
