+# Thresholds copied from legacy billing.volume_tier (parcelo.legacy is
+# scheduled for deletion, so it must not be imported here).
+_VOLUME_TIERS = ((50, "bulk"), (10, "regular"))
+_DEFAULT_VOLUME_TIER = "starter"
+
+
+def _volume_tier(shipment_count):
+    for threshold, label in _VOLUME_TIERS:
+        if shipment_count >= threshold:
+            return label
+    return _DEFAULT_VOLUME_TIER
+
+
+def volume_report():
+    """Return {customer_id: {"shipments": count, "tier": label}} for every customer.
+
+    Customers with no shipments are included with a count of 0. Shipments whose
+    customer is not in the store are ignored. Read-only: emits no events.
+    """
+    counts = {customer_id: 0 for customer_id in db.customers}
+    for shipment in db.shipments.values():
+        if shipment.customer_id in counts:
+            counts[shipment.customer_id] += 1
+    return {
+        customer_id: {"shipments": count, "tier": _volume_tier(count)}
+        for customer_id, count in counts.items()
+    }
+
+
