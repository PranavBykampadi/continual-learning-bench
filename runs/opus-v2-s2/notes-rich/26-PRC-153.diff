+import copy
+from datetime import datetime, timezone
+
+import pytest
+
+from parcelo import clock, customers, events
+from parcelo.errors import DomainError
+from parcelo.models import Customer, Invoice, Shipment
+from parcelo.store import db
+
+T0 = datetime(2026, 11, 12, 9, 0, tzinfo=timezone.utc)
+
+
+@pytest.fixture(autouse=True)
+def fixed_clock():
+    clock.set_fixed(T0)
+    yield
+    clock.clear_fixed()
+
+
+def _seed_customer(cid="C1", active=True):
+    c = Customer(id=cid, name="Cust " + cid, active=active)
+    db.customers[cid] = c
+    return c
+
+
+def _seed_shipment(sid, cid):
+    s = Shipment(id=sid, customer_id=cid, weight_kg=1.0, zone="local", created_at=T0)
+    db.shipments[sid] = s
+    return s
+
+
+def _seed_invoice(iid, cid, amount, status="open", sid=None):
+    sid = sid or "shp_" + iid
+    if sid not in db.shipments:
+        _seed_shipment(sid, cid)
+    inv = Invoice(id=iid, shipment_id=sid, amount=amount, status=status, issued_at=T0)
+    db.invoices[iid] = inv
+    return inv
+
+
+def _snapshot():
+    return copy.deepcopy((db.customers, db.shipments, db.invoices))
+
+
+def _assert_rejected(code, *args):
+    before = _snapshot()
+    with pytest.raises(DomainError) as err:
+        customers.needs_review(*args)
+    assert err.value.code == code
+    assert _snapshot() == before
+    assert events.OUTBOX == []
+
+
+def _check(cid, expected):
+    before = _snapshot()
+    assert customers.needs_review(cid) is expected
+    assert _snapshot() == before
+    assert events.OUTBOX == []
+
+
+# --- happy paths -----------------------------------------------------------
+
+
+def test_no_invoices_is_false():
+    _seed_customer()
+    _check("C1", False)
+
+
+@pytest.mark.parametrize("n, expected", [(2, False), (3, False), (4, True)])
+def test_open_invoice_count_boundary(n, expected):
+    _seed_customer()
+    for i in range(n):
+        _seed_invoice(f"I{i}", "C1", 1.00)
+    _check("C1", expected)
+
+
+@pytest.mark.parametrize(
+    "amounts, expected",
+    [
+        ([249.99], False),
+        ([250.00], False),  # exactly 250.00 is not "over"
+        ([250.01], True),
+        ([100.00, 150.00], False),  # 250.00
+        ([100.00, 150.01], True),  # 250.01
+    ],
+)
+def test_open_total_boundary(amounts, expected):
+    _seed_customer()
+    for i, a in enumerate(amounts):
+        _seed_invoice(f"I{i}", "C1", a)
+    _check("C1", expected)
+
+
+def test_float_amounts_summed_exactly():
+    # 0.1 + 0.2 style float drift must not push the total over 250.00:
+    # 83.33 + 83.33 + 83.34 = 250.00 exactly in cents.
+    _seed_customer()
+    for i, a in enumerate([83.33, 83.33, 83.34]):
+        _seed_invoice(f"I{i}", "C1", a)
+    _check("C1", False)
+
+
+def test_half_cent_amount_rounds_half_up():
+    # 250.005 -> Money.parse rounds ROUND_HALF_UP to 250.01 (25001 cents) > 250.00
+    _seed_customer()
+    _seed_invoice("I1", "C1", "250.005")
+    _check("C1", True)
+
+
+@pytest.mark.parametrize("status", ["paid", "void", "OPEN", "Open", "", None])
+def test_non_open_invoices_ignored(status):
+    _seed_customer()
+    for i in range(5):
+        _seed_invoice(f"I{i}", "C1", 100.00, status=status)
+    _check("C1", False)
+
+
