+
+
+REVIEW_MAX_OPEN_INVOICES = 3
+REVIEW_MAX_OPEN_TOTAL = Money.parse("250.00")
+
+
+def needs_review(customer_id):
+    """True if the customer has more than 3 open invoices or more than 250.00 open.
+
+    Read-only: no events, no store changes. Invoices whose shipment is missing
+    (orphans) are ignored.
+    """
+    if not isinstance(customer_id, str) or not customer_id.strip():
+        raise DomainError("E_BAD_INPUT", repr(customer_id))
+    if customer_id not in db.customers:
+        raise DomainError("E_NOT_FOUND", customer_id)
+    count = 0
+    total = Money.zero()
+    for invoice in db.invoices.values():
+        if invoice.status != "open":
+            continue
+        shipment = db.shipments.get(invoice.shipment_id)
+        if shipment is None or shipment.customer_id != customer_id:
+            continue
+        count += 1
+        total = total + Money.parse(invoice.amount)
+    return count > REVIEW_MAX_OPEN_INVOICES or REVIEW_MAX_OPEN_TOTAL < total
