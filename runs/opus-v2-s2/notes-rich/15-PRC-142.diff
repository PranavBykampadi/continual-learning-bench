+def reopen_invoice(invoice_id):
+    if not isinstance(invoice_id, str) or not invoice_id.strip():
+        raise DomainError("E_BAD_INPUT", repr(invoice_id))
+    invoice = db.invoices.get(invoice_id)
+    if invoice is None:
+        raise DomainError("E_NOT_FOUND", invoice_id)
+    if invoice.status != "paid":
+        raise DomainError("E_BAD_STATE", f"{invoice_id} is {invoice.status}")
+    previous_paid_at = invoice.paid_at
+    now = clock.now()
+    invoice.status = "open"
+    invoice.paid_at = None
+    invoice.reopened_at = now
+    events.emit(
+        "invoice.reopened",
+        invoice.id,
+        status_before="paid",
+        status_after="open",
+        paid_at_before=previous_paid_at,
+        reopened_at=now,
+    )
     return invoice
 
 
