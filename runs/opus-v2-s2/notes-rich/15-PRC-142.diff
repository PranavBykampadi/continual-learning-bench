+import copy
+from datetime import datetime, timedelta, timezone
+
+import pytest
+
+from parcelo import clock, events, invoices
+from parcelo.errors import DomainError
+from parcelo.models import Customer, Invoice, Shipment
+from parcelo.store import db
+
+T0 = datetime(2026, 11, 12, 9, 0, tzinfo=timezone.utc)
+PAID_AT = datetime(2026, 11, 10, 15, 30, tzinfo=timezone.utc)
+
+
+def _seed_customer(cid="cus_1"):
+    c = Customer(id=cid, name="Acme")
+    db.customers[cid] = c
+    return c
+
+
+def _seed_shipment(sid="shp_1", customer_id="cus_1"):
+    s = Shipment(id=sid, customer_id=customer_id, weight_kg=2.0, zone="local")
+    db.shipments[sid] = s
+    return s
+
+
+def _seed_invoice(iid, status="paid", paid_at=PAID_AT, shipment_id="shp_1"):
+    inv = Invoice(
+        id=iid,
+        shipment_id=shipment_id,
+        amount=12.5,
+        status=status,
+        issued_at=PAID_AT - timedelta(days=5),
+        paid_at=paid_at,
+    )
+    db.invoices[iid] = inv
+    return inv
+
+
+@pytest.fixture(autouse=True)
+def _setup():
+    clock.set_fixed(T0)
+    _seed_customer()
+    _seed_shipment()
+
+
+def _snapshot():
+    return copy.deepcopy(
+        {"customers": db.customers, "shipments": db.shipments, "invoices": db.invoices}
+    )
+
+
+def _assert_rejected(code, *args):
+    before = _snapshot()
+    with pytest.raises(DomainError) as err:
+        invoices.reopen_invoice(*args)
+    assert err.value.code == code
+    assert _snapshot() == before
+    assert events.OUTBOX == []
+
+
+def test_reopens_paid_invoice():
+    inv = _seed_invoice("INV-1")
+    other = _seed_invoice("INV-2")
+    other_before = copy.deepcopy(other)
+
+    result = invoices.reopen_invoice("INV-1")
+
+    assert result is inv
+    assert db.invoices["INV-1"] is inv
+    assert inv.status == "open"
+    assert inv.paid_at is None
+    assert inv.reopened_at == T0
+    assert db.invoices["INV-2"] == other_before
+    assert events.OUTBOX == [
+        {
+            "name": "invoice.reopened",
+            "entity_id": "INV-1",
+            "at": T0,
+            "payload": {
+                "status_before": "paid",
+                "status_after": "open",
+                "paid_at_before": PAID_AT,
+                "reopened_at": T0,
+            },
+        }
+    ]
+
+
+def test_reopened_invoice_listed_as_open():
+    _seed_invoice("INV-1")
+    invoices.reopen_invoice("INV-1")
+    assert [i.id for i in invoices.open_invoices()] == ["INV-1"]
+
+
+def test_new_invoice_has_no_reopened_at():
+    inv = Invoice(id="INV-X", shipment_id="shp_1", amount=1.0)
+    assert inv.reopened_at is None
+
+
+def test_reopen_pay_reopen_again_emits_each_event():
+    inv = _seed_invoice("INV-1")
+    invoices.reopen_invoice("INV-1")
+
+    inv.status = "paid"
+    second_paid_at = T0 + timedelta(hours=1)
+    inv.paid_at = second_paid_at
+    t1 = T0 + timedelta(hours=2)
+    clock.set_fixed(t1)
+    invoices.reopen_invoice("INV-1")
+
+    assert inv.reopened_at == t1
+    assert [(e["name"], e["at"], e["payload"]["paid_at_before"]) for e in events.OUTBOX] == [
+        ("invoice.reopened", T0, PAID_AT),
+        ("invoice.reopened", t1, second_paid_at),
+    ]
+
+
+def test_unknown_invoice_on_empty_store():
+    _assert_rejected("E_NOT_FOUND", "INV-missing")
+
+
+def test_unknown_invoice():
+    _seed_invoice("INV-1")
+    _assert_rejected("E_NOT_FOUND", "INV-missing")
+
+
+def test_wrong_case_id_not_found():
+    _seed_invoice("INV-1")
+    _assert_rejected("E_NOT_FOUND", "inv-1")
+
+
+@pytest.mark.parametrize("status", ["open", "void", "PAID", ""])
+def test_not_paid_rejected(status):
+    _seed_invoice("INV-1", status=status, paid_at=None)
+    _assert_rejected("E_BAD_STATE", "INV-