@@ -0,0 +1,170 @@
+import ast
+import copy
+import pathlib
+from datetime import datetime, timedelta, timezone
+
+import pytest
+
+from parcelo import clock, disputes, events, store
+from parcelo.errors import DomainError
+from parcelo.models import Customer, Dispute, Invoice, Shipment
+from parcelo.store import db
+
+T0 = datetime(2026, 11, 1, 9, 30, tzinfo=timezone.utc)
+T1 = T0 + timedelta(hours=2)
+
+
+@pytest.fixture(autouse=True)
+def fixed_clock():
+    clock.set_fixed(T0)
+    yield
+    clock.clear_fixed()
+
+
+def _seed_customer(cid="cus_1"):
+    c = Customer(id=cid, name="Acme")
+    db.customers[cid] = c
+    return c
+
+
+def _seed_shipment(sid="shp_1", cid="cus_1"):
+    s = Shipment(id=sid, customer_id=cid, weight_kg=2.0, zone="local", created_at=T0)
+    db.shipments[sid] = s
+    return s
+
+
+def _seed_invoice(iid="inv_1", sid="shp_1", status="open"):
+    i = Invoice(id=iid, shipment_id=sid, amount=12.5, status=status, issued_at=T0)
+    db.invoices[iid] = i
+    return i
+
+
+def _seed_all():
+    _seed_customer()
+    _seed_shipment()
+    return _seed_invoice()
+
+
+def _snapshot():
+    return copy.deepcopy(
+        {
+            "customers": db.customers,
+            "shipments": db.shipments,
+            "invoices": db.invoices,
+            "disputes": db.disputes,
+        }
+    )
+
+
+def _assert_rejected(code, *args):
+    before = _snapshot()
+    with pytest.raises(DomainError) as err:
+        disputes.open_dispute(*args)
+    assert err.value.code == code
+    assert _snapshot() == before
+    assert events.OUTBOX == []
+
+
+# --- happy path ---------------------------------------------------------------
+
+
+def test_open_dispute_creates_and_stores():
+    inv = _seed_all()
+    d = disputes.open_dispute("inv_1", "Package never arrived")
+    assert isinstance(d, Dispute)
+    assert d.id.startswith("dsp_")
+    assert d.invoice_id == "inv_1"
+    assert d.reason == "Package never arrived"
+    assert d.opened_at == T0
+    assert d.opened_at.tzinfo is not None
+    assert db.disputes[d.id] is d
+    assert list(db.disputes) == [d.id]
+    # the disputed invoice and unrelated entities are untouched
+    assert db.invoices["inv_1"] is inv
+    assert inv.status == "open"
+    assert inv.amount == 12.5
+    assert len(db.customers) == 1 and len(db.shipments) == 1
+
+
+def test_open_dispute_emits_event():
+    _seed_all()
+    d = disputes.open_dispute("inv_1", "Overcharged")
+    assert events.OUTBOX == [
+        {
+            "name": "dispute.opened",
+            "entity_id": d.id,
+            "at": T0,
+            "payload": {"invoice_id": "inv_1", "reason": "Overcharged"},
+        }
+    ]
+
+
+def test_multiple_disputes_get_distinct_ids_and_times():
+    _seed_all()
+    _seed_invoice("inv_2")
+    d1 = disputes.open_dispute("inv_1", "first")
+    clock.set_fixed(T1)
+    d2 = disputes.open_dispute("inv_2", "second")
+    assert d1.id != d2.id
+    assert d1.opened_at == T0 and d2.opened_at == T1
+    assert db.disputes == {d1.id: d1, d2.id: d2}
+    assert [e["at"] for e in events.OUTBOX] == [T0, T1]
+    assert [e["entity_id"] for e in events.OUTBOX] == [d1.id, d2.id]
+
+
+@pytest.mark.parametrize("status", ["open", "paid", "void", "written_off"])
+def test_any_invoice_status_can_be_disputed(status):
+    _seed_all()
+    db.invoices["inv_1"].status = status
+    d = disputes.open_dispute