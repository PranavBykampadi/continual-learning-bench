diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_create_refund.py b/tests/unit/test_create_refund.py
--- a/tests/unit/test_create_refund.py	1969-12-31 19:00:00
+++ b/tests/unit/test_create_refund.py	2026-11-12 04:13:51
@@ -0,0 +1,74 @@
+from datetime import datetime, timezone
+
+import pytest
+
+from parcelo import audit, clock, refunds
+from parcelo.errors import DomainError
+from parcelo.models import Invoice
+from parcelo.money import Money
+from parcelo.store import db
+
+FIXED = datetime(2026, 11, 12, 9, 30, tzinfo=timezone.utc)
+
+
+def _invoice(status):
+    inv = Invoice(id="INV-1", shipment_id="shp_000001", amount=20.0, status=status)
+    db.invoices[inv.id] = inv
+    return inv
+
+
+def test_refund_paid_invoice():
+    clock.set_fixed(FIXED)
+    _invoice("paid")
+    refund = refunds.create_refund("INV-1", 12.5)
+    assert refund.id.startswith("rfd_")
+    assert refund.invoice_id == "INV-1"
+    assert refund.amount == Money.parse("12.50")
+    assert refund.created_at == FIXED
+    assert db.refunds[refund.id] is refund
+    entry = audit.LOG[-1]
+    assert entry["action"] == "refund.created"
+    assert entry["entity_id"] == refund.id
+    assert entry["details"]["invoice_id"] == "INV-1"
+
+
+def test_refund_accepts_money():
+    _invoice("paid")
+    refund = refunds.create_refund("INV-1", Money(500))
+    assert refund.amount == Money(500)
+
+
+def test_unknown_invoice():
+    with pytest.raises(DomainError) as err:
+        refunds.create_refund("INV-nope", 5)
+    assert err.value.code == "E_NOT_FOUND"
+    assert db.refunds == {}
+    assert audit.LOG == []
+
+
+@pytest.mark.parametrize("status", ["open", "void"])
+def test_unpaid_invoice_rejected(status):
+    _invoice(status)
+    with pytest.raises(DomainError) as err:
+        refunds.create_refund("INV-1", 5)
+    assert err.value.code == "E_BAD_STATE"
+    assert db.refunds == {}
+    assert audit.LOG == []
+
+
+@pytest.mark.parametrize("amount", [0, -3.0])
+def test_non_positive_amount_rejected(amount):
+    _invoice("paid")
+    with pytest.raises(DomainError) as err:
+        refunds.create_refund("INV-1", amount)
+    assert err.value.code == "E_BAD_INPUT"
+    assert db.refunds == {}
+
+
+def test_reset_clears_refunds():
+    from parcelo import store
+
+    _invoice("paid")
+    refunds.create_refund("INV-1", 1)
+    store.reset()
+    assert db.refunds == {}
