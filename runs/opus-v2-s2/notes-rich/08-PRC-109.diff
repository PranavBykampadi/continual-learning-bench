+def add_address(customer_id, line, city):
+    if customer_id not in db.customers:
+        raise DomainError("E_UNKNOWN_CUSTOMER", f"customer {customer_id} does not exist")
+    if not isinstance(line, str) or not line.strip():
+        raise DomainError("E_BAD_INPUT", "street line must not be empty")
+    if not isinstance(city, str) or not city.strip():
+        raise DomainError("E_BAD_INPUT", "city must not be empty")
+    address = Address(
+        id=ids.new_id("adr"),
+        customer_id=customer_id,
+        line=line,
+        city=city,
+    )
+    db.addresses[address.id] = address
+    audit.record("address.added", address.id, customer_id=customer_id)
