+from parcelo.errors import DomainError
+from parcelo.legacy.billing import fuel_surcharge
+
 ZONE_BASE = {"local": 4.5, "national": 9.0, "international": 24.0}
 PER_KG = 1.25
 
@@ -12,3 +15,13 @@
     if weight_kg <= 0:
         raise ValueError("weight must be positive")
     return round(base_rate(zone) + PER_KG * weight_kg, 2)
+
+
+def quote_with_surcharge(weight_kg, zone):
+    """Normal quote for weight and zone plus the zone's fuel surcharge."""
+    if zone not in ZONE_BASE:
+        raise DomainError("E_BAD_ZONE", "unknown zone: %s" % zone)
+    if weight_kg <= 0:
+        raise DomainError("E_BAD_WEIGHT", "weight must be positive, got %s" % weight_kg)
+    amount = quote(weight_kg, zone)
+    return round(amount + fuel_surcharge(amount, zone), 2)
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_quote_with_surcharge.py b/tests/unit/test_quote_with_surcharge.py
--- a/tests/unit/test_quote_with_surcharge.py	1969-12-31 19:00:00
+++ b/tests/unit/test_quote_with_surcharge.py	2026-11-12 04:12:35
@@ -0,0 +1,31 @@
+import pytest
+
+from parcelo import rates
+from parcelo.errors import DomainError
+
+
+def test_local_has_no_surcharge():
+    assert rates.quote_with_surcharge(2, "local") == rates.quote(2, "local") == 7.0
+
+
+def test_national_adds_four_percent():
+    # quote = 9.0 + 1.25 * 4 = 14.00; surcharge 4% = 0.56
+    assert rates.quote_with_surcharge(4, "national") == 14.56
+
+
+def test_international_adds_nine_and_a_half_percent():
+    # quote = 24.0 + 1.25 * 8 = 34.00; surcharge 9.5% = 3.23
+    assert rates.quote_with_surcharge(8, "international") == 37.23
+
+
+def test_unknown_zone_rejected():
+    with pytest.raises(DomainError) as err:
+        rates.quote_with_surcharge(2, "moon")
+    assert err.value.code == "E_BAD_ZONE"
+
+
+@pytest.mark.parametrize("weight", [0, -1, -0.5])
+def test_non_positive_weight_rejected(weight):
+    with pytest.raises(DomainError) as err:
+        rates.quote_with_surcharge(weight, "local")
+    assert err.value.code == "E_BAD_WEIGHT"
