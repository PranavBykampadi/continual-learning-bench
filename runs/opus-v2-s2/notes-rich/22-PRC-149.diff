+def _is_number(value):
+    return isinstance(value, (int, float)) and not isinstance(value, bool)
+
+
+def _exact(value):
+    # Go through str() so that e.g. 0.1 + 0.2 compares equal to 0.3.
+    return Decimal(str(value))
+
+
+def split_shipment(shipment_id, weights):
+    """Replace a "created" shipment with one new shipment per weight.
+
+    The new shipments keep the original customer and zone and are returned
+    in the same order as ``weights``. The original is marked "split".
+    At least two weights are required, each must be a positive number, and
+    together they must add up exactly to the original weight.
+    """
+    if not isinstance(shipment_id, str) or shipment_id not in db.shipments:
+        raise DomainError("E_NOT_FOUND", str(shipment_id))
+    original = db.shipments[shipment_id]
+    if original.status != "created":
+        raise DomainError("E_BAD_STATE", f"{shipment_id} is {original.status}")
+    if not isinstance(weights, (list, tuple)) or len(weights) < 2:
+        raise DomainError("E_BAD_INPUT", "weights must be a list of at least two weights")
+    for weight in weights:
+        if not _is_number(weight) or not math.isfinite(weight) or weight <= 0:
+            raise DomainError("E_BAD_WEIGHT", str(weight))
+    if sum(_exact(w) for w in weights) != _exact(original.weight_kg):
+        raise DomainError(
+            "E_BAD_WEIGHT", f"weights do not add up to {original.weight_kg}"
+        )
+
+    now = clock.now()
+    parts = []
+    for weight in weights:
+        part = Shipment(
+            id=ids.new_id("shp"),
+            customer_id=original.customer_id,
+            weight_kg=weight,
+            zone=original.zone,
+            created_at=now,
+        )
+        db.shipments[part.id] = part
+        parts.append(part)
+    original.status = "split"
+    for part in parts:
+        events.emit("shipment.created", part.id, zone=part.zone)
+    events.emit("shipment.split", original.id, into=[p.id for p in parts])
+    return parts
