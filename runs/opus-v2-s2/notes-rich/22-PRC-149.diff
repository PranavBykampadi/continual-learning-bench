+import copy
+from datetime import datetime, timedelta, timezone
+
+import pytest
+
+from parcelo import clock, events, shipments
+from parcelo.errors import DomainError
+from parcelo.models import Customer, Shipment
+from parcelo.store import db
+
+T0 = datetime(2026, 11, 12, 9, 0, tzinfo=timezone.utc)
+STATUSES = ["created", "split", "in_transit", "delivered", "cancelled"]
+
+
+@pytest.fixture(autouse=True)
+def fixed_clock():
+    clock.set_fixed(T0)
+    yield
+    clock.clear_fixed()
+
+
+def _seed_customer(cid="cus_a"):
+    db.customers[cid] = Customer(id=cid, name="Acme")
+    return db.customers[cid]
+
+
+def _seed_shipment(sid="shp_orig", weight=10.0, status="created", zone="national", cid="cus_a"):
+    if cid not in db.customers:
+        _seed_customer(cid)
+    db.shipments[sid] = Shipment(
+        id=sid, customer_id=cid, weight_kg=weight, zone=zone, status=status,
+        created_at=T0 - timedelta(days=1), notes=["fragile"],
+    )
+    return db.shipments[sid]
+
+
+def _snapshot():
+    return copy.deepcopy((db.customers, db.shipments, db.invoices))
+
+
+def _assert_rejected(code, *args):
+    before = _snapshot()
+    with pytest.raises(DomainError) as err:
+        shipments.split_shipment(*args)
+    assert err.value.code == code
+    assert _snapshot() == before
+    assert events.OUTBOX == []
+
+
+def test_happy_path():
+    orig = _seed_shipment()
+    other = _seed_shipment("shp_other", weight=3.0)
+    parts = shipments.split_shipment("shp_orig", [6.0, 2.5, 1.5])
+
+    assert [p.weight_kg for p in parts] == [6.0, 2.5, 1.5]
+    assert len({p.id for p in parts}) == 3
+    for p in parts:
+        assert p.id.startswith("shp_")
+        assert db.shipments[p.id] is p
+        assert p.customer_id == "cus_a"
+        assert p.zone == "national"
+        assert p.status == "created"
+        assert p.created_at == T0
+        assert p.delivered_at is None
+        assert p.notes == []
+    assert db.shipments["shp_orig"] is orig
+    assert orig.status == "split"
+    assert orig.weight_kg == 10.0
+    assert orig.notes == ["fragile"]
+    assert orig.created_at == T0 - timedelta(days=1)
+    assert other.status == "created" and other.weight_kg == 3.0
+    assert len(db.shipments) == 5
+
+    assert events.OUTBOX == [
+        *[{"name": "shipment.created", "entity_id": p.id, "at": T0,
+           "payload": {"zone": "national"}} for p in parts],
+        {"name": "shipment.split", "entity_id": "shp_orig", "at": T0,
+         "payload": {"into": [p.id for p in parts]}},
+    ]
+
+
+def test_float_weights_sum_exactly():
+    # 0.1 + 0.2 != 0.3 in binary floats, but the split must accept it.
+    _seed_shipment(weight=0.3)
+    parts = shipments.split_shipment("shp_orig", [0.1, 0.2])
+    assert [p.weight_kg for p in parts] == [0.1, 0.2]
+
+
+de