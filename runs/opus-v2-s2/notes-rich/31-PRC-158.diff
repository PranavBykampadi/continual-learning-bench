diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_request_return.py b/tests/unit/test_request_return.py
--- a/tests/unit/test_request_return.py	1969-12-31 19:00:00
+++ b/tests/unit/test_request_return.py	2026-11-12 04:42:09
@@ -0,0 +1,82 @@
+import copy
+from datetime import datetime, timezone
+
+import pytest
+
+from parcelo import clock, events, returns
+from parcelo.errors import DomainError
+from parcelo.models import Customer, ReturnRequest, Shipment
+from parcelo.settings import MAX_RETURNS_PER_SHIPMENT
+from parcelo.store import db
+
+NOW = datetime(2026, 11, 12, 9, 0, tzinfo=timezone.utc)
+
+
+def _seed(status="delivered", sid="shp_1"):
+    db.customers.setdefault("cus_1", Customer(id="cus_1", name="Acme"))
+    db.shipments[sid] = Shipment(id=sid, customer_id="cus_1", weight_kg=1.0, zone="local", status=status)
+    return db.shipments[sid]
+
+
+def _snapshot():
+    return copy.deepcopy(
+        (db.customers, db.shipments, db.invoices, db.returns, list(events.OUTBOX))
+    )
+
+
+def _assert_rejected(code, *args):
+    before = _snapshot()
+    with pytest.raises(DomainError) as err:
+        returns.request_return(*args)
+    assert err.value.code == code
+    assert _snapshot() == before
+
+
+def test_happy_path_creates_saves_and_emits():
+    _seed()
+    clock.set_fixed(NOW)
+    r = returns.request_return("shp_1", "damaged")
+    assert isinstance(r, ReturnRequest)
+    assert r.id.startswith("ret_")
+    assert (r.shipment_id, r.reason, r.requested_at) == ("shp_1", "damaged", NOW)
+    assert db.returns[r.id] is r
+    assert events.OUTBOX[-1]["name"] == "return.requested"
+    assert events.OUTBOX[-1]["entity_id"] == r.id
+    assert len(events.OUTBOX) == 1
+
+
+d