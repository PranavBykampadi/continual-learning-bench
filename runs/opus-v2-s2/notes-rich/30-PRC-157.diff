diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_hold_invoice.py b/tests/unit/test_hold_invoice.py
--- a/tests/unit/test_hold_invoice.py	1969-12-31 19:00:00
+++ b/tests/unit/test_hold_invoice.py	2026-11-12 04:41:13
@@ -0,0 +1,72 @@
+import copy
+from datetime import datetime, timezone
+
+import pytest
+
+from parcelo import clock, events, invoices
+from parcelo.errors import DomainError
+from parcelo.models import Invoice
+from parcelo.money import Money
+from parcelo.store import db
+
+NOW = datetime(2026, 11, 12, 9, 30, tzinfo=timezone.utc)
+
+
+def _seed(inv_id="INV-1", status="open"):
+    inv = Invoice(id=inv_id, shipment_id="shp_1", amount=Money.parse("10.00"), status=status)
+    db.invoices[inv.id] = inv
+    return inv
+
+
+def _snapshot():
+    return copy.deepcopy((db.customers, db.shipments, db.invoices))
+
+
+def _assert_rejected(code, *args):
+    before = _snapshot()
+    with pytest.raises(DomainError) as err:
+        invoices.hold_invoice(*args)
+    assert err.value.code == code
+    assert _snapshot() == before
+    assert events.OUTBOX == []
+
+
+def test_holds_open_invoice():
+    clock.set_fixed(NOW)
+    inv = _seed()
+    result = invoices.hold_invoice("INV-1")
+    assert result is inv
+    assert result.status == "on_hold"
+    assert result.held_at == NOW
+    assert len(events.OUTBOX) == 1
+    assert events.OUTBOX[0]["name"] == "invoice.held"
+    assert events.OUTBOX[0]["entity_id"] == "INV-1"
+
+
+def test_idempotent_on_already_held():
+    clock.set_fixed(NOW)
+    _seed()
+    invoices.hold_invoice("INV-1")
+    events.OUTBOX.clear()
+    clock.set_fixed(datetime(2026, 12, 1, tzinfo=timezone.utc))
+    result = invoices.hold_invoice("INV-1")
+    assert result.status == "on_hold"
+    assert result.held_at == NOW
+    assert events.OUTBOX == []
+
+
+def test_unknown_invoice():
+    _seed()
+    _assert_rejected("E_UNKNOWN_INVOICE", "INV-missing")
+
+
+@pytest.mark.parametrize("bad", [None, "", "   ", 123, True, ["INV-1"]])
+def test_bad_input(bad):
+    _seed()
+    _assert_rejected("E_BAD_INPUT", bad)
+
+
+@pytest.mark.parametrize("status", ["paid", "void"])
+def test_non_open_rejected(status):
+    _seed(status=status)
+    _assert_rejected("E_BAD_STATE", "INV-1")
