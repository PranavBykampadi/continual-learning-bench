 def open_invoices():
     return [i for i in db.invoices.values() if i.status == "open"]
+
+
+def hold_invoice(invoice_id):
+    """Put an open invoice on hold. Idempotent: holding an on-hold invoice is a no-op."""
+    if not isinstance(invoice_id, str) or not invoice_id.strip():
+        raise DomainError("E_BAD_INPUT", repr(invoice_id))
+    invoice = db.invoices.get(invoice_id)
+    if invoice is None:
+        raise DomainError("E_UNKNOWN_INVOICE", invoice_id)
+    if invoice.status == "on_hold":
+        return invoice
+    if invoice.status != "open":
+        raise DomainError("E_BAD_STATE", invoice.status)
+    invoice.status = "on_hold"
+    invoice.held_at = clock.now()
+    events.emit("invoice.held", invoice.id)
+    return invoice
