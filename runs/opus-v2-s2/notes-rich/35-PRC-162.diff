@@ -32,3 +37,15 @@
 
 def open_invoices():
     return [i for i in db.invoices.values() if i.status == "open"]
+
+
+def invoices_by_status(status):
+    """Return invoices whose status is `status`, sorted by id ascending.
+
+    Read-only, emits no events. Raises DomainError("E_BAD_INPUT") unless
+    `status` is one of QUERYABLE_INVOICE_STATUSES.
+    """
+    if not isinstance(status, str) or status not in QUERYABLE_INVOICE_STATUSES:
+        raise DomainError("E_BAD_INPUT", f"invalid invoice status: {status!r}")
+    matches = [i for i in db.invoices.values() if i.status == status]
+    return sorted(matches, key=lambda i: i.id)
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_invoices_by_status.py b/tests/unit/test_invoices_by_status.py
--- a/tests/unit/test_invoices_by_status.py	1969-12-31 19:00:00
+++ b/tests/unit/test_invoices_by_status.py	2026-11-12 04:45:57
@@ -0,0 +1,46 @@
+import pytest
+
+from parcelo import events, invoices
+from parcelo.errors import DomainError
+from parcelo.models import Invoice
+from parcelo.store import db
+
+
+def _seed(inv_id, status):
+    db.invoices[inv_id] = Invoice(id=inv_id, shipment_id="shp_1", amount=10.0, status=status)
+
+
+def test_returns_open_sorted_by_id():
+    _seed("INV-c", "open")
+    _seed("INV-a", "open")
+    _seed("INV-b", "paid")
+    result = invoices.invoices_by_status("open")
+    assert [i.id for i in result] == ["INV-a", "INV-c"]
+
+
+def test_returns_paid():
+    _seed("INV-b", "paid")
+    _seed("INV-a", "open")
+    assert [i.id for i in invoices.invoices_by_status("paid")] == ["INV-b"]
+
+
+def test_empty_when_none_match():
+    assert invoices.invoices_by_status("open") == []
+    _seed("INV-a", "open")
+    assert invoices.invoices_by_status("paid") == []
+
+
+@pytest.mark.parametrize("bad", [None, "", "  ", 42, "void", "OPEN", " open"])
+def test_invalid_status_rejected(bad):
+    with pytest.raises(DomainError) as err:
+        invoices.invoices_by_status(bad)
+    assert err.value.code == "E_BAD_INPUT"
+
+
+def test_read_only_no_events_no_mutation():
+    _seed("INV-a", "open")
+    before = list(events.OUTBOX)
+    invoices.invoices_by_status("open")
+    assert list(events.OUTBOX) == before
+    assert db.invoices["INV-a"].status == "open"
+    assert db.invoices["INV-a"].paid_at is None
