     if shipment_id not in db.shipments:
         raise DomainError("E_NOT_FOUND", shipment_id)
     return db.shipments[shipment_id]
+
+
+def list_shipments(customer_id):
+    """Return a new list of the customer's shipments, in creation order.
+
+    Read-only: emits no events and does not modify the store.
+    """
+    if not isinstance(customer_id, str):
+        raise DomainError("E_BAD_INPUT", repr(customer_id))
+    if customer_id not in db.customers:
+        raise DomainError("E_UNKNOWN_CUSTOMER", customer_id)
+    return [s for s in db.shipments.values() if s.customer_id == customer_id]
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_list_shipments.py b/tests/unit/test_list_shipments.py
--- a/tests/unit/test_list_shipments.py	1969-12-31 19:00:00
+++ b/tests/unit/test_list_shipments.py	2026-11-12 04:34:41
@@ -0,0 +1,133 @@
+import copy
+from datetime import datetime, timedelta, timezone
+
+import pytest
+
+from parcelo import clock, events
+from parcelo.errors import DomainError
+from parcelo.models import Customer, Shipment
+from parcelo.shipments import list_shipments
+from parcelo.store import db
+
+T0 = datetime(2026, 11, 12, 9, 0, tzinfo=timezone.utc)
+
+
+@pytest.fixture(autouse=True)
+def fixed_clock():
+    clock.set_fixed(T0)
+    yield
+    clock.clear_fixed()
+
+
+def _seed_customer(cid="C1", **kw):
+    c = Customer(id=cid, name=kw.pop("name", "Acme"), **kw)
+    db.customers[cid] = c
+    return c
+
+
+def _seed_shipment(sid, customer_id, status="created", created_at=T0):
+    s = Shipment(id=sid, customer_id=customer_id, weight_kg=1.0, zone="local",
+                 status=status, created_at=created_at)
+    db.shipments[sid] = s
+    return s
+
+
+def _snapshot():
+    return copy.deepcopy((db.customers, db.shipments, db.invoices))
+
+
+def _assert_rejected(code, *args):
+    before = _snapshot()
+    with pytest.raises(DomainError) as err:
+        list_shipments(*args)
+    assert err.value.code == code
+    assert _snapshot() == before
+    assert events.OUTBOX == []
+
+
+def test_returns_only_customers_shipments_in_creation_order():
+    _seed_customer("C1")
+    _seed_customer("C2")
+    _seed_shipment("shp_1", "C1")
+    _seed_shipment("shp_2", "C2")
+    _seed_shipment("shp_3", "C1", created_at=T0 + timedelta(hours=1))
+    before = _snapshot()
+
+    result = list_shipments("C1")
+
+    assert [s.id for s in result] == ["shp_1", "shp_3"]
+    assert result[0] is db.shipments["shp_1"]
+    assert result[1] is db.shipments["shp_3"]
+    assert _snapshot() == before
+    assert len(db.shipments) == 3
+    assert events.OUTBOX == []
+
+
+@pytest.mark.parametrize("status", ["created", "in_transit", "delivered", "cancelled", "CREATED", ""])
+def test_includes_shipments_of_every_status(status):
+    _seed_customer("C1")
+    s = _seed_shipment("shp_1", "C1", status=status)
+    assert list_shipments("C1") == [s]
+
+
+def test_inactive_customer_still_listed():
+    _seed_customer("C1", active=False)
+    s = _seed_shipment("shp_1", "C1")
+    assert list_shipments("C1") == [s]
+
+
+def test_customer_without_shipments_returns_empty_list():
+    _seed_customer("C1")
+    _seed_customer("C2")
+    _seed_shipment("shp_1", "C2")
+    assert list_shipments("C1") == []
+    assert events.OUTBOX == []
+
+
+def test_orphan_shipments_are_ignored():
+    # Shipments pointing at a missing customer never match a real customer id.
+    _seed_customer("C1")
+    _seed_shipment("shp_orphan", "GONE")
+    assert list_shipments("C1") == []
+
+
+def test_fresh_list_each_call():
+    _seed_customer("C1")
+    _seed_shipment("shp_1", "C1")
+    first = list_shipments("C1")
+    first.clear()
+    second = list_shipments("C1")
+    assert len(second) == 1
+    assert second is not list_shipments("C1")
+    assert len(db.shipments) == 1
+
+
+def test_repeat_call_same_result():
+    _seed_customer("C1")
+    _seed_shipment("shp_1", "C1")
+    assert list_shipments("C1") == list_shipments("C1")
+    assert events.OUTBOX == []
+
+
+def test_unknown_customer_empty_store():
+    _assert_rejected("E_UNKNOWN_CUSTOMER", "C1")
+
+
+@pytest.mark.parametrize("cid", ["nope", "c1", "", "   ", "C1 "])
+def test_unknown_customer(cid):
+    _seed_customer("C1")
+    _seed_shipment("shp_1", "C1")
+    _assert_rejected("E_UNKNOWN_CUSTOMER", cid)
+
+
+def test_customer_with_only_orphan_shipments_still_rejected():
+    _seed_shipment("shp_1", "GONE")
+    _assert_rejected("E_UNKNOWN_CUSTOMER", "GONE")
+
+
+@pytest.mark.parametrize("cid", [None, 0, 1, -1, True, 1.5, float("nan"), float("inf"),
+                                 ["C1"], ("C1",), {"id": "C1"}, datetime(2026, 1, 1)])
+def test_bad_input(cid):
+    _seed_customer("C1")
+    _seed_shipment("shp_1", "C1")
+    _assert_rejected("E_BAD_INPUT", cid)
