+from datetime import datetime, timezone
+
+import pytest
+
+from parcelo import clock, events, invoices
+from parcelo.errors import DomainError
+from parcelo.models import Invoice
+from parcelo.store import db
+
+
+def seed(id_, amount=600.0, status="open"):
+    db.invoices[id_] = Invoice(id=id_, shipment_id="shp_1", amount=amount, status=status)
+    return db.invoices[id_]
+
+
+def test_happy_path_sets_status_and_emits():
+    clock.set_fixed(datetime(2026, 1, 1, tzinfo=timezone.utc))
+    inv = seed("inv_1")
+    result = invoices.escalate_invoice("inv_1")
+    assert result is inv
+    assert inv.status == "escalated"
+    assert events.OUTBOX[-1]["name"] == "invoice.escalated"
+    assert events.OUTBOX[-1]["entity_id"] == "inv_1"
+    assert len(events.OUTBOX) == 1
+
+
+def test_model_default_status_is_open_and_escalatable():
+    db.invoices["inv_d"] = Invoice(id="inv_d", shipment_id="s", amount=500)
+    assert invoices.escalate_invoice("inv_d").status == "escalated"
+
+
+@pytest.mark.parametrize("amount", [500.0, 500, "500.00", 500.004, 10_000.0])
+def test_at_or_above_limit(amount):
+    seed("inv_1", amount=amount)
+    assert invoices.escalate_invoice("inv_1").status == "escalated"
+
+
