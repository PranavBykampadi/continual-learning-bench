 def open_invoices():
     return [i for i in db.invoices.values() if i.status == "open"]
+
+
+def escalate_invoice(invoice_id):
+    """Escalate a large unpaid invoice to collections (status "escalated").
+
+    Idempotent: escalating an already-escalated invoice returns it unchanged
+    and emits no event. Only invoices with status exactly "open" and an amount
+    of at least ``settings.ESCALATION_MIN_AMOUNT`` (500.00, inclusive) can be
+    escalated; the amount is compared in exact cents via ``Money``.
+
+    Raises ``DomainError``:
+      - ``E_BAD_INPUT``: ``invoice_id`` is not a str or is blank.
+      - ``E_UNKNOWN_INVOICE``: no invoice with that id (ids are matched exactly).
+      - ``E_BAD_STATE``: invoice status is neither "open" nor "escalated"
+        (e.g. "paid").
+      - ``E_LIMIT``: open invoice whose amount is below the minimum.
+
+    On success sets status to "escalated", emits ``invoice.escalated`` and
+    returns the stored ``Invoice``. Failed calls mutate and emit nothing.
+    """
+    if not isinstance(invoice_id, str) or not invoice_id.strip():
+        raise DomainError("E_BAD_INPUT", repr(invoice_id))
+    invoice = db.invoices.get(invoice_id)
+    if invoice is None:
+        raise DomainError("E_UNKNOWN_INVOICE", invoice_id)
+    if invoice.status == "escalated":
+        return invoice
+    if invoice.status != "open":
+        raise DomainError("E_BAD_STATE", f"{invoice_id} is {invoice.status}")
+    if Money.parse(invoice.amount) < Money.parse(settings.ESCALATION_MIN_AMOUNT):
+        raise DomainError("E_LIMIT", f"{invoice_id} amount {invoice.amount} below minimum")
+    invoice.status = "escalated"
+    events.emit("invoice.escalated", invoice.id)
+    return invoice
