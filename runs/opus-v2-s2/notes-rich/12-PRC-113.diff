+def _parse_credit(amount):
+    if isinstance(amount, bool) or not isinstance(amount, (Money, int, float, str, Decimal)):
+        raise DomainError("E_BAD_INPUT", f"credit amount {amount!r} is not a money value")
+    try:
+        credit = Money.parse(amount.strip() if isinstance(amount, str) else amount)
+    except (InvalidOperation, ValueError, ArithmeticError) as exc:
+        raise DomainError("E_BAD_INPUT", f"credit amount {amount!r} is not a money value") from exc
+    if credit.cents <= 0:
+        raise DomainError("E_BAD_INPUT", f"credit amount {amount!r} must be positive")
+    return credit
+
+
+def apply_credit(invoice_id, amount):
+    """Reduce an open invoice's amount by a credit and return the remaining Money."""
+    if not isinstance(invoice_id, str) or invoice_id not in db.invoices:
+        raise DomainError("E_NOT_FOUND", f"invoice {invoice_id!r} does not exist")
+    invoice = db.invoices[invoice_id]
+    credit = _parse_credit(amount)
+    if invoice.status != "open":
+        raise DomainError(
+            "E_BAD_STATE", f"invoice {invoice_id!r} is {invoice.status!r}, not open"
+        )
+    current = Money.parse(invoice.amount)
+    if current < credit:
+        raise DomainError(
+            "E_BAD_INPUT", f"credit {credit} exceeds invoice {invoice_id!r} amount {current}"
+        )
+    remaining = current - credit
+    # Invoice.amount is a legacy float field read by reports and customer balances;
+    # write it back as an exact dollar value derived from integer cents.
+    invoice.amount = float(Decimal(remaining.cents) / 100)
+    audit.record(
+        "invoice.credit_applied",
+        invoice.id,
+        credit=credit,
+        previous=current,
+        remaining=remaining,
+    )
+    return remaining
