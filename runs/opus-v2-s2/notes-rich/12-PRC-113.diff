+import copy
+from datetime import datetime, timezone
+from decimal import Decimal
+
+import pytest
+
+from parcelo import audit, clock, customers, invoices, reports
+from parcelo.errors import DomainError
+from parcelo.models import Customer, Invoice, Shipment
+from parcelo.money import Money
+from parcelo.store import db
+
+T0 = datetime(2026, 11, 12, 9, 0, tzinfo=timezone.utc)
+T1 = datetime(2026, 11, 12, 10, 30, tzinfo=timezone.utc)
+
+
+def _seed_customer(cid="cus_000001"):
+    customer = Customer(id=cid, name="Acme")
+    db.customers[cid] = customer
+    return customer
+
+
+def _seed_shipment(sid="shp_000001", cid="cus_000001"):
+    shipment = Shipment(id=sid, customer_id=cid, weight_kg=2.0, zone="local")
+    db.shipments[sid] = shipment
+    return shipment
+
+
+def _seed_invoice(iid="inv_000001", sid="shp_000001", amount=100.0, status="open"):
+    invoice = Invoice(id=iid, shipment_id=sid, amount=amount, status=status, issued_at=T0)
+    db.invoices[iid] = invoice
+    return invoice
+
+
+def _seed_world(amount=100.0, status="open"):
+    _seed_customer()
+    _seed_shipment()
+    return _seed_invoice(amount=amount, status=status)
+
+
+def _snapshot():
+    return copy.deepcopy((db.customers, db.shipments, db.invoices))
+
+
+def _assert_rejected(code, *args):
+    before = _snapshot()
+    with pytest.raises(DomainError) as err:
+        invoices.apply_credit(*args)
+    assert err.value.code == code
+    assert _snapshot() == before
+    assert audit.LOG == []
+
+
+def test_happy_path_reduces_amount_and_audits():
+    clock.set_fixed(T0)
+    invoice = _seed_world(amount=100.0)
+    other = _seed_invoice(iid="inv_000002", amount=40.0)
+
+    remaining = invoices.apply_credit("inv_000001", Money(2550))
+
+    assert remaining == Money(7450)
+    assert db.invoices["inv_000001"] is invoice
+    assert invoice.amount == 74.50
+    assert invoice.status == "open"
+    assert invoice.paid_at is None
+    assert other.amount == 40.0
+    assert audit.LOG == [
+        {
+            "action": "invoice.credit_applied",
+            "entity_id": "inv_000001",
+            "at": T0,
+            "details": {
+                "credit": Money(2550),
+                "previous": Money(10000),
+                "remaining": Money(7450),
+            },
+        }
+    ]
+
+
+def test_successive_credits_each_audited_with_own_time():
+    clock.set_fixed(T0)
+    invoice = _seed_world(amount=50.0)
+    assert invoices.apply_credit("inv_000001", Money(1000)) == Money(4000)
+    clock.set_fixed(T1)
+    assert invoices.apply_credit("inv_000001", "15.25") == Money(2475)
+    assert invoice.amount == 24.75
+    assert [(e["at"], e["details"]["remaining"]) for e in audit.LOG] == [
+        (T0, Money(4000)),
+        (T1, Money(2475)),
+    ]
+    assert all(e["entity_id"] == "inv_000001" for e in audit.LOG)
+
+
