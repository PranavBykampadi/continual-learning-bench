@@ -0,0 +1,51 @@
+from decimal import Decimal, InvalidOperation
+
+from parcelo import audit, clock, ids
+from parcelo.errors import DomainError
+from parcelo.models import Claim
+from parcelo.money import Money
+from parcelo.store import db
+
+CLAIMABLE_STATUS = "delivered"
+
+
+def _parse_amount(amount):
+    # bool is an int subclass; True/False are never a meaningful amount.
+    if isinstance(amount, bool) or not isinstance(amount, (Money, int, float, Decimal, str)):
+        raise DomainError("E_BAD_INPUT", f"amount {amount!r} is not a valid money amount")
+    try:
+        money = Money.parse(amount.strip() if isinstance(amount, str) else amount)
+    except (InvalidOperation, ValueError, OverflowError):
+        raise DomainError("E_BAD_INPUT", f"amount {amount!r} is not a valid money amount")
+    if money.cents <= 0:
+        raise DomainError("E_BAD_INPUT", f"amount {amount!r} must be positive")
+    return money
+
+
+def _clean_reason(reason):
+    if not isinstance(reason, str) or not reason.strip():
+        raise DomainError("E_BAD_INPUT", f"reason {reason!r} must be a non-empty string")
+    return reason.strip()
+
+
+def file_claim(shipment_id, amount, reason):
+    shipment = db.shipments.get(shipment_id) if isinstance(shipment_id, str) else None
+    if shipment is None:
+        raise DomainError("E_NOT_FOUND", f"shipment {shipment_id!r} does not exist")
+    money = _parse_amount(amount)
+    clean_reason = _clean_reason(reason)
+    if shipment.status != CLAIMABLE_STATUS:
+        raise DomainError(
+            "E_BAD_STATE",
+            f"shipment {shipment_id!r} is {shipment.status!r}; only delivered shipments can have claims",
+        )
+    claim = Claim(
+        id=ids.new_id("clm"),
+        shipment_id=shipment_id,
+        amount=money,
+        reason=clean_reason,
+        filed_at=clock.now(),
+    )
+    db.claims[claim.id] = claim
+    audit.record("claim.filed", claim.id)
+    return claim
