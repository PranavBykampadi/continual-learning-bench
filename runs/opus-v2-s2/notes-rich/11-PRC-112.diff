diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_file_claim.py b/tests/unit/test_file_claim.py
--- a/tests/unit/test_file_claim.py	1969-12-31 19:00:00
+++ b/tests/unit/test_file_claim.py	2026-11-12 04:21:28
@@ -0,0 +1,169 @@
+import copy
+from datetime import datetime, timedelta, timezone
+from decimal import Decimal
+
+import pytest
+
+from parcelo import audit, claims, clock
+from parcelo.errors import DomainError
+from parcelo.models import Claim, Shipment
+from parcelo.money import Money
+from parcelo.store import db
+
+T0 = datetime(2026, 11, 12, 9, 0, tzinfo=timezone.utc)
+T1 = T0 + timedelta(hours=3)
+
+
+def _seed_shipment(shipment_id="shp_1", status="delivered"):
+    db.shipments[shipment_id] = Shipment(
+        id=shipment_id, customer_id="cus_1", weight_kg=2.0, zone="local", status=status
+    )
+    return db.shipments[shipment_id]
+
+
+def _snapshot():
+    return copy.deepcopy((db.shipments, db.claims))
+
+
+def _assert_rejected(code, *args):
+    before = _snapshot()
+    with pytest.raises(DomainError) as err:
+        claims.file_claim(*args)
+    assert err.value.code == code
+    assert _snapshot() == before
+    assert audit.LOG == []
+
+
+def test_files_claim_on_delivered_shipment():
+    clock.set_fixed(T0)
+    _seed_shipment()
+
+    claim = claims.file_claim("shp_1", "12.50", "box crushed")
+
+    assert claim == Claim(
+        id=claim.id,
+        shipment_id="shp_1",
+        amount=Money(1250),
+        reason="box crushed",
+        filed_at=T0,
+    )
+    assert claim.id.startswith("clm_")
+    assert db.claims == {claim.id: claim}
+    assert db.claims[claim.id] is claim
+    assert audit.LOG == [
+        {"action": "claim.filed", "entity_id": claim.id, "at": T0, "details": {}}
+    ]
+
+
+def test_does_not_change_shipment():
+    clock.set_fixed(T0)
+    shipment = _seed_shipment()
+    before = copy.deepcopy(shipment)
+
+    claims.file_claim("shp_1", 5, "late")
+
+    assert db.shipments["shp_1"] == before
+
+
+def test_multiple_claims_each_get_own_id_and_timestamp():
+    _seed_shipment()
+    clock.set_fixed(T0)
+    first = claims.file_claim("shp_1", 10, "dent")
+    clock.set_fixed(T1)
+    second = claims.file_claim("shp_1", 20, "water damage")
+
+    assert first.id != second.id
+    assert first.filed_at == T0
+    assert second.filed_at == T1
+    assert db.claims == {first.id: first, second.id: second}
+    assert audit.LOG == [
+        {"action": "claim.filed", "entity_id": first.id, "at": T0, "details": {}},
+        {"action": "claim.filed", "entity_id": second.id, "at": T1, "details": {}},
+    ]
+
+
+@pytest.mark.parametrize(
+    "