+import pytest
+
+from parcelo import customers, events, shipments
+from parcelo.errors import DomainError
+from parcelo.models import Invoice
+from parcelo.money import Money
+from parcelo.store import db
+
+
+def _seed(customer_id, n_shipments, amount=100.0, status="paid"):
+    for i in range(n_shipments):
+        s = shipments.create_shipment(customer_id, 1, "local")
+        inv_id = f"INV-{customer_id}-{i}"
+        db.invoices[inv_id] = Invoice(id=inv_id, shipment_id=s.id, amount=amount, status=status)
+
+
+def test_no_shipments_is_zero():
+    c = customers.add_customer("Acme")
+    assert customers.rebate_for(c.id) == Money.zero()
+
+
+def test_below_threshold_is_zero():
+    c = customers.add_customer("Acme")
+    _seed(c.id, 9)
+    assert customers.rebate_for(c.id) == Money.zero()
+
+
+def test_regular_tier_three_percent():
+    c = customers.add_customer("Acme")
+    _seed(c.id, 10)
+    assert customers.rebate_for(c.id) == Money.parse("30.00")
+
+
+def test_bulk_tier_six_percent():
+    c = customers.add_customer("Acme")
+    _seed(c.id, 50)
+    assert customers.rebate_for(c.id) == Money.parse("300.00")
+
+
+def test_only_paid_invoices_of_own_shipments_count():
+    c = customers.add_customer("Acme")
+    other = customers.add_customer("Other")
+    _seed(c.id, 10)
+    s = shipments.create_shipment(c.id, 1, "local")
+    db.invoices["open1"] = Invoice(id="open1", shipment_id=s.id, amount=500.0, status="open")
+    _seed(other.id, 10)
+    # 11 shipments, paid total 1000.00 -> 3%
+    assert customers.rebate_for(c.id) == Money.parse("30.00")
+
+
+def test_rounds_half_up_to_cents():
+    c = customers.add_customer("Acme")
+    _seed(c.id, 10, amount=0.05)  # 0.50 * 3% = 0.015 -> 0.02
+    assert customers.rebate_for(c.id) == Money(2)
+
+
+def test_read_only_emits_no_event():
+    c = customers.add_customer("Acme")
+    _seed(c.id, 10)
+    before = list(events.OUTBOX)
+    customers.rebate_for(c.id)
+    assert list(events.OUTBOX) == before
+
+
+def test_unknown_customer():
+    with pytest.raises(DomainError) as err:
+        customers.rebate_for("nope")
+    assert err.value.code == "E_UNKNOWN_CUSTOMER"
+
+
