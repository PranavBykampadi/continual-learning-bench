+def rebate_for(customer_id):
+    """Volume rebate a customer has earned on their paid invoices (read-only)."""
+    if not isinstance(customer_id, str) or not customer_id.strip():
+        raise DomainError("E_BAD_INPUT", repr(customer_id))
+    if db.customers.get(customer_id) is None:
+        raise DomainError("E_UNKNOWN_CUSTOMER", customer_id)
+
+    shipment_ids = {s.id for s in db.shipments.values() if s.customer_id == customer_id}
+    count = len(shipment_ids)
+    if count >= settings.REBATE_BULK_MIN_SHIPMENTS:
+        rate = settings.REBATE_BULK_RATE
+    elif count >= settings.REBATE_REGULAR_MIN_SHIPMENTS:
+        rate = settings.REBATE_REGULAR_RATE
+    else:
+        return Money.zero()
+
+    paid_total = Money.zero()
+    for invoice in db.invoices.values():
+        if invoice.shipment_id in shipment_ids and invoice.status == INVOICE_STATUS_PAID:
+            paid_total = paid_total + Money.parse(invoice.amount)
+    return paid_total.scale(rate)
