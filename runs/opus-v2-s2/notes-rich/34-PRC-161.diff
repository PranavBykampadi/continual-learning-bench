+"""Business constants. Every value carries a comment explaining what it controls."""
+from decimal import Decimal
+
+# Minimum shipment count for the regular volume rebate (same cut-off as legacy volume_tier "regular").
+REBATE_REGULAR_MIN_SHIPMENTS = 10
+# Share of the paid invoice total rebated at the regular tier (3%).
+REBATE_REGULAR_RATE = Decimal("0.03")
+# Minimum shipment count for the bulk volume rebate (same cut-off as legacy volume_tier "bulk").
+REBATE_BULK_MIN_SHIPMENTS = 50
+# Share of the paid invoice total rebated at the bulk tier (6%).
+REBATE_BULK_RATE = Decimal("0.06")
