@@ -32,3 +36,31 @@
 
 def open_invoices():
     return [i for i in db.invoices.values() if i.status == "open"]
+
+
+LATE_AFTER_DAYS = 30
+LATE_FEE_RATE_PER_DAY = Decimal("0.015")
+
+
+def late_fee_for(invoice_id):
+    """Late fee accrued so far on an open invoice, as Money.
+
+    An invoice is late 30 days after issue; each further day adds 1.5%
+    of the invoice amount.
+    """
+    if invoice_id not in db.invoices:
+        raise DomainError("E_NOT_FOUND", f"invoice {invoice_id} does not exist")
+    invoice = db.invoices[invoice_id]
+    if invoice.status != "open":
+        raise DomainError(
+            "E_BAD_STATE",
+            f"invoice {invoice_id} is {invoice.status}; late fees apply only to open invoices",
+        )
+    issued_at = invoice.issued_at
+    if issued_at.tzinfo is None:
+        # Invoices are stamped with naive UTC datetimes by issue_invoice.
+        issued_at = issued_at.replace(tzinfo=timezone.utc)
+    days_late = (clock.now() - issued_at).days - LATE_AFTER_DAYS
+    if days_late <= 0:
+        return Money.zero()
+    return Money.parse(invoice.amount).scale(LATE_FEE_RATE_PER_DAY * days_late)
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_late_fee_invoice.py b/tests/unit/test_late_fee_invoice.py
--- a/tests/unit/test_late_fee_invoice.py	1969-12-31 19:00:00
+++ b/tests/unit/test_late_fee_invoice.py	2026-11-12 04:14:53
@@ -0,0 +1,72 @@
+from datetime import datetime, timedelta, timezone
+
+import pytest
+
+from parcelo import audit, clock, invoices
+from parcelo.errors import DomainError
+from parcelo.models import Invoice
+from parcelo.money import Money
+from parcelo.store import db
+
+ISSUED = datetime(2026, 1, 1, tzinfo=timezone.utc)
+
+
+def _seed(amount=100.0, status="open", issued_at=ISSUED):
+    inv = Invoice(id="inv_1", shipment_id="shp_1", amount=amount, status=status, issued_at=issued_at)
+    db.invoices[inv.id] = inv
+    return inv
+
+
+@pytest.mark.parametrize(
+    "days_since_issue, expected",
+    [
+        (0, Money(0)),
+        (29, Money(0)),
+        (30, Money(0)),
+        (31, Money(150)),
+        (40, Money(1500)),
+    ],
+)
+def test_late_fee_by_age(days_since_issue, expected):
+    _seed(amount=100.0)
+    clock.set_fixed(ISSUED + timedelta(days=days_since_issue))
+    assert invoices.late_fee_for("inv_1") == expected
+
+
+def test_late_fee_rounds_to_cents():
+    _seed(amount=12.34)
+    clock.set_fixed(ISSUED + timedelta(days=33))
+    # 12.34 * 0.015 * 3 = 0.5553 -> 0.56
+    assert invoices.late_fee_for("inv_1") == Money(56)
+
+
+def test_late_fee_handles_naive_utc_issue_time():
+    _seed(amount=100.0, issued_at=datetime(2026, 1, 1))
+    clock.set_fixed(ISSUED + timedelta(days=32))
+    assert invoices.late_fee_for("inv_1") == Money(300)
+
+
+def test_late_fee_does_not_mutate_or_audit():
+    inv = _seed(amount=100.0)
+    clock.set_fixed(ISSUED + timedelta(days=45))
+    invoices.late_fee_for("inv_1")
+    assert inv.amount == 100.0
+    assert inv.status == "open"
+    assert audit.LOG == []
+
+
+def test_unknown_invoice_fails():
+    with pytest.raises(DomainError) as err:
+        invoices.late_fee_for("nope")
+    assert err.value.code == "E_NOT_FOUND"
+    assert audit.LOG == []
+
+
+@pytest.mark.parametrize("status", ["paid", "void"])
+def test_non_open_invoice_fails(status):
+    _seed(status=status)
+    clock.set_fixed(ISSUED + timedelta(days=45))
+    with pytest.raises(DomainError) as err:
+        invoices.late_fee_for("inv_1")
+    assert err.value.code == "E_BAD_STATE"
+    assert audit.LOG == []
