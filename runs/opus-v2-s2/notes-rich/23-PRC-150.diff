+def set_credit_limit(customer_id, amount):
+    """Set a customer's credit limit and return the new limit.
+
+    ``amount`` is a dollar value (int, float or Decimal) >= 0; it is rounded to
+    whole cents with ROUND_HALF_UP. Emits ``customer.credit_limit_set``.
+
+    Raises DomainError:
+      E_NOT_FOUND - customer_id is not a str or no such customer exists.
+      E_BAD_INPUT - amount is not a finite, non-negative number.
+    """
+    if not isinstance(customer_id, str) or customer_id not in db.customers:
+        raise DomainError("E_NOT_FOUND", f"customer {customer_id!r} not found")
+    customer = db.customers[customer_id]
+
+    if isinstance(amount, bool) or not isinstance(amount, (int, float, Decimal)):
+        raise DomainError("E_BAD_INPUT", "amount must be a number")
+    if isinstance(amount, (float, Decimal)) and not math.isfinite(amount):
+        raise DomainError("E_BAD_INPUT", "amount must be finite")
+    if amount < 0:
+        raise DomainError("E_BAD_INPUT", "amount must not be negative")
+
+    new_limit = Money.parse(amount).cents / 100
+    old_limit = customer.credit_limit
+    customer.credit_limit = new_limit
+    events.emit(
+        "customer.credit_limit_set",
+        customer.id,
+        old_limit=old_limit,
+        new_limit=new_limit,
+    )
+    return new_limit
