+def insurance_fee(declared_value, zone):
+    """Insurance fee for a shipment's declared value.
+
+    Fee = (2% + the zone's fuel surcharge %) of declared_value, rounded half-up
+    to cents, with a minimum of 1.00. Returns a float, like ``quote``.
+    """
+    if isinstance(declared_value, bool) or not isinstance(
+        declared_value, (int, float, Decimal)
+    ):
+        raise DomainError("E_BAD_INPUT", f"declared_value must be a number: {declared_value!r}")
+    if not isinstance(declared_value, int) and not math.isfinite(declared_value):
+        raise DomainError("E_BAD_INPUT", f"declared_value must be finite: {declared_value!r}")
+    if not isinstance(zone, str) or not zone.strip():
+        raise DomainError("E_BAD_INPUT", f"zone must be a non-blank string: {zone!r}")
+    if declared_value <= 0:
+        raise DomainError("E_BAD_INPUT", f"declared_value must be positive: {declared_value!r}")
+    if zone not in FUEL_SURCHARGE_PCT:
+        raise DomainError("E_BAD_ZONE", zone)
+
+    pct = INSURANCE_PCT + Decimal(str(FUEL_SURCHARGE_PCT[zone]))
+    fee = (Decimal(str(declared_value)) * pct / Decimal(100)).quantize(
+        Decimal("0.01"), rounding=ROUND_HALF_UP
+    )
+    return float(max(fee, INSURANCE_MIN_FEE))
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_insurance_fee.py b/tests/unit/test_insurance_fee.py
--- a/tests/unit/test_insurance_fee.py	1969-12-31 19:00:00
+++ b/tests/unit/test_insurance_fee.py	2026-11-12 04:27:51
@@ -0,0 +1,137 @@
+import copy
+from datetime import datetime, timezone
+from decimal import Decimal
+
+import pytest
+
+from parcelo import audit, clock, events, rates
+from parcelo.errors import DomainError
+from parcelo.legacy import billing
+from parcelo.store import db
+
+T0 = datetime(2026, 11, 12, 9, 0, tzinfo=timezone.utc)
+
+
+@pytest.fixture(autouse=True)
+def _fixed_clock():
+    clock.set_fixed(T0)
+    yield
+
+
+def _snapshot():
+    return copy.deepcopy(vars(db))
+
+
+def _assert_rejected(code, *args):
+    before = _snapshot()
+    with pytest.raises(DomainError) as err:
+        rates.insurance_fee(*args)
+    assert err.value.code == code
+    assert _snapshot() == before
+    assert events.OUTBOX == []
+    assert audit.LOG == []
+
+
+@pytest.mark.parametrize(
+    "value, zone, expected",
+    [
+        # 1000 * 2% = 20.00
+        (1000, "local", 20.0),
+        # 1000 * (2% + 4%) = 60.00
+        (1000, "national", 60.0),
+        # 1000 * (2% + 9.5%) = 115.00
+        (1000, "international", 115.0),
+        (Decimal("250.00"), "national", 15.0),
+        (250.5, "local", 5.01),
+    ],
+)
+def test_fee_per_zone(value, zone, expected):
+    assert rates.insurance_fee(value, zone) == expected
+
+
+@pytest.mark.parametrize(
+    "value, zone, expected",
+    [
+        # 461.25 * 2% = 9.225 -> half-up 9.23 (float math would give 9.22)
+        (461.25, "local", 9.23),
+        # 153.75 * 6% = 9.225 -> 9.23
+        (153.75, "national", 9.23),
+        # 100.01 * 11.5% = 11.50115 -> 11.50
+        (100.01, "international", 11.5),
+    ],
+)
+def test_rounds_half_up_to_cents(value, zone, expected):
+    assert rates.insurance_fee(value, zone) == expected
+
+
+@pytest.mark.parametrize(
+    "value, zone, expected",
+    [
+        (0.01, "local", 1.0),
+        (49.99, "local", 1.0),  # 0.9998 -> 1.00 rounds to the minimum anyway
+        (49.75, "local", 1.0),  # 0.995 -> 1.00 after rounding
+        (49.7, "local", 1.0),  # 0.994 -> 0.99 -> clamped to 1.00
+        (50, "local", 1.0),  # exactly 1.00
+        (50.5, "local", 1.01),  # 1.01, just above minimum
+        (16.66, "national", 1.0),  # 0.9996 -> 1.00
+        (8, "international", 1.0),  # 0.92 -> clamped
+    ],
+)
+def test_minimum_fee(value, zone, expected):
+    assert rates.insurance_fee(value, zone) == expected
+
+
+def test_minimum_not_applied_above_threshold():
+    # 10 * 11.5% = 1.15
+    assert rates.insurance_fee(10, "international") == 1.15
+
+
+def test_returns_float():
+    assert isinstance(rates.insurance_fee(1000, "local"), float)