@@ -0,0 +1,69 @@
+import copy
+
+import pytest
+
+from parcelo import events, rates
+from parcelo.errors import DomainError
+from parcelo.settings import HEAVY_SURCHARGE_PER_KG, HEAVY_THRESHOLD_KG
+from parcelo.store import db
+
+
+def _snapshot():
+    return copy.deepcopy(dict(vars(db)))
+
+
+def _assert_rejected(code, *args):
+    before = _snapshot()
+    with pytest.raises(DomainError) as err:
+        rates.heavy_quote(*args)
+    assert err.value.code == code
+    assert _snapshot() == before
+    assert events.OUTBOX == []
+
+
+def test_constants_come_from_settings():
+    assert HEAVY_THRESHOLD_KG == 30
+    assert HEAVY_SURCHARGE_PER_KG == 0.75
+
+
+@pytest.mark.parametrize("weight", [0.5, 1, 10, 29.99, 30, 30.0])
+@pytest.mark.parametrize("zone", ["local", "national", "international"])
+def test_at_or_below_threshold_is_normal_quote(weight, zone):
+    assert rates.heavy_quote(weight, zone) == rates.quote(weight, zone)
+
+
+@pytest.mark.parametrize(
+    "weight,zone,expected",
+    [
+        (31, "local", 44.0),  # 4.5 + 38.75 + 0.75
+        (40, "national", 66.5),  # 9.0 + 50.0 + 7.5
+        (32, "international", 65.5),  # 24.0 + 40.0 + 1.5
+        (30.4, "local", 42.8),  # 4.5 + 38.0 + 0.3
+        (100, "local", 182.0),  # 4.5 + 125 + 52.5
+    ],
+)
+def test_above_threshold_adds_surcharge(weight, zone, expected):
+    assert rates.heavy_quote(weight, zone) == expected
+
+
+def test_no_events_and_no_state_change():
+    before = _snapshot()
+    rates.heavy_quote(45, "national")
+    assert events.OUTBOX == []
+    assert _snapshot() == before
+
+
+@pytest.mark.parametrize(
+    "zone",
+    ["moon", "", " ", "Local", "LOCAL", " local", "local ", None, 1, True, ["local"]],
+)
+def test_bad_zone(zone):
+    _assert_rejected("E_BAD_ZONE", 31, zone)
+
+
+@pytest.mark.parametrize(
+    "weight",
+    [0, -1, -0.5, float("nan"), float("inf"), float("-inf"), None, "31", "", True, False, [31]],
+)
+def test_bad_weight(weight):
+    _assert_rejected("E_BAD_WEIGHT", weight, "local")
