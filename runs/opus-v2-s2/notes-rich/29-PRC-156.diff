+
+def heavy_quote(weight_kg, zone):
+    """Normal quote plus a per-kg surcharge for weight above the heavy threshold."""
+    if not isinstance(zone, str) or zone not in ZONE_BASE:
+        raise DomainError("E_BAD_ZONE", repr(zone))
+    if (
+        isinstance(weight_kg, bool)
+        or not isinstance(weight_kg, (int, float))
+        or not isfinite(weight_kg)
+        or weight_kg <= 0
+    ):
+        raise DomainError("E_BAD_WEIGHT", repr(weight_kg))
+    excess = max(0, weight_kg - HEAVY_THRESHOLD_KG)
+    return round(quote(weight_kg, zone) + HEAVY_SURCHARGE_PER_KG * excess, 2)
