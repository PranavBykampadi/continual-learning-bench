+
+T0 = datetime(2026, 11, 12, 9, 0, tzinfo=timezone.utc)
+WINDOW = datetime(2026, 11, 13, 14, 0, tzinfo=timezone.utc)
+
+
+def _seed_customer(cid="cus_1"):
+    c = Customer(id=cid, name="Acme")
+    db.customers[cid] = c
+    return c
+
+
+def _seed_shipment(sid="shp_1", status="created", customer_id="cus_1"):
+    s = Shipment(id=sid, customer_id=customer_id, weight_kg=2.0, zone="local", status=status, created_at=T0)
+    db.shipments[sid] = s
+    return s
+
+
+def _seed_invoice(iid="inv_1", shipment_id="shp_1"):
+    i = Invoice(id=iid, shipment_id=shipment_id, amount=10.0, issued_at=T0)
+    db.invoices[iid] = i
+    return i
+
+
+def _snapshot():
+    return copy.deepcopy(
+        {
+            "customers": db.customers,
+            "shipments": db.shipments,
+            "invoices": db.invoices,
+            "pickups": db.pickups,
+        }
+    )
+
+
+def _assert_rejected(code, *args):
+    before = _snapshot()
+    with pytest.raises(DomainError) as err:
+        schedule_pickup(*args)
+    assert err.value.code == code
+    assert _snapshot() == before
+    assert events.OUTBOX == []
+
+
+@pytest.fixture(autouse=True)
+def _setup():
+    clock.set_fixed(T0)
+    _seed_customer()
+    _seed_shipment()
+    yield
+    clock.clear_fixed()
+
+
+def test_pickup_defaults_are_none():
+    p = Pickup(id="pku_x", shipment_id="shp_1")
+    assert p.window_start is None
+    assert p.scheduled_at is None
+
+
+def test_reset_clears_pickups():
+    assert db.pickups == {}
+    schedule_pickup("shp_1", WINDOW)
+    store.reset()
+    assert db.pickups == {}
+
+
+def test_happy_path():
+    other = _seed_shipment("shp_2")
+    inv = _seed_invoice()
+    other_before = copy.deepcopy(other)
+    inv_before = copy.deepcopy(inv)
+
+    p = schedule_pickup("shp_1", WINDOW)
+
+    assert isinstance(p, Pickup)
+    assert p.id.startswith("pku_")
+    assert p.shipment_id == "shp_1"
+    assert p.window_start == WINDOW
+    assert p.scheduled_at == T0
+    assert db.pickups[p.id] is p
+    assert list(db.pickups) == [p.id]
+    # the shipment itself and unrelated entities are untouched
+    assert db.shipments["shp_1"].status == "created"
