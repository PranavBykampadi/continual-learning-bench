@@ -0,0 +1,34 @@
+from datetime import datetime
+
+from parcelo import clock, events, ids
+from parcelo.errors import DomainError
+from parcelo.models import Pickup
+from parcelo.store import db
+
+
+def schedule_pickup(shipment_id, window_start):
+    if not isinstance(shipment_id, str) or not shipment_id.strip():
+        raise DomainError("E_BAD_INPUT", f"invalid shipment_id {shipment_id!r}")
+    if not isinstance(window_start, datetime) or window_start.tzinfo is None:
+        raise DomainError("E_BAD_INPUT", f"window_start must be an aware datetime, got {window_start!r}")
+    shipment = db.shipments.get(shipment_id)
+    if shipment is None:
+        raise DomainError("E_NOT_FOUND", shipment_id)
+    if shipment.status != "created":
+        raise DomainError("E_BAD_STATE", f"shipment {shipment_id} is {shipment.status!r}, expected 'created'")
+
+    pickup = Pickup(
+        id=ids.new_id("pku"),
+        shipment_id=shipment_id,
+        window_start=window_start,
+        scheduled_at=clock.now(),
+    )
+    db.pickups[pickup.id] = pickup
+    events.emit(
+        "pickup.scheduled",
+        pickup.id,
+        shipment_id=shipment_id,
+        window_start=window_start,
+        scheduled_at=pickup.scheduled_at,
+    )
+    return pickup
