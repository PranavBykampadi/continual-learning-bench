diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_void_invoice.py b/tests/unit/test_void_invoice.py
--- a/tests/unit/test_void_invoice.py	1969-12-31 19:00:00
+++ b/tests/unit/test_void_invoice.py	2026-11-12 04:11:49
@@ -0,0 +1,63 @@
+from datetime import datetime, timezone
+
+import pytest
+
+from parcelo import audit, clock, customers, invoices, shipments
+from parcelo.errors import DomainError
+
+
+def _invoice():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 2.0, "local")
+    return invoices.issue_invoice(s.id)
+
+
+def test_void_open_invoice():
+    moment = datetime(2026, 1, 2, 3, 4, 5, tzinfo=timezone.utc)
+    clock.set_fixed(moment)
+    inv = _invoice()
+    result = invoices.void_invoice(inv.id)
+    assert result is inv
+    assert inv.status == "void"
+    assert inv.voided_at == moment
+    assert audit.LOG[-1]["action"] == "invoice.voided"
+    assert audit.LOG[-1]["entity_id"] == inv.id
+
+
+def test_void_unknown_invoice():
+    with pytest.raises(DomainError) as err:
+        invoices.void_invoice("INV-missing")
+    assert err.value.code == "E_NOT_FOUND"
+
+
+def test_void_paid_invoice_fails_without_side_effects():
+    inv = _invoice()
+    invoices.mark_paid(inv.id)
+    log_len = len(audit.LOG)
+    with pytest.raises(DomainError) as err:
+        invoices.void_invoice(inv.id)
+    assert err.value.code == "E_BAD_STATE"
+    assert inv.status == "paid"
+    assert inv.voided_at is None
+    assert len(audit.LOG) == log_len
+
+
+def test_void_already_void_invoice_fails_without_side_effects():
+    first = datetime(2026, 1, 2, tzinfo=timezone.utc)
+    clock.set_fixed(first)
+    inv = _invoice()
+    invoices.void_invoice(inv.id)
+    clock.set_fixed(datetime(2026, 2, 3, tzinfo=timezone.utc))
+    log_len = len(audit.LOG)
+    with pytest.raises(DomainError) as err:
+        invoices.void_invoice(inv.id)
+    assert err.value.code == "E_BAD_STATE"
+    assert inv.status == "void"
+    assert inv.voided_at == first
+    assert len(audit.LOG) == log_len
+
+
+def test_voided_invoice_not_open():
+    inv = _invoice()
+    invoices.void_invoice(inv.id)
+    assert inv not in invoices.open_invoices()
