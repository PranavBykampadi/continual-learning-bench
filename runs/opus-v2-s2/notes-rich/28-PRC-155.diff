+def customers_by_tier(tier):
+    """Return the customers on ``tier``, in insertion order.
+
+    Read-only: emits no events. Inactive customers are included. Returns a
+    new list on every call (empty if no customer is on the tier). Raises
+    ``DomainError("E_BAD_INPUT")`` if ``tier`` is not one of ``TIERS``
+    (matching is exact and case-sensitive).
+    """
+    if not isinstance(tier, str) or tier not in TIERS:
+        raise DomainError("E_BAD_INPUT", repr(tier))
+    return [c for c in db.customers.values() if c.tier == tier]
 
 
