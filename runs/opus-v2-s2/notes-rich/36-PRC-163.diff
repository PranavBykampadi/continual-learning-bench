diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_lock_customer.py b/tests/unit/test_lock_customer.py
--- a/tests/unit/test_lock_customer.py	1969-12-31 19:00:00
+++ b/tests/unit/test_lock_customer.py	2026-11-12 04:46:58
@@ -0,0 +1,73 @@
+import pytest
+
+from parcelo import customers, events
+from parcelo.errors import DomainError
+from parcelo.models import Customer
+from parcelo.store import db
+
+
+def test_customer_unlocked_by_default():
+    assert Customer(id="C1", name="Acme").locked is False
+    assert customers.add_customer("Acme").locked is False
+
+
+def test_lock_sets_flag_and_returns_customer():
+    c = customers.add_customer("Acme")
+    result = customers.lock_customer(c.id)
+    assert result is c
+    assert db.customers[c.id].locked is True
+
+
+def test_lock_emits_event():
+    db.customers["C1"] = Customer(id="C1", name="Acme")
+    customers.lock_customer("C1")
+    assert events.OUTBOX[-1]["name"] == "customer.locked"
+    assert events.OUTBOX[-1]["entity_id"] == "C1"
+
+
+def test_lock_only_affects_target():
+    db.customers["C2"] = Customer(id="C2", name="B")
+    db.customers["C1"] = Customer(id="C1", name="A")
+    customers.lock_customer("C1")
+    assert db.customers["C2"].locked is False
+
+
+def test_lock_already_locked_is_noop():
+    db.customers["C1"] = Customer(id="C1", name="Acme", locked=True)
+    before = list(events.OUTBOX)
+    result = customers.lock_customer("C1")
+    assert result.locked is True
+    assert list(events.OUTBOX) == before
+
+
+def test_lock_twice_emits_once():
+    db.customers["C1"] = Customer(id="C1", name="Acme")
+    customers.lock_customer("C1")
+    customers.lock_customer("C1")
+    assert [e["name"] for e in events.OUTBOX] == ["customer.locked"]
+
+
+def test_unknown_customer():
+    before = list(events.OUTBOX)
+    with pytest.raises(DomainError) as err:
+        customers.lock_customer("nope")
+    assert err.value.code == "E_UNKNOWN_CUSTOMER"
+    assert list(events.OUTBOX) == before
+
+
+@pytest.mark.parametrize("near_miss", ["c1", " C1", "C1 "])
+def test_near_miss_ids_are_unknown(near_miss):
+    db.customers["C1"] = Customer(id="C1", name="Acme")
+    with pytest.raises(DomainError) as err:
+        customers.lock_customer(near_miss)
+    assert err.value.code == "E_UNKNOWN_CUSTOMER"
+    assert db.customers["C1"].locked is False
+
+
+@pytest.mark.parametrize("bad", [None, "", "  ", 42])
+def test_bad_input(bad):
+    before = list(events.OUTBOX)
+    with pytest.raises(DomainError) as err:
+        customers.lock_customer(bad)
+    assert err.value.code == "E_BAD_INPUT"
+    assert list(events.OUTBOX) == before
