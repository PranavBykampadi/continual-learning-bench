+def lock_customer(customer_id):
+    """Lock a customer account (idempotent).
+
+    Emits ``customer.locked`` only when the flag actually changes; locking an
+    already-locked customer returns it unchanged with no event.
+    """
+    if not isinstance(customer_id, str) or not customer_id.strip():
+        raise DomainError("E_BAD_INPUT", repr(customer_id))
+    if customer_id not in db.customers:
+        raise DomainError("E_UNKNOWN_CUSTOMER", customer_id)
+    customer = db.customers[customer_id]
+    if customer.locked:
+        return customer
+    customer.locked = True
+    events.emit("customer.locked", customer.id)
+    return customer
