+def write_off(invoice_id):
+    """Write off an open invoice; returns the written-off amount as Money."""
+    if not isinstance(invoice_id, str) or not invoice_id.strip():
+        raise DomainError("E_BAD_INPUT", "invoice_id must be a non-blank string")
+    invoice = db.invoices.get(invoice_id)
+    if invoice is None:
+        raise DomainError("E_NOT_FOUND", invoice_id)
+    if invoice.status != "open":
+        raise DomainError("E_BAD_STATE", f"cannot write off invoice in status {invoice.status!r}")
+    amount = Money.parse(invoice.amount)
+    now = clock.now()
+    before = invoice.status
+    invoice.status = "written_off"
+    invoice.written_off_at = now
+    events.emit(
+        "invoice.written_off",
+        invoice.id,
+        before=before,
+        after=invoice.status,
+        amount=amount,
+    )
+    return amount
