+import copy
+from datetime import datetime, timedelta, timezone
+
+import pytest
+
+from parcelo import clock, events
+from parcelo.errors import DomainError
+from parcelo.invoices import write_off
+from parcelo.models import Customer, Invoice, Shipment
+from parcelo.money import Money
+from parcelo.store import db
+
+T0 = datetime(2026, 11, 12, 9, 0, tzinfo=timezone.utc)
+
+
+def _seed_customer(id="cus_1"):
+    c = Customer(id=id, name="Acme")
+    db.customers[id] = c
+    return c
+
+
+def _seed_shipment(id="shp_1", customer_id="cus_1"):
+    s = Shipment(id=id, customer_id=customer_id, weight_kg=2.0, zone="local", created_at=T0)
+    db.shipments[id] = s
+    return s
+
+
+def _seed_invoice(id="INV-1", amount=9.225, status="open", shipment_id="shp_1"):
+    inv = Invoice(id=id, shipment_id=shipment_id, amount=amount, status=status, issued_at=T0)
+    db.invoices[id] = inv
+    return inv
+
+
+def _snapshot():
+    return copy.deepcopy(
+        {"customers": db.customers, "shipments": db.shipments, "invoices": db.invoices}
+    )
+
+
+def _assert_rejected(code, *args):
+    before = _snapshot()
+    with pytest.raises(DomainError) as err:
+        write_off(*args)
+    assert err.value.code == code
+    assert _snapshot() == before
+    assert events.OUTBOX == []
+
+
+@pytest.fixture(autouse=True)
+def _setup():
+    clock.set_fixed(T0)
+    _seed_customer()
+    _seed_shipment()
+    _seed_shipment(id="shp_2")
+    yield
+    clock.clear_fixed()
+
+
+def test_happy_path_returns_money_and_updates_invoice():
+    inv = _seed_invoice()
+    other = _seed_invoice(id="INV-2", amount=5.0, shipment_id="shp_2")
+    other_before = copy.deepcopy(other)
+
+    result = write_off("INV-1")
+
+    # 9.225 dollars -> 922.5 cents -> ROUND_HALF_UP -> 923 cents (9.23)
+    assert result == Money(923)
+    assert isinstance(result, Money)
+    assert db.invoices["INV-1"] is inv
+    assert inv.status == "written_off"
+    assert inv.written_off_at == T0
+    # other fields preserved
+    assert inv.amount == 9.225
+    assert inv.shipment_id == "shp_1"
+    assert inv.issued_at == T0
+    assert inv.paid_at is None
+    # unrelated entity untouched
+    assert db.invoices["INV-2"] is other
+    assert other == other_before
+
+
+def test_emits_event():
+    _seed_invoice()
+    write_off("INV-1")
+    assert events.OUTBOX == [
+        {
+            "name": "invoice.written_off",
+            "entity_id": "INV-1",
+            "at": T0,
+            "payload": {"before": "open", "after": "written_off", "amount": Money(923)},
+        }
+    ]
+
+
+def test_events_use_current_clock_for_each_write_off():
+    a = _seed_invoice(id="INV-1", amount=10)
+    b = _seed_invoice(id="INV-2", amount=20, shipment_id="shp_2")
+    write_off("INV-1")
+    t1 = T0 + timedelta(hours=1)
+    clock.set_fixed(t1)
+    write_off("INV-2")
+    assert a.written_off_at == T0
+    assert b.written_off_at == t1
+    assert [e["at"] for e in events.OUTBOX] == [T0, t1]
+    assert [e["payload"]["amount"] for e in events.OUTBOX] == [Money(1000), Money(2000)]
+
+
+def test_new_field_defaults_to_none():
+    assert Invoice(id="x", shipment_id="s", amount=1.0).written_off_at is None
+
+
+@pytest.mark.parametrize(
+    "bad", ["", "   ", None, 123, True, 0, -1, 1.5, ["INV-1"], T0.replace(tzinfo=None)]
+)
+def test_bad_input(bad):
+    _seed_invoice()
+    _assert_rejected("E_BAD_INPUT", bad)
+
+
+def test_not_found():
+    _seed_invoice()
+    _assert_rejected("E_NOT_FOUND", "INV-404")
+
+
+def test_not_found_empty_store():
+    db.customers.clear()
+    db.shipments.clear()
+    _assert_rejected("E_NOT_FOUND", "INV-1")
+
+
+@pytest.m