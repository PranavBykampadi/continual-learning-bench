         raise ValueError("weight must be positive")
     return round(base_rate(zone) + PER_KG * weight_kg, 2)
+
+
+TIER_DISCOUNT_PCT = {"standard": Decimal("0"), "gold": Decimal("10")}
+
+
+def discounted_quote(weight_kg, zone, tier):
+    """Regular quote for weight/zone minus the tier's percentage discount, as Money.
+
+    The discounted amount is rounded half-up to whole cents (via Money.scale).
+    """
+    if zone not in ZONE_BASE:
+        raise DomainError("E_BAD_ZONE", f"unknown zone: {zone!r}")
+    if tier not in TIER_DISCOUNT_PCT:
+        raise DomainError("E_BAD_INPUT", f"unknown tier: {tier!r}")
+    if (
+        isinstance(weight_kg, bool)
+        or not isinstance(weight_kg, (int, float))
+        or weight_kg <= 0
+    ):
+        raise DomainError("E_BAD_WEIGHT", f"weight must be positive, got {weight_kg!r}")
+    regular = Money.parse(quote(weight_kg, zone))
+    factor = 1 - TIER_DISCOUNT_PCT[tier] / Decimal(100)
+    return regular.scale(factor)
