@@ -0,0 +1,70 @@
+from decimal import Decimal
+
+import pytest
+
+from parcelo import audit, rates
+from parcelo.errors import DomainError
+from parcelo.money import Money
+
+
+@pytest.mark.parametrize(
+    "weight_kg, zone, expected",
+    [
+        (2, "local", Money(700)),  # 4.50 + 2.50
+        (1, "national", Money(1025)),  # 9.00 + 1.25
+        (4, "international", Money(2900)),  # 24.00 + 5.00
+    ],
+)
+def test_standard_tier_has_no_discount(weight_kg, zone, expected):
+    assert rates.discounted_quote(weight_kg, zone, "standard") == expected
+    assert audit.LOG == []
+
+
+@pytest.mark.parametrize(
+    "weight_kg, zone, expected",
+    [
+        (2, "local", Money(630)),  # 7.00 * 0.9
+        (4, "international", Money(2610)),  # 29.00 * 0.9
+        (1, "national", Money(923)),  # 10.25 * 0.9 = 9.225 -> 9.23 (half up)
+        (1, "local", Money(518)),  # 5.75 * 0.9 = 5.175 -> 5.18 (half up)
+    ],
+)
+def test_gold_tier_gets_ten_percent_off(weight_kg, zone, expected):
+    assert rates.discounted_quote(weight_kg, zone, "gold") == expected
+    assert audit.LOG == []
+
+
+@pytest.mark.parametrize("weight_kg", [0.01, 1, 2.5, 3])
+def test_standard_matches_regular_quote(weight_kg):
+    expected = Money.parse(rates.quote(weight_kg, "national"))
+    assert rates.discounted_quote(weight_kg, "national", "standard") == expected
+
+
+@pytest.mark.parametrize("zone", ["moon", "", "  ", None, "LOCAL"])
+def test_unknown_zone_fails(zone):
+    with pytest.raises(DomainError) as err:
+        rates.discounted_quote(1, zone, "gold")
+    assert err.value.code == "E_BAD_ZONE"
+    assert audit.LOG == []
+
+
+@pytest.mark.parametrize("tier", ["platinum", "", "  ", None, "Gold"])
+def test_unknown_tier_fails(tier):
+    with pytest.raises(DomainError) as err:
+        rates.discounted_quote(1, "local", tier)
+    assert err.value.code == "E_BAD_INPUT"
+    assert audit.LOG == []
+
+
+@pytest.mark.parametrize("weight_kg", [0, -1, -0.01, None, "2", True, Decimal("2")])
+def test_bad_weight_fails(weight_kg):
+    with pytest.raises(DomainError) as err:
+        rates.discounted_quote(weight_kg, "local", "gold")
+    assert err.value.code == "E_BAD_WEIGHT"
+    assert audit.LOG == []
+
+
+def test_zone_checked_before_tier():
+    with pytest.raises(DomainError) as err:
+        rates.discounted_quote(1, "moon", "platinum")
+    assert err.value.code == "E_BAD_ZONE"
