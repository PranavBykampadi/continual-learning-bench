+# Fuel surcharge percentages, copied from legacy billing (do not import parcelo.legacy).
+FUEL_SURCHARGE_PCT = {
+    "local": Decimal("0.0"),
+    "national": Decimal("4.0"),
+    "international": Decimal("9.5"),
+}
+INSURANCE_PCT = Decimal("2")
+INSURANCE_MIN_FEE = Money.parse("1.00")
+
+
+def insurance_fee(declared_value, zone):
+    """Insurance fee: (2% + zone fuel surcharge %) of the declared value, minimum 1.00.
+
+    Raises DomainError E_BAD_ZONE for an unknown zone and E_BAD_INPUT for a
+    declared value that is missing, unparseable, zero or negative. Returns Money.
+    """
+    if not isinstance(zone, str) or zone not in FUEL_SURCHARGE_PCT:
+        raise DomainError("E_BAD_ZONE", "unknown zone: %r" % (zone,))
+    if declared_value is None or isinstance(declared_value, bool):
+        raise DomainError("E_BAD_INPUT", "declared value must be an amount")
+    try:
+        value = Money.parse(declared_value)
+    except (InvalidOperation, ValueError, TypeError):
+        raise DomainError("E_BAD_INPUT", "invalid declared value: %r" % (declared_value,))
+    if value.cents <= 0:
+        raise DomainError("E_BAD_INPUT", "declared value must be positive")
+    fee = value.scale((INSURANCE_PCT + FUEL_SURCHARGE_PCT[zone]) / Decimal("100"))
+    return INSURANCE_MIN_FEE if fee < INSURANCE_MIN_FEE else fee
