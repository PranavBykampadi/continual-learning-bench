+++ b/tests/unit/test_insurance_fee.py	2026-11-12 04:31:09
@@ -0,0 +1,63 @@
+import pytest
+
+from parcelo import rates
+from parcelo.errors import DomainError
+from parcelo.money import Money
+
+
+def test_returns_money():
+    assert isinstance(rates.insurance_fee(100, "local"), Money)
+
+
+@pytest.mark.parametrize(
+    "value, zone, expected",
+    [
+        (100, "local", "2.00"),          # 2%
+        (100, "national", "6.00"),       # 2% + 4%
+        (100, "international", "11.50"), # 2% + 9.5%
+        ("250.00", "national", "15.00"),
+    ],
+)
+def test_fee_per_zone(value, zone, expected):
+    assert rates.insurance_fee(value, zone) == Money.parse(expected)
+
+
+def test_minimum_fee_applies():
+    assert rates.insurance_fee(10, "local") == Money.parse("1.00")      # 0.20 -> 1.00
+    assert rates.insurance_fee("0.01", "international") == Money.parse("1.00")
+
+
+def test_exactly_minimum():
+    assert rates.insurance_fee(50, "local") == Money.parse("1.00")
+
+
+def test_half_cent_rounds_half_up():
+    # 123.45 * 11.5% = 14.19675 -> 14.20
+    fee = rates.insurance_fee("123.45", "international")
+    assert fee == Money.parse("14.20")
+    assert fee.cents == 1420
+
+
+def test_accepts_money_input():
+    assert rates.insurance_fee(Money.parse("100"), "national") == Money.parse("6.00")
+
+
+@pytest.mark.parametrize("zone", ["mars", "Local", "", None])
+def test_unknown_zone(zone):
+    with pytest.raises(DomainError) as e:
+        rates.insurance_fee(100, zone)
+    assert e.value.code == "E_BAD_ZONE"
+
+
+@pytest.mark.parametrize("value", [0, -1, "0.00", "-5", "0.001"])
+def test_non_positive_value(value):
+    with pytest.raises(DomainError) as e:
+        rates.insurance_fee(value, "local")
+    assert e.value.code == "E_BAD_INPUT"
+
+
+@pytest.mark.parametrize("value", ["abc", None, True])
+def test_invalid_value(value):
+    with pytest.raises(DomainError) as e:
+        rates.insurance_fee(value, "local")
+    assert e.value.code == "E_BAD_INPUT"
