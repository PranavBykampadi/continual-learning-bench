diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_reopen_invoice.py b/tests/unit/test_reopen_invoice.py
--- a/tests/unit/test_reopen_invoice.py	1969-12-31 19:00:00
+++ b/tests/unit/test_reopen_invoice.py	2026-11-12 04:28:46
@@ -0,0 +1,95 @@
+from datetime import datetime, timezone
+
+import pytest
+
+from parcelo import clock, customers, events, invoices, shipments
+from parcelo.errors import DomainError
+
+NOW = datetime(2026, 11, 12, 9, 30, tzinfo=timezone.utc)
+
+
+def make_invoice():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 2, "local")
+    return invoices.issue_invoice(s.id)
+
+
+def make_paid_invoice():
+    inv = make_invoice()
+    invoices.mark_paid(inv.id)
+    return inv
+
+
+def test_new_invoice_has_no_reopened_at():
+    assert make_invoice().reopened_at is None
+
+
+def test_reopen_paid_invoice():
+    inv = make_paid_invoice()
+    clock.set_fixed(NOW)
+
+    result = invoices.reopen_invoice(inv.id)
+
+    assert result is inv
+    assert inv.status == "open"
+    assert inv.paid_at is None
+    assert inv.reopened_at == NOW
+    assert inv in invoices.open_invoices()
+
+
+def test_reopen_emits_event():
+    inv = make_paid_invoice()
+    before = len(events.OUTBOX)
+
+    invoices.reopen_invoice(inv.id)
+
+    assert len(events.OUTBOX) == before + 1
+    event = events.OUTBOX[-1]
+    assert event["name"] == "invoice.reopened"
+    assert event["entity_id"] == inv.id
+    assert event["payload"] == {"shipment_id": inv.shipment_id}
+
+
+def test_reopened_invoice_can_be_paid_again():
+    inv = make_paid_invoice()
+    invoices.reopen_invoice(inv.id)
+
+    invoices.mark_paid(inv.id)
+
+    assert inv.status == "paid"
+    assert inv.paid_at is not None
+
+
+def test_reopen_unknown_invoice():
+    before = len(events.OUTBOX)
+    with pytest.raises(DomainError) as err:
+        invoices.reopen_invoice("INV-missing")
+    assert err.value.code == "E_NOT_FOUND"
+    assert len(events.OUTBOX) == before
+
+
+@pytest.mark.parametrize("status", ["open", "void"])
+def test_reopen_not_paid_invoice(status):
+    inv = make_invoice()
+    inv.status = status
+    before = len(events.OUTBOX)
+
+    with pytest.raises(DomainError) as err:
+        invoices.reopen_invoice(inv.id)
+
+    assert err.value.code == "E_BAD_STATE"
+    assert inv.status == status
+    assert inv.reopened_at is None
+    assert len(events.OUTBOX) == before
+
+
+def test_reopen_twice_fails():
+    inv = make_paid_invoice()
+    clock.set_fixed(NOW)
+    invoices.reopen_invoice(inv.id)
+
+    with pytest.raises(DomainError) as err:
+        invoices.reopen_invoice(inv.id)
+
+    assert err.value.code == "E_BAD_STATE"
+    assert inv.reopened_at == NOW
