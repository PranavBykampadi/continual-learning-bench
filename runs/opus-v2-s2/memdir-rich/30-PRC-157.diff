+def hold_invoice(invoice_id):
+    """Put an open invoice on hold to pause collection.
+
+    Idempotent: an invoice already on hold is returned unchanged.
+    """
+    invoice = db.invoices.get(invoice_id)
+    if invoice is None:
+        raise DomainError("E_NOT_FOUND", f"invoice {invoice_id} not found")
+    if invoice.status == "on_hold":
+        return invoice
+    if invoice.status != "open":
+        raise DomainError("E_BAD_STATE", f"invoice {invoice_id} is {invoice.status}")
+    invoice.status = "on_hold"
+    invoice.held_at = clock.now()
+    events.emit("invoice.held", invoice.id, shipment_id=invoice.shipment_id)
     return invoice
 
 
