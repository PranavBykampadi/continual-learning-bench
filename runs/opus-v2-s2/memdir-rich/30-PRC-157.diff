diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_hold_invoice.py b/tests/unit/test_hold_invoice.py
--- a/tests/unit/test_hold_invoice.py	1969-12-31 19:00:00
+++ b/tests/unit/test_hold_invoice.py	2026-11-12 04:49:28
@@ -0,0 +1,78 @@
+from datetime import datetime, timedelta, timezone
+
+import pytest
+
+from parcelo import clock, customers, events, invoices, shipments
+from parcelo.errors import DomainError
+
+NOW = datetime(2026, 11, 12, 9, 30, tzinfo=timezone.utc)
+
+
+def make_invoice():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 2, "local")
+    inv = invoices.issue_invoice(s.id)
+    events.OUTBOX.clear()
+    return inv
+
+
+def test_new_invoice_has_no_held_at():
+    assert make_invoice().held_at is None
+
+
+def test_hold_open_invoice():
+    clock.set_fixed(NOW)
+    inv = make_invoice()
+    amount = inv.amount
+
+    result = invoices.hold_invoice(inv.id)
+
+    assert result is inv
+    assert inv.status == "on_hold"
+    assert inv.held_at == NOW
+    assert inv.amount == amount
+    assert len(events.OUTBOX) == 1
+    assert events.OUTBOX[-1]["name"] == "invoice.held"
+    assert events.OUTBOX[-1]["entity_id"] == inv.id
+    assert events.OUTBOX[-1]["payload"] == {"shipment_id": inv.shipment_id}
+
+
+def test_held_invoice_not_in_open_invoices():
+    inv = make_invoice()
+    invoices.hold_invoice(inv.id)
+    assert inv not in invoices.open_invoices()
+
+
+def test_unknown_invoice_fails():
+    with pytest.raises(DomainError) as err:
+        invoices.hold_invoice("INV-missing")
+    assert err.value.code == "E_NOT_FOUND"
+    assert events.OUTBOX == []
+
+
+@pytest.mark.parametrize("status", ["paid", "void"])
+def test_non_open_invoice_fails(status):
+    inv = make_invoice()
+    inv.status = status
+
+    with pytest.raises(DomainError) as err:
+        invoices.hold_invoice(inv.id)
+
+    assert err.value.code == "E_BAD_STATE"
+    assert inv.status == status
+    assert inv.held_at is None
+    assert events.OUTBOX == []
+
+
+def test_hold_twice_is_idempotent():
+    clock.set_fixed(NOW)
+    inv = make_invoice()
+    invoices.hold_invoice(inv.id)
+
+    clock.set_fixed(NOW + timedelta(hours=1))
+    result = invoices.hold_invoice(inv.id)
+
+    assert result is inv
+    assert inv.status == "on_hold"
+    assert inv.held_at == NOW
+    assert len(events.OUTBOX) == 1
