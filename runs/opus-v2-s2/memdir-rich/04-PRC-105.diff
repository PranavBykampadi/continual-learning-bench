diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_refunds.py b/tests/unit/test_refunds.py
--- a/tests/unit/test_refunds.py	1969-12-31 19:00:00
+++ b/tests/unit/test_refunds.py	2026-11-12 04:15:21
@@ -0,0 +1,96 @@
+from datetime import datetime, timezone
+
+import pytest
+
+from parcelo import audit, clock, customers, invoices, refunds, shipments
+from parcelo.errors import DomainError
+from parcelo.money import Money
+from parcelo.store import db
+
+
+def _invoice(paid=True):
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 2, "local")
+    inv = invoices.issue_invoice(s.id)  # amount 7.00
+    if paid:
+        invoices.mark_paid(inv.id)
+    return inv
+
+
+def test_create_refund_for_paid_invoice():
+    inv = _invoice()
+    moment = datetime(2026, 11, 12, 10, 0, tzinfo=timezone.utc)
+    clock.set_fixed(moment)
+
+    refund = refunds.create_refund(inv.id, Money.parse("2.50"))
+
+    assert refund.id
+    assert refund.invoice_id == inv.id
+    assert refund.amount == Money.parse("2.50")
+    assert refund.created_at == moment
+    assert db.refunds[refund.id] is refund
+    assert audit.LOG[-1]["action"] == "refund.created"
+    assert audit.LOG[-1]["entity_id"] == refund.id
+
+
+def test_amount_given_as_number_is_stored_as_money():
+    inv = _invoice()
+    refund = refunds.create_refund(inv.id, 7)
+    assert refund.amount == Money.parse("7.00")
+
+
+def test_multiple_partial_refunds_allowed_up_to_invoice_amount():
+    inv = _invoice()
+    r1 = refunds.create_refund(inv.id, Money.parse("3.00"))
+    r2 = refunds.create_refund(inv.id, Money.parse("4.00"))
+    assert r1.id != r2.id
+    assert len(db.refunds) == 2
+
+
+def test_unknown_invoice_is_not_found():
+    with pytest.raises(DomainError) as err:
+        refunds.create_refund("INV-missing", Money.parse("1.00"))
+    assert err.value.code == "E_NOT_FOUND"
+    assert db.refunds == {}
+
+
+@pytest.mark.parametrize("status", ["open", "void"])
+def test_unpaid_invoice_cannot_be_refunded(status):
+    inv = _invoice(paid=False)
+    inv.status = status
+    log_len = len(audit.LOG)
+
+    with pytest.raises(DomainError) as err:
+        refunds.create_refund(inv.id, Money.parse("1.00"))
+
+    assert err.value.code == "E_BAD_STATE"
+    assert db.refunds == {}
+    assert len(audit.LOG) == log_len
+    assert inv.status == status
+
+
+@pytest.mark.parametrize("amount", [Money.parse("0"), Money.parse("-1.00"), "abc"])
+def test_invalid_amount_rejected(amount):
+    inv = _invoice()
+    with pytest.raises(DomainError) as err:
+        refunds.create_refund(inv.id, amount)
+    assert err.value.code == "E_BAD_INPUT"
+    assert db.refunds == {}
+
+
+def test_refunds_cannot_exceed_invoice_amount():
+    inv = _invoice()
+    refunds.create_refund(inv.id, Money.parse("5.00"))
+    with pytest.raises(DomainError) as err:
+        refunds.create_refund(inv.id, Money.parse("2.01"))
+    assert err.value.code == "E_LIMIT"
+    assert len(db.refunds) == 1
+
+
+def test_reset_clears_refunds():
+    from parcelo import store
+
+    inv = _invoice()
+    refunds.create_refund(inv.id, Money.parse("1.00"))
+    store.reset()
+    assert db.refunds == {}
