--- a/tests/unit/test_escalate_invoice.py	1969-12-31 19:00:00
+++ b/tests/unit/test_escalate_invoice.py	2026-11-12 05:02:55
@@ -0,0 +1,94 @@
+from datetime import datetime, timedelta, timezone
+
+import pytest
+
+from parcelo import clock, events, invoices, settings
+from parcelo.errors import DomainError
+from parcelo.models import Invoice
+from parcelo.store import db
+
+NOW = datetime(2026, 11, 12, 9, 0, tzinfo=timezone.utc)
+MIN = settings.ESCALATION_MIN_AMOUNT.cents / 100
+
+
+def _invoice(amount=MIN, status="open", invoice_id="INV-1"):
+    inv = Invoice(id=invoice_id, shipment_id="shp_1", amount=amount, status=status)
+    db.invoices[inv.id] = inv
+    events.OUTBOX.clear()
+    return inv
+
+
+def test_fresh_invoice_has_no_escalated_at():
+    assert _invoice().escalated_at is None
+
+
+def test_escalate_exactly_minimum():
+    clock.set_fixed(NOW)
+    inv = _invoice(amount=MIN)
+    result = invoices.escalate_invoice(inv.id)
+    assert result is inv
+    assert db.invoices[inv.id].status == "escalated"
+    assert inv.escalated_at == NOW
+    assert isinstance(inv.amount, float)
+    assert inv not in invoices.open_invoices()
+
+
+def test_escalate_emits_event():
+    clock.set_fixed(NOW)
+    inv = _invoice(amount=1234.5)
+    invoices.escalate_invoice(inv.id)
+    assert events.OUTBOX == [
+        {
+            "name": "invoice.escalated",
+            "entity_id": inv.id,
+            "at": NOW,
+            "payload": {"shipment_id": "shp_1", "amount": "1234.50 USD"},
+        }
+    ]
+
+
+def test_below_minimum_rejected():
+    inv = _invoice(amount=MIN - 0.01)
+    with pytest.raises(DomainError) as err:
+        invoices.escalate_invoice(inv.id)
+    assert err.value.code == "E_LIMIT"
+    assert inv.status == "open"
+    assert inv.escalated_at is None
+    assert events.OUTBOX == []
+
+
+def test_unknown_invoice():
+    with pytest.raises(DomainError) as err:
+        invoices.escalate_invoice("INV-nope")
+    assert err.value.code == "E_NOT_FOUND"
+    assert events.OUTBOX == []
+
+
+@pytest.mark.parametrize("status", ["paid", "void", "on_hold", "written_off"])
+def test_non_open_rejected(status):
+    inv = _invoice(amount=MIN * 2, status=status)
+    with pytest.raises(DomainError) as err:
+        invoices.escalate_invoice(inv.id)
+    assert err.value.code == "E_BAD_STATE"
+    assert inv.status == status
+    assert inv.escalated_at is None
+    assert events.OUTBOX == []
+
+
+def test_escalate_twice_is_idempotent():
+    clock.set_fixed(NOW)
+    inv = _invoice()
+    first = invoices.escalate_invoic