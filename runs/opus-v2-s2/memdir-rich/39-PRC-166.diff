+def escalate_invoice(invoice_id):
+    """Hand a large open invoice to collections. Idempotent."""
+    invoice = db.invoices.get(invoice_id)
+    if invoice is None:
+        raise DomainError("E_NOT_FOUND", f"invoice {invoice_id!r} not found")
+    if invoice.status == "escalated":
+        return invoice
+    if invoice.status != "open":
+        raise DomainError("E_BAD_STATE", f"{invoice_id} is {invoice.status}")
+    amount = Money.parse(invoice.amount)
+    if amount < settings.ESCALATION_MIN_AMOUNT:
+        raise DomainError(
+            "E_LIMIT",
+            f"{invoice_id} amount {amount} is below {settings.ESCALATION_MIN_AMOUNT}",
+        )
+    invoice.status = "escalated"
+    invoice.escalated_at = clock.now()
+    events.emit(
+        "invoice.escalated",
+        invoice.id,
+        shipment_id=invoice.shipment_id,
+        amount=str(amount),
+    )
     return invoice
 
 
