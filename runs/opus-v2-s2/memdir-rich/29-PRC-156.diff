+++ b/parcelo/settings.py	2026-11-12 04:47:55
@@ -0,0 +1,8 @@
+from decimal import Decimal
+
+from parcelo.money import Money
+
+# Business numbers live here so Finance has one place to look.
+
+HEAVY_PARCEL_THRESHOLD_KG = Decimal("30")  # PRC-156: kg above this pay the heavy surcharge
+HEAVY_SURCHARGE_PER_KG = Money.parse("0.75")  # PRC-156: surcharge per kg above the threshold
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_heavy_quote.py b/tests/unit/test_heavy_quote.py
--- a/tests/unit/test_heavy_quote.py	1969-12-31 19:00:00
+++ b/tests/unit/test_heavy_quote.py	2026-11-12 04:48:09
@@ -0,0 +1,62 @@
+import pytest
+
+from parcelo import events, settings
+from parcelo.errors import DomainError
+from parcelo.money import Money
+from parcelo.rates import heavy_quote, quote
+
+
+def test_returns_money():
+    assert isinstance(heavy_quote(40, "local"), Money)
+
+
+@pytest.mark.parametrize("weight", [1, 10, 29.9, 30])
+def test_at_or_below_threshold_is_normal_quote(weight):
+    assert heavy_quote(weight, "national") == Money.parse(quote(weight, "national"))
+
+
+def test_one_kg_above_threshold():
+    # quote(31, local) = 43.25, + 1 * 0.75
+    assert heavy_quote(31, "local") == Money.parse("44.00")
+
+
+@pytest.mark.parametrize(
+    "weight, zone, expected",
+    [
+        (40, "national", "66.50"),  # 59.00 + 10 * 0.75
+        (50, "international", "101.50"),  # 86.50 + 20 * 0.75
+        (30.4, "local", "42.80"),  # 42.50 + 0.4 * 0.75
+    ],
+)
+def test_surcharge_per_kg_above_threshold(weight, zone, expected):
+    assert heavy_quote(weight, zone) == Money.parse(expected)
+
+
+def test_half_cent_rounds_half_up():
+    # quote(30.01, local) = 42.01; surcharge 0.01 * 0.75 = 0.0075 -> 0.01
+    assert heavy_quote(30.01, "local").cents == 4202
+
+
+def test_threshold_comes_from_settings():
+    just_above = settings.HEAVY_PARCEL_THRESHOLD_KG + 1
+    expected = Money.parse(quote(float(just_above), "local")) + settings.HEAVY_SURCHARGE_PER_KG
+    assert heavy_quote(float(just_above), "local") == expected
+
+
+@pytest.mark.parametrize("zone", ["mars", "Local", "", None])
+def test_unknown_zone_fails(zone):
+    with pytest.raises(DomainError) as exc:
+        heavy_quote(40, zone)
+    assert exc.value.code == "E_BAD_ZONE"
+
+
+@pytest.mark.parametrize("weight", [0, -1, -40.5, None, "40", True])
+def test_non_positive_or_invalid_weight_fails(weight):
+    with pytest.raises(DomainError) as exc:
+        heavy_quote(weight, "local")
+    assert exc.value.code == "E_BAD_WEIGHT"
+
+
+def test_read_only():
+    heavy_quote(40, "local")
+    assert events.OUTBOX == []
