+
+def heavy_quote(weight_kg, zone):
+    """Quote plus HEAVY_SURCHARGE_PER_KG for every kg above HEAVY_PARCEL_THRESHOLD_KG, as Money.
+
+    Partial kilograms above the threshold are charged pro rata (rounded half-up to cents).
+    """
+    if not isinstance(zone, str) or zone not in ZONE_BASE:
+        raise DomainError("E_BAD_ZONE", str(zone))
+    if isinstance(weight_kg, bool) or not isinstance(weight_kg, (int, float, Decimal)):
+        raise DomainError("E_BAD_WEIGHT", str(weight_kg))
+    if weight_kg <= 0:
+        raise DomainError("E_BAD_WEIGHT", str(weight_kg))
+    price = Money.parse(quote(weight_kg, zone))
+    excess = Decimal(str(weight_kg)) - settings.HEAVY_PARCEL_THRESHOLD_KG
+    if excess > 0:
+        price = price + settings.HEAVY_SURCHARGE_PER_KG.scale(excess)
+    return price
