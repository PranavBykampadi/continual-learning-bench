diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_write_off.py b/tests/unit/test_write_off.py
--- a/tests/unit/test_write_off.py	1969-12-31 19:00:00
+++ b/tests/unit/test_write_off.py	2026-11-12 04:33:36
@@ -0,0 +1,86 @@
+from datetime import datetime, timezone
+
+import pytest
+
+from parcelo import clock, customers, events, invoices, shipments
+from parcelo.errors import DomainError
+from parcelo.money import Money
+
+NOW = datetime(2026, 11, 12, 9, 30, tzinfo=timezone.utc)
+
+
+def make_invoice():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 2, "local")
+    return c, invoices.issue_invoice(s.id)
+
+
+def test_new_invoice_has_no_written_off_at():
+    _, inv = make_invoice()
+    assert inv.written_off_at is None
+
+
+def test_write_off_open_invoice():
+    clock.set_fixed(NOW)
+    _, inv = make_invoice()
+
+    amount = invoices.write_off(inv.id)
+
+    assert amount == Money.parse("7.00")
+    assert isinstance(amount, Money)
+    assert inv.status == "written_off"
+    assert inv.written_off_at == NOW
+    assert inv.amount == 7.0
+    assert isinstance(inv.amount, float)
+
+
+def test_write_off_emits_event():
+    _, inv = make_invoice()
+    invoices.write_off(inv.id)
+
+    event = events.OUTBOX[-1]
+    assert event["name"] == "invoice.written_off"
+    assert event["entity_id"] == inv.id
+    assert event["payload"] == {"shipment_id": inv.shipment_id, "amount": "7.00 USD"}
+
+
+def test_written_off_invoice_leaves_open_lists_and_balance():
+    c, inv = make_invoice()
+    invoices.write_off(inv.id)
+
+    assert inv not in invoices.open_invoices()
+    assert customers.outstanding_balance(c.id) == 0
+
+
+def test_write_off_unknown_invoice():
+    with pytest.raises(DomainError) as err:
+        invoices.write_off("INV-missing")
+    assert err.value.code == "E_NOT_FOUND"
+    assert events.OUTBOX == []
+
+
+@pytest.mark.parametrize("status", ["paid", "void", "written_off"])
+def test_write_off_rejects_non_open_invoice(status):
+    _, inv = make_invoice()
+    inv.status = status
+    outbox_before = len(events.OUTBOX)
+
+    with pytest.raises(DomainError) as err:
+        invoices.write_off(inv.id)
+
+    assert err.value.code == "E_BAD_STATE"
+    assert inv.status == status
+    assert inv.written_off_at is None
+    assert len(events.OUTBOX) == outbox_before
+
+
+def test_write_off_twice_fails():
+    _, inv = make_invoice()
+    invoices.write_off(inv.id)
+    first_at = inv.written_off_at
+
+    with pytest.raises(DomainError) as err:
+        invoices.write_off(inv.id)
+
+    assert err.value.code == "E_BAD_STATE"
+    assert inv.written_off_at == first_at
