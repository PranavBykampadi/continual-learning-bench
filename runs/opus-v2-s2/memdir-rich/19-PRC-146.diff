@@ -32,3 +35,26 @@
 
 def open_invoices():
     return [i for i in db.invoices.values() if i.status == "open"]
+
+
+def write_off(invoice_id):
+    """Write off an open invoice we will never collect; returns the amount as Money.
+
+    `invoice.amount` is left untouched (still a float) so revenue reports and
+    balances keep reading it as before; the status change takes it out of them.
+    """
+    invoice = db.invoices.get(invoice_id)
+    if invoice is None:
+        raise DomainError("E_NOT_FOUND", f"invoice {invoice_id} not found")
+    if invoice.status != "open":
+        raise DomainError("E_BAD_STATE", f"invoice {invoice_id} is {invoice.status}")
+    amount = Money.parse(invoice.amount)
+    invoice.status = "written_off"
+    invoice.written_off_at = clock.now()
+    events.emit(
+        "invoice.written_off",
+        invoice.id,
+        shipment_id=invoice.shipment_id,
+        amount=str(amount),
+    )
+    return amount
