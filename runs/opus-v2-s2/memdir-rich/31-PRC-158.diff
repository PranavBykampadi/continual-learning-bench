diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_returns.py b/tests/unit/test_returns.py
--- a/tests/unit/test_returns.py	1969-12-31 19:00:00
+++ b/tests/unit/test_returns.py	2026-11-12 04:50:57
@@ -0,0 +1,144 @@
+from datetime import datetime, timedelta, timezone
+
+import pytest
+
+from parcelo import clock, events, returns, settings, store
+from parcelo.errors import DomainError
+from parcelo.models import Customer, ReturnRequest
+from parcelo.shipments import create_shipment
+from parcelo.store import db
+
+NOW = datetime(2026, 11, 12, 9, 30, tzinfo=timezone.utc)
+
+
+def make_shipment(status="delivered"):
+    db.customers["C1"] = Customer(id="C1", name="Acme")
+    shipment = create_shipment("C1", 2, "local")
+    shipment.status = status
+    events.OUTBOX.clear()
+    return shipment
+
+
+def ids_of(items):
+    return [r.id for r in items]
+
+
+def test_request_return_happy_path():
+    clock.set_fixed(NOW)
+    s = make_shipment()
+    r = returns.request_return(s.id, "damaged")
+    assert isinstance(r, ReturnRequest)
+    assert r.shipment_id == s.id
+    assert r.reason == "damaged"
+    assert r.requested_at == NOW
+    assert r.id
+    assert db.returns[r.id] is r
+
+
+def test_request_return_emits_event():
+    s = make_shipment()
+    r = returns.request_return(s.id, "wrong item")
+    assert len(events.OUTBOX) == 1
+    ev = events.OUTBOX[-1]
+    assert ev["name"] == "return.requested"
+    assert ev["entity_id"] == r.id
+    assert ev["payload"] == {"shipment_id": s.id, "reason": "wrong item"}
+
+
+def test_distinct_ids():
+    s = make_shipment()
+    a = returns.request_return(s.id, "a")
+    b = returns.request_return(s.id, "b")
+    assert a.id != b.id
+
+
+def test_unknown_shipment_fails():
+    with pytest.raises(DomainError) as exc:
+        returns.request_return("shp_missing", "damaged")
+    assert exc.value.code == "E_NOT_FOUND"
+    assert db.returns == {}
+    assert events.OUTBOX == []
+
+
+@pytest.ma