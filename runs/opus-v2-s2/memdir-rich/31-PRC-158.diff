diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/parcelo/returns.py b/parcelo/returns.py
--- a/parcelo/returns.py	1969-12-31 19:00:00
+++ b/parcelo/returns.py	2026-11-12 04:50:27
@@ -0,0 +1,43 @@
+from parcelo import clock, events, ids, settings
+from parcelo.errors import DomainError
+from parcelo.models import ReturnRequest
+from parcelo.shipments import get_shipment
+from parcelo.store import db
+
+
+def request_return(shipment_id, reason):
+    """File a return request for a delivered shipment.
+
+    Errors: unknown shipment → E_NOT_FOUND; shipment not delivered → E_BAD_STATE;
+    blank/non-string reason → E_BAD_INPUT; shipment already has
+    settings.RETURN_MAX_PER_SHIPMENT requests → E_LIMIT.
+    """
+    shipment = get_shipment(shipment_id)
+    if shipment.status != "delivered":
+        raise DomainError("E_BAD_STATE", f"shipment {shipment_id} is {shipment.status}")
+    if not isinstance(reason, str) or not reason.strip():
+        raise DomainError("E_BAD_INPUT", "reason must be a non-empty string")
+    existing = sum(1 for r in db.returns.values() if r.shipment_id == shipment_id)
+    if existing >= settings.RETURN_MAX_PER_SHIPMENT:
+        raise DomainError(
+            "E_LIMIT",
+            f"shipment {shipment_id} already has {existing} return requests",
+        )
+    request = ReturnRequest(
+        id=ids.new_id("ret"),
+        shipment_id=shipment_id,
+        reason=reason,
+        requested_at=clock.now(),
+    )
+    db.returns[request.id] = request
+    events.emit("return.requested", request.id, shipment_id=shipment_id, reason=reason)
+    return request
+
+
+def returns_for(shipment_id):
+    """Return requests filed for a shipment, sorted by id. Unknown shipment → E_NOT_FOUND."""
+    get_shipment(shipment_id)
+    return sorted(
+        (r for r in db.returns.values() if r.shipment_id == shipment_id),
+        key=lambda x: x.id,
+    )
