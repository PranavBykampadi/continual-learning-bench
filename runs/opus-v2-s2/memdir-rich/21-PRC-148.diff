diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_disputes.py b/tests/unit/test_disputes.py
--- a/tests/unit/test_disputes.py	1969-12-31 19:00:00
+++ b/tests/unit/test_disputes.py	2026-11-12 04:36:34
@@ -0,0 +1,76 @@
+from datetime import datetime, timezone
+
+import pytest
+
+from parcelo import clock, events, store
+from parcelo.customers import add_customer
+from parcelo.disputes import open_dispute
+from parcelo.errors import DomainError
+from parcelo.invoices import issue_invoice
+from parcelo.models import Dispute
+from parcelo.shipments import create_shipment
+from parcelo.store import db
+
+NOW = datetime(2026, 11, 12, 9, 30, tzinfo=timezone.utc)
+
+
+def make_invoice():
+    cust = add_customer("Acme")
+    ship = create_shipment(cust.id, 2, "local")
+    inv = issue_invoice(ship.id)
+    events.OUTBOX.clear()
+    return inv
+
+
+def test_open_dispute_creates_and_stores():
+    clock.set_fixed(NOW)
+    inv = make_invoice()
+    d = open_dispute(inv.id, "charged twice")
+    assert isinstance(d, Dispute)
+    assert d.invoice_id == inv.id
+    assert d.reason == "charged twice"
+    assert d.opened_at == NOW
+    assert db.disputes[d.id] is d
+
+
+def test_open_dispute_emits_event():
+    inv = make_invoice()
+    d = open_dispute(inv.id, "wrong amount")
+    assert len(events.OUTBOX) == 1
+    ev = events.OUTBOX[0]
+    assert ev["name"] == "dispute.opened"
+    assert ev["entity_id"] == d.id
+    assert ev["payload"] == {"invoice_id": inv.id}
+
+
+def test_disputes_get_distinct_ids():
+    inv = make_invoice()
+    a = open_dispute(inv.id, "one")
+    b = open_dispute(inv.id, "two")
+    assert a.id != b.id
+    assert len(db.disputes) == 2
+
+
+def test_unknown_invoice_fails():
+    with pytest.raises(DomainError) as e:
+        open_dispute("INV-missing", "reason")
+    assert e.value.code == "E_NOT_FOUND"
+    assert db.disputes == {}
+    assert events.OUTBOX == []
+
+
+@pytest.mark.parametrize("reason", ["", "   ", None, 123])
+def test_empty_reason_fails(reason):
+    inv = make_invoice()
+    with pytest.raises(DomainError) as e:
+        open_dispute(inv.id, reason)
+    assert e.value.code == "E_BAD_INPUT"
+    assert db.disputes == {}
+    assert events.OUTBOX == []
+
+
+def test_reset_clears_disputes():
+    inv = make_invoice()
+    open_dispute(inv.id, "late delivery")
+    store.reset()
+    assert db.disputes == {}
