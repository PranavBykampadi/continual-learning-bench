@@ -0,0 +1,23 @@
+from parcelo import clock, events, ids
+from parcelo.errors import DomainError
+from parcelo.models import Dispute
+from parcelo.store import db
+
+
+def open_dispute(invoice_id, reason):
+    """Open a dispute on an existing invoice and return it."""
+    invoice = db.invoices.get(invoice_id)
+    if invoice is None:
+        raise DomainError("E_NOT_FOUND", f"invoice {invoice_id} not found")
+    if not isinstance(reason, str) or not reason.strip():
+        raise DomainError("E_BAD_INPUT", "reason must be a non-empty string")
+
+    dispute = Dispute(
+        id=ids.new_id("dsp"),
+        invoice_id=invoice.id,
+        reason=reason,
+        opened_at=clock.now(),
+    )
+    db.disputes[dispute.id] = dispute
+    events.emit("dispute.opened", dispute.id, invoice_id=invoice.id)
+    return dispute
