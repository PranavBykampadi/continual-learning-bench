@@ -0,0 +1,34 @@
+from decimal import InvalidOperation
+
+from parcelo import clock, events, ids, settings
+from parcelo.errors import DomainError
+from parcelo.models import Voucher
+from parcelo.money import Money
+from parcelo.store import db
+
+
+def issue_voucher(customer_id, amount):
+    """Issue a goodwill voucher (Money, more than zero, at most settings.VOUCHER_MAX_AMOUNT)."""
+    if customer_id not in db.customers:
+        raise DomainError("E_UNKNOWN_CUSTOMER", str(customer_id))
+    if amount is None or isinstance(amount, bool):
+        raise DomainError("E_BAD_INPUT", f"invalid amount {amount!r}")
+    try:
+        value = Money.parse(amount)
+    except (InvalidOperation, ValueError, TypeError):
+        raise DomainError("E_BAD_INPUT", f"invalid amount {amount!r}")
+    if value <= Money.zero():
+        raise DomainError("E_BAD_INPUT", f"amount must be positive, got {value}")
+    if settings.VOUCHER_MAX_AMOUNT < value:
+        raise DomainError(
+            "E_LIMIT", f"amount {value} exceeds maximum {settings.VOUCHER_MAX_AMOUNT}"
+        )
+    voucher = Voucher(
+        id=ids.new_id("vch"),
+        customer_id=customer_id,
+        amount=value,
+        issued_at=clock.now(),
+    )
+    db.vouchers[voucher.id] = voucher
+    events.emit("voucher.issued", voucher.id, customer_id=customer_id, amount=str(value))
+    return voucher
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_vouchers.py b/tests/unit/test_vouchers.py
--- a/tests/unit/test_vouchers.py	1969-12-31 19:00:00
+++ b/tests/unit/test_vouchers.py	2026-11-12 05:00:12
@@ -0,0 +1,104 @@
+from datetime import datetime, timezone
+
+import pytest
+
+from parcelo import clock, events, settings, store, vouchers
+from parcelo.errors import DomainError
+from parcelo.models import Customer, Voucher
+from parcelo.money import Money
+from parcelo.store import db
+
+NOW = datetime(2026, 11, 12, 9, 30, tzinfo=timezone.utc)
+
+
+def _customer(cid="cus_1"):
+    db.customers[cid] = Customer(id=cid, name="Ada")
+    events.OUTBOX.clear()
+    return cid
+
+
+def test_issue_voucher_happy_path():
+    cid = _customer()
+    clock.set_fixed(NOW)
+    v = vouchers.issue_voucher(cid, "25.50")
+    assert isinstance(v, Voucher)
+    assert v.customer_id == cid
+    assert v.amount == Money.parse("25.50")
+    assert isinstance(v.amount, Money)
+    assert v.issued_at == NOW
+    assert db.vouchers[v.id] is v
+
+
+def test_issue_voucher_emits_event():
+    cid = _customer()
+    v = vouchers.issue_voucher(cid, 10)
+    assert len(events.OUTBOX) == 1
+    ev = events.OUTBOX[-1]
+    assert ev["name"] == "voucher.issued"
+    assert ev["entity_id"] == v.id
+    assert ev["payload"] == {"customer_id": cid, "amount": "10.00 USD"}
+
+
+def test_issue_voucher_accepts_money_and_float():
+    cid = _customer()
+    assert vouchers.issue_voucher(cid, Money.parse("5")).amount == Money.parse("5.00")
+    assert vouchers.issue_voucher(cid, 7.25).amount == Money.parse("7.25")
+
+
+def test_vouchers_get_distinct_ids():
+    cid = _customer()
+    a = vouchers.issue_voucher(cid, 1)
+    b = vouchers.issue_voucher(cid, 1)
+    assert a.id != b.id
+    assert len(db.vouchers) == 2
+
+
+def test_exactly_max_amount_is_allowed():
+    cid = _customer()
+    v = vouchers.issue_voucher(cid, settings.VOUCHER_MAX_AMOUNT)
+    assert v.amount == Money.parse("150.00")
+
+
+@pytest.mark.parametrize("amount", ["150.01", "1000", settings.VOUCHER_MAX_AMOUNT + Money(1)])
+def test_over_max_amount_fails(amount):
+    cid = _customer()
+    with pytest.raises(DomainError) as exc:
+        vouchers.issue_voucher(cid, amount)
+    assert exc.value.code == "E_LIMIT"
+    assert db.vouchers == {}
+    assert events.OUTBOX == []
+
+
+@pytes