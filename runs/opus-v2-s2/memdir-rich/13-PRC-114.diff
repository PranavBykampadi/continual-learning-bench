+AGING_BUCKETS = ("0-30", "31-60", "60+")
+
+
+def _age_in_days(issued_at, now):
+    # Same arithmetic as the old billing days_between: whole days via timedelta.days.
+    # Legacy issue_invoice stores naive UTC timestamps; clock.now() is tz-aware.
+    if issued_at.tzinfo is None:
+        issued_at = issued_at.replace(tzinfo=timezone.utc)
+    return (now - issued_at).days
+
+
+def _aging_bucket(age_days):
+    if age_days <= 30:
+        return "0-30"
+    if age_days <= 60:
+        return "31-60"
+    return "60+"
+
+
+def aging_report():
+    """Total amount of open invoices by age since issue, as Money per bucket."""
+    now = clock.now()
+    report = {bucket: Money.zero() for bucket in AGING_BUCKETS}
+    for invoice in db.invoices.values():
+        if invoice.status != "open":
+            continue
+        bucket = _aging_bucket(_age_in_days(invoice.issued_at, now))
+        report[bucket] = report[bucket] + Money.parse(invoice.amount)
+    return report
