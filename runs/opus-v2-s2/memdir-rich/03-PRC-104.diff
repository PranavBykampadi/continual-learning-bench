diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_deactivate_customer.py b/tests/unit/test_deactivate_customer.py
--- a/tests/unit/test_deactivate_customer.py	1969-12-31 19:00:00
+++ b/tests/unit/test_deactivate_customer.py	2026-11-12 04:14:18
@@ -0,0 +1,44 @@
+import pytest
+
+from parcelo import audit, customers
+from parcelo.errors import DomainError
+
+
+def test_deactivate_customer_sets_inactive_and_returns_customer():
+    c = customers.add_customer("Acme")
+
+    result = customers.deactivate_customer(c.id)
+
+    assert result is c
+    assert result.active is False
+    assert customers.get_customer(c.id).active is False
+    assert audit.LOG[-1]["action"] == "customer.deactivated"
+    assert audit.LOG[-1]["entity_id"] == c.id
+
+
+def test_deactivate_unknown_customer_fails():
+    with pytest.raises(DomainError) as err:
+        customers.deactivate_customer("C-missing")
+    assert err.value.code == "E_NOT_FOUND"
+    assert audit.LOG == []
+
+
+def test_deactivate_already_inactive_customer_fails():
+    c = customers.add_customer("Acme")
+    customers.deactivate_customer(c.id)
+    log_len = len(audit.LOG)
+
+    with pytest.raises(DomainError) as err:
+        customers.deactivate_customer(c.id)
+    assert err.value.code == "E_BAD_STATE"
+    assert c.active is False
+    assert len(audit.LOG) == log_len
+
+
+def test_deactivate_does_not_affect_other_customers():
+    a = customers.add_customer("Acme")
+    b = customers.add_customer("Globex")
+
+    customers.deactivate_customer(a.id)
+
+    assert b.active is True
