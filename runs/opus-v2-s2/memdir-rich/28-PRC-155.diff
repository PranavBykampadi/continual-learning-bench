+def customers_by_tier(tier):
+    """Return the customers on ``tier``, sorted by id.
+
+    Includes inactive customers. Unknown tier → DomainError E_BAD_INPUT.
+    """
+    if not isinstance(tier, str) or tier not in TIERS:
+        raise DomainError("E_BAD_INPUT", f"unknown tier {tier!r}")
+    return sorted(
+        (c for c in db.customers.values() if c.tier == tier),
+        key=lambda x: x.id,
+    )
 
 
