diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_customer_addresses.py b/tests/unit/test_customer_addresses.py
--- a/tests/unit/test_customer_addresses.py	1969-12-31 19:00:00
+++ b/tests/unit/test_customer_addresses.py	2026-11-12 04:20:16
@@ -0,0 +1,62 @@
+import pytest
+
+from parcelo import audit, customers, store
+from parcelo.errors import DomainError
+from parcelo.models import Address
+from parcelo.store import db
+
+
+def test_add_address_creates_and_stores():
+    c = customers.add_customer("Acme")
+    a = customers.add_address(c.id, "1 Main St", "Springfield")
+    assert isinstance(a, Address)
+    assert a.id.startswith("adr_")
+    assert a.customer_id == c.id
+    assert a.line == "1 Main St"
+    assert a.city == "Springfield"
+    assert db.addresses[a.id] is a
+    assert audit.LOG[-1]["action"] == "address.created"
+    assert audit.LOG[-1]["entity_id"] == a.id
+
+
+def test_multiple_addresses_get_distinct_ids():
+    c = customers.add_customer("Acme")
+    a1 = customers.add_address(c.id, "1 Main St", "Springfield")
+    a2 = customers.add_address(c.id, "2 Side Rd", "Shelbyville")
+    assert a1.id != a2.id
+    assert len(db.addresses) == 2
+
+
+def test_unknown_customer_fails():
+    with pytest.raises(DomainError) as err:
+        customers.add_address("nope", "1 Main St", "Springfield")
+    assert err.value.code == "E_UNKNOWN_CUSTOMER"
+    assert db.addresses == {}
+    assert audit.LOG == []
+
+
+@pytest.mark.parametrize(
+    "line, city",
+    [
+        ("", "Springfield"),
+        ("   ", "Springfield"),
+        (None, "Springfield"),
+        ("1 Main St", ""),
+        ("1 Main St", "  "),
+        ("1 Main St", None),
+    ],
+)
+def test_empty_line_or_city_fails(line, city):
+    c = customers.add_customer("Acme")
+    with pytest.raises(DomainError) as err:
+        customers.add_address(c.id, line, city)
+    assert err.value.code == "E_BAD_INPUT"
+    assert db.addresses == {}
+    assert audit.LOG == []
+
+
+def test_reset_clears_addresses():
+    c = customers.add_customer("Acme")
+    customers.add_address(c.id, "1 Main St", "Springfield")
+    store.reset()
+    assert db.addresses == {}
