+def reactivate_customer(customer_id):
+    """Switch a customer back on and return it.
+
+    Unknown id -> DomainError E_NOT_FOUND. Idempotent: an already-active
+    customer is returned unchanged, with no second event.
+    """
+    customer = db.customers.get(customer_id)
+    if customer is None:
+        raise DomainError("E_NOT_FOUND", customer_id)
+    if customer.active:
+        return customer
+    customer.active = True
+    events.emit("customer.reactivated", customer.id)
+    return customer
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_reactivate_customer.py b/tests/unit/test_reactivate_customer.py
--- a/tests/unit/test_reactivate_customer.py	1969-12-31 19:00:00
+++ b/tests/unit/test_reactivate_customer.py	2026-11-12 04:45:58
@@ -0,0 +1,77 @@
+import pytest
+
+from parcelo import customers, events
+from parcelo.errors import DomainError
+from parcelo.store import db
+
+
+def make_inactive_customer():
+    customer = customers.add_customer("Acme")
+    customer.active = False
+    events.OUTBOX.clear()
+    return customer
+
+
+def test_reactivate_sets_active_and_returns_customer():
+    customer = make_inactive_customer()
+
+    result = customers.reactivate_customer(customer.id)
+
+    assert result is customer
+    assert customer.active is True
+    assert db.customers[customer.id].active is True
+
+
+def test_reactivate_emits_event():
+    customer = make_inactive_customer()
+
+    customers.reactivate_customer(customer.id)
+
+    assert len(events.OUTBOX) == 1
+    event = events.OUTBOX[-1]
+    assert event["name"] == "customer.reactivated"
+    assert event["entity_id"] == customer.id
+    assert event["payload"] == {}
+
+
+def test_reactivate_twice_is_idempotent():
+    customer = make_inactive_customer()
+
+    first = customers.reactivate_customer(customer.id)
+    second = customers.reactivate_customer(customer.id)
+
+    assert first is second is customer
+    assert customer.active is True
+    assert len(events.OUTBOX) == 1
+
+
+def test_reactivate_already_active_customer_returns_unchanged():
+    customer = customers.add_customer("Acme", tier="gold")
+    events.OUTBOX.clear()
+
+    result = customers.reactivate_customer(customer.id)
+
+    assert result is customer
+    assert customer.active is True
+    assert customer.tier == "gold"
+    assert events.OUTBOX == []
+
+
+def test_reactivate_unknown_customer_fails():
+    with pytest.raises(DomainError) as err:
+        customers.reactivate_customer("C-missing")
+
+    assert err.value.code == "E_NOT_FOUND"
+    assert events.OUTBOX == []
+    assert db.customers == {}
+
+
+def test_reactivate_only_touches_given_customer():
+    target = make_inactive_customer()
+    other = customers.add_customer("Other")
+    other.active = False
+
+    customers.reactivate_customer(target.id)
+
+    assert target.active is True
+    assert other.active is False
