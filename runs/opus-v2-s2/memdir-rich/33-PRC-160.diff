diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/parcelo/shipments.py b/parcelo/shipments.py
--- a/parcelo/shipments.py	2026-11-10 12:20:18
+++ b/parcelo/shipments.py	2026-11-12 04:53:47
@@ -28,3 +28,21 @@
     if shipment_id not in db.shipments:
         raise DomainError("E_NOT_FOUND", shipment_id)
     return db.shipments[shipment_id]
+
+
+def mark_returned(shipment_id):
+    """Record that a delivered shipment came back to the depot.
+
+    Only a "delivered" shipment can be marked returned; any other status
+    (e.g. "created") raises E_BAD_STATE. Unknown id raises E_NOT_FOUND.
+    Idempotent: an already-returned shipment is returned unchanged.
+    """
+    shipment = get_shipment(shipment_id)
+    if shipment.status == "returned":
+        return shipment
+    if shipment.status != "delivered":
+        raise DomainError("E_BAD_STATE", f"{shipment_id} is {shipment.status}")
+    shipment.status = "returned"
+    shipment.returned_at = clock.now()
+    events.emit("shipment.returned", shipment.id, customer_id=shipment.customer_id)
+    return shipment
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_mark_returned.py b/tests/unit/test_mark_returned.py
--- a/tests/unit/test_mark_returned.py	1969-12-31 19:00:00
+++ b/tests/unit/test_mark_returned.py	2026-11-12 04:53:56
@@ -0,0 +1,76 @@
+from datetime import datetime, timezone
+
+import pytest
+
+from parcelo import clock, customers, events, shipments
+from parcelo.errors import DomainError
+
+NOW = datetime(2026, 11, 12, 10, 0, tzinfo=timezone.utc)
+LATER = datetime(2026, 11, 13, 9, 0, tzinfo=timezone.utc)
+
+
+def _delivered():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 2, "local")
+    s.status = "delivered"
+    events.OUTBOX.clear()
+    return s
+
+
+def test_new_shipment_has_no_returned_at():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 2, "local")
+    assert s.returned_at is None
+
+
+def test_mark_returned_happy_path():
+    s = _delivered()
+    clock.set_fixed(NOW)
+    result = shipments.mark_returned(s.id)
+    assert result is s
+    assert s.status == "returned"
+    assert s.returned_at == NOW
+
+
+def test_mark_returned_emits_event():
+    s = _delivered()
+    clock.set_fixed(NOW)
+    shipments.mark_returned(s.id)
+    assert len(events.OUTBOX) == 1
+    ev = events.OUTBOX[-1]
+    assert ev["name"] == "shipment.returned"
+    assert ev["entity_id"] == s.id
+    assert ev["payload"] == {"customer_id": s.customer_id}
+
+
+def test_unknown_shipment_fails():
+    with pytest.raises(DomainError) as err:
+        shipments.mark_returned("shp_nope")
+    assert err.value.code == "E_NOT_FOUND"
+    assert events.OUTBOX == []
+
+
+@pytest.mark.parametrize("status", ["created", "cancelled"])
+def test_not_delivered_fails(status):
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 2, "local")
+    s.status = status
+    events.OUTBOX.clear()
+    with pytest.raises(DomainError) as err:
+        shipments.mark_returned(s.id)
+    assert err.value.code == "E_BAD_STATE"
+    assert s.status == status
+    assert s.returned_at is None
+    assert events.OUTBOX == []
+
+
+def test_mark_returned_twice_is_idempotent():
+    s = _delivered()
+    clock.set_fixed(NOW)
+    shipments.mark_returned(s.id)
+    clock.set_fixed(LATER)
+    again = shipments.mark_returned(s.id)
+    assert again is s
+    assert s.status == "returned"
+    assert s.returned_at == NOW
+    assert len(events.OUTBOX) == 1
