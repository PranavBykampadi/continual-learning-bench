+def lock_customer(customer_id):
+    """Lock a customer account (e.g. after suspicious logins).
+
+    Idempotent: an already-locked customer is returned unchanged.
+    Unknown id → DomainError E_NOT_FOUND.
+    """
+    customer = db.customers.get(customer_id)
+    if customer is None:
+        raise DomainError("E_NOT_FOUND", f"customer {customer_id!r} not found")
+    if customer.locked:
+        return customer
+    customer.locked = True
+    events.emit("customer.locked", customer.id)
+    return customer
 
 
