diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_lock_customer.py b/tests/unit/test_lock_customer.py
--- a/tests/unit/test_lock_customer.py	1969-12-31 19:00:00
+++ b/tests/unit/test_lock_customer.py	2026-11-12 04:58:32
@@ -0,0 +1,51 @@
+import pytest
+
+from parcelo import customers, events
+from parcelo.errors import DomainError
+from parcelo.store import db
+
+
+def test_new_customer_is_not_locked():
+    c = customers.add_customer("Acme")
+    assert c.locked is False
+
+
+def test_lock_customer_sets_flag_and_returns_customer():
+    c = customers.add_customer("Acme")
+    result = customers.lock_customer(c.id)
+    assert result is c
+    assert c.locked is True
+    assert db.customers[c.id].locked is True
+    assert c.active is True
+
+
+def test_lock_customer_emits_event():
+    c = customers.add_customer("Acme")
+    customers.lock_customer(c.id)
+    assert len(events.OUTBOX) == 1
+    assert events.OUTBOX[-1]["name"] == "customer.locked"
+    assert events.OUTBOX[-1]["entity_id"] == c.id
+    assert events.OUTBOX[-1]["payload"] == {}
+
+
+def test_lock_unknown_customer_fails():
+    with pytest.raises(DomainError) as err:
+        customers.lock_customer("C-missing")
+    assert err.value.code == "E_NOT_FOUND"
+    assert events.OUTBOX == []
+
+
+def test_lock_twice_is_idempotent():
+    c = customers.add_customer("Acme")
+    first = customers.lock_customer(c.id)
+    second = customers.lock_customer(c.id)
+    assert second is first
+    assert c.locked is True
+    assert len(events.OUTBOX) == 1
+
+
+def test_lock_only_affects_target_customer():
+    a = customers.add_customer("Acme")
+    b = customers.add_customer("Beta")
+    customers.lock_customer(a.id)
+    assert b.locked is False
