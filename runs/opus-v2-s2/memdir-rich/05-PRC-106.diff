@@ -32,3 +36,24 @@
 
 def open_invoices():
     return [i for i in db.invoices.values() if i.status == "open"]
+
+
+LATE_AFTER_DAYS = 30
+LATE_FEE_DAILY_RATE = "0.015"
+
+
+def late_fee_for(invoice_id):
+    """Late fee accrued on an open invoice as of clock.now(), as Money."""
+    if invoice_id not in db.invoices:
+        raise DomainError("E_NOT_FOUND", f"invoice {invoice_id} not found")
+    invoice = db.invoices[invoice_id]
+    if invoice.status != "open":
+        raise DomainError("E_BAD_STATE", f"invoice {invoice_id} is {invoice.status}")
+    issued_at = invoice.issued_at
+    if issued_at.tzinfo is None:
+        # Legacy issue_invoice stores naive UTC timestamps.
+        issued_at = issued_at.replace(tzinfo=timezone.utc)
+    days_late = (clock.now() - issued_at).days - LATE_AFTER_DAYS
+    if days_late <= 0:
+        return Money.zero()
+    return Money.parse(invoice.amount).scale(Decimal(LATE_FEE_DAILY_RATE) * days_late)
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_late_fee.py b/tests/unit/test_late_fee.py
--- a/tests/unit/test_late_fee.py	1969-12-31 19:00:00
+++ b/tests/unit/test_late_fee.py	2026-11-12 04:17:00
@@ -0,0 +1,96 @@
+from datetime import datetime, timedelta, timezone
+
+import pytest
+
+from parcelo import audit, clock, customers, invoices, shipments
+from parcelo.errors import DomainError
+from parcelo.money import Money
+
+ISSUED = datetime(2026, 1, 1, 12, 0, tzinfo=timezone.utc)
+
+
+def _invoice(amount=100.0, issued_at=ISSUED):
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 2, "local")
+    inv = invoices.issue_invoice(s.id)
+    inv.amount = amount
+    inv.issued_at = issued_at
+    return inv
+
+
+def _at(days_after_issue):
+    clock.set_fixed(ISSUED + timedelta(days=days_after_issue))
+
+
+def test_not_late_yet_is_zero():
+    inv = _invoice()
+    _at(10)
+    assert invoices.late_fee_for(inv.id) == Money.zero()
+
+
+def test_exactly_30_days_is_zero():
+    inv = _invoice()
+    _at(30)
+    assert invoices.late_fee_for(inv.id) == Money.zero()
+
+
+def test_one_day_late():
+    inv = _invoice()
+    _at(31)
+    assert invoices.late_fee_for(inv.id) == Money.parse("1.50")
+
+
+def test_ten_days_late():
+    inv = _invoice()
+    _at(40)
+    assert invoices.late_fee_for(inv.id) == Money.parse("15.00")
+
+
+def test_rounds_to_cents():
+    inv = _invoice(amount=11.5)
+    _at(33)  # 11.50 * 0.015 * 3 = 0.5175
+    assert invoices.late_fee_for(inv.id) == Money.parse("0.52")
+
+
+def test_partial_day_does_not_count():
+    inv = _invoice()
+    clock.set_fixed(ISSUED + timedelta(days=31, hours=-1))
+    assert invoices.late_fee_for(inv.id) == Money.zero()
+
+
+def test_naive_issued_at_treated_as_utc():
+    inv = _invoice(issued_at=ISSUED.replace(tzinfo=None))
+    _at(32)
+    assert invoices.late_fee_for(inv.id) == Money.parse("3.00")
+
+
+def test_returns_money():
+    inv = _invoice()
+    _at(31)
+    assert isinstance(invoices.late_fee_for(inv.id), Money)
+
+
+def test_unknown_invoice_fails():
+    with pytest.raises(DomainError) as err:
+        invoices.late_fee_for("INV-missing")
+    assert err.value.code == "E_NOT_FOUND"
+
+
+@pytest.mark.parametrize("status", ["paid", "void"])
+def test_non_open_invoice_fails(status):
+    inv = _invoice()
+    inv.status = status
+    _at(40)
+    with pytest.raises(DomainError) as err:
+        invoices.late_fee_for(inv.id)
+    assert err.value.code == "E_BAD_STATE"
+
+
+def test_does_not_change_invoice_or_audit():
+    inv = _invoice()
+    _at(40)
+    log_len = len(audit.LOG)
+    invoices.late_fee_for(inv.id)
+    assert inv.status == "open"
+    assert inv.amount == 100.0
+    assert len(audit.LOG) == log_len
