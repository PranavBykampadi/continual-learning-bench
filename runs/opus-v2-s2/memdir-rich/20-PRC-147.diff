     return counts
 
 
+VOLUME_TIERS = ((50, "bulk"), (10, "regular"), (0, "starter"))  # same thresholds as legacy volume_tier
+
+
+def _volume_tier(shipment_count):
+    for minimum, label in VOLUME_TIERS:
+        if shipment_count >= minimum:
+            return label
+    return VOLUME_TIERS[-1][1]
+
+
+def volume_report():
+    """Shipment count and volume tier per customer, including customers with none."""
+    counts = {customer_id: 0 for customer_id in db.customers}
+    for shipment in db.shipments.values():
+        if shipment.customer_id in counts:
+            counts[shipment.customer_id] += 1
+    return {
+        customer_id: {"shipments": count, "tier": _volume_tier(count)}
+        for customer_id, count in counts.items()
+    }
+
+
