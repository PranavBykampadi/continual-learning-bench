+
+def add_note(shipment_id, text):
+    shipment = get_shipment(shipment_id)
+    if not isinstance(text, str) or not text.strip():
+        raise DomainError("E_BAD_INPUT", "note text must not be empty")
+    shipment.notes.append({"text": text, "at": clock.now()})
+    audit.record("shipment.note_added", shipment.id)
+    return shipment
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_shipment_notes.py b/tests/unit/test_shipment_notes.py
--- a/tests/unit/test_shipment_notes.py	1969-12-31 19:00:00
+++ b/tests/unit/test_shipment_notes.py	2026-11-12 04:22:21
@@ -0,0 +1,67 @@
+from datetime import datetime, timezone
+
+import pytest
+
+from parcelo import audit, clock, customers, shipments
+from parcelo.errors import DomainError
+
+
+def _shipment():
+    c = customers.add_customer("Acme")
+    return shipments.create_shipment(c.id, 2, "local")
+
+
+def test_add_note_appends_timestamped_note():
+    s = _shipment()
+    moment = datetime(2026, 11, 12, 9, 30, tzinfo=timezone.utc)
+    clock.set_fixed(moment)
+
+    result = shipments.add_note(s.id, "Customer called about delay")
+
+    assert result is s
+    assert s.notes == [{"text": "Customer called about delay", "at": moment}]
+    assert audit.LOG[-1]["action"] == "shipment.note_added"
+    assert audit.LOG[-1]["entity_id"] == s.id
+
+
+def test_notes_keep_order_and_own_timestamps():
+    s = _shipment()
+    first = datetime(2026, 11, 12, 9, 0, tzinfo=timezone.utc)
+    second = datetime(2026, 11, 12, 10, 0, tzinfo=timezone.utc)
+
+    clock.set_fixed(first)
+    shipments.add_note(s.id, "first")
+    clock.set_fixed(second)
+    shipments.add_note(s.id, "second")
+
+    assert s.notes == [
+        {"text": "first", "at": first},
+        {"text": "second", "at": second},
+    ]
+
+
+def test_notes_are_per_shipment():
+    a = _shipment()
+    b = _shipment()
+    shipments.add_note(a.id, "only on a")
+    assert len(a.notes) == 1
+    assert b.notes == []
+
+
+def test_unknown_shipment():
+    with pytest.raises(DomainError) as err:
+        shipments.add_note("shp_nope", "hello")
+    assert err.value.code == "E_NOT_FOUND"
+
+
+@pytest.mark.parametrize("text", ["", "   ", None])
+def test_empty_text_rejected(text):
+    s = _shipment()
+    log_len = len(audit.LOG)
+
+    with pytest.raises(DomainError) as err:
+        shipments.add_note(s.id, text)
+
+    assert err.value.code == "E_BAD_INPUT"
+    assert s.notes == []
+    assert len(audit.LOG) == log_len
