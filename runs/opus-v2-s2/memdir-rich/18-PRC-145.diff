+def upgrade_tier(customer_id):
+    if customer_id not in db.customers:
+        raise DomainError("E_NOT_FOUND", customer_id)
+    customer = db.customers[customer_id]
+    if customer.tier != "standard":
+        raise DomainError("E_BAD_STATE", f"{customer_id} is already {customer.tier}")
+    previous = customer.tier
+    customer.tier = "gold"
+    events.emit("customer.upgraded", customer.id, from_tier=previous, to_tier="gold")
+    return customer
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_upgrade_tier.py b/tests/unit/test_upgrade_tier.py
--- a/tests/unit/test_upgrade_tier.py	1969-12-31 19:00:00
+++ b/tests/unit/test_upgrade_tier.py	2026-11-12 04:32:13
@@ -0,0 +1,43 @@
+import pytest
+
+from parcelo import customers, events
+from parcelo.errors import DomainError
+from parcelo.store import db
+
+
+def test_upgrade_standard_customer_to_gold():
+    c = customers.add_customer("Acme")
+    result = customers.upgrade_tier(c.id)
+    assert result is c
+    assert c.tier == "gold"
+    assert db.customers[c.id].tier == "gold"
+    evt = events.OUTBOX[-1]
+    assert evt["name"] == "customer.upgraded"
+    assert evt["entity_id"] == c.id
+    assert evt["payload"] == {"from_tier": "standard", "to_tier": "gold"}
+
+
+def test_upgrade_unknown_customer_fails():
+    with pytest.raises(DomainError) as exc:
+        customers.upgrade_tier("nope")
+    assert exc.value.code == "E_NOT_FOUND"
+    assert events.OUTBOX == []
+
+
+def test_upgrade_gold_customer_fails_and_leaves_it_unchanged():
+    c = customers.add_customer("Acme", tier="gold")
+    before = len(events.OUTBOX)
+    with pytest.raises(DomainError) as exc:
+        customers.upgrade_tier(c.id)
+    assert exc.value.code == "E_BAD_STATE"
+    assert c.tier == "gold"
+    assert len(events.OUTBOX) == before
+
+
+def test_upgrade_twice_fails_second_time():
+    c = customers.add_customer("Acme")
+    customers.upgrade_tier(c.id)
+    with pytest.raises(DomainError) as exc:
+        customers.upgrade_tier(c.id)
+    assert exc.value.code == "E_BAD_STATE"
+    assert len(events.OUTBOX) == 1
