+def rebate_for(customer_id):
+    """Volume rebate earned by a customer, as Money.
+
+    A share of the total of the customer's paid invoices, picked by how many
+    shipments the customer has (every status counts), using
+    ``settings.VOLUME_REBATE_TIERS``. Below the lowest cut-off the rebate is zero.
+    Unknown customer → DomainError E_UNKNOWN_CUSTOMER. Read-only: emits no events.
+    """
+    if customer_id not in db.customers:
+        raise DomainError("E_UNKNOWN_CUSTOMER", customer_id)
+
+    shipment_count = sum(
+        1 for s in db.shipments.values() if s.customer_id == customer_id
+    )
+    share = Decimal("0")
+    for minimum, pct in settings.VOLUME_REBATE_TIERS:
+        if shipment_count >= minimum:
+            share = pct
+            break
+
+    paid_total = Money.zero()
+    for invoice in db.invoices.values():
+        shipment = db.shipments.get(invoice.shipment_id)
+        if shipment is None or shipment.customer_id != customer_id:
+            continue
+        if invoice.status == "paid":
+            paid_total = paid_total + Money.parse(invoice.amount)
+
+    return paid_total.scale(share)
