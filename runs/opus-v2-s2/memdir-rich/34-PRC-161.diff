+import pytest
+
+from parcelo import customers, events
+from parcelo.errors import DomainError
+from parcelo.models import Customer, Invoice, Shipment
+from parcelo.money import Money
+from parcelo.store import db
+
+
+def _customer(cid="C1"):
+    db.customers[cid] = Customer(id=cid, name=cid)
+    return cid
+
+
+def _shipments(cid, n, status="created"):
+    made = []
+    for i in range(n):
+        sid = f"{cid}_shp_{i:04d}"
+        db.shipments[sid] = Shipment(
+            id=sid, customer_id=cid, weight_kg=1.0, zone="local", status=status
+        )
+        made.append(sid)
+    return made
+
+
+def _invoice(iid, shipment_id, amount, status="paid"):
+    db.invoices[iid] = Invoice(id=iid, shipment_id=shipment_id, amount=amount, status=status)
+
+
+def test_unknown_customer_fails():
+    with pytest.raises(DomainError) as err:
+        customers.rebate_for("nope")
+    assert err.value.code == "E_UNKNOWN_CUSTOMER"
+    assert events.OUTBOX == []
+
+
+def test_no_shipments_no_invoices_is_zero():
+    cid = _customer()
+    assert customers.rebate_for(cid) == Money.zero()
+
+
+@pytest.mark.parametrize(
+    "count, expected",
+    [
+        (0, "0.00"),
+        (9, "0.00"),
+        (10, "30.00"),
+        (49, "30.00"),
+        (50, "60.00"),
+        (75, "60.00"),
+    ],
+)
+def test_tier_boundaries(count, expected):
+    cid = _customer()
+    sids = _shipments(cid, count)
+    if sids:
+        _invoice("I1", sids[0], 1000.0)
+    else:
+        db.shipments["lone"] = Shipment(id="lone", customer_id="OTHER", weight_kg=1, zone="local")
+    assert customers.rebate_for(cid) == Money.parse(expected)
+
+
+def test_only_paid_invoices_count():
+    cid = _customer()
+    sids = _shipments(cid, 10)
+    _invoice("I1", sids[0], 100.0, "paid")
+    _invoice("I2", sids[1], 200.0, "paid")
+    _invoice("I3", sids[2], 5000.0, "open")
+    _invoice("I4", sids[3], 7000.0, "void")
+    assert customers.rebate_for(cid) == Money.parse("9.00")
+
+
+def test_other_customers_invoices_and_shipments_ignored():
+    a = _customer("C1")
+    b = _customer("C2")
+    a_sids = _shipments(a, 10)
+    b_sids = _shipments(b, 50)
+    _invoice("I1", a_sids[0], 100.0)
+    _invoice("I2", b_sids[0], 1000.0)
+    assert customers.rebate_for(a) == Money.parse("3.00")
+    assert customers.rebate_for(b) == Money.parse("60.00")
+
+
