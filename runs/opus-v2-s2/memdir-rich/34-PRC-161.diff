+"""Business thresholds and rates. Finance changes these; keep them all here."""
+from decimal import Decimal
+
+# PRC-161: volume rebate on paid invoices, by shipment count.
+# Same shipment-count cut-offs as legacy volume_tier (50 → bulk, 10 → regular).
+# Ordered highest minimum first: (minimum shipments, rebate share).
+VOLUME_REBATE_TIERS = (
+    (50, Decimal("0.06")),
+    (10, Decimal("0.03")),
+)
