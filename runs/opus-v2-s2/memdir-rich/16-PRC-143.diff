@@ -0,0 +1,25 @@
+from datetime import datetime
+
+from parcelo import clock, events, ids
+from parcelo.errors import DomainError
+from parcelo.models import Pickup
+from parcelo.shipments import get_shipment
+from parcelo.store import db
+
+
+def schedule_pickup(shipment_id, window_start):
+    """Book a pickup for a shipment that is ready to go (status "created")."""
+    shipment = get_shipment(shipment_id)
+    if shipment.status != "created":
+        raise DomainError("E_BAD_STATE", f"{shipment_id} is {shipment.status}")
+    if not isinstance(window_start, datetime):
+        raise DomainError("E_BAD_INPUT", f"window_start must be a datetime: {window_start!r}")
+    pickup = Pickup(
+        id=ids.new_id("pck"),
+        shipment_id=shipment.id,
+        window_start=window_start,
+        scheduled_at=clock.now(),
+    )
+    db.pickups[pickup.id] = pickup
+    events.emit("pickup.scheduled", pickup.id, shipment_id=shipment.id, window_start=window_start)
+    return pickup
