diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_schedule_pickup.py b/tests/unit/test_schedule_pickup.py
--- a/tests/unit/test_schedule_pickup.py	1969-12-31 19:00:00
+++ b/tests/unit/test_schedule_pickup.py	2026-11-12 04:29:54
@@ -0,0 +1,86 @@
+from datetime import datetime, timedelta, timezone
+
+import pytest
+
+from parcelo import clock, customers, events, pickups, shipments, store
+from parcelo.errors import DomainError
+from parcelo.models import Pickup
+from parcelo.store import db
+
+NOW = datetime(2026, 11, 12, 9, 0, tzinfo=timezone.utc)
+WINDOW = NOW + timedelta(days=1)
+
+
+@pytest.fixture
+def shipment():
+    clock.set_fixed(NOW)
+    c = customers.add_customer("Acme")
+    return shipments.create_shipment(c.id, 2, "local")
+
+
+def test_schedule_pickup_happy_path(shipment):
+    p = pickups.schedule_pickup(shipment.id, WINDOW)
+    assert isinstance(p, Pickup)
+    assert p.id.startswith("pck_")
+    assert p.shipment_id == shipment.id
+    assert p.window_start == WINDOW
+    assert p.scheduled_at == NOW
+    assert db.pickups[p.id] is p
+
+
+def test_schedule_pickup_emits_event(shipment):
+    p = pickups.schedule_pickup(shipment.id, WINDOW)
+    ev = events.OUTBOX[-1]
+    assert ev["name"] == "pickup.scheduled"
+    assert ev["entity_id"] == p.id
+    assert ev["payload"] == {"shipment_id": shipment.id, "window_start": WINDOW}
+
+
+def test_distinct_ids(shipment):
+    p1 = pickups.schedule_pickup(shipment.id, WINDOW)
+    p2 = pickups.schedule_pickup(shipment.id, WINDOW + timedelta(hours=2))
+    assert p1.id != p2.id
+    assert len(db.pickups) == 2
+
+
+def test_unknown_shipment():
+    with pytest.raises(DomainError) as err:
+        pickups.schedule_pickup("shp_nope", WINDOW)
+    assert err.value.code == "E_NOT_FOUND"
+    assert db.pickups == {}
+    assert events.OUTBOX == []
+
+
+@pytest.mark.parametrize("status", ["cancelled", "delivered"])
+def test_shipment_not_created(shipment, status):
+    shipment.status = status
+    before = len(events.OUTBOX)
+    with pytest.raises(DomainError) as err:
+        pickups.schedule_pickup(shipment.id, WINDOW)
+    assert err.value.code == "E_BAD_STATE"
+    assert db.pickups == {}
+    assert len(events.OUTBOX) == before
+    assert shipment.status == status
+
+
+@pytest.mark.parametrize("bad", [None, "", "2026-11-13", 123])
+def test_bad_window_start(shipment, bad):
+    before = len(events.OUTBOX)
+    with pytest.raises(DomainError) as err:
+        pickups.schedule_pickup(shipment.id, bad)
+    assert err.value.code == "E_BAD_INPUT"
+    assert db.pickups == {}
+    assert len(events.OUTBOX) == before
+
+
+def test_bad_state_checked_before_bad_input(shipment):
+    shipment.status = "cancelled"
+    with pytest.raises(DomainError) as err:
+        pickups.schedule_pickup(shipment.id, None)
+    assert err.value.code == "E_BAD_STATE"
+
+
+def test_reset_clears_pickups(shipment):
+    pickups.schedule_pickup(shipment.id, WINDOW)
+    store.reset()
+    assert db.pickups == {}
