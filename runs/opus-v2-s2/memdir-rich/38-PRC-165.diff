+def shipments_without_invoice():
+    """Shipments that no invoice refers to (any invoice status), sorted by id.
+
+    Read-only: no mutation, no events.
+    """
+    invoiced = {invoice.shipment_id for invoice in db.invoices.values()}
+    return sorted(
+        (s for s in db.shipments.values() if s.id not in invoiced),
+        key=lambda x: x.id,
+    )
+
