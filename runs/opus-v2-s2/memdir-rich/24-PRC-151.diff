@@ -28,3 +28,15 @@
     if shipment_id not in db.shipments:
         raise DomainError("E_NOT_FOUND", shipment_id)
     return db.shipments[shipment_id]
+
+
+def list_shipments(customer_id):
+    """Return every shipment of a customer, oldest first (booking order).
+
+    Read-only: no events. Includes shipments in any status. Returns an
+    empty list if the customer has none; unknown customer ->
+    DomainError E_UNKNOWN_CUSTOMER.
+    """
+    if customer_id not in db.customers:
+        raise DomainError("E_UNKNOWN_CUSTOMER", customer_id)
+    return [s for s in db.shipments.values() if s.customer_id == customer_id]
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_list_shipments.py b/tests/unit/test_list_shipments.py
--- a/tests/unit/test_list_shipments.py	1969-12-31 19:00:00
+++ b/tests/unit/test_list_shipments.py	2026-11-12 04:41:01
@@ -0,0 +1,57 @@
+import pytest
+
+from parcelo import events
+from parcelo.customers import add_customer
+from parcelo.errors import DomainError
+from parcelo.shipments import create_shipment, list_shipments
+from parcelo.store import db
+
+
+def test_returns_only_that_customers_shipments_in_booking_order():
+    alice = add_customer("Alice")
+    bob = add_customer("Bob")
+    a1 = create_shipment(alice.id, 1.0, "local")
+    b1 = create_shipment(bob.id, 2.0, "local")
+    a2 = create_shipment(alice.id, 3.0, "local")
+
+    assert list_shipments(alice.id) == [a1, a2]
+    assert list_shipments(bob.id) == [b1]
+
+
+def test_customer_without_shipments_gets_empty_list():
+    alice = add_customer("Alice")
+    assert list_shipments(alice.id) == []
+
+
+def test_includes_shipments_in_any_status():
+    alice = add_customer("Alice")
+    s = create_shipment(alice.id, 1.0, "local")
+    s.status = "cancelled"
+    assert list_shipments(alice.id) == [s]
+
+
+def test_unknown_customer_fails():
+    with pytest.raises(DomainError) as exc:
+        list_shipments("C-missing")
+    assert exc.value.code == "E_UNKNOWN_CUSTOMER"
+
+
+def test_unknown_customer_fails_even_with_orphan_shipments():
+    alice = add_customer("Alice")
+    create_shipment(alice.id, 1.0, "local")
+    del db.customers[alice.id]
+    with pytest.raises(DomainError):
+        list_shipments(alice.id)
+
+
+def test_is_read_only_and_returns_new_list():
+    alice = add_customer("Alice")
+    create_shipment(alice.id, 1.0, "local")
+    before = len(events.OUTBOX)
+
+    result = list_shipments(alice.id)
+    result.clear()
+
+    assert len(events.OUTBOX) == before
+    assert len(db.shipments) == 1
+    assert len(list_shipments(alice.id)) == 1
