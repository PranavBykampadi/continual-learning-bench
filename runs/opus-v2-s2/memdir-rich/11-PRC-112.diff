diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_claims.py b/tests/unit/test_claims.py
--- a/tests/unit/test_claims.py	1969-12-31 19:00:00
+++ b/tests/unit/test_claims.py	2026-11-12 04:23:24
@@ -0,0 +1,105 @@
+from datetime import datetime, timezone
+
+import pytest
+
+from parcelo import audit, claims, clock, customers, shipments, store
+from parcelo.errors import DomainError
+from parcelo.money import Money
+from parcelo.store import db
+
+
+def _delivered_shipment():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 2, "local")
+    s.status = "delivered"
+    return s
+
+
+def test_file_claim_happy_path():
+    s = _delivered_shipment()
+    moment = datetime(2026, 11, 12, 9, 30, tzinfo=timezone.utc)
+    clock.set_fixed(moment)
+
+    claim = claims.file_claim(s.id, "12.50", "box crushed")
+
+    assert claim.id.startswith("clm_")
+    assert claim.shipment_id == s.id
+    assert claim.amount == Money.parse("12.50")
+    assert isinstance(claim.amount, Money)
+    assert claim.reason == "box crushed"
+    assert claim.filed_at == moment
+    assert db.claims[claim.id] is claim
+    assert audit.LOG[-1]["action"] == "claim.filed"
+    assert audit.LOG[-1]["entity_id"] == claim.id
+    assert audit.LOG[-1]["details"]["shipment_id"] == s.id
+
+
+@pytest.mark.parametrize("amount", [7, 0.1, "3.25", Money.parse("4.00")])
+def test_accepts_money_and_numbers(amount):
+    s = _delivered_shipment()
+    claim = claims.file_claim(s.id, amount, "late")
+    assert claim.amount == Money.parse(amount)
+
+
+def test_multiple_claims_get_distinct_ids():
+    s = _delivered_shipment()
+    a = claims.file_claim(s.id, 1, "dent")
+    b = claims.file_claim(s.id, 2, "scratch")
+    assert a.id != b.id
+    assert set(db.claims) == {a.id, b.id}
+
+
+def test_unknown_shipment():
+    with pytest.raises(DomainError) as err:
+        claims.file_claim("shp_nope", 5, "lost")
+    assert err.value.code == "E_NOT_FOUND"
+    assert db.claims == {}
+
+
+@pytest.mark.parametrize("status", ["created", "cancelled", "in_transit"])
+def test_only_delivered_shipments(status):
+    s = _delivered_shipment()
+    s.status = status
+    log_len = len(audit.LOG)
+    with pytest.raises(DomainError) as err:
+        claims.file_claim(s.id, 5, "lost")
+    assert err.value.code == "E_BAD_STATE"
+    assert db.claims == {}
+    assert len(audit.LOG) == log_len
+
+
+@pytest.mark.parametrize(
+    "amount", [0, -1, "-0.01", "0.00", 0.001, "abc", None, "", True, float("nan")]
+)
+def test_amount_must_be_positive(amount):
+    s = _delivered_shipment()
+    log_len = len(audit.LOG)
+    with pytest.raises(DomainError) as err:
+        claims.file_claim(s.id, amount, "lost")
+    assert err.value.code == "E_BAD_INPUT"
+    assert db.claims == {}
+    assert len(audit.LOG) == log_len
+
+
+@pytest.mark.parametrize("reason", ["", "   ", None, 42])
+def test_reason_required(reason):
+    s = _delivered_shipment()
+    with pytest.raises(DomainError) as err:
+        claims.file_claim(s.id, 5, reason)
+    assert err.value.code == "E_BAD_INPUT"
+    assert db.claims == {}
+
+
+def test_state_checked_before_amount():
+    s = _delivered_shipment()
+    s.status = "created"
+    with pytest.raises(DomainError) as err:
+        claims.file_claim(s.id, -5, "lost")
+    assert err.value.code == "E_BAD_STATE"
+
+
+def test_reset_clears_c