+def outstanding_by_customer():
+    """Map every customer id to the total (Money) of its open invoices.
+
+    Paid and void invoices are ignored. Customers with nothing open map to
+    Money.zero(). Read-only: no audit entry, no mutation.
+    """
+    totals = {customer_id: Money.zero() for customer_id in db.customers}
+    for invoice in db.invoices.values():
+        if invoice.status != "open":
+            continue
+        shipment = db.shipments.get(invoice.shipment_id)
+        if shipment is None:
+            continue
+        customer_id = shipment.customer_id
+        totals[customer_id] = totals.get(customer_id, Money.zero()) + Money.parse(invoice.amount)
+    return totals
 
 
