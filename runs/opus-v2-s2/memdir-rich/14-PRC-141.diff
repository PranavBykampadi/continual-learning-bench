+def reassign_shipment(shipment_id, new_customer_id):
+    """Move a shipment booked under the wrong customer to `new_customer_id`."""
+    shipment = get_shipment(shipment_id)
+    if shipment.status == "delivered":
+        raise DomainError("E_BAD_STATE", f"{shipment_id} is {shipment.status}")
+    if new_customer_id not in db.customers:
+        raise DomainError("E_UNKNOWN_CUSTOMER", new_customer_id)
+    old_customer_id = shipment.customer_id
+    shipment.customer_id = new_customer_id
+    audit.record(
+        "shipment.reassigned",
+        shipment.id,
+        from_customer_id=old_customer_id,
+        to_customer_id=new_customer_id,
+    )
+    events.emit(
+        "shipment.reassigned",
+        shipment.id,
+        from_customer_id=old_customer_id,
+        to_customer_id=new_customer_id,
+    )
+    return shipment
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_reassign_shipment.py b/tests/unit/test_reassign_shipment.py
--- a/tests/unit/test_reassign_shipment.py	1969-12-31 19:00:00
+++ b/tests/unit/test_reassign_shipment.py	2026-11-12 04:27:08
@@ -0,0 +1,79 @@
+import pytest
+
+from parcelo import audit, customers, events, shipments
+from parcelo.errors import DomainError
+
+
+@pytest.fixture
+def setup():
+    old = customers.add_customer("Acme")
+    new = customers.add_customer("Globex")
+    shipment = shipments.create_shipment(old.id, 2, "local")
+    return old, new, shipment
+
+
+def test_reassign_changes_customer_and_returns_shipment(setup):
+    old, new, s = setup
+    result = shipments.reassign_shipment(s.id, new.id)
+    assert result is s
+    assert s.customer_id == new.id
+    assert shipments.get_shipment(s.id).customer_id == new.id
+
+
+def test_reassign_records_audit_and_event(setup):
+    old, new, s = setup
+    shipments.reassign_shipment(s.id, new.id)
+    entry = audit.LOG[-1]
+    assert entry["action"] == "shipment.reassigned"
+    assert entry["entity_id"] == s.id
+    assert entry["details"] == {"from_customer_id": old.id, "to_customer_id": new.id}
+    event = events.OUTBOX[-1]
+    assert event["name"] == "shipment.reassigned"
+    assert event["entity_id"] == s.id
+    assert event["payload"] == {"from_customer_id": old.id, "to_customer_id": new.id}
+
+
+def test_reassign_unknown_shipment(setup):
+    _, new, _ = setup
+    with pytest.raises(DomainError) as err:
+        shipments.reassign_shipment("shp_missing", new.id)
+    assert err.value.code == "E_NOT_FOUND"
+
+
+def test_reassign_to_unknown_customer_leaves_shipment_unchanged(setup):
+    old, _, s = setup
+    log_len, outbox_len = len(audit.LOG), len(events.OUTBOX)
+    with pytest.raises(DomainError) as err:
+        shipments.reassign_shipment(s.id, "C_missing")
+    assert err.value.code == "E_UNKNOWN_CUSTOMER"
+    assert s.customer_id == old.id
+    assert len(audit.LOG) == log_len
+    assert len(events.OUTBOX) == outbox_len
+
+
+def test_reassign_delivered_shipment_fails(setup):
+    old, new, s = setup
+    s.status = "delivered"
+    log_len, outbox_len = len(audit.LOG), len(events.OUTBOX)
+    with pytest.raises(DomainError) as err:
+        shipments.reassign_shipment(s.id, new.id)
+    assert err.value.code == "E_BAD_STATE"
+    assert s.customer_id == old.id
+    assert s.status == "delivered"
+    assert len(audit.LOG) == log_len
+    assert len(events.OUTBOX) == outbox_len
+
+
+def test_delivered_checked_before_customer(setup):
+    _, _, s = setup
+    s.status = "delivered"
+    with pytest.raises(DomainError) as err:
+        shipments.reassign_shipment(s.id, "C_missing")
+    assert err.value.code == "E_BAD_STATE"
+
+
+def test_reassign_does_not_affect_other_shipments(setup):
+    old, new, s = setup
+    other = shipments.create_shipment(old.id, 1, "local")
+    shipments.reassign_shipment(s.id, new.id)
+    assert other.customer_id == old.id
