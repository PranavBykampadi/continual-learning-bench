@@ -0,0 +1,136 @@
+from datetime import datetime, timezone
+
+import pytest
+
+from parcelo import clock, customers, events, shipments
+from parcelo.errors import DomainError
+from parcelo.store import db
+
+NOW = datetime(2026, 11, 12, 9, 0, tzinfo=timezone.utc)
+
+
+def make_shipment(weight=10, zone="national"):
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, weight, zone)
+    events.OUTBOX.clear()
+    return s
+
+
+def test_split_creates_one_shipment_per_weight_in_order():
+    clock.set_fixed(NOW)
+    original = make_shipment(10, "national")
+
+    parts = shipments.split_shipment(original.id, [3, 5, 2])
+
+    assert [p.weight_kg for p in parts] == [3, 5, 2]
+    assert len({p.id for p in parts} | {original.id}) == 4
+    for p in parts:
+        assert p.customer_id == original.customer_id
+        assert p.zone == "national"
+        assert p.status == "created"
+        assert p.created_at == NOW
+        assert db.shipments[p.id] is p
+    assert original.status == "split"
+    assert db.shipments[original.id] is original
+    assert original.weight_kg == 10
+
+
+def test_split_emits_events():
+    original = make_shipment(10)
+    parts = shipments.split_shipment(original.id, [4, 6])
+
+    names = [e["name"] for e in events.OUTBOX]
+    assert names == ["shipment.created", "shipment.created", "shipment.split"]
+    for entry, part in zip(events.OUTBOX[:2], parts):
+        assert entry["entity_id"] == part.id
+        assert entry["payload"] == {"zone": "national", "split_from": original.id}
+    last = events.OUTBOX[-1]
+    assert last["entity_id"] == original.id
+    assert last["payload"] == {"into": [parts[0].id, parts[1].id], "weights": [4, 6]}
+
+
+def test_float_weights_that_add_up_exactly_are_accepted():
+    original = make_shipment(0.3)
+    parts = shipments.split_shipment(original.id, [0.1, 0.2])
+    assert [p.weight_kg for p in parts] == [0.1, 0.2]
+    assert original.status == "split"
+
+
+def test_single_weight_split_is_allowed():
+    original = make_shipment(2.5)
+    parts = shipments.split_shipment(original.id, [2.5])
+    assert len(parts) == 1
+    assert parts[0].id != original.id
+
+
+def test_split_parts_can_be_split_again():
+    original = make_shipment(10)
+    first, _ = shipments.split_shipment(original.id, [6, 4])
+    again = shipments.split_shipment(first.id, [1, 5])
+    assert first.status == "split"
+    assert [p.weight_kg for p in again] == [1, 5]
+
