+def _exact_weight(weight):
+    # Compare weights as decimals so 0.1 + 0.2 matches an original of 0.3.
+    return Decimal(str(weight))
+
+
+def split_shipment(shipment_id, weights):
+    """Replace a "created" shipment with one new shipment per weight.
+
+    All checks run before anything changes, so a failed split leaves the
+    store and the outbox untouched.
+    """
+    original = get_shipment(shipment_id)
+    if original.status != "created":
+        raise DomainError("E_BAD_STATE", f"{shipment_id} is {original.status}")
+    if not isinstance(weights, (list, tuple)) or not weights:
+        raise DomainError("E_BAD_INPUT", "weights must be a non-empty list")
+    for weight in weights:
+        if isinstance(weight, bool) or not isinstance(weight, (int, float, Decimal)):
+            raise DomainError("E_BAD_INPUT", f"bad weight {weight!r}")
+        if not weight > 0:
+            raise DomainError("E_BAD_WEIGHT", str(weight))
+    total = sum((_exact_weight(w) for w in weights), Decimal("0"))
+    if total != _exact_weight(original.weight_kg):
+        raise DomainError(
+            "E_BAD_WEIGHT",
+            f"weights add up to {total}, shipment weighs {original.weight_kg}",
+        )
+
+    parts = []
+    for weight in weights:
+        part = Shipment(
+            id=ids.new_id("shp"),
+            customer_id=original.customer_id,
+            weight_kg=weight,
+            zone=original.zone,
+            created_at=clock.now(),
+        )
+        db.shipments[part.id] = part
+        parts.append(part)
+    original.status = "split"
+
+    for part in parts:
+        events.emit("shipment.created", part.id, zone=part.zone, split_from=original.id)
+    events.emit(
+        "shipment.split",
+        original.id,
+        into=[part.id for part in parts],
+        weights=[part.weight_kg for part in parts],
+    )
+    return parts
