diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_reports.py b/tests/unit/test_reports.py
--- a/tests/unit/test_reports.py	1969-12-31 19:00:00
+++ b/tests/unit/test_reports.py	2026-11-12 03:03:51
@@ -0,0 +1,50 @@
+from parcelo import customers, events, reports, shipments
+
+
+def _book(customer_id, count):
+    for _ in range(count):
+        shipments.create_shipment(customer_id, 1.0, "local")
+
+
+def test_includes_every_customer_even_without_shipments():
+    idle = customers.add_customer("Idle")
+    busy = customers.add_customer("Busy")
+    _book(busy.id, 2)
+
+    report = reports.volume_report()
+
+    assert set(report) == {idle.id, busy.id}
+    assert report[idle.id] == {"shipments": 0, "tier": "starter"}
+    assert report[busy.id] == {"shipments": 2, "tier": "starter"}
+
+
+def test_empty_when_no_customers():
+    assert reports.volume_report() == {}
+
+
+def test_tier_thresholds():
+    starter_9 = customers.add_customer("Nine")
+    regular_10 = customers.add_customer("Ten")
+    regular_49 = customers.add_customer("FortyNine")
+    bulk_50 = customers.add_customer("Fifty")
+    _book(starter_9.id, 9)
+    _book(regular_10.id, 10)
+    _book(regular_49.id, 49)
+    _book(bulk_50.id, 50)
+
+    report = reports.volume_report()
+
+    assert report[starter_9.id] == {"shipments": 9, "tier": "starter"}
+    assert report[regular_10.id] == {"shipments": 10, "tier": "regular"}
+    assert report[regular_49.id] == {"shipments": 49, "tier": "regular"}
+    assert report[bulk_50.id] == {"shipments": 50, "tier": "bulk"}
+
+
+def test_report_is_read_only_and_emits_nothing():
+    c = customers.add_customer("Acme")
+    _book(c.id, 3)
+    events.OUTBOX.clear()
+
+    reports.volume_report()
+
+    assert events.OUTBOX == []
