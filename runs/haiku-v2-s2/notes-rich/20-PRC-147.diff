+def _volume_tier(shipment_count):
+    # Same thresholds as volume_tier in parcelo/legacy/billing.py. Copied here
+    # because parcelo.legacy is scheduled for deletion.
+    if shipment_count >= 50:
+        return "bulk"
+    if shipment_count >= 10:
+        return "regular"
+    return "starter"
+
+
+def volume_report():
+    """Shipment count and volume tier for every customer, keyed by customer id.
+
+    Customers with no shipments are included with a count of 0. Read-only.
+    """
+    counts = {customer_id: 0 for customer_id in db.customers}
+    for shipment in db.shipments.values():
+        if shipment.customer_id in counts:
+            counts[shipment.customer_id] += 1
+    return {
+        customer_id: {"shipments": count, "tier": _volume_tier(count)}
+        for customer_id, count in counts.items()
+    }
+
+
