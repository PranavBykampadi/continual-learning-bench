+def list_shipments(customer_id):
+    if customer_id not in db.customers:
+        raise DomainError("E_UNKNOWN_CUSTOMER", customer_id)
+    return [s for s in db.shipments.values() if s.customer_id == customer_id]
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_list_shipments.py b/tests/unit/test_list_shipments.py
--- a/tests/unit/test_list_shipments.py	1969-12-31 19:00:00
+++ b/tests/unit/test_list_shipments.py	2026-11-12 03:06:21
@@ -0,0 +1,29 @@
+import pytest
+
+from parcelo import customers, shipments
+from parcelo.errors import DomainError
+
+
+def test_returns_empty_list_when_customer_has_no_shipments():
+    c = customers.add_customer("Acme")
+    assert shipments.list_shipments(c.id) == []
+
+
+def test_returns_only_that_customers_shipments():
+    a = customers.add_customer("Acme")
+    b = customers.add_customer("Globex")
+    s1 = shipments.create_shipment(a.id, 1.5, "national")
+    s2 = shipments.create_shipment(a.id, 2.0, "national")
+    shipments.create_shipment(b.id, 3.0, "national")
+
+    result = shipments.list_shipments(a.id)
+
+    assert len(result) == 2
+    assert {s.id for s in result} == {s1.id, s2.id}
+    assert all(s.customer_id == a.id for s in result)
+
+
+def test_unknown_customer_raises():
+    with pytest.raises(DomainError) as err:
+        shipments.list_shipments("nope")
+    assert err.value.code == "E_UNKNOWN_CUSTOMER"
