diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_invoice_hold.py b/tests/unit/test_invoice_hold.py
--- a/tests/unit/test_invoice_hold.py	1969-12-31 19:00:00
+++ b/tests/unit/test_invoice_hold.py	2026-11-12 03:10:01
@@ -0,0 +1,74 @@
+from datetime import datetime, timezone
+
+import pytest
+
+from parcelo import clock, customers, events, invoices, shipments
+from parcelo.errors import DomainError
+
+
+def _open_invoice():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 2, "local")
+    return invoices.issue_invoice(s.id)
+
+
+def test_hold_open_invoice_sets_status_and_time():
+    inv = _open_invoice()
+    moment = datetime(2026, 11, 12, 9, 30, tzinfo=timezone.utc)
+    clock.set_fixed(moment)
+    try:
+        result = invoices.hold_invoice(inv.id)
+    finally:
+        clock.clear_fixed()
+    assert result is inv
+    assert inv.status == "on_hold"
+    assert inv.held_at == moment
+
+
+def test_hold_emits_event():
+    inv = _open_invoice()
+    events.OUTBOX.clear()
+    invoices.hold_invoice(inv.id)
+    assert len(events.OUTBOX) == 1
+    assert events.OUTBOX[-1]["name"] == "invoice.on_hold"
+    assert events.OUTBOX[-1]["entity_id"] == inv.id
+
+
+def test_hold_is_idempotent():
+    inv = _open_invoice()
+    invoices.hold_invoice(inv.id)
+    first_time = inv.held_at
+    events.OUTBOX.clear()
+    again = invoices.hold_invoice(inv.id)
+    assert again is inv
+    assert inv.status == "on_hold"
+    assert inv.held_at == first_time
+    assert events.OUTBOX == []
+
+
+def test_hold_unknown_invoice():
+    with pytest.raises(DomainError) as err:
+        invoices.hold_invoice("INV-missing")
+    assert err.value.code == "E_NOT_FOUND"
+
+
+def test_hold_none_invoice_id():
+    with pytest.raises(DomainError) as err:
+        invoices.hold_invoice(None)
+    assert err.value.code == "E_NOT_FOUND"
+
+
+def test_hold_paid_invoice_fails():
+    inv = _open_invoice()
+    invoices.mark_paid(inv.id)
+    with pytest.raises(DomainError) as err:
+        invoices.hold_invoice(inv.id)
+    assert err.value.code == "E_BAD_STATE"
+    assert inv.status == "paid"
+    assert inv.held_at is None
+
+
+def test_held_invoice_not_in_open_invoices():
+    inv = _open_invoice()
+    invoices.hold_invoice(inv.id)
+    assert inv not in invoices.open_invoices()
