+def hold_invoice(invoice_id):
+    """Put an open invoice on hold. Already-held invoices are returned unchanged."""
+    if invoice_id not in db.invoices:
+        raise DomainError("E_NOT_FOUND", f"invoice {invoice_id} not found")
+    invoice = db.invoices[invoice_id]
+    if invoice.status == "on_hold":
+        return invoice
+    if invoice.status != "open":
+        raise DomainError("E_BAD_STATE", f"invoice {invoice_id} is {invoice.status}, not open")
+    invoice.status = "on_hold"
+    invoice.held_at = clock.now()
+    events.emit("invoice.on_hold", invoice.id)
     return invoice
 
 
