+def _as_utc(moment):
+    # issue_invoice stores naive UTC datetimes; clock.now() is timezone-aware.
+    if moment.tzinfo is None:
+        return moment.replace(tzinfo=timezone.utc)
+    return moment
+
+
+def late_fee_for(invoice_id):
+    """Late fee as Money: 1.5% of the invoice amount per full day past 30 days from issue."""
+    if invoice_id not in db.invoices:
+        raise DomainError("E_NOT_FOUND", invoice_id)
+    invoice = db.invoices[invoice_id]
+    elapsed_days = (clock.now() - _as_utc(invoice.issued_at)).days
+    days_late = elapsed_days - LATE_AFTER_DAYS
+    if days_late <= 0:
+        return Money.zero()
+    return Money.parse(invoice.amount).scale(LATE_FEE_RATE * days_late)
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_late_fee.py b/tests/unit/test_late_fee.py
--- a/tests/unit/test_late_fee.py	1969-12-31 19:00:00
+++ b/tests/unit/test_late_fee.py	2026-11-12 02:52:30
@@ -0,0 +1,60 @@
+from datetime import datetime, timedelta, timezone
+
+import pytest
+
+from parcelo import clock, customers, invoices, shipments
+from parcelo.errors import DomainError
+from parcelo.money import Money
+
+NOW = datetime(2026, 11, 12, tzinfo=timezone.utc)
+
+
+def _open_invoice(days_since_issue):
+    """Open invoice for a 2 kg local shipment (amount 7.00), issued `days_since_issue` days ago."""
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 2, "local")
+    inv = invoices.issue_invoice(s.id)
+    inv.issued_at = NOW - timedelta(days=days_since_issue)
+    clock.set_fixed(NOW)
+    return inv
+
+
+def test_not_late_before_30_days():
+    inv = _open_invoice(29)
+    assert invoices.late_fee_for(inv.id) == Money.zero()
+
+
+def test_not_late_exactly_30_days():
+    inv = _open_invoice(30)
+    assert invoices.late_fee_for(inv.id) == Money.zero()
+
+
+def test_fee_is_money_type():
+    inv = _open_invoice(35)
+    assert isinstance(invoices.late_fee_for(inv.id), Money)
+
+
+def test_fee_for_five_days_past_due():
+    # 700 cents * 1.5% * 5 days = 52.5 cents, rounds half up to 53
+    inv = _open_invoice(35)
+    assert invoices.late_fee_for(inv.id) == Money(53)
+
+
+def test_fee_for_one_day_past_due():
+    # 700 cents * 1.5% = 10.5 cents, rounds half up to 11
+    inv = _open_invoice(31)
+    assert invoices.late_fee_for(inv.id) == Money(11)
+
+
+def test_fee_uses_naive_issued_at_from_issue_invoice():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 2, "local")
+    inv = invoices.issue_invoice(s.id)  # stores naive UTC issued_at
+    clock.set_fixed(datetime.now(timezone.utc) + timedelta(days=31))
+    assert invoices.late_fee_for(inv.id) == Money(11)
+
+
+def test_unknown_invoice_raises_not_found():
+    with pytest.raises(DomainError) as err:
+        invoices.late_fee_for("INV-missing")
+    assert err.value.code == "E_NOT_FOUND"
