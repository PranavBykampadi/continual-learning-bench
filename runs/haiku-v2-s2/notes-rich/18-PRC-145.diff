diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_customers.py b/tests/unit/test_customers.py
--- a/tests/unit/test_customers.py	1969-12-31 19:00:00
+++ b/tests/unit/test_customers.py	2026-11-12 03:02:27
@@ -0,0 +1,46 @@
+import pytest
+
+from parcelo import customers, events, store
+from parcelo.errors import DomainError
+from parcelo.models import Customer
+
+
+def test_upgrade_standard_to_gold():
+    c = customers.add_customer("Acme")
+    events.OUTBOX.clear()
+    result = customers.upgrade_tier(c.id)
+    assert result is c
+    assert result.tier == "gold"
+    assert store.db.customers[c.id].tier == "gold"
+    assert len(events.OUTBOX) == 1
+    assert events.OUTBOX[-1]["name"] == "customer.upgraded"
+    assert events.OUTBOX[-1]["entity_id"] == c.id
+
+
+def test_upgrade_unknown_customer_fails():
+    events.OUTBOX.clear()
+    with pytest.raises(DomainError) as err:
+        customers.upgrade_tier("C_missing")
+    assert err.value.code == "E_NOT_FOUND"
+    assert "C_missing" not in store.db.customers
+    assert events.OUTBOX == []
+
+
+def test_upgrade_already_gold_fails():
+    c = customers.add_customer("Acme", tier="gold")
+    events.OUTBOX.clear()
+    with pytest.raises(DomainError) as err:
+        customers.upgrade_tier(c.id)
+    assert err.value.code == "E_BAD_STATE"
+    assert store.db.customers[c.id].tier == "gold"
+    assert events.OUTBOX == []
+
+
+def test_upgrade_leaves_other_fields_unchanged():
+    c = customers.add_customer("Acme")
+    before = Customer(**vars(c))
+    customers.upgrade_tier(c.id)
+    after = store.db.customers[c.id]
+    assert after.name == before.name
+    assert after.credit_limit == before.credit_limit
+    assert after.active == before.active
