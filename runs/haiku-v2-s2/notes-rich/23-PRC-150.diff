@@ -0,0 +1,56 @@
+import math
+from decimal import Decimal
+
+import pytest
+
+from parcelo import customers, events
+from parcelo.errors import DomainError
+
+
+def test_set_credit_limit_updates_and_returns_new_limit():
+    c = customers.add_customer("Acme")
+    events.OUTBOX.clear()
+    result = customers.set_credit_limit(c.id, 1250.5)
+    assert result == 1250.5
+    assert customers.get_customer(c.id).credit_limit == 1250.5
+    assert len(events.OUTBOX) == 1
+    assert events.OUTBOX[0]["name"] == "customer.credit_limit_changed"
+    assert events.OUTBOX[0]["entity_id"] == c.id
+
+
+def test_set_credit_limit_accepts_decimal_and_string():
+    c = customers.add_customer("Acme")
+    assert customers.set_credit_limit(c.id, Decimal("99.99")) == 99.99
+    assert customers.set_credit_limit(c.id, "300") == 300.0
+
+
+def test_set_credit_limit_unknown_customer():
+    events.OUTBOX.clear()
+    with pytest.raises(DomainError) as err:
+        customers.set_credit_limit("C-missing", 100)
+    assert err.value.code == "E_NOT_FOUND"
+    assert events.OUTBOX == []
+
+
+@pytest.mark.parametrize("amount", [-1, -0.01, 0, 0.0, "-5", Decimal("-2.50")])
+def test_set_credit_limit_rejects_non_positive(amount):
+    c = customers.add_customer("Acme")
+    before = customers.get_customer(c.id).credit_limit
+    events.OUTBOX.clear()
+    with pytest.raises(DomainError) as err:
+        customers.set_credit_limit(c.id, amount)
+    assert err.value.code == "E_BAD_INPUT"
+    assert customers.get_customer(c.id).credit_limit == before
+    assert events.OUTBOX == []
+
+
+@pytest.mark.parametrize(
+    "amount",
+    [None, "", "   ", float("inf"), float("-inf"), float("nan"), "nan", "inf", "abc", Decimal("NaN")],
+)
+def test_set_credit_limit_rejects_bad_input(amount):
+    c = customers.add_customer("Acme")
+    with pytest.raises(DomainError) as err:
+        customers.set_credit_limit(c.id, amount)
+    assert err.value.code == "E_BAD_INPUT"
+    assert not math.isnan(customers.get_customer(c.id).credit_limit)
