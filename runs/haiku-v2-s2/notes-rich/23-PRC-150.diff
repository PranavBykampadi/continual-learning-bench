 import uuid
+from decimal import Decimal, InvalidOperation
 
+from parcelo import events
+from parcelo.errors import DomainError
 from parcelo.models import Customer
+from parcelo.money import Money
 from parcelo.store import db
 
 TIERS = ("standard", "gold")
+
+
+def _parse_limit(amount):
+    """Validate a credit limit given in dollars and return it as Money.
+
+    Raises E_BAD_INPUT for None, blank strings, non-finite values, non-numeric
+    input, and non-positive amounts.
+    """
+    if amount is None:
+        raise DomainError("E_BAD_INPUT", "amount required")
+    if not isinstance(amount, Money):
+        if isinstance(amount, str) and not amount.strip():
+            raise DomainError("E_BAD_INPUT", "amount required")
+        try:
+            number = Decimal(str(amount).strip())
+        except (InvalidOperation, TypeError, ValueError):
+            raise DomainError("E_BAD_INPUT", f"not a number: {amount!r}")
+        if not number.is_finite():
+            raise DomainError("E_BAD_INPUT", f"not finite: {amount!r}")
+    try:
+        money = Money.parse(amount)
+    except (InvalidOperation, TypeError, ValueError, OverflowError):
+        raise DomainError("E_BAD_INPUT", f"not a number: {amount!r}")
+    if money.cents <= 0:
+        raise DomainError("E_BAD_INPUT", "credit limit must be positive")
+    return money
+
+
+def set_credit_limit(customer_id, amount):
+    """Set a customer's credit limit in dollars and return the new limit as float.
+
+    Raises E_BAD_INPUT if amount is missing, not a finite number, or not positive.
+    Raises E_NOT_FOUND if the customer does not exist.
+    Emits customer.credit_limit_changed for the customer.
+    """
+    money = _parse_limit(amount)
+    if customer_id not in db.customers:
+        raise DomainError("E_NOT_FOUND", customer_id)
+    customer = db.customers[customer_id]
+    customer.credit_limit = money.cents / 100
+    events.emit("customer.credit_limit_changed", customer.id, credit_limit=customer.credit_limit)
+    return customer.credit_limit
 
 
