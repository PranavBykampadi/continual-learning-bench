diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_write_off.py b/tests/unit/test_write_off.py
--- a/tests/unit/test_write_off.py	1969-12-31 19:00:00
+++ b/tests/unit/test_write_off.py	2026-11-12 03:03:09
@@ -0,0 +1,74 @@
+from datetime import datetime, timezone
+
+import pytest
+
+from parcelo import clock, customers, events, invoices, shipments
+from parcelo.errors import DomainError
+from parcelo.money import Money
+
+
+def _open_invoice():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 2, "local")
+    return invoices.issue_invoice(s.id)
+
+
+def _snapshot(inv):
+    return dict(vars(inv))
+
+
+def test_write_off_open_invoice():
+    moment = datetime(2026, 11, 1, 12, 0, tzinfo=timezone.utc)
+    clock.set_fixed(moment)
+    inv = _open_invoice()
+    events.OUTBOX.clear()
+
+    amount = invoices.write_off(inv.id)
+
+    assert amount == Money(700)
+    assert inv.status == "written_off"
+    assert inv.written_off_at == moment
+    assert [e["name"] for e in events.OUTBOX] == ["invoice.written_off"]
+    assert events.OUTBOX[0]["entity_id"] == inv.id
+
+
+def test_write_off_unknown_invoice():
+    events.OUTBOX.clear()
+    with pytest.raises(DomainError) as err:
+        invoices.write_off("INV-missing")
+    assert err.value.code == "E_NOT_FOUND"
+    assert events.OUTBOX == []
+
+
+def test_write_off_paid_invoice_fails():
+    inv = _open_invoice()
+    invoices.mark_paid(inv.id)
+    before = _snapshot(inv)
+    events.OUTBOX.clear()
+
+    with pytest.raises(DomainError) as err:
+        invoices.write_off(inv.id)
+
+    assert err.value.code == "E_BAD_STATE"
+    assert _snapshot(inv) == before
+    assert events.OUTBOX == []
+
+
+def test_write_off_twice_fails():
+    inv = _open_invoice()
+    invoices.write_off(inv.id)
+    before = _snapshot(inv)
+    events.OUTBOX.clear()
+
+    with pytest.raises(DomainError) as err:
+        invoices.write_off(inv.id)
+
+    assert err.value.code == "E_BAD_STATE"
+    assert _snapshot(inv) == before
+    assert events.OUTBOX == []
+
+
+def test_written_off_invoice_leaves_open_invoices():
+    inv = _open_invoice()
+    invoices.write_off(inv.id)
+    assert inv not in invoices.open_invoices()
