+from datetime import datetime, timezone
+
+import pytest
+
+from parcelo import clock, customers, events, returns, shipments, store
+from parcelo.errors import DomainError
+from parcelo.models import ReturnRequest
+
+
+def _delivered_shipment():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 2.0, "national")
+    s.status = "delivered"
+    return s
+
+
+def test_request_return_creates_and_stores():
+    moment = datetime(2026, 11, 1, 9, 30, tzinfo=timezone.utc)
+    clock.set_fixed(moment)
+    try:
+        s = _delivered_shipment()
+        r = returns.request_return(s.id, "damaged")
+    finally:
+        clock.clear_fixed()
+    assert isinstance(r, ReturnRequest)
+    assert r.id.startswith("ret_")
+    assert r.shipment_id == s.id
+    assert r.reason == "damaged"
+    assert r.requested_at == moment
+    assert store.db.returns[r.id] is r
+
+
+def test_request_return_emits_event():
+    s = _delivered_shipment()
+    events.OUTBOX.clear()
+    r = returns.request_return(s.id, "wrong item")
+    assert len(events.OUTBOX) == 1
+    assert events.OUTBOX[0]["name"] == "return.requested"
+    assert events.OUTBOX[0]["entity_id"] == r.id
+
+
+def test_unknown_shipment_fails():
+    with pytest.raises(DomainError) as err:
+        returns.request_return("shp_missing", "damaged")
+    assert err.value.code == "E_NOT_FOUND"
+    assert store.db.returns == {}
+    assert events.OUTBOX == []
+
+
+def test_only_delivered_shipments_can_be_returned():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 2.0, "national")
+    assert s.status == "created"
+    events.OUTBOX.clear()
+    with pytest.raises(DomainError) as err:
+        returns.request_return(s.id, "damaged")
+    assert err.value.code == "E_BAD_STATE"
+    assert s.status == "created"
+    assert store.db.returns == {}
+    assert events.OUTBOX == []
+
+
