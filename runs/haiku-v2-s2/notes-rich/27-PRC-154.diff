diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_reactivate_customer.py b/tests/unit/test_reactivate_customer.py
--- a/tests/unit/test_reactivate_customer.py	1969-12-31 19:00:00
+++ b/tests/unit/test_reactivate_customer.py	2026-11-12 03:08:04
@@ -0,0 +1,39 @@
+import pytest
+
+from parcelo import customers, events
+from parcelo.errors import DomainError
+from parcelo.store import db
+
+
+def test_reactivate_sets_active_and_returns_customer():
+    c = customers.add_customer("Acme")
+    c.active = False
+    result = customers.reactivate_customer(c.id)
+    assert result is c
+    assert result.active is True
+    assert db.customers[c.id].active is True
+
+
+def test_reactivate_emits_event():
+    c = customers.add_customer("Acme")
+    c.active = False
+    customers.reactivate_customer(c.id)
+    assert events.OUTBOX[-1]["name"] == "customer.reactivated"
+    assert events.OUTBOX[-1]["entity_id"] == c.id
+
+
+def test_reactivate_unknown_customer_raises_not_found():
+    with pytest.raises(DomainError) as err:
+        customers.reactivate_customer("C_missing")
+    assert err.value.code == "E_NOT_FOUND"
+    assert events.OUTBOX == []
+
+
+def test_reactivate_does_not_touch_other_customers():
+    a = customers.add_customer("Acme")
+    b = customers.add_customer("Beta")
+    a.active = False
+    b.active = False
+    customers.reactivate_customer(a.id)
+    assert db.customers[a.id].active is True
+    assert db.customers[b.id].active is False
