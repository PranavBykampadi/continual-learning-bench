 def open_invoices():
     return [i for i in db.invoices.values() if i.status == "open"]
+
+
+def _naive_utc_now():
+    # Invoice timestamps are stored as naive UTC; clock.now() is aware UTC.
+    now = clock.now()
+    if now.tzinfo is not None:
+        now = now.astimezone(timezone.utc).replace(tzinfo=None)
+    return now
+
+
+def reopen_invoice(invoice_id):
+    if invoice_id not in db.invoices:
+        raise DomainError("E_NOT_FOUND", invoice_id)
+    invoice = db.invoices[invoice_id]
+    if invoice.status != "paid":
+        raise DomainError("E_BAD_STATE", "invoice %s is not paid" % invoice_id)
+    invoice.status = "open"
+    invoice.paid_at = None
+    invoice.reopened_at = _naive_utc_now()
+    events.emit("invoice.reopened", invoice_id)
+    return invoice
