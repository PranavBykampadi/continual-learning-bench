diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_reopen_invoice.py b/tests/unit/test_reopen_invoice.py
--- a/tests/unit/test_reopen_invoice.py	1969-12-31 19:00:00
+++ b/tests/unit/test_reopen_invoice.py	2026-11-12 03:00:22
@@ -0,0 +1,84 @@
+from datetime import datetime, timedelta, timezone
+
+import pytest
+
+from parcelo import clock, events, invoices
+from parcelo.errors import DomainError
+from parcelo.models import Invoice
+from parcelo.store import db
+
+
+def _add_invoice(invoice_id, status, paid_at=None):
+    inv = Invoice(
+        id=invoice_id,
+        shipment_id="shp_x",
+        amount=12.5,
+        status=status,
+        issued_at=datetime(2026, 11, 1, 9, 0),
+        paid_at=paid_at,
+    )
+    db.invoices[invoice_id] = inv
+    return inv
+
+
+def test_reopen_paid_invoice_sets_open_and_clears_paid_at():
+    clock.set_fixed(datetime(2026, 11, 12, 10, 30, tzinfo=timezone.utc))
+    _add_invoice("INV-1", "paid", paid_at=datetime(2026, 11, 2, 8, 0))
+    events.OUTBOX.clear()
+
+    inv = invoices.reopen_invoice("INV-1")
+
+    assert inv is db.invoices["INV-1"]
+    assert inv.status == "open"
+    assert inv.paid_at is None
+    assert inv.reopened_at == datetime(2026, 11, 12, 10, 30)
+    assert inv.reopened_at.tzinfo is None
+    assert events.OUTBOX[-1]["name"] == "invoice.reopened"
+    assert events.OUTBOX[-1]["entity_id"] == "INV-1"
+
+
+def test_reopen_normalizes_naive_clock_value_unchanged():
+    clock.set_fixed(datetime(2026, 11, 12, 10, 30))
+    _add_invoice("INV-2", "paid", paid_at=datetime(2026, 11, 2, 8, 0))
+
+    inv = invoices.reopen_invoice("INV-2")
+
+    assert inv.reopened_at == datetime(2026, 11, 12, 10, 30)
+
+
+def test_reopen_converts_non_utc_aware_clock_to_naive_utc():
+    tz = timezone(timedelta(hours=-5))
+    clock.set_fixed(datetime(2026, 11, 12, 5, 30, tzinfo=tz))
+    _add_invoice("INV-3", "paid", paid_at=datetime(2026, 11, 2, 8, 0))
+
+    inv = invoices.reopen_invoice("INV-3")
+
+    assert inv.reopened_at == datetime(2026, 11, 12, 10, 30)
+    assert inv.reopened_at.tzinfo is None
+
+
+def test_reopen_unknown_invoice_raises_not_found_and_emits_nothing():
+    events.OUTBOX.clear()
+
+    with pytest.raises(DomainError) as err:
+        invoices.reopen_invoice("INV-missing")
+
+    assert err.value.code == "E_NOT_FOUND"
+    assert "INV-missing" not in db.invoices
+    assert events.OUTBOX == []
+
+
+def test_reopen_open_invoice_raises_bad_state_and_leaves_it_unchanged():
+    clock.set_fixed(datetime(2026, 11, 12, 10, 30, tzinfo=timezone.utc))
+    _add_invoice("INV-4", "open")
+    events.OUTBOX.clear()
+
+    with pytest.raises(DomainError) as err:
+        invoices.reopen_invoice("INV-4")
+
+    assert err.value.code == "E_BAD_STATE"
+    inv = db.invoices["INV-4"]
+    assert inv.status == "open"
+    assert inv.paid_at is None
+    assert inv.reopened_at is None
+    assert events.OUTBOX == []
