diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_customers_by_tier.py b/tests/unit/test_customers_by_tier.py
--- a/tests/unit/test_customers_by_tier.py	1969-12-31 19:00:00
+++ b/tests/unit/test_customers_by_tier.py	2026-11-12 03:08:32
@@ -0,0 +1,50 @@
+import pytest
+
+from parcelo import customers
+from parcelo.errors import DomainError
+from parcelo.models import Customer
+from parcelo.store import db
+
+
+def _put(customer_id, tier):
+    db.customers[customer_id] = Customer(id=customer_id, name=customer_id, tier=tier)
+
+
+def test_returns_only_customers_on_tier():
+    _put("C000002", "gold")
+    _put("C000001", "standard")
+    _put("C000003", "gold")
+    result = customers.customers_by_tier("gold")
+    assert [c.id for c in result] == ["C000002", "C000003"]
+    assert all(c.tier == "gold" for c in result)
+
+
+def test_empty_list_when_no_customers_on_tier():
+    _put("C000001", "standard")
+    assert customers.customers_by_tier("gold") == []
+
+
+def test_empty_list_when_no_customers_at_all():
+    assert customers.customers_by_tier("standard") == []
+
+
+def test_results_sorted_by_id_not_storage_order():
+    # Insert in descending id order so storage order differs from id order.
+    _put("C000009", "standard")
+    _put("C000005", "standard")
+    _put("C000007", "standard")
+    result = customers.customers_by_tier("standard")
+    assert [c.id for c in result] == ["C000005", "C000007", "C000009"]
+
+
+def test_unknown_tier_raises_bad_input():
+    _put("C000001", "standard")
+    with pytest.raises(DomainError) as err:
+        customers.customers_by_tier("platinum")
+    assert err.value.code == "E_BAD_INPUT"
+
+
+def test_none_tier_raises_bad_input():
+    with pytest.raises(DomainError) as err:
+        customers.customers_by_tier(None)
+    assert err.value.code == "E_BAD_INPUT"
