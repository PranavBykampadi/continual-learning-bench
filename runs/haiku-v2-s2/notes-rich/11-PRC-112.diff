diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_claims.py b/tests/unit/test_claims.py
--- a/tests/unit/test_claims.py	1969-12-31 19:00:00
+++ b/tests/unit/test_claims.py	2026-11-12 02:57:14
@@ -0,0 +1,81 @@
+from datetime import datetime, timezone
+from decimal import Decimal
+
+import pytest
+
+from parcelo import audit, clock, customers, shipments
+from parcelo.claims import file_claim
+from parcelo.errors import DomainError
+from parcelo.money import Money
+from parcelo.store import db
+
+
+def make_shipment(status="delivered"):
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 2, "local")
+    s.status = status
+    if status == "delivered":
+        s.delivered_at = datetime(2026, 11, 1, tzinfo=timezone.utc)
+    return s
+
+
+def test_file_claim_on_delivered_shipment():
+    clock.set_fixed(datetime(2026, 11, 12, 9, 0, tzinfo=timezone.utc))
+    s = make_shipment()
+    audit.LOG.clear()
+    claim = file_claim(s.id, Decimal("12.50"), "damaged")
+    assert claim.id.startswith("clm_")
+    assert claim.shipment_id == s.id
+    assert claim.amount == Money(1250)
+    assert claim.reason == "damaged"
+    assert claim.filed_at == datetime(2026, 11, 12, 9, 0, tzinfo=timezone.utc)
+    assert db.claims[claim.id] is claim
+    assert audit.LOG[-1]["action"] == "claim.filed"
+    assert audit.LOG[-1]["entity_id"] == claim.id
+
+
+def test_float_amount_is_parsed_to_money():
+    s = make_shipment()
+    claim = file_claim(s.id, 19.99, "late")
+    assert claim.amount == Money(1999)
+
+
+def test_unknown_shipment_fails_not_found():
+    audit.LOG.clear()
+    with pytest.raises(DomainError) as err:
+        file_claim("shp_missing", Decimal("5"), "lost")
+    assert err.value.code == "E_NOT_FOUND"
+    assert db.claims == {}
+    assert audit.LOG == []
+
+
+@pytest.mark.parametrize("status", ["created", "in_transit"])
+def test_undelivered_shipment_fails_bad_state(status):
+    s = make_shipment(status=status)
+    audit.LOG.clear()
+    with pytest.raises(DomainError) as err:
+        file_claim(s.id, Decimal("5"), "lost")
+    assert err.value.code == "E_BAD_STATE"
+    assert db.claims == {}
+    assert audit.LOG == []
+
+
+@pytest.mark.parametrize("amount", [0, Decimal("0"), -1, Decimal("-0.01"), -2.5])
+def test_non_positive_amount_fails_bad_input(amount):
+    s = make_shipment()
+    audit.LOG.clear()
+    with pytest.raises(DomainError) as err:
+        file_claim(s.id, amount, "damaged")
+    assert err.value.code == "E_BAD_INPUT"
+    assert db.claims == {}
+    assert audit.LOG == []
+
+
+def test_unparseable_amount_fails_bad_input():
+    s = make_shipment()
+    audit.LOG.clear()
+    with pytest.raises(DomainError) as err:
+        file_claim(s.id, "abc", "damaged")
+    assert err.value.code == "E_BAD_INPUT"
+    assert db.claims == {}
+    assert audit.LOG == []
