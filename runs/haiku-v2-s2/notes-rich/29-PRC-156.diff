+def heavy_quote(weight_kg, zone):
+    """Normal quote plus HEAVY_SURCHARGE_PER_KG for each kg above the threshold.
+
+    Returns Money. Raises E_BAD_ZONE for an unknown zone and E_BAD_WEIGHT for a
+    None, non-numeric, non-finite or non-positive weight.
+    """
+    if not isinstance(zone, str) or zone not in ZONE_BASE:
+        raise DomainError("E_BAD_ZONE", "unknown zone: %r" % (zone,))
+    if (
+        weight_kg is None
+        or isinstance(weight_kg, bool)
+        or not isinstance(weight_kg, (int, float))
+        or not math.isfinite(weight_kg)
+        or weight_kg <= 0
+    ):
+        raise DomainError("E_BAD_WEIGHT", "weight must be a positive number: %r" % (weight_kg,))
+
+    total = Money.parse(quote(weight_kg, zone))
+    if Decimal(str(weight_kg)) > HEAVY_WEIGHT_THRESHOLD_KG:
+        excess = Decimal(str(weight_kg)) - HEAVY_WEIGHT_THRESHOLD_KG
+        total = total + Money.parse(excess * HEAVY_SURCHARGE_PER_KG)
+    return total
