diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_refunds.py b/tests/unit/test_refunds.py
--- a/tests/unit/test_refunds.py	1969-12-31 19:00:00
+++ b/tests/unit/test_refunds.py	2026-11-12 02:51:30
@@ -0,0 +1,67 @@
+from datetime import datetime, timezone
+
+import pytest
+
+from parcelo import audit, clock, customers, invoices, refunds, shipments
+from parcelo.errors import DomainError
+from parcelo.money import Money
+from parcelo.store import db
+
+
+def _paid_invoice():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 2, "local")
+    inv = invoices.issue_invoice(s.id)
+    return invoices.mark_paid(inv.id)
+
+
+def test_create_refund_for_paid_invoice():
+    inv = _paid_invoice()
+    r = refunds.create_refund(inv.id, Money.parse(3.5))
+    assert r.id.startswith("ref_")
+    assert r.invoice_id == inv.id
+    assert r.amount == Money(350)
+    assert isinstance(r.amount, Money)
+    assert db.refunds[r.id] is r
+
+
+def test_create_refund_wraps_float_amount():
+    inv = _paid_invoice()
+    r = refunds.create_refund(inv.id, 3.5)
+    assert isinstance(r.amount, Money)
+    assert r.amount == Money(350)
+
+
+def test_create_refund_sets_created_at():
+    clock.set_fixed(datetime(2026, 11, 12, 9, 0, tzinfo=timezone.utc))
+    inv = _paid_invoice()
+    r = refunds.create_refund(inv.id, Money.parse(1))
+    assert r.created_at == clock.now()
+
+
+def test_create_refund_records_audit():
+    inv = _paid_invoice()
+    audit.LOG.clear()
+    r = refunds.create_refund(inv.id, Money.parse(1))
+    assert audit.LOG[-1]["action"] == "refund.created"
+    assert audit.LOG[-1]["entity_id"] == r.id
+
+
+def test_unknown_invoice_fails():
+    with pytest.raises(DomainError) as err:
+        refunds.create_refund("INV-missing", Money.parse(1))
+    assert err.value.code == "E_NOT_FOUND"
+    assert db.refunds == {}
+    assert audit.LOG == []
+
+
+def test_unpaid_invoice_fails():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 2, "local")
+    inv = invoices.issue_invoice(s.id)
+    audit.LOG.clear()
+    with pytest.raises(DomainError) as err:
+        refunds.create_refund(inv.id, Money.parse(1))
+    assert err.value.code == "E_BAD_STATE"
+    assert db.refunds == {}
+    assert audit.LOG == []
