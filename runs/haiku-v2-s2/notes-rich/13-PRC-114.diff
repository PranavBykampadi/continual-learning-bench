-from datetime import datetime
+from datetime import datetime, timezone
 
+from parcelo import clock
+from parcelo.money import Money
 from parcelo.store import db
+
+AGING_BUCKETS = ("0-30", "31-60", "60+")
+
+
+def _as_naive_utc(moment):
+    # invoices.issue_invoice stores naive UTC (utcnow) while clock.now() is
+    # aware UTC; subtracting the two raises TypeError, so normalize both.
+    if moment.tzinfo is not None:
+        moment = moment.astimezone(timezone.utc).replace(tzinfo=None)
+    return moment
+
+
+def _aging_bucket(age_days):
+    if age_days <= 30:
+        return "0-30"
+    if age_days <= 60:
+        return "31-60"
+    return "60+"
+
+
+def aging_report():
+    """Total open invoice amounts per age bucket, in whole days since issue."""
+    now = _as_naive_utc(clock.now())
+    totals = {key: Money.zero() for key in AGING_BUCKETS}
+    for invoice in db.invoices.values():
+        if invoice.status != "open" or invoice.issued_at is None:
+            continue
+        age = (now - _as_naive_utc(invoice.issued_at)).days
+        # An invoice dated in the future (clock skew) counts as age 0.
+        bucket = _aging_bucket(max(age, 0))
+        totals[bucket] = totals[bucket] + Money.parse(invoice.amount)
+    return totals
 
 
