+def apply_credit(invoice_id, amount):
+    """Reduce an open invoice by a credit; return the remaining amount as Money."""
+    if invoice_id not in db.invoices:
+        raise DomainError("E_NOT_FOUND", invoice_id)
+    try:
+        credit = Money.parse(amount)
+    except (InvalidOperation, TypeError, ValueError, OverflowError):
+        raise DomainError("E_BAD_INPUT", repr(amount))
+    if credit.cents <= 0:
+        raise DomainError("E_BAD_INPUT", "credit must be positive")
+    invoice = db.invoices[invoice_id]
+    current = Money.parse(invoice.amount)
+    if current < credit:
+        raise DomainError("E_BAD_INPUT", "credit exceeds invoice amount")
+    if invoice.status != "open":
+        raise DomainError("E_BAD_STATE", invoice.status)
+    remaining = current - credit
+    # Invoice.amount is a float in dollars; reports and balances sum it as such.
+    invoice.amount = remaining.cents / 100
+    audit.record(
+        "invoice.credit_applied",
+        invoice.id,
+        credit_cents=credit.cents,
+        remaining_cents=remaining.cents,
+    )
+    return remaining
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_invoice_credit.py b/tests/unit/test_invoice_credit.py
--- a/tests/unit/test_invoice_credit.py	1969-12-31 19:00:00
+++ b/tests/unit/test_invoice_credit.py	2026-11-12 02:58:09
@@ -0,0 +1,130 @@
+from decimal import Decimal
+
+import pytest
+
+from parcelo import audit, customers, invoices, reports, shipments
+from parcelo.errors import DomainError
+from parcelo.money import Money
+
+
+def make_open_invoice():
+    """Local 2kg shipment -> invoice amount 7.00, status open."""
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 2, "local")
+    inv = invoices.issue_invoice(s.id)
+    return c, inv
+
+
+def make_paid_invoice():
+    c, inv = make_open_invoice()
+    invoices.mark_paid(inv.id)
+    return c, inv
+
+
+def test_credit_reduces_amount_and_returns_remaining_money():
+    _, inv = make_open_invoice()
+    remaining = invoices.apply_credit(inv.id, Decimal("2.50"))
+    assert remaining == Money(450)
+    assert inv.amount == 4.5
+    assert inv.status == "open"
+
+
+def test_credit_accepts_float_input():
+    _, inv = make_open_invoice()
+    remaining = invoices.apply_credit(inv.id, 1.25)
+    assert remaining == Money(575)
+    assert inv.amount == 5.75
+
+
+def test_credit_equal_to_amount_leaves_zero():
+    _, inv = make_open_invoice()
+    remaining = invoices.apply_credit(inv.id, 7.0)
+    assert remaining == Money.zero()
+    assert inv.amount == 0.0
+
+
+def test_credit_records_audit_against_invoice():
+    _, inv = make_open_invoice()
+    audit.LOG.clear()
+    invoices.apply_credit(inv.id, 2.5)
+    entry = audit.LOG[-1]
+    assert entry["action"] == "invoice.credit_applied"
+    assert entry["entity_id"] == inv.id
+    assert entry["details"] == {"credit_cents": 250, "remaining_cents": 450}
+
+
+def test_unknown_invoice_is_not_found():
+    with pytest.raises(DomainError) as err:
+        invoices.apply_credit("INV-missing", 1.0)
+    assert err.value.code == "E_NOT_FOUND"
+
+
+def test_unknown_invoice_records_nothing():
+    audit.LOG.clear()
+    with pytest.raises(DomainError):
+        invoices.apply_credit("INV-missing", 1.0)
+    assert audit.LOG == []
+
+
+@pytest.mark.parametrize("bad", ["abc", None, "", float("inf")])
+def test_unparseable_credit_is_bad_input(bad):
+    _, inv = make_open_invoice()
+    audit.LOG.clear()
+    with pytest.raises(DomainError) as err:
+        invoices.apply_credit(inv.id, bad)
+    assert err.value.code == "E_BAD_INPUT"
+    assert inv.amount == 7.0
+    assert audit.LOG == []
+
+
+@pytest.mark.parametrize("bad", [0, -1, -0.5])
+def test_non_positive_credit_is_bad_input(bad):
+    _, inv = make_open_invoice()
+    audit.LOG.clear()
+    with pytest.raises(DomainError) as err:
+        invoices.apply_credit(inv.id, bad)
+    assert err.value.code == "E_BAD_INPUT"
+    assert inv.amount == 7.0
+    assert audit.LOG == []
+
+
+def test_credit_larger_than_amount_is_bad_input():
+    _, inv = make_open_invoice()
+    audit.LOG.clear()
+    with pytest.raises(DomainError) as err:
+        invoices.apply_credit(inv.id, 7.01)
+    assert err.value.code == "E_BAD_INPUT"
+    assert inv.amount == 7.0
+    assert audit.LOG == []
+
+
+def test_paid_invoice_is_bad_state():
+    _, inv = make_paid_invoice()
+    audit.LOG.clear()
+    with pytest.raises(DomainError) as err:
+        invoices.apply_credit(inv.id, 1.0)
+    assert err.value.code == "E_BAD_STATE"
+    assert inv.amount == 7.0
+    assert inv.status == "paid"
+    assert audit.LOG == []
+
+
+def test_credit_keeps_outstanding_balance_correct():
+    c, inv = make_open_invoice()
+    invoices.apply_credit(inv.id, 2.5)
+    assert customers.outstanding_balance(c.id) == 4.5
+
+
+def test_credit_keeps_reports_working():
+    _, inv = make_open_invoice()
+    invoices.apply_credit(inv.id, 2.5)
+    assert reports.revenue_total() == 0.0
+    summary = reports.daily_summary()
+    assert summary["shipments"] 