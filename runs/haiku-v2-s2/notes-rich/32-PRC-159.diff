diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_shipments_in_zone.py b/tests/unit/test_shipments_in_zone.py
--- a/tests/unit/test_shipments_in_zone.py	1969-12-31 19:00:00
+++ b/tests/unit/test_shipments_in_zone.py	2026-11-12 03:11:28
@@ -0,0 +1,74 @@
+import pytest
+
+from parcelo import customers, events, shipments
+from parcelo.errors import DomainError
+
+
+def _book(customer_id, zone, weight=1.0):
+    return shipments.create_shipment(customer_id, weight, zone)
+
+
+def test_returns_only_shipments_in_zone():
+    c = customers.add_customer("Acme")
+    national = _book(c.id, "national")
+    _book(c.id, "local")
+    other_national = _book(c.id, "national", weight=2.0)
+
+    result = shipments.shipments_in_zone("national")
+
+    assert [s.id for s in result] == sorted([national.id, other_national.id])
+    assert all(s.zone == "national" for s in result)
+
+
+def test_empty_list_when_no_shipments_in_zone():
+    c = customers.add_customer("Acme")
+    _book(c.id, "local")
+
+    assert shipments.shipments_in_zone("international") == []
+
+
+def test_empty_list_when_no_shipments_at_all():
+    assert shipments.shipments_in_zone("local") == []
+
+
+def test_sorted_by_id_not_storage_order():
+    c = customers.add_customer("Acme")
+    created = [_book(c.id, "local") for _ in range(5)]
+
+    result = shipments.shipments_in_zone("local")
+
+    ids_result = [s.id for s in result]
+    assert ids_result == sorted(ids_result)
+    assert sorted(ids_result) == sorted(s.id for s in created)
+
+
+def test_unknown_zone_raises_bad_zone():
+    with pytest.raises(DomainError) as err:
+        shipments.shipments_in_zone("mars")
+    assert err.value.code == "E_BAD_ZONE"
+
+
+def test_read_only_emits_no_events_and_changes_nothing():
+    c = customers.add_customer("Acme")
+    s = _book(c.id, "local")
+    before_events = len(events.OUTBOX)
+    before_status = s.status
+
+    first = shipments.shipments_in_zone("local")
+    second = shipments.shipments_in_zone("local")
+
+    assert len(events.OUTBOX) == before_events
+    assert first == second == [s]
+    assert s.status == before_status
+
+
+def test_bad_zone_leaves_outbox_unchanged():
+    c = customers.add_customer("Acme")
+    _book(c.id, "local")
+    before = list(events.OUTBOX)
+
+    with pytest.raises(DomainError):
+        shipments.shipments_in_zone("mars")
+
+    assert events.OUTBOX == before
+
