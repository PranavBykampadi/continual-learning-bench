+import copy
+
+import pytest
+
+from parcelo import customers, events, store, vouchers
+from parcelo.errors import DomainError
+from parcelo.models import Voucher
+from parcelo.settings import MAX_VOUCHER_AMOUNT
+
+
+def test_issue_voucher_saves_and_returns_voucher():
+    c = customers.add_customer("Acme")
+    v = vouchers.issue_voucher(c.id, 25)
+    assert isinstance(v, Voucher)
+    assert v.id.startswith("vch_")
+    assert v.customer_id == c.id
+    assert v.amount == 25
+    assert v.issued_at is not None
+    assert store.db.vouchers[v.id] is v
+
+
+def test_issue_voucher_emits_no_events():
+    c = customers.add_customer("Acme")
+    events.OUTBOX.clear()
+    vouchers.issue_voucher(c.id, 10)
+    assert events.OUTBOX == []
+
+
+def test_issue_voucher_is_not_idempotent():
+    c = customers.add_customer("Acme")
+    first = vouchers.issue_voucher(c.id, 10)
+    second = vouchers.issue_voucher(c.id, 10)
+    assert first.id != second.id
+    assert len(store.db.vouchers) == 2
+
+
+def test_amount_at_limit_is_allowed():
+    c = customers.add_customer("Acme")
+    v = vouchers.issue_voucher(c.id, MAX_VOUCHER_AMOUNT)
+    assert v.amount == MAX_VOUCHER_AMOUNT
+
+
+def test_unknown_customer():
+    with pytest.raises(DomainError) as err:
+        vouchers.issue_voucher("nope", 10)
+    assert err.value.code == "E_UNKNOWN_CUSTOMER"
+
+
+def test_amount_over_limit():
+    c = customers.add_customer("Acme")
+    with pytest.raises(DomainError) as err:
+        vouchers.issue_voucher(c.id, MAX_VOUCHER_AMOUNT + 0.01)
+    assert err.value.code == "E_LIMIT"
+
+
+@pytest.mark.parametrize("amount", [0, -1, -0.01, None, "10", True])
+def test_bad_amount(amount):
+    c = customers.add_customer("Acme")
+    with pytest.raises(DomainError) as err:
+        vouchers.issue_voucher(c.id, amount)
+    assert err.value.code == "E_BAD_INPUT"
+
+
