diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_reports.py b/tests/unit/test_reports.py
--- a/tests/unit/test_reports.py	1969-12-31 19:00:00
+++ b/tests/unit/test_reports.py	2026-11-12 02:54:00
@@ -0,0 +1,46 @@
+from parcelo import customers, invoices, reports, shipments
+from parcelo.money import Money
+
+
+def _invoice(customer_id, weight_kg, zone, status="open"):
+    s = shipments.create_shipment(customer_id, weight_kg, zone)
+    inv = invoices.issue_invoice(s.id)
+    if status == "paid":
+        invoices.mark_paid(inv.id)
+    elif status != "open":
+        inv.status = status
+    return inv
+
+
+def test_sums_open_invoices_per_customer_and_skips_paid_and_void():
+    a = customers.add_customer("Acme")
+    b = customers.add_customer("Beta")
+    c = customers.add_customer("Gamma")
+
+    _invoice(a.id, 2, "local")  # quote = 4.5 + 1.25*2 = 7.00 -> 700 cents, open
+    _invoice(a.id, 1, "national")  # quote = 9.0 + 1.25*1 = 10.25 -> 1025 cents, open
+    _invoice(a.id, 4, "international", status="paid")  # 29.00, excluded
+    _invoice(a.id, 3, "local", status="void")  # 8.25, excluded
+    _invoice(b.id, 4, "international", status="paid")  # only paid -> zero
+
+    result = reports.outstanding_by_customer()
+
+    # 700 + 1025 = 1725 cents
+    assert result[a.id] == Money(1725)
+    assert result[b.id] == Money.zero()
+    # customer with no invoices at all still appears, at zero
+    assert result[c.id] == Money.zero()
+
+
+def test_values_are_money_not_float():
+    a = customers.add_customer("Acme")
+    _invoice(a.id, 2, "local")  # 7.00 -> 700 cents
+
+    result = reports.outstanding_by_customer()
+
+    assert isinstance(result[a.id], Money)
+    assert result[a.id].cents == 700
+
+
+def test_empty_when_no_customers():
+    assert reports.outstanding_by_customer() == {}
