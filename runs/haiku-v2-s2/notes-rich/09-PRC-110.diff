+from decimal import Decimal
+
+from parcelo.errors import DomainError
+from parcelo.money import Money
+
 ZONE_BASE = {"local": 4.5, "national": 9.0, "international": 24.0}
 PER_KG = 1.25
 
+# Discount rate per customer tier, as a fraction of the quote.
+TIER_DISCOUNT = {"standard": Decimal("0"), "gold": Decimal("0.10")}
 
+
 def base_rate(zone):
     if zone not in ZONE_BASE:
         raise ValueError("unknown zone: %s" % zone)
@@ -12,3 +20,13 @@
     if weight_kg <= 0:
         raise ValueError("weight must be positive")
     return round(base_rate(zone) + PER_KG * weight_kg, 2)
+
+
+def discounted_quote(weight_kg, zone, tier):
+    """Return the quote for weight and zone as Money, with the tier discount applied."""
+    if zone not in ZONE_BASE:
+        raise DomainError("E_BAD_ZONE", zone)
+    if tier not in TIER_DISCOUNT:
+        raise DomainError("E_BAD_INPUT", "unknown tier: %s" % tier)
+    regular = Money.parse(quote(weight_kg, zone))
+    return regular.scale(1 - TIER_DISCOUNT[tier])
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_discounted_quote.py b/tests/unit/test_discounted_quote.py
--- a/tests/unit/test_discounted_quote.py	1969-12-31 19:00:00
+++ b/tests/unit/test_discounted_quote.py	2026-11-12 02:55:30
@@ -0,0 +1,42 @@
+import pytest
+
+from parcelo import audit, rates
+from parcelo.errors import DomainError
+from parcelo.money import Money
+
+
+def test_gold_gets_ten_percent_off():
+    # local 2kg: 4.5 + 1.25 * 2 = 7.00 -> 10% off = 6.30
+    result = rates.discounted_quote(2, "local", "gold")
+    assert isinstance(result, Money)
+    assert result == Money(630)
+
+
+def test_standard_has_no_discount():
+    result = rates.discounted_quote(2, "local", "standard")
+    assert isinstance(result, Money)
+    assert result == Money(700)
+
+
+def test_gold_matches_regular_quote_less_ten_percent():
+    regular = Money.parse(rates.quote(10, "international"))
+    result = rates.discounted_quote(10, "international", "gold")
+    assert result == regular.scale(0.9)
+
+
+def test_unknown_zone_fails():
+    with pytest.raises(DomainError) as err:
+        rates.discounted_quote(2, "moon", "gold")
+    assert err.value.code == "E_BAD_ZONE"
+
+
+def test_unknown_tier_fails():
+    with pytest.raises(DomainError) as err:
+        rates.discounted_quote(2, "local", "platinum")
+    assert err.value.code == "E_BAD_INPUT"
+
+
+def test_quote_is_read_only_no_audit():
+    before = list(audit.LOG)
+    rates.discounted_quote(2, "local", "gold")
+    assert audit.LOG == before
