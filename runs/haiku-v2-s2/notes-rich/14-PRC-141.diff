     if shipment_id not in db.shipments:
         raise DomainError("E_NOT_FOUND", shipment_id)
     return db.shipments[shipment_id]
+
+
+def _is_delivered(shipment):
+    return shipment.status == "delivered" or shipment.delivered_at is not None
+
+
+def reassign_shipment(shipment_id, new_customer_id):
+    # Order: existence, then state, then mutate/audit. Failing calls change nothing.
+    shipment = get_shipment(shipment_id)
+    if new_customer_id not in db.customers:
+        raise DomainError("E_UNKNOWN_CUSTOMER", new_customer_id)
+    if _is_delivered(shipment):
+        raise DomainError("E_BAD_STATE", shipment_id)
+    old_customer_id = shipment.customer_id
+    shipment.customer_id = new_customer_id
+    audit.record(
+        "shipment.reassigned",
+        shipment_id,
+        old_customer_id=old_customer_id,
+        new_customer_id=new_customer_id,
+    )
+    return shipment
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_reassign_shipment.py b/tests/unit/test_reassign_shipment.py
--- a/tests/unit/test_reassign_shipment.py	1969-12-31 19:00:00
+++ b/tests/unit/test_reassign_shipment.py	2026-11-12 02:59:42
@@ -0,0 +1,81 @@
+from datetime import datetime, timezone
+
+import pytest
+
+from parcelo import audit, customers, shipments
+from parcelo.errors import DomainError
+from parcelo.store import db
+
+
+def _setup():
+    a = customers.add_customer("Acme")
+    b = customers.add_customer("Globex")
+    s = shipments.create_shipment(a.id, 2.0, "national")
+    return a, b, s
+
+
+def test_reassign_changes_customer_and_returns_shipment():
+    a, b, s = _setup()
+    result = shipments.reassign_shipment(s.id, b.id)
+    assert result is s
+    assert s.customer_id == b.id
+    assert db.shipments[s.id].customer_id == b.id
+
+
+def test_reassign_audits_with_old_and_new_customer():
+    a, b, s = _setup()
+    audit.LOG.clear()
+    shipments.reassign_shipment(s.id, b.id)
+    entry = audit.LOG[-1]
+    assert entry["action"] == "shipment.reassigned"
+    assert entry["entity_id"] == s.id
+    assert entry["details"] == {"old_customer_id": a.id, "new_customer_id": b.id}
+
+
+def test_reassign_unknown_shipment_fails():
+    a, b, s = _setup()
+    audit.LOG.clear()
+    with pytest.raises(DomainError) as err:
+        shipments.reassign_shipment("shp_missing", b.id)
+    assert err.value.code == "E_NOT_FOUND"
+    assert audit.LOG == []
+
+
+def test_reassign_to_unknown_customer_fails():
+    a, b, s = _setup()
+    audit.LOG.clear()
+    with pytest.raises(DomainError) as err:
+        shipments.reassign_shipment(s.id, "C_missing")
+    assert err.value.code == "E_UNKNOWN_CUSTOMER"
+    assert s.customer_id == a.id
+    assert audit.LOG == []
+
+
+def test_reassign_delivered_by_status_fails():
+    a, b, s = _setup()
+    s.status = "delivered"
+    audit.LOG.clear()
+    with pytest.raises(DomainError) as err:
+        shipments.reassign_shipment(s.id, b.id)
+    assert err.value.code == "E_BAD_STATE"
+    assert s.customer_id == a.id
+    assert audit.LOG == []
+
+
+def test_reassign_delivered_by_timestamp_fails():
+    a, b, s = _setup()
+    s.delivered_at = datetime(2026, 11, 1, 12, 0, tzinfo=timezone.utc)
+    audit.LOG.clear()
+    with pytest.raises(DomainError) as err:
+        shipments.reassign_shipment(s.id, b.id)
+    assert err.value.code == "E_BAD_STATE"
+    assert s.customer_id == a.id
+    assert audit.LOG == []
+
+
+def test_unknown_customer_checked_before_delivered_state():
+    a, b, s = _setup()
+    s.status = "delivered"
+    with pytest.raises(DomainError) as err:
+        shipments.reassign_shipment(s.id, "C_missing")
+    assert err.value.code == "E_UNKNOWN_CUSTOMER"
