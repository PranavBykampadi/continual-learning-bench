+def _parse_declared_value(declared_value):
+    if declared_value is None or (isinstance(declared_value, str) and declared_value.strip() == ""):
+        raise DomainError("E_BAD_INPUT", "declared value is required")
+    if isinstance(declared_value, float) and not math.isfinite(declared_value):
+        raise DomainError("E_BAD_INPUT", "declared value must be finite")
+    try:
+        value = Money.parse(declared_value)
+    except (InvalidOperation, TypeError, ValueError, OverflowError) as exc:
+        raise DomainError("E_BAD_INPUT", "bad declared value: %r" % (declared_value,)) from exc
+    if value.cents <= 0:
+        raise DomainError("E_BAD_INPUT", "declared value must be positive")
+    return value
+
+
+def insurance_fee(declared_value, zone):
+    """Insurance fee: 2% of declared value plus the zone's fuel surcharge, min 1.00."""
+    if zone not in FUEL_SURCHARGE_PCT:
+        raise DomainError("E_BAD_ZONE", zone)
+    value = _parse_declared_value(declared_value)
+    rate = (INSURANCE_RATE_PCT + FUEL_SURCHARGE_PCT[zone]) / Decimal(100)
+    fee = value.scale(rate)
+    if fee < INSURANCE_MIN_FEE:
+        fee = INSURANCE_MIN_FEE
+    return fee
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_insurance.py b/tests/unit/test_insurance.py
--- a/tests/unit/test_insurance.py	1969-12-31 19:00:00
+++ b/tests/unit/test_insurance.py	2026-11-12 03:01:45
@@ -0,0 +1,67 @@
+from decimal import Decimal
+
+import pytest
+
+from parcelo import events
+from parcelo.errors import DomainError
+from parcelo.money import Money
+from parcelo.rates import insurance_fee
+
+
+def test_national_fee_includes_fuel_surcharge():
+    # 2% + 4% fuel of 100.00 = 6.00
+    fee = insurance_fee(100, "national")
+    assert isinstance(fee, Money)
+    assert fee == Money(600)
+
+
+def test_local_fee_has_no_fuel_surcharge():
+    assert insurance_fee(Decimal("250.00"), "local") == Money(500)
+
+
+def test_international_fee_uses_fuel_percentage():
+    # 2% + 9.5% of 100.00 = 11.50
+    assert insurance_fee(100, "international") == Money(1150)
+
+
+def test_float_input_is_parsed_as_dollars():
+    # 2% + 4% of 19.99 = 1.1994, rounds to 1.20
+    assert insurance_fee(19.99, "national") == Money(120)
+
+
+def test_minimum_fee_applies_to_small_values():
+    # 2% of 10.00 is 0.20, so the 1.00 minimum applies
+    assert insurance_fee(10, "local") == Money(100)
+
+
+def test_minimum_fee_boundary_exact():
+    # 2% of 50.00 is exactly 1.00
+    assert insurance_fee(50, "local") == Money(100)
+
+
+def test_unknown_zone_fails():
+    events.OUTBOX.clear()
+    with pytest.raises(DomainError) as err:
+        insurance_fee(100, "moon")
+    assert err.value.code == "E_BAD_ZONE"
+    assert events.OUTBOX == []
+
+
+@pytest.mark.parametrize("value", [0, -5, -0.01, 0.001])
+def test_non_positive_declared_value_fails(value):
+    with pytest.raises(DomainError) as err:
+        insurance_fee(value, "national")
+    assert err.value.code == "E_BAD_INPUT"
+
+
+@pytest.mark.parametrize("value", [None, "", "   ", "abc", float("inf"), float("nan"), "inf"])
+def test_bad_declared_value_fails(value):
+    with pytest.raises(DomainError) as err:
+        insurance_fee(value, "national")
+    assert err.value.code == "E_BAD_INPUT"
+
+
+def test_fee_emits_no_events():
+    events.OUTBOX.clear()
+    insurance_fee(100, "national")
+    assert events.OUTBOX == []
