--- a/parcelo/shipments.py	2026-11-10 12:20:18
+++ b/parcelo/shipments.py	2026-11-12 03:11:58
@@ -28,3 +28,15 @@
     if shipment_id not in db.shipments:
         raise DomainError("E_NOT_FOUND", shipment_id)
     return db.shipments[shipment_id]
+
+
+def mark_returned(shipment_id):
+    shipment = get_shipment(shipment_id)
+    if shipment.status == "returned":
+        return shipment
+    if shipment.status == "created":
+        raise DomainError("E_BAD_STATE", shipment_id)
+    shipment.status = "returned"
+    shipment.returned_at = clock.now()
+    events.emit("shipment.returned", shipment.id)
+    return shipment
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_mark_returned.py b/tests/unit/test_mark_returned.py
--- a/tests/unit/test_mark_returned.py	1969-12-31 19:00:00
+++ b/tests/unit/test_mark_returned.py	2026-11-12 03:12:04
@@ -0,0 +1,86 @@
+from datetime import datetime, timezone
+
+import pytest
+
+from parcelo import clock, customers, events, shipments
+from parcelo.errors import DomainError
+from parcelo.store import db
+
+MOMENT = datetime(2026, 11, 1, 12, 0, tzinfo=timezone.utc)
+LATER = datetime(2026, 11, 2, 9, 30, tzinfo=timezone.utc)
+
+
+def _delivered_shipment():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 2.0, "national")
+    s.status = "delivered"
+    events.OUTBOX.clear()
+    return s
+
+
+def _snapshot(s):
+    return (s.status, s.returned_at, s.delivered_at, list(s.notes))
+
+
+def test_marks_delivered_shipment_returned():
+    s = _delivered_shipment()
+    clock.set_fixed(MOMENT)
+    try:
+        result = shipments.mark_returned(s.id)
+    finally:
+        clock.clear_fixed()
+    assert result is s
+    assert s.status == "returned"
+    assert s.returned_at == MOMENT
+
+
+def test_emits_one_returned_event():
+    s = _delivered_shipment()
+    shipments.mark_returned(s.id)
+    assert len(events.OUTBOX) == 1
+    assert events.OUTBOX[0]["name"] == "shipment.returned"
+    assert events.OUTBOX[0]["entity_id"] == s.id
+
+
+def test_created_shipment_is_rejected_and_unchanged():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 2.0, "national")
+    before_outbox = list(events.OUTBOX)
+    before = _snapshot(s)
+    with pytest.raises(DomainError) as err:
+        shipments.mark_returned(s.id)
+    assert err.value.code == "E_BAD_STATE"
+    assert _snapshot(s) == before
+    assert s.status == "created"
+    assert events.OUTBOX == before_outbox
+
+
+def test_unknown_shipment_is_rejected_and_store_unchanged():
+    s = _delivered_shipment()
+    before_outbox = list(events.OUTBOX)
+    before_store = dict(db.shipments)
+    with pytest.raises(DomainError) as err:
+        shipments.mark_returned("shp_missing")
+    assert err.value.code == "E_NOT_FOUND"
+    assert db.shipments == before_store
+    assert events.OUTBOX == before_outbox
+    assert _snapshot(s) == ("delivered", None, None, [])
+
+
+def test_idempotent_second_call_keeps_time_and_emits_nothing():
+    s = _delivered_shipment()
+    clock.set_fixed(MOMENT)
+    try:
+        shipments.mark_returned(s.id)
+    finally:
+        clock.clear_fixed()
+    outbox_after_first = list(events.OUTBOX)
+    clock.set_fixed(LATER)
+    try:
+        result = shipments.mark_returned(s.id)
+    finally:
+        clock.clear_fixed()
+    assert result is s
+    assert s.status == "returned"
+    assert s.returned_at == MOMENT
+    assert events.OUTBOX == outbox_after_first
