diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_pickups.py b/tests/unit/test_pickups.py
--- a/tests/unit/test_pickups.py	1969-12-31 19:00:00
+++ b/tests/unit/test_pickups.py	2026-11-12 03:00:57
@@ -0,0 +1,71 @@
+from datetime import datetime, timezone
+
+import pytest
+
+from parcelo import clock, customers, events, pickups, shipments, store
+from parcelo.errors import DomainError
+
+WINDOW = datetime(2026, 11, 13, 9, 0, tzinfo=timezone.utc)
+
+
+def _created_shipment():
+    c = customers.add_customer("Acme")
+    return shipments.create_shipment(c.id, 2.0, "national")
+
+
+def test_schedule_creates_pickup_and_saves_it():
+    clock.set_fixed(datetime(2026, 11, 12, 8, 0, tzinfo=timezone.utc))
+    s = _created_shipment()
+    p = pickups.schedule_pickup(s.id, WINDOW)
+    assert p.id.startswith("pkp_")
+    assert p.shipment_id == s.id
+    assert p.window_start == WINDOW
+    assert p.scheduled_at == datetime(2026, 11, 12, 8, 0, tzinfo=timezone.utc)
+    assert store.db.pickups[p.id] is p
+
+
+def test_schedule_emits_event_for_pickup():
+    s = _created_shipment()
+    events.OUTBOX.clear()
+    p = pickups.schedule_pickup(s.id, WINDOW)
+    assert len(events.OUTBOX) == 1
+    assert events.OUTBOX[-1]["name"] == "pickup.scheduled"
+    assert events.OUTBOX[-1]["entity_id"] == p.id
+
+
+def test_unknown_shipment_fails_not_found():
+    with pytest.raises(DomainError) as err:
+        pickups.schedule_pickup("nope", WINDOW)
+    assert err.value.code == "E_NOT_FOUND"
+
+
+def test_non_created_shipment_fails_bad_state():
+    s = _created_shipment()
+    s.status = "delivered"
+    with pytest.raises(DomainError) as err:
+        pickups.schedule_pickup(s.id, WINDOW)
+    assert err.value.code == "E_BAD_STATE"
+
+
+def test_missing_window_start_fails_bad_input():
+    s = _created_shipment()
+    with pytest.raises(DomainError) as err:
+        pickups.schedule_pickup(s.id, None)
+    assert err.value.code == "E_BAD_INPUT"
+
+
+def test_failed_calls_leave_store_and_events_unchanged():
+    s = _created_shipment()
+    s.status = "delivered"
+    events.OUTBOX.clear()
+    before = dict(store.db.pickups)
+
+    with pytest.raises(DomainError):
+        pickups.schedule_pickup("nope", WINDOW)
+    with pytest.raises(DomainError):
+        pickups.schedule_pickup(s.id, None)
+    with pytest.raises(DomainError):
+        pickups.schedule_pickup(s.id, WINDOW)
+
+    assert store.db.pickups == before
+    assert events.OUTBOX == []
