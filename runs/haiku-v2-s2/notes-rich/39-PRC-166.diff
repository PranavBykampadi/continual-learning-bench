 def open_invoices():
     return [i for i in db.invoices.values() if i.status == "open"]
+
+
+def escalate_invoice(invoice_id):
+    """Send an open invoice of at least ESCALATION_MIN_AMOUNT to collections.
+
+    Idempotent: an already escalated invoice is returned unchanged, with no event.
+    """
+    if invoice_id not in db.invoices:
+        raise DomainError("E_NOT_FOUND", invoice_id)
+    invoice = db.invoices[invoice_id]
+    if invoice.status == "escalated":
+        return invoice
+    if invoice.status != "open":
+        raise DomainError("E_BAD_STATE", invoice_id)
+    if Money.parse(invoice.amount) < ESCALATION_MIN_AMOUNT:
+        raise DomainError("E_LIMIT", invoice_id)
+    invoice.status = "escalated"
+    events.emit("invoice.escalated", invoice.id)
+    return invoice
