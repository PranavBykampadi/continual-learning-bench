+def split_shipment(shipment_id, weights):
+    shipment = get_shipment(shipment_id)
+    if not isinstance(weights, (list, tuple)) or len(weights) == 0:
+        raise DomainError("E_BAD_INPUT", "weights must be a non-empty list")
+    for w in weights:
+        if isinstance(w, bool) or not isinstance(w, (int, float)) or not math.isfinite(w):
+            raise DomainError("E_BAD_INPUT", str(w))
+        if w <= 0:
+            raise DomainError("E_BAD_WEIGHT", str(w))
+    total = sum(weights)
+    if not math.isclose(total, shipment.weight_kg, rel_tol=1e-9, abs_tol=1e-9):
+        raise DomainError(
+            "E_BAD_WEIGHT",
+            f"weights sum to {total}, shipment weighs {shipment.weight_kg}",
+        )
+    if shipment.status != "created":
+        raise DomainError("E_BAD_STATE", shipment.status)
+
+    now = clock.now()
+    parts = []
+    for w in weights:
+        part = Shipment(
+            id=ids.new_id("shp"),
+            customer_id=shipment.customer_id,
+            weight_kg=w,
+            zone=shipment.zone,
+            created_at=now,
+        )
+        db.shipments[part.id] = part
+        events.emit("shipment.created", part.id, zone=part.zone)
+        parts.append(part)
+
+    shipment.status = "split"
+    events.emit("shipment.split", shipment.id, parts=[p.id for p in parts])
+    return parts
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_split_shipment.py b/tests/unit/test_split_shipment.py
--- a/tests/unit/test_split_shipment.py	1969-12-31 19:00:00
+++ b/tests/unit/test_split_shipment.py	2026-11-12 03:05:01
@@ -0,0 +1,107 @@
+import pytest
+
+from parcelo import clock, customers, events, shipments
+from parcelo.errors import DomainError
+
+
+def _created(weight=3.0, zone="national"):
+    c = customers.add_customer("Acme")
+    return shipments.create_shipment(c.id, weight, zone)
+
+
+def test_split_returns_new_shipments_in_weight_order():
+    s = _created(3.0, "national")
+    parts = shipments.split_shipment(s.id, [1.0, 2.0])
+    assert [p.weight_kg for p in parts] == [1.0, 2.0]
+    for p in parts:
+        assert p.id.startswith("shp_")
+        assert p.id != s.id
+        assert p.customer_id == s.customer_id
+        assert p.zone == "national"
+        assert p.status == "created"
+    assert shipments.get_shipment(parts[0].id) is parts[0]
+    assert shipments.get_shipment(parts[1].id) is parts[1]
+
+
+def test_split_marks_original_as_split():
+    s = _created(3.0)
+    shipments.split_shipment(s.id, [1.0, 2.0])
+    assert shipments.get_shipment(s.id).status == "split"
+
+
+def test_split_new_shipments_use_clock_now():
+    moment = clock.now()
+    clock.set_fixed(moment)
+    try:
+        s = _created(2.0)
+        parts = shipments.split_shipment(s.id, [0.5, 1.5])
+        assert all(p.created_at == moment for p in parts)
+    finally:
+        clock.clear_fixed()
+
+
+def test_split_emits_events():
+    s = _created(3.0)
+    events.OUTBOX.clear()
+    parts = shipments.split_shipment(s.id, [1.0, 2.0])
+    names = [(e["name"], e["entity_id"]) for e in events.OUTBOX]
+    assert names == [
+        ("shipment.created", parts[0].id),
+        ("shipment.created", parts[1].id),
+        ("shipment.split", s.id),
+    ]
+
+
+def test_split_accepts_float_rounding_noise():
+    s = _created(0.3)
+    parts = shipments.split_shipment(s.id, [0.1, 0.2])
+    assert len(parts) == 2
+
+
+def test_split_unknown_shipment_fails():
+    with pytest.raises(DomainError) as err:
+        shipments.split_shipment("shp_missing", [1.0])
+    assert err.value.code == "E_NOT_FOUND"
+
+
+def test_split_non_created_shipment_fails():
+    s = _created(3.0)
+    shipments.split_shipment(s.id, [1.0, 2.0])
+    events.OUTBOX.clear()
+    with pytest.raises(DomainError) as err:
+        shipments.split_shipment(s.id, [1.0, 2.0])
+    assert err.value.code == "E_BAD_STATE"
+    assert events.OUTBOX == []
+
+
+def test_split_weights_must_sum_to_original():
+    s = _created(3.0)
+    with pytest.raises(DomainError) as err:
+        shipments.split_shipment(s.id, [1.0, 1.0])
+    assert err.value.code == "E_BAD_WEIGHT"
+    assert shipments.get_shipment(s.id).status == "created"
+
