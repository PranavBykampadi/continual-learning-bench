diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_claims.py b/tests/unit/test_claims.py
--- a/tests/unit/test_claims.py	1969-12-31 19:00:00
+++ b/tests/unit/test_claims.py	2026-11-12 02:53:27
@@ -0,0 +1,47 @@
+import pytest
+
+from parcelo import claims, customers, shipments
+from parcelo.errors import DomainError
+from parcelo.store import db
+
+
+def _delivered_shipment():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 2.0, "local")
+    s.status = "delivered"
+    return s
+
+
+def test_file_claim_on_delivered_shipment():
+    s = _delivered_shipment()
+    claim = claims.file_claim(s.id, 12.5, "broken box")
+    assert claim.id.startswith("clm_")
+    assert claim.shipment_id == s.id
+    assert claim.amount == 12.5
+    assert claim.reason == "broken box"
+    assert claim.filed_at is not None
+    assert db.claims[claim.id] is claim
+
+
+def test_undelivered_shipment_rejected():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 2.0, "local")
+    with pytest.raises(DomainError) as err:
+        claims.file_claim(s.id, 5, "late")
+    assert err.value.code == "E_BAD_STATE"
+    assert db.claims == {}
+
+
+def test_unknown_shipment_rejected():
+    with pytest.raises(DomainError) as err:
+        claims.file_claim("shp_missing", 5, "lost")
+    assert err.value.code == "E_NOT_FOUND"
+
+
+@pytest.mark.parametrize("amount", [0, -3, None, "5", True])
+def test_non_positive_or_invalid_amount_rejected(amount):
+    s = _delivered_shipment()
+    with pytest.raises(DomainError) as err:
+        claims.file_claim(s.id, amount, "damaged")
+    assert err.value.code == "E_BAD_INPUT"
+    assert db.claims == {}
