diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_customers.py b/tests/unit/test_customers.py
--- a/tests/unit/test_customers.py	1969-12-31 19:00:00
+++ b/tests/unit/test_customers.py	2026-11-12 02:49:42
@@ -0,0 +1,26 @@
+import pytest
+
+from parcelo import customers
+from parcelo.errors import DomainError
+
+
+def test_deactivate_customer_sets_inactive():
+    c = customers.add_customer("Acme")
+    assert c.active is True
+    result = customers.deactivate_customer(c.id)
+    assert result is c
+    assert c.active is False
+
+
+def test_deactivate_unknown_customer_fails():
+    with pytest.raises(DomainError) as err:
+        customers.deactivate_customer("C000000")
+    assert err.value.code == "E_NOT_FOUND"
+
+
+def test_deactivate_already_inactive_fails():
+    c = customers.add_customer("Acme")
+    customers.deactivate_customer(c.id)
+    with pytest.raises(DomainError) as err:
+        customers.deactivate_customer(c.id)
+    assert err.value.code == "E_BAD_STATE"
