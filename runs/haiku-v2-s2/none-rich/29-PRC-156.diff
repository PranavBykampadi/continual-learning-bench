diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/parcelo/rates.py b/parcelo/rates.py
--- a/parcelo/rates.py	2026-11-10 12:17:53
+++ b/parcelo/rates.py	2026-11-12 03:00:13
@@ -12,3 +12,16 @@
     if weight_kg <= 0:
         raise ValueError("weight must be positive")
     return round(base_rate(zone) + PER_KG * weight_kg, 2)
+
+
+HEAVY_THRESHOLD_KG = 30
+HEAVY_PER_KG = 0.75
+
+
+def heavy_quote(weight_kg, zone):
+    """Normal quote plus a surcharge for every kg above 30 kg."""
+    # quote() validates the zone and rejects non-positive weights.
+    base = quote(weight_kg, zone)
+    if weight_kg <= HEAVY_THRESHOLD_KG:
+        return base
+    return round(base + HEAVY_PER_KG * (weight_kg - HEAVY_THRESHOLD_KG), 2)
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/test_rates.py b/tests/test_rates.py
--- a/tests/test_rates.py	2026-11-10 12:17:53
+++ b/tests/test_rates.py	2026-11-12 03:00:15
@@ -10,3 +10,24 @@
 def test_unknown_zone():
     with pytest.raises(ValueError):
         rates.base_rate("moon")
+
+
+def test_heavy_quote_at_threshold_is_normal():
+    assert rates.heavy_quote(30, "local") == rates.quote(30, "local")
+
+
+def test_heavy_quote_surcharge_above_30kg():
+    # local: 4.5 + 1.25*40 = 54.5, plus 0.75*10 = 7.5
+    assert rates.heavy_quote(40, "local") == 62.0
+
+
+def test_heavy_quote_unknown_zone():
+    with pytest.raises(ValueError):
+        rates.heavy_quote(40, "moon")
+
+
+def test_heavy_quote_non_positive_weight():
+    with pytest.raises(ValueError):
+        rates.heavy_quote(0, "local")
+    with pytest.raises(ValueError):
+        rates.heavy_quote(-1, "local")
