@@ -1,9 +1,63 @@
-from parcelo import customers, invoices, shipments
+from datetime import timedelta, timezone
 
+import pytest
 
+from parcelo import clock, customers, invoices, shipments
+from parcelo.errors import DomainError
+
+
 def test_issue_and_pay():
     c = customers.add_customer("Acme")
     s = shipments.create_shipment(c.id, 2, "local")
     inv = invoices.issue_invoice(s.id)
     assert inv.amount == 7.0
     assert invoices.mark_paid(inv.id).status == "paid"
+
+
+def _invoice_with_amount(amount):
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 2, "local")
+    inv = invoices.issue_invoice(s.id)
+    inv.amount = amount
+    return inv
+
+
+def _set_now_after_issue(inv, days, extra_hours=0):
+    issued = inv.issued_at.replace(tzinfo=timezone.utc)
+    clock.set_fixed(issued + timedelta(days=days, hours=extra_hours))
+
+
+def test_late_fee_zero_before_late_threshold():
+    inv = _invoice_with_amount(100.0)
+    _set_now_after_issue(inv, 29)
+    assert invoices.late_fee_for(inv.id) == 0.0
+
+
+def test_late_fee_zero_at_exactly_30_days():
+    inv = _invoice_with_amount(100.0)
+    _set_now_after_issue(inv, 30)
+    assert invoices.late_fee_for(inv.id) == 0.0
+
+
+def test_late_fee_one_day_past_threshold():
+    inv = _invoice_with_amount(100.0)
+    _set_now_after_issue(inv, 31)
+    assert invoices.late_fee_for(inv.id) == 1.5
+
+
+def test_late_fee_counts_full_days_only():
+    inv = _invoice_with_amount(100.0)
+    _set_now_after_issue(inv, 31, extra_hours=23)
+    assert invoices.late_fee_for(inv.id) == 1.5
+
+
+def test_late_fee_scales_with_days_late():
+    inv = _invoice_with_amount(100.0)
+    _set_now_after_issue(inv, 40)
+    assert invoices.late_fee_for(inv.id) == 15.0
+
+
+def test_late_fee_unknown_invoice_fails():
+    with pytest.raises(DomainError) as exc:
+        invoices.late_fee_for("INV-missing")
+    assert exc.value.code == "E_NOT_FOUND"
