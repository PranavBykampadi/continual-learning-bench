@@ -32,3 +33,22 @@
 
 def open_invoices():
     return [i for i in db.invoices.values() if i.status == "open"]
+
+
+def apply_credit(invoice_id, amount):
+    """Reduce an open invoice's amount by `amount` and return the remaining amount.
+
+    Reports and customer balances read `Invoice.amount`, so they pick up the
+    reduced value automatically.
+    """
+    if invoice_id not in db.invoices:
+        raise DomainError("E_NOT_FOUND", invoice_id)
+    invoice = db.invoices[invoice_id]
+    if invoice.status != "open":
+        raise DomainError("E_BAD_STATE", f"{invoice_id} is {invoice.status}")
+    if amount <= 0:
+        raise DomainError("E_BAD_INPUT", f"credit must be positive: {amount}")
+    if amount > invoice.amount:
+        raise DomainError("E_BAD_INPUT", f"credit {amount} exceeds invoice amount {invoice.amount}")
+    invoice.amount = round(invoice.amount - amount, 2)
+    return invoice.amount
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/test_invoices.py b/tests/test_invoices.py
--- a/tests/test_invoices.py	2026-11-10 12:17:53
+++ b/tests/test_invoices.py	2026-11-12 02:53:59
@@ -1,9 +1,65 @@
-from parcelo import customers, invoices, shipments
+import pytest
 
+from parcelo import customers, invoices, reports, shipments
+from parcelo.errors import DomainError
 
+
 def test_issue_and_pay():
     c = customers.add_customer("Acme")
     s = shipments.create_shipment(c.id, 2, "local")
     inv = invoices.issue_invoice(s.id)
     assert inv.amount == 7.0
     assert invoices.mark_paid(inv.id).status == "paid"
+
+
+def _open_invoice(amount_kg=2, zone="local"):
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, amount_kg, zone)
+    return c, invoices.issue_invoice(s.id)
+
+
+def test_apply_credit_reduces_open_invoice_and_balance():
+    c, inv = _open_invoice()
+    assert invoices.apply_credit(inv.id, 2.5) == 4.5
+    assert inv.amount == 4.5
+    assert inv.status == "open"
+    assert customers.outstanding_balance(c.id) == 4.5
+
+
+def test_apply_credit_reflected_in_revenue_after_payment():
+    _, inv = _open_invoice()
+    invoices.apply_credit(inv.id, 1)
+    invoices.mark_paid(inv.id)
+    assert reports.revenue_total() == 6.0
+
+
+def test_apply_credit_missing_invoice_fails():
+    with pytest.raises(DomainError) as exc:
+        invoices.apply_credit("INV-nope", 1)
+    assert exc.value.code == "E_NOT_FOUND"
+
+
+def test_apply_credit_to_paid_invoice_fails():
+    _, inv = _open_invoice()
+    invoices.mark_paid(inv.id)
+    with pytest.raises(DomainError) as exc:
+        invoices.apply_credit(inv.id, 1)
+    assert exc.value.code == "E_BAD_STATE"
+    assert inv.amount == 7.0
+
+
+def test_apply_credit_larger_than_amount_fails():
+    _, inv = _open_invoice()
+    with pytest.raises(DomainError) as exc:
+        invoices.apply_credit(inv.id, 7.01)
+    assert exc.value.code == "E_BAD_INPUT"
+    assert inv.amount == 7.0
+
+
+def test_apply_credit_non_positive_fails():
+    _, inv = _open_invoice()
+    with pytest.raises(DomainError):
+        invoices.apply_credit(inv.id, 0)
+    with pytest.raises(DomainError):
+        invoices.apply_credit(inv.id, -1)
+    assert inv.amount == 7.0
