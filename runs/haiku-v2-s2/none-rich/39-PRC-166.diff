+def _add_invoice(invoice_id, amount, status="open"):
+    db.invoices[invoice_id] = Invoice(
+        id=invoice_id, shipment_id="S-1", amount=amount, status=status
+    )
+    return db.invoices[invoice_id]
+
+
+def test_escalate_large_open_invoice():
+    _add_invoice("INV-big", 500.00)
+    inv = invoices.escalate_invoice("INV-big")
+    assert inv.status == "escalated"
+    assert db.invoices["INV-big"] is inv
+
+
+def test_escalate_rejects_small_invoice():
+    _add_invoice("INV-small", 499.99)
+    with pytest.raises(DomainError) as err:
+        invoices.escalate_invoice("INV-small")
+    assert err.value.code == "E_LIMIT"
+    assert db.invoices["INV-small"].status == "open"
+
+
+def test_escalate_rejects_non_open_invoice():
+    _add_invoice("INV-paid", 900.00, status="paid")
+    with pytest.raises(DomainError) as err:
+        invoices.escalate_invoice("INV-paid")
+    assert err.value.code == "E_BAD_STATE"
+    assert db.invoices["INV-paid"].status == "paid"
+
+
+def test_escalate_missing_invoice_fails():
+    with pytest.raises(DomainError) as err:
+        invoices.escalate_invoice("INV-nope")
+    assert err.value.code == "E_NOT_FOUND"
