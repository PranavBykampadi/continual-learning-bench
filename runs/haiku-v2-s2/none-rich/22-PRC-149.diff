diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/parcelo/shipments.py b/parcelo/shipments.py
--- a/parcelo/shipments.py	2026-11-10 12:20:18
+++ b/parcelo/shipments.py	2026-11-12 02:58:20
@@ -1,3 +1,5 @@
+import math
+
 from parcelo import clock, events, ids
 from parcelo.errors import DomainError
 from parcelo.models import Shipment
@@ -28,3 +30,36 @@
     if shipment_id not in db.shipments:
         raise DomainError("E_NOT_FOUND", shipment_id)
     return db.shipments[shipment_id]
+
+
+def split_shipment(shipment_id, weights):
+    """Replace a "created" shipment with one new shipment per weight.
+
+    The original is marked "split". Returns the new shipments in the same
+    order as ``weights``. All validation happens before any state changes,
+    so a failed split leaves the database untouched.
+    """
+    shipment = get_shipment(shipment_id)
+    if shipment.status != "created":
+        raise DomainError("E_BAD_STATE", f"{shipment_id} is {shipment.status}")
+
+    weights = list(weights)
+    if not weights:
+        raise DomainError("E_BAD_INPUT", "no weights given")
+    for weight in weights:
+        if weight <= 0:
+            raise DomainError("E_BAD_WEIGHT", str(weight))
+    if shipment.customer_id not in db.customers:
+        raise DomainError("E_UNKNOWN_CUSTOMER", shipment.customer_id)
+    if not math.isclose(sum(weights), shipment.weight_kg, rel_tol=1e-9, abs_tol=1e-9):
+        raise DomainError(
+            "E_BAD_INPUT",
+            f"weights sum to {sum(weights)}, expected {shipment.weight_kg}",
+        )
+
+    new_shipments = [
+        create_shipment(shipment.customer_id, weight, shipment.zone)
+        for weight in weights
+    ]
+    shipment.status = "split"
+    return new_shipments
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_shipments.py b/tests/unit/test_shipments.py
--- a/tests/unit/test_shipments.py	2026-11-10 12:20:18
+++ b/tests/unit/test_shipments.py	2026-11-12 02:58:24
@@ -15,3 +15,49 @@
     with pytest.raises(DomainError) as err:
         shipments.create_shipment("nope", 1, "local")
     assert err.value.code == "E_UNKNOWN_CUSTOMER"
+
+
+def test_split_creates_one_shipment_per_weight():
+    c = customers.add_customer("Acme")
+    original = shipments.create_shipment(c.id, 10, "national")
+    parts = shipments.split_shipment(original.id, [4, 6])
+    assert [p.weight_kg for p in parts] == [4, 6]
+    assert all(p.customer_id == c.id and p.zone == "national" for p in parts)
+    assert all(p.status == "created" for p in parts)
+    assert shipments.get_shipment(original.id).status == "split"
+
+
+def test_split_unknown_shipment():
+    with pytest.raises(DomainError) as err:
+        shipments.split_shipment("shp_missing", [1])
+    assert err.value.code == "E_NOT_FOUND"
+
+
+def test_split_requires_created_status():
+    c = customers.add_customer("Acme")
+    original = shipments.create_shipment(c.id, 2, "local")
+    shipments.split_shipment(original.id, [1, 1])
+    with pytest.raises(DomainError) as err:
+        shipments.split_shipment(original.id, [1, 1])
+    assert err.value.code == "E_BAD_STATE"
+
+
+def test_split_weights_must_sum_to_original():
+    c = customers.add_customer("Acme")
+    original = shipments.create_shipment(c.id, 5, "local")
+    before = len(shipments.db.shipments)
+    with pytest.raises(DomainError) as err:
+        shipments.split_shipment(original.id, [2, 2])
+    assert err.value.code == "E_BAD_INPUT"
+    # Failed split must not change anything.
+    assert len(shipments.db.shipments) == before
+    assert shipments.get_shipment(original.id).status == "created"
+
+
+def test_split_rejects_non_positive_weight():
+    c = customers.add_customer("Acme")
+    original = shipments.create_shipment(c.id, 3, "local")
+    with pytest.raises(DomainError) as err:
+        shipments.split_shipment(original.id, [3, 0])
+    assert err.value.code == "E_BAD_WEIGHT"
+    assert shipments.get_shipment(original.id).status == "created"
