+++ b/tests/test_reports.py	2026-11-12 02:54:35
@@ -0,0 +1,44 @@
+from datetime import datetime, timedelta, timezone
+
+from parcelo import clock, reports
+from parcelo.models import Invoice
+from parcelo.store import db
+
+
+def _add(inv_id, amount, days_old, now, status="open"):
+    db.invoices[inv_id] = Invoice(
+        id=inv_id,
+        shipment_id="S",
+        amount=amount,
+        status=status,
+        issued_at=now - timedelta(days=days_old),
+    )
+
+
+def test_aging_report_buckets():
+    now = datetime(2026, 11, 12, 12, 0, tzinfo=timezone.utc)
+    clock.set_fixed(now)
+    _add("a", 10.0, 0, now)
+    _add("b", 20.0, 30, now)
+    _add("c", 5.5, 31, now)
+    _add("d", 7.0, 60, now)
+    _add("e", 3.0, 61, now)
+    _add("f", 100.0, 5, now, status="paid")
+    assert reports.aging_report() == {"0-30": 30.0, "31-60": 12.5, "60+": 3.0}
+
+
+def test_aging_report_empty_buckets_are_zero():
+    assert reports.aging_report() == {"0-30": 0.0, "31-60": 0.0, "60+": 0.0}
+
+
+def test_aging_report_handles_naive_issue_dates():
+    # issue_invoice() stores naive UTC timestamps
+    now = datetime(2026, 11, 12, 12, 0, tzinfo=timezone.utc)
+    clock.set_fixed(now)
+    db.invoices["n"] = Invoice(
+        id="n",
+        shipment_id="S",
+        amount=4.0,
+        issued_at=datetime(2026, 10, 1, 12, 0),
+    )
+    assert reports.aging_report() == {"0-30": 0.0, "31-60": 4.0, "60+": 0.0}
