-from datetime import datetime
+from datetime import datetime, timezone
 
+from parcelo import clock
+from parcelo.legacy.billing import days_between
 from parcelo.store import db
+
+
+def _as_naive_utc(moment):
+    """Invoices store naive UTC timestamps; clock.now() is timezone-aware.
+    Normalise both to naive UTC so they can be subtracted."""
+    if moment.tzinfo is not None:
+        return moment.astimezone(timezone.utc).replace(tzinfo=None)
+    return moment
+
+
+def aging_report():
+    """Total amount of open invoices per age bucket, by whole days since issue."""
+    now = _as_naive_utc(clock.now())
+    buckets = {"0-30": 0.0, "31-60": 0.0, "60+": 0.0}
+    for invoice in db.invoices.values():
+        if invoice.status != "open":
+            continue
+        age = days_between(_as_naive_utc(invoice.issued_at), end=now)
+        if 0 <= age <= 30:
+            buckets["0-30"] += invoice.amount
+        elif 31 <= age <= 60:
+            buckets["31-60"] += invoice.amount
+        elif age > 60:
+            buckets["60+"] += invoice.amount
+    return {key: round(total, 2) for key, total in buckets.items()}
 
 
