diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/test_returns.py b/tests/test_returns.py
--- a/tests/test_returns.py	1969-12-31 19:00:00
+++ b/tests/test_returns.py	2026-11-12 03:01:05
@@ -0,0 +1,55 @@
+import pytest
+
+from parcelo import returns, shipments
+from parcelo.customers import add_customer
+from parcelo.errors import DomainError
+from parcelo.store import db
+
+
+def _delivered_shipment():
+    customer = add_customer("Acme")
+    shipment = shipments.create_shipment(customer.id, 2.0, "local")
+    shipment.status = "delivered"
+    return shipment
+
+
+def test_request_return_saves_and_returns_request():
+    shipment = _delivered_shipment()
+    req = returns.request_return(shipment.id, "damaged")
+    assert req.shipment_id == shipment.id
+    assert req.reason == "damaged"
+    assert req.requested_at is not None
+    assert db.returns[req.id] is req
+    assert returns.returns_for(shipment.id) == [req]
+
+
+def test_unknown_shipment_fails():
+    with pytest.raises(DomainError) as exc:
+        returns.request_return("shp_missing", "x")
+    assert exc.value.code == "E_NOT_FOUND"
+
+
+def test_undelivered_shipment_cannot_be_returned():
+    customer = add_customer("Acme")
+    shipment = shipments.create_shipment(customer.id, 2.0, "local")
+    with pytest.raises(DomainError) as exc:
+        returns.request_return(shipment.id, "x")
+    assert exc.value.code == "E_BAD_STATE"
+    assert returns.returns_for(shipment.id) == []
+
+
+def test_fourth_return_request_fails():
+    shipment = _delivered_shipment()
+    for i in range(3):
+        returns.request_return(shipment.id, f"r{i}")
+    with pytest.raises(DomainError) as exc:
+        returns.request_return(shipment.id, "r3")
+    assert exc.value.code == "E_LIMIT"
+    assert len(returns.returns_for(shipment.id)) == 3
+
+
+def test_returns_are_scoped_to_shipment():
+    a = _delivered_shipment()
+    b = _delivered_shipment()
+    returns.request_return(a.id, "one")
+    assert returns.returns_for(b.id) == []
