diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/parcelo/vouchers.py b/parcelo/vouchers.py
--- a/parcelo/vouchers.py	1969-12-31 19:00:00
+++ b/parcelo/vouchers.py	2026-11-12 03:02:58
@@ -0,0 +1,23 @@
+from parcelo import clock, ids
+from parcelo.errors import DomainError
+from parcelo.models import Voucher
+from parcelo.store import db
+
+MAX_VOUCHER_AMOUNT = 150.00
+
+
+def issue_voucher(customer_id, amount):
+    if customer_id not in db.customers:
+        raise DomainError("E_UNKNOWN_CUSTOMER", customer_id)
+    if amount <= 0:
+        raise DomainError("E_BAD_INPUT", str(amount))
+    if amount > MAX_VOUCHER_AMOUNT:
+        raise DomainError("E_LIMIT", str(amount))
+    voucher = Voucher(
+        id=ids.new_id("vch"),
+        customer_id=customer_id,
+        amount=amount,
+        issued_at=clock.now(),
+    )
+    db.vouchers[voucher.id] = voucher
+    return voucher
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_vouchers.py b/tests/unit/test_vouchers.py
--- a/tests/unit/test_vouchers.py	1969-12-31 19:00:00
+++ b/tests/unit/test_vouchers.py	2026-11-12 03:02:59
@@ -0,0 +1,36 @@
+import pytest
+
+from parcelo import customers, vouchers
+from parcelo.errors import DomainError
+from parcelo.store import db
+
+
+def test_issue_voucher():
+    c = customers.add_customer("Acme")
+    v = vouchers.issue_voucher(c.id, 25.5)
+    assert v.id.startswith("vch_")
+    assert v.customer_id == c.id
+    assert v.amount == 25.5
+    assert v.issued_at is not None
+    assert db.vouchers[v.id] is v
+
+
+def test_max_amount_allowed():
+    c = customers.add_customer("Acme")
+    assert vouchers.issue_voucher(c.id, 150).amount == 150
+
+
+@pytest.mark.parametrize("amount,code", [(150.01, "E_LIMIT"), (0, "E_BAD_INPUT"), (-5, "E_BAD_INPUT")])
+def test_bad_amounts_rejected(amount, code):
+    c = customers.add_customer("Acme")
+    with pytest.raises(DomainError) as err:
+        vouchers.issue_voucher(c.id, amount)
+    assert err.value.code == code
+    assert db.vouchers == {}
+
+
+def test_unknown_customer():
+    with pytest.raises(DomainError) as err:
+        vouchers.issue_voucher("nope", 10)
+    assert err.value.code == "E_UNKNOWN_CUSTOMER"
+    assert db.vouchers == {}
