diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_customer_upgrade.py b/tests/unit/test_customer_upgrade.py
--- a/tests/unit/test_customer_upgrade.py	1969-12-31 19:00:00
+++ b/tests/unit/test_customer_upgrade.py	2026-11-12 03:02:35
@@ -0,0 +1,96 @@
+from datetime import datetime, timezone
+
+import pytest
+
+from parcelo import audit, clock, customers, events, ids, store
+from parcelo.errors import DomainError
+
+
+@pytest.fixture(autouse=True)
+def clean_state():
+    store.reset()
+    ids.reset()
+    audit.LOG.clear()
+    events.OUTBOX.clear()
+    clock.clear_fixed()
+    yield
+    store.reset()
+    ids.reset()
+    audit.LOG.clear()
+    events.OUTBOX.clear()
+    clock.clear_fixed()
+
+
+def make_standard_customer(name="Acme"):
+    return customers.add_customer(name)
+
+
+def test_upgrade_standard_to_gold_returns_customer():
+    c = make_standard_customer()
+    result = customers.upgrade_tier(c.id)
+    assert result is c
+    assert result.id == c.id
+    assert result.name == "Acme"
+    assert result.tier == "gold"
+    assert customers.get_customer(c.id).tier == "gold"
+
+
+def test_upgrade_emits_event():
+    c = make_standard_customer()
+    customers.upgrade_tier(c.id)
+    assert len(events.OUTBOX) == 1
+    assert events.OUTBOX[-1]["name"] == "customer.upgraded"
+    assert events.OUTBOX[-1]["entity_id"] == c.id
+    assert events.OUTBOX[-1]["payload"] == {"tier": "gold"}
+
+
+def test_upgrade_records_audit_entry():
+    clock.set_fixed(datetime(2026, 11, 12, 9, 0, tzinfo=timezone.utc))
+    c = make_standard_customer()
+    customers.upgrade_tier(c.id)
+    assert len(audit.LOG) == 1
+    entry = audit.LOG[-1]
+    assert entry["action"] == "customer.upgrade"
+    assert entry["entity_id"] == c.id
+    assert entry["at"] == datetime(2026, 11, 12, 9, 0, tzinfo=timezone.utc)
+    assert entry["details"] == {"from_tier": "standard", "to_tier": "gold"}
+
+
+@pytest.mark.parametrize("bad_id", ["", None, "nope"])
+def test_unknown_customer_fails_and_changes_nothing(bad_id):
+    make_standard_customer()
+    before_customers = {k: dict(v.__dict__) for k, v in store.db.customers.items()}
+    audit_len = len(audit.LOG)
+    events_len = len(events.OUTBOX)
+
+    with pytest.raises(DomainError) as err:
+        customers.upgrade_tier(bad_id)
+
+    assert err.value.code == "E_NOT_FOUND"
+    assert {k: dict(v.__dict__) for k, v in store.db.customers.items()} == before_customers
+    assert len(audit.LOG) == audit_len
+    assert len(events.OUTBOX) == events_len
+
+
+def test_already_gold_fails_and_changes_nothing():
+    c = make_standard_customer()
+    customers.upgrade_tier(c.id)
+    before = dict(c.__dict__)
+    audit_len = len(audit.LOG)
+    events_len = len(events.OUTBOX)
+
+    with pytest.raises(DomainError) as err:
+        customers.upgrade_tier(c.id)
+
+    assert err.value.code == "E_BAD_STATE"
+    assert dict(customers.get_customer(c.id).__dict__) == before
+    assert len(audit.LOG) == audit_len
+    assert len(events.OUTBOX) == events_len
+
+
+def test_second_upgrade_fails_with_bad_state():
+    c = make_standard_customer()
+    customers.upgrade_tier(c.id)
+    with pytest.raises(DomainError) as err:
+        customers.upgrade_tier(c.id)
+    assert err.value.code == "E_BAD_STATE"
