+def discounted_quote(weight_kg, zone, tier):
+    if tier not in TIER_DISCOUNT_PCT:
+        raise ValueError("unknown tier: %s" % tier)
+    amount = apply_discount(quote(weight_kg, zone), TIER_DISCOUNT_PCT[tier])
+    return Money.parse(amount)
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_discounted_quote.py b/tests/unit/test_discounted_quote.py
--- a/tests/unit/test_discounted_quote.py	1969-12-31 19:00:00
+++ b/tests/unit/test_discounted_quote.py	2026-11-12 02:55:04
@@ -0,0 +1,44 @@
+import pytest
+
+from parcelo import audit, ids, rates, store
+from parcelo.money import Money
+
+
+@pytest.fixture(autouse=True)
+def clean_state():
+    store.reset()
+    ids.reset()
+    audit.LOG.clear()
+    yield
+
+
+def test_gold_gets_ten_percent_off():
+    # quote(2, "local") is 7.00; 10% off is 6.30
+    assert rates.discounted_quote(2, "local", "gold") == Money(630)
+
+
+def test_standard_has_no_discount():
+    assert rates.discounted_quote(2, "local", "standard") == Money(700)
+
+
+def test_returns_money_not_float():
+    result = rates.discounted_quote(2, "local", "gold")
+    assert isinstance(result, Money)
+
+
+@pytest.mark.parametrize("zone", ["moon", "", None])
+def test_unknown_zone_fails(zone):
+    with pytest.raises(ValueError):
+        rates.discounted_quote(2, zone, "gold")
+
+
+@pytest.mark.parametrize("tier", ["platinum", "", None])
+def test_unknown_tier_fails(tier):
+    with pytest.raises(ValueError):
+        rates.discounted_quote(2, "local", tier)
+
+
+@pytest.mark.parametrize("weight", [0, -1])
+def test_non_positive_weight_fails(weight):
+    with pytest.raises(ValueError):
+        rates.discounted_quote(weight, "local", "gold")
