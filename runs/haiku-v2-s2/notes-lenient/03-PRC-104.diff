diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_customer_deactivate.py b/tests/unit/test_customer_deactivate.py
--- a/tests/unit/test_customer_deactivate.py	1969-12-31 19:00:00
+++ b/tests/unit/test_customer_deactivate.py	2026-11-12 02:50:31
@@ -0,0 +1,34 @@
+import pytest
+
+from parcelo import audit, customers
+from parcelo.errors import DomainError
+
+
+def test_deactivate_sets_inactive_and_returns_customer():
+    c = customers.add_customer("Acme")
+    assert c.active is True
+    result = customers.deactivate_customer(c.id)
+    assert result is c
+    assert result.active is False
+    assert customers.get_customer(c.id).active is False
+
+
+def test_deactivate_records_audit():
+    c = customers.add_customer("Acme")
+    customers.deactivate_customer(c.id)
+    assert audit.LOG[-1]["action"] == "customer.deactivated"
+    assert audit.LOG[-1]["entity_id"] == c.id
+
+
+def test_deactivate_not_found():
+    with pytest.raises(DomainError) as err:
+        customers.deactivate_customer("C_missing")
+    assert err.value.code == "E_NOT_FOUND"
+
+
+def test_deactivate_already_inactive():
+    c = customers.add_customer("Acme")
+    customers.deactivate_customer(c.id)
+    with pytest.raises(DomainError) as err:
+        customers.deactivate_customer(c.id)
+    assert err.value.code == "E_BAD_STATE"
