@@ -0,0 +1,29 @@
+import math
+
+from parcelo import audit, clock, events, ids
+from parcelo.errors import DomainError
+from parcelo.models import Voucher
+from parcelo.settings import MAX_VOUCHER_AMOUNT
+from parcelo.store import db
+
+
+def issue_voucher(customer_id, amount):
+    """Issue a goodwill voucher. Not idempotent: every call creates a new voucher."""
+    if customer_id not in db.customers:
+        raise DomainError("E_UNKNOWN_CUSTOMER", str(customer_id))
+    if isinstance(amount, bool) or not isinstance(amount, (int, float)) or not math.isfinite(amount):
+        raise DomainError("E_BAD_INPUT", repr(amount))
+    if amount <= 0:
+        raise DomainError("E_BAD_INPUT", str(amount))
+    if amount > MAX_VOUCHER_AMOUNT:
+        raise DomainError("E_LIMIT", str(amount))
+    voucher = Voucher(
+        id=ids.new_id("vch"),
+        customer_id=customer_id,
+        amount=amount,
+        issued_at=clock.now(),
+    )
+    db.vouchers[voucher.id] = voucher
+    audit.record("voucher.issued", voucher.id, customer_id=customer_id, amount=amount)
+    events.emit("voucher.issued", voucher.id, customer_id=customer_id, amount=amount)
+    return voucher
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_vouchers.py b/tests/unit/test_vouchers.py
--- a/tests/unit/test_vouchers.py	1969-12-31 19:00:00
+++ b/tests/unit/test_vouchers.py	2026-11-12 03:16:50
@@ -0,0 +1,52 @@
+import pytest
+
+from parcelo import audit, customers, events, vouchers
+from parcelo.errors import DomainError
+from parcelo.settings import MAX_VOUCHER_AMOUNT
+from parcelo.store import db
+
+
+def test_issue_voucher_stores_and_records():
+    c = customers.add_customer("Acme")
+    v = vouchers.issue_voucher(c.id, 25.0)
+    assert v.id.startswith("vch_")
+    assert v.customer_id == c.id
+    assert v.amount == 25.0
+    assert v.issued_at is not None
+    assert db.vouchers[v.id] is v
+    assert audit.LOG[-1]["action"] == "voucher.issued"
+    assert events.OUTBOX[-1]["name"] == "voucher.issued"
+
+
+def test_amount_at_limit_is_allowed():
+    c = customers.add_customer("Acme")
+    v = vouchers.issue_voucher(c.id, MAX_VOUCHER_AMOUNT)
+    assert v.amount == MAX_VOUCHER_AMOUNT
+
+
+def test_amount_over_limit_rejected_and_nothing_changes():
+    c = customers.add_customer("Acme")
+    with pytest.raises(DomainError) as err:
+        vouchers.issue_voucher(c.id, MAX_VOUCHER_AMOUNT + 0.01)
+    assert err.value.code == "E_LIMIT"
+    assert db.vouchers == {}
+    assert audit.LOG == []
+    assert events.OUTBOX == []
+
+
+def test_unknown_customer_rejected():
+    with pytest.raises(DomainError) as err:
+        vouchers.issue_voucher("nope", 10)
+    assert err.value.code == "E_UNKNOWN_CUSTOMER"
+    assert db.vouchers == {}
+
+
+@pytest.mark.parametrize("amount", [0, -5, -0.01, True, None, "10", float("nan"), float("inf")])
+def test_bad_amount_rejected(amount):
+    c = customers.add_customer("Acme")
+    with pytest.raises(DomainError) as err:
+        vouchers.issue_voucher(c.id, amount)
+    assert err.value.code == "E_BAD_INPUT"
+    assert db.vouchers == {}
+    assert audit.LOG == []
+    assert events.OUTBOX == []
