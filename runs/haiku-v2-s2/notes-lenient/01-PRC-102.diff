diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_invoice_void.py b/tests/unit/test_invoice_void.py
--- a/tests/unit/test_invoice_void.py	1969-12-31 19:00:00
+++ b/tests/unit/test_invoice_void.py	2026-11-12 02:48:47
@@ -0,0 +1,46 @@
+from datetime import datetime, timezone
+
+import pytest
+
+from parcelo import audit, clock, customers, invoices, shipments
+from parcelo.errors import DomainError
+
+
+def _issued_invoice():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 2, "local")
+    return invoices.issue_invoice(s.id)
+
+
+def test_void_sets_status_and_timestamp():
+    moment = datetime(2026, 11, 12, 10, 0, tzinfo=timezone.utc)
+    clock.set_fixed(moment)
+    inv = _issued_invoice()
+    result = invoices.void_invoice(inv.id)
+    assert result is inv
+    assert inv.status == "void"
+    assert inv.voided_at == moment
+    assert audit.LOG[-1]["action"] == "invoice.voided"
+
+
+def test_void_not_found():
+    with pytest.raises(DomainError) as err:
+        invoices.void_invoice("INV-missing")
+    assert err.value.code == "E_NOT_FOUND"
+
+
+def test_void_already_paid():
+    inv = _issued_invoice()
+    invoices.mark_paid(inv.id)
+    with pytest.raises(DomainError) as err:
+        invoices.void_invoice(inv.id)
+    assert err.value.code == "E_BAD_STATE"
+    assert inv.status == "paid"
+
+
+def test_void_already_void():
+    inv = _issued_invoice()
+    invoices.void_invoice(inv.id)
+    with pytest.raises(DomainError) as err:
+        invoices.void_invoice(inv.id)
+    assert err.value.code == "E_BAD_STATE"
