+
+def heavy_quote(weight_kg, zone):
+    """Normal quote plus 0.75 per kg above 30 kg, returned as Money."""
+    if not isinstance(zone, str) or zone not in ZONE_BASE:
+        raise DomainError("E_BAD_ZONE", str(zone))
+    if isinstance(weight_kg, bool) or not isinstance(weight_kg, (int, float)):
+        raise DomainError("E_BAD_WEIGHT", str(weight_kg))
+    if isinstance(weight_kg, float) and not math.isfinite(weight_kg):
+        raise DomainError("E_BAD_WEIGHT", str(weight_kg))
+    if weight_kg <= 0:
+        raise DomainError("E_BAD_WEIGHT", str(weight_kg))
+
+    total = Money.parse(quote(weight_kg, zone))
+    if weight_kg <= HEAVY_LIMIT_KG:
+        return total
+    excess_kg = Decimal(str(weight_kg)) - Decimal(HEAVY_LIMIT_KG)
+    return total + HEAVY_SURCHARGE_PER_KG.scale(excess_kg)
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_heavy_quote.py b/tests/unit/test_heavy_quote.py
--- a/tests/unit/test_heavy_quote.py	1969-12-31 19:00:00
+++ b/tests/unit/test_heavy_quote.py	2026-11-12 03:10:33
@@ -0,0 +1,80 @@
+import pytest
+
+from parcelo import audit, customers, events, rates, shipments, store
+from parcelo.errors import DomainError
+from parcelo.money import Money
+
+
+def snapshot():
+    return (
+        dict(store.db.customers),
+        dict(store.db.shipments),
+        len(audit.LOG),
+        len(events.OUTBOX),
+    )
+
+
+def test_at_limit_has_no_surcharge():
+    assert rates.heavy_quote(30, "local") == Money.parse(rates.quote(30, "local"))
+
+
+def test_just_below_limit_has_no_surcharge():
+    assert rates.heavy_quote(29.99, "national") == Money.parse(rates.quote(29.99, "national"))
+
+
+def test_one_cent_past_limit_is_over():
+    # 0.01 kg * 0.75 = 0.75 cents, rounded half up to 1 cent
+    base = Money.parse(rates.quote(30.01, "local"))
+    assert rates.heavy_quote(30.01, "local") == base + Money(1)
+
+
+def test_whole_kg_over_limit():
+    # local: 4.5 + 1.25 * 32 = 44.50; surcharge 2 kg * 0.75 = 1.50
+    assert rates.heavy_quote(32, "local") == Money(4600)
+
+
+def test_returns_money():
+    assert isinstance(rates.heavy_quote(40, "international"), Money)
+
+
+def test_zone_is_checked_before_weight():
+    with pytest.raises(DomainError) as err:
+        rates.heavy_quote(-1, "moon")
+    assert err.value.code == "E_BAD_ZONE"
+
+
+@pytest.mark.parametrize("zone", ["", " ", "Local", "moon", None, 3, ["local"]])
+def test_unknown_zone_fails(zone):
+    with pytest.raises(DomainError) as err:
+        rates.heavy_quote(10, zone)
+    assert err.value.code == "E_BAD_ZONE"
+
+
+@pytest.mark.parametrize(
+    "weight",
+    [0, -0.01, -1, None, True, False, "5", "", "nan", float("nan"), float("inf"), float("-inf")],
+)
+def test_bad_weight_fails(weight):
+    with pytest.raises(DomainError) as err:
+        rates.heavy_quote(weight, "local")
+    assert err.value.code == "E_BAD_WEIGHT"
+
+
+def test_read_only_leaves_state_unchanged():
+    c = customers.add_customer("Acme")
+    shipments.create_shipment(c.id, 35, "local")
+    before = snapshot()
+    rates.heavy_quote(45, "national")
+    assert snapshot() == before
+
+
+def test_failed_call_leaves_state_unchanged():
+    before = snapshot()
+    with pytest.raises(DomainError):
+        rates.heavy_quote(45, "moon")
+    assert snapshot() == before
+
+
+def test_empty_store_works():
+    # local: 4.5 + 1.25 * 31 = 43.25; surcharge 1 kg * 0.75 = 0.75
+    assert rates.heavy_quote(31, "local") == Money(4400)
