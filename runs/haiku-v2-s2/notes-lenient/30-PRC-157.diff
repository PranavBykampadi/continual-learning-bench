diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_invoice_hold.py b/tests/unit/test_invoice_hold.py
--- a/tests/unit/test_invoice_hold.py	1969-12-31 19:00:00
+++ b/tests/unit/test_invoice_hold.py	2026-11-12 03:11:40
@@ -0,0 +1,99 @@
+import copy
+from datetime import datetime, timezone
+
+import pytest
+
+from parcelo import audit, clock, customers, events, ids, invoices, shipments, store
+from parcelo.errors import DomainError
+
+
+@pytest.fixture(autouse=True)
+def clean_state():
+    store.reset()
+    ids.reset()
+    audit.LOG.clear()
+    events.OUTBOX.clear()
+    clock.clear_fixed()
+    yield
+    store.reset()
+    ids.reset()
+    audit.LOG.clear()
+    events.OUTBOX.clear()
+    clock.clear_fixed()
+
+
+def _open_invoice():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 2, "local")
+    return invoices.issue_invoice(s.id)
+
+
+def _snapshot():
+    return (
+        copy.deepcopy(store.db.customers),
+        copy.deepcopy(store.db.shipments),
+        copy.deepcopy(store.db.invoices),
+        len(audit.LOG),
+        copy.deepcopy(events.OUTBOX),
+    )
+
+
+HELD_AT = datetime(2026, 11, 12, 9, 0, tzinfo=timezone.utc)
+
+
+def test_hold_sets_status_and_time():
+    clock.set_fixed(HELD_AT)
+    inv = _open_invoice()
+    result = invoices.hold_invoice(inv.id)
+    assert result is inv
+    assert inv.status == "on_hold"
+    assert inv.held_at == HELD_AT
+
+
+def test_hold_emits_event():
+    inv = _open_invoice()
+    invoices.hold_invoice(inv.id)
+    last = events.OUTBOX[-1]
+    assert last["name"] == "invoice.held"
+    assert last["entity_id"] == inv.id
+    assert last["payload"] == {"status": "on_hold"}
+
+
+def test_paid_invoice_cannot_be_held():
+    inv = _open_invoice()
+    invoices.mark_paid(inv.id)
+    before = _snapshot()
+    with pytest.raises(DomainError) as err:
+        invoices.hold_invoice(inv.id)
+    assert err.value.code == "E_BAD_STATE"
+    assert inv.status == "paid"
+    assert inv.held_at is None
+    assert _snapshot() == before
+
+
+@pytest.mark.parametrize(
+    "bad_id",
+    ["", "   ", "INV-nope", None, 0, 42, ["INV-x"]],
+)
+def test_unknown_or_invalid_id_is_not_found(bad_id):
+    _open_invoice()
+    before = _snapshot()
+    with pytest.raises(DomainError) as err:
+        invoices.hold_invoice(bad_id)
+    assert err.value.code == "E_NOT_FOUND"
+    assert _snapshot() == before
+
+
+def test_repeat_hold_is_a_noop():
+    clock.set_fixed(HELD_AT)
+    inv = _open_invoice()
+    invoices.hold_invoice(inv.id)
+    before = _snapshot()
+
+    clock.set_fixed(datetime(2026, 11, 13, 9, 0, tzinfo=timezone.utc))
+    result = invoices.hold_invoice(inv.id)
+
+    assert result is inv
+    assert inv.status == "on_hold"
+    assert inv.held_at == HELD_AT
+    assert _snapshot() == before
