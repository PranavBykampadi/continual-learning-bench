 def open_invoices():
     return [i for i in db.invoices.values() if i.status == "open"]
+
+
+def hold_invoice(invoice_id):
+    """Pause collection on an open invoice. Repeating the call on a held invoice is a no-op."""
+    if not isinstance(invoice_id, str) or invoice_id not in db.invoices:
+        raise DomainError("E_NOT_FOUND", str(invoice_id))
+    invoice = db.invoices[invoice_id]
+    if invoice.status == "on_hold":
+        return invoice
+    if invoice.status != "open":
+        raise DomainError("E_BAD_STATE", invoice.status)
+    invoice.status = "on_hold"
+    invoice.held_at = clock.now()
+    events.emit("invoice.held", invoice_id, status="on_hold")
+    return invoice
