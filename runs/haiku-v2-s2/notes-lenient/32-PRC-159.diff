     if shipment_id not in db.shipments:
         raise DomainError("E_NOT_FOUND", shipment_id)
     return db.shipments[shipment_id]
+
+
+def shipments_in_zone(zone):
+    # Type check first: unhashable inputs would otherwise fail the dict lookup.
+    if not isinstance(zone, str) or zone not in ZONE_BASE:
+        raise DomainError("E_BAD_ZONE", str(zone))
+    return [s for s in db.shipments.values() if s.zone == zone]
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_shipments_in_zone.py b/tests/unit/test_shipments_in_zone.py
--- a/tests/unit/test_shipments_in_zone.py	1969-12-31 19:00:00
+++ b/tests/unit/test_shipments_in_zone.py	2026-11-12 03:13:10
@@ -0,0 +1,94 @@
+import copy
+
+import pytest
+
+from parcelo import audit, clock, customers, events, ids, shipments, store
+from parcelo.errors import DomainError
+from parcelo.rates import ZONE_BASE
+
+
+@pytest.fixture(autouse=True)
+def clean_state():
+    store.reset()
+    ids.reset()
+    audit.LOG.clear()
+    events.OUTBOX.clear()
+    clock.clear_fixed()
+    yield
+    store.reset()
+    ids.reset()
+    audit.LOG.clear()
+    events.OUTBOX.clear()
+    clock.clear_fixed()
+
+
+def _snapshot():
+    collections = {name: copy.deepcopy(getattr(store.db, name)) for name in vars(store.db)}
+    return (collections, len(audit.LOG), copy.deepcopy(events.OUTBOX))
+
+
+def _new_customer():
+    return customers.add_customer("Acme")
+
+
+def test_empty_store_returns_empty_list():
+    assert shipments.shipments_in_zone("local") == []
+
+
+def test_zone_with_no_shipments_returns_empty_list():
+    c = _new_customer()
+    shipments.create_shipment(c.id, 1.0, "local")
+    assert shipments.shipments_in_zone("international") == []
+
+
+def test_returns_only_matching_zone():
+    c = _new_customer()
+    a = shipments.create_shipment(c.id, 1.0, "local")
+    b = shipments.create_shipment(c.id, 2.0, "national")
+    d = shipments.create_shipment(c.id, 3.0, "local")
+    result = shipments.shipments_in_zone("local")
+    assert [s.id for s in result] == [a.id, d.id]
+    assert all(s.zone == "local" for s in result)
+    assert b.id not in [s.id for s in result]
+
+
+@pytest.mark.parametrize("zone", sorted(ZONE_BASE))
+def test_every_known_zone_is_accepted(zone):
+    assert shipments.shipments_in_zone(zone) == []
+
+
+@pytest.mark.parametrize(
+    "zone",
+    ["", "   ", "Local", "LOCAL", "mars", " local", None, 5, True, float("nan"), ["local"], {"local": 1}],
+)
+def test_unknown_or_invalid_zone_raises(zone):
+    c = _new_customer()
+    shipments.create_shipment(c.id, 1.0, "local")
+    with pytest.raises(DomainError) as err:
+        shipments.shipments_in_zone(zone)
+    assert err.value.code == "E_BAD_ZONE"
+
+
+def test_invalid_zone_does_not_modify_state():
+    c = _new_customer()
+    shipments.create_shipment(c.id, 1.0, "local")
+    before = _snapshot()
+    with pytest.raises(DomainError):
+        shipments.shipments_in_zone("mars")
+    assert _snapshot() == before
+
+
+def test_read_only_call_does_not_modify_state():
+    c = _new_customer()
+    shipments.create_shipment(c.id, 1.0, "local")
+    shipments.create_shipment(c.id, 2.0, "national")
+    before = _snapshot()
+    shipments.shipments_in_zone("local")
+    shipments.shipments_in_zone("international")
+    assert _snapshot() == before
+
+
+def test_read_only_call_on_empty_store_does_not_modify_state():
+    before = _snapshot()
+    shipments.shipments_in_zone("local")
+    assert _snapshot() == before
