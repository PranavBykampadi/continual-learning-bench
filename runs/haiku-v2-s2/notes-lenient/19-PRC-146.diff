+import copy
+from datetime import datetime, timezone
+
+import pytest
+
+from parcelo import audit, clock, customers, events, invoices, shipments, store
+from parcelo.errors import DomainError
+from parcelo.money import Money
+
+
+@pytest.fixture(autouse=True)
+def clean_state():
+    store.reset()
+    audit.LOG.clear()
+    events.OUTBOX.clear()
+    clock.clear_fixed()
+    yield
+    store.reset()
+    audit.LOG.clear()
+    events.OUTBOX.clear()
+    clock.clear_fixed()
+
+
+FIXED = datetime(2026, 11, 12, 9, 30, tzinfo=timezone.utc)
+
+
+def make_open_invoice():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 2, "local")
+    return invoices.issue_invoice(s.id)
+
+
+def test_write_off_sets_status_and_timestamp():
+    clock.set_fixed(FIXED)
+    inv = make_open_invoice()
+    invoices.write_off(inv.id)
+    assert inv.status == "written_off"
+    assert inv.written_off_at == FIXED
+
+
+def test_write_off_returns_money_amount():
+    inv = make_open_invoice()
+    result = invoices.write_off(inv.id)
+    assert isinstance(result, Money)
+    assert result == Money.parse(7.0)
+    assert result.cents == 700
+
+
+def test_write_off_emits_event():
+    inv = make_open_invoice()
+    events.OUTBOX.clear()
+    invoices.write_off(inv.id)
+    assert len(events.OUTBOX) == 1
+    event = events.OUTBOX[-1]
+    assert event["name"] == "invoice.written_off"
+    assert event["entity_id"] == inv.id
+    assert event["payload"] == {"amount": Money.parse(7.0)}
+
+
+def test_write_off_records_audit_entry():
+    clock.set_fixed(FIXED)
+    inv = make_open_invoice()
+    audit.LOG.clear()
+    invoices.write_off(inv.id)
+    assert len(audit.LOG) == 1
+    entry = audit.LOG[-1]
+    assert entry["action"] == "invoice.write_off"
+    assert entry["entity_id"] == inv.id
+    assert entry["at"] == FIXED
+    assert entry["details"] == {"amount": Money.parse(7.0)}
+
+
+def test_second_write_off_fails_with_bad_state():
+    inv = make_open_invoice()
+    invoices.write_off(inv.id)
+    with pytest.raises(DomainError) as err:
+        invoices.write_off(inv.id)
+    assert err.value.code == "E_BAD_STATE"
+
+
+def test_paid_invoice_cannot_be_written_off():
+    inv = make_open_invoice()
+    invoices.mark_paid(inv.id)
+    before = copy.copy(inv.__dict__)
+    audit_len = len(audit.LOG)
+    events_len = len(events.OUTBOX)
+    with pytest.raises(DomainError) as err:
+        invoices.write_off(inv.id)
+    assert err.value.code == "E_BAD_STATE"
+    assert inv.__dict__ == before
+    assert len(audit.LOG) == audit_len
+    assert len(events.OUTBOX) == events_len
+
+
+@pytest.mark.parametrize("bad_id", ["", None, "INV-nope"])
+def test_unknown_invoice_id_fails_not_found(bad_id):
+    inv = make_open_invoice()
+    before = dict(store.db.invoices)
+    audit_len = len(audit.LOG)
+    events_len = len(events.OUTBOX)
+    with pytest.raises(DomainError) as err:
+        invoices.write_off(bad_id)
+    assert err.value.code == "E_NOT_FOUND"
+    assert store.db.invoices == before
+    assert store.db.invoices[inv.id].status == "open"
+    assert len(audit.LOG) == audit_len
+    assert len(events.OUTBOX) == events_len
+
+
