diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_customers.py b/tests/unit/test_customers.py
--- a/tests/unit/test_customers.py	1969-12-31 19:00:00
+++ b/tests/unit/test_customers.py	2026-11-12 03:09:42
@@ -0,0 +1,92 @@
+import pytest
+
+from parcelo import audit, clock, customers, events, ids, store
+from parcelo.customers import TIERS, customers_by_tier
+
+
+@pytest.fixture(autouse=True)
+def clean_state():
+    store.reset()
+    ids.reset()
+    audit.LOG.clear()
+    events.OUTBOX.clear()
+    clock.clear_fixed()
+    yield
+    store.reset()
+    ids.reset()
+    audit.LOG.clear()
+    events.OUTBOX.clear()
+    clock.clear_fixed()
+
+
+def _snapshot():
+    return (
+        dict(store.db.customers),
+        dict(store.db.shipments),
+        dict(store.db.invoices),
+        len(audit.LOG),
+        len(events.OUTBOX),
+    )
+
+
+def test_returns_only_customers_on_tier():
+    std = customers.add_customer("Acme", tier="standard")
+    gold = customers.add_customer("Globex", tier="gold")
+    result = customers_by_tier("gold")
+    assert result == [gold]
+    assert std not in result
+
+
+def test_returns_all_matching_customers():
+    a = customers.add_customer("A", tier="gold")
+    b = customers.add_customer("B", tier="gold")
+    customers.add_customer("C", tier="standard")
+    assert customers_by_tier("gold") == [a, b]
+
+
+def test_empty_store_returns_empty_list():
+    assert customers_by_tier("standard") == []
+
+
+def test_no_customers_on_known_tier_returns_empty_list():
+    customers.add_customer("Acme", tier="standard")
+    assert customers_by_tier("gold") == []
+
+
+def test_returns_a_new_list_each_call():
+    customers.add_customer("A", tier="gold")
+    first = customers_by_tier("gold")
+    first.clear()
+    assert len(customers_by_tier("gold")) == 1
+
+
+@pytest.mark.parametrize("tier", TIERS)
+def test_every_known_tier_is_accepted(tier):
+    assert customers_by_tier(tier) == []
+
+
+@pytest.mark.parametrize(
+    "tier",
+    ["", " ", "Gold", " gold", "platinum", None, True, False, 0, 1, float("nan"), [], {}],
+)
+def test_unknown_or_invalid_tier_raises(tier):
+    customers.add_customer("A", tier="standard")
+    before = _snapshot()
+    with pytest.raises(ValueError):
+        customers_by_tier(tier)
+    assert _snapshot() == before
+
+
+def test_read_only_does_not_modify_records_or_outbox():
+    customers.add_customer("A", tier="gold")
+    customers.add_customer("B", tier="standard")
+    before = _snapshot()
+    customers_by_tier("gold")
+    customers_by_tier("standard")
+    assert _snapshot() == before
+
+
+def test_read_only_on_empty_store_does_not_modify_state():
+    before = _snapshot()
+    assert customers_by_tier("gold") == []
+    assert _snapshot() == before
