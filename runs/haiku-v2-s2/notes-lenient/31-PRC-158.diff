@@ -0,0 +1,141 @@
+import copy
+from datetime import datetime, timezone
+
+import pytest
+
+from parcelo import audit, clock, customers, events, returns, shipments, store
+from parcelo.errors import DomainError
+from parcelo.models import ReturnRequest
+
+FIXED = datetime(2026, 11, 1, 9, 30, tzinfo=timezone.utc)
+
+
+def _delivered_shipment():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 1.5, "national")
+    s.status = "delivered"  # no public delivery transition exists yet
+    return s
+
+
+def _snapshot():
+    return (
+        copy.deepcopy(
+            (
+                store.db.customers,
+                store.db.shipments,
+                store.db.invoices,
+                store.db.returns,
+            )
+        ),
+        len(audit.LOG),
+        copy.deepcopy(events.OUTBOX),
+    )
+
+
+def test_request_return_creates_and_stores_record():
+    clock.set_fixed(FIXED)
+    s = _delivered_shipment()
+    r = returns.request_return(s.id, "damaged")
+    assert isinstance(r, ReturnRequest)
+    assert r.id.startswith("ret_")
+    assert r.shipment_id == s.id
+    assert r.reason == "damaged"
+    assert r.requested_at == FIXED
+    assert store.db.returns[r.id] is r
+
+
+def test_request_return_emits_event():
+    s = _delivered_shipment()
+    r = returns.request_return(s.id, "wrong item")
+    assert events.OUTBOX[-1]["name"] == "return.requested"
+    assert events.OUTBOX[-1]["entity_id"] == r.id
+    assert events.OUTBOX[-1]["payload"] == {"shipment_id": s.id, "reason": "wrong item"}
+
+
+def test_returns_for_lists_only_that_shipments_requests_in_order():
+    s1 = _delivered_shipment()
+    s2 = _delivered_shipment()
+    a = returns.request_return(s1.id, "first")
+    returns.request_return(s2.id, "other")
+    b = returns.request_return(s1.id, "second")
+    assert returns.returns_for(s1.id) == [a, b]
+
+
+def test_reset_clears_returns():
+    s = _delivered_shipment()
+    returns.request_return(s.id, "damaged")
+    store.reset()
+    assert store.db.returns == {}
+
+
+@pytest.mark.parametrize("reason", ["", "   ", "\t\n", None, 5, 1.5, b"bytes", ["a"]])
+def test_invalid_reason_rejected_without_changes(reason):
+    s = _delivered_shipment()
+    before = _snapshot()
+    with pytest.raises(DomainError) as err:
+        returns.request_return(s.id, reason)
+    assert err.value.code == "E_BAD_INPUT"
+    assert _snapshot() == before
+
+
+def test_unknown_shipment_rejected_without_changes():
+    before = _snapshot()
+  