diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_customer_lock.py b/tests/unit/test_customer_lock.py
--- a/tests/unit/test_customer_lock.py	1969-12-31 19:00:00
+++ b/tests/unit/test_customer_lock.py	2026-11-12 03:16:03
@@ -0,0 +1,63 @@
+import pytest
+
+from parcelo import audit, clock, customers, events, ids, store
+from parcelo.errors import DomainError
+
+
+@pytest.fixture(autouse=True)
+def clean_state():
+    store.reset()
+    ids.reset()
+    audit.LOG.clear()
+    events.OUTBOX.clear()
+    clock.clear_fixed()
+    yield
+    store.reset()
+    ids.reset()
+    audit.LOG.clear()
+    events.OUTBOX.clear()
+    clock.clear_fixed()
+
+
+def test_new_customer_is_not_locked():
+    c = customers.add_customer("Acme")
+    assert c.locked is False
+
+
+def test_lock_sets_flag_and_returns_customer():
+    c = customers.add_customer("Acme")
+    result = customers.lock_customer(c.id)
+    assert result is c
+    assert result.locked is True
+    assert customers.get_customer(c.id).locked is True
+
+
+def test_lock_emits_event_and_audit_once():
+    c = customers.add_customer("Acme")
+    customers.lock_customer(c.id)
+    assert [e["name"] for e in events.OUTBOX] == ["customer.locked"]
+    assert [a["action"] for a in audit.LOG] == ["customer.locked"]
+
+
+def test_lock_is_idempotent():
+    c = customers.add_customer("Acme")
+    first = customers.lock_customer(c.id)
+    events_before = len(events.OUTBOX)
+    audit_before = len(audit.LOG)
+
+    second = customers.lock_customer(c.id)
+
+    assert second is first
+    assert second.locked is True
+    assert len(events.OUTBOX) == events_before
+    assert len(audit.LOG) == audit_before
+
+
+def test_lock_unknown_customer_raises_and_changes_nothing():
+    c = customers.add_customer("Acme")
+    with pytest.raises(DomainError) as err:
+        customers.lock_customer("C_missing")
+    assert err.value.code == "E_NOT_FOUND"
+    assert customers.get_customer(c.id).locked is False
+    assert len(events.OUTBOX) == 0
+    assert len(audit.LOG) == 0
