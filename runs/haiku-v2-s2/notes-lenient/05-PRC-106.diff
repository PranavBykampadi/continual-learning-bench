 def open_invoices():
     return [i for i in db.invoices.values() if i.status == "open"]
+
+
+def late_fee_for(invoice_id):
+    """Late fee accrued by an open invoice, as Money.
+
+    The invoice becomes late LATE_AFTER_DAYS after it was issued; from then on
+    the fee is 1.5% of the invoice amount for each day past that point.
+    """
+    if invoice_id not in db.invoices:
+        raise DomainError("E_NOT_FOUND", invoice_id)
+    invoice = db.invoices[invoice_id]
+    if invoice.status != "open":
+        raise DomainError("E_BAD_STATE", "invoice is %s" % invoice.status)
+
+    issued_at = invoice.issued_at
+    if issued_at.tzinfo is None:
+        # issue_invoice stores naive UTC timestamps.
+        issued_at = issued_at.replace(tzinfo=timezone.utc)
+    elapsed_days = (clock.now() - issued_at).days
+    days_late = elapsed_days - LATE_AFTER_DAYS
+    # legacy late_fee returns a float; convert at the boundary.
+    return Money.parse(late_fee(invoice.amount, days_late))
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_late_fee.py b/tests/unit/test_late_fee.py
--- a/tests/unit/test_late_fee.py	1969-12-31 19:00:00
+++ b/tests/unit/test_late_fee.py	2026-11-12 02:52:07
@@ -0,0 +1,67 @@
+from datetime import datetime, timedelta, timezone
+
+import pytest
+
+from parcelo import clock, invoices
+from parcelo.errors import DomainError
+from parcelo.models import Invoice
+from parcelo.money import Money
+from parcelo.store import db
+
+ISSUED = datetime(2026, 1, 1, tzinfo=timezone.utc)
+
+
+def _open_invoice(amount=100.0, status="open", issued_at=ISSUED):
+    inv = Invoice(
+        id="INV-LATE1",
+        shipment_id="shp_000001",
+        amount=amount,
+        status=status,
+        issued_at=issued_at,
+    )
+    db.invoices[inv.id] = inv
+    return inv
+
+
+def test_fee_is_zero_before_late_threshold():
+    _open_invoice()
+    clock.set_fixed(ISSUED + timedelta(days=29))
+    assert invoices.late_fee_for("INV-LATE1") == Money(0)
+
+
+def test_fee_is_zero_on_the_late_threshold_day():
+    _open_invoice()
+    clock.set_fixed(ISSUED + timedelta(days=30))
+    assert invoices.late_fee_for("INV-LATE1") == Money(0)
+
+
+def test_fee_accrues_per_day_past_threshold():
+    _open_invoice(amount=100.0)
+    # 10 days past the 30-day threshold: 100.00 * 1.5% * 10 = 15.00
+    clock.set_fixed(ISSUED + timedelta(days=40))
+    assert invoices.late_fee_for("INV-LATE1") == Money(1500)
+
+
+def test_fee_accepts_naive_issued_at_as_utc():
+    _open_invoice(amount=100.0, issued_at=ISSUED.replace(tzinfo=None))
+    clock.set_fixed(ISSUED + timedelta(days=40))
+    assert invoices.late_fee_for("INV-LATE1") == Money(1500)
+
+
+def test_unknown_invoice_not_found():
+    clock.set_fixed(ISSUED + timedelta(days=40))
+    with pytest.raises(DomainError) as err:
+        invoices.late_fee_for("INV-MISSING")
+    assert err.value.code == "E_NOT_FOUND"
+    assert db.invoices == {}
+
+
+@pytest.mark.parametrize("status", ["paid", "void"])
+def test_non_open_invoice_bad_state(status):
+    _open_invoice(status=status)
+    clock.set_fixed(ISSUED + timedelta(days=40))
+    with pytest.raises(DomainError) as err:
+        invoices.late_fee_for("INV-LATE1")
+    assert err.value.code == "E_BAD_STATE"
+    assert list(db.invoices) == ["INV-LATE1"]
+    assert db.invoices["INV-LATE1"].status == status
