@@ -0,0 +1,6 @@
+from parcelo.money import Money
+
+# Business thresholds owned by finance. Do not inline these values elsewhere.
+
+# Open invoices at or above this amount may be escalated to collections.
+ESCALATION_MIN_AMOUNT = Money.parse("500.00")
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_escalation.py b/tests/unit/test_escalation.py
--- a/tests/unit/test_escalation.py	1969-12-31 19:00:00
+++ b/tests/unit/test_escalation.py	2026-11-12 03:18:06
@@ -0,0 +1,71 @@
+import pytest
+
+from parcelo import audit, events, invoices
+from parcelo.errors import DomainError
+from parcelo.models import Invoice
+from parcelo.store import db
+
+
+def _add_invoice(invoice_id, amount, status="open"):
+    inv = Invoice(
+        id=invoice_id,
+        shipment_id="shp_x",
+        amount=float(amount),
+        status=status,
+    )
+    db.invoices[inv.id] = inv
+    return inv
+
+
+def test_escalates_open_invoice_at_threshold():
+    _add_invoice("INV-1", "500.00")
+    inv = invoices.escalate_invoice("INV-1")
+    assert inv.status == "escalated"
+    assert db.invoices["INV-1"].status == "escalated"
+    assert events.OUTBOX[-1]["name"] == "invoice.escalated"
+    assert events.OUTBOX[-1]["entity_id"] == "INV-1"
+
+
+def test_escalates_invoice_above_threshold():
+    _add_invoice("INV-2", "1250.75")
+    assert invoices.escalate_invoice("INV-2").status == "escalated"
+
+
+def test_rejects_invoice_below_threshold():
+    _add_invoice("INV-3", "499.99")
+    with pytest.raises(DomainError) as err:
+        invoices.escalate_invoice("INV-3")
+    assert err.value.code == "E_BAD_STATE"
+    assert db.invoices["INV-3"].status == "open"
+    assert len(events.OUTBOX) == 0
+
+
+def test_rejects_paid_invoice():
+    _add_invoice("INV-4", "900.00", status="paid")
+    with pytest.raises(DomainError) as err:
+        invoices.escalate_invoice("INV-4")
+    assert err.value.code == "E_BAD_STATE"
+    assert db.invoices["INV-4"].status == "paid"
+    assert len(events.OUTBOX) == 0
+
+
+def test_unknown_invoice_raises_not_found():
+    with pytest.raises(DomainError) as err:
+        invoices.escalate_invoice("INV-missing")
+    assert err.value.code == "E_NOT_FOUND"
+    assert len(events.OUTBOX) == 0
+    assert len(audit.LOG) == 0
+
+
+def test_escalate_is_idempotent():
+    _add_invoice("INV-5", "800.00")
+    first = invoices.escalate_invoice("INV-5")
+    outbox_before = len(events.OUTBOX)
+    log_before = len(audit.LOG)
+
+    second = invoices.escalate_invoice("INV-5")
+
+    assert second is first
+    assert second.status == "escalated"
+    assert len(events.OUTBOX) == outbox_before
+    assert len(audit.LOG) == log_before
