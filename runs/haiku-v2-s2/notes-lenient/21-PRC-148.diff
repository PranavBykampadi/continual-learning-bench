diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_disputes.py b/tests/unit/test_disputes.py
--- a/tests/unit/test_disputes.py	1969-12-31 19:00:00
+++ b/tests/unit/test_disputes.py	2026-11-12 03:04:26
@@ -0,0 +1,94 @@
+from datetime import datetime, timezone
+
+import pytest
+
+from parcelo import audit, clock, customers, disputes, events, ids, invoices, shipments, store
+from parcelo.errors import DomainError
+
+
+@pytest.fixture(autouse=True)
+def clean_state():
+    store.reset()
+    ids.reset()
+    audit.LOG.clear()
+    events.OUTBOX.clear()
+    clock.clear_fixed()
+    yield
+    store.reset()
+    ids.reset()
+    audit.LOG.clear()
+    events.OUTBOX.clear()
+    clock.clear_fixed()
+
+
+def _make_invoice():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 1.5, "national")
+    return invoices.issue_invoice(s.id)
+
+
+def test_open_dispute_saves_and_returns_record():
+    inv = _make_invoice()
+    moment = datetime(2026, 11, 1, 9, 30, tzinfo=timezone.utc)
+    clock.set_fixed(moment)
+
+    d = disputes.open_dispute(inv.id, "Wrong weight billed")
+
+    assert d.id.startswith("dsp_")
+    assert d.invoice_id == inv.id
+    assert d.reason == "Wrong weight billed"
+    assert d.opened_at == moment
+    assert store.db.disputes[d.id] is d
+
+
+def test_open_dispute_emits_event():
+    inv = _make_invoice()
+    events.OUTBOX.clear()
+
+    d = disputes.open_dispute(inv.id, "Duplicate charge")
+
+    assert len(events.OUTBOX) == 1
+    entry = events.OUTBOX[-1]
+    assert entry["name"] == "dispute.opened"
+    assert entry["entity_id"] == d.id
+    assert entry["payload"] == {"invoice_id": inv.id}
+
+
+def test_multiple_disputes_get_distinct_ids():
+    inv = _make_invoice()
+    a = disputes.open_dispute(inv.id, "first")
+    b = disputes.open_dispute(inv.id, "second")
+    assert a.id != b.id
+    assert len(store.db.disputes) == 2
+
+
+@pytest.mark.parametrize("bad_reason", ["", "   ", "\t\n", None])
+def test_empty_reason_rejected(bad_reason):
+    inv = _make_invoice()
+    before_dispute = dict(store.db.disputes)
+    before_invoice = dict(inv.__dict__)
+    log_len = len(audit.LOG)
+    outbox_len = len(events.OUTBOX)
+
+    with pytest.raises(DomainError) as err:
+        disputes.open_dispute(inv.id, bad_reason)
+
+    assert err.value.code == "E_BAD_INPUT"
+    assert store.db.disputes == before_dispute
+    assert inv.__dict__ == before_invoice
+    assert len(audit.LOG) == log_len
+    assert len(events.OUTBOX) == outbox_len
+
+
+@pytest.mark.parametrize("bad_id", ["", None, "INV-missing"])
+def test_unknown_invoice_rejected(bad_id):
+    _make_invoice()
+    before = dict(store.db.disputes)
+    outbox_len = len(events.OUTBOX)
+
+    with pytest.raises(DomainError) as err:
+        disputes.open_dispute(bad_id, "anything")
+
+    assert err.value.code == "E_NOT_FOUND"
+    assert store.db.disputes == before
+    assert len(events.OUTBOX) == outbox_len
