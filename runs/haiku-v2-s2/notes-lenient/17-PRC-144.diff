+import math
+
 ZONE_BASE = {"local": 4.5, "national": 9.0, "international": 24.0}
 PER_KG = 1.25
 
+# Same percentages as fuel_surcharge() in parcelo/legacy/billing.py.
+FUEL_SURCHARGE_PCT = {"local": 0.0, "national": 4.0, "international": 9.5}
+INSURANCE_PCT = 2.0
+MIN_INSURANCE_FEE = 1.00
 
+
 def base_rate(zone):
     if zone not in ZONE_BASE:
         raise ValueError("unknown zone: %s" % zone)
@@ -12,3 +19,20 @@
     if weight_kg <= 0:
         raise ValueError("weight must be positive")
     return round(base_rate(zone) + PER_KG * weight_kg, 2)
+
+
+def insurance_fee(declared_value, zone):
+    """Insurance fee for a declared value: 2% plus the zone's fuel surcharge
+    percentage of the declared value, with a minimum fee of 1.00."""
+    if zone not in FUEL_SURCHARGE_PCT:
+        raise ValueError("unknown zone: %s" % zone)
+    if (
+        isinstance(declared_value, bool)
+        or not isinstance(declared_value, (int, float))
+        or not math.isfinite(declared_value)
+        or declared_value <= 0
+    ):
+        raise ValueError("declared value must be a positive number")
+    pct = INSURANCE_PCT + FUEL_SURCHARGE_PCT[zone]
+    fee = declared_value * pct / 100.0
+    return round(max(MIN_INSURANCE_FEE, fee), 2)
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_insurance.py b/tests/unit/test_insurance.py
--- a/tests/unit/test_insurance.py	1969-12-31 19:00:00
+++ b/tests/unit/test_insurance.py	2026-11-12 03:01:47
@@ -0,0 +1,63 @@
+import pytest
+
+from parcelo import audit, clock, events, ids, store
+from parcelo.rates import insurance_fee
+
+
+@pytest.fixture(autouse=True)
+def clean_state():
+    store.reset()
+    ids.reset()
+    audit.LOG.clear()
+    events.OUTBOX.clear()
+    clock.clear_fixed()
+    yield
+    store.reset()
+    ids.reset()
+    audit.LOG.clear()
+    events.OUTBOX.clear()
+    clock.clear_fixed()
+
+
+@pytest.mark.parametrize(
+    "declared_value, zone, expected",
+    [
+        (100, "local", 2.00),
+        (100, "national", 6.00),
+        (100, "international", 11.50),
+        (1000, "international", 115.00),
+        (50, "local", 1.00),  # exactly at the minimum
+        (10, "local", 1.00),  # below the minimum, minimum applies
+        (0.01, "international", 1.00),
+    ],
+)
+def test_insurance_fee_values(declared_value, zone, expected):
+    assert insurance_fee(declared_value, zone) == expected
+
+
+def test_insurance_fee_is_read_only():
+    before_audit = len(audit.LOG)
+    before_outbox = len(events.OUTBOX)
+    before_db = {name: dict(getattr(store.db, name)) for name in ("shipments", "invoices")}
+
+    insurance_fee(100, "national")
+
+    assert len(audit.LOG) == before_audit
+    assert len(events.OUTBOX) == before_outbox
+    for name, snapshot in before_db.items():
+        assert getattr(store.db, name) == snapshot
+
+
+@pytest.mark.parametrize("zone", ["moon", "", None])
+def test_unknown_zone_fails(zone):
+    with pytest.raises(ValueError):
+        insurance_fee(100, zone)
+
+
+@pytest.mark.parametrize(
+    "declared_value",
+    [0, 0.0, -5, -0.01, float("nan"), float("inf"), float("-inf"), None, "100", True],
+)
+def test_invalid_declared_value_fails(declared_value):
+    with pytest.raises(ValueError):
+        insurance_fee(declared_value, "local")
