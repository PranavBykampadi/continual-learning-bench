diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_list_shipments.py b/tests/unit/test_list_shipments.py
--- a/tests/unit/test_list_shipments.py	1969-12-31 19:00:00
+++ b/tests/unit/test_list_shipments.py	2026-11-12 03:07:12
@@ -0,0 +1,87 @@
+import pytest
+
+from parcelo import audit, clock, customers, events, ids, shipments, store
+from parcelo.errors import DomainError
+
+
+@pytest.fixture(autouse=True)
+def clean_state():
+    store.reset()
+    ids.reset()
+    audit.LOG.clear()
+    events.OUTBOX.clear()
+    clock.clear_fixed()
+    yield
+    store.reset()
+    ids.reset()
+    audit.LOG.clear()
+    events.OUTBOX.clear()
+    clock.clear_fixed()
+
+
+def _ship(customer_id, weight=1.0, zone="local"):
+    return shipments.create_shipment(customer_id, weight, zone)
+
+
+def test_returns_only_that_customers_shipments_in_creation_order():
+    a = customers.add_customer("Acme")
+    b = customers.add_customer("Bolt")
+    s1 = _ship(a.id)
+    _ship(b.id)
+    s2 = _ship(a.id, weight=2.5, zone="national")
+
+    result = shipments.list_shipments(a.id)
+
+    assert result == [s1, s2]
+    assert all(s.customer_id == a.id for s in result)
+
+
+def test_customer_with_no_shipments_gets_empty_list():
+    c = customers.add_customer("Quiet")
+    assert shipments.list_shipments(c.id) == []
+
+
+def test_empty_store_with_unknown_customer_fails():
+    with pytest.raises(DomainError) as err:
+        shipments.list_shipments("C_missing")
+    assert err.value.code == "E_UNKNOWN_CUSTOMER"
+
+
+@pytest.mark.parametrize("bad_id", ["", "   ", "nope", None])
+def test_unknown_or_invalid_customer_ids_fail(bad_id):
+    c = customers.add_customer("Acme")
+    _ship(c.id)
+    before_db = dict(store.db.shipments)
+    before_log = len(audit.LOG)
+    before_outbox = len(events.OUTBOX)
+
+    with pytest.raises(DomainError) as err:
+        shipments.list_shipments(bad_id)
+
+    assert err.value.code == "E_UNKNOWN_CUSTOMER"
+    assert store.db.shipments == before_db
+    assert len(audit.LOG) == before_log
+    assert len(events.OUTBOX) == before_outbox
+
+
+def test_read_only_does_not_modify_records_or_outbox():
+    c = customers.add_customer("Acme")
+    _ship(c.id)
+    records_before = list(store.db.shipments.values())
+    outbox_before = len(events.OUTBOX)
+    log_before = len(audit.LOG)
+
+    result = shipments.list_shipments(c.id)
+
+    assert len(result) == 1
+    assert list(store.db.shipments.values()) == records_before
+    assert len(events.OUTBOX) == outbox_before
+    assert len(audit.LOG) == log_before
+
+
+def test_returned_list_is_a_fresh_list_not_the_store_dict():
+    c = customers.add_customer("Acme")
+    _ship(c.id)
+    result = shipments.list_shipments(c.id)
+    result.clear()
+    assert len(store.db.shipments) == 1
