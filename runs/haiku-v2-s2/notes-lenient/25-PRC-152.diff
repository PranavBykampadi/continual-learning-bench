diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/parcelo/shipments.py b/parcelo/shipments.py
--- a/parcelo/shipments.py	2026-11-10 12:20:18
+++ b/parcelo/shipments.py	2026-11-12 03:07:40
@@ -28,3 +28,16 @@
     if shipment_id not in db.shipments:
         raise DomainError("E_NOT_FOUND", shipment_id)
     return db.shipments[shipment_id]
+
+
+def mark_lost(shipment_id):
+    if not isinstance(shipment_id, str) or not shipment_id.strip():
+        raise DomainError("E_BAD_INPUT", repr(shipment_id))
+    shipment = get_shipment(shipment_id)
+    if shipment.status == "delivered" or shipment.delivered_at is not None:
+        raise DomainError("E_BAD_STATE", f"{shipment_id} already delivered")
+    if shipment.status == "lost":
+        raise DomainError("E_BAD_STATE", f"{shipment_id} already lost")
+    shipment.status = "lost"
+    events.emit("shipment.lost", shipment.id)
+    return shipment
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_mark_lost.py b/tests/unit/test_mark_lost.py
--- a/tests/unit/test_mark_lost.py	1969-12-31 19:00:00
+++ b/tests/unit/test_mark_lost.py	2026-11-12 03:07:45
@@ -0,0 +1,100 @@
+import pytest
+
+from parcelo import audit, clock, customers, events, ids, shipments, store
+from parcelo.errors import DomainError
+
+
+@pytest.fixture(autouse=True)
+def clean_state():
+    store.reset()
+    ids.reset()
+    audit.LOG.clear()
+    events.OUTBOX.clear()
+    clock.clear_fixed()
+    yield
+    store.reset()
+    ids.reset()
+    audit.LOG.clear()
+    events.OUTBOX.clear()
+    clock.clear_fixed()
+
+
+def _make_shipment():
+    c = customers.add_customer("Acme")
+    return shipments.create_shipment(c.id, 2.0, "national")
+
+
+def _snapshot():
+    return (
+        {k: (v.status, v.delivered_at) for k, v in store.db.shipments.items()},
+        len(audit.LOG),
+        len(events.OUTBOX),
+    )
+
+
+def test_marks_shipment_lost_and_returns_it():
+    s = _make_shipment()
+    result = shipments.mark_lost(s.id)
+    assert result is s
+    assert result.status == "lost"
+    assert store.db.shipments[s.id].status == "lost"
+
+
+def test_emits_lost_event():
+    s = _make_shipment()
+    events.OUTBOX.clear()
+    shipments.mark_lost(s.id)
+    assert len(events.OUTBOX) == 1
+    event = events.OUTBOX[-1]
+    assert event["name"] == "shipment.lost"
+    assert event["entity_id"] == s.id
+
+
+def test_mark_lost_twice_fails():
+    s = _make_shipment()
+    shipments.mark_lost(s.id)
+    before = _snapshot()
+    with pytest.raises(DomainError) as err:
+        shipments.mark_lost(s.id)
+    assert err.value.code == "E_BAD_STATE"
+    assert _snapshot() == before
+
+
+def test_delivered_shipment_cannot_be_marked_lost():
+    s = _make_shipment()
+    s.status = "delivered"
+    before = _snapshot()
+    with pytest.raises(DomainError) as err:
+        shipments.mark_lost(s.id)
+    assert err.value.code == "E_BAD_STATE"
+    assert store.db.shipments[s.id].status == "delivered"
+    assert _snapshot() == before
+
+
+def test_delivered_at_set_cannot_be_marked_lost():
+    s = _make_shipment()
+    s.delivered_at = clock.now()
+    with pytest.raises(DomainError) as err:
+        shipments.mark_lost(s.id)
+    assert err.value.code == "E_BAD_STATE"
+    assert store.db.shipments[s.id].status == "created"
+
+
+def test_unknown_shipment_fails():
+    _make_shipment()
+    before = _snapshot()
+    with pytest.raises(DomainError) as err:
+        shipments.mark_lost("shp_999999")
+    assert err.value.code == "E_NOT_FOUND"
+    assert _snapshot() == before
+
+
+@pytest.mark.parametrize("bad", ["", "   ", None, 0, 1.5, True, ["shp_000001"]])
+def test_invalid_id_fails(bad):
+    s = _make_shipment()
+    before = _snapshot()
+    with pytest.raises(DomainError) as err:
+        shipments.mark_lost(bad)
+    assert err.value.code == "E_BAD_INPUT"
+    assert store.db.shipments[s.id].status == "created"
+    assert _snapshot() == before
