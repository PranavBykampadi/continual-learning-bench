diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_refunds.py b/tests/unit/test_refunds.py
--- a/tests/unit/test_refunds.py	1969-12-31 19:00:00
+++ b/tests/unit/test_refunds.py	2026-11-12 02:51:21
@@ -0,0 +1,66 @@
+from datetime import datetime, timezone
+
+import pytest
+
+from parcelo import audit, clock, customers, invoices, refunds, shipments
+from parcelo.errors import DomainError
+from parcelo.models import Refund
+from parcelo.money import Money
+from parcelo.store import db
+
+
+def _paid_invoice():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 2, "local")
+    inv = invoices.issue_invoice(s.id)
+    invoices.mark_paid(inv.id)
+    return inv
+
+
+def test_create_refund_for_paid_invoice():
+    clock.set_fixed(datetime(2026, 11, 12, 9, 0, tzinfo=timezone.utc))
+    inv = _paid_invoice()
+    r = refunds.create_refund(inv.id, 3.5)
+    assert isinstance(r, Refund)
+    assert r.id.startswith("ref_")
+    assert r.invoice_id == inv.id
+    assert r.amount == Money(350)
+    assert r.created_at == datetime(2026, 11, 12, 9, 0, tzinfo=timezone.utc)
+    assert db.refunds[r.id] is r
+    assert audit.LOG[-1]["action"] == "refund.created"
+    assert audit.LOG[-1]["entity_id"] == r.id
+
+
+def test_refund_unknown_invoice():
+    with pytest.raises(DomainError) as err:
+        refunds.create_refund("INV-missing", 1)
+    assert err.value.code == "E_NOT_FOUND"
+    assert db.refunds == {}
+
+
+def test_refund_open_invoice():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 2, "local")
+    inv = invoices.issue_invoice(s.id)
+    with pytest.raises(DomainError) as err:
+        refunds.create_refund(inv.id, 1)
+    assert err.value.code == "E_BAD_STATE"
+    assert db.refunds == {}
+
+
+def test_refund_void_invoice():
+    inv = _paid_invoice()
+    inv.status = "void"
+    with pytest.raises(DomainError) as err:
+        refunds.create_refund(inv.id, 1)
+    assert err.value.code == "E_BAD_STATE"
+    assert db.refunds == {}
+
+
+@pytest.mark.parametrize("amount", [0, -2])
+def test_refund_non_positive_amount(amount):
+    inv = _paid_invoice()
+    with pytest.raises(DomainError) as err:
+        refunds.create_refund(inv.id, amount)
+    assert err.value.code == "E_BAD_INPUT"
+    assert db.refunds == {}
