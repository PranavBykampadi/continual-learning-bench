diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_reopen_invoice.py b/tests/unit/test_reopen_invoice.py
--- a/tests/unit/test_reopen_invoice.py	1969-12-31 19:00:00
+++ b/tests/unit/test_reopen_invoice.py	2026-11-12 03:00:20
@@ -0,0 +1,113 @@
+from datetime import datetime, timezone
+
+import pytest
+
+from parcelo import audit, clock, customers, events, ids, invoices, shipments, store
+from parcelo.errors import DomainError
+
+
+@pytest.fixture(autouse=True)
+def clean_state():
+    store.reset()
+    ids.reset()
+    audit.LOG.clear()
+    events.OUTBOX.clear()
+    clock.clear_fixed()
+    yield
+    store.reset()
+    ids.reset()
+    audit.LOG.clear()
+    events.OUTBOX.clear()
+    clock.clear_fixed()
+
+
+def make_invoice():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 2, "local")
+    return invoices.issue_invoice(s.id)
+
+
+def make_paid_invoice():
+    inv = make_invoice()
+    return invoices.mark_paid(inv.id)
+
+
+def test_reopen_sets_open_and_clears_paid_at():
+    inv = make_paid_invoice()
+    assert inv.paid_at is not None
+
+    result = invoices.reopen_invoice(inv.id)
+
+    assert result is inv
+    assert inv.status == "open"
+    assert inv.paid_at is None
+
+
+def test_reopen_records_reopened_at():
+    inv = make_paid_invoice()
+    moment = datetime(2026, 11, 12, 9, 30, tzinfo=timezone.utc)
+    clock.set_fixed(moment)
+
+    invoices.reopen_invoice(inv.id)
+
+    assert inv.reopened_at == moment
+
+
+def test_reopen_emits_event():
+    inv = make_paid_invoice()
+    before = len(events.OUTBOX)
+
+    invoices.reopen_invoice(inv.id)
+
+    assert len(events.OUTBOX) == before + 1
+    assert events.OUTBOX[-1]["name"] == "invoice.reopened"
+    assert events.OUTBOX[-1]["entity_id"] == inv.id
+
+
+def test_reopened_invoice_is_open_again():
+    inv = make_paid_invoice()
+    invoices.reopen_invoice(inv.id)
+    assert inv in invoices.open_invoices()
+
+
+@pytest.mark.parametrize("bad_id", ["INV-missing", "", None])
+def test_reopen_unknown_invoice_fails(bad_id):
+    make_paid_invoice()
+    before_log = len(audit.LOG)
+    before_events = len(events.OUTBOX)
+    before = {k: dict(v.__dict__) for k, v in store.db.invoices.items()}
+
+    with pytest.raises(DomainError) as err:
+        invoices.reopen_invoice(bad_id)
+
+    assert err.value.code == "E_NOT_FOUND"
+    assert len(audit.LOG) == before_log
+    assert len(events.OUTBOX) == before_events
+    assert {k: dict(v.__dict__) for k, v in store.db.invoices.items()} == before
+
+
+def test_reopen_open_invoice_fails():
+    inv = make_invoice()
+    before_log = len(audit.LOG)
+    before_events = len(events.OUTBOX)
+    before = dict(inv.__dict__)
+
+    with pytest.raises(DomainError) as err:
+        invoices.reopen_invoice(inv.id)
+
+    assert err.value.code == "E_BAD_STATE"
+    assert dict(inv.__dict__) == before
+    assert len(audit.LOG) == before_log
+    assert len(events.OUTBOX) == before_events
+
+
+def test_reopen_twice_fails():
+    inv = make_paid_invoice()
+    invoices.reopen_invoice(inv.id)
+    before_events = len(events.OUTBOX)
+
+    with pytest.raises(DomainError) as err:
+        invoices.reopen_invoice(inv.id)
+
+    assert err.value.code == "E_BAD_STATE"
+    assert len(events.OUTBOX) == before_events
