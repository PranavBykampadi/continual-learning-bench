+def reopen_invoice(invoice_id):
+    if invoice_id not in db.invoices:
+        raise DomainError("E_NOT_FOUND", str(invoice_id))
+    invoice = db.invoices[invoice_id]
+    if invoice.status != "paid":
+        raise DomainError("E_BAD_STATE", f"{invoice_id} is {invoice.status}")
+    invoice.status = "open"
+    invoice.paid_at = None
+    invoice.reopened_at = clock.now()
+    events.emit("invoice.reopened", invoice.id)
     return invoice
 
 
