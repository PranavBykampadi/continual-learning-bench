+def _parse_credit(amount):
+    """Turn a credit into a positive, whole-cent Money value or raise E_BAD_INPUT."""
+    try:
+        if not isinstance(amount, Money):
+            exact = Decimal(str(amount)) * 100
+            if exact != exact.to_integral_value():
+                raise ValueError("sub-cent amount")
+        credit = Money.parse(amount)
+    except (InvalidOperation, TypeError, ValueError) as exc:
+        raise DomainError("E_BAD_INPUT", repr(amount)) from exc
+    if credit.cents <= 0:
+        raise DomainError("E_BAD_INPUT", repr(amount))
+    return credit
+
+
+def apply_credit(invoice_id, amount):
+    """Reduce an open invoice by a credit and return the remaining amount as Money.
+
+    The stored invoice amount stays a float so reports and balances keep working.
+    """
+    if invoice_id not in db.invoices:
+        raise DomainError("E_NOT_FOUND", invoice_id)
+    invoice = db.invoices[invoice_id]
+    if invoice.status != "open":
+        raise DomainError("E_BAD_STATE", invoice.status)
+    credit = _parse_credit(amount)
+    current = Money.parse(invoice.amount)
+    if credit.cents > current.cents:
+        raise DomainError("E_BAD_INPUT", "credit exceeds invoice amount")
+    remaining = current - credit
+    invoice.amount = remaining.cents / 100
+    audit.record(
+        "invoice.credit_applied",
+        invoice_id,
+        credit_cents=credit.cents,
+        remaining_cents=remaining.cents,
+    )
+    return remaining
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_credits.py b/tests/unit/test_credits.py
--- a/tests/unit/test_credits.py	1969-12-31 19:00:00
+++ b/tests/unit/test_credits.py	2026-11-12 02:58:03
@@ -0,0 +1,92 @@
+import pytest
+
+from parcelo import audit, clock, customers, ids, invoices, reports, shipments, store
+from parcelo.errors import DomainError
+from parcelo.money import Money
+
+
+@pytest.fixture(autouse=True)
+def clean_state():
+    store.reset()
+    ids.reset()
+    audit.LOG.clear()
+    clock.clear_fixed()
+    yield
+    store.reset()
+    ids.reset()
+    audit.LOG.clear()
+    clock.clear_fixed()
+
+
+def _open_invoice():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 2, "local")  # quote: 4.5 + 1.25 * 2 = 7.00
+    return invoices.issue_invoice(s.id)
+
+
+def _snapshot(inv):
+    return inv.amount, inv.status, len(audit.LOG)
+
+
+def test_credit_reduces_open_invoice():
+    inv = _open_invoice()
+    remaining = invoices.apply_credit(inv.id, 2)
+    assert remaining == Money(500)
+    assert inv.amount == 5.0
+    assert inv.status == "open"
+    assert audit.LOG[-1]["action"] == "invoice.credit_applied"
+    assert audit.LOG[-1]["entity_id"] == inv.id
+
+
+def test_credit_equal_to_amount_leaves_zero():
+    inv = _open_invoice()
+    assert invoices.apply_credit(inv.id, "7.00") == Money.zero()
+    assert inv.amount == 0.0
+
+
+def test_credit_keeps_reports_and_balance_working():
+    c = customers.add_customer("Beta")
+    s = shipments.create_shipment(c.id, 2, "local")
+    inv = invoices.issue_invoice(s.id)
+    invoices.apply_credit(inv.id, "1.25")
+    assert customers.outstanding_balance(c.id) == 5.75
+    invoices.mark_paid(inv.id)
+    assert reports.revenue_total() == 5.75
+
+
+def test_unknown_invoice_fails():
+    with pytest.raises(DomainError) as err:
+        invoices.apply_credit("INV-missing", 1)
+    assert err.value.code == "E_NOT_FOUND"
+
+
+def test_paid_invoice_fails_and_is_unchanged():
+    inv = _open_invoice()
+    invoices.mark_paid(inv.id)
+    before = _snapshot(inv)
+    with pytest.raises(DomainError) as err:
+        invoices.apply_credit(inv.id, 1)
+    assert err.value.code == "E_BAD_STATE"
+    assert _snapshot(inv) == before
+
+
+def test_credit_larger_than_amount_fails_and_is_unchanged():
+    inv = _open_invoice()
+    before = _snapshot(inv)
+    with pytest.raises(DomainError) as err:
+        invoices.apply_credit(inv.id, "7.01")
+    assert err.value.code == "E_BAD_INPUT"
+    assert _snapshot(inv) == before
+
+
+@pytest.mark.parametrize(
+    "bad",
+    [0, -1, -0.5, "0", "-2", 0.001, 0.005, "0.001", "abc", "", None, float("nan")],
+)
+def test_invalid_credit_fails_and_is_unchanged(bad):
+    inv = _open_invoice()
+    before = _snapshot(inv)
+    with pytest.raises(DomainError) as err:
+        invoices.apply_credit(inv.id, bad)
+    assert err.value.code == "E_BAD_INPUT"
+    assert _snapshot(inv) == before
