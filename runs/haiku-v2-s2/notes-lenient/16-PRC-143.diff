diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_pickups.py b/tests/unit/test_pickups.py
--- a/tests/unit/test_pickups.py	1969-12-31 19:00:00
+++ b/tests/unit/test_pickups.py	2026-11-12 03:01:09
@@ -0,0 +1,82 @@
+import copy
+from datetime import datetime, timezone
+
+import pytest
+
+from parcelo import audit, clock, customers, events, ids, pickups, shipments, store
+from parcelo.errors import DomainError
+from parcelo.models import Pickup
+
+WINDOW = datetime(2026, 11, 13, 9, 0, tzinfo=timezone.utc)
+
+
+@pytest.fixture(autouse=True)
+def clean_state():
+    store.reset()
+    ids.reset()
+    audit.LOG.clear()
+    events.OUTBOX.clear()
+    clock.clear_fixed()
+    yield
+    store.reset()
+    ids.reset()
+    audit.LOG.clear()
+    events.OUTBOX.clear()
+    clock.clear_fixed()
+
+
+def make_shipment():
+    c = customers.add_customer("Acme")
+    return shipments.create_shipment(c.id, 2.0, "national")
+
+
+def test_schedule_returns_pickup_and_stores_it():
+    clock.set_fixed(datetime(2026, 11, 12, 10, 0, tzinfo=timezone.utc))
+    s = make_shipment()
+    p = pickups.schedule_pickup(s.id, WINDOW)
+    assert isinstance(p, Pickup)
+    assert p.id.startswith("pck_")
+    assert p.shipment_id == s.id
+    assert p.window_start == WINDOW
+    assert p.scheduled_at == datetime(2026, 11, 12, 10, 0, tzinfo=timezone.utc)
+    assert store.db.pickups[p.id] is p
+
+
+def test_schedule_emits_event():
+    s = make_shipment()
+    events.OUTBOX.clear()
+    p = pickups.schedule_pickup(s.id, WINDOW)
+    assert len(events.OUTBOX) == 1
+    assert events.OUTBOX[-1]["name"] == "pickup.scheduled"
+    assert events.OUTBOX[-1]["entity_id"] == p.id
+
+
+@pytest.mark.parametrize("bad_id", ["", None, "shp_missing"])
+def test_unknown_shipment_fails(bad_id):
+    make_shipment()
+    before_pickups = dict(store.db.pickups)
+    before_audit = len(audit.LOG)
+    before_events = len(events.OUTBOX)
+    with pytest.raises(DomainError) as err:
+        pickups.schedule_pickup(bad_id, WINDOW)
+    assert err.value.code == "E_NOT_FOUND"
+    assert store.db.pickups == before_pickups
+    assert len(audit.LOG) == before_audit
+    assert len(events.OUTBOX) == before_events
+
+
+@pytest.mark.parametrize("bad_status", ["delivered", "cancelled", "in_transit"])
+def test_shipment_not_created_fails(bad_status):
+    s = make_shipment()
+    s.status = bad_status
+    before_shipment = copy.copy(s.__dict__)
+    before_pickups = dict(store.db.pickups)
+    before_audit = len(audit.LOG)
+    before_events = len(events.OUTBOX)
+    with pytest.raises(DomainError) as err:
+        pickups.schedule_pickup(s.id, WINDOW)
+    assert err.value.code == "E_BAD_STATE"
+    assert s.__dict__ == before_shipment
+    assert store.db.pickups == before_pickups
+    assert len(audit.LOG) == before_audit
+    assert len(events.OUTBOX) == before_events
