+import copy
+
+import pytest
+
+from parcelo import audit, clock, customers, events, ids, invoices, shipments, store
+from parcelo.errors import DomainError
+
+
+@pytest.fixture(autouse=True)
+def clean_state():
+    store.reset()
+    ids.reset()
+    audit.LOG.clear()
+    events.OUTBOX.clear()
+    clock.clear_fixed()
+    yield
+    store.reset()
+    ids.reset()
+    audit.LOG.clear()
+    events.OUTBOX.clear()
+    clock.clear_fixed()
+
+
+def _customer_with_shipments(shipment_count, paid_invoices=0, amount=100.0):
+    """Customer with `shipment_count` shipments; the first `paid_invoices` are paid at `amount`."""
+    customer = customers.add_customer("Acme")
+    shipment_list = [
+        shipments.create_shipment(customer.id, 1, "local") for _ in range(shipment_count)
+    ]
+    for shipment in shipment_list[:paid_invoices]:
+        invoice = invoices.issue_invoice(shipment.id)
+        invoice.amount = amount
+        invoices.mark_paid(invoice.id)
+    return customer
+
+
+def _snapshot():
+    return (copy.deepcopy(vars(store.db)), len(audit.LOG), copy.deepcopy(events.OUTBOX))
+
+
+@pytest.mark.parametrize(
+    "shipment_count, expected",
+    [
+        (0, 0.0),
+        (1, 0.0),
+        (9, 0.0),  # one below the first tier: no rebate
+        (10, 3.0),  # first tier boundary: 3% of 100.0
+        (11, 3.0),
+        (49, 3.0),  # one below the second tier: still first tier
+        (50, 6.0),  # second tier boundary: 6% of 100.0
+        (51, 6.0),
+    ],
+)
+def test_rebate_tier_boundaries(shipment_count, expected):
+    customer = _customer_with_shipments(shipment_count, paid_invoices=1)
+    assert customers.rebate_for(customer.id) == expected
+
+
+def test_rebate_is_share_of_paid_total_only():
+    customer = _customer_with_shipments(10, paid_invoices=2, amount=250.0)
+    # Two paid invoices of 250.0 each, 3% of 500.0.
+    assert customers.rebate_for(customer.id) == 15.0
+
+
+def test_open_invoices_do_not_count():
+    customer = _customer_with_shipments(10, paid_invoices=1)
+    open_shipment = shipments.create_shipment(customer.id, 1, "local")
+    open_invoice = invoices.issue_invoice(open_shipment.id)
+    open_invoice.amount = 1000.0
+    assert customers.rebate_for(customer.id) == 3.0
+
+
+def test_other_customers_invoices_do_not_count():
+    customer = _customer_with_shipments(10, paid_invoices=1)
+    other = _customer_with_shipments(10, paid_invoices=1, amount=5000.0)
+    assert other.id != customer.id
+    assert customers.rebate_for(customer.id) == 3.0
+
+
+def test_customer_with_no_paid_invoices_gets_zero():
+    customer = _customer_with_shipments(60, paid_invoices=0)
+    assert customers.rebate_for(customer.id) == 0.0
+
+
