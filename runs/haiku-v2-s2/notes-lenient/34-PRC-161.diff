+def rebate_for(customer_id):
+    """Volume rebate earned by a customer: a share of their paid invoice total.
+
+    Read-only: emits no events and writes no audit entries.
+    """
+    if customer_id not in db.customers:
+        raise DomainError("E_UNKNOWN_CUSTOMER", str(customer_id))
+    shipment_count = 0
+    paid_total = 0.0
+    for shipment in db.shipments.values():
+        if shipment.customer_id == customer_id:
+            shipment_count += 1
+    for invoice in db.invoices.values():
+        shipment = db.shipments[invoice.shipment_id]
+        if shipment.customer_id == customer_id and invoice.status == "paid":
+            paid_total += invoice.amount
+    if shipment_count >= REBATE_TIER_2_MIN_SHIPMENTS:
+        rate = REBATE_TIER_2_RATE
+    elif shipment_count >= REBATE_TIER_1_MIN_SHIPMENTS:
+        rate = REBATE_TIER_1_RATE
+    else:
+        return 0.0
+    return round(paid_total * rate, 2)
