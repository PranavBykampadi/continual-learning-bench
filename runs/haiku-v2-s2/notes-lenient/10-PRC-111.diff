     if shipment_id not in db.shipments:
         raise DomainError("E_NOT_FOUND", shipment_id)
     return db.shipments[shipment_id]
+
+
+def add_note(shipment_id, text):
+    if shipment_id not in db.shipments:
+        raise DomainError("E_NOT_FOUND", shipment_id)
+    if not isinstance(text, str) or not text.strip():
+        raise DomainError("E_BAD_INPUT", "note text must be non-empty")
+    shipment = db.shipments[shipment_id]
+    shipment.notes.append({"text": text, "at": clock.now()})
+    return shipment
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_shipment_notes.py b/tests/unit/test_shipment_notes.py
--- a/tests/unit/test_shipment_notes.py	1969-12-31 19:00:00
+++ b/tests/unit/test_shipment_notes.py	2026-11-12 02:55:59
@@ -0,0 +1,71 @@
+from datetime import datetime, timezone
+
+import pytest
+
+from parcelo import audit, clock, customers, ids, shipments, store
+from parcelo.errors import DomainError
+
+
+@pytest.fixture(autouse=True)
+def clean_state():
+    store.reset()
+    ids.reset()
+    audit.LOG.clear()
+    yield
+    clock.clear_fixed()
+
+
+def _make_shipment():
+    c = customers.add_customer("Acme")
+    return shipments.create_shipment(c.id, 1.5, "national")
+
+
+def test_add_note_appends_text_and_timestamp():
+    moment = datetime(2026, 11, 12, 9, 30, tzinfo=timezone.utc)
+    clock.set_fixed(moment)
+    s = _make_shipment()
+
+    result = shipments.add_note(s.id, "Left at front desk")
+
+    assert result is s
+    assert s.notes == [{"text": "Left at front desk", "at": moment}]
+
+
+def test_add_note_keeps_earlier_notes_and_records_each_time():
+    first = datetime(2026, 11, 12, 9, 0, tzinfo=timezone.utc)
+    second = datetime(2026, 11, 12, 10, 0, tzinfo=timezone.utc)
+    s = _make_shipment()
+
+    clock.set_fixed(first)
+    shipments.add_note(s.id, "one")
+    clock.set_fixed(second)
+    shipments.add_note(s.id, "two")
+
+    assert s.notes == [
+        {"text": "one", "at": first},
+        {"text": "two", "at": second},
+    ]
+
+
+def test_add_note_unknown_shipment_raises_not_found():
+    with pytest.raises(DomainError) as err:
+        shipments.add_note("shp_missing", "hello")
+    assert err.value.code == "E_NOT_FOUND"
+
+
+@pytest.mark.parametrize("text", ["", "   ", None, 42])
+def test_add_note_rejects_empty_or_invalid_text(text):
+    s = _make_shipment()
+
+    with pytest.raises(DomainError) as err:
+        shipments.add_note(s.id, text)
+
+    assert err.value.code == "E_BAD_INPUT"
+    assert s.notes == []
+
+
+def test_failed_add_note_on_missing_shipment_leaves_existing_shipment_alone():
+    s = _make_shipment()
+    with pytest.raises(DomainError):
+        shipments.add_note("shp_missing", "hello")
+    assert s.notes == []
