+
+def needs_review(customer_id):
+    if customer_id not in db.customers:
+        raise DomainError("E_UNKNOWN_CUSTOMER", str(customer_id))
+    open_count = 0
+    open_total = Decimal("0")
+    for invoice in db.invoices.values():
+        shipment = db.shipments[invoice.shipment_id]
+        if shipment.customer_id == customer_id and invoice.status == "open":
+            open_count += 1
+            open_total += Decimal(str(invoice.amount))
+    return open_count > REVIEW_MAX_OPEN_INVOICES or open_total > REVIEW_MAX_OPEN_TOTAL
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_customers_review.py b/tests/unit/test_customers_review.py
--- a/tests/unit/test_customers_review.py	1969-12-31 19:00:00
+++ b/tests/unit/test_customers_review.py	2026-11-12 03:08:28
@@ -0,0 +1,102 @@
+import pytest
+
+from parcelo import audit, customers, events, invoices, shipments, store
+from parcelo.errors import DomainError
+
+
+def _open_invoice(customer_id, amount):
+    s = shipments.create_shipment(customer_id, 1, "local")
+    inv = invoices.issue_invoice(s.id)
+    inv.amount = amount  # backdate the amount for a controlled total
+    return inv
+
+
+def _snapshot():
+    return (
+        dict(store.db.customers),
+        dict(store.db.shipments),
+        dict(store.db.invoices),
+        len(audit.LOG),
+        len(events.OUTBOX),
+    )
+
+
+def test_customer_with_no_invoices_is_not_flagged():
+    c = customers.add_customer("Acme")
+    assert customers.needs_review(c.id) is False
+
+
+def test_unknown_customer_raises():
+    with pytest.raises(DomainError) as err:
+        customers.needs_review("C_missing")
+    assert err.value.code == "E_UNKNOWN_CUSTOMER"
+
+
+@pytest.mark.parametrize("bad", ["", "   ", None])
+def test_blank_or_none_customer_raises(bad):
+    before = _snapshot()
+    with pytest.raises(DomainError) as err:
+        customers.needs_review(bad)
+    assert err.value.code == "E_UNKNOWN_CUSTOMER"
+    assert _snapshot() == before
+
+
+def test_three_open_invoices_under_total_not_flagged():
+    c = customers.add_customer("Acme")
+    for _ in range(3):
+        _open_invoice(c.id, 10.0)
+    assert customers.needs_review(c.id) is False
+
+
+def test_four_open_invoices_flagged():
+    c = customers.add_customer("Acme")
+    for _ in range(4):
+        _open_invoice(c.id, 1.0)
+    assert customers.needs_review(c.id) is True
+
+
+def test_total_exactly_250_not_flagged():
+    c = customers.add_customer("Acme")
+    _open_invoice(c.id, 100.0)
+    _open_invoice(c.id, 150.0)
+    assert customers.needs_review(c.id) is False
+
+
+def test_total_just_over_250_flagged():
+    c = customers.add_customer("Acme")
+    _open_invoice(c.id, 100.0)
+    _open_invoice(c.id, 150.01)
+    assert customers.needs_review(c.id) is True
+
+
+def test_float_sum_does_not_misjudge_boundary():
+    # 0.1 + 0.2 style drift must not push an exact 250.00 total over the line
+    c = customers.add_customer("Acme")
+    _open_invoice(c.id, 83.33)
+    _open_invoice(c.id, 83.33)
+    _open_invoice(c.id, 83.34)
+    assert customers.needs_review(c.id) is False
+
+
+def test_paid_invoices_do_not_count():
+    c = customers.add_customer("Acme")
+    for _ in range(4):
+        inv = _open_invoice(c.id, 1.0)
+        invoices.mark_paid(inv.id)
+    assert customers.needs_review(c.id) is False
+
+
+def test_other_customers_invoices_do_not_count():
+    a = customers.add_customer("Acme")
+    b = customers.add_customer("Beta")
+    for _ in range(4):
+        _open_invoice(b.id, 1.0)
+    assert customers.needs_review(a.id) is False
+
+
+def test_read_only_does_not_modify_state():
+    c = customers.add_customer("Acme")
+    _open_invoice(c.id, 300.0)
+    before = _snapshot()
+    customers.needs_review(c.id)
+    assert _snapshot() == before
