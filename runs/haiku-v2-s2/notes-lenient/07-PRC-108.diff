 from datetime import datetime
 
+from parcelo.money import Money
 from parcelo.store import db
+
+
+def outstanding_by_customer():
+    """Map each customer id to the total of their open invoices as Money.
+
+    Every known customer appears in the result, with a zero balance if they
+    have no open invoices. Paid and void invoices are excluded.
+    """
+    balances = {customer_id: Money.zero() for customer_id in db.customers}
+    for invoice in db.invoices.values():
+        if invoice.status != "open":
+            continue
+        customer_id = db.shipments[invoice.shipment_id].customer_id
+        current = balances.get(customer_id, Money.zero())
+        balances[customer_id] = current + Money.parse(invoice.amount)
+    return balances
 
 
