+
+def reactivate_customer(customer_id):
+    if customer_id is None or not isinstance(customer_id, str) or not customer_id.strip():
+        raise DomainError("E_BAD_INPUT", repr(customer_id))
+    customer = db.customers.get(customer_id)
+    if customer is None:
+        raise DomainError("E_UNKNOWN_CUSTOMER", customer_id)
+    if customer.active:
+        return customer
+    customer.active = True
+    events.emit("customer.reactivated", customer.id)
     return customer
 
 
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_customers.py b/tests/unit/test_customers.py
--- a/tests/unit/test_customers.py	1969-12-31 19:00:00
+++ b/tests/unit/test_customers.py	2026-11-12 03:09:11
@@ -0,0 +1,81 @@
+import datetime
+
+import pytest
+
+from parcelo import audit, clock, customers, events, ids, store
+from parcelo.errors import DomainError
+
+
+@pytest.fixture(autouse=True)
+def clean_state():
+    store.reset()
+    ids.reset()
+    audit.LOG.clear()
+    events.OUTBOX.clear()
+    clock.clear_fixed()
+    yield
+    store.reset()
+    ids.reset()
+    audit.LOG.clear()
+    events.OUTBOX.clear()
+    clock.clear_fixed()
+
+
+def snapshot():
+    return (
+        dict(store.db.customers),
+        dict(store.db.shipments),
+        dict(store.db.invoices),
+        len(audit.LOG),
+        len(events.OUTBOX),
+    )
+
+
+def make_inactive():
+    c = customers.add_customer("Acme")
+    customers.get_customer(c.id).active = False
+    return c.id
+
+
+def test_reactivates_inactive_customer():
+    clock.set_fixed(datetime.datetime(2026, 11, 12, tzinfo=datetime.timezone.utc))
+    cid = make_inactive()
+    result = customers.reactivate_customer(cid)
+    assert result is customers.get_customer(cid)
+    assert result.active is True
+    assert events.OUTBOX[-1]["name"] == "customer.reactivated"
+    assert events.OUTBOX[-1]["entity_id"] == cid
+
+
+def test_already_active_is_noop():
+    c = customers.add_customer("Acme")
+    before = snapshot()
+    result = customers.reactivate_customer(c.id)
+    assert result.active is True
+    assert snapshot() == before
+
+
+def test_repeat_call_is_noop():
+    cid = make_inactive()
+    customers.reactivate_customer(cid)
+    before = snapshot()
+    customers.reactivate_customer(cid)
+    assert snapshot() == before
+
+
+@pytest.mark.parametrize("bad", [None, "", "   ", 42, 1.5, True])
+def test_bad_ids_rejected(bad):
+    before = snapshot()
+    with pytest.raises(DomainError) as err:
+        customers.reactivate_customer(bad)
+    assert err.value.code == "E_BAD_INPUT"
+    assert snapshot() == before
+
+
+@pytest.mark.parametrize("missing", ["nope", "C000000"])
+def test_unknown_customer_fails(missing):
+    before = snapshot()
+    with pytest.raises(DomainError) as err:
+        customers.reactivate_customer(missing)
+    assert err.value.code == "E_UNKNOWN_CUSTOMER"
+    assert snapshot() == before
