--- a/tests/unit/test_volume_report.py	1969-12-31 19:00:00
+++ b/tests/unit/test_volume_report.py	2026-11-12 03:03:48
@@ -0,0 +1,75 @@
+import pytest
+
+from parcelo import audit, clock, customers, events, ids, shipments, store
+from parcelo.reports import volume_report
+
+
+@pytest.fixture(autouse=True)
+def clean_state():
+    store.reset()
+    ids.reset()
+    audit.LOG.clear()
+    events.OUTBOX.clear()
+    clock.clear_fixed()
+    yield
+    store.reset()
+    ids.reset()
+    audit.LOG.clear()
+    events.OUTBOX.clear()
+    clock.clear_fixed()
+
+
+def add_shipments(customer_id, count):
+    for _ in range(count):
+        shipments.create_shipment(customer_id, 1.0, "local")
+
+
+def test_customer_with_no_shipments_is_included():
+    c = customers.add_customer("Acme")
+    assert volume_report() == {c.id: {"shipments": 0, "tier": "starter"}}
+
+
+def test_counts_shipments_per_customer():
+    a = customers.add_customer("Acme")
+    b = customers.add_customer("Globex")
+    add_shipments(a.id, 3)
+    add_shipments(b.id, 1)
+    report = volume_report()
+    assert report[a.id] == {"shipments": 3, "tier": "starter"}
+    assert report[b.id] == {"shipments": 1, "tier": "starter"}
+
+
+def test_empty_store_returns_empty_dict():
+    assert volume_report() == {}
+
+
+@pytest.mark.parametrize(
+    "count, tier",
+    [
+        (0, "starter"),
+        (9, "starter"),
+        (10, "regular"),
+        (49, "regular"),
+        (50, "bulk"),
+    ],
+)
+def test_tier_thresholds_match_legacy_volume_tier(count, tier):
+    c = customers.add_customer("Acme")
+    add_shipments(c.id, count)
+    assert volume_report()[c.id] == {"shipments": count, "tier": tier}
+
+
+def test_read_only_does_not_modify_state():
+    c = customers.add_customer("Acme")
+    add_shipments(c.id, 2)
+    before_customers = dict(store.db.customers)
+    before_shipments = {k: dict(v.__dict__) for k, v in store.db.shipments.items()}
+    audit_len = len(audit.LOG)
+    outbox_len = len(events.OUTBOX)
+
+    volume_report()
+
+    assert dict(store.db.customers) == before_customers
+    assert {k: dict(v.__dict__) for k, v in store.db.shipments.items()} == before_shipments
+    assert len(audit.LOG) == audit_len
+    assert len(events.OUTBOX) == outbox_len
