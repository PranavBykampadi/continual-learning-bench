+def _is_valid_weight(weight):
+    return (
+        isinstance(weight, (int, float))
+        and not isinstance(weight, bool)
+        and math.isfinite(weight)
+        and weight > 0
+    )
+
+
+def split_shipment(shipment_id, weights):
+    """Replace a "created" shipment with one new shipment per weight.
+
+    The original is marked "split". The weights must be positive and must add
+    up exactly to the original weight. All checks run before anything is
+    changed, so a failed call leaves the store untouched.
+    """
+    shipment = get_shipment(shipment_id)
+    if shipment.status != "created":
+        raise DomainError("E_BAD_STATE", shipment_id)
+    if not isinstance(weights, (list, tuple)) or len(weights) == 0:
+        raise DomainError("E_BAD_INPUT", "weights must be a non-empty list")
+    for weight in weights:
+        if not _is_valid_weight(weight):
+            raise DomainError("E_BAD_WEIGHT", repr(weight))
+    # Compare as decimals so float rounding (0.1 + 0.2) does not cause false mismatches.
+    if sum(Decimal(str(w)) for w in weights) != Decimal(str(shipment.weight_kg)):
+        raise DomainError("E_BAD_WEIGHT", "weights do not add up to shipment weight")
+
+    now = clock.now()
+    new_shipments = [
+        Shipment(
+            id=ids.new_id("shp"),
+            customer_id=shipment.customer_id,
+            weight_kg=weight,
+            zone=shipment.zone,
+            created_at=now,
+        )
+        for weight in weights
+    ]
+    for new in new_shipments:
+        db.shipments[new.id] = new
+    shipment.status = "split"
+    events.emit("shipment.split", shipment.id, new_ids=[s.id for s in new_shipments])
+    return new_shipments
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_split_shipment.py b/tests/unit/test_split_shipment.py
--- a/tests/unit/test_split_shipment.py	1969-12-31 19:00:00
+++ b/tests/unit/test_split_shipment.py	2026-11-12 03:05:40
@@ -0,0 +1,164 @@
+from datetime import datetime, timezone
+
+import pytest
+
+from parcelo import audit, clock, customers, events, ids, shipments, store
+from parcelo.errors import DomainError
+
+
+@pytest.fixture(autouse=True)
+def clean_state():
+    store.reset()
+    ids.reset()
+    audit.LOG.clear()
+    events.OUTBOX.clear()
+    clock.clear_fixed()
+    yield
+    store.reset()
+    ids.reset()
+    audit.LOG.clear()
+    events.OUTBOX.clear()
+    clock.clear_fixed()
+
+
+def _make_shipment(weight=10.0, zone="national"):
+    customer = customers.add_customer("Acme")
+    return shipments.create_shipment(customer.id, weight, zone)
+
+
+def _snapshot():
+    return (
+        {k: dict(v.__dict__) for k, v in store.db.shipments.items()},
+        len(audit.LOG),
+        len(events.OUTBOX),
+    )
+
+
+def test_returns_one_shipment_per_weight_in_order():
+    original = _make_shipment(10.0)
+    result = shipments.split_shipment(original.id, [3.0, 7.0])
+    assert [s.weight_kg for s in result] == [3.0, 7.0]
+    assert all(s.id.startswith("shp_") for s in result)
+    assert len({s.id for s in result} | {original.id}) == 3
+
+
+def test_new_shipments_keep_customer_and_zone():
+    original = _make_shipment(5.0, zone="international")
+    result = shipments.split_shipment(original.id, [2.0, 3.0])
+    for s in result:
+        assert s.customer_id == original.customer_id
+        assert s.zone == "international"
+        assert s.status == "created"
+        assert store.db.shipments[s.id] is s
+
+
+def test_original_is_marked_split():
+    original = _make_shipment(10.0)
+    shipments.split_shipment(original.id, [5.0, 5.0])
+    assert store.db.shipments[original.id].status == "split"
+
+
+def test_split_emits_event_with_new_ids():
+    original = _make_shipment(10.0)
+    result = shipments.split_shipment(original.id, [4.0, 6.0])
+    event = events.OUTBOX[-1]
+    assert event["name"] == "shipment.split"
+    assert event["entity_id"] == original.id
+    assert event["payload"] == {"new_ids": [s.id for s in result]}
+
+
+def test_split_event_timestamp_uses_clock():
+    moment = datetime(2026, 11, 12, 9, 30, tzinfo=timezone.utc)
+    original = _make_shipment(10.0)
+    clock.set_fixed(moment)
+    shipments.split_shipment(original.id, [10.0])
+    assert events.OUTBOX[-1]["at"] == moment
+
+
+def test_new_shipments_get_created_at_from_clock():
+    moment = datetime(2026, 11, 12, 9, 30, tzinfo=timezone.utc)
+    original = _make_shipment(10.0)
+    clock.set_fixed(moment)
+    result = shipments.split_shipment(original.id, [2.5, 7.5])
+    assert all(s.created_at == moment for s in result)
+
+
+def test