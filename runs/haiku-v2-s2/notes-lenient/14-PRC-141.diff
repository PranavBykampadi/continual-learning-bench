+def reassign_shipment(shipment_id, new_customer_id):
+    # Lookup order: existence, then state, then input validation.
+    shipment = get_shipment(shipment_id)
+    if shipment.delivered_at is not None or shipment.status == "delivered":
+        raise DomainError("E_BAD_STATE", shipment_id)
+    if new_customer_id not in db.customers:
+        raise DomainError("E_UNKNOWN_CUSTOMER", new_customer_id)
+    old_customer_id = shipment.customer_id
+    shipment.customer_id = new_customer_id
+    audit.record(
+        "shipments.reassign",
+        shipment.id,
+        from_customer=old_customer_id,
+        to_customer=new_customer_id,
+    )
+    return shipment
