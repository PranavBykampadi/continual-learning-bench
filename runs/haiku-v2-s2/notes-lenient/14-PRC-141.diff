+import pytest
+
+from parcelo import audit, clock, customers, ids, shipments, store
+from parcelo.errors import DomainError
+
+
+@pytest.fixture(autouse=True)
+def clean_state():
+    store.reset()
+    ids.reset()
+    audit.LOG.clear()
+    clock.clear_fixed()
+    yield
+    store.reset()
+    ids.reset()
+    audit.LOG.clear()
+    clock.clear_fixed()
+
+
+def _start():
+    """Return (shipment, original_customer, other_customer) built via public functions."""
+    original = customers.add_customer("Acme")
+    other = customers.add_customer("Beta")
+    shipment = shipments.create_shipment(original.id, 1.5, "national")
+    return shipment, original, other
+
+
+def _snapshot(shipment):
+    return (shipment.customer_id, shipment.status, shipment.delivered_at, len(audit.LOG))
+
+
+def test_reassign_changes_customer_and_returns_shipment():
+    shipment, original, other = _start()
+
+    result = shipments.reassign_shipment(shipment.id, other.id)
+
+    assert result is shipment
+    assert store.db.shipments[shipment.id].customer_id == other.id
+    assert result.customer_id != original.id
+
+
+def test_reassign_records_audit_entry():
+    shipment, original, other = _start()
+    before = len(audit.LOG)
+
+    shipments.reassign_shipment(shipment.id, other.id)
+
+    assert len(audit.LOG) == before + 1
+    entry = audit.LOG[-1]
+    assert entry["action"] == "shipments.reassign"
+    assert entry["entity_id"] == shipment.id
+    assert entry["details"] == {"from_customer": original.id, "to_customer": other.id}
+
+
+@pytest.mark.parametrize("bad_shipment_id", ["shp_missing", "", None])
+def test_unknown_shipment_fails_not_found(bad_shipment_id):
+    _, _, other = _start()
+    before_audit = len(audit.LOG)
+
+    with pytest.raises(DomainError) as err:
+        shipments.reassign_shipment(bad_shipment_id, other.id)
+
+    assert err.value.code == "E_NOT_FOUND"
+    assert len(audit.LOG) == before_audit
+
+
+@pytest.mark.parametrize("bad_customer_id", ["C_missing", "", None])
+def test_unknown_customer_fails_and_leaves_shipment_unchanged(bad_customer_id):
+    shipment, original, _ = _start()
+    before = _snapshot(shipment)
+
+    with pytest.raises(DomainError) as err:
+        shipments.reassign_shipment(shipment.id, bad_customer_id)
+
+    assert err.value.code == "E_UNKNOWN_CUSTOMER"
+    assert _snapshot(shipment) == before
+    assert shipment.customer_id == original.id
+
+
+def test_delivered_shipment_by_timestamp_fails_bad_state():
+    shipment, original, other = _start()
+    shipment.delivered_at = clock.now()
+    before = _snapshot(shipment)
+
+    with pytest.raises(DomainError) as err:
+        shipments.reassign_shipment(shipment.id, other.id)
+
+    assert err.value.code == "E_BAD_STATE"
+    assert _snapshot(shipment) == before
+    assert shipment.customer_id == original.id
+
+
+def test_delivered_shipment_by_status_fails_bad_state():
+    shipment, original, other = _start()
+    shipment.status = "delivered"
+    before = _snapshot(shipment)
+
+    with pytest.raises(DomainError) as err:
+        shipments.reassign_shipment(shipment.id, other.id)
+
+    assert err.value.code == "E_BAD_STATE"
+    assert _snapshot(shipment) == before
+    assert shipment.customer_id == original.id
+
+
+def test_missing_shipment_reported_before_unknown_customer():
+    with pytest.raises(DomainError) as err:
+        shipments.reassign_shipment("shp_missing", "C_missing")
+
+    assert err.value.code == "E_NOT_FOUND"
+
+
