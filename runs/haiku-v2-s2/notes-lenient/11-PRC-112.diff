diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_claims.py b/tests/unit/test_claims.py
--- a/tests/unit/test_claims.py	1969-12-31 19:00:00
+++ b/tests/unit/test_claims.py	2026-11-12 02:56:52
@@ -0,0 +1,83 @@
+from datetime import datetime
+from decimal import Decimal
+
+import pytest
+
+from parcelo import audit, claims, clock, customers, ids, shipments, store
+from parcelo.errors import DomainError
+from parcelo.money import Money
+
+
+@pytest.fixture(autouse=True)
+def clean_state():
+    store.reset()
+    ids.reset()
+    audit.LOG.clear()
+    clock.clear_fixed()
+    yield
+    store.reset()
+    ids.reset()
+    audit.LOG.clear()
+    clock.clear_fixed()
+
+
+def _shipment_with_status(status="delivered"):
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 1.5, "national")
+    store.db.shipments[s.id].status = status
+    return s
+
+
+def test_file_claim_on_delivered_shipment():
+    clock.set_fixed(datetime(2026, 11, 1, 12, 0))
+    s = _shipment_with_status()
+    claim = claims.file_claim(s.id, 15.00, "box damaged")
+    assert claim.id.startswith("clm_")
+    assert claim.shipment_id == s.id
+    assert claim.amount == Money(1500)
+    assert claim.reason == "box damaged"
+    assert claim.filed_at == datetime(2026, 11, 1, 12, 0)
+    assert store.db.claims[claim.id] is claim
+    assert audit.LOG[-1]["action"] == "claim.filed"
+
+
+def test_claim_amount_accepts_string_and_decimal_inputs():
+    s = _shipment_with_status()
+    assert claims.file_claim(s.id, "2.50", "late").amount == Money(250)
+    assert claims.file_claim(s.id, Decimal("0.99"), "late").amount == Money(99)
+
+
+def test_unknown_shipment_is_not_found():
+    with pytest.raises(DomainError) as err:
+        claims.file_claim("shp_missing", 5, "lost")
+    assert err.value.code == "E_NOT_FOUND"
+
+
+@pytest.mark.parametrize("status", ["created", "in_transit", "cancelled"])
+def test_only_delivered_shipments_can_have_claims(status):
+    s = _shipment_with_status(status=status)
+    with pytest.raises(DomainError) as err:
+        claims.file_claim(s.id, 5, "lost")
+    assert err.value.code == "E_BAD_STATE"
+    assert store.db.claims == {}
+
+
+@pytest.mark.parametrize(
+    "amount",
+    [0, -1, -0.01, 0.001, "0", "-3.00", "abc", "nan", None],
+)
+def test_invalid_amount_is_rejected(amount):
+    s = _shipment_with_status()
+    with pytest.raises(DomainError) as err:
+        claims.file_claim(s.id, amount, "damaged")
+    assert err.value.code == "E_BAD_INPUT"
+    assert store.db.claims == {}
+
+
+@pytest.mark.parametrize("reason", ["", "   ", None])
+def test_blank_reason_is_rejected(reason):
+    s = _shipment_with_status()
+    with pytest.raises(DomainError) as err:
+        claims.file_claim(s.id, 5, reason)
+    assert err.value.code == "E_BAD_INPUT"
+    assert store.db.claims == {}
