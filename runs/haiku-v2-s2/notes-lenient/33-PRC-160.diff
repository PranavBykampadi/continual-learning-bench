     if shipment_id not in db.shipments:
         raise DomainError("E_NOT_FOUND", shipment_id)
     return db.shipments[shipment_id]
+
+
+def mark_returned(shipment_id):
+    shipment = get_shipment(shipment_id)
+    if shipment.status in ("created", "returned"):
+        raise DomainError("E_BAD_STATE", f"{shipment_id} is {shipment.status}")
+    shipment.status = "returned"
+    shipment.returned_at = clock.now()
+    return shipment
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_returns.py b/tests/unit/test_returns.py
--- a/tests/unit/test_returns.py	1969-12-31 19:00:00
+++ b/tests/unit/test_returns.py	2026-11-12 03:13:52
@@ -0,0 +1,114 @@
+import copy
+from datetime import datetime, timezone
+
+import pytest
+
+from parcelo import audit, clock, customers, events, ids, shipments, store
+from parcelo.errors import DomainError
+
+FIXED_NOW = datetime(2026, 11, 12, 9, 30, tzinfo=timezone.utc)
+
+
+@pytest.fixture(autouse=True)
+def clean_state():
+    store.reset()
+    ids.reset()
+    audit.LOG.clear()
+    events.OUTBOX.clear()
+    clock.clear_fixed()
+    yield
+    store.reset()
+    ids.reset()
+    audit.LOG.clear()
+    events.OUTBOX.clear()
+    clock.clear_fixed()
+
+
+def snapshot():
+    return (
+        copy.deepcopy(vars(store.db)),
+        len(audit.LOG),
+        copy.deepcopy(events.OUTBOX),
+    )
+
+
+def make_shipment():
+    c = customers.add_customer("Acme")
+    return shipments.create_shipment(c.id, 2.0, "national")
+
+
+def make_delivered_shipment():
+    s = make_shipment()
+    s.status = "delivered"
+    s.delivered_at = datetime(2026, 11, 1, 12, 0, tzinfo=timezone.utc)
+    return s
+
+
+def test_marks_delivered_shipment_returned():
+    s = make_delivered_shipment()
+    clock.set_fixed(FIXED_NOW)
+    result = shipments.mark_returned(s.id)
+    assert result is s
+    assert s.status == "returned"
+    assert s.returned_at == FIXED_NOW
+    assert store.db.shipments[s.id].status == "returned"
+
+
+def test_returned_at_defaults_to_none_before_return():
+    s = make_delivered_shipment()
+    assert s.returned_at is None
+
+
+def test_created_shipment_cannot_be_returned():
+    s = make_shipment()
+    before = snapshot()
+    with pytest.raises(DomainError) as err:
+        shipments.mark_returned(s.id)
+    assert err.value.code == "E_BAD_STATE"
+    assert s.status == "created"
+    assert s.returned_at is None
+    assert snapshot() == before
+
+
+def test_already_returned_shipment_cannot_be_returned_twice():
+    s = make_delivered_shipment()
+    clock.set_fixed(FIXED_NOW)
+    shipments.mark_returned(s.id)
+    before = snapshot()
+    clock.set_fixed(datetime(2026, 11, 13, 9, 0, tzinfo=timezone.utc))
+    with pytest.raises(DomainError) as err:
+        shipments.mark_returned(s.id)
+    assert err.value.code == "E_BAD_STATE"
+    assert s.returned_at == FIXED_NOW
+    assert snapshot() == before
+
+
+@pytest.mark.parametrize(
+    "bad_id",
+    ["nope", "", "   ", None, True, 0, -1, float("nan")],
+)
+def test_unknown_or_invalid_id_is_not_found(bad_id):
+    make_delivered_shipment()
+    before = snapshot()
+    with pytest.raises(DomainError) as err:
+        shipments.mark_returned(bad_id)
+    assert err.value.code == "E_NOT_FOUND"
+    assert snapshot() == before
+
+
+def test_empty_store_is_not_found():
+    before = snapshot()
+    with pytest.raises(DomainError) as err:
+        shipments.mark_returned("shp_000001")
+    assert err.value.code == "E_NOT_FOUND"
+    assert snapshot() == before
+
+
+def test_return_emits_no_extra_outbox_or_audit_entries_on_failure():
+    s = make_shipment()
+    outbox_len = len(events.OUTBOX)
+    audit_len = len(audit.LOG)
+    with pytest.raises(DomainError):
+        shipments.mark_returned(s.id)
+    assert len(events.OUTBOX) == outbox_len
+    assert len(audit.LOG) == audit_len
