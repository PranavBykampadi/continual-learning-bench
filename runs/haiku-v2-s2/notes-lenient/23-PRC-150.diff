+def _parse_credit_limit(amount):
+    """Validate a credit limit and return it as Money. Raises E_BAD_INPUT."""
+    if amount is None or isinstance(amount, bool):
+        raise DomainError("E_BAD_INPUT", "credit limit must be a number")
+    try:
+        value = Decimal(str(amount))
+    except (InvalidOperation, ValueError):
+        raise DomainError("E_BAD_INPUT", "credit limit must be a number")
+    if not value.is_finite():
+        raise DomainError("E_BAD_INPUT", "credit limit must be finite")
+    if value < 0:
+        raise DomainError("E_BAD_INPUT", "credit limit must not be negative")
+    if value.as_tuple().exponent < -2:
+        raise DomainError("E_BAD_INPUT", "credit limit must not have sub-cent precision")
+    return Money.parse(value)
+
+
+def set_credit_limit(customer_id, amount):
+    """Set a customer's credit limit and return the new limit as Money."""
+    if customer_id not in db.customers:
+        raise DomainError("E_UNKNOWN_CUSTOMER", str(customer_id))
+    limit = _parse_credit_limit(amount)
+    customer = db.customers[customer_id]
+    previous = customer.credit_limit
+    customer.credit_limit = limit
+    events.emit(
+        "customer.credit_limit_set",
+        customer_id,
+        previous=str(previous),
+        limit=str(limit),
+    )
+    return limit
 
 
