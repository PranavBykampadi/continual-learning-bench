diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_credit_limit.py b/tests/unit/test_credit_limit.py
--- a/tests/unit/test_credit_limit.py	1969-12-31 19:00:00
+++ b/tests/unit/test_credit_limit.py	2026-11-12 03:06:30
@@ -0,0 +1,90 @@
+import pytest
+
+from parcelo import audit, customers, events, store
+from parcelo.errors import DomainError
+from parcelo.money import Money
+
+
+def _customer():
+    return customers.add_customer("Acme")
+
+
+def _snapshot(customer):
+    return (customer.credit_limit, len(store.db.customers), len(audit.LOG), len(events.OUTBOX))
+
+
+def test_set_credit_limit_returns_money_and_updates_customer():
+    c = _customer()
+    limit = customers.set_credit_limit(c.id, "1250.50")
+    assert isinstance(limit, Money)
+    assert limit == Money(125050)
+    assert customers.get_customer(c.id).credit_limit == Money(125050)
+
+
+def test_set_credit_limit_accepts_zero():
+    c = _customer()
+    assert customers.set_credit_limit(c.id, 0) == Money(0)
+
+
+def test_set_credit_limit_emits_event_with_name_id_and_payload():
+    c = _customer()
+    customers.set_credit_limit(c.id, 900)
+    event = events.OUTBOX[-1]
+    assert event["name"] == "customer.credit_limit_set"
+    assert event["entity_id"] == c.id
+    assert event["payload"] == {"previous": "500.00 USD", "limit": "900.00 USD"}
+
+
+def test_set_credit_limit_does_not_write_audit_directly():
+    c = _customer()
+    customers.set_credit_limit(c.id, 900)
+    assert len(audit.LOG) == 0
+
+
+def test_set_credit_limit_unknown_customer():
+    with pytest.raises(DomainError) as err:
+        customers.set_credit_limit("C-missing", 100)
+    assert err.value.code == "E_UNKNOWN_CUSTOMER"
+
+
+def test_unknown_customer_leaves_store_unchanged():
+    c = _customer()
+    before = _snapshot(customers.get_customer(c.id))
+    with pytest.raises(DomainError):
+        customers.set_credit_limit("C-missing", 100)
+    assert _snapshot(customers.get_customer(c.id)) == before
+
+
+def test_negative_amount_rejected():
+    c = _customer()
+    with pytest.raises(DomainError) as err:
+        customers.set_credit_limit(c.id, -1)
+    assert err.value.code == "E_BAD_INPUT"
+
+
+@pytest.mark.parametrize(
+    "bad",
+    [
+        -0.01,
+        -100,
+        "-5",
+        "",
+        "   ",
+        "abc",
+        None,
+        True,
+        False,
+        float("nan"),
+        float("inf"),
+        float("-inf"),
+        "1.005",
+        0.001,
+    ],
+)
+def test_invalid_amounts_rejected_and_state_unchanged(bad):
+    c = _customer()
+    before = _snapshot(customers.get_customer(c.id))
+    with pytest.raises(DomainError) as err:
+        customers.set_credit_limit(c.id, bad)
+    assert err.value.code == "E_BAD_INPUT"
+    assert _snapshot