+
+def aging_report():
+    """Total open invoice amounts (in dollars) bucketed by age in whole days."""
+    now = _as_utc(clock.now())
+    cents = {"0-30": 0, "31-60": 0, "60+": 0}
+    for invoice in db.invoices.values():
+        if invoice.status != "open":
+            continue
+        age = days_between(_as_utc(invoice.issued_at), now)
+        if age <= 30:
+            bucket = "0-30"
+        elif age <= 60:
+            bucket = "31-60"
+        else:
+            bucket = "60+"
+        cents[bucket] += Money.parse(invoice.amount).cents
+    return {bucket: round(total / 100, 2) for bucket, total in cents.items()}
 
 
