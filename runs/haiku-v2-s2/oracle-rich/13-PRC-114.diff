-from datetime import datetime
+from datetime import datetime, timezone
 
+from parcelo import clock
+from parcelo.money import Money
 from parcelo.store import db
+
+
+def _as_utc(moment):
+    # Invoices issued by older code carry naive UTC datetimes; clock.now() is aware.
+    if moment.tzinfo is None:
+        return moment.replace(tzinfo=timezone.utc)
+    return moment
+
+
+def _whole_days_between(start, end):
+    return (_as_utc(end) - _as_utc(start)).days
+
+
+def aging_report():
+    """Totals of open invoices grouped by age in whole days since issue."""
+    now = clock.now()
+    totals = {"0-30": Money.zero(), "31-60": Money.zero(), "60+": Money.zero()}
+    for invoice in db.invoices.values():
+        if invoice.status == "paid":
+            continue
+        age = _whole_days_between(invoice.issued_at, now)
+        if age <= 30:
+            bucket = "0-30"
+        elif age <= 60:
+            bucket = "31-60"
+        else:
+            bucket = "60+"
+        totals[bucket] = totals[bucket] + Money.parse(invoice.amount)
+    return totals
 
 
