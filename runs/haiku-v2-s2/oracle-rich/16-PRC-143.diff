diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_pickups.py b/tests/unit/test_pickups.py
--- a/tests/unit/test_pickups.py	1969-12-31 19:00:00
+++ b/tests/unit/test_pickups.py	2026-11-12 02:57:27
@@ -0,0 +1,63 @@
+import pytest
+
+from parcelo import clock, customers, events, pickups, shipments, store
+from parcelo.errors import DomainError
+from parcelo.models import Pickup
+
+
+def _created_shipment():
+    c = customers.add_customer("Acme")
+    return shipments.create_shipment(c.id, 1.5, "national")
+
+
+def test_schedule_pickup_creates_and_stores():
+    s = _created_shipment()
+    window = "2026-11-13T09:00"
+    p = pickups.schedule_pickup(s.id, window)
+    assert isinstance(p, Pickup)
+    assert p.id.startswith("pck_")
+    assert p.shipment_id == s.id
+    assert p.window_start == window
+    assert p.scheduled_at is not None
+    assert store.db.pickups[p.id] is p
+
+
+def test_scheduled_at_uses_clock():
+    moment = clock.now()
+    clock.set_fixed(moment)
+    s = _created_shipment()
+    p = pickups.schedule_pickup(s.id, "w")
+    assert p.scheduled_at == moment
+
+
+def test_schedule_emits_event():
+    s = _created_shipment()
+    events.OUTBOX.clear()
+    p = pickups.schedule_pickup(s.id, "w")
+    assert events.OUTBOX[-1]["name"] == "pickup.scheduled"
+    assert events.OUTBOX[-1]["entity_id"] == p.id
+    assert events.OUTBOX[-1]["payload"] == {"shipment_id": s.id}
+
+
+def test_unknown_shipment_fails():
+    with pytest.raises(DomainError) as err:
+        pickups.schedule_pickup("shp_missing", "w")
+    assert err.value.code == "E_NOT_FOUND"
+    assert store.db.pickups == {}
+
+
+@pytest.mark.parametrize("status", ["delivered", "cancelled", "in_transit"])
+def test_shipment_not_created_fails(status):
+    s = _created_shipment()
+    s.status = status
+    with pytest.raises(DomainError) as err:
+        pickups.schedule_pickup(s.id, "w")
+    assert err.value.code == "E_BAD_STATE"
+    assert store.db.pickups == {}
+
+
+def test_reset_clears_pickups():
+    s = _created_shipment()
+    pickups.schedule_pickup(s.id, "w")
+    store.reset()
+    assert store.db.pickups == {}
