diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_reopen_invoice.py b/tests/unit/test_reopen_invoice.py
--- a/tests/unit/test_reopen_invoice.py	1969-12-31 19:00:00
+++ b/tests/unit/test_reopen_invoice.py	2026-11-12 02:57:03
@@ -0,0 +1,50 @@
+import pytest
+
+from parcelo import clock, events, invoices
+from parcelo.errors import DomainError
+from parcelo.models import Invoice
+from parcelo.store import db
+
+
+def _paid_invoice(invoice_id="INV-T1"):
+    inv = Invoice(id=invoice_id, shipment_id="shp_x", amount=7.0, status="paid", paid_at="2026-01-01")
+    db.invoices[inv.id] = inv
+    return inv
+
+
+def test_reopen_paid_invoice_sets_open_clears_paid_at_and_stamps_time():
+    moment = clock.now()
+    clock.set_fixed(moment)
+    inv = _paid_invoice()
+
+    result = invoices.reopen_invoice(inv.id)
+
+    assert result is inv
+    assert inv.status == "open"
+    assert inv.paid_at is None
+    assert inv.reopened_at == moment
+    assert invoices.open_invoices() == [inv]
+
+
+def test_reopen_emits_event():
+    _paid_invoice()
+    invoices.reopen_invoice("INV-T1")
+    assert events.OUTBOX[-1]["name"] == "invoice.reopened"
+    assert events.OUTBOX[-1]["entity_id"] == "INV-T1"
+
+
+def test_reopen_unknown_invoice_raises_not_found():
+    with pytest.raises(DomainError) as err:
+        invoices.reopen_invoice("INV-missing")
+    assert err.value.code == "E_NOT_FOUND"
+    assert events.OUTBOX == []
+
+
+def test_reopen_unpaid_invoice_raises_bad_state():
+    inv = Invoice(id="INV-T2", shipment_id="shp_x", amount=7.0, status="open")
+    db.invoices[inv.id] = inv
+    with pytest.raises(DomainError) as err:
+        invoices.reopen_invoice(inv.id)
+    assert err.value.code == "E_BAD_STATE"
+    assert inv.reopened_at is None
+    assert events.OUTBOX == []
