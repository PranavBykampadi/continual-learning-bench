+def insurance_fee(declared_value, zone):
+    """Insurance fee as Money: (insurance rate + zone fuel surcharge) of the declared value, floored at the minimum fee."""
+    if zone not in FUEL_SURCHARGE_PCT:
+        raise DomainError("E_BAD_ZONE", "unknown zone: %s" % (zone,))
+    try:
+        value = Money.parse(declared_value)
+    except (ArithmeticError, TypeError, ValueError):
+        raise DomainError("E_BAD_INPUT", "declared value is not a number: %r" % (declared_value,))
+    if value.cents <= 0:
+        raise DomainError("E_BAD_INPUT", "declared value must be positive")
+    total_pct = Decimal(str(INSURANCE_RATE_PCT)) + Decimal(str(FUEL_SURCHARGE_PCT[zone]))
+    fee = value.scale(total_pct / Decimal(100))
+    if fee < INSURANCE_MIN_FEE:
+        return INSURANCE_MIN_FEE
+    return fee
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/parcelo/settings.py b/parcelo/settings.py
--- a/parcelo/settings.py	1969-12-31 19:00:00
+++ b/parcelo/settings.py	2026-11-12 02:57:49
@@ -0,0 +1,12 @@
+"""Business thresholds, limits and rates used by new code."""
+from parcelo.money import Money
+
+# Insurance fee: percentage of the declared value, before the fuel surcharge.
+INSURANCE_RATE_PCT = 2.0
+
+# Floor for any insurance fee.
+INSURANCE_MIN_FEE = Money(100)  # 1.00 USD
+
+# Fuel surcharge percentage of the declared value, per zone.
+# Same values as the legacy fuel_surcharge table in parcelo/legacy/billing.py.
+FUEL_SURCHARGE_PCT = {"local": 0.0, "national": 4.0, "international": 9.5}
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_insurance.py b/tests/unit/test_insurance.py
--- a/tests/unit/test_insurance.py	1969-12-31 19:00:00
+++ b/tests/unit/test_insurance.py	2026-11-12 02:58:00
@@ -0,0 +1,60 @@
+import pytest
+
+from parcelo import rates
+from parcelo.errors import DomainError
+from parcelo.money import Money
+
+
+def test_local_fee_is_rate_only():
+    # local has no fuel surcharge: 2% of 100.00
+    assert rates.insurance_fee(100, "local") == Money(200)
+
+
+def test_national_fee_adds_fuel_surcharge():
+    # 2% + 4% of 100.00
+    assert rates.insurance_fee(100, "national") == Money(600)
+
+
+def test_international_fee_uses_fractional_surcharge():
+    # 2% + 9.5% of 100.00
+    assert rates.insurance_fee(100, "international") == Money(1150)
+
+
+def test_float_declared_value_is_parsed_to_money():
+    # 2% + 4% of 250.50 = 15.03
+    fee = rates.insurance_fee(250.50, "national")
+    assert isinstance(fee, Money)
+    assert fee == Money(1503)
+
+
+def test_money_declared_value_accepted():
+    assert rates.insurance_fee(Money(10000), "national") == Money(600)
+
+
+def test_minimum_fee_applied():
+    # 2% of 10.00 is 0.20, floored to 1.00
+    assert rates.insurance_fee(10, "local") == Money(100)
+
+
+def test_fee_just_above_minimum_not_floored():
+    # 2% of 60.00 is 1.20, above the minimum
+    assert rates.insurance_fee(60, "local") == Money(120)
+
+
+def test_unknown_zone_fails():
+    with pytest.raises(DomainError) as err:
+        rates.insurance_fee(100, "moon")
+    assert err.value.code == "E_BAD_ZONE"
+
+
+@pytest.mark.parametrize("value", [0, -5, -0.01, Money(0), Money(-100)])
+def test_non_positive_declared_value_fails(value):
+    with pytest.raises(DomainError) as err:
+        rates.insurance_fee(value, "national")
+    assert err.value.code == "E_BAD_INPUT"
+
+
+def test_non_numeric_declared_value_fails():
+    with pytest.raises(DomainError) as err:
+        rates.insurance_fee("abc", "national")
+    assert err.value.code == "E_BAD_INPUT"
