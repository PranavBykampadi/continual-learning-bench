diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/parcelo/shipments.py b/parcelo/shipments.py
--- a/parcelo/shipments.py	2026-11-10 12:20:18
+++ b/parcelo/shipments.py	2026-11-12 02:56:26
@@ -28,3 +28,25 @@
     if shipment_id not in db.shipments:
         raise DomainError("E_NOT_FOUND", shipment_id)
     return db.shipments[shipment_id]
+
+
+DELIVERED_STATUS = "delivered"
+
+
+def reassign_shipment(shipment_id, new_customer_id):
+    shipment = get_shipment(shipment_id)
+    if shipment.status == DELIVERED_STATUS:
+        raise DomainError("E_BAD_STATE", shipment_id)
+    if new_customer_id not in db.customers:
+        raise DomainError("E_UNKNOWN_CUSTOMER", new_customer_id)
+    if shipment.customer_id == new_customer_id:
+        return shipment
+    old_customer_id = shipment.customer_id
+    shipment.customer_id = new_customer_id
+    events.emit(
+        "shipment.reassigned",
+        shipment.id,
+        old_customer_id=old_customer_id,
+        new_customer_id=new_customer_id,
+    )
+    return shipment
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_reassign_shipment.py b/tests/unit/test_reassign_shipment.py
--- a/tests/unit/test_reassign_shipment.py	1969-12-31 19:00:00
+++ b/tests/unit/test_reassign_shipment.py	2026-11-12 02:56:29
@@ -0,0 +1,65 @@
+import pytest
+
+from parcelo import customers, events, shipments
+from parcelo.errors import DomainError
+
+
+def _shipment(customer_id):
+    return shipments.create_shipment(customer_id, 2.0, "national")
+
+
+def test_reassign_changes_customer_and_emits_event():
+    a = customers.add_customer("Acme")
+    b = customers.add_customer("Globex")
+    s = _shipment(a.id)
+    events.OUTBOX.clear()
+
+    result = shipments.reassign_shipment(s.id, b.id)
+
+    assert result is s
+    assert s.customer_id == b.id
+    assert events.OUTBOX[-1]["name"] == "shipment.reassigned"
+    assert events.OUTBOX[-1]["entity_id"] == s.id
+    assert events.OUTBOX[-1]["payload"] == {
+        "old_customer_id": a.id,
+        "new_customer_id": b.id,
+    }
+
+
+def test_reassign_same_customer_is_noop():
+    a = customers.add_customer("Acme")
+    s = _shipment(a.id)
+    events.OUTBOX.clear()
+
+    result = shipments.reassign_shipment(s.id, a.id)
+
+    assert result is s
+    assert s.customer_id == a.id
+    assert events.OUTBOX == []
+
+
+def test_reassign_unknown_shipment_fails():
+    b = customers.add_customer("Globex")
+    with pytest.raises(DomainError) as err:
+        shipments.reassign_shipment("shp_999999", b.id)
+    assert err.value.code == "E_NOT_FOUND"
+
+
+def test_reassign_to_unknown_customer_fails():
+    a = customers.add_customer("Acme")
+    s = _shipment(a.id)
+    with pytest.raises(DomainError) as err:
+        shipments.reassign_shipment(s.id, "C_missing")
+    assert err.value.code == "E_UNKNOWN_CUSTOMER"
+    assert s.customer_id == a.id
+
+
+def test_reassign_delivered_shipment_fails():
+    a = customers.add_customer("Acme")
+    b = customers.add_customer("Globex")
+    s = _shipment(a.id)
+    s.status = "delivered"
+    with pytest.raises(DomainError) as err:
+        shipments.reassign_shipment(s.id, b.id)
+    assert err.value.code == "E_BAD_STATE"
+    assert s.customer_id == a.id
