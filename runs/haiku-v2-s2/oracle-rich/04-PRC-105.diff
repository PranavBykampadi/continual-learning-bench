diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_refunds.py b/tests/unit/test_refunds.py
--- a/tests/unit/test_refunds.py	1969-12-31 19:00:00
+++ b/tests/unit/test_refunds.py	2026-11-12 02:50:45
@@ -0,0 +1,55 @@
+import pytest
+
+from parcelo import audit, refunds
+from parcelo.errors import DomainError
+from parcelo.models import Invoice
+from parcelo.money import Money
+from parcelo.store import db
+
+
+def _invoice(invoice_id="INV-test0001", status="paid"):
+    invoice = Invoice(id=invoice_id, shipment_id="shp_x", amount=20.0, status=status)
+    db.invoices[invoice.id] = invoice
+    return invoice
+
+
+def test_create_refund_for_paid_invoice():
+    _invoice()
+    r = refunds.create_refund("INV-test0001", 5.25)
+    assert r.id.startswith("ref_")
+    assert r.invoice_id == "INV-test0001"
+    assert r.amount == Money(525)
+    assert r.created_at is not None
+    assert db.refunds[r.id] is r
+
+
+def test_refund_is_audited_against_refund_id():
+    _invoice()
+    r = refunds.create_refund("INV-test0001", "3.00")
+    assert audit.LOG[-1]["action"] == "refund.created"
+    assert audit.LOG[-1]["entity_id"] == r.id
+
+
+def test_unknown_invoice_fails():
+    with pytest.raises(DomainError) as err:
+        refunds.create_refund("INV-missing", 1)
+    assert err.value.code == "E_NOT_FOUND"
+    assert db.refunds == {}
+
+
+@pytest.mark.parametrize("status", ["open", "void"])
+def test_unpaid_invoice_cannot_be_refunded(status):
+    _invoice(status=status)
+    with pytest.raises(DomainError) as err:
+        refunds.create_refund("INV-test0001", 1)
+    assert err.value.code == "E_BAD_STATE"
+    assert db.refunds == {}
+
+
+@pytest.mark.parametrize("amount", [0, -1, "abc", None])
+def test_non_positive_or_invalid_amount_rejected(amount):
+    _invoice()
+    with pytest.raises(DomainError) as err:
+        refunds.create_refund("INV-test0001", amount)
+    assert err.value.code == "E_BAD_INPUT"
+    assert db.refunds == {}
