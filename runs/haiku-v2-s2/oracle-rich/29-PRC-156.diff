+"""Business thresholds, limits and rates used by new code."""
+
+# Parcels above this weight (kg) pay the heavy surcharge (PRC-156).
+HEAVY_THRESHOLD_KG = 30
+
+# Surcharge in dollars per kg above HEAVY_THRESHOLD_KG (PRC-156).
+HEAVY_SURCHARGE_PER_KG = 0.75
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_heavy_quote.py b/tests/unit/test_heavy_quote.py
--- a/tests/unit/test_heavy_quote.py	1969-12-31 19:00:00
+++ b/tests/unit/test_heavy_quote.py	2026-11-12 03:05:01
@@ -0,0 +1,41 @@
+import pytest
+
+from parcelo import rates
+from parcelo.errors import DomainError
+from parcelo.money import Money
+
+
+def test_at_threshold_is_normal_quote():
+    assert rates.heavy_quote(30, "local") == Money(4200)
+
+
+def test_below_threshold_is_normal_quote():
+    assert rates.heavy_quote(2, "local") == Money(700)
+
+
+def test_surcharge_per_kg_above_threshold():
+    # national: 9.00 + 1.25 * 32 = 49.00, plus 2 kg * 0.75 = 1.50
+    assert rates.heavy_quote(32, "national") == Money(5050)
+
+
+def test_fractional_kg_above_threshold():
+    # local: 4.50 + 1.25 * 31 = 43.25, plus 1 kg * 0.75 = 0.75
+    assert rates.heavy_quote(31, "local") == Money(4400)
+
+
+def test_returns_money_not_float():
+    result = rates.heavy_quote(40, "international")
+    assert isinstance(result, Money)
+
+
+def test_unknown_zone():
+    with pytest.raises(DomainError) as err:
+        rates.heavy_quote(40, "moon")
+    assert err.value.code == "E_BAD_ZONE"
+
+
+@pytest.mark.parametrize("weight", [0, -1])
+def test_weight_must_be_positive(weight):
+    with pytest.raises(DomainError) as err:
+        rates.heavy_quote(weight, "local")
+    assert err.value.code == "E_BAD_WEIGHT"
