@@ -32,3 +35,14 @@
 
 def open_invoices():
     return [i for i in db.invoices.values() if i.status == "open"]
+
+
+def invoices_by_status(status):
+    """Return invoices with the given status, sorted by id ascending.
+
+    Only "open" and "paid" are accepted; anything else raises E_BAD_INPUT.
+    """
+    if status not in VALID_INVOICE_STATUSES:
+        raise DomainError("E_BAD_INPUT", f"invoice status {status!r}")
+    matches = [i for i in db.invoices.values() if i.status == status]
+    return sorted(matches, key=lambda i: i.id)
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_invoices_by_status.py b/tests/unit/test_invoices_by_status.py
--- a/tests/unit/test_invoices_by_status.py	1969-12-31 19:00:00
+++ b/tests/unit/test_invoices_by_status.py	2026-11-12 03:17:10
@@ -0,0 +1,46 @@
+import pytest
+
+from parcelo import customers, invoices, shipments
+from parcelo.errors import DomainError
+
+
+def _issue(n):
+    c = customers.add_customer("Acme")
+    return [
+        invoices.issue_invoice(shipments.create_shipment(c.id, 2, "local").id)
+        for _ in range(n)
+    ]
+
+
+def test_returns_only_matching_status():
+    a, b, c = _issue(3)
+    invoices.mark_paid(b.id)
+    open_ids = [i.id for i in invoices.invoices_by_status("open")]
+    paid_ids = [i.id for i in invoices.invoices_by_status("paid")]
+    assert sorted(open_ids) == sorted([a.id, c.id])
+    assert paid_ids == [b.id]
+
+
+def test_empty_when_none_match():
+    _issue(2)
+    assert invoices.invoices_by_status("paid") == []
+
+
+def test_empty_when_no_invoices():
+    assert invoices.invoices_by_status("open") == []
+
+
+def test_sorted_by_id_ascending():
+    _issue(5)
+    result = invoices.invoices_by_status("open")
+    ids = [i.id for i in result]
+    assert len(ids) == 5
+    assert ids == sorted(ids)
+
+
+@pytest.mark.parametrize("bad", ["OPEN", "void", "", None, ["open"]])
+def test_invalid_status_raises_bad_input(bad):
+    _issue(1)
+    with pytest.raises(DomainError) as err:
+        invoices.invoices_by_status(bad)
+    assert err.value.code == "E_BAD_INPUT"
