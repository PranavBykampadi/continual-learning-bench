+"""Business thresholds, limits and rates used by new code."""
+
+# Volume rebate (PRC-161): share of a customer's paid invoices, by shipment count.
+REBATE_TIER1_MIN_SHIPMENTS = 10
+REBATE_TIER1_RATE = 0.03
+REBATE_TIER2_MIN_SHIPMENTS = 50
+REBATE_TIER2_RATE = 0.06
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_rebate.py b/tests/unit/test_rebate.py
--- a/tests/unit/test_rebate.py	1969-12-31 19:00:00
+++ b/tests/unit/test_rebate.py	2026-11-12 03:16:46
@@ -0,0 +1,90 @@
+import pytest
+
+from parcelo import customers
+from parcelo.errors import DomainError
+from parcelo.models import Invoice, Shipment
+from parcelo.money import Money
+from parcelo.store import db
+
+
+def _add_shipments(customer_id, count):
+    ids_added = []
+    for i in range(count):
+        sid = f"shp_{customer_id}_{i:03d}"
+        db.shipments[sid] = Shipment(id=sid, customer_id=customer_id, weight_kg=1.0, zone="local")
+        ids_added.append(sid)
+    return ids_added
+
+
+def _add_invoice(shipment_id, amount, status):
+    inv_id = f"INV-{shipment_id}"
+    db.invoices[inv_id] = Invoice(id=inv_id, shipment_id=shipment_id, amount=amount, status=status)
+
+
+def test_unknown_customer_raises():
+    with pytest.raises(DomainError) as err:
+        customers.rebate_for("C_missing")
+    assert err.value.code == "E_UNKNOWN_CUSTOMER"
+
+
+def test_zero_below_ten_shipments_even_with_paid_invoices():
+    c = customers.add_customer("Small")
+    sids = _add_shipments(c.id, 9)
+    _add_invoice(sids[0], 100.0, "paid")
+
+    result = customers.rebate_for(c.id)
+
+    assert isinstance(result, Money)
+    assert result == Money.zero()
+
+
+def test_three_percent_at_ten_shipments():
+    c = customers.add_customer("Regular")
+    sids = _add_shipments(c.id, 10)
+    _add_invoice(sids[0], 100.0, "paid")
+    _add_invoice(sids[1], 50.25, "paid")
+
+    result = customers.rebate_for(c.id)
+
+    # paid total 150.25 -> 3% = 4.5075 -> 4.51
+    assert result == Money(451)
+
+
+def test_six_percent_at_fifty_shipments():
+    c = customers.add_customer("Bulk")
+    sids = _add_shipments(c.id, 50)
+    _add_invoice(sids[0], 100.0, "paid")
+    _add_invoice(sids[1], 50.0, "paid")
+
+    result = customers.rebate_for(c.id)
+
+    # paid total 150.00 -> 6% = 9.00
+    assert result == Money(900)
+
+
+def test_open_invoices_do_not_count():
+    c = customers.add_customer("Owes")
+    sids = _add_shipments(c.id, 10)
+    _add_invoice(sids[0], 100.0, "paid")
+    _add_invoice(sids[1], 1000.0, "open")
+
+    assert customers.rebate_for(c.id) == Money(300)
+
+
+def test_other_customers_invoices_do_not_count():
+    a = customers.add_customer("A")
+    b = customers.add_customer("B")
+    a_sids = _add_shipments(a.id, 10)
+    b_sids = _add_shipments(b.id, 1)
+    _add_invoice(a_sids[0], 100.0, "paid")
+    _add_invoice(b_sids[0], 999.0, "paid")
+
+    assert customers.rebate_for(a.id) == Money(300)
+    assert customers.rebate_for(b.id) == Money.zero()
+
+
+def test_no_paid_invoices_gives_zero():
+    c = customers.add_customer("Nopay")
+    _add_shipments(c.id, 60)
+
+    assert customers.rebate_for(c.id) == Money.zero()
