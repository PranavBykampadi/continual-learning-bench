+def rebate_for(customer_id):
+    """Volume rebate earned so far: a share of the customer's paid invoices.
+
+    Returns Money. Zero below REBATE_TIER1_MIN_SHIPMENTS shipments.
+    Raises DomainError E_UNKNOWN_CUSTOMER if the customer does not exist.
+    """
+    if customer_id not in db.customers:
+        raise DomainError("E_UNKNOWN_CUSTOMER", customer_id)
+
+    shipment_count = 0
+    for shipment in db.shipments.values():
+        if shipment.customer_id == customer_id:
+            shipment_count += 1
+
+    if shipment_count >= REBATE_TIER2_MIN_SHIPMENTS:
+        rate = REBATE_TIER2_RATE
+    elif shipment_count >= REBATE_TIER1_MIN_SHIPMENTS:
+        rate = REBATE_TIER1_RATE
+    else:
+        return Money.zero()
+
+    paid_total = Money.zero()
+    for invoice in db.invoices.values():
+        shipment = db.shipments[invoice.shipment_id]
+        if shipment.customer_id == customer_id and invoice.status == "paid":
+            paid_total = paid_total + Money.parse(invoice.amount)
+
+    return paid_total.scale(rate)
