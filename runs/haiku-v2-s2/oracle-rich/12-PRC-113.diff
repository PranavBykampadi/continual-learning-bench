+import pytest
+
+from parcelo import audit, customers, invoices, reports, shipments
+from parcelo.errors import DomainError
+from parcelo.money import Money
+
+
+def _open_invoice(weight=2, zone="local"):
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, weight, zone)
+    return c, invoices.issue_invoice(s.id)
+
+
+def test_apply_credit_reduces_open_invoice():
+    _, inv = _open_invoice()  # quote is 7.00
+    remaining = invoices.apply_credit(inv.id, 2.5)
+    assert remaining == Money(450)
+    assert invoices.db.invoices[inv.id].amount == Money(450)
+    assert invoices.db.invoices[inv.id].status == "open"
+
+
+def test_apply_credit_records_audit():
+    _, inv = _open_invoice()
+    invoices.apply_credit(inv.id, Money(100))
+    entry = audit.LOG[-1]
+    assert entry["action"] == "invoice.credit_applied"
+    assert entry["entity_id"] == inv.id
+    assert entry["details"] == {"credit_cents": 100, "remaining_cents": 600}
+
+
+def test_apply_credit_unknown_invoice():
+    with pytest.raises(DomainError) as err:
+        invoices.apply_credit("INV-missing", 1)
+    assert err.value.code == "E_NOT_FOUND"
+
+
+def test_apply_credit_to_paid_invoice_fails():
+    _, inv = _open_invoice()
+    invoices.mark_paid(inv.id)
+    with pytest.raises(DomainError) as err:
+        invoices.apply_credit(inv.id, 1)
+    assert err.value.code == "E_BAD_STATE"
+
+
+def test_apply_credit_larger_than_amount_fails():
+    _, inv = _open_invoice()
+    with pytest.raises(DomainError) as err:
+        invoices.apply_credit(inv.id, 7.01)
+    assert err.value.code == "E_BAD_INPUT"
+    assert invoices.db.invoices[inv.id].amount == 7.0
+
+
