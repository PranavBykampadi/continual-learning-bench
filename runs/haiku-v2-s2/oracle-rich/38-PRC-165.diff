diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_reports.py b/tests/unit/test_reports.py
--- a/tests/unit/test_reports.py	1969-12-31 19:00:00
+++ b/tests/unit/test_reports.py	2026-11-12 03:18:11
@@ -0,0 +1,37 @@
+from parcelo import reports
+from parcelo.models import Invoice, Shipment
+from parcelo.store import db
+
+
+def _shipment(shipment_id):
+    s = Shipment(id=shipment_id, customer_id="cust_x", weight_kg=1.0, zone="local")
+    db.shipments[s.id] = s
+    return s
+
+
+def _invoice(invoice_id, shipment_id):
+    inv = Invoice(id=invoice_id, shipment_id=shipment_id, amount=0)
+    db.invoices[inv.id] = inv
+    return inv
+
+
+def test_shipments_without_invoice_returns_uninvoiced_only():
+    _shipment("shp_000002")
+    _shipment("shp_000001")
+    _shipment("shp_000003")
+    _invoice("INV-1", "shp_000003")
+
+    result = reports.shipments_without_invoice()
+
+    assert [s.id for s in result] == ["shp_000001", "shp_000002"]
+
+
+def test_shipments_without_invoice_empty_when_all_invoiced():
+    _shipment("shp_000001")
+    _invoice("INV-1", "shp_000001")
+
+    assert reports.shipments_without_invoice() == []
+
+
+def test_shipments_without_invoice_no_shipments():
+    assert reports.shipments_without_invoice() == []
