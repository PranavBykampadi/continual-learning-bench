+def shipments_without_invoice():
+    """Shipments that no invoice refers to, sorted by id ascending."""
+    invoiced_ids = {invoice.shipment_id for invoice in db.invoices.values()}
+    return sorted(
+        (s for s in db.shipments.values() if s.id not in invoiced_ids),
+        key=lambda s: s.id,
+    )
+
