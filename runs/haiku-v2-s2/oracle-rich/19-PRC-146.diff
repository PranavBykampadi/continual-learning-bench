diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_invoice_write_off.py b/tests/unit/test_invoice_write_off.py
--- a/tests/unit/test_invoice_write_off.py	1969-12-31 19:00:00
+++ b/tests/unit/test_invoice_write_off.py	2026-11-12 02:58:50
@@ -0,0 +1,69 @@
+import pytest
+
+from parcelo import clock, events, invoices
+from parcelo.errors import DomainError
+from parcelo.models import Invoice
+from parcelo.money import Money
+from parcelo.store import db
+
+
+def _add_invoice(invoice_id="INV-T1", status="open", amount=12.5):
+    inv = Invoice(id=invoice_id, shipment_id="shp_x", amount=amount, status=status)
+    db.invoices[inv.id] = inv
+    return inv
+
+
+def test_write_off_open_invoice():
+    inv = _add_invoice(amount=12.5)
+    result = invoices.write_off(inv.id)
+    assert result == Money(1250)
+    assert inv.status == "written_off"
+    assert inv.written_off_at is not None
+
+
+def test_write_off_uses_clock():
+    from datetime import datetime, timezone
+
+    moment = datetime(2026, 1, 2, 3, 4, 5, tzinfo=timezone.utc)
+    clock.set_fixed(moment)
+    inv = _add_invoice()
+    invoices.write_off(inv.id)
+    assert inv.written_off_at == moment
+
+
+def test_write_off_emits_event():
+    inv = _add_invoice()
+    invoices.write_off(inv.id)
+    assert events.OUTBOX[-1]["name"] == "invoice.written_off"
+    assert events.OUTBOX[-1]["entity_id"] == inv.id
+    assert events.OUTBOX[-1]["payload"] == {"amount_cents": 1250}
+
+
+def test_write_off_is_idempotent():
+    inv = _add_invoice()
+    invoices.write_off(inv.id)
+    first_stamp = inv.written_off_at
+    events_before = len(events.OUTBOX)
+
+    result = invoices.write_off(inv.id)
+
+    assert result == Money(1250)
+    assert inv.status == "written_off"
+    assert inv.written_off_at == first_stamp
+    assert len(events.OUTBOX) == events_before
+
+
+def test_write_off_paid_invoice_rejected():
+    inv = _add_invoice(status="paid")
+    with pytest.raises(DomainError) as err:
+        invoices.write_off(inv.id)
+    assert err.value.code == "E_BAD_STATE"
+    assert inv.status == "paid"
+    assert inv.written_off_at is None
+    assert events.OUTBOX == []
+
+
+def test_write_off_unknown_invoice():
+    with pytest.raises(DomainError) as err:
+        invoices.write_off("INV-missing")
+    assert err.value.code == "E_NOT_FOUND"
