     if shipment_id not in db.shipments:
         raise DomainError("E_NOT_FOUND", shipment_id)
     return db.shipments[shipment_id]
+
+
+def shipments_in_zone(zone):
+    """Return the shipments going to `zone`, sorted by id ascending."""
+    if zone not in ZONE_BASE:
+        raise DomainError("E_BAD_ZONE", zone)
+    matches = [s for s in db.shipments.values() if s.zone == zone]
+    return sorted(matches, key=lambda s: s.id)
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_shipments_in_zone.py b/tests/unit/test_shipments_in_zone.py
--- a/tests/unit/test_shipments_in_zone.py	1969-12-31 19:00:00
+++ b/tests/unit/test_shipments_in_zone.py	2026-11-12 03:15:49
@@ -0,0 +1,42 @@
+import pytest
+
+from parcelo import customers, shipments
+from parcelo.errors import DomainError
+
+
+def test_returns_only_shipments_in_zone():
+    c = customers.add_customer("Acme")
+    local = shipments.create_shipment(c.id, 1.0, "local")
+    national = shipments.create_shipment(c.id, 2.0, "national")
+    other = shipments.create_shipment(c.id, 3.0, "local")
+
+    result = shipments.shipments_in_zone("local")
+
+    assert [s.id for s in result] == [local.id, other.id]
+    assert national not in result
+
+
+def test_empty_list_when_no_shipments_in_zone():
+    c = customers.add_customer("Acme")
+    shipments.create_shipment(c.id, 1.0, "local")
+
+    assert shipments.shipments_in_zone("international") == []
+
+
+def test_empty_list_when_no_shipments_at_all():
+    assert shipments.shipments_in_zone("national") == []
+
+
+def test_result_sorted_by_id_ascending():
+    c = customers.add_customer("Acme")
+    ids_created = [shipments.create_shipment(c.id, 1.0, "national").id for _ in range(12)]
+
+    result = shipments.shipments_in_zone("national")
+
+    assert [s.id for s in result] == sorted(ids_created)
+
+
+def test_unknown_zone_raises_bad_zone():
+    with pytest.raises(DomainError) as err:
+        shipments.shipments_in_zone("mars")
+    assert err.value.code == "E_BAD_ZONE"
