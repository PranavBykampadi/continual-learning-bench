+@dataclass(frozen=True)
+class QuoteWithSurcharge:
+    quote: Money
+    fuel_surcharge: Money
+    total: Money
+
+
+def quote_with_surcharge(weight_kg, zone):
+    """Return the quote for weight and zone plus the zone's fuel surcharge."""
+    if zone not in FUEL_SURCHARGE_PCT:
+        raise DomainError("E_BAD_ZONE", "unknown zone: %s" % zone)
+    if weight_kg <= 0:
+        raise DomainError("E_BAD_WEIGHT", "weight must be positive")
+    base = Money.parse(quote(weight_kg, zone))
+    surcharge = base.scale(FUEL_SURCHARGE_PCT[zone] / 100)
+    return QuoteWithSurcharge(quote=base, fuel_surcharge=surcharge, total=base + surcharge)
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_rates_surcharge.py b/tests/unit/test_rates_surcharge.py
--- a/tests/unit/test_rates_surcharge.py	1969-12-31 19:00:00
+++ b/tests/unit/test_rates_surcharge.py	2026-11-12 02:49:30
@@ -0,0 +1,48 @@
+import pytest
+
+from parcelo import rates
+from parcelo.errors import DomainError
+from parcelo.money import Money
+
+
+def test_local_has_no_surcharge():
+    q = rates.quote_with_surcharge(2, "local")
+    assert q.quote == Money(700)
+    assert q.fuel_surcharge == Money(0)
+    assert q.total == Money(700)
+
+
+def test_national_surcharge_is_4_percent():
+    # quote 11.50 -> 4% = 0.46
+    q = rates.quote_with_surcharge(2, "national")
+    assert q.quote == Money(1150)
+    assert q.fuel_surcharge == Money(46)
+    assert q.total == Money(1196)
+
+
+def test_international_surcharge_rounds_half_up():
+    # quote 26.50 -> 9.5% = 2.5175 -> 2.52
+    q = rates.quote_with_surcharge(2, "international")
+    assert q.quote == Money(2650)
+    assert q.fuel_surcharge == Money(252)
+    assert q.total == Money(2902)
+
+
+def test_amounts_are_money_not_float():
+    q = rates.quote_with_surcharge(1, "national")
+    assert isinstance(q.quote, Money)
+    assert isinstance(q.fuel_surcharge, Money)
+    assert isinstance(q.total, Money)
+
+
+def test_unknown_zone_raises_domain_error():
+    with pytest.raises(DomainError) as err:
+        rates.quote_with_surcharge(1, "moon")
+    assert err.value.code == "E_BAD_ZONE"
+
+
+@pytest.mark.parametrize("weight", [0, -1, -0.5])
+def test_non_positive_weight_raises_domain_error(weight):
+    with pytest.raises(DomainError) as err:
+        rates.quote_with_surcharge(weight, "local")
+    assert err.value.code == "E_BAD_WEIGHT"
