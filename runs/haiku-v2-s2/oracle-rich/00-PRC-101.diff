diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/parcelo/shipments.py b/parcelo/shipments.py
--- a/parcelo/shipments.py	2026-11-10 12:17:53
+++ b/parcelo/shipments.py	2026-11-12 02:48:00
@@ -28,3 +28,16 @@
     if shipment_id not in db.shipments:
         raise DomainError("E_NOT_FOUND", shipment_id)
     return db.shipments[shipment_id]
+
+
+TERMINAL_STATUSES = ("cancelled", "delivered")
+
+
+def cancel_shipment(shipment_id, reason):
+    shipment = get_shipment(shipment_id)
+    if shipment.status in TERMINAL_STATUSES:
+        raise DomainError("E_BAD_STATE", f"{shipment_id} is {shipment.status}")
+    shipment.status = "cancelled"
+    shipment.notes.append(reason)
+    audit.record("shipment.cancelled", shipment.id, reason=reason)
+    return shipment
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_cancel_shipment.py b/tests/unit/test_cancel_shipment.py
--- a/tests/unit/test_cancel_shipment.py	1969-12-31 19:00:00
+++ b/tests/unit/test_cancel_shipment.py	2026-11-12 02:48:04
@@ -0,0 +1,58 @@
+import pytest
+
+from parcelo import audit, customers, shipments
+from parcelo.errors import DomainError
+from parcelo.store import db
+
+
+def _new_shipment():
+    c = customers.add_customer("Acme")
+    return shipments.create_shipment(c.id, 1.5, "national")
+
+
+def test_cancel_sets_status_and_appends_reason():
+    s = _new_shipment()
+    result = shipments.cancel_shipment(s.id, "customer request")
+    assert result is s
+    assert s.status == "cancelled"
+    assert s.notes == ["customer request"]
+
+
+def test_cancel_appends_to_existing_notes():
+    s = _new_shipment()
+    s.notes.append("fragile")
+    shipments.cancel_shipment(s.id, "duplicate order")
+    assert s.notes == ["fragile", "duplicate order"]
+
+
+def test_cancel_records_audit():
+    s = _new_shipment()
+    shipments.cancel_shipment(s.id, "customer request")
+    assert audit.LOG[-1]["action"] == "shipment.cancelled"
+    assert audit.LOG[-1]["entity_id"] == s.id
+
+
+def test_cancel_unknown_shipment_fails():
+    with pytest.raises(DomainError) as err:
+        shipments.cancel_shipment("shp_999999", "x")
+    assert err.value.code == "E_NOT_FOUND"
+
+
+def test_cancel_already_cancelled_fails():
+    s = _new_shipment()
+    shipments.cancel_shipment(s.id, "first")
+    with pytest.raises(DomainError) as err:
+        shipments.cancel_shipment(s.id, "second")
+    assert err.value.code == "E_BAD_STATE"
+    assert s.notes == ["first"]
+
+
+def test_cancel_delivered_fails():
+    s = _new_shipment()
+    s.status = "delivered"
+    with pytest.raises(DomainError) as err:
+        shipments.cancel_shipment(s.id, "too late")
+    assert err.value.code == "E_BAD_STATE"
+    assert s.status == "delivered"
+    assert s.notes == []
+    assert all(e["action"] != "shipment.cancelled" for e in audit.LOG)
