diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_disputes.py b/tests/unit/test_disputes.py
--- a/tests/unit/test_disputes.py	1969-12-31 19:00:00
+++ b/tests/unit/test_disputes.py	2026-11-12 02:59:38
@@ -0,0 +1,55 @@
+import pytest
+
+from parcelo import clock, disputes, events, ids
+from parcelo.errors import DomainError
+from parcelo.models import Dispute, Invoice
+from parcelo.store import db
+
+
+def _add_invoice(invoice_id="INV-1"):
+    db.invoices[invoice_id] = Invoice(id=invoice_id, shipment_id="shp_x", amount=10.0)
+    return invoice_id
+
+
+def test_open_dispute_stores_and_returns_dispute():
+    clock.set_fixed("2026-11-12T00:00:00+00:00")
+    inv = _add_invoice()
+    d = disputes.open_dispute(inv, "wrong weight")
+    assert isinstance(d, Dispute)
+    assert d.id.startswith("dsp_")
+    assert d.invoice_id == inv
+    assert d.reason == "wrong weight"
+    assert d.opened_at == "2026-11-12T00:00:00+00:00"
+    assert db.disputes[d.id] is d
+
+
+def test_open_dispute_emits_event():
+    inv = _add_invoice()
+    d = disputes.open_dispute(inv, "damaged")
+    assert events.OUTBOX[-1]["name"] == "dispute.opened"
+    assert events.OUTBOX[-1]["entity_id"] == d.id
+
+
+def test_unknown_invoice_fails():
+    with pytest.raises(DomainError) as err:
+        disputes.open_dispute("INV-missing", "reason")
+    assert err.value.code == "E_NOT_FOUND"
+    assert db.disputes == {}
+
+
+@pytest.mark.parametrize("reason", ["", "   ", None])
+def test_empty_reason_fails(reason):
+    inv = _add_invoice()
+    with pytest.raises(DomainError) as err:
+        disputes.open_dispute(inv, reason)
+    assert err.value.code == "E_BAD_INPUT"
+    assert db.disputes == {}
+
+
+def test_store_reset_clears_disputes():
+    from parcelo import store
+
+    inv = _add_invoice()
+    disputes.open_dispute(inv, "x")
+    store.reset()
+    assert db.disputes == {}
