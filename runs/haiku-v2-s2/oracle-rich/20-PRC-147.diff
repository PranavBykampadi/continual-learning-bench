 from datetime import datetime
 
+from parcelo.settings import BULK_TIER_MIN_SHIPMENTS, REGULAR_TIER_MIN_SHIPMENTS
 from parcelo.store import db
+
+
+def _volume_tier(shipment_count):
+    if shipment_count >= BULK_TIER_MIN_SHIPMENTS:
+        return "bulk"
+    if shipment_count >= REGULAR_TIER_MIN_SHIPMENTS:
+        return "regular"
+    return "starter"
+
+
+def volume_report():
+    """Per-customer shipment counts and volume tier, keyed by customer id (sorted)."""
+    counts = {customer_id: 0 for customer_id in db.customers}
+    for shipment in db.shipments.values():
+        if shipment.customer_id in counts:
+            counts[shipment.customer_id] += 1
+    report = {}
+    for customer_id in sorted(counts):
+        count = counts[customer_id]
+        report[customer_id] = {"shipments": count, "tier": _volume_tier(count)}
+    return report
 
 
