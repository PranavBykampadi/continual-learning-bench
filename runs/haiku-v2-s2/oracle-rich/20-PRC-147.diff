diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_volume_report.py b/tests/unit/test_volume_report.py
--- a/tests/unit/test_volume_report.py	1969-12-31 19:00:00
+++ b/tests/unit/test_volume_report.py	2026-11-12 02:59:17
@@ -0,0 +1,52 @@
+from parcelo import customers, events, reports, shipments
+from parcelo.settings import BULK_TIER_MIN_SHIPMENTS, REGULAR_TIER_MIN_SHIPMENTS
+
+
+def _book(customer_id, n):
+    for _ in range(n):
+        shipments.create_shipment(customer_id, 1.0, "local")
+
+
+def test_includes_customers_without_shipments():
+    c = customers.add_customer("Empty")
+    report = reports.volume_report()
+    assert report == {c.id: {"shipments": 0, "tier": "starter"}}
+
+
+def test_counts_only_own_shipments():
+    a = customers.add_customer("A")
+    b = customers.add_customer("B")
+    _book(a.id, 3)
+    _book(b.id, 1)
+    report = reports.volume_report()
+    assert report[a.id]["shipments"] == 3
+    assert report[b.id]["shipments"] == 1
+
+
+def test_tier_thresholds():
+    assert REGULAR_TIER_MIN_SHIPMENTS == 10
+    assert BULK_TIER_MIN_SHIPMENTS == 50
+    low = customers.add_customer("Low")
+    mid = customers.add_customer("Mid")
+    high = customers.add_customer("High")
+    _book(low.id, REGULAR_TIER_MIN_SHIPMENTS - 1)
+    _book(mid.id, REGULAR_TIER_MIN_SHIPMENTS)
+    _book(high.id, BULK_TIER_MIN_SHIPMENTS)
+    report = reports.volume_report()
+    assert report[low.id]["tier"] == "starter"
+    assert report[mid.id]["tier"] == "regular"
+    assert report[high.id]["tier"] == "bulk"
+
+
+def test_keys_sorted_by_id():
+    for name in ("x", "y", "z"):
+        customers.add_customer(name)
+    keys = list(reports.volume_report().keys())
+    assert keys == sorted(keys)
+
+
+def test_does_not_emit_events():
+    customers.add_customer("Quiet")
+    events.OUTBOX.clear()
+    reports.volume_report()
+    assert events.OUTBOX == []
