+from parcelo.money import Money
 from parcelo.store import db
+
+
+def outstanding_by_customer():
+    """Map every customer id to the total of its open invoices (Money).
+
+    Invoices link to customers through their shipment. Paid and void
+    invoices are excluded. Customers with nothing owed map to zero.
+    """
+    totals = {customer_id: Money.zero() for customer_id in db.customers}
+    for invoice in db.invoices.values():
+        if invoice.status != "open":
+            continue
+        shipment = db.shipments[invoice.shipment_id]
+        owed = Money.parse(invoice.amount)
+        totals[shipment.customer_id] = totals.get(shipment.customer_id, Money.zero()) + owed
+    return totals
 
 
