+from parcelo.errors import DomainError
+from parcelo.money import Money
+
 ZONE_BASE = {"local": 4.5, "national": 9.0, "international": 24.0}
 PER_KG = 1.25
+TIER_DISCOUNT_PCT = {"standard": 0, "gold": 10}
 
 
 def base_rate(zone):
@@ -12,3 +16,18 @@
     if weight_kg <= 0:
         raise ValueError("weight must be positive")
     return round(base_rate(zone) + PER_KG * weight_kg, 2)
+
+
+def discounted_quote(weight_kg, zone, tier):
+    """Quote for weight and zone with the tier's discount applied, as Money."""
+    if zone not in ZONE_BASE:
+        raise DomainError("E_BAD_ZONE", "unknown zone: %s" % zone)
+    if tier not in TIER_DISCOUNT_PCT:
+        raise DomainError("E_BAD_TIER", "unknown tier: %s" % tier)
+    if weight_kg <= 0:
+        raise DomainError("E_BAD_WEIGHT", "weight must be positive")
+    regular = Money.parse(quote(weight_kg, zone))
+    pct = TIER_DISCOUNT_PCT[tier]
+    if pct == 0:
+        return regular
+    return regular.scale(1 - pct / 100)
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_rates_discount.py b/tests/unit/test_rates_discount.py
--- a/tests/unit/test_rates_discount.py	1969-12-31 19:00:00
+++ b/tests/unit/test_rates_discount.py	2026-11-12 02:53:21
@@ -0,0 +1,43 @@
+import pytest
+
+from parcelo import rates
+from parcelo.errors import DomainError
+from parcelo.money import Money
+
+
+def test_standard_tier_has_no_discount():
+    # local, 2 kg: 4.5 + 1.25 * 2 = 7.00
+    assert rates.discounted_quote(2, "local", "standard") == Money(700)
+
+
+def test_gold_tier_takes_ten_percent_off():
+    # local, 2 kg: 7.00 * 0.9 = 6.30
+    assert rates.discounted_quote(2, "local", "gold") == Money(630)
+
+
+def test_gold_discount_on_national_zone():
+    # national, 4 kg: 9.00 + 5.00 = 14.00, * 0.9 = 12.60
+    assert rates.discounted_quote(4, "national", "gold") == Money(1260)
+
+
+def test_result_is_money_not_float():
+    result = rates.discounted_quote(2, "local", "gold")
+    assert isinstance(result, Money)
+
+
+def test_unknown_zone_raises_domain_error():
+    with pytest.raises(DomainError) as err:
+        rates.discounted_quote(2, "mars", "gold")
+    assert err.value.code == "E_BAD_ZONE"
+
+
+def test_unknown_tier_raises_domain_error():
+    with pytest.raises(DomainError) as err:
+        rates.discounted_quote(2, "local", "platinum")
+    assert err.value.code == "E_BAD_TIER"
+
+
+def test_non_positive_weight_raises_domain_error():
+    with pytest.raises(DomainError) as err:
+        rates.discounted_quote(0, "local", "gold")
+    assert err.value.code == "E_BAD_WEIGHT"
