diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_invoice_hold.py b/tests/unit/test_invoice_hold.py
--- a/tests/unit/test_invoice_hold.py	1969-12-31 19:00:00
+++ b/tests/unit/test_invoice_hold.py	2026-11-12 03:15:08
@@ -0,0 +1,60 @@
+from datetime import datetime, timezone
+
+import pytest
+
+from parcelo import clock, customers, events, invoices, shipments
+from parcelo.errors import DomainError
+
+
+def _open_invoice():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 2, "local")
+    return invoices.issue_invoice(s.id)
+
+
+def test_hold_open_invoice():
+    inv = _open_invoice()
+    moment = datetime(2026, 11, 12, 9, 30, tzinfo=timezone.utc)
+    clock.set_fixed(moment)
+    held = invoices.hold_invoice(inv.id)
+    assert held is inv
+    assert held.status == "on_hold"
+    assert held.held_at == moment
+
+
+def test_hold_emits_event_once():
+    inv = _open_invoice()
+    events.OUTBOX.clear()
+    invoices.hold_invoice(inv.id)
+    assert [e["name"] for e in events.OUTBOX] == ["invoice.held"]
+    assert events.OUTBOX[0]["entity_id"] == inv.id
+
+
+def test_hold_is_idempotent():
+    inv = _open_invoice()
+    invoices.hold_invoice(inv.id)
+    first_held_at = inv.held_at
+    events.OUTBOX.clear()
+    again = invoices.hold_invoice(inv.id)
+    assert again is inv
+    assert again.status == "on_hold"
+    assert again.held_at == first_held_at
+    assert events.OUTBOX == []
+
+
+def test_hold_unknown_invoice_fails():
+    with pytest.raises(DomainError) as err:
+        invoices.hold_invoice("INV-missing")
+    assert err.value.code == "E_NOT_FOUND"
+
+
+def test_hold_paid_invoice_fails():
+    inv = _open_invoice()
+    invoices.mark_paid(inv.id)
+    events.OUTBOX.clear()
+    with pytest.raises(DomainError) as err:
+        invoices.hold_invoice(inv.id)
+    assert err.value.code == "E_BAD_STATE"
+    assert inv.status == "paid"
+    assert inv.held_at is None
+    assert events.OUTBOX == []
