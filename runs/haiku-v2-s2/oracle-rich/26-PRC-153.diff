diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_customers_review.py b/tests/unit/test_customers_review.py
--- a/tests/unit/test_customers_review.py	1969-12-31 19:00:00
+++ b/tests/unit/test_customers_review.py	2026-11-12 03:01:45
@@ -0,0 +1,71 @@
+import pytest
+
+from parcelo import customers
+from parcelo.errors import DomainError
+from parcelo.models import Invoice, Shipment
+from parcelo.store import db
+
+
+def _add_invoice(customer_id, amount, status="open"):
+    shipment_id = f"shp_{len(db.shipments) + 1:06d}"
+    db.shipments[shipment_id] = Shipment(
+        id=shipment_id, customer_id=customer_id, weight_kg=1.0, zone="local"
+    )
+    invoice_id = f"inv_{len(db.invoices) + 1:06d}"
+    db.invoices[invoice_id] = Invoice(
+        id=invoice_id, shipment_id=shipment_id, amount=amount, status=status
+    )
+
+
+def test_no_invoices_does_not_need_review():
+    c = customers.add_customer("Acme")
+    assert customers.needs_review(c.id) is False
+
+
+def test_three_open_invoices_small_total_does_not_need_review():
+    c = customers.add_customer("Acme")
+    for _ in range(3):
+        _add_invoice(c.id, 10.00)
+    assert customers.needs_review(c.id) is False
+
+
+def test_more_than_three_open_invoices_needs_review():
+    c = customers.add_customer("Acme")
+    for _ in range(4):
+        _add_invoice(c.id, 1.00)
+    assert customers.needs_review(c.id) is True
+
+
+def test_total_exactly_250_does_not_need_review():
+    c = customers.add_customer("Acme")
+    _add_invoice(c.id, 150.00)
+    _add_invoice(c.id, 100.00)
+    assert customers.needs_review(c.id) is False
+
+
+def test_total_over_250_needs_review():
+    c = customers.add_customer("Acme")
+    _add_invoice(c.id, 150.00)
+    _add_invoice(c.id, 100.01)
+    assert customers.needs_review(c.id) is True
+
+
+def test_paid_invoices_are_ignored():
+    c = customers.add_customer("Acme")
+    for _ in range(5):
+        _add_invoice(c.id, 100.00, status="paid")
+    assert customers.needs_review(c.id) is False
+
+
+def test_other_customers_invoices_are_ignored():
+    c = customers.add_customer("Acme")
+    other = customers.add_customer("Other")
+    for _ in range(4):
+        _add_invoice(other.id, 1.00)
+    assert customers.needs_review(c.id) is False
+
+
+def test_unknown_customer_raises():
+    with pytest.raises(DomainError) as err:
+        customers.needs_review("C_missing")
+    assert err.value.code == "E_UNKNOWN_CUSTOMER"
