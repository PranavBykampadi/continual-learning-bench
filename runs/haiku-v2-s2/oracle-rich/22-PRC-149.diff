+def split_shipment(shipment_id, weights):
+    """Replace a "created" shipment with one new shipment per weight.
+
+    The original is marked "split". New shipments share its customer and zone
+    and are returned in the same order as ``weights`` (ids ascend in that order).
+    All checks run before anything is changed.
+    """
+    original = get_shipment(shipment_id)
+    if original.status != "created":
+        raise DomainError("E_BAD_STATE", f"{shipment_id} is {original.status}")
+    if not weights:
+        raise DomainError("E_BAD_INPUT", "no weights given")
+    for weight in weights:
+        if weight <= 0:
+            raise DomainError("E_BAD_WEIGHT", str(weight))
+    if not math.isclose(sum(weights), original.weight_kg, rel_tol=0, abs_tol=SPLIT_WEIGHT_TOLERANCE_KG):
+        raise DomainError(
+            "E_BAD_INPUT", f"weights sum to {sum(weights)}, expected {original.weight_kg}"
+        )
+
+    now = clock.now()
+    new_shipments = []
+    for weight in weights:
+        shipment = Shipment(
+            id=ids.new_id("shp"),
+            customer_id=original.customer_id,
+            weight_kg=weight,
+            zone=original.zone,
+            created_at=now,
+        )
+        db.shipments[shipment.id] = shipment
+        events.emit("shipment.created", shipment.id, zone=shipment.zone)
+        new_shipments.append(shipment)
+
+    original.status = "split"
+    events.emit("shipment.split", original.id, new_ids=[s.id for s in new_shipments])
+    return new_shipments
