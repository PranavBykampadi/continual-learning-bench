@@ -0,0 +1,94 @@
+import pytest
+
+from parcelo import customers, events, shipments
+from parcelo.errors import DomainError
+
+
+def _created(weight=10.0, zone="national"):
+    c = customers.add_customer("Acme")
+    return shipments.create_shipment(c.id, weight, zone)
+
+
+def test_split_returns_new_shipments_in_weight_order():
+    s = _created(10.0)
+    parts = shipments.split_shipment(s.id, [2.0, 3.0, 5.0])
+    assert [p.weight_kg for p in parts] == [2.0, 3.0, 5.0]
+    ids = [p.id for p in parts]
+    assert ids == sorted(ids)
+    assert all(i.startswith("shp_") for i in ids)
+
+
+def test_split_new_shipments_keep_customer_and_zone():
+    s = _created(10.0, zone="international")
+    parts = shipments.split_shipment(s.id, [4.0, 6.0])
+    for p in parts:
+        assert p.customer_id == s.customer_id
+        assert p.zone == "international"
+        assert p.status == "created"
+        assert shipments.get_shipment(p.id) is p
+
+
+def test_split_marks_original_and_stores_new_ones():
+    s = _created(10.0)
+    parts = shipments.split_shipment(s.id, [5.0, 5.0])
+    assert shipments.get_shipment(s.id).status == "split"
+    assert len(parts) == 2
+
+
+def test_split_emits_events():
+    s = _created(10.0)
+    events.OUTBOX.clear()
+    parts = shipments.split_shipment(s.id, [5.0, 5.0])
+    names = [e["name"] for e in events.OUTBOX]
+    assert names.count("shipment.created") == 2
+    assert events.OUTBOX[-1]["name"] == "shipment.split"
+    assert events.OUTBOX[-1]["entity_id"] == s.id
+    assert events.OUTBOX[-1]["payload"]["new_ids"] == [p.id for p in parts]
+
+
+def test_split_accepts_float_rounding_in_weights():
+    s = _created(1.0)
+    parts = shipments.split_shipment(s.id, [0.1, 0.2, 0.7])
+    assert len(parts) == 3
+
+
+def test_split_unknown_shipment_fails():
+    with pytest.raises(DomainError) as err:
+        shipments.split_shipment("shp_999999", [1.0])
+    assert err.value.code == "E_NOT_FOUND"
+
+
+def test_split_non_created_shipment_fails():
+    s = _created(10.0)
+    shipments.split_shipment(s.id, [5.0, 5.0])
+    before = len(shipments.db.shipments)
+    with pytest.raises(DomainError) as err:
+        shipments.split_shipment(s.id, [5.0, 5.0])
+    assert err.value.code == "E_BAD_STATE"
+    assert len(shipments.db.shipments) == before
+
