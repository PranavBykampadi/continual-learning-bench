+"""Business thresholds and limits used by new code."""
+
+# How far apart (in kg) the split weights may be from the original weight
+# and still count as adding up to it. Absorbs float rounding error only.
+SPLIT_WEIGHT_TOLERANCE_KG = 1e-6
