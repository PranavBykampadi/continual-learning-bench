diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_invoice_escalation.py b/tests/unit/test_invoice_escalation.py
--- a/tests/unit/test_invoice_escalation.py	1969-12-31 19:00:00
+++ b/tests/unit/test_invoice_escalation.py	2026-11-12 03:18:35
@@ -0,0 +1,59 @@
+import pytest
+
+from parcelo import events, invoices
+from parcelo.errors import DomainError
+from parcelo.models import Invoice
+from parcelo.store import db
+
+
+def _add_invoice(invoice_id, amount, status="open"):
+    inv = Invoice(id=invoice_id, shipment_id="shp_x", amount=amount, status=status)
+    db.invoices[invoice_id] = inv
+    return inv
+
+
+def test_escalates_open_invoice_at_threshold():
+    _add_invoice("INV-1", 500.00)
+    inv = invoices.escalate_invoice("INV-1")
+    assert inv.status == "escalated"
+    assert db.invoices["INV-1"].status == "escalated"
+    assert events.OUTBOX[-1]["name"] == "invoice.escalated"
+    assert events.OUTBOX[-1]["entity_id"] == "INV-1"
+
+
+def test_escalates_invoice_above_threshold():
+    _add_invoice("INV-2", 1234.56)
+    assert invoices.escalate_invoice("INV-2").status == "escalated"
+
+
+def test_below_threshold_is_rejected():
+    _add_invoice("INV-3", 499.99)
+    with pytest.raises(DomainError) as err:
+        invoices.escalate_invoice("INV-3")
+    assert err.value.code == "E_LIMIT"
+    assert db.invoices["INV-3"].status == "open"
+    assert events.OUTBOX == []
+
+
+def test_paid_invoice_is_rejected():
+    _add_invoice("INV-4", 800.00, status="paid")
+    with pytest.raises(DomainError) as err:
+        invoices.escalate_invoice("INV-4")
+    assert err.value.code == "E_BAD_STATE"
+    assert db.invoices["INV-4"].status == "paid"
+    assert events.OUTBOX == []
+
+
+def test_missing_invoice_fails():
+    with pytest.raises(DomainError) as err:
+        invoices.escalate_invoice("INV-nope")
+    assert err.value.code == "E_NOT_FOUND"
+
+
+def test_already_escalated_is_unchanged_without_event():
+    _add_invoice("INV-5", 900.00)
+    invoices.escalate_invoice("INV-5")
+    events.OUTBOX.clear()
+    inv = invoices.escalate_invoice("INV-5")
+    assert inv.status == "escalated"
+    assert events.OUTBOX == []
