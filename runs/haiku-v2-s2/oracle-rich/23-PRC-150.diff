+def set_credit_limit(customer_id, amount):
+    """Set a customer's credit limit to `amount` (dollars) and return the new limit as Money.
+
+    Setting the limit to the value it already has changes nothing and emits no event.
+    """
+    if customer_id not in db.customers:
+        raise DomainError("E_UNKNOWN_CUSTOMER", customer_id)
+    try:
+        limit = Money.parse(amount)
+    except (ArithmeticError, TypeError, ValueError) as exc:
+        raise DomainError("E_BAD_INPUT", f"credit limit {amount!r} is not a number") from exc
+    if limit.cents < 0:
+        raise DomainError("E_BAD_INPUT", "credit limit must not be negative")
+    customer = db.customers[customer_id]
+    if customer.credit_limit == limit:
+        return customer.credit_limit
+    customer.credit_limit = limit
+    events.emit("customer.credit_limit_set", customer_id, limit_cents=limit.cents)
+    return customer.credit_limit
 
 
