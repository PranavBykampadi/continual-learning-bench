diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_customer_credit_limit.py b/tests/unit/test_customer_credit_limit.py
--- a/tests/unit/test_customer_credit_limit.py	1969-12-31 19:00:00
+++ b/tests/unit/test_customer_credit_limit.py	2026-11-12 03:00:44
@@ -0,0 +1,73 @@
+import pytest
+
+from parcelo import customers, events
+from parcelo.errors import DomainError
+from parcelo.money import Money
+from parcelo.settings import DEFAULT_CREDIT_LIMIT
+
+
+def test_new_customer_gets_default_limit():
+    c = customers.add_customer("Acme")
+    assert c.credit_limit == DEFAULT_CREDIT_LIMIT
+
+
+def test_set_credit_limit_updates_and_returns_money():
+    c = customers.add_customer("Acme")
+    limit = customers.set_credit_limit(c.id, 1200)
+    assert limit == Money(120000)
+    assert customers.get_customer(c.id).credit_limit == Money(120000)
+
+
+def test_float_amount_is_converted_to_cents():
+    c = customers.add_customer("Acme")
+    assert customers.set_credit_limit(c.id, 1234.5) == Money(123450)
+
+
+def test_set_credit_limit_emits_event():
+    c = customers.add_customer("Acme")
+    events.OUTBOX.clear()
+    customers.set_credit_limit(c.id, 800)
+    assert len(events.OUTBOX) == 1
+    event = events.OUTBOX[-1]
+    assert event["name"] == "customer.credit_limit_set"
+    assert event["entity_id"] == c.id
+    assert event["payload"] == {"limit_cents": 80000}
+
+
+def test_zero_limit_is_allowed():
+    c = customers.add_customer("Acme")
+    assert customers.set_credit_limit(c.id, 0) == Money(0)
+
+
+def test_same_limit_again_is_a_no_op():
+    c = customers.add_customer("Acme")
+    customers.set_credit_limit(c.id, 900)
+    events.OUTBOX.clear()
+    assert customers.set_credit_limit(c.id, 900) == Money(90000)
+    assert customers.get_customer(c.id).credit_limit == Money(90000)
+    assert events.OUTBOX == []
+
+
+def test_unknown_customer_fails():
+    with pytest.raises(DomainError) as err:
+        customers.set_credit_limit("nope", 100)
+    assert err.value.code == "E_UNKNOWN_CUSTOMER"
+    assert events.OUTBOX == []
+
+
+def test_negative_amount_fails_and_leaves_limit_unchanged():
+    c = customers.add_customer("Acme")
+    before = customers.get_customer(c.id).credit_limit
+    events.OUTBOX.clear()
+    with pytest.raises(DomainError) as err:
+        customers.set_credit_limit(c.id, -1)
+    assert err.value.code == "E_BAD_INPUT"
+    assert customers.get_customer(c.id).credit_limit == before
+    assert events.OUTBOX == []
+
+
+def test_non_numeric_amount_fails():
+    c = customers.add_customer("Acme")
+    with pytest.raises(DomainError) as err:
+        customers.set_credit_limit(c.id, "lots")
+    assert err.value.code == "E_BAD_INPUT"
