diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/parcelo/vouchers.py b/parcelo/vouchers.py
--- a/parcelo/vouchers.py	1969-12-31 19:00:00
+++ b/parcelo/vouchers.py	2026-11-12 03:17:48
@@ -0,0 +1,31 @@
+from decimal import InvalidOperation
+
+from parcelo import clock, events, ids
+from parcelo.errors import DomainError
+from parcelo.models import Voucher
+from parcelo.money import Money
+from parcelo.settings import MAX_VOUCHER_CENTS
+from parcelo.store import db
+
+
+def issue_voucher(customer_id, amount):
+    """Issue a goodwill voucher for an existing customer; amount is in dollars or Money."""
+    if customer_id not in db.customers:
+        raise DomainError("E_UNKNOWN_CUSTOMER", customer_id)
+    try:
+        value = Money.parse(amount)
+    except (InvalidOperation, TypeError, ValueError):
+        raise DomainError("E_BAD_INPUT", f"amount {amount!r}")
+    if value.cents <= 0:
+        raise DomainError("E_BAD_INPUT", f"amount must be positive, got {value}")
+    if value.cents > MAX_VOUCHER_CENTS:
+        raise DomainError("E_LIMIT", f"voucher amount {value} exceeds the maximum")
+    voucher = Voucher(
+        id=ids.new_id("vch"),
+        customer_id=customer_id,
+        amount=value,
+        issued_at=clock.now(),
+    )
+    db.vouchers[voucher.id] = voucher
+    events.emit("voucher.issued", voucher.id, customer_id=customer_id, cents=value.cents)
+    return voucher
