@@ -0,0 +1,74 @@
+import pytest
+
+from parcelo import customers, events, vouchers
+from parcelo.errors import DomainError
+from parcelo.money import Money
+from parcelo.store import db
+
+
+def test_issue_voucher_saves_and_returns_voucher():
+    c = customers.add_customer("Acme")
+    v = vouchers.issue_voucher(c.id, "25.00")
+    assert v.id.startswith("vch_")
+    assert v.customer_id == c.id
+    assert v.amount == Money(2500)
+    assert v.issued_at is not None
+    assert db.vouchers[v.id] is v
+
+
+def test_issue_voucher_accepts_money_and_float():
+    c = customers.add_customer("Acme")
+    assert vouchers.issue_voucher(c.id, Money(1000)).amount == Money(1000)
+    assert vouchers.issue_voucher(c.id, 12.5).amount == Money(1250)
+
+
+def test_issue_voucher_stores_money_not_float():
+    c = customers.add_customer("Acme")
+    v = vouchers.issue_voucher(c.id, 10.10)
+    assert isinstance(v.amount, Money)
+    assert v.amount.cents == 1010
+
+
+def test_issue_voucher_at_maximum_is_allowed():
+    c = customers.add_customer("Acme")
+    v = vouchers.issue_voucher(c.id, "150.00")
+    assert v.amount == Money(15000)
+
+
+def test_issue_voucher_emits_event():
+    c = customers.add_customer("Acme")
+    v = vouchers.issue_voucher(c.id, 5)
+    assert events.OUTBOX[-1]["name"] == "voucher.issued"
+    assert events.OUTBOX[-1]["entity_id"] == v.id
+
+
+def test_unknown_customer_rejected():
+    with pytest.raises(DomainError) as err:
+        vouchers.issue_voucher("nope", 5)
+    assert err.value.code == "E_UNKNOWN_CUSTOMER"
+    assert db.vouchers == {}
+
+
+@pytest.mark.parametrize("amount", ["150.01", 200, "1000"])
+def test_over_limit_rejected(amount):
+    c = customers.add_customer("Acme")
+    with pytest.raises(DomainError) as err:
+        vouchers.issue_voucher(c.id, amount)
+    assert err.value.code == "E_LIMIT"
+    assert db.vouchers == {}
+
+
+@pytest.mark.parametrize("amount", [0, "0.00", -1, -0.01])
+def test_zero_or_negative_rejected(amount):
+    c = customers.add_customer("Acme")
+    with pytest.raises(DomainError) as err:
+        vouchers.issue_voucher(c.id, amount)
+    assert err.value.code == "E_BAD_INPUT"
+    assert db.vouchers == {}
+
