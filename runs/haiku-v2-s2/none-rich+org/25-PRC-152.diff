diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_mark_lost.py b/tests/unit/test_mark_lost.py
--- a/tests/unit/test_mark_lost.py	1969-12-31 19:00:00
+++ b/tests/unit/test_mark_lost.py	2026-11-12 03:01:13
@@ -0,0 +1,32 @@
+import pytest
+
+from parcelo import customers, shipments
+from parcelo.errors import DomainError
+from parcelo.store import db
+
+
+def _shipment():
+    c = customers.add_customer("Acme")
+    return shipments.create_shipment(c.id, 2, "local")
+
+
+def test_mark_lost_sets_status():
+    s = _shipment()
+    result = shipments.mark_lost(s.id)
+    assert result.status == "lost"
+    assert db.shipments[s.id].status == "lost"
+
+
+def test_mark_lost_unknown_shipment():
+    with pytest.raises(DomainError) as exc:
+        shipments.mark_lost("shp_missing")
+    assert exc.value.code == "E_NOT_FOUND"
+
+
+def test_mark_lost_delivered_fails():
+    s = _shipment()
+    s.status = "delivered"
+    with pytest.raises(DomainError) as exc:
+        shipments.mark_lost(s.id)
+    assert exc.value.code == "E_BAD_STATE"
+    assert s.status == "delivered"
