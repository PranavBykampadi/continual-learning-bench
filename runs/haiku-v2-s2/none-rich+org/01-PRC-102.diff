+def void_invoice(invoice_id):
+    if invoice_id not in db.invoices:
+        raise DomainError("E_NOT_FOUND", invoice_id)
+    invoice = db.invoices[invoice_id]
+    if invoice.status == "paid":
+        raise DomainError("E_BAD_STATE", "invoice already paid")
+    if invoice.status == "void":
+        raise DomainError("E_BAD_STATE", "invoice already void")
+    invoice.status = "void"
+    invoice.voided_at = clock.now()
+    audit.record("invoice.voided", invoice.id)
     return invoice
 
 
