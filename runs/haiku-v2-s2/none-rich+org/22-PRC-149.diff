+def test_split_replaces_original():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 3, "national")
+    parts = shipments.split_shipment(s.id, [1, 2])
+    assert [p.weight_kg for p in parts] == [1, 2]
+    assert all(p.customer_id == c.id and p.zone == "national" for p in parts)
+    assert all(p.status == "created" for p in parts)
+    assert shipments.get_shipment(s.id).status == "split"
+
+
+def test_split_unknown_shipment():
+    with pytest.raises(DomainError) as err:
+        shipments.split_shipment("shp_nope", [1])
+    assert err.value.code == "E_NOT_FOUND"
+
+
+def test_split_requires_created_status():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 2, "local")
+    shipments.split_shipment(s.id, [1, 1])
+    with pytest.raises(DomainError) as err:
+        shipments.split_shipment(s.id, [1, 1])
+    assert err.value.code == "E_BAD_STATE"
+
+
+def test_split_weights_must_sum_to_original():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 2, "local")
+    before = len(shipments.db.shipments)
+    with pytest.raises(DomainError) as err:
+        shipments.split_shipment(s.id, [1, 0.5])
+    assert err.value.code == "E_BAD_INPUT"
+    assert len(shipments.db.shipments) == before
+    assert shipments.get_shipment(s.id).status == "created"
+
+
