@@ -28,3 +28,28 @@
     if shipment_id not in db.shipments:
         raise DomainError("E_NOT_FOUND", shipment_id)
     return db.shipments[shipment_id]
+
+
+def mark_returned(shipment_id: str) -> Shipment:
+    """Record that a shipment has come back to the depot.
+
+    Sets the status to "returned" and stamps ``returned_at`` with the
+    current time.
+
+    Args:
+        shipment_id: ID of the shipment to mark.
+
+    Returns:
+        The updated shipment.
+
+    Raises:
+        DomainError: E_NOT_FOUND if the shipment does not exist, or
+            E_BAD_STATE if the shipment is still in status "created".
+    """
+    shipment = get_shipment(shipment_id)
+    if shipment.status == "created":
+        raise DomainError("E_BAD_STATE", f"{shipment_id} is still in status created")
+    shipment.status = "returned"
+    shipment.returned_at = clock.now()
+    audit.record("shipment.returned", shipment.id)
+    return shipment
