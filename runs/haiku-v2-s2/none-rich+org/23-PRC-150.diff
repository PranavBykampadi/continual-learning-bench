diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_customers.py b/tests/unit/test_customers.py
--- a/tests/unit/test_customers.py	1969-12-31 19:00:00
+++ b/tests/unit/test_customers.py	2026-11-12 03:00:39
@@ -0,0 +1,40 @@
+import pytest
+
+from parcelo import audit, customers
+from parcelo.errors import DomainError
+from parcelo.store import db
+
+
+def test_set_credit_limit_updates_and_returns_new_limit():
+    c = customers.add_customer("Acme")
+    assert customers.set_credit_limit(c.id, 1500) == 1500
+    assert db.customers[c.id].credit_limit == 1500
+
+
+def test_set_credit_limit_to_zero_is_allowed():
+    c = customers.add_customer("Acme")
+    assert customers.set_credit_limit(c.id, 0) == 0
+
+
+def test_set_credit_limit_unknown_customer_fails():
+    with pytest.raises(DomainError) as exc:
+        customers.set_credit_limit("C_missing", 100)
+    assert exc.value.code == "E_NOT_FOUND"
+
+
+def test_set_credit_limit_negative_fails_and_leaves_limit_unchanged():
+    c = customers.add_customer("Acme")
+    before = c.credit_limit
+    with pytest.raises(DomainError) as exc:
+        customers.set_credit_limit(c.id, -1)
+    assert exc.value.code == "E_BAD_INPUT"
+    assert db.customers[c.id].credit_limit == before
+
+
+def test_set_credit_limit_is_audited():
+    c = customers.add_customer("Acme")
+    customers.set_credit_limit(c.id, 900)
+    entry = audit.LOG[-1]
+    assert entry["action"] == "customer.credit_limit_set"
+    assert entry["entity_id"] == c.id
+    assert entry["details"] == {"credit_limit": 900}
