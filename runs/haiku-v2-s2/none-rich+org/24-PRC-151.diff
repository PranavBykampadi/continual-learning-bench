diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/parcelo/shipments.py b/parcelo/shipments.py
--- a/parcelo/shipments.py	2026-11-10 12:20:18
+++ b/parcelo/shipments.py	2026-11-12 03:00:54
@@ -28,3 +28,9 @@
     if shipment_id not in db.shipments:
         raise DomainError("E_NOT_FOUND", shipment_id)
     return db.shipments[shipment_id]
+
+
+def list_shipments(customer_id):
+    if customer_id not in db.customers:
+        raise DomainError("E_UNKNOWN_CUSTOMER", customer_id)
+    return [s for s in db.shipments.values() if s.customer_id == customer_id]
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_shipments.py b/tests/unit/test_shipments.py
--- a/tests/unit/test_shipments.py	2026-11-10 12:20:18
+++ b/tests/unit/test_shipments.py	2026-11-12 03:00:56
@@ -15,3 +15,23 @@
     with pytest.raises(DomainError) as err:
         shipments.create_shipment("nope", 1, "local")
     assert err.value.code == "E_UNKNOWN_CUSTOMER"
+
+
+def test_list_shipments_returns_only_that_customers():
+    a = customers.add_customer("Acme")
+    b = customers.add_customer("Globex")
+    s1 = shipments.create_shipment(a.id, 1, "local")
+    s2 = shipments.create_shipment(a.id, 2, "national")
+    shipments.create_shipment(b.id, 3, "international")
+    assert shipments.list_shipments(a.id) == [s1, s2]
+
+
+def test_list_shipments_empty_for_customer_without_shipments():
+    c = customers.add_customer("Initech")
+    assert shipments.list_shipments(c.id) == []
+
+
+def test_list_shipments_unknown_customer():
+    with pytest.raises(DomainError) as err:
+        shipments.list_shipments("nope")
+    assert err.value.code == "E_UNKNOWN_CUSTOMER"
