--- a/tests/test_reports.py	1969-12-31 19:00:00
+++ b/tests/test_reports.py	2026-11-12 02:56:23
@@ -0,0 +1,43 @@
+from datetime import datetime, timedelta, timezone
+
+from parcelo import clock, reports
+from parcelo.models import Invoice
+from parcelo.store import db
+
+NOW = datetime(2026, 11, 12, 12, 0, tzinfo=timezone.utc)
+
+
+def _add(inv_id, amount, days_old, status="open"):
+    issued = (NOW - timedelta(days=days_old)).replace(tzinfo=None)  # naive UTC, like issue_invoice
+    db.invoices[inv_id] = Invoice(
+        id=inv_id, shipment_id="S", amount=amount, status=status, issued_at=issued
+    )
+
+
+def test_aging_empty_is_all_zero():
+    clock.set_fixed(NOW)
+    assert reports.aging_report() == {"0-30": 0.0, "31-60": 0.0, "60+": 0.0}
+
+
+def test_aging_buckets_and_boundaries():
+    clock.set_fixed(NOW)
+    _add("a", 10.0, 0)
+    _add("b", 5.0, 30)
+    _add("c", 20.0, 31)
+    _add("d", 7.5, 60)
+    _add("e", 1.25, 61)
+    assert reports.aging_report() == {"0-30": 15.0, "31-60": 27.5, "60+": 1.25}
+
+
+def test_aging_skips_paid_invoices():
+    clock.set_fixed(NOW)
+    _add("a", 10.0, 5)
+    _add("b", 99.0, 90, status="paid")
+    assert reports.aging_report() == {"0-30": 10.0, "31-60": 0.0, "60+": 0.0}
+
+
+def test_aging_uses_whole_days():
+    clock.set_fixed(NOW)
+    _add("a", 3.0, 30)
+    db.invoices["a"].issued_at = NOW - timedelta(days=30, hours=23)  # still 30 whole days
+    assert reports.aging_report()["0-30"] == 3.0
