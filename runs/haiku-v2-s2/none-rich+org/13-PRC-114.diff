-from datetime import datetime
+from datetime import datetime, timezone
 
+from parcelo import clock
+from parcelo.legacy.billing import days_between
 from parcelo.store import db
+
+
+def _as_utc(moment):
+    # issue_invoice() stores naive UTC datetimes; clock.now() is aware UTC.
+    # Subtracting naive from aware raises, so normalise before comparing.
+    if moment.tzinfo is None:
+        return moment.replace(tzinfo=timezone.utc)
+    return moment
+
+
+def aging_report():
+    """Total of unpaid invoices by age in whole days since issue."""
+    today = clock.now()
+    buckets = {"0-30": 0.0, "31-60": 0.0, "60+": 0.0}
+    for invoice in db.invoices.values():
+        if invoice.status == "paid":
+            continue
+        age = days_between(_as_utc(invoice.issued_at), today)
+        if age <= 30:
+            key = "0-30"
+        elif age <= 60:
+            key = "31-60"
+        else:
+            key = "60+"
+        buckets[key] += invoice.amount
+    return {key: round(total, 2) for key, total in buckets.items()}
 
 
