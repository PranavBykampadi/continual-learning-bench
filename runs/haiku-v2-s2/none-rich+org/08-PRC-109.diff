diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_addresses.py b/tests/unit/test_addresses.py
--- a/tests/unit/test_addresses.py	1969-12-31 19:00:00
+++ b/tests/unit/test_addresses.py	2026-11-12 02:53:17
@@ -0,0 +1,32 @@
+import pytest
+
+from parcelo import customers
+from parcelo.errors import DomainError
+from parcelo.models import Address
+from parcelo.store import db
+
+
+def test_add_address_stores_and_returns():
+    c = customers.add_customer("Acme")
+    addr = customers.add_address(c.id, "1 Main St", "Springfield")
+    assert isinstance(addr, Address)
+    assert addr.customer_id == c.id
+    assert addr.line == "1 Main St"
+    assert addr.city == "Springfield"
+    assert db.addresses[addr.id] is addr
+
+
+def test_add_address_unknown_customer():
+    with pytest.raises(DomainError) as exc:
+        customers.add_address("C_missing", "1 Main St", "Springfield")
+    assert exc.value.code == "E_UNKNOWN_CUSTOMER"
+    assert db.addresses == {}
+
+
+@pytest.mark.parametrize("line,city", [("", "Springfield"), ("   ", "Springfield"), ("1 Main St", ""), ("1 Main St", "  ")])
+def test_add_address_empty_fields(line, city):
+    c = customers.add_customer("Acme")
+    with pytest.raises(DomainError) as exc:
+        customers.add_address(c.id, line, city)
+    assert exc.value.code == "E_BAD_INPUT"
+    assert db.addresses == {}
