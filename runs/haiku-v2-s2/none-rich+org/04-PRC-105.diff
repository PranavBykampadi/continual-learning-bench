diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/test_refunds.py b/tests/test_refunds.py
--- a/tests/test_refunds.py	1969-12-31 19:00:00
+++ b/tests/test_refunds.py	2026-11-12 02:50:53
@@ -0,0 +1,55 @@
+import pytest
+
+from parcelo import customers, invoices, shipments
+from parcelo.errors import DomainError
+from parcelo.money import Money
+from parcelo.refunds import create_refund
+from parcelo.store import db
+
+
+def _paid_invoice():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 2, "local")
+    inv = invoices.issue_invoice(s.id)
+    invoices.mark_paid(inv.id)
+    return inv
+
+
+def test_refund_paid_invoice_is_stored_and_returned():
+    inv = _paid_invoice()
+    refund = create_refund(inv.id, 3.5)
+    assert refund.invoice_id == inv.id
+    assert refund.amount == Money(350)
+    assert refund.created_at is not None
+    assert db.refunds[refund.id] is refund
+
+
+def test_refund_accepts_money_and_string():
+    inv = _paid_invoice()
+    assert create_refund(inv.id, Money(100)).amount == Money(100)
+    assert create_refund(inv.id, "2.25").amount == Money(225)
+
+
+def test_unknown_invoice_fails():
+    with pytest.raises(DomainError) as exc:
+        create_refund("INV-missing", 1)
+    assert exc.value.code == "E_NOT_FOUND"
+    assert db.refunds == {}
+
+
+def test_unpaid_invoice_fails():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 2, "local")
+    inv = invoices.issue_invoice(s.id)
+    with pytest.raises(DomainError) as exc:
+        create_refund(inv.id, 1)
+    assert exc.value.code == "E_BAD_STATE"
+    assert db.refunds == {}
+
+
+def test_non_positive_amount_fails():
+    inv = _paid_invoice()
+    with pytest.raises(DomainError) as exc:
+        create_refund(inv.id, 0)
+    assert exc.value.code == "E_BAD_INPUT"
+    assert db.refunds == {}
