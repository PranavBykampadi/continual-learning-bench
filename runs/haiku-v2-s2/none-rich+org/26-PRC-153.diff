+def open_invoice_count(customer_id):
+    count = 0
+    for invoice in db.invoices.values():
+        shipment = db.shipments[invoice.shipment_id]
+        if shipment.customer_id == customer_id and invoice.status == "open":
+            count += 1
+    return count
+
+
+def needs_review(customer_id):
+    """True if the customer has more than 3 open invoices or open invoices totalling over 250.00.
+
+    Raises KeyError if the customer does not exist.
+    """
+    get_customer(customer_id)  # fail loudly for unknown customers
+    return open_invoice_count(customer_id) > 3 or outstanding_balance(customer_id) > 250.00
