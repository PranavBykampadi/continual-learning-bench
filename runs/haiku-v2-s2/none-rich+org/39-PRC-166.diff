+def escalate_invoice(invoice_id):
+    """Hand a large unpaid invoice to the collections team.
+
+    Only open invoices of at least 500.00 can be escalated.
+    """
+    if invoice_id not in db.invoices:
+        raise DomainError("E_NOT_FOUND", invoice_id)
+    invoice = db.invoices[invoice_id]
+    if invoice.status != "open":
+        raise DomainError("E_BAD_STATE", "invoice %s is %s" % (invoice_id, invoice.status))
+    if Money.parse(invoice.amount) < ESCALATION_THRESHOLD:
+        raise DomainError("E_BAD_STATE", "invoice %s is below the escalation threshold" % invoice_id)
+    invoice.status = "escalated"
     return invoice
 
 
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/test_escalate_invoice.py b/tests/test_escalate_invoice.py
--- a/tests/test_escalate_invoice.py	1969-12-31 19:00:00
+++ b/tests/test_escalate_invoice.py	2026-11-12 03:06:52
@@ -0,0 +1,46 @@
+import pytest
+
+from parcelo import invoices
+from parcelo.errors import DomainError
+from parcelo.models import Invoice
+from parcelo.store import db
+
+
+def _add(invoice_id, amount, status="open"):
+    inv = Invoice(id=invoice_id, shipment_id="shp", amount=amount, status=status)
+    db.invoices[invoice_id] = inv
+    return inv
+
+
+def test_escalates_open_invoice_at_threshold():
+    _add("INV-1", 500.00)
+    inv = invoices.escalate_invoice("INV-1")
+    assert inv.status == "escalated"
+    assert db.invoices["INV-1"].status == "escalated"
+
+
+def test_escalates_large_open_invoice():
+    _add("INV-2", 1234.5)
+    assert invoices.escalate_invoice("INV-2").status == "escalated"
+
+
+def test_below_threshold_is_rejected():
+    _add("INV-3", 499.99)
+    with pytest.raises(DomainError) as exc:
+        invoices.escalate_invoice("INV-3")
+    assert exc.value.code == "E_BAD_STATE"
+    assert db.invoices["INV-3"].status == "open"
+
+
+def test_non_open_invoice_is_rejected():
+    _add("INV-4", 900.0, status="paid")
+    with pytest.raises(DomainError) as exc:
+        invoices.escalate_invoice("INV-4")
+    assert exc.value.code == "E_BAD_STATE"
+    assert db.invoices["INV-4"].status == "paid"
+
+
+def test_missing_invoice_fails():
+    with pytest.raises(DomainError) as exc:
+        invoices.escalate_invoice("INV-missing")
+    assert exc.value.code == "E_NOT_FOUND"
