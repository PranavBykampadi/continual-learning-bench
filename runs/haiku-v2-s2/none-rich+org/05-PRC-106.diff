 def open_invoices():
     return [i for i in db.invoices.values() if i.status == "open"]
+
+
+def late_fee_for(invoice_id):
+    """Late fee accrued on an invoice as of now.
+
+    The invoice is late 30 days after issue. From then on the fee is 1.5% of
+    the invoice amount for each full day past those 30 days. Rounded to the
+    cent once, at the end.
+    """
+    if invoice_id not in db.invoices:
+        raise DomainError("E_NOT_FOUND", invoice_id)
+    invoice = db.invoices[invoice_id]
+
+    issued = invoice.issued_at
+    if issued.tzinfo is None:
+        # issue_invoice stores naive UTC; make it aware before comparing.
+        issued = issued.replace(tzinfo=timezone.utc)
+    days_late = (clock.now() - issued).days - LATE_AFTER_DAYS
+    if days_late <= 0:
+        return Money.zero()
+
+    amount = Money.parse(invoice.amount)
+    return amount.scale(LATE_FEE_PER_DAY * days_late)
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/test_invoices.py b/tests/test_invoices.py
