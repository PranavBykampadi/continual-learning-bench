@@ -1,9 +1,51 @@
-from parcelo import customers, invoices, shipments
+from datetime import datetime, timedelta, timezone
 
+import pytest
 
+from parcelo import clock, customers, invoices, shipments
+from parcelo.errors import DomainError
+from parcelo.models import Invoice
+from parcelo.money import Money
+from parcelo.store import db
+
+
 def test_issue_and_pay():
     c = customers.add_customer("Acme")
     s = shipments.create_shipment(c.id, 2, "local")
     inv = invoices.issue_invoice(s.id)
     assert inv.amount == 7.0
     assert invoices.mark_paid(inv.id).status == "paid"
+
+
+def _invoice_issued_at(issued, amount=100.0):
+    inv = Invoice(id="INV-test", shipment_id="shp_x", amount=amount, issued_at=issued)
+    db.invoices[inv.id] = inv
+    return inv
+
+
+def test_late_fee_zero_before_thirty_days():
+    issued = datetime(2026, 1, 1, tzinfo=timezone.utc)
+    _invoice_issued_at(issued)
+    clock.set_fixed(issued + timedelta(days=30))
+    assert invoices.late_fee_for("INV-test") == Money.zero()
+
+
+def test_late_fee_accrues_per_day_past_thirty():
+    issued = datetime(2026, 1, 1, tzinfo=timezone.utc)
+    _invoice_issued_at(issued, amount=100.0)
+    clock.set_fixed(issued + timedelta(days=40))
+    # 10 full days past day 30: 1.5% * 10 of 100.00 = 15.00
+    assert invoices.late_fee_for("INV-test") == Money.parse(15.0)
+
+
+def test_late_fee_handles_naive_issued_at_from_issue_invoice():
+    issued = datetime(2026, 1, 1)  # naive UTC, as issue_invoice writes it
+    _invoice_issued_at(issued, amount=100.0)
+    clock.set_fixed(datetime(2026, 1, 1, 0, 0, tzinfo=timezone.utc) + timedelta(days=32))
+    assert invoices.late_fee_for("INV-test") == Money.parse(3.0)
+
+
+def test_late_fee_unknown_invoice_raises():
+    with pytest.raises(DomainError) as err:
+        invoices.late_fee_for("INV-missing")
+    assert err.value.code == "E_NOT_FOUND"
