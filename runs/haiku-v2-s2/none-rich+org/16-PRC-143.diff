diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_pickups.py b/tests/unit/test_pickups.py
--- a/tests/unit/test_pickups.py	1969-12-31 19:00:00
+++ b/tests/unit/test_pickups.py	2026-11-12 02:57:52
@@ -0,0 +1,47 @@
+import pytest
+
+from parcelo import audit, clock, customers, pickups, shipments, store
+from parcelo.errors import DomainError
+
+
+def _created_shipment():
+    c = customers.add_customer("Acme")
+    return shipments.create_shipment(c.id, 2.0, "local")
+
+
+def test_schedule_pickup_creates_and_stores_pickup():
+    clock.set_fixed(clock.now())
+    s = _created_shipment()
+    window = clock.now()
+    p = pickups.schedule_pickup(s.id, window)
+    assert p.id.startswith("pck_")
+    assert p.shipment_id == s.id
+    assert p.window_start == window
+    assert p.scheduled_at == clock.now()
+    assert store.db.pickups[p.id] is p
+    assert audit.LOG[-1]["action"] == "pickup.scheduled"
+    assert audit.LOG[-1]["entity_id"] == p.id
+
+
+def test_unknown_shipment_fails():
+    with pytest.raises(DomainError) as err:
+        pickups.schedule_pickup("shp_missing", clock.now())
+    assert err.value.code == "E_NOT_FOUND"
+    assert store.db.pickups == {}
+
+
+@pytest.mark.parametrize("status", ["in_transit", "delivered", "cancelled"])
+def test_shipment_not_created_fails(status):
+    s = _created_shipment()
+    s.status = status
+    with pytest.raises(DomainError) as err:
+        pickups.schedule_pickup(s.id, clock.now())
+    assert err.value.code == "E_BAD_STATE"
+    assert store.db.pickups == {}
+
+
+def test_reset_clears_pickups():
+    s = _created_shipment()
+    pickups.schedule_pickup(s.id, clock.now())
+    store.reset()
+    assert store.db.pickups == {}
