@@ -0,0 +1,33 @@
+from parcelo import audit, clock, ids
+from parcelo.errors import DomainError
+from parcelo.models import Pickup
+from parcelo.shipments import get_shipment
+from parcelo.store import db
+
+
+def schedule_pickup(shipment_id: str, window_start: object) -> Pickup:
+    """Book a driver pickup for a shipment that is ready to go.
+
+    Args:
+        shipment_id: Id of the shipment to pick up.
+        window_start: Start of the pickup window.
+
+    Returns:
+        The newly created Pickup.
+
+    Raises:
+        DomainError: E_NOT_FOUND if the shipment does not exist, or
+            E_BAD_STATE if the shipment is not in status "created".
+    """
+    shipment = get_shipment(shipment_id)  # raises E_NOT_FOUND
+    if shipment.status != "created":
+        raise DomainError("E_BAD_STATE", f"{shipment_id} is {shipment.status}")
+    pickup = Pickup(
+        id=ids.new_id("pck"),
+        shipment_id=shipment_id,
+        window_start=window_start,
+        scheduled_at=clock.now(),
+    )
+    db.pickups[pickup.id] = pickup
+    audit.record("pickup.scheduled", pickup.id, shipment_id=shipment_id)
+    return pickup
