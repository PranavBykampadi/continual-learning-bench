+++ b/parcelo/claims.py	2026-11-12 02:54:57
@@ -0,0 +1,36 @@
+import math
+from decimal import Decimal
+
+from parcelo import audit, clock, ids
+from parcelo.errors import DomainError
+from parcelo.models import Claim
+from parcelo.shipments import get_shipment
+from parcelo.store import db
+
+
+def _valid_amount(amount):
+    if isinstance(amount, bool) or not isinstance(amount, (int, float, Decimal)):
+        return False
+    if isinstance(amount, float) and not math.isfinite(amount):
+        return False
+    return amount > 0
+
+
+def file_claim(shipment_id, amount, reason):
+    if not _valid_amount(amount):
+        raise DomainError("E_BAD_INPUT", f"amount must be a positive number: {amount!r}")
+    shipment = get_shipment(shipment_id)  # raises E_NOT_FOUND
+    if shipment.status != "delivered":
+        raise DomainError(
+            "E_BAD_STATE", f"claims need a delivered shipment, got {shipment.status}"
+        )
+    claim = Claim(
+        id=ids.new_id("clm"),
+        shipment_id=shipment_id,
+        amount=amount,
+        reason=reason,
+        filed_at=clock.now(),
+    )
+    db.claims[claim.id] = claim
+    audit.record("claim.filed", claim.id, shipment_id=shipment_id, amount=amount)
+    return claim
