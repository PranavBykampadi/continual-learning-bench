+def apply_credit(invoice_id, amount):
+    """Reduce an open invoice's amount by a credit.
+
+    The invoice stays open; only its amount changes, so reports and
+    customer balances pick up the reduced figure.
+
+    Args:
+        invoice_id: ID of the invoice to credit.
+        amount: Credit to apply, in dollars. Must be positive and no
+            larger than the invoice's current amount.
+
+    Returns:
+        The remaining invoice amount in dollars, as a float.
+
+    Raises:
+        DomainError: With E_NOT_FOUND if the invoice does not exist,
+            E_BAD_STATE if it is not open, and E_BAD_INPUT if the credit
+            is not positive or exceeds the invoice amount.
+    """
+    if invoice_id not in db.invoices:
+        raise DomainError("E_NOT_FOUND", invoice_id)
+    invoice = db.invoices[invoice_id]
+    if invoice.status != "open":
+        raise DomainError("E_BAD_STATE", f"{invoice_id} is {invoice.status}")
+
+    credit = Money.parse(amount)
+    if credit.cents <= 0:
+        raise DomainError("E_BAD_INPUT", f"credit must be positive, got {amount}")
+    current = Money.parse(invoice.amount)
+    if current < credit:
+        raise DomainError("E_BAD_INPUT", f"credit {credit} exceeds invoice {current}")
+
+    remaining = current - credit
+    invoice.amount = round(remaining.cents / 100, 2)
+    audit.record(
+        "invoice.credit_applied",
+        invoice_id,
+        credit=round(credit.cents / 100, 2),
+        remaining=invoice.amount,
+    )
+    return invoice.amount
