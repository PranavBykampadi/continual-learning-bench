+
+
+def _open_invoice():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 2, "local")
+    return c, invoices.issue_invoice(s.id)
+
+
+def test_apply_credit_reduces_open_invoice():
+    c, inv = _open_invoice()
+    assert invoices.apply_credit(inv.id, 2.5) == 4.5
+    assert inv.amount == 4.5
+    assert inv.status == "open"
+    assert customers.outstanding_balance(c.id) == 4.5
+    assert invoices.open_invoices() == [inv]
+
+
+def test_apply_credit_rounds_to_cents():
+    _, inv = _open_invoice()
+    assert invoices.apply_credit(inv.id, 0.1) == 6.9
+    assert invoices.apply_credit(inv.id, 0.2) == 6.7
+
+
+def test_apply_credit_equal_to_amount_leaves_zero():
+    c, inv = _open_invoice()
+    assert invoices.apply_credit(inv.id, 7.0) == 0.0
+    assert customers.outstanding_balance(c.id) == 0.0
+
+
+def test_apply_credit_records_audit():
+    from parcelo import audit
+
+    _, inv = _open_invoice()
+    invoices.apply_credit(inv.id, 1.0)
+    assert audit.LOG[-1]["action"] == "invoice.credit_applied"
+    assert audit.LOG[-1]["entity_id"] == inv.id
+
+
+def test_apply_credit_unknown_invoice():
+    with pytest.raises(DomainError) as err:
+        invoices.apply_credit("INV-nope", 1.0)
+    assert err.value.code == "E_NOT_FOUND"
+
+
+def test_apply_credit_paid_invoice():
+    _, inv = _open_invoice()
+    invoices.mark_paid(inv.id)
+    with pytest.raises(DomainError) as err:
+        invoices.apply_credit(inv.id, 1.0)
+    assert err.value.code == "E_BAD_STATE"
+    assert inv.amount == 7.0
+
+
+def test_apply_credit_larger_than_amount():
+    _, inv = _open_invoice()
+    with pytest.raises(DomainError) as err:
+        invoices.apply_credit(inv.id, 7.01)
+    assert err.value.code == "E_BAD_INPUT"
+    assert inv.amount == 7.0
+
+
+@pytest.mark.parametrize("bad", [0, -1.0])
+def test_apply_credit_non_positive(bad):
+    _, inv = _open_invoice()
+    with pytest.raises(DomainError) as err:
+        invoices.apply_credit(inv.id, bad)
+    assert err.value.code == "E_BAD_INPUT"
+    assert inv.amount == 7.0
