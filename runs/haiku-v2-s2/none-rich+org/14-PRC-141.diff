diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/parcelo/shipments.py b/parcelo/shipments.py
--- a/parcelo/shipments.py	2026-11-10 12:20:18
+++ b/parcelo/shipments.py	2026-11-12 02:56:44
@@ -28,3 +28,20 @@
     if shipment_id not in db.shipments:
         raise DomainError("E_NOT_FOUND", shipment_id)
     return db.shipments[shipment_id]
+
+
+def reassign_shipment(shipment_id, new_customer_id):
+    shipment = get_shipment(shipment_id)
+    if new_customer_id not in db.customers:
+        raise DomainError("E_UNKNOWN_CUSTOMER", new_customer_id)
+    if shipment.status == "delivered" or shipment.delivered_at is not None:
+        raise DomainError("E_BAD_STATE", shipment_id)
+    old_customer_id = shipment.customer_id
+    shipment.customer_id = new_customer_id
+    events.emit(
+        "shipment.reassigned",
+        shipment.id,
+        from_customer=old_customer_id,
+        to_customer=new_customer_id,
+    )
+    return shipment
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_shipments.py b/tests/unit/test_shipments.py
--- a/tests/unit/test_shipments.py	2026-11-10 12:20:18
+++ b/tests/unit/test_shipments.py	2026-11-12 02:56:46
@@ -15,3 +15,40 @@
     with pytest.raises(DomainError) as err:
         shipments.create_shipment("nope", 1, "local")
     assert err.value.code == "E_UNKNOWN_CUSTOMER"
+
+
+def test_reassign_changes_customer():
+    a = customers.add_customer("Acme")
+    b = customers.add_customer("Beta")
+    s = shipments.create_shipment(a.id, 2, "local")
+    out = shipments.reassign_shipment(s.id, b.id)
+    assert out is s
+    assert s.customer_id == b.id
+    assert events.OUTBOX[-1]["name"] == "shipment.reassigned"
+
+
+def test_reassign_unknown_shipment():
+    b = customers.add_customer("Beta")
+    with pytest.raises(DomainError) as err:
+        shipments.reassign_shipment("shp_999999", b.id)
+    assert err.value.code == "E_NOT_FOUND"
+
+
+def test_reassign_unknown_customer():
+    a = customers.add_customer("Acme")
+    s = shipments.create_shipment(a.id, 2, "local")
+    with pytest.raises(DomainError) as err:
+        shipments.reassign_shipment(s.id, "nope")
+    assert err.value.code == "E_UNKNOWN_CUSTOMER"
+    assert s.customer_id == a.id
+
+
+def test_reassign_delivered_shipment_fails():
+    a = customers.add_customer("Acme")
+    b = customers.add_customer("Beta")
+    s = shipments.create_shipment(a.id, 2, "local")
+    s.status = "delivered"
+    with pytest.raises(DomainError) as err:
+        shipments.reassign_shipment(s.id, b.id)
+    assert err.value.code == "E_BAD_STATE"
+    assert s.customer_id == a.id
