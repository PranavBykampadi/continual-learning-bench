diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/parcelo/rates.py b/parcelo/rates.py
--- a/parcelo/rates.py	2026-11-10 12:17:53
+++ b/parcelo/rates.py	2026-11-12 02:49:29
@@ -1,3 +1,5 @@
+from parcelo.legacy.billing import fuel_surcharge
+
 ZONE_BASE = {"local": 4.5, "national": 9.0, "international": 24.0}
 PER_KG = 1.25
 
@@ -12,3 +14,23 @@
     if weight_kg <= 0:
         raise ValueError("weight must be positive")
     return round(base_rate(zone) + PER_KG * weight_kg, 2)
+
+
+def quote_with_surcharge(weight_kg, zone):
+    """Return the quote plus the zone's fuel surcharge.
+
+    Result is a dict with ``quote`` (normal quote), ``surcharge`` (fuel
+    surcharge on the unrounded amount) and ``total`` (quote + surcharge).
+    Rounding happens once, at the end, per the pricing notes.
+    """
+    if weight_kg <= 0:
+        raise ValueError("weight must be positive")
+    # Validates the zone (raises ValueError if unknown).
+    raw = base_rate(zone) + PER_KG * weight_kg
+    surcharge = fuel_surcharge(raw, zone)
+    base = round(raw, 2)
+    return {
+        "quote": base,
+        "surcharge": surcharge,
+        "total": round(base + surcharge, 2),
+    }
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/test_rates.py b/tests/test_rates.py
