+++ b/tests/test_rates.py	2026-11-12 02:49:33
@@ -10,3 +10,33 @@
 def test_unknown_zone():
     with pytest.raises(ValueError):
         rates.base_rate("moon")
+
+
+def test_quote_with_surcharge_local_has_no_surcharge():
+    result = rates.quote_with_surcharge(2, "local")
+    assert result == {"quote": 7.0, "surcharge": 0.0, "total": 7.0}
+
+
+def test_quote_with_surcharge_national():
+    # quote 9.0 + 2.5 = 11.5; 4% = 0.46
+    result = rates.quote_with_surcharge(2, "national")
+    assert result == {"quote": 11.5, "surcharge": 0.46, "total": 11.96}
+
+
+def test_quote_with_surcharge_international():
+    # quote 24.0 + 2.5 = 26.5; 9.5% = 2.5175 -> 2.52
+    result = rates.quote_with_surcharge(2, "international")
+    assert result["quote"] == 26.5
+    assert result["surcharge"] == 2.52
+    assert result["total"] == 29.02
+
+
+def test_quote_with_surcharge_unknown_zone():
+    with pytest.raises(ValueError):
+        rates.quote_with_surcharge(2, "moon")
+
+
+@pytest.mark.parametrize("weight", [0, -1])
+def test_quote_with_surcharge_rejects_non_positive_weight(weight):
+    with pytest.raises(ValueError):
+        rates.quote_with_surcharge(weight, "national")
