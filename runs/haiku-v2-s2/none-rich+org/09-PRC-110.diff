diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/parcelo/rates.py b/parcelo/rates.py
--- a/parcelo/rates.py	2026-11-10 12:17:53
+++ b/parcelo/rates.py	2026-11-12 02:53:40
@@ -1,3 +1,5 @@
+from parcelo.legacy.billing import apply_discount
+
 ZONE_BASE = {"local": 4.5, "national": 9.0, "international": 24.0}
 PER_KG = 1.25
 
@@ -8,7 +10,17 @@
     return ZONE_BASE[zone]
 
 
+TIER_DISCOUNT_PCT = {"standard": 0.0, "gold": 10.0}
+
+
 def quote(weight_kg, zone):
     if weight_kg <= 0:
         raise ValueError("weight must be positive")
     return round(base_rate(zone) + PER_KG * weight_kg, 2)
+
+
+def discounted_quote(weight_kg, zone, tier):
+    if tier not in TIER_DISCOUNT_PCT:
+        raise ValueError("unknown tier: %s" % tier)
+    regular = quote(weight_kg, zone)
+    return apply_discount(regular, TIER_DISCOUNT_PCT[tier])
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/test_rates.py b/tests/test_rates.py
--- a/tests/test_rates.py	2026-11-10 12:17:53
+++ b/tests/test_rates.py	2026-11-12 02:53:43
@@ -10,3 +10,22 @@
 def test_unknown_zone():
     with pytest.raises(ValueError):
         rates.base_rate("moon")
+
+
+def test_discounted_quote_gold():
+    # quote(2, "local") == 7.0, 10% off -> 6.3
+    assert rates.discounted_quote(2, "local", "gold") == 6.3
+
+
+def test_discounted_quote_standard_matches_quote():
+    assert rates.discounted_quote(2, "local", "standard") == rates.quote(2, "local")
+
+
+def test_discounted_quote_unknown_zone():
+    with pytest.raises(ValueError):
+        rates.discounted_quote(2, "moon", "gold")
+
+
+def test_discounted_quote_unknown_tier():
+    with pytest.raises(ValueError):
+        rates.discounted_quote(2, "local", "platinum")
