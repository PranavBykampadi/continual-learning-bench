 def base_rate(zone):
@@ -12,3 +14,16 @@
     if weight_kg <= 0:
         raise ValueError("weight must be positive")
     return round(base_rate(zone) + PER_KG * weight_kg, 2)
+
+
+def heavy_quote(weight_kg, zone):
+    """Quote plus HEAVY_PER_KG for each kg above HEAVY_THRESHOLD_KG.
+
+    Rounds to cents once, at the end, so the surcharge on fractional kg
+    is not rounded away before it is added.
+    """
+    if weight_kg <= 0:
+        raise ValueError("weight must be positive")
+    raw = base_rate(zone) + PER_KG * weight_kg
+    excess = max(0, weight_kg - HEAVY_THRESHOLD_KG)
+    return round(raw + HEAVY_PER_KG * excess, 2)
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/test_rates.py b/tests/test_rates.py
--- a/tests/test_rates.py	2026-11-10 12:17:53
+++ b/tests/test_rates.py	2026-11-12 03:02:26
@@ -10,3 +10,29 @@
 def test_unknown_zone():
     with pytest.raises(ValueError):
         rates.base_rate("moon")
+
+
+def test_heavy_quote_at_threshold_is_normal_quote():
+    assert rates.heavy_quote(30, "local") == rates.quote(30, "local")
+
+
+def test_heavy_quote_adds_surcharge_above_threshold():
+    # 4.5 + 1.25*40 + 0.75*10 = 62.0
+    assert rates.heavy_quote(40, "local") == 62.0
+
+
+def test_heavy_quote_fractional_kg_rounds_once_at_end():
+    # 4.5 + 1.25*30.1 + 0.75*0.1 = 42.125 + 0.075 = 42.2
+    assert rates.heavy_quote(30.1, "local") == 42.2
+
+
+def test_heavy_quote_unknown_zone():
+    with pytest.raises(ValueError):
+        rates.heavy_quote(40, "moon")
+
+
+def test_heavy_quote_non_positive_weight():
+    with pytest.raises(ValueError):
+        rates.heavy_quote(0, "local")
+    with pytest.raises(ValueError):
+        rates.heavy_quote(-1, "local")
