+def rebate_for(customer_id):
+    """Volume rebate earned by a customer: a share of their paid invoices.
+
+    Tiers follow ``volume_tier``: 0% under 10 shipments, 3% from 10,
+    6% from 50. Raises DomainError if the customer does not exist.
+    """
+    if customer_id not in db.customers:
+        raise DomainError("E_UNKNOWN_CUSTOMER", customer_id)
+
+    shipment_ids = set()
+    shipment_count = 0
+    for shipment in db.shipments.values():
+        if shipment.customer_id == customer_id:
+            shipment_ids.add(shipment.id)
+            shipment_count += 1
+
+    paid_total = 0.0
+    for invoice in db.invoices.values():
+        if invoice.shipment_id in shipment_ids and invoice.status == "paid":
+            paid_total += invoice.amount
+
+    pct = REBATE_PCT[volume_tier(shipment_count)]
+    return round(paid_total * pct / 100.0, 2)
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/test_rebates.py b/tests/test_rebates.py
--- a/tests/test_rebates.py	1969-12-31 19:00:00
+++ b/tests/test_rebates.py	2026-11-12 03:04:39
@@ -0,0 +1,53 @@
+import pytest
+
+from parcelo import customers, invoices, shipments, store
+from parcelo.errors import DomainError
+
+
+def _paid_shipments(customer_id, count, weight=2):
+    """Create `count` shipments for the customer, each invoiced and paid at 7.0."""
+    for _ in range(count):
+        s = shipments.create_shipment(customer_id, weight, "local")
+        inv = invoices.issue_invoice(s.id)
+        invoices.mark_paid(inv.id)
+
+
+def test_no_rebate_under_ten_shipments():
+    c = customers.add_customer("Acme")
+    _paid_shipments(c.id, 9)
+    assert customers.rebate_for(c.id) == 0.0
+
+
+def test_three_percent_from_ten_shipments():
+    c = customers.add_customer("Acme")
+    _paid_shipments(c.id, 10)
+    assert customers.rebate_for(c.id) == round(70.0 * 0.03, 2)
+
+
+def test_six_percent_from_fifty_shipments():
+    c = customers.add_customer("Acme")
+    _paid_shipments(c.id, 50)
+    assert customers.rebate_for(c.id) == round(350.0 * 0.06, 2)
+
+
+def test_only_paid_invoices_count():
+    c = customers.add_customer("Acme")
+    _paid_shipments(c.id, 10)
+    s = shipments.create_shipment(c.id, 2, "local")
+    invoices.issue_invoice(s.id)  # open, not paid
+    assert customers.rebate_for(c.id) == round(70.0 * 0.03, 2)
+
+
+def test_other_customers_do_not_count():
+    a = customers.add_customer("Acme")
+    b = customers.add_customer("Bolt")
+    _paid_shipments(a.id, 10)
+    _paid_shipments(b.id, 3)
+    assert customers.rebate_for(b.id) == 0.0
+    assert customers.rebate_for(a.id) == round(70.0 * 0.03, 2)
+
+
+def test_unknown_customer_fails():
+    with pytest.raises(DomainError) as exc:
+        customers.rebate_for("C-missing")
+    assert exc.value.code == "E_UNKNOWN_CUSTOMER"
