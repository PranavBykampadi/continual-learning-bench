diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/parcelo/returns.py b/parcelo/returns.py
--- a/parcelo/returns.py	1969-12-31 19:00:00
+++ b/parcelo/returns.py	2026-11-12 03:03:24
@@ -0,0 +1,53 @@
+from parcelo import audit, clock, ids
+from parcelo.errors import DomainError
+from parcelo.models import ReturnRequest
+from parcelo.shipments import get_shipment
+from parcelo.store import db
+
+MAX_RETURNS_PER_SHIPMENT = 3
+
+
+def request_return(shipment_id: str, reason: str) -> ReturnRequest:
+    """File a return request for a delivered shipment.
+
+    Args:
+        shipment_id: Id of the delivered shipment being sent back.
+        reason: Customer-given reason for the return.
+
+    Returns:
+        The stored ReturnRequest.
+
+    Raises:
+        DomainError: E_NOT_FOUND if the shipment does not exist, E_BAD_STATE
+            if it has not been delivered, E_LIMIT if the shipment already has
+            the maximum number of return requests.
+    """
+    shipment = get_shipment(shipment_id)
+    if shipment.status != "delivered":
+        raise DomainError("E_BAD_STATE", f"{shipment_id} is {shipment.status}")
+    if len(returns_for(shipment_id)) >= MAX_RETURNS_PER_SHIPMENT:
+        raise DomainError(
+            "E_LIMIT", f"{shipment_id} already has {MAX_RETURNS_PER_SHIPMENT} returns"
+        )
+
+    request = ReturnRequest(
+        id=ids.new_id("ret"),
+        shipment_id=shipment_id,
+        reason=reason,
+        requested_at=clock.now(),
+    )
+    db.returns[request.id] = request
+    audit.record("return.requested", request.id, shipment_id=shipment_id)
+    return request
+
+
+def returns_for(shipment_id: str) -> list[ReturnRequest]:
+    """List the return requests filed for a shipment.
+
+    Args:
+        shipment_id: Id of the shipment.
+
+    Returns:
+        Return requests for the shipment, in the order they were filed.
+    """
+    return [r for r in db.returns.values() if r.shipment_id == shipment_id]
