+def reactivate_customer(customer_id):
+    """Set a customer's active flag back to True.
+
+    Reactivating a customer that is already active changes nothing and emits no event.
+
+    Args:
+        customer_id: ID of the customer to reactivate.
+
+    Returns:
+        The customer, with ``active`` set to True.
+
+    Raises:
+        DomainError: ``E_UNKNOWN_CUSTOMER`` if no customer has this ID.
+    """
+    if customer_id not in db.customers:
+        raise DomainError("E_UNKNOWN_CUSTOMER", customer_id)
+    customer = db.customers[customer_id]
+    if customer.active:
+        return customer
+    customer.active = True
+    events.emit("customer.reactivated", customer.id)
+    return customer
 
 
