diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_customers_reactivate.py b/tests/unit/test_customers_reactivate.py
--- a/tests/unit/test_customers_reactivate.py	1969-12-31 19:00:00
+++ b/tests/unit/test_customers_reactivate.py	2026-11-12 03:14:05
@@ -0,0 +1,64 @@
+import pytest
+
+from parcelo import clock, customers, events, store
+from parcelo.errors import DomainError
+
+
+def _inactive_customer():
+    c = customers.add_customer("Acme")
+    c.active = False
+    return c
+
+
+def test_reactivate_sets_active_and_emits_event():
+    clock.set_fixed("2026-11-12T00:00:00+00:00")
+    c = _inactive_customer()
+    events.OUTBOX.clear()
+
+    result = customers.reactivate_customer(c.id)
+
+    assert result is c
+    assert c.active is True
+    assert len(events.OUTBOX) == 1
+    assert events.OUTBOX[-1]["name"] == "customer.reactivated"
+    assert events.OUTBOX[-1]["entity_id"] == c.id
+    assert events.OUTBOX[-1]["at"] == "2026-11-12T00:00:00+00:00"
+
+
+def test_reactivate_unknown_customer_raises():
+    with pytest.raises(DomainError) as err:
+        customers.reactivate_customer("C-does-not-exist")
+    assert err.value.code == "E_UNKNOWN_CUSTOMER"
+    assert events.OUTBOX == []
+
+
+def test_reactivate_already_active_is_noop():
+    c = customers.add_customer("Acme")
+    events.OUTBOX.clear()
+
+    result = customers.reactivate_customer(c.id)
+
+    assert result is c
+    assert c.active is True
+    assert events.OUTBOX == []
+
+
+def test_reactivate_twice_emits_one_event():
+    c = _inactive_customer()
+    events.OUTBOX.clear()
+
+    customers.reactivate_customer(c.id)
+    customers.reactivate_customer(c.id)
+
+    assert c.active is True
+    assert len([e for e in events.OUTBOX if e["name"] == "customer.reactivated"]) == 1
+    assert len(events.OUTBOX) == 1
+
+
+def test_reactivate_does_not_add_customers():
+    c = _inactive_customer()
+    before = set(store.db.customers)
+
+    customers.reactivate_customer(c.id)
+
+    assert set(store.db.customers) == before
