     with pytest.raises(DomainError) as err:
         shipments.create_shipment("nope", 1, "local")
     assert err.value.code == "E_UNKNOWN_CUSTOMER"
+
+
+def test_shipments_in_zone_filters_and_sorts_by_id():
+    c = customers.add_customer("Acme")
+    first = shipments.create_shipment(c.id, 1, "local")  # lowest id
+    other = shipments.create_shipment(c.id, 1, "national")
+    third = shipments.create_shipment(c.id, 2, "local")  # highest id
+    # Re-insert in reverse id order so storage order differs from id order.
+    db.shipments.clear()
+    for s in (third, other, first):
+        db.shipments[s.id] = s
+    got = shipments.shipments_in_zone("local")
+    assert [s.id for s in got] == [first.id, third.id]
+    assert all(s.zone == "local" for s in got)
+
+
+def test_shipments_in_zone_empty_when_none():
+    c = customers.add_customer("Acme")
+    shipments.create_shipment(c.id, 1, "national")
+    assert shipments.shipments_in_zone("international") == []
+
+
+def test_shipments_in_zone_unknown_zone_raises():
+    with pytest.raises(DomainError) as err:
+        shipments.shipments_in_zone("moon")
+    assert err.value.code == "E_BAD_ZONE"
+
+
+def test_shipments_in_zone_emits_nothing():
+    c = customers.add_customer("Acme")
+    shipments.create_shipment(c.id, 1, "local")
+    events.OUTBOX.clear()
+    shipments.shipments_in_zone("local")
+    assert events.OUTBOX == []
