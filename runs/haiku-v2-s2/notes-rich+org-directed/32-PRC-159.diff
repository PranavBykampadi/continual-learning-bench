     if shipment_id not in db.shipments:
         raise DomainError("E_NOT_FOUND", shipment_id)
     return db.shipments[shipment_id]
+
+
+def shipments_in_zone(zone: str) -> list[Shipment]:
+    """List the shipments going to a zone, sorted by id ascending.
+
+    Read-only: emits no events and writes no audit records.
+
+    Args:
+        zone: A zone name from ZONE_BASE.
+
+    Returns:
+        The shipments whose zone is `zone`, or an empty list if there are none.
+
+    Raises:
+        DomainError: With code E_BAD_ZONE if `zone` is not a known zone.
+    """
+    if zone not in ZONE_BASE:
+        raise DomainError("E_BAD_ZONE", zone)
+    matches = [s for s in db.shipments.values() if s.zone == zone]
+    return sorted(matches, key=lambda s: s.id)
