@@ -0,0 +1,91 @@
+import pytest
+
+from parcelo import customers, events
+from parcelo.errors import DomainError
+from parcelo.models import Invoice, Shipment
+from parcelo.store import db
+
+
+def _add_open_invoices(customer_id, amounts, status="open"):
+    shipment = Shipment(
+        id=f"shp_test_{len(db.shipments)}",
+        customer_id=customer_id,
+        weight_kg=1.0,
+        zone="local",
+    )
+    db.shipments[shipment.id] = shipment
+    for amount in amounts:
+        invoice = Invoice(
+            id=f"INV-test-{len(db.invoices)}",
+            shipment_id=shipment.id,
+            amount=amount,
+            status=status,
+        )
+        db.invoices[invoice.id] = invoice
+
+
+def test_no_invoices_does_not_need_review():
+    c = customers.add_customer("Acme")
+    assert customers.needs_review(c.id) is False
+
+
+def test_three_open_invoices_is_not_enough():
+    c = customers.add_customer("Acme")
+    _add_open_invoices(c.id, [1.0, 1.0, 1.0])
+    assert customers.needs_review(c.id) is False
+
+
+def test_more_than_three_open_invoices_needs_review():
+    c = customers.add_customer("Acme")
+    _add_open_invoices(c.id, [1.0, 1.0, 1.0, 1.0])
+    assert customers.needs_review(c.id) is True
+
+
+def test_open_balance_at_limit_does_not_need_review():
+    c = customers.add_customer("Acme")
+    _add_open_invoices(c.id, [250.00])
+    assert customers.needs_review(c.id) is False
+
+
+def test_open_balance_over_limit_needs_review():
+    c = customers.add_customer("Acme")
+    _add_open_invoices(c.id, [125.00, 125.01])
+    assert customers.needs_review(c.id) is True
+
+
+def test_balance_is_summed_in_cents_not_floats():
+    # Sums to exactly 250.00. Float addition can land just above 250.00 here,
+    # which would wrongly flag the customer, so the total must be computed in Money.
+    c = customers.add_customer("Acme")
+    _add_open_invoices(c.id, [249.70, 0.10, 0.20])
+    assert customers.needs_review(c.id) is False
+
+
+def test_paid_invoices_are_ignored():
+    c = customers.add_customer("Acme")
+    _add_open_invoices(c.id, [100.0, 100.0, 100.0, 100.0], status="paid")
+    _add_open_invoices(c.id, [10.0])
+    assert customers.needs_review(c.id) is False
+
+
+def test_other_customers_invoices_are_ignored():
+    c = customers.add_customer("Acme")
+    other = customers.add_customer("Other")
+    _add_open_invoices(other.id, [200.0, 200.0])
+    _add_open_invoices(c.id, [1.0])
+    assert customers.needs_review(c.id) is False
+
+
