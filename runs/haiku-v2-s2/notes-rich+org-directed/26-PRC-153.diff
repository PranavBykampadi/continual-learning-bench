+def needs_review(customer_id: str) -> bool:
+    """Return True if the customer's open invoices need a manual account review.
+
+    A review is needed when the customer has more than
+    settings.OPEN_INVOICE_COUNT_REVIEW_LIMIT open invoices, or their open invoices
+    total more than settings.OPEN_BALANCE_REVIEW_LIMIT.
+
+    Args:
+        customer_id: Id of the customer to check.
+
+    Returns:
+        True if the customer needs a review, False otherwise.
+
+    Raises:
+        DomainError: E_NOT_FOUND if the customer does not exist.
+    """
+    if customer_id not in db.customers:
+        raise DomainError("E_NOT_FOUND", customer_id)
+    open_count = 0
+    open_balance = Money.zero()
+    for invoice in db.invoices.values():
+        shipment = db.shipments[invoice.shipment_id]
+        if shipment.customer_id == customer_id and invoice.status == "open":
+            open_count += 1
+            open_balance = open_balance + Money.parse(invoice.amount)
+    return (
+        open_count > settings.OPEN_INVOICE_COUNT_REVIEW_LIMIT
+        or settings.OPEN_BALANCE_REVIEW_LIMIT < open_balance
+    )
