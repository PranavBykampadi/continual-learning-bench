@@ -0,0 +1,9 @@
+from parcelo.money import Money
+
+# Business thresholds. Finance and product may ask us to change these, so keep them here.
+
+# A customer with more than this many open invoices needs a manual review.
+OPEN_INVOICE_COUNT_REVIEW_LIMIT = 3
+
+# A customer whose open invoices total more than this needs a manual review.
+OPEN_BALANCE_REVIEW_LIMIT = Money.parse("250.00")
