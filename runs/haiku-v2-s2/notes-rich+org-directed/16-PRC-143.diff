diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_pickups.py b/tests/unit/test_pickups.py
--- a/tests/unit/test_pickups.py	1969-12-31 19:00:00
+++ b/tests/unit/test_pickups.py	2026-11-12 03:03:53
@@ -0,0 +1,54 @@
+from datetime import datetime, timezone
+
+import pytest
+
+from parcelo import clock, customers, events, pickups, shipments, store
+from parcelo.errors import DomainError
+
+WINDOW = datetime(2026, 11, 13, 9, 0, tzinfo=timezone.utc)
+
+
+def _created_shipment():
+    c = customers.add_customer("Acme")
+    return shipments.create_shipment(c.id, 1.5, "national")
+
+
+def test_schedule_pickup_creates_and_stores_pickup():
+    clock.set_fixed(datetime(2026, 11, 12, 8, 0, tzinfo=timezone.utc))
+    s = _created_shipment()
+    p = pickups.schedule_pickup(s.id, WINDOW)
+    assert p.id.startswith("pkp_")
+    assert p.shipment_id == s.id
+    assert p.window_start == WINDOW
+    assert p.scheduled_at == clock.now()
+    assert store.db.pickups[p.id] is p
+
+
+def test_schedule_pickup_emits_event():
+    s = _created_shipment()
+    events.OUTBOX.clear()
+    p = pickups.schedule_pickup(s.id, WINDOW)
+    assert len(events.OUTBOX) == 1
+    assert events.OUTBOX[-1]["name"] == "pickup.scheduled"
+    assert events.OUTBOX[-1]["entity_id"] == p.id
+
+
+def test_unknown_shipment_fails_without_changes():
+    events.OUTBOX.clear()
+    with pytest.raises(DomainError) as err:
+        pickups.schedule_pickup("shp_missing", WINDOW)
+    assert err.value.code == "E_NOT_FOUND"
+    assert store.db.pickups == {}
+    assert events.OUTBOX == []
+
+
+@pytest.mark.parametrize("status", ["delivered", "paid", "void"])
+def test_non_created_shipment_fails_without_changes(status):
+    s = _created_shipment()
+    s.status = status
+    events.OUTBOX.clear()
+    with pytest.raises(DomainError) as err:
+        pickups.schedule_pickup(s.id, WINDOW)
+    assert err.value.code == "E_BAD_STATE"
+    assert store.db.pickups == {}
+    assert events.OUTBOX == []
