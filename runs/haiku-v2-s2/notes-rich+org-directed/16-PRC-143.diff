+"""Pickup scheduling for shipments that are ready to go."""
+
+from datetime import datetime
+
+from parcelo import clock, events, ids
+from parcelo.errors import DomainError
+from parcelo.models import Pickup
+from parcelo.store import db
+
+
+def schedule_pickup(shipment_id: str, window_start: datetime) -> Pickup:
+    """Book a pickup for a shipment that is still in status "created".
+
+    Args:
+        shipment_id: Id of the shipment to pick up.
+        window_start: Start of the pickup window.
+
+    Returns:
+        The newly created Pickup.
+
+    Raises:
+        DomainError: E_NOT_FOUND if the shipment does not exist, or
+            E_BAD_STATE if it is not in status "created".
+    """
+    if shipment_id not in db.shipments:
+        raise DomainError("E_NOT_FOUND", shipment_id)
+    shipment = db.shipments[shipment_id]
+    if shipment.status != "created":
+        raise DomainError("E_BAD_STATE", f"{shipment_id} is {shipment.status}")
+    pickup = Pickup(
+        id=ids.new_id("pkp"),
+        shipment_id=shipment_id,
+        window_start=window_start,
+        scheduled_at=clock.now(),
+    )
+    db.pickups[pickup.id] = pickup
+    events.emit("pickup.scheduled", pickup.id, shipment_id=shipment_id)
+    return pickup
