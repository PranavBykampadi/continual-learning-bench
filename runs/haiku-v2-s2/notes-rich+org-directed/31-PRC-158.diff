diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/parcelo/returns.py b/parcelo/returns.py
--- a/parcelo/returns.py	1969-12-31 19:00:00
+++ b/parcelo/returns.py	2026-11-12 03:18:07
@@ -0,0 +1,53 @@
+"""Return requests for delivered shipments."""
+
+from parcelo import clock, events, ids
+from parcelo.errors import DomainError
+from parcelo.models import ReturnRequest
+from parcelo.settings import MAX_RETURNS_PER_SHIPMENT
+from parcelo.store import db
+
+
+def request_return(shipment_id: str, reason: str) -> ReturnRequest:
+    """File a return request for a delivered shipment.
+
+    Args:
+        shipment_id: Id of the shipment the customer is sending back.
+        reason: Why the customer is returning it.
+
+    Returns:
+        The stored ReturnRequest.
+
+    Raises:
+        DomainError: E_NOT_FOUND if the shipment does not exist, E_BAD_STATE if it
+            has not been delivered, E_LIMIT if it already has the maximum number of
+            return requests.
+    """
+    if shipment_id not in db.shipments:
+        raise DomainError("E_NOT_FOUND", shipment_id)
+    shipment = db.shipments[shipment_id]
+    if shipment.status != "delivered":
+        raise DomainError("E_BAD_STATE", shipment_id)
+    if len(returns_for(shipment_id)) >= MAX_RETURNS_PER_SHIPMENT:
+        raise DomainError("E_LIMIT", shipment_id)
+    request = ReturnRequest(
+        id=ids.new_id("ret"),
+        shipment_id=shipment_id,
+        reason=reason,
+        requested_at=clock.now(),
+    )
+    db.returns[request.id] = request
+    events.emit("return.requested", request.id, shipment_id=shipment_id)
+    return request
+
+
+def returns_for(shipment_id: str) -> list[ReturnRequest]:
+    """List the return requests filed for a shipment.
+
+    Args:
+        shipment_id: Id of the shipment.
+
+    Returns:
+        ReturnRequest objects for the shipment, sorted by id ascending. Empty if none.
+    """
+    matches = [r for r in db.returns.values() if r.shipment_id == shipment_id]
+    return sorted(matches, key=lambda r: r.id)
