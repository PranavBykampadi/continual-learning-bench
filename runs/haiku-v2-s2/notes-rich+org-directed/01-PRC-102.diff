+def get_invoice(invoice_id: str) -> Invoice:
+    """Return the invoice with the given id.
+
+    Args:
+        invoice_id: The id of the invoice to look up.
+
+    Returns:
+        The matching Invoice.
+
+    Raises:
+        DomainError: With code E_NOT_FOUND if no such invoice exists.
+    """
+    if invoice_id not in db.invoices:
+        raise DomainError("E_NOT_FOUND", invoice_id)
+    return db.invoices[invoice_id]
+
+
+def void_invoice(invoice_id: str) -> Invoice:
+    """Void an invoice that was issued by mistake.
+
+    Sets the status to "void" and records the time of the void. Paid and
+    already-void invoices cannot be voided.
+
+    Args:
+        invoice_id: The id of the invoice to void.
+
+    Returns:
+        The voided Invoice.
+
+    Raises:
+        DomainError: With code E_NOT_FOUND if the invoice does not exist, or
+            E_BAD_STATE if it is already paid or already void.
+    """
+    invoice = get_invoice(invoice_id)
+    if invoice.status == "paid":
+        raise DomainError("E_BAD_STATE", "invoice already paid: " + invoice_id)
+    if invoice.status == "void":
+        raise DomainError("E_BAD_STATE", "invoice already void: " + invoice_id)
+    invoice.status = "void"
+    invoice.voided_at = clock.now()
+    audit.record("invoice.voided", invoice.id)
     return invoice
 
 
