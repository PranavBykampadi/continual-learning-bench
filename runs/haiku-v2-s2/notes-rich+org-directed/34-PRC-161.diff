+def rebate_for(customer_id: str) -> Money:
+    """Return the volume rebate the customer has earned on their paid invoices.
+
+    The rate depends on how many shipments the customer has: 6% at 50 or more,
+    3% at 10 or more, and nothing below 10. Read-only; emits no events.
+
+    Args:
+        customer_id: ID of an existing customer.
+
+    Returns:
+        Money: the rebate amount, zero if the customer is below the first tier.
+
+    Raises:
+        DomainError: E_UNKNOWN_CUSTOMER if the customer does not exist.
+    """
+    if customer_id not in db.customers:
+        raise DomainError("E_UNKNOWN_CUSTOMER", customer_id)
+
+    shipment_count = 0
+    paid_total = Money.zero()
+    for shipment in db.shipments.values():
+        if shipment.customer_id == customer_id:
+            shipment_count += 1
+    for invoice in db.invoices.values():
+        shipment = db.shipments[invoice.shipment_id]
+        if shipment.customer_id == customer_id and invoice.status == "paid":
+            paid_total = paid_total + Money.parse(invoice.amount)
+
+    if shipment_count >= settings.REBATE_MIN_SHIPMENTS_TIER2:
+        return paid_total.scale(settings.REBATE_RATE_TIER2)
+    if shipment_count >= settings.REBATE_MIN_SHIPMENTS_TIER1:
+        return paid_total.scale(settings.REBATE_RATE_TIER1)
+    return Money.zero()
