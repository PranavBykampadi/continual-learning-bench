+"""Business thresholds and rates. Functions import these instead of using bare numbers."""
+
+# Volume rebate on paid invoices (PRC-161).
+REBATE_MIN_SHIPMENTS_TIER1 = 10
+REBATE_RATE_TIER1 = 0.03
+REBATE_MIN_SHIPMENTS_TIER2 = 50
+REBATE_RATE_TIER2 = 0.06
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/test_rebate.py b/tests/test_rebate.py
--- a/tests/test_rebate.py	1969-12-31 19:00:00
+++ b/tests/test_rebate.py	2026-11-12 03:21:23
@@ -0,0 +1,82 @@
+import pytest
+
+from parcelo import customers, events
+from parcelo.errors import DomainError
+from parcelo.models import Invoice, Shipment
+from parcelo.money import Money
+from parcelo.store import db
+
+
+def _add_shipments(customer_id, count):
+    """Create `count` shipments for the customer and return their ids."""
+    ids = []
+    for i in range(count):
+        shipment_id = f"S-{customer_id}-{i}"
+        db.shipments[shipment_id] = Shipment(
+            id=shipment_id, customer_id=customer_id, weight_kg=1.0, zone="local"
+        )
+        ids.append(shipment_id)
+    return ids
+
+
+def _add_invoice(shipment_id, amount, status):
+    invoice_id = f"INV-{shipment_id}"
+    db.invoices[invoice_id] = Invoice(
+        id=invoice_id, shipment_id=shipment_id, amount=amount, status=status
+    )
+
+
+def test_unknown_customer_raises():
+    with pytest.raises(DomainError) as err:
+        customers.rebate_for("nope")
+    assert err.value.code == "E_UNKNOWN_CUSTOMER"
+
+
+def test_nine_shipments_earn_nothing():
+    c = customers.add_customer("Acme")
+    ships = _add_shipments(c.id, 9)
+    _add_invoice(ships[0], 1000.0, "paid")
+    assert customers.rebate_for(c.id) == Money.zero()
+
+
+def test_ten_shipments_earn_three_percent_of_paid():
+    c = customers.add_customer("Acme")
+    ships = _add_shipments(c.id, 10)
+    _add_invoice(ships[0], 600.0, "paid")
+    _add_invoice(ships[1], 400.0, "paid")
+    assert customers.rebate_for(c.id) == Money(3000)
+
+
+def test_fifty_shipments_earn_six_percent_of_paid():
+    c = customers.add_customer("Acme")
+    ships = _add_shipments(c.id, 50)
+    _add_invoice(ships[0], 600.0, "paid")
+    _add_invoice(ships[1], 400.0, "paid")
+    assert customers.rebate_for(c.id) == Money(6000)
+
+
+def test_unpaid_invoices_are_excluded():
+    c = customers.add_customer("Acme")
+    ships = _add_shipments(c.id, 10)
+    _add_invoice(ships[0], 1000.0, "paid")
+    _add_invoice(ships[1], 5000.0, "open")
+    assert customers.rebate_for(c.id) == Money(3000)
+
+
+def test_other_customers_invoices_are_excluded():
+    c = customers.add_customer("Acme")
+    other = customers.add_customer("Other")
+    _add_shipments(c.id, 10)
+    other_ships = _add_shipments(other.id, 1)
+    _add_invoice(other_ships[0], 1000.0, "paid")
+    assert customers.rebate_for(c.id) == Money.zero()
+
+
+def test_returns_money_and_emits_nothing():
+    c = customers.add_customer("Acme")
+    ships = _add_shipments(c.id, 10)
+    _add_invoice(ships[0], 100.0, "paid")
