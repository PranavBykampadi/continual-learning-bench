+def split_shipment(shipment_id, weights):
+    """Replace a created shipment with one new shipment per weight.
+
+    Args:
+        shipment_id: Id of the shipment to split. Must be in status "created".
+        weights: Weights in kg for the new shipments. Must sum to the original weight.
+
+    Returns:
+        The new shipments, in the same order as ``weights``.
+
+    Raises:
+        DomainError: E_NOT_FOUND if the shipment does not exist, E_BAD_STATE if it is
+            not in status "created", E_BAD_WEIGHT if any weight is not positive,
+            E_BAD_INPUT if ``weights`` is empty or does not sum to the original weight.
+    """
+    if shipment_id not in db.shipments:
+        raise DomainError("E_NOT_FOUND", shipment_id)
+    original = db.shipments[shipment_id]
+    if original.status != "created":
+        raise DomainError("E_BAD_STATE", original.status)
+    if not weights:
+        raise DomainError("E_BAD_INPUT", "no weights given")
+    for weight in weights:
+        if weight <= 0:
+            raise DomainError("E_BAD_WEIGHT", str(weight))
+    if not math.isclose(sum(weights), original.weight_kg):
+        raise DomainError("E_BAD_INPUT", f"weights sum to {sum(weights)}, not {original.weight_kg}")
+
+    now = clock.now()
+    new_shipments = []
+    for weight in weights:
+        shipment = Shipment(
+            id=ids.new_id("shp"),
+            customer_id=original.customer_id,
+            weight_kg=weight,
+            zone=original.zone,
+            created_at=now,
+        )
+        db.shipments[shipment.id] = shipment
+        events.emit("shipment.created", shipment.id, zone=original.zone)
+        new_shipments.append(shipment)
+
+    original.status = "split"
+    events.emit("shipment.split", original.id, weights=list(weights))
+    return new_shipments
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_shipments_split.py b/tests/unit/test_shipments_split.py
--- a/tests/unit/test_shipments_split.py	1969-12-31 19:00:00
+++ b/tests/unit/test_shipments_split.py	2026-11-12 03:09:38
@@ -0,0 +1,89 @@
+import pytest
+
+from parcelo import clock, customers, events, shipments
+from parcelo.errors import DomainError
+from parcelo.store import db
+
+
+def _created(weight=10.0, zone="national"):
+    c = customers.add_customer("Acme")
+    return shipments.create_shipment(c.id, weight, zone)
+
+
+def test_split_returns_new_shipments_in_weight_order():
+    s = _created(10.0, "national")
+    parts = shipments.split_shipment(s.id, [3.0, 7.0])
+    assert [p.weight_kg for p in parts] == [3.0, 7.0]
+    assert all(p.customer_id == s.customer_id for p in parts)
+    assert all(p.zone == "national" for p in parts)
+    assert all(p.status == "created" for p in parts)
+    assert all(p.id.startswith("shp_") for p in parts)
+
+
+def test_original_is_marked_split():
+    s = _created(10.0)
+    shipments.split_shipment(s.id, [4.0, 6.0])
+    assert db.shipments[s.id].status == "split"
+
+
+def test_split_emits_events():
+    s = _created(10.0)
+    parts = shipments.split_shipment(s.id, [4.0, 6.0])
+    names = [e["name"] for e in events.OUTBOX[-3:]]
+    assert names == ["shipment.created", "shipment.created", "shipment.split"]
+    assert events.OUTBOX[-1]["entity_id"] == s.id
+    assert events.OUTBOX[-2]["entity_id"] == parts[1].id
+
+
+def test_split_uses_fixed_clock_for_created_at():
+    clock.set_fixed("2026-11-12T00:00:00+00:00")
+    s = _created(10.0)
+    parts = shipments.split_shipment(s.id, [5.0, 5.0])
+    assert all(p.created_at == "2026-11-12T00:00:00+00:00" for p in parts)
+
+
+def test_missing_shipment_raises_not_found():
+    with pytest.raises(DomainError) as err:
+        shipments.split_shipment("shp_999999", [1.0])
+    assert err.value.code == "E_NOT_FOUND"
+
+
+def test_already_split_shipment_raises_bad_state():
+    s = _created(10.0)
+    shipments.split_shipment(s.id, [5.0, 5.0])
+    with pytest.raises(DomainError) as err:
+        shipments.split_shipment(s.id, [5.0, 5.0])
+    assert err.value.code == "E_BAD_STATE"
+
+
+def test_weights_must_sum_to_original():
+    s = _created(10.0)
+    with pytest.raises(DomainError) as err:
+        shipments.split_shipment(s.id, [3.0, 3.0])
+    assert err.value.code == "E_BAD_INPUT"
+
+
+def test_empty_weights_rejected():
+    s = _created(10.0)
+    with pytest.raises(DomainError) as err:
+        shipments.split_shipment(s.id, [])
+    assert err.value.code == "E_BAD_INPUT"
+
+
+def test_non_positive_weight_rejected():
+    s = _created(10.0)
+    with pytest.raises(DomainError) as err:
+        shipments.split_shipment(s.