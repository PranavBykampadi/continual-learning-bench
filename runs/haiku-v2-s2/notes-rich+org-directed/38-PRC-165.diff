+from parcelo.models import Shipment
 from parcelo.store import db
+
+
+def shipments_without_invoice() -> list[Shipment]:
+    """Return the shipments that no invoice refers to.
+
+    Returns:
+        Shipments with no invoice, in the order they were stored.
+    """
+    invoiced = {invoice.shipment_id for invoice in db.invoices.values()}
+    return [shipment for shipment in db.shipments.values() if shipment.id not in invoiced]
 
 
