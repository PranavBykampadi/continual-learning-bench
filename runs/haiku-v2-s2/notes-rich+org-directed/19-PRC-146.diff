diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_invoices_write_off.py b/tests/unit/test_invoices_write_off.py
--- a/tests/unit/test_invoices_write_off.py	1969-12-31 19:00:00
+++ b/tests/unit/test_invoices_write_off.py	2026-11-12 03:06:51
@@ -0,0 +1,65 @@
+from datetime import datetime, timezone
+
+import pytest
+
+from parcelo import clock, customers, events, invoices, shipments
+from parcelo.errors import DomainError
+from parcelo.money import Money
+
+FIXED_NOW = datetime(2026, 11, 12, 9, 30, tzinfo=timezone.utc)
+
+
+def _open_invoice():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 2, "local")
+    return invoices.issue_invoice(s.id)
+
+
+def test_write_off_open_invoice():
+    clock.set_fixed(FIXED_NOW)
+    inv = _open_invoice()
+    events.OUTBOX.clear()
+
+    amount = invoices.write_off(inv.id)
+
+    assert amount == Money(700)
+    assert inv.status == "written_off"
+    assert inv.written_off_at == FIXED_NOW
+    assert events.OUTBOX[-1]["name"] == "invoice.written_off"
+    assert events.OUTBOX[-1]["entity_id"] == inv.id
+    assert events.OUTBOX[-1]["payload"] == {"amount_cents": 700}
+
+
+def test_write_off_unknown_invoice():
+    events.OUTBOX.clear()
+    with pytest.raises(DomainError) as err:
+        invoices.write_off("INV-nope")
+    assert err.value.code == "E_NOT_FOUND"
+    assert events.OUTBOX == []
+
+
+def test_write_off_paid_invoice_fails():
+    inv = _open_invoice()
+    invoices.mark_paid(inv.id)
+    events.OUTBOX.clear()
+
+    with pytest.raises(DomainError) as err:
+        invoices.write_off(inv.id)
+
+    assert err.value.code == "E_BAD_STATE"
+    assert inv.status == "paid"
+    assert inv.written_off_at is None
+    assert events.OUTBOX == []
+
+
+def test_write_off_twice_fails():
+    inv = _open_invoice()
+    invoices.write_off(inv.id)
+    events.OUTBOX.clear()
+
+    with pytest.raises(DomainError) as err:
+        invoices.write_off(inv.id)
+
+    assert err.value.code == "E_BAD_STATE"
+    assert inv.status == "written_off"
+    assert events.OUTBOX == []
