+def apply_credit(invoice_id: str, amount) -> Money:
+    """Reduce an open invoice by a credit and return the amount still owed.
+
+    Args:
+        invoice_id: Id of the invoice to credit.
+        amount: Credit to apply, as Money or a dollar amount (float, int, str or Decimal).
+
+    Returns:
+        Money: The invoice amount remaining after the credit.
+
+    Raises:
+        DomainError: E_NOT_FOUND if the invoice does not exist, E_BAD_STATE if it is not
+            open, E_BAD_INPUT if the credit is not positive, has another currency, or is
+            larger than the invoice amount.
+    """
+    if invoice_id not in db.invoices:
+        raise DomainError("E_NOT_FOUND", invoice_id)
+    invoice = db.invoices[invoice_id]
+    if invoice.status != "open":
+        raise DomainError("E_BAD_STATE", f"{invoice_id} is {invoice.status}")
+    credit = Money.parse(amount)
+    current = Money.parse(invoice.amount)
+    if credit.cents <= 0:
+        raise DomainError("E_BAD_INPUT", "credit must be positive")
+    if credit.currency != current.currency:
+        raise DomainError("E_BAD_INPUT", "credit currency does not match invoice")
+    if current < credit:
+        raise DomainError("E_BAD_INPUT", "credit is larger than invoice amount")
+    remaining = current - credit
+    # Invoice.amount is still a float (legacy); store the remaining dollars in it so
+    # revenue_total and outstanding_balance keep working.
+    invoice.amount = remaining.cents / 100
+    audit.record(
+        "invoice.credit_applied",
+        invoice.id,
+        credit_cents=credit.cents,
+        remaining_cents=remaining.cents,
+    )
+    return remaining
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_invoices_credit.py b/tests/unit/test_invoices_credit.py
--- a/tests/unit/test_invoices_credit.py	1969-12-31 19:00:00
+++ b/tests/unit/test_invoices_credit.py	2026-11-12 03:00:15
@@ -0,0 +1,94 @@
+import pytest
+
+from parcelo import audit, customers, invoices, shipments
+from parcelo.errors import DomainError
+from parcelo.money import Money
+from parcelo.reports import revenue_total
+
+
+def _open_invoice(amount_kg=2, zone="local"):
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, amount_kg, zone)
+    return c, invoices.issue_invoice(s.id)
+
+
+def test_credit_reduces_amount_and_returns_money():
+    _, inv = _open_invoice()
+    before = len(audit.LOG)
+
+    remaining = invoices.apply_credit(inv.id, Money(150))
+
+    assert isinstance(remaining, Money)
+    assert remaining == Money(550)
+    assert inv.amount == 5.5
+    assert inv.status == "open"
+    assert audit.LOG[-1]["action"] == "invoice.credit_applied"
+    assert audit.LOG[-1]["entity_id"] == inv.id
+    assert len(audit.LOG) == before + 1
+
+
+def test_float_and_string_amounts_are_accepted():
+    _, inv = _open_invoice()
+    assert invoices.apply_credit(inv.id, 1.25) == Money(575)
+    assert invoices.apply_credit(inv.id, "0.75") == Money(500)
+    assert inv.amount == 5.0
+
+
+def test_credit_equal_to_amount_leaves_zero():
+    _, inv = _open_invoice()
+    remaining = invoices.apply_credit(inv.id, Money(700))
+    assert remaining == Money.zero()
+    assert inv.amount == 0.0
+
+
+def test_reports_and_balance_see_reduced_amount():
+    c, inv = _open_invoice()
+    invoices.apply_credit(inv.id, Money(200))
+    assert customers.outstanding_balance(c.id) == 5.0
+    invoices.mark_paid(inv.id)
+    assert revenue_total() == 5.0
+
+
+def test_missing_invoice_fails():
+    with pytest.raises(DomainError) as err:
+        invoices.apply_credit("INV-missing", Money(100))
+    assert err.value.code == "E_NOT_FOUND"
+    assert audit.LOG == []
+
+
+def test_paid_invoice_fails_without_change():
+    _, inv = _open_invoice()
+    invoices.mark_paid(inv.id)
+    before = len(audit.LOG)
+    with pytest.raises(DomainError) as err:
+        invoices.apply_credit(inv.id, Money(100))
+    assert err.value.code == "E_BAD_STATE"
+    assert inv.amount == 7.0
+    assert len(audit.LOG) == before
+
+
+def test_credit_larger_than_amount_fails_without_change():
+    _, inv = _open_invoice()
+    before = len(audit.LOG)
+    with pytest.raises(DomainError) as err:
+        invoices.apply_credit(inv.id, Money(701))
+    assert err.value.code == "E_BAD_INPUT"
+    assert inv.amount == 7.0
+    assert len(audit.LOG) == before
+
+
+@pytest.mark.parametrize("bad", [Money(0), Money(-50)])
+def test_non_positive_credit_fails(bad):
+    _, inv = _open_invoice()
+    with pytest.raises(DomainError) as err:
+        invoices.apply_credit(inv.id, bad)
+    assert err.value.code == "E_BAD_INPUT"
+    assert inv.amount == 7.0
+
+
+def test_other_currency_credit_fails():
+    _, inv = _open_invoice()
+    with pytest.raises(DomainError) as err:
+        invoices.apply_credit(inv.id, Money(100, "EUR"))
+    assert err.value.code == "E_BAD_INPUT"
+    assert inv.amount == 7.0
