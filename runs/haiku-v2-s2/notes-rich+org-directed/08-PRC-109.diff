+++ b/tests/unit/test_customers_addresses.py	2026-11-12 02:56:43
@@ -0,0 +1,42 @@
+import pytest
+
+from parcelo import customers
+from parcelo.errors import DomainError
+from parcelo.models import Address
+from parcelo.store import db
+
+
+def test_add_address_stores_and_returns_address():
+    c = customers.add_customer("Acme")
+    a = customers.add_address(c.id, "1 Main St", "Springfield")
+    assert isinstance(a, Address)
+    assert a.id.startswith("addr_")
+    assert a.customer_id == c.id
+    assert a.line == "1 Main St"
+    assert a.city == "Springfield"
+    assert db.addresses[a.id] is a
+
+
+def test_add_address_unknown_customer():
+    with pytest.raises(DomainError) as err:
+        customers.add_address("nope", "1 Main St", "Springfield")
+    assert err.value.code == "E_NOT_FOUND"
+    assert db.addresses == {}
+
+
+@pytest.mark.parametrize("line", ["", "   "])
+def test_add_address_empty_line(line):
+    c = customers.add_customer("Acme")
+    with pytest.raises(DomainError) as err:
+        customers.add_address(c.id, line, "Springfield")
+    assert err.value.code == "E_BAD_INPUT"
+    assert db.addresses == {}
+
+
+@pytest.mark.parametrize("city", ["", "   "])
+def test_add_address_empty_city(city):
+    c = customers.add_customer("Acme")
+    with pytest.raises(DomainError) as err:
+        customers.add_address(c.id, "1 Main St", city)
+    assert err.value.code == "E_BAD_INPUT"
+    assert db.addresses == {}
