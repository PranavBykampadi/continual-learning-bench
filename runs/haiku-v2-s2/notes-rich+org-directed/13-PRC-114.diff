--- a/tests/unit/test_reports_aging.py	1969-12-31 19:00:00
+++ b/tests/unit/test_reports_aging.py	2026-11-12 03:01:08
@@ -0,0 +1,78 @@
+from datetime import datetime, timedelta, timezone
+
+from parcelo import audit, clock, reports, store
+from parcelo.models import Invoice
+from parcelo.money import Money
+
+NOW = datetime(2026, 11, 12, 12, 0, tzinfo=timezone.utc)
+
+
+def _invoice(invoice_id, amount, days_old, status="open"):
+    issued = NOW - timedelta(days=days_old)
+    store.db.invoices[invoice_id] = Invoice(
+        id=invoice_id,
+        shipment_id="shp_x",
+        amount=amount,
+        status=status,
+        issued_at=issued.replace(tzinfo=None),  # naive UTC, as issue_invoice stores it
+    )
+
+
+def setup_function():
+    clock.set_fixed(NOW)
+
+
+def test_empty_report_is_all_zero():
+    report = reports.aging_report()
+    assert report == {"0-30": Money.zero(), "31-60": Money.zero(), "60+": Money.zero()}
+
+
+def test_buckets_and_edges():
+    _invoice("a", 1.0, 0)
+    _invoice("b", 2.0, 30)
+    _invoice("c", 4.0, 31)
+    _invoice("d", 8.0, 60)
+    _invoice("e", 16.0, 61)
+    report = reports.aging_report()
+    assert report["0-30"].cents == 300
+    assert report["31-60"].cents == 1200
+    assert report["60+"].cents == 1600
+
+
+def test_partial_day_counts_as_whole_days():
+    # 30 days and 23 hours old is still 30 whole days, so it's in 0-30.
+    store.db.invoices["x"] = Invoice(
+        id="x",
+        shipment_id="shp_x",
+        amount=5.0,
+        status="open",
+        issued_at=(NOW - timedelta(days=30, hours=23)).replace(tzinfo=None),
+    )
+    assert reports.aging_report()["0-30"].cents == 500
+
+
+def test_paid_and_void_invoices_are_left_out():
+    _invoice("paid", 10.0, 5, status="paid")
+    _invoice("void", 20.0, 90, status="void")
+    _invoice("open", 3.0, 90)
+    report = reports.aging_report()
+    assert report["0-30"] == Money.zero()
+    assert report["60+"].cents == 300
+
+
+def test_aware_issued_at_is_accepted():
+    store.db.invoices["z"] = Invoice(
+        id="z",
+        shipment_id="shp_x",
+        amount=7.0,
+        status="open",
+        issued_at=NOW - timedelta(days=40),
+    )
+    assert reports.aging_report()["31-60"].cents == 700
+
+
+def test_read_only_does_not_audit():
+    _invoice("a", 1.0, 10)
+    before = len(audit.LOG)
+    reports.aging_report()
+    assert len(audit.LOG) == before
