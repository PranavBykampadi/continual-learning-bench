+from datetime import datetime, timezone
 
+from parcelo import clock
+from parcelo.legacy.billing import days_between
+from parcelo.money import Money
 from parcelo.store import db
+
+
+def _as_utc(moment):
+    """Return an aware UTC datetime, reading naive values as UTC."""
+    if moment.tzinfo is None:
+        return moment.replace(tzinfo=timezone.utc)
+    return moment.astimezone(timezone.utc)
+
+
+def aging_report() -> dict[str, Money]:
+    """Total the open invoices by age in whole days since they were issued.
+
+    Paid and void invoices are left out.
+
+    Returns:
+        A dict with the keys "0-30", "31-60" and "60+", each mapped to the
+        Money total of the open invoices in that bucket. Empty buckets are zero.
+    """
+    now = clock.now()
+    buckets = {"0-30": Money.zero(), "31-60": Money.zero(), "60+": Money.zero()}
+    for invoice in db.invoices.values():
+        if invoice.status != "open":
+            continue
+        age = days_between(_as_utc(invoice.issued_at), now)
+        if age <= 30:
+            key = "0-30"
+        elif age <= 60:
+            key = "31-60"
+        else:
+            key = "60+"
+        buckets[key] = buckets[key] + Money.parse(invoice.amount)
+    return buckets
 
 
