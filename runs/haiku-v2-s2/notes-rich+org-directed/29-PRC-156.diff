+def heavy_quote(weight_kg, zone):
+    """Quote a parcel, adding a surcharge for each kg above the heavy threshold.
+
+    Args:
+        weight_kg: parcel weight in kg, must be positive.
+        zone: a key of ZONE_BASE.
+
+    Returns:
+        Money: the normal quote plus HEAVY_SURCHARGE_PER_KG for every kg above
+        HEAVY_THRESHOLD_KG. Parcels at or under the threshold get the normal quote.
+
+    Raises:
+        DomainError: E_BAD_ZONE for an unknown zone, E_BAD_WEIGHT for a weight that is not positive.
+    """
+    if zone not in ZONE_BASE:
+        raise DomainError("E_BAD_ZONE", zone)
+    if weight_kg <= 0:
+        raise DomainError("E_BAD_WEIGHT", str(weight_kg))
+    total = Money.parse(quote(weight_kg, zone))
+    if weight_kg <= HEAVY_THRESHOLD_KG:
+        return total
+    excess_kg = weight_kg - HEAVY_THRESHOLD_KG
+    return total + Money.parse(HEAVY_SURCHARGE_PER_KG).scale(excess_kg)
