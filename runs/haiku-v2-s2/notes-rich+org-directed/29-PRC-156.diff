@@ -0,0 +1,8 @@
+"""Business thresholds and rates that finance or product may ask us to change.
+
+Functions import these constants; do not put bare numbers for these in function bodies.
+"""
+
+# Parcels heavier than this pay HEAVY_SURCHARGE_PER_KG for each kg above it.
+HEAVY_THRESHOLD_KG = 30
+HEAVY_SURCHARGE_PER_KG = 0.75
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_rates_heavy.py b/tests/unit/test_rates_heavy.py
--- a/tests/unit/test_rates_heavy.py	1969-12-31 19:00:00
+++ b/tests/unit/test_rates_heavy.py	2026-11-12 03:15:57
@@ -0,0 +1,59 @@
+import pytest
+
+from parcelo import events, rates
+from parcelo.errors import DomainError
+from parcelo.money import Money
+
+
+def test_at_threshold_gets_normal_quote():
+    events.OUTBOX.clear()
+    assert rates.heavy_quote(30, "local") == Money.parse(rates.quote(30, "local"))
+
+
+def test_light_parcel_gets_normal_quote():
+    events.OUTBOX.clear()
+    assert rates.heavy_quote(10, "local") == Money(1700)
+
+
+def test_one_kg_over_threshold():
+    events.OUTBOX.clear()
+    # local: 4.50 + 1.25 * 31 = 43.25, plus 0.75 surcharge
+    assert rates.heavy_quote(31, "local") == Money(4400)
+
+
+def test_ten_kg_over_threshold_national():
+    events.OUTBOX.clear()
+    # national: 9.00 + 1.25 * 40 = 59.00, plus 10 * 0.75 = 7.50
+    assert rates.heavy_quote(40, "national") == Money(6650)
+
+
+def test_fractional_excess_rounds_surcharge_to_cents():
+    events.OUTBOX.clear()
+    # 0.5 kg over threshold -> 0.375 surcharge, rounded half up to 0.38
+    expected = Money.parse(rates.quote(30.5, "local")) + Money(38)
+    assert rates.heavy_quote(30.5, "local") == expected
+
+
+def test_returns_money():
+    assert isinstance(rates.heavy_quote(35, "international"), Money)
+
+
+@pytest.mark.parametrize("zone", ["moon", "", "LOCAL"])
+def test_unknown_zone_raises(zone):
+    with pytest.raises(DomainError) as err:
+        rates.heavy_quote(35, zone)
+    assert err.value.code == "E_BAD_ZONE"
+
+
+@pytest.mark.parametrize("weight", [0, -1, -0.5])
+def test_non_positive_weight_raises(weight):
+    with pytest.raises(DomainError) as err:
+        rates.heavy_quote(weight, "local")
+    assert err.value.code == "E_BAD_WEIGHT"
+
+
+def test_read_only_emits_nothing():
+    events.OUTBOX.clear()
+    rates.heavy_quote(45, "national")
+    rates.heavy_quote(5, "local")
+    assert len(events.OUTBOX) == 0
