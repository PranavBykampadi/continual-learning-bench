@@ -0,0 +1,97 @@
+import pytest
+
+from parcelo import audit, claims, customers, shipments, store
+from parcelo.errors import DomainError
+from parcelo.money import Money
+from parcelo.store import db
+
+
+def _shipment(status="delivered"):
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 1.5, "national")
+    s.status = status
+    return s
+
+
+def test_file_claim_on_delivered_shipment():
+    s = _shipment()
+    claim = claims.file_claim(s.id, Money(950), "box arrived crushed")
+    assert claim.id.startswith("clm_")
+    assert claim.shipment_id == s.id
+    assert claim.reason == "box arrived crushed"
+    assert claim.filed_at is not None
+    assert db.claims[claim.id] is claim
+
+
+def test_claim_amount_is_money():
+    s = _shipment()
+    claim = claims.file_claim(s.id, Money(950), "damaged")
+    assert isinstance(claim.amount, Money)
+    assert claim.amount == Money(950)
+
+
+def test_legacy_float_amount_is_wrapped_as_money():
+    s = _shipment()
+    claim = claims.file_claim(s.id, 9.5, "damaged")
+    assert isinstance(claim.amount, Money)
+    assert claim.amount == Money(950)
+
+
+def test_file_claim_records_audit():
+    s = _shipment()
+    before = len(audit.LOG)
+    claim = claims.file_claim(s.id, Money(950), "damaged")
+    assert len(audit.LOG) == before + 1
+    assert audit.LOG[-1]["action"] == "claim.filed"
+    assert audit.LOG[-1]["entity_id"] == claim.id
+
+
+def test_undelivered_shipment_is_rejected():
+    s = _shipment(status="created")
+    before = len(audit.LOG)
+    with pytest.raises(DomainError) as err:
+        claims.file_claim(s.id, Money(950), "damaged")
+    assert err.value.code == "E_BAD_STATE"
+    assert db.claims == {}
+    assert len(audit.LOG) == before
+
+
+def test_cancelled_shipment_is_rejected():
+    s = _shipment(status="cancelled")
+    with pytest.raises(DomainError) as err:
+        claims.file_claim(s.id, Money(950), "damaged")
+    assert err.value.code == "E_BAD_STATE"
+
+
+def test_unknown_shipment_is_rejected():
+    with pytest.raises(DomainError) as err:
+        claims.file_claim("shp_missing", Money(950), "damaged")
+    assert err.value.code == "E_NOT_FOUND"
+    assert db.claims == {}
+
+
