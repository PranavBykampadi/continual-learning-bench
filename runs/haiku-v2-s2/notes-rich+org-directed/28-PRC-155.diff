+def customers_by_tier(tier: str) -> list[Customer]:
+    """List customers on a tier, sorted by id.
+
+    Read-only: emits no events.
+
+    Args:
+        tier: One of the known tiers in TIERS.
+
+    Returns:
+        Matching customers ordered by id ascending. Empty if none match.
+
+    Raises:
+        DomainError: E_BAD_INPUT if tier is not a known tier.
+    """
+    if tier not in TIERS:
+        raise DomainError("E_BAD_INPUT", tier)
+    matches = [c for c in db.customers.values() if c.tier == tier]
+    return sorted(matches, key=lambda c: c.id)
 
 
