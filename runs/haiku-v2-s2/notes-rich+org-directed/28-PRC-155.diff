diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_customers_by_tier.py b/tests/unit/test_customers_by_tier.py
--- a/tests/unit/test_customers_by_tier.py	1969-12-31 19:00:00
+++ b/tests/unit/test_customers_by_tier.py	2026-11-12 03:14:55
@@ -0,0 +1,48 @@
+import pytest
+
+from parcelo import customers, events
+from parcelo.errors import DomainError
+from parcelo.models import Customer
+from parcelo.store import db
+
+
+def _put(customer_id, name, tier):
+    db.customers[customer_id] = Customer(id=customer_id, name=name, tier=tier)
+
+
+def test_returns_matching_customers():
+    _put("C1", "Acme", "gold")
+    _put("C2", "Beta", "standard")
+    result = customers.customers_by_tier("gold")
+    assert [c.id for c in result] == ["C1"]
+
+
+def test_empty_when_none_match():
+    _put("C1", "Acme", "standard")
+    assert customers.customers_by_tier("gold") == []
+
+
+def test_results_sorted_by_id():
+    # Insert out of id order so storage order cannot pass for sorted order.
+    _put("C3", "Gamma", "gold")
+    _put("C1", "Alpha", "gold")
+    _put("C2", "Beta", "gold")
+    result = customers.customers_by_tier("gold")
+    assert [c.id for c in result] == ["C1", "C2", "C3"]
+
+
+def test_read_only_emits_nothing():
+    _put("C1", "Acme", "gold")
+    events.OUTBOX.clear()
+    customers.customers_by_tier("gold")
+    customers.customers_by_tier("standard")
+    assert events.OUTBOX == []
+
+
+def test_unknown_tier_raises_and_emits_nothing():
+    _put("C1", "Acme", "gold")
+    events.OUTBOX.clear()
+    with pytest.raises(DomainError) as err:
+        customers.customers_by_tier("platinum")
+    assert err.value.code == "E_BAD_INPUT"
+    assert events.OUTBOX == []
