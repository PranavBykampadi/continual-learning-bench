+def set_credit_limit(customer_id, amount):
+    """Set a customer's credit limit.
+
+    Args:
+        customer_id: Id of the customer to update.
+        amount: New credit limit. Must be zero or positive.
+
+    Returns:
+        The customer's new credit limit.
+
+    Raises:
+        DomainError: E_NOT_FOUND if the customer does not exist, or
+            E_BAD_INPUT if amount is negative.
+    """
+    if customer_id not in db.customers:
+        raise DomainError("E_NOT_FOUND", customer_id)
+    if amount < 0:
+        raise DomainError("E_BAD_INPUT", f"credit limit must not be negative: {amount}")
+    customer = db.customers[customer_id]
+    old_limit = customer.credit_limit
+    customer.credit_limit = amount
+    audit.record(
+        "customer.credit_limit_changed",
+        customer_id,
+        old_limit=old_limit,
+        new_limit=amount,
+    )
+    events.emit(
+        "customer.credit_limit_changed",
+        customer_id,
+        old_limit=old_limit,
+        new_limit=amount,
+    )
+    return customer.credit_limit
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_customers_credit_limit.py b/tests/unit/test_customers_credit_limit.py
--- a/tests/unit/test_customers_credit_limit.py	1969-12-31 19:00:00
+++ b/tests/unit/test_customers_credit_limit.py	2026-11-12 03:10:47
@@ -0,0 +1,71 @@
+import datetime
+
+import pytest
+
+from parcelo import audit, clock, customers, events
+from parcelo.errors import DomainError
+from parcelo.store import db
+
+
+def test_set_credit_limit_updates_and_returns_new_limit():
+    c = customers.add_customer("Acme")
+    assert c.credit_limit == 500.0
+
+    result = customers.set_credit_limit(c.id, 1200.0)
+
+    assert result == 1200.0
+    assert db.customers[c.id].credit_limit == 1200.0
+
+
+def test_set_credit_limit_to_zero_is_allowed():
+    c = customers.add_customer("Acme")
+    assert customers.set_credit_limit(c.id, 0) == 0
+
+
+def test_set_credit_limit_unknown_customer_fails():
+    with pytest.raises(DomainError) as err:
+        customers.set_credit_limit("C_missing", 100.0)
+    assert err.value.code == "E_NOT_FOUND"
+    assert audit.LOG == []
+    assert events.OUTBOX == []
+
+
+def test_set_credit_limit_negative_fails_and_leaves_limit_unchanged():
+    c = customers.add_customer("Acme")
+    audit_before = len(audit.LOG)
+    events_before = len(events.OUTBOX)
+
+    with pytest.raises(DomainError) as err:
+        customers.set_credit_limit(c.id, -1.0)
+
+    assert err.value.code == "E_BAD_INPUT"
+    assert db.customers[c.id].credit_limit == 500.0
+    assert len(audit.LOG) == audit_before
+    assert len(events.OUTBOX) == events_before
+
+
+def test_set_credit_limit_records_audit_entry():
+    c = customers.add_customer("Acme")
+    before = len(audit.LOG)
+    fixed = datetime.datetime(2026, 11, 12, 9, 0, tzinfo=datetime.timezone.utc)
+    clock.set_fixed(fixed)
+
+    customers.set_credit_limit(c.id, 900.0)
+
+    assert len(audit.LOG) == before + 1
+    entry = audit.LOG[-1]
+    assert entry["action"] == "customer.credit_limit_changed"
+    assert entry["entity_id"] == c.id
+    assert entry["at"] == fixed
+    assert entry["details"] == {"old_limit": 500.0, "new_limit": 900.0}
+
+
+def test_set_credit_limit_emits_event():
+    c = customers.add_customer("Acme")
+
+    customers.set_credit_limit(c.id, 900.0)
+
+    event = events.OUTBOX[-1]
+    assert event["name"] == "customer.credit_limit_changed"
+    assert event["entity_id"] == c.id
+    assert event["payload"] == {"old_limit": 500.0, "new_limit": 900.0}
