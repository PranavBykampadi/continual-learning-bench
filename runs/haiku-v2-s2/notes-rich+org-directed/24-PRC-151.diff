+
+
+def list_shipments(customer_id):
+    if customer_id not in db.customers:
+        raise DomainError("E_UNKNOWN_CUSTOMER", customer_id)
+    return [s for s in db.shipments.values() if s.customer_id == customer_id]
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_shipments_list.py b/tests/unit/test_shipments_list.py
--- a/tests/unit/test_shipments_list.py	1969-12-31 19:00:00
+++ b/tests/unit/test_shipments_list.py	2026-11-12 03:11:24
@@ -0,0 +1,38 @@
+import pytest
+
+from parcelo import customers, events, shipments
+from parcelo.errors import DomainError
+
+
+def test_list_returns_only_that_customers_shipments():
+    a = customers.add_customer("Acme")
+    b = customers.add_customer("Globex")
+    s1 = shipments.create_shipment(a.id, 1.5, "national")
+    s2 = shipments.create_shipment(a.id, 2.0, "local")
+    shipments.create_shipment(b.id, 3.0, "local")
+
+    result = shipments.list_shipments(a.id)
+
+    assert result == [s1, s2]
+
+
+def test_list_empty_when_customer_has_no_shipments():
+    c = customers.add_customer("Acme")
+
+    assert shipments.list_shipments(c.id) == []
+
+
+def test_list_unknown_customer_fails():
+    with pytest.raises(DomainError) as err:
+        shipments.list_shipments("nope")
+    assert err.value.code == "E_UNKNOWN_CUSTOMER"
+
+
+def test_list_does_not_emit_events():
+    c = customers.add_customer("Acme")
+    shipments.create_shipment(c.id, 1.5, "national")
+    before = len(events.OUTBOX)
+
+    shipments.list_shipments(c.id)
+
+    assert len(events.OUTBOX) == before
