+++ b/tests/unit/test_reports_volume.py	2026-11-12 03:07:44
@@ -0,0 +1,44 @@
+import pytest
+
+from parcelo import audit, customers, events, reports, shipments
+
+
+def _book(customer_id, n):
+    for _ in range(n):
+        shipments.create_shipment(customer_id, 1.0, "local")
+
+
+def test_includes_customers_with_no_shipments():
+    idle = customers.add_customer("Idle Co")
+    report = reports.volume_report()
+    assert report == {idle.id: {"shipments": 0, "tier": "starter"}}
+
+
+def test_counts_shipments_per_customer():
+    a = customers.add_customer("Acme")
+    b = customers.add_customer("Beta")
+    _book(a.id, 3)
+    _book(b.id, 1)
+    report = reports.volume_report()
+    assert report[a.id] == {"shipments": 3, "tier": "starter"}
+    assert report[b.id] == {"shipments": 1, "tier": "starter"}
+
+
+@pytest.mark.parametrize(
+    "count,tier",
+    [(9, "starter"), (10, "regular"), (49, "regular"), (50, "bulk")],
+)
+def test_tier_thresholds(count, tier):
+    c = customers.add_customer("Acme")
+    _book(c.id, count)
+    assert reports.volume_report()[c.id] == {"shipments": count, "tier": tier}
+
+
+def test_read_only_records_no_audit_or_events():
+    c = customers.add_customer("Acme")
+    _book(c.id, 2)
+    audit_before = len(audit.LOG)
+    events.OUTBOX.clear()
+    reports.volume_report()
+    assert len(audit.LOG) == audit_before
+    assert events.OUTBOX == []
