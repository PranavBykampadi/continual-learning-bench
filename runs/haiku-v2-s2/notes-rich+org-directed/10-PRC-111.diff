@@ -28,3 +28,25 @@
     if shipment_id not in db.shipments:
         raise DomainError("E_NOT_FOUND", shipment_id)
     return db.shipments[shipment_id]
+
+
+def add_note(shipment_id, text):
+    """Append a timestamped note to a shipment.
+
+    Args:
+        shipment_id: Id of the shipment to annotate.
+        text: Note body. Must not be empty or whitespace only.
+
+    Returns:
+        The updated Shipment.
+
+    Raises:
+        DomainError: E_NOT_FOUND if the shipment does not exist, or
+            E_BAD_INPUT if the text is empty.
+    """
+    shipment = get_shipment(shipment_id)
+    if not isinstance(text, str) or not text.strip():
+        raise DomainError("E_BAD_INPUT", "note text must not be empty")
+    shipment.notes.append({"text": text, "at": clock.now()})
+    audit.record("shipment.note_added", shipment.id)
+    return shipment
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_shipments_notes.py b/tests/unit/test_shipments_notes.py
--- a/tests/unit/test_shipments_notes.py	1969-12-31 19:00:00
+++ b/tests/unit/test_shipments_notes.py	2026-11-12 02:58:02
@@ -0,0 +1,72 @@
+from datetime import datetime, timezone
+
+import pytest
+
+from parcelo import audit, clock, customers, shipments
+from parcelo.errors import DomainError
+
+MOMENT = datetime(2026, 11, 12, 9, 30, tzinfo=timezone.utc)
+
+
+def _shipment():
+    c = customers.add_customer("Acme")
+    return shipments.create_shipment(c.id, 1.5, "national")
+
+
+def test_add_note_appends_text_and_time():
+    clock.set_fixed(MOMENT)
+    s = _shipment()
+
+    result = shipments.add_note(s.id, "left at front desk")
+
+    assert result is s
+    assert s.notes == [{"text": "left at front desk", "at": MOMENT}]
+    assert isinstance(s.notes[0]["at"], datetime)
+    assert s.notes[0]["at"].tzinfo is not None
+
+
+def test_add_note_keeps_earlier_notes_in_order():
+    s = _shipment()
+    clock.set_fixed(MOMENT)
+    shipments.add_note(s.id, "first")
+    later = datetime(2026, 11, 12, 10, 0, tzinfo=timezone.utc)
+    clock.set_fixed(later)
+    shipments.add_note(s.id, "second")
+
+    assert [n["text"] for n in s.notes] == ["first", "second"]
+    assert s.notes[1]["at"] == later
+
+
+def test_add_note_records_audit_with_shipment_id():
+    s = _shipment()
+    before = len(audit.LOG)
+
+    shipments.add_note(s.id, "call customer")
+
+    assert len(audit.LOG) == before + 1
+    entry = audit.LOG[-1]
+    assert entry["action"] == "shipment.note_added"
+    assert entry["entity_id"] == s.id
+
+
+def test_add_note_unknown_shipment_fails():
+    before = len(audit.LOG)
+
+    with pytest.raises(DomainError) as err:
+        shipments.add_note("shp_missing", "hello")
+
+    assert err.value.code == "E_NOT_FOUND"
+    assert len(audit.LOG) == before
+
+
+@pytest.mark.parametrize("text", ["", "   "])
+def test_add_note_empty_text_fails(text):
+    s = _shipment()
+    before = len(audit.LOG)
+
+    with pytest.raises(DomainError) as err:
+        shipments.add_note(s.id, text)
+
+    assert err.value.code == "E_BAD_INPUT"
+    assert s.notes == []
+    assert len(audit.LOG) == before
