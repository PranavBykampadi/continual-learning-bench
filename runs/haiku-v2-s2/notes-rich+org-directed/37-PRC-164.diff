diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/parcelo/vouchers.py b/parcelo/vouchers.py
--- a/parcelo/vouchers.py	1969-12-31 19:00:00
+++ b/parcelo/vouchers.py	2026-11-12 03:23:26
@@ -0,0 +1,28 @@
+from parcelo import clock, events, ids
+from parcelo.errors import DomainError
+from parcelo.models import Voucher
+from parcelo.money import Money
+from parcelo.store import db
+
+MAX_VOUCHER = Money(15000)  # 150.00
+
+
+def issue_voucher(customer_id, amount):
+    """Issue a goodwill voucher. Creating a voucher is not idempotent: each
+    call issues a new voucher, so a retried call can issue a duplicate."""
+    if customer_id not in db.customers:
+        raise DomainError("E_UNKNOWN_CUSTOMER", customer_id)
+    value = Money.parse(amount)
+    if value.cents <= 0:
+        raise DomainError("E_BAD_INPUT", str(amount))
+    if MAX_VOUCHER < value:
+        raise DomainError("E_LIMIT", str(value))
+    voucher = Voucher(
+        id=ids.new_id("vch"),
+        customer_id=customer_id,
+        amount=value,
+        issued_at=clock.now(),
+    )
+    db.vouchers[voucher.id] = voucher
+    events.emit("voucher.issued", voucher.id, customer_id=customer_id, cents=value.cents)
+    return voucher
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_vouchers.py b/tests/unit/test_vouchers.py
--- a/tests/unit/test_vouchers.py	1969-12-31 19:00:00
+++ b/tests/unit/test_vouchers.py	2026-11-12 03:23:34
@@ -0,0 +1,57 @@
+import pytest
+
+from parcelo import customers, events, vouchers
+from parcelo.errors import DomainError
+from parcelo.money import Money
+from parcelo.store import db
+
+
+def test_issue_voucher_saves_and_emits():
+    c = customers.add_customer("Acme")
+    v = vouchers.issue_voucher(c.id, Money(2500))
+    assert v.id.startswith("vch_")
+    assert v.customer_id == c.id
+    assert v.amount == Money(2500)
+    assert v.issued_at is not None
+    assert db.vouchers[v.id] is v
+    assert events.OUTBOX[-1]["name"] == "voucher.issued"
+    assert events.OUTBOX[-1]["entity_id"] == v.id
+
+
+def test_float_amount_is_wrapped_as_money():
+    c = customers.add_customer("Acme")
+    v = vouchers.issue_voucher(c.id, 30.5)
+    assert v.amount == Money(3050)
+
+
+def test_exact_cap_is_allowed():
+    c = customers.add_customer("Acme")
+    v = vouchers.issue_voucher(c.id, Money(15000))
+    assert v.amount == Money(15000)
+
+
+def test_unknown_customer():
+    with pytest.raises(DomainError) as err:
+        vouchers.issue_voucher("nope", Money(1000))
+    assert err.value.code == "E_UNKNOWN_CUSTOMER"
+    assert db.vouchers == {}
+    assert events.OUTBOX == []
+
+
+def test_over_cap_is_rejected():
+    c = customers.add_customer("Acme")
+    with pytest.raises(DomainError) as err:
+        vouchers.issue_voucher(c.id, Money(15001))
+    assert err.value.code == "E_LIMIT"
+    assert db.vouchers == {}
+    assert events.OUTBOX == []
+
+
+@pytest.mark.parametrize("amount", [0, 0.0, -1, -10.5])
+def test_zero_or_negative_is_rejected(amount):
+    c = customers.add_customer("Acme")
+    with pytest.raises(DomainError) as err:
+        vouchers.issue_voucher(c.id, amount)
+    assert err.value.code == "E_BAD_INPUT"
+    assert db.vouchers == {}
+    assert events.OUTBOX == []
