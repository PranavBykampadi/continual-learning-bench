diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/parcelo/shipments.py b/parcelo/shipments.py
--- a/parcelo/shipments.py	2026-11-10 12:20:18
+++ b/parcelo/shipments.py	2026-11-12 03:19:57
@@ -28,3 +28,29 @@
     if shipment_id not in db.shipments:
         raise DomainError("E_NOT_FOUND", shipment_id)
     return db.shipments[shipment_id]
+
+
+def mark_returned(shipment_id: str) -> Shipment:
+    """Record that a shipment came back to the depot.
+
+    Calling this on a shipment that is already returned changes nothing and emits no event.
+
+    Args:
+        shipment_id: Id of the shipment to mark.
+
+    Returns:
+        The shipment, with status "returned" and returned_at set.
+
+    Raises:
+        DomainError: E_NOT_FOUND if the shipment does not exist, or E_BAD_STATE if it
+            is still in status "created".
+    """
+    shipment = get_shipment(shipment_id)
+    if shipment.status == "returned":
+        return shipment
+    if shipment.status == "created":
+        raise DomainError("E_BAD_STATE", shipment_id)
+    shipment.status = "returned"
+    shipment.returned_at = clock.now()
+    events.emit("shipment.returned", shipment.id)
+    return shipment
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_shipments.py b/tests/unit/test_shipments.py
--- a/tests/unit/test_shipments.py	2026-11-10 12:20:18
+++ b/tests/unit/test_shipments.py	2026-11-12 03:20:10
@@ -1,6 +1,8 @@
+from datetime import datetime, timezone
+
 import pytest
 
-from parcelo import customers, events, shipments
+from parcelo import clock, customers, events, shipments
 from parcelo.errors import DomainError
 
 
@@ -15,3 +17,59 @@
     with pytest.raises(DomainError) as err:
         shipments.create_shipment("nope", 1, "local")
     assert err.value.code == "E_UNKNOWN_CUSTOMER"
+
+
+def _delivered_shipment():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 1.5, "national")
+    s.status = "delivered"
+    return s
+
+
+def test_mark_returned_sets_status_and_time():
+    moment = datetime(2026, 11, 12, 9, 0, tzinfo=timezone.utc)
+    clock.set_fixed(moment)
+    s = _delivered_shipment()
+    result = shipments.mark_returned(s.id)
+    assert result is s
+    assert s.status == "returned"
+    assert s.returned_at == moment
+
+
+def test_mark_returned_emits_one_event():
+    s = _delivered_shipment()
+    events.OUTBOX.clear()
+    shipments.mark_returned(s.id)
+    assert [e["name"] for e in events.OUTBOX] == ["shipment.returned"]
+    assert events.OUTBOX[0]["entity_id"] == s.id
+
+
+def test_mark_returned_twice_is_a_no_op():
+    s = _delivered_shipment()
+    clock.set_fixed(datetime(2026, 11, 12, 9, 0, tzinfo=timezone.utc))
+    shipments.mark_returned(s.id)
+    first_time = s.returned_at
+    events.OUTBOX.clear()
+    clock.set_fixed(datetime(2026, 11, 13, 9, 0, tzinfo=timezone.utc))
+    result = shipments.mark_returned(s.id)
+    assert result is s
+    assert s.returned_at == first_time
+    assert events.OUTBOX == []
+
+
+def test_mark_returned_rejects_created_shipment():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 1.5, "national")
+    events.OUTBOX.clear()
+    with pytest.raises(DomainError) as err:
+        shipments.mark_returned(s.id)
+    assert err.value.code == "E_BAD_STATE"
+    assert s.status == "created"
+    assert s.returned_at is None
+    assert events.OUTBOX == []
+
+
+def test_mark_returned_unknown_shipment():
+    with pytest.raises(DomainError) as err:
+        shipments.mark_returned("shp_missing")
+    assert err.value.code == "E_NOT_FOUND"
