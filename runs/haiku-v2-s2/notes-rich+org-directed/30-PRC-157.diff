diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_invoices_hold.py b/tests/unit/test_invoices_hold.py
--- a/tests/unit/test_invoices_hold.py	1969-12-31 19:00:00
+++ b/tests/unit/test_invoices_hold.py	2026-11-12 03:17:04
@@ -0,0 +1,67 @@
+from datetime import datetime, timezone
+
+import pytest
+
+from parcelo import clock, customers, events, invoices, shipments
+from parcelo.errors import DomainError
+
+FIXED = datetime(2026, 11, 12, 9, 30, tzinfo=timezone.utc)
+
+
+def _open_invoice():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 2, "local")
+    return invoices.issue_invoice(s.id)
+
+
+def test_hold_open_invoice_sets_status_and_time():
+    inv = _open_invoice()
+    clock.set_fixed(FIXED)
+    events.OUTBOX.clear()
+
+    result = invoices.hold_invoice(inv.id)
+
+    assert result is inv
+    assert inv.status == "on_hold"
+    assert inv.held_at == FIXED
+    assert [e["name"] for e in events.OUTBOX] == ["invoice.held"]
+    assert events.OUTBOX[0]["entity_id"] == inv.id
+
+
+def test_hold_already_held_is_noop():
+    inv = _open_invoice()
+    invoices.hold_invoice(inv.id)
+    first_held_at = inv.held_at
+    events.OUTBOX.clear()
+
+    clock.set_fixed(FIXED)
+    result = invoices.hold_invoice(inv.id)
+
+    assert result is inv
+    assert inv.status == "on_hold"
+    assert inv.held_at == first_held_at
+    assert events.OUTBOX == []
+
+
+def test_hold_paid_invoice_fails():
+    inv = _open_invoice()
+    invoices.mark_paid(inv.id)
+    events.OUTBOX.clear()
+
+    with pytest.raises(DomainError) as err:
+        invoices.hold_invoice(inv.id)
+
+    assert err.value.code == "E_BAD_STATE"
+    assert inv.status == "paid"
+    assert inv.held_at is None
+    assert events.OUTBOX == []
+
+
+def test_hold_missing_invoice_fails():
+    events.OUTBOX.clear()
+
+    with pytest.raises(DomainError) as err:
+        invoices.hold_invoice("INV-missing")
+
+    assert err.value.code == "E_NOT_FOUND"
+    assert events.OUTBOX == []
