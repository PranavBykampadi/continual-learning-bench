+def hold_invoice(invoice_id):
+    """Put an open invoice on hold to pause collection.
+
+    Calling this on an invoice that is already on hold returns it unchanged
+    and emits no event, so retries are safe.
+
+    Args:
+        invoice_id: ID of the invoice to hold.
+
+    Returns:
+        The updated Invoice.
+
+    Raises:
+        DomainError: E_NOT_FOUND if the invoice does not exist, or
+            E_BAD_STATE if the invoice is neither open nor on hold.
+    """
+    if invoice_id not in db.invoices:
+        raise DomainError("E_NOT_FOUND", invoice_id)
+    invoice = db.invoices[invoice_id]
+    if invoice.status == "on_hold":
+        return invoice
+    if invoice.status != "open":
+        raise DomainError("E_BAD_STATE", invoice.status)
+    invoice.status = "on_hold"
+    invoice.held_at = clock.now()
+    events.emit("invoice.held", invoice.id)
     return invoice
 
 
