+def _as_utc(moment):
+    """Treat a naive datetime as UTC. issue_invoice stores naive utcnow() values."""
+    if moment.tzinfo is None:
+        return moment.replace(tzinfo=timezone.utc)
+    return moment
+
+
+def late_fee_for(invoice_id):
+    """Return the late fee accrued by an invoice as of now.
+
+    The invoice is late from LATE_AFTER_DAYS after it was issued. From then on
+    the fee is 1.5% of the invoice amount for each full day past that point.
+
+    Args:
+        invoice_id: Id of the invoice.
+
+    Returns:
+        Money: The late fee, or zero if the invoice is not late yet.
+
+    Raises:
+        DomainError: E_NOT_FOUND if no invoice has this id.
+    """
+    invoice = db.invoices.get(invoice_id)
+    if invoice is None:
+        raise DomainError("E_NOT_FOUND", f"invoice {invoice_id}")
+    elapsed_days = (clock.now() - _as_utc(invoice.issued_at)).days
+    days_late = elapsed_days - LATE_AFTER_DAYS
+    if days_late <= 0:
+        return Money.zero()
+    return Money.parse(invoice.amount).scale(LATE_FEE_PER_DAY * days_late)
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_invoices_late_fee.py b/tests/unit/test_invoices_late_fee.py
--- a/tests/unit/test_invoices_late_fee.py	1969-12-31 19:00:00
+++ b/tests/unit/test_invoices_late_fee.py	2026-11-12 02:53:48
@@ -0,0 +1,67 @@
+from datetime import datetime, timedelta, timezone
+
+import pytest
+
+from parcelo import clock, invoices
+from parcelo.errors import DomainError
+from parcelo.models import Invoice
+from parcelo.money import Money
+from parcelo.store import db
+
+ISSUED = datetime(2026, 1, 1, 12, 0)  # naive, like issue_invoice's utcnow()
+
+
+def _invoice(amount, issued_at=ISSUED):
+    inv = Invoice(id="INV-test", shipment_id="shp_1", amount=amount, issued_at=issued_at)
+    db.invoices[inv.id] = inv
+    return inv
+
+
+def _pin_days_after_issue(days):
+    clock.set_fixed((ISSUED + timedelta(days=days)).replace(tzinfo=timezone.utc))
+
+
+def test_not_late_on_day_30_is_zero():
+    _invoice(100.0)
+    _pin_days_after_issue(30)
+    fee = invoices.late_fee_for("INV-test")
+    assert isinstance(fee, Money)
+    assert fee == Money.zero()
+
+
+def test_one_day_past_30_is_1_5_percent():
+    _invoice(100.0)
+    _pin_days_after_issue(31)
+    assert invoices.late_fee_for("INV-test") == Money(150)
+
+
+def test_fee_grows_per_full_day_past_30():
+    _invoice(100.0)
+    _pin_days_after_issue(33)
+    fee = invoices.late_fee_for("INV-test")
+    assert isinstance(fee, Money)
+    assert fee == Money(450)
+
+
+def test_float_amount_is_wrapped_as_money():
+    _invoice(7.0)
+    _pin_days_after_issue(32)
+    assert invoices.late_fee_for("INV-test") == Money(21)
+
+
+def test_rounds_once_to_cents():
+    _invoice(0.5)
+    _pin_days_after_issue(31)
+    assert invoices.late_fee_for("INV-test") == Money(1)
+
+
+def test_aware_issued_at_gives_same_fee():
+    _invoice(100.0, issued_at=ISSUED.replace(tzinfo=timezone.utc))
+    _pin_days_after_issue(33)
+    assert invoices.late_fee_for("INV-test") == Money(450)
+
+
+def test_unknown_invoice_raises_not_found():
+    with pytest.raises(DomainError) as err:
+        invoices.late_fee_for("INV-missing")
+    assert err.value.code == "E_NOT_FOUND"
