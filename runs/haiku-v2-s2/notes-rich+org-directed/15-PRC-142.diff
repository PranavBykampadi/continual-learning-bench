diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_invoices_reopen.py b/tests/unit/test_invoices_reopen.py
--- a/tests/unit/test_invoices_reopen.py	1969-12-31 19:00:00
+++ b/tests/unit/test_invoices_reopen.py	2026-11-12 03:02:53
@@ -0,0 +1,53 @@
+from datetime import datetime, timezone
+
+import pytest
+
+from parcelo import clock, customers, events, invoices, shipments
+from parcelo.errors import DomainError
+from parcelo.store import db
+
+
+def _paid_invoice():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 2, "local")
+    inv = invoices.issue_invoice(s.id)
+    return invoices.mark_paid(inv.id)
+
+
+def test_reopen_paid_invoice():
+    clock.set_fixed(datetime(2026, 11, 12, 9, 0, tzinfo=timezone.utc))
+    inv = _paid_invoice()
+    events.OUTBOX.clear()
+
+    result = invoices.reopen_invoice(inv.id)
+
+    assert result is inv
+    assert inv.status == "open"
+    assert inv.paid_at is None
+    assert inv.reopened_at == clock.now()
+    assert events.OUTBOX[-1]["name"] == "invoice.reopened"
+    assert events.OUTBOX[-1]["entity_id"] == inv.id
+    assert invoices.open_invoices() == [inv]
+
+
+def test_reopen_missing_invoice_fails():
+    with pytest.raises(DomainError) as err:
+        invoices.reopen_invoice("INV-nope")
+    assert err.value.code == "E_NOT_FOUND"
+    assert events.OUTBOX == []
+
+
+def test_reopen_unpaid_invoice_fails_and_changes_nothing():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 2, "local")
+    inv = invoices.issue_invoice(s.id)
+    before = (inv.status, inv.paid_at, inv.reopened_at)
+    events.OUTBOX.clear()
+
+    with pytest.raises(DomainError) as err:
+        invoices.reopen_invoice(inv.id)
+
+    assert err.value.code == "E_BAD_STATE"
+    assert (inv.status, inv.paid_at, inv.reopened_at) == before
+    assert events.OUTBOX == []
+    assert list(db.invoices) == [inv.id]
