diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_refunds.py b/tests/unit/test_refunds.py
--- a/tests/unit/test_refunds.py	1969-12-31 19:00:00
+++ b/tests/unit/test_refunds.py	2026-11-12 02:52:39
@@ -0,0 +1,76 @@
+from datetime import datetime, timezone
+
+import pytest
+
+from parcelo import audit, clock, refunds
+from parcelo.errors import DomainError
+from parcelo.models import Invoice
+from parcelo.money import Money
+from parcelo.store import db
+
+MOMENT = datetime(2026, 11, 12, 9, 0, tzinfo=timezone.utc)
+
+
+def _add_invoice(invoice_id="INV-paid0001", status="paid"):
+    invoice = Invoice(
+        id=invoice_id,
+        shipment_id="shp_000001",
+        amount=42.5,
+        status=status,
+    )
+    db.invoices[invoice.id] = invoice
+    return invoice
+
+
+@pytest.fixture
+def fixed_time():
+    clock.set_fixed(MOMENT)
+    yield MOMENT
+    clock.clear_fixed()
+
+
+def test_refund_paid_invoice_is_stored_and_returned(fixed_time):
+    _add_invoice()
+    refund = refunds.create_refund("INV-paid0001", Money(1500))
+
+    assert refund.id.startswith("ref_")
+    assert refund.invoice_id == "INV-paid0001"
+    assert refund.amount == Money(1500)
+    assert refund.created_at == MOMENT
+    assert db.refunds[refund.id] is refund
+
+
+def test_refund_amount_is_money(fixed_time):
+    _add_invoice()
+    refund = refunds.create_refund("INV-paid0001", 15.75)
+
+    assert isinstance(refund.amount, Money)
+    assert refund.amount == Money(1575)
+
+
+def test_refund_records_audit_entry(fixed_time):
+    _add_invoice()
+    refund = refunds.create_refund("INV-paid0001", Money(1500))
+
+    assert audit.LOG[-1]["action"] == "refund.created"
+    assert audit.LOG[-1]["entity_id"] == refund.id
+    assert audit.LOG[-1]["details"]["invoice_id"] == "INV-paid0001"
+
+
+def test_unknown_invoice_raises_not_found():
+    with pytest.raises(DomainError) as err:
+        refunds.create_refund("INV-missing", Money(100))
+    assert err.value.code == "E_NOT_FOUND"
+    assert db.refunds == {}
+    assert audit.LOG == []
+
+
+@pytest.mark.parametrize("status", ["open", "void"])
+def test_unpaid_invoice_raises_bad_state(status):
+    invoice = _add_invoice(status=status)
+    with pytest.raises(DomainError) as err:
+        refunds.create_refund(invoice.id, Money(100))
+    assert err.value.code == "E_BAD_STATE"
+    assert db.refunds == {}
+    assert audit.LOG == []
+    assert db.invoices[invoice.id].status == status
