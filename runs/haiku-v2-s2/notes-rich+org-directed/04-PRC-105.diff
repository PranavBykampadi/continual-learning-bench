@@ -0,0 +1,42 @@
+"""Refunds recorded against invoices that customers already paid."""
+
+from __future__ import annotations
+
+from decimal import Decimal
+
+from parcelo import audit, clock, ids
+from parcelo.errors import DomainError
+from parcelo.models import Refund
+from parcelo.money import Money
+from parcelo.store import db
+
+
+def create_refund(invoice_id: str, amount: Money | Decimal | float | int | str) -> Refund:
+    """Record a refund against a paid invoice.
+
+    Args:
+        invoice_id: Id of the invoice being refunded.
+        amount: Refund amount. Floats, ints, strings and Decimals are wrapped
+            with ``Money.parse``; a ``Money`` is used as given.
+
+    Returns:
+        The stored Refund.
+
+    Raises:
+        DomainError: ``E_NOT_FOUND`` if the invoice does not exist, or
+            ``E_BAD_STATE`` if the invoice is not paid.
+    """
+    invoice = db.invoices.get(invoice_id)
+    if invoice is None:
+        raise DomainError("E_NOT_FOUND", invoice_id)
+    if invoice.status != "paid":
+        raise DomainError("E_BAD_STATE", f"invoice {invoice_id} is {invoice.status}")
+    refund = Refund(
+        id=ids.new_id("ref"),
+        invoice_id=invoice_id,
+        amount=Money.parse(amount),
+        created_at=clock.now(),
+    )
+    db.refunds[refund.id] = refund
+    audit.record("refund.created", refund.id, invoice_id=invoice_id, amount=str(refund.amount))
+    return refund
