 def open_invoices():
     return [i for i in db.invoices.values() if i.status == "open"]
+
+
+INVOICE_STATUSES = ("open", "paid")
+
+
+def invoices_by_status(status: str) -> list[Invoice]:
+    """Return all invoices in the given status, sorted by id ascending.
+
+    Read-only: emits no events and writes no audit records.
+
+    Args:
+        status: "open" or "paid".
+
+    Returns:
+        Matching invoices, or an empty list if there are none.
+
+    Raises:
+        DomainError: E_BAD_INPUT if status is not "open" or "paid".
+    """
+    if status not in INVOICE_STATUSES:
+        raise DomainError("E_BAD_INPUT", status)
+    matches = [i for i in db.invoices.values() if i.status == status]
+    return sorted(matches, key=lambda i: i.id)
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/test_invoices.py b/tests/test_invoices.py
