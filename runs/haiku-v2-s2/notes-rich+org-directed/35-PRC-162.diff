@@ -1,9 +1,61 @@
-from parcelo import customers, invoices, shipments
+import pytest
 
+from parcelo import customers, events, invoices, shipments
+from parcelo.errors import DomainError
+from parcelo.models import Invoice
+from parcelo.store import db
 
+
 def test_issue_and_pay():
     c = customers.add_customer("Acme")
     s = shipments.create_shipment(c.id, 2, "local")
     inv = invoices.issue_invoice(s.id)
     assert inv.amount == 7.0
     assert invoices.mark_paid(inv.id).status == "paid"
+
+
+def _add(inv_id, status):
+    db.invoices[inv_id] = Invoice(id=inv_id, shipment_id="shp_x", amount=1.0, status=status)
+
+
+def test_invoices_by_status_returns_matches_sorted_by_id():
+    # Insert out of id order so the test fails if storage order leaks through.
+    _add("INV-c", "open")
+    _add("INV-a", "paid")
+    _add("INV-b", "open")
+    _add("INV-d", "open")
+
+    open_ids = [i.id for i in invoices.invoices_by_status("open")]
+    paid_ids = [i.id for i in invoices.invoices_by_status("paid")]
+
+    assert open_ids == ["INV-b", "INV-c", "INV-d"]
+    assert paid_ids == ["INV-a"]
+
+
+def test_invoices_by_status_empty_when_none_match():
+    _add("INV-1", "open")
+    assert invoices.invoices_by_status("paid") == []
+
+
+def test_invoices_by_status_empty_when_no_invoices():
+    assert invoices.invoices_by_status("open") == []
+
+
+def test_invoices_by_status_rejects_unknown_status():
+    _add("INV-1", "open")
+    with pytest.raises(DomainError) as err:
+        invoices.invoices_by_status("void")
+    assert err.value.code == "E_BAD_INPUT"
+
+
+def test_invoices_by_status_is_read_only():
+    _add("INV-1", "open")
+    _add("INV-2", "paid")
+    before_events = list(events.OUTBOX)
+    before_state = {k: (v.status, v.paid_at) for k, v in db.invoices.items()}
+
+    invoices.invoices_by_status("open")
+    invoices.invoices_by_status("paid")
+
+    assert events.OUTBOX == before_events
+    assert {k: (v.status, v.paid_at) for k, v in db.invoices.items()} == before_state
