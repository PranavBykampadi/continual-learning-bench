+def outstanding_by_customer() -> dict[str, Money]:
+    """Return the total of open invoices for every customer.
+
+    Only invoices with status "open" count. Paid and void invoices are ignored.
+    Customers with no open invoices map to a zero balance.
+
+    Returns:
+        A dict mapping each customer id to the Money total they still owe.
+    """
+    totals = {customer_id: Money.zero() for customer_id in db.customers}
+    for invoice in db.invoices.values():
+        if invoice.status != "open":
+            continue
+        customer_id = db.shipments[invoice.shipment_id].customer_id
+        totals[customer_id] = totals.get(customer_id, Money.zero()) + Money.parse(invoice.amount)
+    return totals
 
 
