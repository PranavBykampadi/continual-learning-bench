diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_reports_outstanding.py b/tests/unit/test_reports_outstanding.py
--- a/tests/unit/test_reports_outstanding.py	1969-12-31 19:00:00
+++ b/tests/unit/test_reports_outstanding.py	2026-11-12 02:55:43
@@ -0,0 +1,64 @@
+from parcelo import reports
+from parcelo.models import Customer, Invoice, Shipment
+from parcelo.money import Money
+from parcelo.store import db
+
+
+def _add_customer(customer_id):
+    db.customers[customer_id] = Customer(id=customer_id, name=customer_id)
+
+
+def _add_invoice(invoice_id, customer_id, amount, status="open"):
+    shipment_id = "shp_" + invoice_id
+    db.shipments[shipment_id] = Shipment(
+        id=shipment_id, customer_id=customer_id, weight_kg=1, zone="local"
+    )
+    db.invoices[invoice_id] = Invoice(
+        id=invoice_id, shipment_id=shipment_id, amount=amount, status=status
+    )
+
+
+def test_sums_open_invoices_per_customer():
+    _add_customer("C1")
+    _add_customer("C2")
+    _add_invoice("INV-1", "C1", 7.0)
+    _add_invoice("INV-2", "C1", 2.5)
+    _add_invoice("INV-3", "C2", 10.0)
+
+    result = reports.outstanding_by_customer()
+
+    assert result == {"C1": Money(950), "C2": Money(1000)}
+
+
+def test_paid_and_void_invoices_are_excluded():
+    _add_customer("C1")
+    _add_invoice("INV-1", "C1", 7.0, status="open")
+    _add_invoice("INV-2", "C1", 3.0, status="paid")
+    _add_invoice("INV-3", "C1", 4.0, status="void")
+
+    assert reports.outstanding_by_customer()["C1"] == Money(700)
+
+
+def test_customer_with_no_open_invoices_is_zero():
+    _add_customer("C1")
+    _add_customer("C2")
+    _add_invoice("INV-1", "C1", 5.0, status="paid")
+
+    result = reports.outstanding_by_customer()
+
+    assert result == {"C1": Money.zero(), "C2": Money.zero()}
+
+
+def test_values_are_money_not_floats():
+    _add_customer("C1")
+    _add_invoice("INV-1", "C1", 0.1)
+    _add_invoice("INV-2", "C1", 0.2)
+
+    result = reports.outstanding_by_customer()
+
+    assert all(isinstance(v, Money) for v in result.values())
+    assert result["C1"] == Money(30)
+
+
+def test_empty_store_returns_empty_dict():
+    assert reports.outstanding_by_customer() == {}
