diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_escalate_invoice.py b/tests/unit/test_escalate_invoice.py
--- a/tests/unit/test_escalate_invoice.py	1969-12-31 19:00:00
+++ b/tests/unit/test_escalate_invoice.py	2026-11-12 03:25:30
@@ -0,0 +1,66 @@
+import pytest
+
+from parcelo import events, invoices
+from parcelo.errors import DomainError
+from parcelo.models import Invoice
+from parcelo.store import db
+
+
+def _add_invoice(amount, status="open"):
+    invoice = Invoice(id="INV-test", shipment_id="shp_x", amount=amount, status=status)
+    db.invoices[invoice.id] = invoice
+    return invoice
+
+
+def _escalated_events():
+    return [e for e in events.OUTBOX if e["name"] == "invoice.escalated"]
+
+
+def test_escalates_open_invoice_at_threshold():
+    _add_invoice(500.00)
+    inv = invoices.escalate_invoice("INV-test")
+    assert inv.status == "escalated"
+    assert db.invoices["INV-test"].status == "escalated"
+
+
+def test_escalates_large_open_invoice_and_emits_once():
+    _add_invoice(1234.56)
+    inv = invoices.escalate_invoice("INV-test")
+    assert inv.status == "escalated"
+    assert len(_escalated_events()) == 1
+    assert _escalated_events()[0]["entity_id"] == "INV-test"
+
+
+def test_below_threshold_fails_without_change_or_event():
+    _add_invoice(499.99)
+    with pytest.raises(DomainError) as err:
+        invoices.escalate_invoice("INV-test")
+    assert err.value.code == "E_BAD_STATE"
+    assert db.invoices["INV-test"].status == "open"
+    assert _escalated_events() == []
+
+
+@pytest.mark.parametrize("status", ["paid", "void"])
+def test_non_open_invoice_fails(status):
+    _add_invoice(900.00, status=status)
+    with pytest.raises(DomainError) as err:
+        invoices.escalate_invoice("INV-test")
+    assert err.value.code == "E_BAD_STATE"
+    assert db.invoices["INV-test"].status == status
+    assert _escalated_events() == []
+
+
+def test_missing_invoice_fails():
+    with pytest.raises(DomainError) as err:
+        invoices.escalate_invoice("INV-nope")
+    assert err.value.code == "E_NOT_FOUND"
+    assert events.OUTBOX == []
+
+
+def test_retry_on_escalated_invoice_is_unchanged_with_no_second_event():
+    _add_invoice(800.00)
+    first = invoices.escalate_invoice("INV-test")
+    second = invoices.escalate_invoice("INV-test")
+    assert second is first
+    assert second.status == "escalated"
+    assert len(_escalated_events()) == 1
