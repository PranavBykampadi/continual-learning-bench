@@ -0,0 +1,35 @@
+"""Open disputes against invoices."""
+
+from parcelo import clock, events, ids
+from parcelo.errors import DomainError
+from parcelo.models import Dispute
+from parcelo.store import db
+
+
+def open_dispute(invoice_id, reason):
+    """Open a dispute against an existing invoice.
+
+    Args:
+        invoice_id: Id of the invoice the customer is contesting.
+        reason: Why the invoice is being contested. Must not be blank.
+
+    Returns:
+        The newly created Dispute, also stored in db.disputes.
+
+    Raises:
+        DomainError: E_NOT_FOUND if the invoice does not exist, or
+            E_BAD_INPUT if the reason is empty or whitespace only.
+    """
+    if invoice_id not in db.invoices:
+        raise DomainError("E_NOT_FOUND", invoice_id)
+    if not reason or not reason.strip():
+        raise DomainError("E_BAD_INPUT", "reason required")
+    dispute = Dispute(
+        id=ids.new_id("dsp"),
+        invoice_id=invoice_id,
+        reason=reason,
+        opened_at=clock.now(),
+    )
+    db.disputes[dispute.id] = dispute
+    events.emit("dispute.opened", dispute.id, invoice_id=invoice_id)
+    return dispute
