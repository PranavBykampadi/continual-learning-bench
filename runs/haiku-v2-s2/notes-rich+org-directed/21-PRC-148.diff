diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_disputes.py b/tests/unit/test_disputes.py
--- a/tests/unit/test_disputes.py	1969-12-31 19:00:00
+++ b/tests/unit/test_disputes.py	2026-11-12 03:08:36
@@ -0,0 +1,67 @@
+from datetime import datetime, timezone
+
+import pytest
+
+from parcelo import clock, customers, disputes, events, invoices, shipments, store
+from parcelo.errors import DomainError
+
+
+def _make_invoice():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 2.0, "national")
+    return invoices.issue_invoice(s.id)
+
+
+def test_open_dispute_stores_and_returns_dispute():
+    inv = _make_invoice()
+    moment = datetime(2026, 11, 1, 12, 0, tzinfo=timezone.utc)
+    clock.set_fixed(moment)
+
+    d = disputes.open_dispute(inv.id, "wrong weight")
+
+    assert d.id.startswith("dsp_")
+    assert d.invoice_id == inv.id
+    assert d.reason == "wrong weight"
+    assert d.opened_at == moment
+    assert store.db.disputes[d.id] is d
+
+
+def test_open_dispute_emits_event():
+    inv = _make_invoice()
+    d = disputes.open_dispute(inv.id, "duplicate charge")
+
+    assert events.OUTBOX[-1]["name"] == "dispute.opened"
+    assert events.OUTBOX[-1]["entity_id"] == d.id
+
+
+def test_unknown_invoice_fails_without_side_effects():
+    outbox_before = len(events.OUTBOX)
+
+    with pytest.raises(DomainError) as err:
+        disputes.open_dispute("INV-missing", "wrong weight")
+
+    assert err.value.code == "E_NOT_FOUND"
+    assert store.db.disputes == {}
+    assert len(events.OUTBOX) == outbox_before
+
+
+@pytest.mark.parametrize("reason", ["", "   ", None])
+def test_empty_reason_fails_without_side_effects(reason):
+    inv = _make_invoice()
+    outbox_before = len(events.OUTBOX)
+
+    with pytest.raises(DomainError) as err:
+        disputes.open_dispute(inv.id, reason)
+
+    assert err.value.code == "E_BAD_INPUT"
+    assert store.db.disputes == {}
+    assert len(events.OUTBOX) == outbox_before
+
+
+def test_reset_clears_disputes():
+    inv = _make_invoice()
+    disputes.open_dispute(inv.id, "wrong weight")
+
+    store.reset()
+
+    assert store.db.disputes == {}
