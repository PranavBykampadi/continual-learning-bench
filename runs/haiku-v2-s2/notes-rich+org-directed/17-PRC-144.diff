+from decimal import Decimal
+
+from parcelo.errors import DomainError
+from parcelo.money import Money
+
 ZONE_BASE = {"local": 4.5, "national": 9.0, "international": 24.0}
 PER_KG = 1.25
 
+# Fuel surcharge percentage per zone. Finance owns these numbers; they must
+# match parcelo/legacy/billing.py fuel_surcharge until the legacy module is removed.
+FUEL_SURCHARGE_PCT = {"local": 0.0, "national": 4.0, "international": 9.5}
+INSURANCE_PCT = 2.0
+INSURANCE_MIN = Money(100)
 
+
 def base_rate(zone):
     if zone not in ZONE_BASE:
         raise ValueError("unknown zone: %s" % zone)
@@ -12,3 +23,33 @@
     if weight_kg <= 0:
         raise ValueError("weight must be positive")
     return round(base_rate(zone) + PER_KG * weight_kg, 2)
+
