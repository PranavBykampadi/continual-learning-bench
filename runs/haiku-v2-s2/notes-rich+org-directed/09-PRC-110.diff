+from parcelo.errors import DomainError
+from parcelo.money import Money
+
 ZONE_BASE = {"local": 4.5, "national": 9.0, "international": 24.0}
 PER_KG = 1.25
+TIER_DISCOUNT_FACTOR = {"standard": 1.0, "gold": 0.9}
 
 
 def base_rate(zone):
@@ -12,3 +16,17 @@
     if weight_kg <= 0:
         raise ValueError("weight must be positive")
     return round(base_rate(zone) + PER_KG * weight_kg, 2)
+
+
+def discounted_quote(weight_kg, zone, tier):
+    """Quote for weight and zone with the tier discount applied, as Money.
+
+    "gold" gets 10% off; "standard" gets no discount. Unknown tiers and
+    unknown zones raise DomainError.
+    """
+    if tier not in TIER_DISCOUNT_FACTOR:
+        raise DomainError("E_BAD_INPUT", "unknown tier: %s" % tier)
+    if zone not in ZONE_BASE:
+        raise DomainError("E_BAD_ZONE", "unknown zone: %s" % zone)
+    regular = Money.parse(quote(weight_kg, zone))
+    return regular.scale(TIER_DISCOUNT_FACTOR[tier])
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_rates_gold_discount.py b/tests/unit/test_rates_gold_discount.py
--- a/tests/unit/test_rates_gold_discount.py	1969-12-31 19:00:00
+++ b/tests/unit/test_rates_gold_discount.py	2026-11-12 02:57:20
@@ -0,0 +1,40 @@
+import pytest
+
+from parcelo import audit, rates
+from parcelo.errors import DomainError
+from parcelo.money import Money
+
+
+def test_gold_gets_ten_percent_off():
+    # local, 2 kg: quote is 7.00 -> 6.30 with 10% off
+    result = rates.discounted_quote(2, "local", "gold")
+    assert result == Money(630)
+
+
+def test_standard_has_no_discount():
+    result = rates.discounted_quote(2, "local", "standard")
+    assert result == Money(700)
+
+
+def test_returns_money_instance():
+    assert isinstance(rates.discounted_quote(2, "national", "gold"), Money)
+    assert isinstance(rates.discounted_quote(2, "national", "standard"), Money)
+
+
+def test_unknown_tier_fails():
+    with pytest.raises(DomainError) as err:
+        rates.discounted_quote(2, "local", "platinum")
+    assert err.value.code == "E_BAD_INPUT"
+
+
+def test_unknown_zone_fails():
+    with pytest.raises(DomainError) as err:
+        rates.discounted_quote(2, "moon", "gold")
+    assert err.value.code == "E_BAD_ZONE"
+
+
+def test_quote_does_not_record_audit():
+    # Pricing is a read-only computation, so it adds no audit entries.
+    before = len(audit.LOG)
+    rates.discounted_quote(2, "local", "gold")
+    assert len(audit.LOG) == before
