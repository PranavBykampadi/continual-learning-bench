diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/parcelo/shipments.py b/parcelo/shipments.py
--- a/parcelo/shipments.py	2026-11-10 12:20:18
+++ b/parcelo/shipments.py	2026-11-12 03:12:01
@@ -28,3 +28,12 @@
     if shipment_id not in db.shipments:
         raise DomainError("E_NOT_FOUND", shipment_id)
     return db.shipments[shipment_id]
+
+
+def mark_lost(shipment_id):
+    shipment = get_shipment(shipment_id)
+    if shipment.status == "delivered" or shipment.delivered_at is not None:
+        raise DomainError("E_BAD_STATE", shipment_id)
+    shipment.status = "lost"
+    events.emit("shipment.lost", shipment.id)
+    return shipment
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_shipments_mark_lost.py b/tests/unit/test_shipments_mark_lost.py
--- a/tests/unit/test_shipments_mark_lost.py	1969-12-31 19:00:00
+++ b/tests/unit/test_shipments_mark_lost.py	2026-11-12 03:12:06
@@ -0,0 +1,65 @@
+from datetime import datetime, timezone
+
+import pytest
+
+from parcelo import clock, customers, events, shipments
+from parcelo.errors import DomainError
+
+
+def _new_shipment():
+    c = customers.add_customer("Acme")
+    return shipments.create_shipment(c.id, 1.5, "national")
+
+
+def test_mark_lost_sets_status_and_emits_once():
+    s = _new_shipment()
+    before = len(events.OUTBOX)
+    result = shipments.mark_lost(s.id)
+    assert result is s
+    assert s.status == "lost"
+    assert len(events.OUTBOX) - before == 1
+    assert events.OUTBOX[-1]["name"] == "shipment.lost"
+    assert events.OUTBOX[-1]["entity_id"] == s.id
+
+
+def test_mark_lost_event_timestamp():
+    s = _new_shipment()
+    moment = datetime(2026, 11, 12, 9, 0, tzinfo=timezone.utc)
+    clock.set_fixed(moment)
+    shipments.mark_lost(s.id)
+    assert events.OUTBOX[-1]["at"] == moment
+
+
+def test_mark_lost_unknown_shipment_fails_and_emits_nothing():
+    before = len(events.OUTBOX)
+    with pytest.raises(DomainError) as err:
+        shipments.mark_lost("shp_999999")
+    assert err.value.code == "E_NOT_FOUND"
+    assert len(events.OUTBOX) == before
+
+
+def test_mark_lost_delivered_status_fails_and_emits_nothing():
+    s = _new_shipment()
+    s.status = "delivered"
+    before = len(events.OUTBOX)
+    with pytest.raises(DomainError) as err:
+        shipments.mark_lost(s.id)
+    assert err.value.code == "E_BAD_STATE"
+    assert s.status == "delivered"
+    assert len(events.OUTBOX) == before
+
+
+def test_mark_lost_delivered_at_set_fails():
+    s = _new_shipment()
+    s.delivered_at = datetime(2026, 11, 11, 15, 0, tzinfo=timezone.utc)
+    with pytest.raises(DomainError) as err:
+        shipments.mark_lost(s.id)
+    assert err.value.code == "E_BAD_STATE"
+    assert s.status == "created"
+
+
+def test_get_shipment_is_read_only_and_emits_nothing():
+    s = _new_shipment()
+    before = len(events.OUTBOX)
+    assert shipments.get_shipment(s.id) is s
+    assert len(events.OUTBOX) == before
