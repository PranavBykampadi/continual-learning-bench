+++ b/tests/unit/test_rates_surcharge.py	2026-11-12 02:50:42
@@ -0,0 +1,36 @@
+import pytest
+
+from parcelo import rates
+from parcelo.errors import DomainError
+
+
+def test_local_has_no_surcharge():
+    assert rates.quote_with_surcharge(2, "local") == (7.0, 0.0)
+
+
+def test_national_surcharge_is_four_percent():
+    # quote 9.0 + 1.25 * 2 = 11.5, surcharge 4% of 11.5 = 0.46
+    assert rates.quote_with_surcharge(2, "national") == (11.5, 0.46)
+
+
+def test_international_surcharge_is_nine_point_five_percent():
+    # quote 24.0 + 1.25 * 1 = 25.25, surcharge 9.5% of 25.25 = 2.39875 -> 2.40
+    assert rates.quote_with_surcharge(1, "international") == (25.25, 2.4)
+
+
+def test_quote_matches_plain_quote():
+    base, _ = rates.quote_with_surcharge(3.7, "national")
+    assert base == rates.quote(3.7, "national")
+
+
+def test_unknown_zone():
+    with pytest.raises(DomainError) as err:
+        rates.quote_with_surcharge(2, "moon")
+    assert err.value.code == "E_BAD_ZONE"
+
+
+@pytest.mark.parametrize("weight", [0, -1, -0.5])
+def test_non_positive_weight(weight):
+    with pytest.raises(DomainError) as err:
+        rates.quote_with_surcharge(weight, "local")
+    assert err.value.code == "E_BAD_WEIGHT"
