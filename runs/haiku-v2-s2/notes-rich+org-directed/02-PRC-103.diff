+FUEL_SURCHARGE_PCT = {"local": 0.0, "national": 4.0, "international": 9.5}
 
 
 def base_rate(zone):
@@ -12,3 +16,30 @@
     if weight_kg <= 0:
         raise ValueError("weight must be positive")
     return round(base_rate(zone) + PER_KG * weight_kg, 2)
+
+
+def quote_with_surcharge(weight_kg, zone):
+    """Quote a shipment and add the fuel surcharge for its zone.
+
+    The surcharge is computed on the unrounded quote and rounded once at the
+    end, so the amounts are only rounded to cents here.
+
+    Args:
+        weight_kg: Shipment weight in kilograms. Must be greater than zero.
+        zone: One of the keys in ZONE_BASE ("local", "national", "international").
+
+    Returns:
+        A tuple (quote, fuel_surcharge), both in dollars rounded to cents.
+        quote matches quote(weight_kg, zone).
+
+    Raises:
+        DomainError: E_BAD_ZONE if the zone is unknown, or E_BAD_WEIGHT if
+            weight_kg is zero or negative.
+    """
+    if zone not in ZONE_BASE:
+        raise DomainError("E_BAD_ZONE", zone)
+    if weight_kg <= 0:
+        raise DomainError("E_BAD_WEIGHT", str(weight_kg))
+    raw = ZONE_BASE[zone] + PER_KG * weight_kg
+    surcharge = round(raw * FUEL_SURCHARGE_PCT[zone] / 100.0, 2)
+    return round(raw, 2), surcharge
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_rates_surcharge.py b/tests/unit/test_rates_surcharge.py
