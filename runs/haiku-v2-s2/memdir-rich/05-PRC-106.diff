 def open_invoices():
     return [i for i in db.invoices.values() if i.status == "open"]
+
+
+def late_fee_for(invoice_id):
+    """Late fee on an invoice as Money.
+
+    The invoice is late from 30 days after issue. Each full day past those
+    30 days adds 1.5% of the invoice amount. Not late yet means zero.
+    """
+    if invoice_id not in db.invoices:
+        raise DomainError("E_NOT_FOUND", invoice_id)
+    invoice = db.invoices[invoice_id]
+    issued = invoice.issued_at
+    if issued.tzinfo is None:
+        # issue_invoice stores a naive UTC datetime; clock.now() is aware.
+        issued = issued.replace(tzinfo=timezone.utc)
+    elapsed_days = (clock.now() - issued).days
+    days_late = elapsed_days - LATE_AFTER_DAYS
+    if days_late <= 0:
+        return Money.zero()
+    return Money.parse(invoice.amount).scale(LATE_FEE_PER_DAY * days_late)
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_late_fee_for.py b/tests/unit/test_late_fee_for.py
--- a/tests/unit/test_late_fee_for.py	1969-12-31 19:00:00
+++ b/tests/unit/test_late_fee_for.py	2026-11-12 02:54:59
@@ -0,0 +1,53 @@
+from datetime import datetime, timedelta, timezone
+
+import pytest
+
+from parcelo import clock, customers, invoices, shipments
+from parcelo.errors import DomainError
+from parcelo.money import Money
+
+
+def _open_invoice():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 2, "local")
+    inv = invoices.issue_invoice(s.id)
+    assert inv.amount == 7.0  # 700 cents, used by the expected values below
+    return inv
+
+
+def _days_after_issue(inv, days):
+    issued = datetime(2026, 1, 1, tzinfo=timezone.utc)
+    inv.issued_at = issued
+    clock.set_fixed(issued + timedelta(days=days))
+
+
+@pytest.mark.parametrize("days", [0, 29, 30])
+def test_no_fee_until_past_30_days(days):
+    inv = _open_invoice()
+    _days_after_issue(inv, days)
+    assert invoices.late_fee_for(inv.id) == Money.zero()
+
+
+def test_fee_is_1_5_percent_per_day_past_30():
+    inv = _open_invoice()
+    _days_after_issue(inv, 32)  # 2 days late: 2 * 1.5% of 7.00 = 0.21
+    assert invoices.late_fee_for(inv.id) == Money(21)
+
+
+def test_fee_grows_with_each_day():
+    inv = _open_invoice()
+    _days_after_issue(inv, 40)  # 10 days late: 10 * 1.5% of 7.00 = 1.05
+    assert invoices.late_fee_for(inv.id) == Money(105)
+
+
+def test_naive_issued_at_from_issue_invoice_is_handled():
+    inv = _open_invoice()
+    inv.issued_at = datetime(2026, 1, 1)  # naive, as issue_invoice stores it
+    clock.set_fixed(datetime(2026, 1, 1, tzinfo=timezone.utc) + timedelta(days=40))
+    assert invoices.late_fee_for(inv.id) == Money(105)
+
+
+def test_missing_invoice_raises_not_found():
+    with pytest.raises(DomainError) as err:
+        invoices.late_fee_for("INV-missing")
+    assert err.value.code == "E_NOT_FOUND"
