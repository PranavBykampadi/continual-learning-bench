diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_customers_by_tier.py b/tests/unit/test_customers_by_tier.py
--- a/tests/unit/test_customers_by_tier.py	1969-12-31 19:00:00
+++ b/tests/unit/test_customers_by_tier.py	2026-11-12 03:26:32
@@ -0,0 +1,61 @@
+import pytest
+
+from parcelo import events
+from parcelo.customers import TIERS, add_customer, customers_by_tier
+from parcelo.errors import DomainError
+from parcelo.store import db
+
+
+def test_returns_only_customers_on_that_tier():
+    std = add_customer("Alice", tier="standard")
+    gold = add_customer("Bob", tier="gold")
+    result = customers_by_tier("gold")
+    assert result == [gold]
+    assert std not in result
+
+
+def test_empty_list_when_no_customer_on_tier():
+    add_customer("Alice", tier="standard")
+    assert customers_by_tier("gold") == []
+
+
+def test_empty_list_when_no_customers_at_all():
+    assert customers_by_tier("standard") == []
+
+
+def test_result_sorted_by_id_ascending_even_if_inserted_out_of_order():
+    a = add_customer("A", tier="gold")
+    b = add_customer("B", tier="gold")
+    c = add_customer("C", tier="gold")
+    # Insert in reverse id order so storage order differs from id order.
+    db.customers.clear()
+    for cust in (c, a, b):
+        db.customers[cust.id] = cust
+    result = customers_by_tier("gold")
+    assert [x.id for x in result] == sorted(x.id for x in (a, b, c))
+
+
+def test_unknown_tier_raises_bad_input():
+    add_customer("Alice", tier="standard")
+    with pytest.raises(DomainError) as err:
+        customers_by_tier("platinum")
+    assert err.value.code == "E_BAD_INPUT"
+
+
+@pytest.mark.parametrize("tier", ["", None, "GOLD"])
+def test_invalid_tier_values_raise_bad_input(tier):
+    with pytest.raises(DomainError) as err:
+        customers_by_tier(tier)
+    assert err.value.code == "E_BAD_INPUT"
+
+
+def test_every_known_tier_is_accepted():
+    for tier in TIERS:
+        assert customers_by_tier(tier) == []
+
+
+def test_read_only_emits_no_events():
+    add_customer("Alice", tier="gold")
+    events.OUTBOX.clear()
+    customers_by_tier("gold")
+    assert events.OUTBOX == []
