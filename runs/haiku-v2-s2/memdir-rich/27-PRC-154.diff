+def reactivate_customer(customer_id):
+    """Set a customer's active flag to True and return the customer.
+
+    Missing id -> E_NOT_FOUND. Already active -> returned unchanged, with no
+    write and no event, so a retried call is safe.
+    """
+    if customer_id not in db.customers:
+        raise DomainError("E_NOT_FOUND", customer_id)
+    customer = db.customers[customer_id]
+    if customer.active:
+        return customer
+    customer.active = True
+    events.emit("customer.reactivated", customer_id)
+    return customer
 
 
