diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_reactivate_customer.py b/tests/unit/test_reactivate_customer.py
--- a/tests/unit/test_reactivate_customer.py	1969-12-31 19:00:00
+++ b/tests/unit/test_reactivate_customer.py	2026-11-12 03:25:13
@@ -0,0 +1,66 @@
+import pytest
+
+from parcelo import customers, events
+from parcelo.errors import DomainError
+from parcelo.store import db
+
+
+def _inactive_customer():
+    customer = customers.add_customer("Acme")
+    # No deactivate function exists in this checkout; set the flag directly.
+    customer.active = False
+    events.OUTBOX.clear()
+    return customer
+
+
+def test_reactivates_inactive_customer():
+    customer = _inactive_customer()
+
+    result = customers.reactivate_customer(customer.id)
+
+    assert result is customer
+    assert result.active is True
+    assert db.customers[customer.id].active is True
+
+
+def test_emits_one_event_on_reactivation():
+    customer = _inactive_customer()
+
+    customers.reactivate_customer(customer.id)
+
+    assert len(events.OUTBOX) == 1
+    assert events.OUTBOX[-1]["name"] == "customer.reactivated"
+    assert events.OUTBOX[-1]["entity_id"] == customer.id
+
+
+def test_missing_customer_raises_not_found():
+    events.OUTBOX.clear()
+
+    with pytest.raises(DomainError) as err:
+        customers.reactivate_customer("C_missing")
+
+    assert err.value.code == "E_NOT_FOUND"
+    assert events.OUTBOX == []
+
+
+def test_already_active_customer_is_returned_unchanged_without_event():
+    customer = customers.add_customer("Acme")
+    events.OUTBOX.clear()
+
+    result = customers.reactivate_customer(customer.id)
+
+    assert result is customer
+    assert result.active is True
+    assert events.OUTBOX == []
+
+
+def test_repeat_call_is_safe_and_emits_once():
+    customer = _inactive_customer()
+
+    first = customers.reactivate_customer(customer.id)
+    second = customers.reactivate_customer(customer.id)
+
+    assert first is customer
+    assert second is customer
+    assert second.active is True
+    assert len(events.OUTBOX) == 1
