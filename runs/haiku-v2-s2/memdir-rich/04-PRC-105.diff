diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_refunds.py b/tests/unit/test_refunds.py
--- a/tests/unit/test_refunds.py	1969-12-31 19:00:00
+++ b/tests/unit/test_refunds.py	2026-11-12 02:53:21
@@ -0,0 +1,81 @@
+from datetime import datetime, timezone
+
+import pytest
+
+from parcelo import audit, clock, customers, invoices, shipments
+from parcelo.errors import DomainError
+from parcelo.models import Refund
+from parcelo.money import Money
+from parcelo.refunds import create_refund
+from parcelo.store import db
+
+
+def make_invoice():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 2, "local")
+    return invoices.issue_invoice(s.id)
+
+
+def make_paid_invoice():
+    inv = make_invoice()
+    invoices.mark_paid(inv.id)
+    return inv
+
+
+def test_refund_paid_invoice():
+    moment = datetime(2026, 11, 12, 9, 30, tzinfo=timezone.utc)
+    clock.set_fixed(moment)
+    inv = make_paid_invoice()
+    audit.LOG.clear()
+    refund = create_refund(inv.id, "5.00")
+    assert isinstance(refund, Refund)
+    assert refund.id.startswith("ref_")
+    assert refund.invoice_id == inv.id
+    assert refund.amount == Money(500)
+    assert refund.created_at == moment
+    assert db.refunds[refund.id] is refund
+    assert audit.LOG[-1]["action"] == "refund.created"
+
+
+def test_refund_accepts_money_and_float():
+    inv = make_paid_invoice()
+    assert create_refund(inv.id, Money(250)).amount == Money(250)
+    assert create_refund(inv.id, 1.5).amount == Money(150)
+
+
+def test_unknown_invoice():
+    with pytest.raises(DomainError) as err:
+        create_refund("INV-missing", "5.00")
+    assert err.value.code == "E_NOT_FOUND"
+    assert db.refunds == {}
+    assert audit.LOG == []
+
+
+def test_open_invoice_cannot_be_refunded():
+    inv = make_invoice()
+    audit.LOG.clear()
+    with pytest.raises(DomainError) as err:
+        create_refund(inv.id, "5.00")
+    assert err.value.code == "E_BAD_STATE"
+    assert db.refunds == {}
+    assert audit.LOG == []
+
+
+def test_void_invoice_cannot_be_refunded():
+    inv = make_invoice()
+    inv.status = "void"
+    with pytest.raises(DomainError) as err:
+        create_refund(inv.id, "5.00")
+    assert err.value.code == "E_BAD_STATE"
+    assert db.refunds == {}
+
+
+@pytest.mark.parametrize("amount", [0, "0.00", -1, -2.5])
+def test_non_positive_amount_rejected(amount):
+    inv = make_paid_invoice()
+    audit.LOG.clear()
+    with pytest.raises(DomainError) as err:
+        create_refund(inv.id, amount)
+    assert err.value.code == "E_BAD_INPUT"
+    assert db.refunds == {}
+    assert audit.LOG == []
