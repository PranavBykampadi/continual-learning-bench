diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_claims.py b/tests/unit/test_claims.py
--- a/tests/unit/test_claims.py	1969-12-31 19:00:00
+++ b/tests/unit/test_claims.py	2026-11-12 03:01:48
@@ -0,0 +1,76 @@
+from datetime import datetime, timezone
+
+import pytest
+
+from parcelo import audit, claims, clock, customers, shipments, store
+from parcelo.errors import DomainError
+from parcelo.money import Money
+from parcelo.store import db
+
+
+def _delivered_shipment():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 2, "local")
+    s.status = "delivered"  # no code sets "delivered" yet; set by hand
+    return s
+
+
+def test_file_claim_stores_and_returns_claim():
+    clock.set_fixed(datetime(2026, 11, 1, 9, 0, tzinfo=timezone.utc))
+    s = _delivered_shipment()
+    audit.LOG.clear()
+
+    c = claims.file_claim(s.id, "12.50", "box damaged")
+
+    assert c.id.startswith("clm_")
+    assert c.shipment_id == s.id
+    assert c.amount == Money(1250)
+    assert c.reason == "box damaged"
+    assert c.filed_at == clock.now()
+    assert db.claims[c.id] is c
+    assert audit.LOG[-1]["action"] == "claim.filed"
+
+
+def test_amount_accepts_money_and_float():
+    s = _delivered_shipment()
+    assert claims.file_claim(s.id, Money(300), "a").amount == Money(300)
+    assert claims.file_claim(s.id, 4.5, "b").amount == Money(450)
+
+
+def test_missing_shipment():
+    with pytest.raises(DomainError) as err:
+        claims.file_claim("shp_nope", 5, "reason")
+    assert err.value.code == "E_NOT_FOUND"
+    assert db.claims == {}
+    assert audit.LOG == []
+
+
+@pytest.mark.parametrize("status", ["created", "cancelled"])
+def test_shipment_not_delivered(status):
+    s = _delivered_shipment()
+    s.status = status
+    audit.LOG.clear()
+    with pytest.raises(DomainError) as err:
+        claims.file_claim(s.id, 5, "reason")
+    assert err.value.code == "E_BAD_STATE"
+    assert db.claims == {}
+    assert audit.LOG == []
+
+
+@pytest.mark.parametrize("amount", [0, "0.00", -1, -2.5, "-0.01", None, "abc"])
+def test_non_positive_or_invalid_amount(amount):
+    s = _delivered_shipment()
+    audit.LOG.clear()
+    with pytest.raises(DomainError) as err:
+        claims.file_claim(s.id, amount, "reason")
+    assert err.value.code == "E_BAD_INPUT"
+    assert db.claims == {}
+    assert audit.LOG == []
+
+
+def test_store_reset_clears_claims():
+    s = _delivered_shipment()
+    claims.file_claim(s.id, 5, "reason")
+    assert len(db.claims) == 1
+    store.reset()
+    assert db.claims == {}
