diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_pickups.py b/tests/unit/test_pickups.py
--- a/tests/unit/test_pickups.py	1969-12-31 19:00:00
+++ b/tests/unit/test_pickups.py	2026-11-12 03:09:23
@@ -0,0 +1,49 @@
+from datetime import datetime, timezone
+
+import pytest
+
+from parcelo import clock, customers, events, pickups, shipments
+from parcelo.errors import DomainError
+from parcelo.store import db
+
+
+def _created_shipment():
+    c = customers.add_customer("Acme")
+    return shipments.create_shipment(c.id, 2.0, "local")
+
+
+def test_schedule_pickup_creates_and_stores():
+    clock.set_fixed(datetime(2026, 11, 12, 9, 0, tzinfo=timezone.utc))
+    s = _created_shipment()
+    start = datetime(2026, 11, 13, 8, 0, tzinfo=timezone.utc)
+    events.OUTBOX.clear()
+
+    p = pickups.schedule_pickup(s.id, start)
+
+    assert p.id.startswith("pck_")
+    assert p.shipment_id == s.id
+    assert p.window_start == start
+    assert p.scheduled_at == clock.now()
+    assert db.pickups[p.id] is p
+    assert events.OUTBOX[-1]["name"] == "pickup.scheduled"
+
+
+def test_unknown_shipment_fails():
+    events.OUTBOX.clear()
+    with pytest.raises(DomainError) as err:
+        pickups.schedule_pickup("shp_nope", "2026-11-13T08:00")
+    assert err.value.code == "E_NOT_FOUND"
+    assert db.pickups == {}
+    assert events.OUTBOX == []
+
+
+@pytest.mark.parametrize("status", ["delivered", "cancelled"])
+def test_shipment_not_created_fails(status):
+    s = _created_shipment()
+    s.status = status
+    events.OUTBOX.clear()
+    with pytest.raises(DomainError) as err:
+        pickups.schedule_pickup(s.id, "2026-11-13T08:00")
+    assert err.value.code == "E_BAD_STATE"
+    assert db.pickups == {}
+    assert events.OUTBOX == []
