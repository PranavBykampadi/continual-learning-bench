+def reassign_shipment(shipment_id, new_customer_id):
+    # Checks run in this order: shipment exists, shipment not delivered, new customer exists.
+    shipment = get_shipment(shipment_id)
+    if shipment.status == "delivered":
+        raise DomainError("E_BAD_STATE", f"{shipment_id} is {shipment.status}")
+    if new_customer_id not in db.customers:
+        raise DomainError("E_UNKNOWN_CUSTOMER", new_customer_id)
+    old_customer_id = shipment.customer_id
+    shipment.customer_id = new_customer_id
+    audit.record(
+        "shipment.reassigned",
+        shipment_id,
+        old_customer_id=old_customer_id,
+        new_customer_id=new_customer_id,
+    )
+    events.emit(
+        "shipment.reassigned",
+        shipment_id,
+        old_customer_id=old_customer_id,
+        new_customer_id=new_customer_id,
+    )
+    return shipment
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_reassign_shipment.py b/tests/unit/test_reassign_shipment.py
--- a/tests/unit/test_reassign_shipment.py	1969-12-31 19:00:00
+++ b/tests/unit/test_reassign_shipment.py	2026-11-12 03:06:27
@@ -0,0 +1,65 @@
+import pytest
+
+from parcelo import audit, customers, events, shipments
+from parcelo.errors import DomainError
+from parcelo.store import db
+
+
+def _setup():
+    old = customers.add_customer("Old Co")
+    new = customers.add_customer("New Co")
+    s = shipments.create_shipment(old.id, 2.0, "national")
+    return old, new, s
+
+
+def test_reassign_changes_customer_and_returns_same_shipment():
+    old, new, s = _setup()
+    result = shipments.reassign_shipment(s.id, new.id)
+    assert result is s
+    assert s.customer_id == new.id
+    assert db.shipments[s.id].customer_id == new.id
+
+
+def test_reassign_records_audit_and_event():
+    old, new, s = _setup()
+    audit.LOG.clear()
+    events.OUTBOX.clear()
+    shipments.reassign_shipment(s.id, new.id)
+    assert audit.LOG[-1]["action"] == "shipment.reassigned"
+    assert audit.LOG[-1]["entity_id"] == s.id
+    assert audit.LOG[-1]["details"] == {
+        "old_customer_id": old.id,
+        "new_customer_id": new.id,
+    }
+    assert events.OUTBOX[-1]["name"] == "shipment.reassigned"
+
+
+def test_reassign_missing_shipment_raises_not_found():
+    old, new, s = _setup()
+    audit.LOG.clear()
+    with pytest.raises(DomainError) as err:
+        shipments.reassign_shipment("shp_missing", new.id)
+    assert err.value.code == "E_NOT_FOUND"
+    assert audit.LOG == []
+    assert db.shipments[s.id].customer_id == old.id
+
+
+def test_reassign_to_missing_customer_raises_unknown_customer():
+    old, new, s = _setup()
+    audit.LOG.clear()
+    with pytest.raises(DomainError) as err:
+        shipments.reassign_shipment(s.id, "C_missing")
+    assert err.value.code == "E_UNKNOWN_CUSTOMER"
+    assert audit.LOG == []
+    assert db.shipments[s.id].customer_id == old.id
+
+
+def test_reassign_delivered_shipment_raises_bad_state():
+    old, new, s = _setup()
+    s.status = "delivered"  # no mark_delivered in this checkout; set by hand
+    audit.LOG.clear()
+    with pytest.raises(DomainError) as err:
+        shipments.reassign_shipment(s.id, new.id)
+    assert err.value.code == "E_BAD_STATE"
+    assert audit.LOG == []
+    assert db.shipments[s.id].customer_id == old.id
