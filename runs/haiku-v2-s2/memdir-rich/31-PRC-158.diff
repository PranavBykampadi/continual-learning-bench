diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/parcelo/returns.py b/parcelo/returns.py
--- a/parcelo/returns.py	1969-12-31 19:00:00
+++ b/parcelo/returns.py	2026-11-12 03:32:05
@@ -0,0 +1,43 @@
+from parcelo import clock, events, ids
+from parcelo.errors import DomainError
+from parcelo.models import ReturnRequest
+from parcelo.settings import MAX_RETURNS_PER_SHIPMENT
+from parcelo.shipments import get_shipment
+from parcelo.store import db
+
+
+def request_return(shipment_id, reason):
+    """File a return request for a delivered shipment.
+
+    Raises E_BAD_INPUT for a blank reason, E_NOT_FOUND for an unknown shipment,
+    E_BAD_STATE if the shipment is not delivered, and E_LIMIT once the shipment
+    already has MAX_RETURNS_PER_SHIPMENT return requests.
+    """
+    if not isinstance(reason, str) or not reason.strip():
+        raise DomainError("E_BAD_INPUT", "reason required")
+    shipment = get_shipment(shipment_id)
+    if shipment.status != "delivered":
+        raise DomainError("E_BAD_STATE", shipment_id)
+    if len(returns_for(shipment_id)) >= MAX_RETURNS_PER_SHIPMENT:
+        raise DomainError("E_LIMIT", shipment_id)
+    request = ReturnRequest(
+        id=ids.new_id("ret"),
+        shipment_id=shipment_id,
+        reason=reason.strip(),
+        requested_at=clock.now(),
+    )
+    db.returns[request.id] = request
+    events.emit("return.requested", request.id, shipment_id=shipment_id)
+    return request
+
+
+def returns_for(shipment_id):
+    """Return the return requests filed for a shipment, sorted by id ascending.
+
+    Raises E_NOT_FOUND if the shipment does not exist.
+    """
+    get_shipment(shipment_id)
+    return sorted(
+        (r for r in db.returns.values() if r.shipment_id == shipment_id),
+        key=lambda r: r.id,
+    )
