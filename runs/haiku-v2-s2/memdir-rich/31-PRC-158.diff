@@ -0,0 +1,131 @@
+import pytest
+
+from parcelo import clock, customers, events, returns, shipments, store
+from parcelo.errors import DomainError
+from parcelo.models import ReturnRequest
+from parcelo.settings import MAX_RETURNS_PER_SHIPMENT
+from parcelo.store import db
+
+
+def delivered_shipment():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 2.0, "national")
+    s.status = "delivered"  # no mark_delivered in this checkout
+    events.OUTBOX.clear()  # drop the shipment.created event from setup
+    return s
+
+
+def test_limit_is_three():
+    assert MAX_RETURNS_PER_SHIPMENT == 3
+
+
+def test_request_return_creates_and_stores_request():
+    events.OUTBOX.clear()
+    clock.set_fixed(clock.now())
+    s = delivered_shipment()
+    r = returns.request_return(s.id, "too small")
+    assert isinstance(r, ReturnRequest)
+    assert r.id.startswith("ret_")
+    assert r.shipment_id == s.id
+    assert r.reason == "too small"
+    assert r.requested_at == clock.now()
+    assert db.returns[r.id] is r
+    assert events.OUTBOX[-1]["name"] == "return.requested"
+    assert events.OUTBOX[-1]["entity_id"] == r.id
+
+
+def test_returns_for_lists_only_that_shipment():
+    s1 = delivered_shipment()
+    s2 = delivered_shipment()
+    a = returns.request_return(s1.id, "a")
+    b = returns.request_return(s2.id, "b")
+    assert returns.returns_for(s1.id) == [a]
+    assert returns.returns_for(s2.id) == [b]
+
+
+def test_returns_for_sorted_by_id_regardless_of_storage_order():
+    s = delivered_shipment()
+    # Insert out of id order to make sure the function sorts rather than relying on dict order.
+    for rid in ("ret_000009", "ret_000002", "ret_000005"):
+        db.returns[rid] = ReturnRequest(id=rid, shipment_id=s.id, reason="x")
+    result = returns.returns_for(s.id)
+    assert [r.id for r in result] == ["ret_000002", "ret_000005", "ret_000009"]
+
+
