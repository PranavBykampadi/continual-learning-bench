+def set_credit_limit(customer_id, amount):
+    """Set a customer's credit limit and return the new limit as Money.
+
+    Order of checks: customer exists (E_NOT_FOUND), then amount parses and is
+    not negative (E_BAD_INPUT). Nothing is changed or emitted on failure.
+    """
+    if customer_id not in db.customers:
+        raise DomainError("E_NOT_FOUND", customer_id)
+    try:
+        limit = Money.parse(amount)
+    except (ArithmeticError, TypeError, ValueError) as exc:
+        raise DomainError("E_BAD_INPUT", f"credit limit: {amount!r}") from exc
+    if limit < Money.zero():
+        raise DomainError("E_BAD_INPUT", f"credit limit is negative: {limit}")
+    customer = db.customers[customer_id]
+    old_limit = customer.credit_limit
+    customer.credit_limit = limit
+    events.emit(
+        "customer.credit_limit_set",
+        customer_id,
+        old_cents=old_limit.cents,
+        new_cents=limit.cents,
+    )
+    return limit
