diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_set_credit_limit.py b/tests/unit/test_set_credit_limit.py
--- a/tests/unit/test_set_credit_limit.py	1969-12-31 19:00:00
+++ b/tests/unit/test_set_credit_limit.py	2026-11-12 03:19:33
@@ -0,0 +1,57 @@
+import pytest
+
+from parcelo import customers, events
+from parcelo.errors import DomainError
+from parcelo.money import Money
+
+
+def test_set_credit_limit_returns_and_stores_new_limit():
+    c = customers.add_customer("Acme")
+    events.OUTBOX.clear()
+    limit = customers.set_credit_limit(c.id, "1250.50")
+    assert limit == Money(125050)
+    assert customers.get_customer(c.id).credit_limit == Money(125050)
+
+
+def test_set_credit_limit_emits_event():
+    c = customers.add_customer("Acme")
+    events.OUTBOX.clear()
+    customers.set_credit_limit(c.id, 75)
+    assert events.OUTBOX[-1]["name"] == "customer.credit_limit_set"
+    assert events.OUTBOX[-1]["entity_id"] == c.id
+    assert events.OUTBOX[-1]["payload"] == dict(old_cents=50000, new_cents=7500)
+
+
+def test_unknown_customer_fails():
+    events.OUTBOX.clear()
+    with pytest.raises(DomainError) as err:
+        customers.set_credit_limit("C_missing", 100)
+    assert err.value.code == "E_NOT_FOUND"
+    assert events.OUTBOX == []
+
+
+@pytest.mark.parametrize("amount", [-0.01, -1, "-5.00", Money(-1)])
+def test_negative_amount_fails(amount):
+    c = customers.add_customer("Acme")
+    events.OUTBOX.clear()
+    with pytest.raises(DomainError) as err:
+        customers.set_credit_limit(c.id, amount)
+    assert err.value.code == "E_BAD_INPUT"
+    assert customers.get_customer(c.id).credit_limit == Money(50000)
+    assert events.OUTBOX == []
+
+
+@pytest.mark.parametrize("amount", [0, "0", 0.0])
+def test_zero_amount_is_allowed(amount):
+    c = customers.add_customer("Acme")
+    assert customers.set_credit_limit(c.id, amount) == Money.zero()
+
+
+@pytest.mark.parametrize("amount", [None, "abc", object()])
+def test_unparseable_amount_fails(amount):
+    c = customers.add_customer("Acme")
+    events.OUTBOX.clear()
+    with pytest.raises(DomainError) as err:
+        customers.set_credit_limit(c.id, amount)
+    assert err.value.code == "E_BAD_INPUT"
+    assert events.OUTBOX == []
