 def open_invoices():
     return [i for i in db.invoices.values() if i.status == "open"]
+
+
+def invoices_by_status(status):
+    """Return the invoices with the given status, sorted by id ascending.
+
+    Raises DomainError (E_BAD_INPUT) if status is not "open" or "paid".
+    Returns an empty list when the status is valid but no invoice has it.
+    """
+    if status not in INVOICE_STATUSES:
+        raise DomainError("E_BAD_INPUT", repr(status))
+    matches = [i for i in db.invoices.values() if i.status == status]
+    return sorted(matches, key=lambda i: i.id)
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_invoices_by_status.py b/tests/unit/test_invoices_by_status.py
--- a/tests/unit/test_invoices_by_status.py	1969-12-31 19:00:00
+++ b/tests/unit/test_invoices_by_status.py	2026-11-12 03:39:39
@@ -0,0 +1,48 @@
+import pytest
+
+from parcelo import customers, invoices, shipments
+from parcelo.errors import DomainError
+from parcelo.store import db
+
+
+def _issue(customer_id):
+    s = shipments.create_shipment(customer_id, 2, "local")
+    return invoices.issue_invoice(s.id)
+
+
+def test_returns_invoices_with_status_sorted_by_id():
+    c = customers.add_customer("Acme")
+    inv_a = _issue(c.id)
+    inv_b = _issue(c.id)
+    inv_c = _issue(c.id)
+    invoices.mark_paid(inv_b.id)
+
+    open_ids = [i.id for i in invoices.invoices_by_status("open")]
+    paid_ids = [i.id for i in invoices.invoices_by_status("paid")]
+
+    assert open_ids == sorted([inv_a.id, inv_c.id])
+    assert paid_ids == [inv_b.id]
+
+
+def test_empty_list_when_valid_status_has_no_matches():
+    c = customers.add_customer("Acme")
+    _issue(c.id)
+    assert invoices.invoices_by_status("paid") == []
+
+
+def test_empty_list_when_no_invoices_exist():
+    assert invoices.invoices_by_status("open") == []
+    assert invoices.invoices_by_status("paid") == []
+
+
+@pytest.mark.parametrize("bad", ["void", None, "", "OPEN", "Paid", " open"])
+def test_unknown_status_raises_bad_input(bad):
+    c = customers.add_customer("Acme")
+    _issue(c.id)
+    before = dict(db.invoices)
+
+    with pytest.raises(DomainError) as err:
+        invoices.invoices_by_status(bad)
+
+    assert err.value.code == "E_BAD_INPUT"
+    assert db.invoices == before
