+from parcelo.legacy.billing import fuel_surcharge
+
 ZONE_BASE = {"local": 4.5, "national": 9.0, "international": 24.0}
 PER_KG = 1.25
 
@@ -12,3 +14,15 @@
     if weight_kg <= 0:
         raise ValueError("weight must be positive")
     return round(base_rate(zone) + PER_KG * weight_kg, 2)
+
+
+def quote_with_surcharge(weight_kg, zone):
+    """Return (quote, fuel_surcharge) for the weight and zone.
+
+    The surcharge is the zone's fuel percentage applied to the quote,
+    using the same percentages as legacy.billing.fuel_surcharge.
+    Unknown zones and non-positive weights raise ValueError (from quote).
+    """
+    base = quote(weight_kg, zone)
+    surcharge = fuel_surcharge(base, zone)
+    return base, surcharge
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_quote_with_surcharge.py b/tests/unit/test_quote_with_surcharge.py
--- a/tests/unit/test_quote_with_surcharge.py	1969-12-31 19:00:00
+++ b/tests/unit/test_quote_with_surcharge.py	2026-11-12 02:50:44
@@ -0,0 +1,29 @@
+import pytest
+
+from parcelo import rates
+
+
+def test_quote_with_surcharge_national():
+    # base quote: 9.0 + 1.25 * 2 = 11.5; 4% surcharge = 0.46
+    assert rates.quote_with_surcharge(2, "national") == (11.5, 0.46)
+
+
+def test_quote_with_surcharge_local_has_no_surcharge():
+    assert rates.quote_with_surcharge(2, "local") == (7.0, 0.0)
+
+
+def test_quote_with_surcharge_international():
+    # base quote: 24.0 + 1.25 * 4 = 29.0; 9.5% surcharge = 2.755, which
+    # fuel_surcharge rounds to 2.75 (float rounding)
+    assert rates.quote_with_surcharge(4, "international") == (29.0, 2.75)
+
+
+def test_unknown_zone_fails():
+    with pytest.raises(ValueError):
+        rates.quote_with_surcharge(2, "moon")
+
+
+@pytest.mark.parametrize("weight", [0, -1])
+def test_non_positive_weight_fails(weight):
+    with pytest.raises(ValueError):
+        rates.quote_with_surcharge(weight, "local")
