+def apply_credit(invoice_id, amount):
+    """Reduce an open invoice by a credit and return the remaining amount as Money.
+
+    Invoice.amount stays a float because revenue_total() and
+    customers.outstanding_balance() sum it directly, so the remaining value is
+    written back as a float rounded to whole cents.
+    """
+    if invoice_id not in db.invoices:
+        raise DomainError("E_NOT_FOUND", invoice_id)
+    invoice = db.invoices[invoice_id]
+    if invoice.status != "open":
+        raise DomainError("E_BAD_STATE", f"{invoice_id} is {invoice.status}")
+    try:
+        credit = Money.parse(amount)
+    except (ArithmeticError, TypeError, ValueError):
+        raise DomainError("E_BAD_INPUT", str(amount))
+    if credit.cents <= 0:
+        raise DomainError("E_BAD_INPUT", str(amount))
+    current = Money.parse(invoice.amount)
+    if current < credit:
+        raise DomainError("E_BAD_INPUT", f"credit {credit} exceeds invoice {current}")
+    remaining = current - credit
+    invoice.amount = remaining.cents / 100
+    audit.record(
+        "invoice.credit_applied",
+        invoice_id,
+        credit_cents=credit.cents,
+        remaining_cents=remaining.cents,
+    )
+    return remaining
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_apply_credit.py b/tests/unit/test_apply_credit.py
--- a/tests/unit/test_apply_credit.py	1969-12-31 19:00:00
+++ b/tests/unit/test_apply_credit.py	2026-11-12 03:03:25
@@ -0,0 +1,85 @@
+import pytest
+
+from parcelo import audit, customers, invoices, reports, shipments
+from parcelo.errors import DomainError
+from parcelo.money import Money
+
+
+def make_open_invoice():
+    # local zone, 2 kg: 4.5 base + 1.25 * 2 = 7.00
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 2, "local")
+    inv = invoices.issue_invoice(s.id)
+    return c, inv
+
+
+def test_partial_credit_reduces_amount_and_returns_remaining():
+    c, inv = make_open_invoice()
+    audit.LOG.clear()
+    remaining = invoices.apply_credit(inv.id, "2.50")
+    assert remaining == Money(450)
+    assert isinstance(remaining, Money)
+    assert inv.amount == 4.5
+    assert inv.status == "open"
+    assert audit.LOG[-1]["action"] == "invoice.credit_applied"
+
+
+def test_credit_equal_to_amount_leaves_zero_and_stays_open():
+    _, inv = make_open_invoice()
+    remaining = invoices.apply_credit(inv.id, Money(700))
+    assert remaining == Money.zero()
+    assert inv.amount == 0.0
+    assert inv.status == "open"
+
+
+def test_customer_balance_reflects_credit():
+    c, inv = make_open_invoice()
+    invoices.apply_credit(inv.id, "2.50")
+    assert customers.outstanding_balance(c.id) == 4.5
+
+
+def test_reports_work_after_credit_is_applied_and_paid():
+    _, inv = make_open_invoice()
+    invoices.apply_credit(inv.id, "2.50")
+    invoices.mark_paid(inv.id)
+    assert reports.revenue_total() == 4.5
+    assert invoices.open_invoices() == []
+
+
+def test_missing_invoice_raises_not_found():
+    with pytest.raises(DomainError) as err:
+        invoices.apply_credit("INV-missing", "1.00")
+    assert err.value.code == "E_NOT_FOUND"
+    assert audit.LOG == []
+
+
+def test_paid_invoice_raises_bad_state_and_is_unchanged():
+    _, inv = make_open_invoice()
+    invoices.mark_paid(inv.id)
+    audit.LOG.clear()
+    with pytest.raises(DomainError) as err:
+        invoices.apply_credit(inv.id, "1.00")
+    assert err.value.code == "E_BAD_STATE"
+    assert inv.amount == 7.0
+    assert audit.LOG == []
+
+
+def test_credit_larger_than_amount_raises_bad_input_and_is_unchanged():
+    _, inv = make_open_invoice()
+    audit.LOG.clear()
+    with pytest.raises(DomainError) as err:
+        invoices.apply_credit(inv.id, "7.01")
+    assert err.value.code == "E_BAD_INPUT"
+    assert inv.amount == 7.0
+    assert audit.LOG == []
+
+
+@pytest.mark.parametrize("bad", [0, "0.00", -1, -2.5, "-0.01", None, "abc"])
+def test_non_positive_or_invalid_credit_raises_bad_input(bad):
+    _, inv = make_open_invoice()
+    audit.LOG.clear()
+    with pytest.raises(DomainError) as err:
+        invoices.apply_credit(inv.id, bad)
+    assert err.value.code == "E_BAD_INPUT"
+    assert inv.amount == 7.0
+    assert audit.LOG == []
