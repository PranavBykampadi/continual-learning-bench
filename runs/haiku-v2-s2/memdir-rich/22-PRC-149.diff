+def split_shipment(shipment_id, weights):
+    """Replace a "created" shipment with one new shipment per weight.
+
+    Checks, in order (nothing is changed unless all pass):
+    missing shipment -> E_NOT_FOUND; status not "created" -> E_BAD_STATE;
+    weights not a non-empty list -> E_BAD_INPUT; any weight not a positive
+    number -> E_BAD_WEIGHT; weights not summing to the original weight -> E_BAD_WEIGHT.
+    The original is marked "split". Returns the new shipments in weight order.
+    """
+    original = get_shipment(shipment_id)
+    if original.status != "created":
+        raise DomainError("E_BAD_STATE", f"{shipment_id} is {original.status}")
+    if not isinstance(weights, (list, tuple)) or len(weights) == 0:
+        raise DomainError("E_BAD_INPUT", "weights must be a non-empty list")
+
+    decimals = []
+    for w in weights:
+        try:
+            d = Decimal(str(w))
+        except (InvalidOperation, TypeError, ValueError):
+            raise DomainError("E_BAD_WEIGHT", str(w))
+        if not d.is_finite() or d <= 0:
+            raise DomainError("E_BAD_WEIGHT", str(w))
+        decimals.append(d)
+
+    if sum(decimals, Decimal(0)) != Decimal(str(original.weight_kg)):
+        raise DomainError("E_BAD_WEIGHT", f"weights do not sum to {original.weight_kg}")
+
+    new_shipments = []
+    for w in weights:
+        new_shipments.append(
+            Shipment(
+                id=ids.new_id("shp"),
+                customer_id=original.customer_id,
+                weight_kg=w,
+                zone=original.zone,
+                created_at=clock.now(),
+            )
+        )
+    for s in new_shipments:
+        db.shipments[s.id] = s
+
+    original.status = "split"
+    events.emit(
+        "shipment.split",
+        original.id,
+        child_ids=[s.id for s in new_shipments],
+    )
+    return new_shipments
