--- a/tests/unit/test_split_shipment.py	1969-12-31 19:00:00
+++ b/tests/unit/test_split_shipment.py	2026-11-12 03:17:34
@@ -0,0 +1,95 @@
+import pytest
+
+from parcelo import customers, events, shipments
+from parcelo.errors import DomainError
+
+
+def _make(weight=4.0, zone="national"):
+    c = customers.add_customer("Acme")
+    return shipments.create_shipment(c.id, weight, zone)
+
+
+def test_split_creates_one_shipment_per_weight_in_order():
+    s = _make(4.0)
+    parts = shipments.split_shipment(s.id, [1.5, 2.5])
+    assert [p.weight_kg for p in parts] == [1.5, 2.5]
+    assert all(p.id.startswith("shp_") for p in parts)
+    assert parts[0].id != parts[1].id
+
+
+def test_split_children_keep_customer_and_zone_and_start_created():
+    s = _make(4.0, "international")
+    parts = shipments.split_shipment(s.id, [1.0, 1.0, 2.0])
+    for p in parts:
+        assert p.customer_id == s.customer_id
+        assert p.zone == "international"
+        assert p.status == "created"
+        assert p.created_at is not None
+
+
+def test_split_marks_original_split_and_stores_children():
+    s = _make(4.0)
+    parts = shipments.split_shipment(s.id, [1.5, 2.5])
+    assert s.status == "split"
+    assert shipments.get_shipment(s.id) is s
+    for p in parts:
+        assert shipments.get_shipment(p.id) is p
+
+
+def test_split_emits_event_with_child_ids():
+    s = _make(4.0)
+    events.OUTBOX.clear()
+    parts = shipments.split_shipment(s.id, [1.5, 2.5])
+    assert events.OUTBOX[-1]["name"] == "shipment.split"
+    assert events.OUTBOX[-1]["entity_id"] == s.id
+    assert events.OUTBOX[-1]["payload"]["child_ids"] == [p.id for p in parts]
+
+
+def test_split_missing_shipment_raises_not_found_and_emits_nothing():
+    events.OUTBOX.clear()
+    with pytest.raises(DomainError) as err:
+        shipments.split_shipment("shp_nope", [1.0])
+    assert err.value.code == "E_NOT_FOUND"
+    assert events.OUTBOX == []
+
+
+@pytest.mark.parametrize("status", ["split", "delivered", "cancelled"])
+def test_split_requires_created_status(status):
+    s = _make(4.0)
+    s.status = status
+    before = len(shipments.db.shipments)
+    events.OUTBOX.clear()
+    with pytest.raises(DomainError) as err:
+        shipments.split_shipment(s.id, [1.5, 2.5])
+    assert err.value.code == "E_BAD_STATE"
+    assert len(shipments.db.shipments) == before
+    assert s.status == status
+    assert events.OUTBOX == []
+
+
+def test_split_weights_must_sum_to_original():
+    s = _make(4.0)
+    before = len(shipments.db.shipments)
+    events.OUTBOX.clear()
+    with pytest.raises(DomainError) as err:
+        shipments.split_shipment(s.id, [1.5, 2.0])
+    assert err.value.code == "E_BAD_WEIGHT"
+    assert s.status == "created"
+    assert len(shipments.db.shipments) == before
+    assert events.OUTBOX == []
+
+
