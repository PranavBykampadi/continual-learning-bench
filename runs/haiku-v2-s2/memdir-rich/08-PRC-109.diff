diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_add_address.py b/tests/unit/test_add_address.py
--- a/tests/unit/test_add_address.py	1969-12-31 19:00:00
+++ b/tests/unit/test_add_address.py	2026-11-12 02:58:42
@@ -0,0 +1,46 @@
+import pytest
+
+from parcelo import audit, customers
+from parcelo.errors import DomainError
+from parcelo.store import db
+
+
+def test_add_address_stores_and_returns_address():
+    c = customers.add_customer("Acme")
+    a = customers.add_address(c.id, "12 High St", "Leeds")
+    assert a.id.startswith("addr_")
+    assert a.customer_id == c.id
+    assert a.line == "12 High St"
+    assert a.city == "Leeds"
+    assert db.addresses[a.id] is a
+    assert audit.LOG[-1]["action"] == "address.added"
+
+
+def test_unknown_customer_fails():
+    with pytest.raises(DomainError) as err:
+        customers.add_address("nope", "12 High St", "Leeds")
+    assert err.value.code == "E_NOT_FOUND"
+    assert db.addresses == {}
+    assert audit.LOG == []
+
+
+@pytest.mark.parametrize("line", ["", "   ", None])
+def test_empty_line_fails(line):
+    c = customers.add_customer("Acme")
+    audit.LOG.clear()
+    with pytest.raises(DomainError) as err:
+        customers.add_address(c.id, line, "Leeds")
+    assert err.value.code == "E_BAD_INPUT"
+    assert db.addresses == {}
+    assert audit.LOG == []
+
+
+@pytest.mark.parametrize("city", ["", "   ", None])
+def test_empty_city_fails(city):
+    c = customers.add_customer("Acme")
+    audit.LOG.clear()
+    with pytest.raises(DomainError) as err:
+        customers.add_address(c.id, "12 High St", city)
+    assert err.value.code == "E_BAD_INPUT"
+    assert db.addresses == {}
+    assert audit.LOG == []
