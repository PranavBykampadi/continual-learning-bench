diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_invoice_write_off.py b/tests/unit/test_invoice_write_off.py
--- a/tests/unit/test_invoice_write_off.py	1969-12-31 19:00:00
+++ b/tests/unit/test_invoice_write_off.py	2026-11-12 03:13:39
@@ -0,0 +1,63 @@
+from datetime import datetime, timezone
+
+import pytest
+
+from parcelo import clock, events
+from parcelo.errors import DomainError
+from parcelo.invoices import write_off
+from parcelo.models import Invoice
+from parcelo.money import Money
+from parcelo.store import db
+
+
+def _add_invoice(invoice_id="INV-test0001", status="open", amount=12.5):
+    invoice = Invoice(id=invoice_id, shipment_id="shp_1", amount=amount, status=status)
+    db.invoices[invoice_id] = invoice
+    return invoice
+
+
+def test_write_off_open_invoice():
+    moment = datetime(2026, 11, 12, 9, 30, tzinfo=timezone.utc)
+    clock.set_fixed(moment)
+    invoice = _add_invoice(amount=12.5)
+    events.OUTBOX.clear()
+
+    result = write_off(invoice.id)
+
+    assert invoice.status == "written_off"
+    assert invoice.written_off_at == moment
+    assert result == Money.parse(12.5)
+    assert result.cents == 1250
+    assert events.OUTBOX[-1]["name"] == "invoice.written_off"
+    assert events.OUTBOX[-1]["entity_id"] == invoice.id
+    assert events.OUTBOX[-1]["payload"] == {"cents": 1250}
+
+
+def test_write_off_unknown_invoice():
+    events.OUTBOX.clear()
+    with pytest.raises(DomainError) as err:
+        write_off("INV-missing")
+    assert err.value.code == "E_NOT_FOUND"
+    assert events.OUTBOX == []
+
+
+@pytest.mark.parametrize("status", ["paid", "written_off"])
+def test_write_off_requires_open_invoice(status):
+    invoice = _add_invoice(status=status)
+    events.OUTBOX.clear()
+    with pytest.raises(DomainError) as err:
+        write_off(invoice.id)
+    assert err.value.code == "E_BAD_STATE"
+    assert invoice.status == status
+    assert invoice.written_off_at is None
+    assert events.OUTBOX == []
+
+
+def test_write_off_twice_fails_second_time():
+    invoice = _add_invoice()
+    write_off(invoice.id)
+    events.OUTBOX.clear()
+    with pytest.raises(DomainError) as err:
+        write_off(invoice.id)
+    assert err.value.code == "E_BAD_STATE"
+    assert events.OUTBOX == []
