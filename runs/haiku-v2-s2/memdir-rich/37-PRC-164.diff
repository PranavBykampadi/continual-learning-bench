diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/parcelo/vouchers.py b/parcelo/vouchers.py
--- a/parcelo/vouchers.py	1969-12-31 19:00:00
+++ b/parcelo/vouchers.py	2026-11-12 03:42:48
@@ -0,0 +1,34 @@
+from parcelo import clock, events, ids
+from parcelo.errors import DomainError
+from parcelo.models import Voucher
+from parcelo.money import Money
+from parcelo.settings import MAX_VOUCHER_AMOUNT
+from parcelo.store import db
+
+
+def issue_voucher(customer_id, amount):
+    """Issue a goodwill voucher to an existing customer and return it.
+
+    Check order: unknown customer -> E_UNKNOWN_CUSTOMER; amount not a valid
+    money value or not above zero -> E_BAD_INPUT; amount above
+    MAX_VOUCHER_AMOUNT -> E_LIMIT. Nothing is stored or emitted on failure.
+    """
+    if customer_id not in db.customers:
+        raise DomainError("E_UNKNOWN_CUSTOMER", customer_id)
+    try:
+        value = Money.parse(amount)
+    except (ArithmeticError, TypeError, ValueError):
+        raise DomainError("E_BAD_INPUT", repr(amount))
+    if value.cents <= 0:
+        raise DomainError("E_BAD_INPUT", str(value))
+    if MAX_VOUCHER_AMOUNT < value:
+        raise DomainError("E_LIMIT", str(value))
+    voucher = Voucher(
+        id=ids.new_id("vch"),
+        customer_id=customer_id,
+        amount=value,
+        issued_at=clock.now(),
+    )
+    db.vouchers[voucher.id] = voucher
+    events.emit("voucher.issued", voucher.id, customer_id=customer_id, cents=value.cents)
+    return voucher
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_vouchers.py b/tests/unit/test_vouchers.py
--- a/tests/unit/test_vouchers.py	1969-12-31 19:00:00
+++ b/tests/unit/test_vouchers.py	2026-11-12 03:42:53
@@ -0,0 +1,71 @@
+import pytest
+
+from parcelo import customers, events, vouchers
+from parcelo.errors import DomainError
+from parcelo.money import Money
+from parcelo.store import db
+
+
+def test_issue_voucher_stores_and_emits():
+    c = customers.add_customer("Acme")
+    events.OUTBOX.clear()
+    v = vouchers.issue_voucher(c.id, "25.00")
+    assert v.id.startswith("vch_")
+    assert v.customer_id == c.id
+    assert v.amount == Money.parse("25.00")
+    assert v.issued_at is not None
+    assert db.vouchers[v.id] is v
+    assert events.OUTBOX[-1]["name"] == "voucher.issued"
+    assert len(events.OUTBOX) == 1
+
+
+def test_unknown_customer():
+    events.OUTBOX.clear()
+    with pytest.raises(DomainError) as err:
+        vouchers.issue_voucher("nope", "10.00")
+    assert err.value.code == "E_UNKNOWN_CUSTOMER"
+    assert db.vouchers == {}
+    assert events.OUTBOX == []
+
+
+@pytest.mark.parametrize("amount", ["0", "0.00", "-0.01", "-5", 0, -5])
+def test_zero_and_negative_rejected(amount):
+    c = customers.add_customer("Acme")
+    events.OUTBOX.clear()
+    with pytest.raises(DomainError) as err:
+        vouchers.issue_voucher(c.id, amount)
+    assert err.value.code == "E_BAD_INPUT"
+    assert db.vouchers == {}
+    assert events.OUTBOX == []
+
+
+@pytest.mark.parametrize("amount", [None, "abc"])
+def test_unparseable_amount_rejected(amount):
+    c = customers.add_customer("Acme")
+    with pytest.raises(DomainError) as err:
+        vouchers.issue_voucher(c.id, amount)
+    assert err.value.code == "E_BAD_INPUT"
+    assert db.vouchers == {}
+
+
+def test_limit_boundary():
+    c = customers.add_customer("Acme")
+    # exactly 150.00 is allowed
+    v = vouchers.issue_voucher(c.id, "150.00")
+    assert v.amount == Money.parse("150.00")
+    # 150.01 is over the limit
+    events.OUTBOX.clear()
+    with pytest.raises(DomainError) as err:
+        vouchers.issue_voucher(c.id, "150.01")
+    assert err.value.code == "E_LIMIT"
+    assert len(db.vouchers) == 1
+    assert events.OUTBOX == []
+
+
+def test