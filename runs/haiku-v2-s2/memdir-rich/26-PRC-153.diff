+
+def needs_review(customer_id):
+    """True when the customer has more than 3 open invoices, or open invoices totalling over 250.00.
+
+    Raises E_UNKNOWN_CUSTOMER for a customer id that does not exist.
+    """
+    if customer_id not in db.customers:
+        raise DomainError("E_UNKNOWN_CUSTOMER", customer_id)
+    open_count = 0
+    open_total = Money.zero()
+    for invoice in db.invoices.values():
+        shipment = db.shipments[invoice.shipment_id]
+        if shipment.customer_id == customer_id and invoice.status == "open":
+            open_count += 1
+            open_total = open_total + Money.parse(invoice.amount)
+    return open_count > MAX_OPEN_INVOICES or MAX_OPEN_TOTAL < open_total
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_needs_review.py b/tests/unit/test_needs_review.py
--- a/tests/unit/test_needs_review.py	1969-12-31 19:00:00
+++ b/tests/unit/test_needs_review.py	2026-11-12 03:23:26
@@ -0,0 +1,89 @@
+import uuid
+
+import pytest
+
+from parcelo import customers
+from parcelo.errors import DomainError
+from parcelo.models import Invoice, Shipment
+from parcelo.store import db
+
+
+def _add_invoice(customer_id, amount, status="open"):
+    shipment = Shipment(
+        id="shp_" + uuid.uuid4().hex[:8], customer_id=customer_id, weight_kg=1.0, zone="local"
+    )
+    db.shipments[shipment.id] = shipment
+    invoice = Invoice(
+        id="INV-" + uuid.uuid4().hex[:8],
+        shipment_id=shipment.id,
+        amount=amount,
+        status=status,
+    )
+    db.invoices[invoice.id] = invoice
+    return invoice
+
+
+def _customer_with_open_amounts(amounts):
+    c = customers.add_customer("Acme")
+    for amount in amounts:
+        _add_invoice(c.id, amount)
+    return c
+
+
+def test_unknown_customer_fails():
+    with pytest.raises(DomainError) as err:
+        customers.needs_review("nope")
+    assert err.value.code == "E_UNKNOWN_CUSTOMER"
+
+
+def test_customer_with_no_invoices_is_not_flagged():
+    c = customers.add_customer("Acme")
+    assert customers.needs_review(c.id) is False
+
+
+@pytest.mark.parametrize(
+    "amounts, expected",
+    [
+        ([10.0, 10.0, 10.0], False),  # 3 open invoices: not more than 3
+        ([1.0, 1.0, 1.0, 1.0], True),  # 4 open invoices: more than 3
+        ([250.0], False),  # total exactly 250.00
+        ([250.01], True),  # total just over 250.00
+        ([100.0, 100.0, 50.01], True),  # total over 250.00 split across invoices
+        ([83.33, 83.33, 83.33], False),  # 249.99 total
+        ([83.34, 83.34, 83.34], True),  # 250.02 total
+        ([80.0, 80.0, 80.0], False),  # 240.00 total, 3 invoices
+    ],
+)
+def test_thresholds(amounts, expected):
+    c = _customer_with_open_amounts(amounts)
+    assert customers.needs_review(c.id) is expected
+
+
+def test_four_small_invoices_flagged_by_count_alone():
+    c = _customer_with_open_amounts([0.01, 0.01, 0.01, 0.01])
+    assert customers.needs_review(c.id) is True
+
+
+def test_paid_invoices_do_not_count_toward_the_count():
+    c = customers.add_customer("Acme")
+    for _ in range(3):
+        _add_invoice(c.id, 10.0)
+    _add_invoice(c.id, 10.0, status="paid")
+    _add_invoice(c.id, 10.0, status="paid")
+    assert customers.needs_review(c.id) is False
+
+
+def test_paid_invoices_do_not_count_toward_the_total():
+    c = customers.add_customer("Acme")
+    _add_invoice(c.id, 200.0)
+    _add_invoice(c.id, 200.0, status="paid")
+    assert customers.needs_review(c.id) is False
+
+
+def test_other_customers_invoices_are_ignored():
+    mine = customers.add_customer("Mine")
+    other = customers.add_customer("Other")
+    for _ in range(5):
+        _add_invoice(other.id, 100.0)
+    assert customers.needs_review(mine.id) is False
+    assert customers.needs_review(other.id) is True
