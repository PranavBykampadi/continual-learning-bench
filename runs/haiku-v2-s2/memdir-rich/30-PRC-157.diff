+++ b/tests/unit/test_invoice_hold.py	2026-11-12 03:30:03
@@ -0,0 +1,64 @@
+from datetime import datetime, timezone
+
+import pytest
+
+from parcelo import clock, customers, events, invoices, shipments
+from parcelo.errors import DomainError
+
+
+def _open_invoice():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 2, "local")
+    return invoices.issue_invoice(s.id)
+
+
+def test_hold_open_invoice():
+    moment = datetime(2026, 11, 12, 9, 30, tzinfo=timezone.utc)
+    clock.set_fixed(moment)
+    inv = _open_invoice()
+    events.OUTBOX.clear()
+
+    result = invoices.hold_invoice(inv.id)
+
+    assert result is inv
+    assert inv.status == "on_hold"
+    assert inv.held_at == moment
+    assert len(events.OUTBOX) == 1
+    assert events.OUTBOX[-1]["name"] == "invoice.held"
+    assert events.OUTBOX[-1]["entity_id"] == inv.id
+
+
+def test_hold_twice_is_noop_and_emits_once():
+    first = datetime(2026, 11, 12, 9, 30, tzinfo=timezone.utc)
+    clock.set_fixed(first)
+    inv = _open_invoice()
+    events.OUTBOX.clear()
+
+    invoices.hold_invoice(inv.id)
+    clock.set_fixed(datetime(2026, 11, 13, 9, 30, tzinfo=timezone.utc))
+    second = invoices.hold_invoice(inv.id)
+
+    assert second is inv
+    assert inv.status == "on_hold"
+    assert inv.held_at == first
+    assert len(events.OUTBOX) == 1
+
+
+def test_hold_unknown_invoice():
+    with pytest.raises(DomainError) as err:
+        invoices.hold_invoice("INV-missing")
+    assert err.value.code == "E_NOT_FOUND"
+    assert events.OUTBOX == []
+
+
+def test_hold_paid_invoice_fails():
+    inv = _open_invoice()
+    invoices.mark_paid(inv.id)
+    events.OUTBOX.clear()
+
+    with pytest.raises(DomainError) as err:
+        invoices.hold_invoice(inv.id)
+    assert err.value.code == "E_BAD_STATE"
+    assert inv.status == "paid"
+    assert inv.held_at is None
+    assert events.OUTBOX == []
