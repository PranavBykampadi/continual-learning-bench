 def open_invoices():
     return [i for i in db.invoices.values() if i.status == "open"]
+
+
+def hold_invoice(invoice_id):
+    """Pause collection on an invoice: status becomes "on_hold" and held_at is set.
+
+    Check order: missing id -> E_NOT_FOUND; already on_hold -> return the invoice
+    unchanged (no write, no event, so retries are safe); status other than open
+    -> E_BAD_STATE; otherwise write and emit "invoice.held" once.
+    """
+    if invoice_id not in db.invoices:
+        raise DomainError("E_NOT_FOUND", invoice_id)
+    invoice = db.invoices[invoice_id]
+    if invoice.status == "on_hold":
+        return invoice
+    if invoice.status != "open":
+        raise DomainError("E_BAD_STATE", f"{invoice_id} is {invoice.status}")
+    invoice.status = "on_hold"
+    invoice.held_at = clock.now()
+    events.emit("invoice.held", invoice_id)
+    return invoice
