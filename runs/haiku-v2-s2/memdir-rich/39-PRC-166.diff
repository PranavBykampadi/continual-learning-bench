@@ -0,0 +1,6 @@
+from parcelo.money import Money
+
+# Business thresholds. Finance owns these; keep them here, not in the module that uses them.
+
+# Open invoices at or above this amount can be escalated to the collections team.
+ESCALATION_MIN_AMOUNT = Money(50000)  # 500.00 USD
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_escalate_invoice.py b/tests/unit/test_escalate_invoice.py
--- a/tests/unit/test_escalate_invoice.py	1969-12-31 19:00:00
+++ b/tests/unit/test_escalate_invoice.py	2026-11-12 03:46:32
@@ -0,0 +1,68 @@
+import pytest
+
+from parcelo import events, invoices
+from parcelo.errors import DomainError
+from parcelo.models import Invoice
+from parcelo.store import db
+
+
+def _add_invoice(invoice_id, amount, status="open"):
+    inv = Invoice(id=invoice_id, shipment_id="shp_x", amount=amount, status=status)
+    db.invoices[invoice_id] = inv
+    return inv
+
+
+def test_escalates_open_invoice_at_threshold():
+    _add_invoice("INV-1", 500.0)
+    inv = invoices.escalate_invoice("INV-1")
+    assert inv.status == "escalated"
+    assert db.invoices["INV-1"].status == "escalated"
+
+
+def test_escalates_open_invoice_above_threshold_and_emits_once():
+    _add_invoice("INV-2", 1234.56)
+    events.OUTBOX.clear()
+    inv = invoices.escalate_invoice("INV-2")
+    assert inv.status == "escalated"
+    assert len(events.OUTBOX) == 1
+    assert events.OUTBOX[-1]["name"] == "invoice.escalated"
+    assert events.OUTBOX[-1]["entity_id"] == "INV-2"
+    assert events.OUTBOX[-1]["payload"] == {"cents": 123456}
+
+
+def test_below_threshold_fails_and_emits_nothing():
+    _add_invoice("INV-3", 499.99)
+    events.OUTBOX.clear()
+    with pytest.raises(DomainError) as err:
+        invoices.escalate_invoice("INV-3")
+    assert err.value.code == "E_BAD_STATE"
+    assert db.invoices["INV-3"].status == "open"
+    assert events.OUTBOX == []
+
+
+def test_missing_invoice_fails():
+    events.OUTBOX.clear()
+    with pytest.raises(DomainError) as err:
+        invoices.escalate_invoice("INV-nope")
+    assert err.value.code == "E_NOT_FOUND"
+    assert events.OUTBOX == []
+
+
+def test_paid_invoice_fails_and_emits_nothing():
+    _add_invoice("INV-4", 900.0, status="paid")
+    events.OUTBOX.clear()
+    with pytest.raises(DomainError) as err:
+        invoices.escalate_invoice("INV-4")
+    assert err.value.code == "E_BAD_STATE"
+    assert db.invoices["INV-4"].status == "paid"
+    assert events.OUTBOX == []
+
+
+def test_repeat_call_is_a_no_op():
+    _add_invoice("INV-5", 800.0)
+    events.OUTBOX.clear()
+    first = invoices.escalate_invoice("INV-5")
+    second = invoices.escalate_invoice("INV-5")
+    assert second is first
+    assert second.status == "escalated"
+    assert len(events.OUTBOX) == 1
