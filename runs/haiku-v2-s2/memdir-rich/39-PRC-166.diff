+def escalate_invoice(invoice_id):
+    """Send an open invoice of at least ESCALATION_MIN_AMOUNT to collections.
+
+    Check order: missing -> E_NOT_FOUND; already escalated -> returned unchanged
+    (no write, no event, so a retry is safe); not open -> E_BAD_STATE; amount
+    below ESCALATION_MIN_AMOUNT (500.00, inclusive) -> E_BAD_STATE. Otherwise sets
+    status to "escalated", emits invoice.escalated once, and returns the invoice.
+    """
+    if invoice_id not in db.invoices:
+        raise DomainError("E_NOT_FOUND", invoice_id)
+    invoice = db.invoices[invoice_id]
+    if invoice.status == "escalated":
+        return invoice
+    if invoice.status != "open":
+        raise DomainError("E_BAD_STATE", f"{invoice_id} is {invoice.status}")
+    amount = Money.parse(invoice.amount)
+    if amount < ESCALATION_MIN_AMOUNT:
+        raise DomainError(
+            "E_BAD_STATE",
+            f"{invoice_id} is {amount}, below {ESCALATION_MIN_AMOUNT}",
+        )
+    invoice.status = "escalated"
+    events.emit("invoice.escalated", invoice_id, cents=amount.cents)
+    return invoice
