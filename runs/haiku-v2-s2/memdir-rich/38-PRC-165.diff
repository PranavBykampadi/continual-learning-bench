+def shipments_without_invoice():
+    """Shipments that no invoice refers to, sorted by id ascending.
+
+    An invoice refers to a shipment through its ``shipment_id``. Invoices of
+    every status count, so a shipment with a paid, open or written-off invoice
+    is not returned.
+    """
+    invoiced = {i.shipment_id for i in db.invoices.values()}
+    return sorted(
+        (s for s in db.shipments.values() if s.id not in invoiced),
+        key=lambda s: s.id,
+    )
+
