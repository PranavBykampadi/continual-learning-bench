diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_disputes.py b/tests/unit/test_disputes.py
--- a/tests/unit/test_disputes.py	1969-12-31 19:00:00
+++ b/tests/unit/test_disputes.py	2026-11-12 03:16:14
@@ -0,0 +1,101 @@
+from datetime import datetime, timezone
+
+import pytest
+
+from parcelo import clock, events
+from parcelo.disputes import open_dispute
+from parcelo.errors import DomainError
+from parcelo.models import Dispute, Invoice
+from parcelo.store import db
+
+FIXED = datetime(2026, 11, 12, 9, 30, tzinfo=timezone.utc)
+
+
+def _invoice(invoice_id="INV-1"):
+    inv = Invoice(id=invoice_id, shipment_id="SHP-1", amount=12.5)
+    db.invoices[inv.id] = inv
+    return inv
+
+
+def test_open_dispute_creates_and_stores_record():
+    clock.set_fixed(FIXED)
+    _invoice()
+    events.OUTBOX.clear()
+
+    d = open_dispute("INV-1", "Wrong weight charged")
+
+    assert isinstance(d, Dispute)
+    assert d.id.startswith("dsp_")
+    assert d.invoice_id == "INV-1"
+    assert d.reason == "Wrong weight charged"
+    assert d.opened_at == FIXED
+    assert db.disputes[d.id] is d
+
+
+def test_open_dispute_emits_event():
+    _invoice()
+    events.OUTBOX.clear()
+
+    d = open_dispute("INV-1", "Duplicate charge")
+
+    assert events.OUTBOX[-1]["name"] == "dispute.opened"
+    assert events.OUTBOX[-1]["entity_id"] == d.id
+    assert events.OUTBOX[-1]["payload"] == {"invoice_id": "INV-1"}
+
+
+def test_each_dispute_gets_a_new_id():
+    _invoice()
+    a = open_dispute("INV-1", "first")
+    b = open_dispute("INV-1", "second")
+
+    assert a.id != b.id
+    assert len(db.disputes) == 2
+
+
+def test_reason_is_stored_stripped():
+    _invoice()
+
+    d = open_dispute("INV-1", "  late delivery  ")
+
+    assert d.reason == "late delivery"
+
+
+def test_missing_invoice_raises_not_found():
+    events.OUTBOX.clear()
+
+    with pytest.raises(DomainError) as err:
+        open_dispute("INV-NOPE", "anything")
+
+    assert err.value.code == "E_NOT_FOUND"
+    assert db.disputes == {}
+    assert events.OUTBOX == []
+
+
+@pytest.mark.parametrize("reason", ["", "   ", "\t\n", None, 42])
+def test_empty_or_non_string_reason_raises_bad_input(reason):
+    _invoice()
+    events.OUTBOX.clear()
+
+    with pytest.raises(DomainError) as err:
+        open_dispute("INV-1", reason)
+
+    assert err.value.code == "E_BAD_INPUT"
+    assert db.disputes == {}
+    assert events.OUTBOX == []
+
+
+def test_missing_invoice_wins_over_bad_reason():
+    with pytest.raises(DomainError) as err:
+        open_dispute("INV-NOPE", "")
+
+    assert err.value.code == "E_NOT_FOUND"
+
+
+def test_reset_clears_disputes():
+    from parcelo import store
+
+    _invoice()
+    open_dispute("INV-1", "x")
+    store.reset()
+
+    assert db.disputes == {}
