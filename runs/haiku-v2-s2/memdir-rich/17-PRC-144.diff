+from decimal import Decimal
+
+from parcelo.errors import DomainError
+from parcelo.money import Money
+
 ZONE_BASE = {"local": 4.5, "national": 9.0, "international": 24.0}
 PER_KG = 1.25
 
+# Same percentages as legacy/billing.py fuel_surcharge (reimplemented; do not import legacy).
+FUEL_SURCHARGE_PCT = {
+    "local": Decimal("0.0"),
+    "national": Decimal("4.0"),
+    "international": Decimal("9.5"),
+}
+INSURANCE_PCT = Decimal("2.0")
+INSURANCE_MIN = Money(100)  # 1.00
 
+
 def base_rate(zone):
     if zone not in ZONE_BASE:
         raise ValueError("unknown zone: %s" % zone)
@@ -12,3 +26,20 @@
     if weight_kg <= 0:
         raise ValueError("weight must be positive")
     return round(base_rate(zone) + PER_KG * weight_kg, 2)
+
+
+def insurance_fee(declared_value, zone):
+    """Insurance fee: (2% + zone fuel surcharge %) of declared value, minimum 1.00."""
+    if zone not in FUEL_SURCHARGE_PCT:
+        raise DomainError("E_BAD_ZONE", str(zone))
+    try:
+        value = Money.parse(declared_value)
+    except (ArithmeticError, TypeError, ValueError):
+        raise DomainError("E_BAD_INPUT", str(declared_value))
+    if value.cents <= 0:
+        raise DomainError("E_BAD_INPUT", "declared value must be positive")
+    total_pct = INSURANCE_PCT + FUEL_SURCHARGE_PCT[zone]
+    fee = value.scale(total_pct / Decimal("100"))
+    if fee.cents < INSURANCE_MIN.cents:
+        return INSURANCE_MIN
+    return fee
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_insurance_fee.py b/tests/unit/test_insurance_fee.py
--- a/tests/unit/test_insurance_fee.py	1969-12-31 19:00:00
+++ b/tests/unit/test_insurance_fee.py	2026-11-12 03:10:44
@@ -0,0 +1,68 @@
+import pytest
+
+from parcelo import events, rates
+from parcelo.errors import DomainError
+from parcelo.money import Money
+
+
+@pytest.mark.parametrize(
+    "zone, value, expected_cents",
+    [
+        ("local", 100, 200),          # 2% + 0%   of 100.00 = 2.00
+        ("national", 100, 600),       # 2% + 4%   of 100.00 = 6.00
+        ("international", 100, 1150),  # 2% + 9.5% of 100.00 = 11.50
+        ("national", 33.33, 200),     # 6% of 33.33 = 1.9998 -> 2.00
+        ("local", 60, 120),           # 2% of 60.00 = 1.20 (above minimum)
+    ],
+)
+def test_fee_is_percentage_of_declared_value(zone, value, expected_cents):
+    fee = rates.insurance_fee(value, zone)
+    assert isinstance(fee, Money)
+    assert fee == Money(expected_cents)
+
+
+@pytest.mark.parametrize(
+    "zone, value",
+    [
+        ("local", 10),         # 0.20 -> minimum
+        ("local", 49.99),      # 0.9998 -> minimum
+        ("international", 8),  # 0.92 -> minimum
+    ],
+)
+def test_minimum_fee_is_one_dollar(zone, value):
+    assert rates.insurance_fee(value, zone) == Money(100)
+
+
+def test_fee_exactly_at_minimum_is_one_dollar():
+    # 2% of 50.00 is exactly 1.00, so the minimum and the formula agree.
+    assert rates.insurance_fee(50, "local") == Money(100)
+
+
+def test_money_input_accepted():
+    assert rates.insurance_fee(Money(10000), "national") == Money(600)
+
+
+def test_unknown_zone_fails():
+    with pytest.raises(DomainError) as err:
+        rates.insurance_fee(100, "moon")
+    assert err.value.code == "E_BAD_ZONE"
+
+
+@pytest.mark.parametrize("value", [0, 0.0, -1, -0.01, "-5", None, "abc"])
+def test_bad_declared_value_fails(value):
+    with pytest.raises(DomainError) as err:
+        rates.insurance_fee(value, "local")
+    assert err.value.code == "E_BAD_INPUT"
+
+
+def test_zone_checked_before_value():
+    with pytest.raises(DomainError) as err:
+        rates.insurance_fee(0, "moon")
+    assert err.value.code == "E_BAD_ZONE"
+
+
+def test_no_event_emitted():
+    # Pure calculation: nothing is stored, so no mutation event.
+    events.OUTBOX.clear()
+    rates.insurance_fee(100, "local")
+    assert events.OUTBOX == []
