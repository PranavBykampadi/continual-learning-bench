@@ -0,0 +1,69 @@
+from parcelo import customers, shipments
+from parcelo.models import Invoice
+from parcelo.money import Money
+from parcelo.reports import outstanding_by_customer
+from parcelo.store import db
+
+
+def _invoice(invoice_id, shipment, amount, status):
+    invoice = Invoice(
+        id=invoice_id,
+        shipment_id=shipment.id,
+        amount=amount,
+        status=status,
+    )
+    db.invoices[invoice.id] = invoice
+    return invoice
+
+
+def test_sums_open_invoices_per_customer():
+    a = customers.add_customer("Acme")
+    b = customers.add_customer("Beta")
+    sa = shipments.create_shipment(a.id, 1.0, "local")
+    sb = shipments.create_shipment(b.id, 2.0, "national")
+    _invoice("INV-1", sa, 10.50, "open")
+    _invoice("INV-2", sa, 4.25, "open")
+    _invoice("INV-3", sb, 7.00, "open")
+
+    result = outstanding_by_customer()
+
+    assert result[a.id] == Money.parse("14.75")
+    assert result[b.id] == Money.parse("7.00")
+
+
+def test_paid_and_void_invoices_are_excluded():
+    a = customers.add_customer("Acme")
+    s = shipments.create_shipment(a.id, 1.0, "local")
+    _invoice("INV-1", s, 10.00, "open")
+    _invoice("INV-2", s, 99.00, "paid")
+    _invoice("INV-3", s, 50.00, "void")
+
+    result = outstanding_by_customer()
+
+    assert result[a.id] == Money.parse("10.00")
+
+
+def test_customer_with_no_open_invoices_maps_to_zero():
+    a = customers.add_customer("Acme")
+    s = shipments.create_shipment(a.id, 1.0, "local")
+    _invoice("INV-1", s, 20.00, "paid")
+
+    result = outstanding_by_customer()
+
+    assert result[a.id] == Money.zero()
+
+
+def test_every_customer_is_present_and_values_are_money():
+    a = customers.add_customer("Acme")
+    b = customers.add_customer("Beta")
+    s = shipments.create_shipment(a.id, 1.0, "local")
+    _invoice("INV-1", s, 3.30, "open")
+
+    result = outstanding_by_customer()
+
+    assert set(result) == {a.id, b.id}
+    assert all(isinstance(v, Money) for v in result.values())
+
+
+def test_empty_store_returns_empty_dict():
+    assert outstanding_by_customer() == {}
