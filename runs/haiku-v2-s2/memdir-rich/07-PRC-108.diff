+from parcelo.money import Money
 from parcelo.store import db
+
+
+def outstanding_by_customer():
+    """Map every customer id to the total of their open invoices, as Money.
+
+    Only invoices with status "open" count; paid and void invoices are ignored.
+    Customers with no open invoices map to Money.zero().
+    """
+    totals = {customer_id: Money.zero() for customer_id in db.customers}
+    for invoice in db.invoices.values():
+        if invoice.status != "open":
+            continue
+        customer_id = db.shipments[invoice.shipment_id].customer_id
+        current = totals.get(customer_id, Money.zero())
+        totals[customer_id] = current + Money.parse(invoice.amount)
+    return totals
 
 
