+++ b/tests/unit/test_discounted_quote.py	2026-11-12 02:59:45
@@ -0,0 +1,57 @@
+import pytest
+
+from parcelo import rates
+from parcelo.errors import DomainError
+from parcelo.money import Money
+
+
+def test_gold_local_gets_ten_percent_off():
+    # quote(2, "local") == 7.0 -> 6.30
+    assert rates.discounted_quote(2, "local", "gold") == Money(630)
+
+
+def test_gold_national():
+    # quote(4, "national") == 14.0 -> 12.60
+    assert rates.discounted_quote(4, "national", "gold") == Money(1260)
+
+
+def test_gold_international():
+    # quote(4, "international") == 29.0 -> 26.10
+    assert rates.discounted_quote(4, "international", "gold") == Money(2610)
+
+
+def test_standard_has_no_discount():
+    assert rates.discounted_quote(2, "local", "standard") == Money(700)
+
+
+@pytest.mark.parametrize("zone", ["local", "national", "international"])
+@pytest.mark.parametrize("weight", [1, 2.5, 10])
+def test_standard_matches_regular_quote(zone, weight):
+    expected = Money.parse(rates.quote(weight, zone))
+    assert rates.discounted_quote(weight, zone, "standard") == expected
+
+
+def test_returns_money():
+    result = rates.discounted_quote(2, "local", "gold")
+    assert isinstance(result, Money)
+
+
+@pytest.mark.parametrize("tier", ["gold", "standard"])
+def test_unknown_zone_fails(tier):
+    with pytest.raises(DomainError) as err:
+        rates.discounted_quote(2, "moon", tier)
+    assert err.value.code == "E_BAD_ZONE"
+
+
+@pytest.mark.parametrize("tier", ["platinum", "", "Gold", None])
+def test_unknown_tier_fails(tier):
+    with pytest.raises(DomainError) as err:
+        rates.discounted_quote(2, "local", tier)
+    assert err.value.code == "E_BAD_INPUT"
+
+
+@pytest.mark.parametrize("weight", [0, -1, -2.5])
+def test_non_positive_weight_fails(weight):
+    with pytest.raises(DomainError) as err:
+        rates.discounted_quote(weight, "local", "gold")
+    assert err.value.code == "E_BAD_WEIGHT"
