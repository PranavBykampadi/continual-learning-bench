+def rebate_for(customer_id):
+    """Volume rebate earned by a customer, as Money.
+
+    REBATE_RATE of the total of the customer's paid invoices once they have
+    REBATE_MIN_SHIPMENTS or more shipments, REBATE_BULK_RATE from
+    REBATE_BULK_SHIPMENTS on. Zero below REBATE_MIN_SHIPMENTS.
+    Rounded once, on the total. Read-only: no event.
+    Raises DomainError E_UNKNOWN_CUSTOMER for an unknown customer.
+    """
+    if customer_id not in db.customers:
+        raise DomainError("E_UNKNOWN_CUSTOMER", customer_id)
+    shipment_count = sum(1 for s in db.shipments.values() if s.customer_id == customer_id)
+    if shipment_count >= REBATE_BULK_SHIPMENTS:
+        rate = REBATE_BULK_RATE
+    elif shipment_count >= REBATE_MIN_SHIPMENTS:
+        rate = REBATE_RATE
+    else:
+        return Money.zero()
+    paid_total = Money.zero()
+    for invoice in db.invoices.values():
+        shipment = db.shipments[invoice.shipment_id]
+        if shipment.customer_id == customer_id and invoice.status == "paid":
+            paid_total = paid_total + Money.parse(invoice.amount)
+    return paid_total.scale(rate)
