+import pytest
+
+from parcelo import customers, events
+from parcelo.errors import DomainError
+from parcelo.models import Invoice, Shipment
+from parcelo.money import Money
+from parcelo.store import db
+
+
+def _customer(shipments, paid=(), open_=()):
+    """Customer with `shipments` shipments; one paid invoice per amount in `paid`
+    (dollars) and one open invoice per amount in `open_`, all on the first shipment."""
+    c = customers.add_customer("Acme")
+    ids = []
+    for i in range(shipments):
+        sid = f"shp_{i}"
+        db.shipments[sid] = Shipment(id=sid, customer_id=c.id, weight_kg=1, zone="local")
+        ids.append(sid)
+    n = 0
+    for amount in paid:
+        n += 1
+        iid = f"INV-p{n}"
+        db.invoices[iid] = Invoice(id=iid, shipment_id=ids[0], amount=amount, status="paid")
+    for amount in open_:
+        n += 1
+        iid = f"INV-o{n}"
+        db.invoices[iid] = Invoice(id=iid, shipment_id=ids[0], amount=amount, status="open")
+    events.OUTBOX.clear()
+    return c
+
+
+def test_zero_with_no_shipments():
+    c = _customer(0)
+    assert customers.rebate_for(c.id) == Money.zero()
+
+
+@pytest.mark.parametrize("count", [1, 9])
+def test_zero_under_ten_shipments(count):
+    c = _customer(count, paid=[100.00])
+    assert customers.rebate_for(c.id) == Money.zero()
+
+
+def test_three_percent_at_ten_shipments():
+    c = _customer(10, paid=[100.00])
+    assert customers.rebate_for(c.id) == Money(300)
+
+
+def test_three_percent_just_under_fifty():
+    c = _customer(49, paid=[100.00])
+    assert customers.rebate_for(c.id) == Money(300)
+
+
+def test_six_percent_at_fifty_shipments():
+    c = _customer(50, paid=[100.00])
+    assert customers.rebate_for(c.id) == Money(600)
+
+
+def test_six_percent_above_fifty():
+    c = _customer(51, paid=[100.00])
+    assert customers.rebate_for(c.id) == Money(600)
+
+
+def test_totals_all_paid_invoices():
+    c = _customer(10, paid=[40.00, 60.00])
+    assert customers.rebate_for(c.id) == Money(300)
+
+
+def test_open_invoices_do_not_count():
+    c = _customer(10, paid=[100.00], open_=[500.00])
+    assert customers.rebate_for(c.id) == Money(300)
+
+
+def test_rounds_half_up_once_on_total():
+    # 10.01 * 3% = 0.3003 -> 0.30
+    c = _customer(10, paid=[10.01])
+    assert customers.rebate_for(c.id) == Money(30)
+
+
+def test_returns_money_not_float():
+    c = _customer(10, paid=[100.00])
+    assert isinstance(customers.rebate_for(c.id), Money)
+
+
