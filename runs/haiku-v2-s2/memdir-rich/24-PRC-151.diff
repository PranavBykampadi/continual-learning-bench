@@ -28,3 +28,14 @@
     if shipment_id not in db.shipments:
         raise DomainError("E_NOT_FOUND", shipment_id)
     return db.shipments[shipment_id]
+
+
+def list_shipments(customer_id):
+    """Return every shipment for a customer, in creation order.
+
+    Unknown customer -> E_NOT_FOUND. A known customer with no shipments
+    gets an empty list. Read-only, so no event is emitted.
+    """
+    if customer_id not in db.customers:
+        raise DomainError("E_NOT_FOUND", customer_id)
+    return [s for s in db.shipments.values() if s.customer_id == customer_id]
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_list_shipments.py b/tests/unit/test_list_shipments.py
--- a/tests/unit/test_list_shipments.py	1969-12-31 19:00:00
+++ b/tests/unit/test_list_shipments.py	2026-11-12 03:20:48
@@ -0,0 +1,40 @@
+import pytest
+
+from parcelo import customers, events, shipments
+from parcelo.errors import DomainError
+
+
+def test_returns_only_that_customers_shipments():
+    a = customers.add_customer("Acme")
+    b = customers.add_customer("Globex")
+    s1 = shipments.create_shipment(a.id, 1.5, "national")
+    s2 = shipments.create_shipment(a.id, 2.0, "national")
+    other = shipments.create_shipment(b.id, 3.0, "national")
+
+    result = shipments.list_shipments(a.id)
+
+    assert result == [s1, s2]
+    assert other not in result
+
+
+def test_customer_with_no_shipments_gets_empty_list():
+    c = customers.add_customer("Quiet Co")
+    shipments.create_shipment(customers.add_customer("Busy").id, 1.0, "national")
+
+    assert shipments.list_shipments(c.id) == []
+
+
+def test_unknown_customer_raises_not_found():
+    with pytest.raises(DomainError) as err:
+        shipments.list_shipments("C_missing")
+    assert err.value.code == "E_NOT_FOUND"
+
+
+def test_read_only_emits_no_event():
+    c = customers.add_customer("Acme")
+    shipments.create_shipment(c.id, 1.5, "national")
+    events.OUTBOX.clear()
+
+    shipments.list_shipments(c.id)
+
+    assert events.OUTBOX == []
