diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/parcelo/shipments.py b/parcelo/shipments.py
--- a/parcelo/shipments.py	2026-11-10 12:20:18
+++ b/parcelo/shipments.py	2026-11-12 03:35:30
@@ -28,3 +28,22 @@
     if shipment_id not in db.shipments:
         raise DomainError("E_NOT_FOUND", shipment_id)
     return db.shipments[shipment_id]
+
+
+def mark_returned(shipment_id):
+    """Mark a delivered shipment as returned to the depot.
+
+    Check order: missing id -> E_NOT_FOUND; already returned -> return the
+    shipment unchanged (no write, no event, so retries are safe); status not
+    "delivered" (e.g. "created") -> E_BAD_STATE; otherwise set status,
+    returned_at and emit "shipment.returned" once.
+    """
+    shipment = get_shipment(shipment_id)
+    if shipment.status == "returned":
+        return shipment
+    if shipment.status != "delivered":
+        raise DomainError("E_BAD_STATE", f"{shipment_id} is {shipment.status}")
+    shipment.status = "returned"
+    shipment.returned_at = clock.now()
+    events.emit("shipment.returned", shipment.id)
+    return shipment
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_mark_returned.py b/tests/unit/test_mark_returned.py
--- a/tests/unit/test_mark_returned.py	1969-12-31 19:00:00
+++ b/tests/unit/test_mark_returned.py	2026-11-12 03:35:35
@@ -0,0 +1,61 @@
+from datetime import datetime, timezone
+
+import pytest
+
+from parcelo import clock, customers, events, shipments
+from parcelo.errors import DomainError
+
+FIXED = datetime(2026, 11, 12, 9, 30, tzinfo=timezone.utc)
+
+
+def _delivered_shipment():
+    # There is no mark_delivered in this checkout, so set the status by hand.
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 1.5, "national")
+    s.status = "delivered"
+    events.OUTBOX.clear()
+    return s
+
+
+def test_marks_delivered_shipment_returned():
+    clock.set_fixed(FIXED)
+    s = _delivered_shipment()
+    result = shipments.mark_returned(s.id)
+    assert result is s
+    assert s.status == "returned"
+    assert s.returned_at == FIXED
+    assert len(events.OUTBOX) == 1
+    assert events.OUTBOX[-1]["name"] == "shipment.returned"
+    assert events.OUTBOX[-1]["entity_id"] == s.id
+
+
+def test_created_shipment_cannot_be_returned():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 1.5, "local")
+    events.OUTBOX.clear()
+    with pytest.raises(DomainError) as err:
+        shipments.mark_returned(s.id)
+    assert err.value.code == "E_BAD_STATE"
+    assert s.status == "created"
+    assert s.returned_at is None
+    assert events.OUTBOX == []
+
+
+def test_unknown_shipment():
+    with pytest.raises(DomainError) as err:
+        shipments.mark_returned("shp_missing")
+    assert err.value.code == "E_NOT_FOUND"
+    assert events.OUTBOX == []
+
+
+def test_repeat_call_is_a_no_op():
+    clock.set_fixed(FIXED)
+    s = _delivered_shipment()
+    shipments.mark_returned(s.id)
+    later = datetime(2026, 11, 13, 8, 0, tzinfo=timezone.utc)
+    clock.set_fixed(later)
+    again = shipments.mark_returned(s.id)
+    assert again is s
+    assert s.status == "returned"
+    assert s.returned_at == FIXED
+    assert len(events.OUTBOX) == 1
