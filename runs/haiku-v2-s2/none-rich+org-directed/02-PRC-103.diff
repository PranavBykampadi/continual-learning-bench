 import pytest
 
 from parcelo import rates
+from parcelo.errors import DomainError
+from parcelo.money import Money
 
 
 def test_quote_local():
@@ -10,3 +12,39 @@
 def test_unknown_zone():
     with pytest.raises(ValueError):
         rates.base_rate("moon")
+
+
+def test_quote_with_surcharge_local_has_no_surcharge():
+    result = rates.quote_with_surcharge(2, "local")
+    assert result["quote"] == Money(700)
+    assert result["surcharge"] == Money(0)
+    assert result["total"] == Money(700)
+
+
+def test_quote_with_surcharge_national():
+    # quote 11.50, 4% surcharge 0.46
+    result = rates.quote_with_surcharge(2, "national")
+    assert result["quote"] == Money(1150)
+    assert result["surcharge"] == Money(46)
+    assert result["total"] == Money(1196)
+
+
+def test_quote_with_surcharge_international():
+    # quote 26.50, 9.5% surcharge 2.5175 rounds to 2.52
+    result = rates.quote_with_surcharge(2, "international")
+    assert result["quote"] == Money(2650)
+    assert result["surcharge"] == Money(252)
+    assert result["total"] == Money(2902)
+
+
+def test_quote_with_surcharge_unknown_zone():
+    with pytest.raises(DomainError) as exc:
+        rates.quote_with_surcharge(2, "moon")
+    assert exc.value.code == "E_BAD_ZONE"
+
+
+@pytest.mark.parametrize("weight", [0, -1, -0.5])
+def test_quote_with_surcharge_bad_weight(weight):
+    with pytest.raises(DomainError) as exc:
+        rates.quote_with_surcharge(weight, "national")
+    assert exc.value.code == "E_BAD_WEIGHT"
