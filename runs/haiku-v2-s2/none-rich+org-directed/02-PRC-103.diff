+from parcelo.errors import DomainError
+from parcelo.legacy.billing import fuel_surcharge
+from parcelo.money import Money
+
 ZONE_BASE = {"local": 4.5, "national": 9.0, "international": 24.0}
 PER_KG = 1.25
 
@@ -12,3 +16,30 @@
     if weight_kg <= 0:
         raise ValueError("weight must be positive")
     return round(base_rate(zone) + PER_KG * weight_kg, 2)
+
+
+def quote_with_surcharge(weight_kg, zone):
+    """Quote a shipment and add the fuel surcharge for its zone.
+
+    The surcharge percentages come from ``parcelo.legacy.billing.fuel_surcharge``,
+    so finance's numbers stay in one place.
+
+    Args:
+        weight_kg: Shipment weight in kilograms. Must be positive.
+        zone: One of the keys in ``ZONE_BASE``.
+
+    Returns:
+        A dict with ``quote``, ``surcharge`` and ``total`` as ``Money``.
+
+    Raises:
+        DomainError: ``E_BAD_ZONE`` for an unknown zone, ``E_BAD_WEIGHT`` for a
+            zero or negative weight.
+    """
+    if zone not in ZONE_BASE:
+        raise DomainError("E_BAD_ZONE", zone)
+    if weight_kg <= 0:
+        raise DomainError("E_BAD_WEIGHT", str(weight_kg))
+    # quote() and fuel_surcharge() still return floats; wrap them at the edge.
+    base = Money.parse(quote(weight_kg, zone))
+    surcharge = Money.parse(fuel_surcharge(base.cents / 100, zone))
+    return {"quote": base, "surcharge": surcharge, "total": base + surcharge}
