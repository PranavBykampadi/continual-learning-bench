+++ b/parcelo/settings.py	2026-11-12 03:08:43
@@ -0,0 +1,9 @@
+"""Business thresholds and rates. Functions import these instead of using bare numbers."""
+
+from parcelo.money import Money
+
+# An account with more than this many open invoices needs a manual review.
+MAX_OPEN_INVOICES = 3
+
+# An account whose open invoices total more than this needs a manual review.
+REVIEW_BALANCE_LIMIT = Money.parse("250.00")
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_customers.py b/tests/unit/test_customers.py
--- a/tests/unit/test_customers.py	1969-12-31 19:00:00
+++ b/tests/unit/test_customers.py	2026-11-12 03:08:55
@@ -0,0 +1,77 @@
+import pytest
+
+from parcelo import customers
+from parcelo.errors import DomainError
+from parcelo.models import Invoice, Shipment
+from parcelo.store import db
+
+
+def _add_open_invoice(customer_id, amount, status="open"):
+    shipment = Shipment(
+        id="shp_%d" % len(db.shipments),
+        customer_id=customer_id,
+        weight_kg=1,
+        zone="local",
+    )
+    db.shipments[shipment.id] = shipment
+    invoice = Invoice(
+        id="INV-%d" % len(db.invoices),
+        shipment_id=shipment.id,
+        amount=amount,
+        status=status,
+    )
+    db.invoices[invoice.id] = invoice
+
+
+def test_no_invoices_no_review():
+    c = customers.add_customer("Acme")
+    assert customers.needs_review(c.id) is False
+
+
+def test_three_open_invoices_is_not_enough():
+    c = customers.add_customer("Acme")
+    for _ in range(3):
+        _add_open_invoice(c.id, 1.0)
+    assert customers.needs_review(c.id) is False
+
+
+def test_more_than_three_open_invoices_needs_review():
+    c = customers.add_customer("Acme")
+    for _ in range(4):
+        _add_open_invoice(c.id, 1.0)
+    assert customers.needs_review(c.id) is True
+
+
+def test_paid_invoices_do_not_count():
+    c = customers.add_customer("Acme")
+    for _ in range(5):
+        _add_open_invoice(c.id, 1.0, status="paid")
+    assert customers.needs_review(c.id) is False
+
+
+def test_total_exactly_250_does_not_need_review():
+    c = customers.add_customer("Acme")
+    _add_open_invoice(c.id, 100.0)
+    _add_open_invoice(c.id, 150.0)
+    assert customers.needs_review(c.id) is False
+
+
+def test_total_over_250_needs_review():
+    c = customers.add_customer("Acme")
+    _add_open_invoice(c.id, 100.0)
+    _add_open_invoice(c.id, 150.01)
+    assert customers.needs_review(c.id) is True
+
+
+def test_other_customers_invoices_are_ignored():
+    c = customers.add_customer("Acme")
+    other = customers.add_customer("Other")
+    for _ in range(4):
+        _add_open_invoice(other.id, 1000.0)
+    assert customers.needs_review(c.id) is False
+
+
+def test_unknown_customer_raises():
+    with pytest.raises(DomainError) as err:
+        customers.needs_review("nope")
+    assert err.value.code == "E_UNKNOWN_CUSTOMER"
