+def needs_review(customer_id):
+    """Return True if the customer's open invoices need a manual account review.
+
+    A customer needs review when they have more than MAX_OPEN_INVOICES open
+    invoices, or when their open invoices total more than REVIEW_BALANCE_LIMIT.
+
+    Args:
+        customer_id: ID of an existing customer.
+
+    Returns:
+        True if the account needs a manual review, otherwise False.
+
+    Raises:
+        DomainError: With code E_UNKNOWN_CUSTOMER if the customer does not exist.
+    """
+    if customer_id not in db.customers:
+        raise DomainError("E_UNKNOWN_CUSTOMER", customer_id)
+    open_count = 0
+    for invoice in db.invoices.values():
+        shipment = db.shipments[invoice.shipment_id]
+        if shipment.customer_id == customer_id and invoice.status == "open":
+            open_count += 1
+    # outstanding_balance is still float; wrap it as Money where it is read.
+    balance = Money.parse(outstanding_balance(customer_id))
+    return open_count > MAX_OPEN_INVOICES or REVIEW_BALANCE_LIMIT < balance
