diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/test_returns.py b/tests/test_returns.py
--- a/tests/test_returns.py	1969-12-31 19:00:00
+++ b/tests/test_returns.py	2026-11-12 03:12:33
@@ -0,0 +1,64 @@
+import pytest
+
+from parcelo import clock, customers, events, returns, shipments
+from parcelo.errors import DomainError
+
+
+def _delivered_shipment():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 2.0, "national")
+    s.status = "delivered"
+    return s
+
+
+def test_request_return_stores_and_returns_request():
+    s = _delivered_shipment()
+    clock.set_fixed(clock.now())
+    r = returns.request_return(s.id, "damaged")
+    assert r.id.startswith("ret_")
+    assert r.shipment_id == s.id
+    assert r.reason == "damaged"
+    assert r.requested_at == clock.now()
+    assert returns.returns_for(s.id) == [r]
+
+
+def test_request_return_emits_event():
+    s = _delivered_shipment()
+    events.OUTBOX.clear()
+    r = returns.request_return(s.id, "wrong item")
+    assert events.OUTBOX[-1]["name"] == "return.requested"
+    assert events.OUTBOX[-1]["entity_id"] == r.id
+
+
+def test_unknown_shipment_fails():
+    with pytest.raises(DomainError) as err:
+        returns.request_return("shp_999999", "damaged")
+    assert err.value.code == "E_NOT_FOUND"
+
+
+def test_undelivered_shipment_fails():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 2.0, "local")
+    with pytest.raises(DomainError) as err:
+        returns.request_return(s.id, "changed mind")
+    assert err.value.code == "E_BAD_STATE"
+    assert returns.returns_for(s.id) == []
+
+
+def test_fourth_request_fails():
+    s = _delivered_shipment()
+    for i in range(3):
+        returns.request_return(s.id, f"reason {i}")
+    with pytest.raises(DomainError) as err:
+        returns.request_return(s.id, "one too many")
+    assert err.value.code == "E_LIMIT"
+    assert len(returns.ret