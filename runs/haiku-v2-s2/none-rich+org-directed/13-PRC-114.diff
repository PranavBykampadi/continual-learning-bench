+def _as_utc(moment):
+    """Return an aware UTC datetime.
+
+    Naive values are treated as UTC, since invoices are stored as naive UTC.
+
+    Args:
+        moment: A naive or aware datetime.
+
+    Returns:
+        datetime: The same moment as an aware UTC datetime.
+    """
+    if moment.tzinfo is None:
+        return moment.replace(tzinfo=timezone.utc)
+    return moment.astimezone(timezone.utc)
+
+
+def aging_report():
+    """Total the open invoices by age in whole days since they were issued.
+
+    Paid invoices are excluded. Buckets: "0-30" (0 to 30 days), "31-60"
+    (31 to 60 days), and "60+" (more than 60 days).
+
+    Returns:
+        dict: Keys "0-30", "31-60" and "60+", each mapped to a Money total.
+    """
+    now = clock.now()
+    totals = {"0-30": Money.zero(), "31-60": Money.zero(), "60+": Money.zero()}
+    for invoice in db.invoices.values():
+        if invoice.status == "paid":
+            continue
+        age = days_between(_as_utc(invoice.issued_at), now)
+        if age <= 30:
+            bucket = "0-30"
+        elif age <= 60:
+            bucket = "31-60"
+        else:
+            bucket = "60+"
+        totals[bucket] = totals[bucket] + Money.parse(invoice.amount)
+    return totals
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/test_reports.py b/tests/test_reports.py
--- a/tests/test_reports.py	1969-12-31 19:00:00
+++ b/tests/test_reports.py	2026-11-12 02:59:41
@@ -0,0 +1,74 @@
+from datetime import datetime, timedelta, timezone
+
+from parcelo import clock, reports
+from parcelo.models import Invoice
+from parcelo.money import Money
+from parcelo.store import db
+
+NOW = datetime(2026, 11, 12, 12, 0, tzinfo=timezone.utc)
+
+
+def _invoice(invoice_id, amount, days_old, status="open", naive=False):
+    issued = NOW - timedelta(days=days_old)
+    if naive:
+        issued = issued.replace(tzinfo=None)
+    db.invoices[invoice_id] = Invoice(
+        id=invoice_id,
+        shipment_id="SHP-1",
+        amount=amount,
+        status=status,
+        issued_at=issued,
+    )
+
+
+def test_aging_report_buckets_by_whole_days():
+    clock.set_fixed(NOW)
+    _invoice("a", 10.0, 0)
+    _invoice("b", 20.0, 30)
+    _invoice("c", 5.0, 31)
+    _invoice("d", 7.0, 60)
+    _invoice("e", 3.0, 61)
+
+    report = reports.aging_report()
+
+    assert report == {
+        "0-30": Money.parse(30.0),
+        "31-60": Money.parse(12.0),
+        "60+": Money.parse(3.0),
+    }
+
+
+def test_aging_report_leaves_out_paid_invoices():
+    clock.set_fixed(NOW)
+    _invoice("open", 10.0, 5)
+    _invoice("paid", 99.0, 5, status="paid")
+
+    assert reports.aging_report()["0-30"] == Money.parse(10.0)
+
+
+def test_aging_report_empty_buckets_are_zero():
+    clock.set_fixed(NOW)
+    _invoice("a", 10.0, 90)
+
+    report = reports.aging_report()
+
+    assert report["0-30"] == Money.zero()
+    assert report["31-60"] == Money.zero()
+    assert report["60+"] == Money.parse(10.0)
+
+
+def test_aging_report_treats_naive_issue_time_as_utc():
+    clock.set_fixed(NOW)
+    _invoice("naive", 4.0, 45, naive=True)
+
+    assert reports.aging_report()["31-60"] == Money.parse(4.0)
+
+
+def test_aging_report_empty_store():
+    clock.set_fixed(NOW)
+
+    assert reports.aging_report() == {
+        "0-30": Money.zero(),
+        "31-60": Money.zero(),
+        "60+": Money.zero(),
+    }
