@@ -32,3 +37,30 @@
 
 def open_invoices():
     return [i for i in db.invoices.values() if i.status == "open"]
+
+
+def late_fee_for(invoice_id: str) -> float:
+    """Return the late fee an invoice has accrued as of now.
+
+    An invoice is late once it is more than LATE_AFTER_DAYS old. Each whole
+    day past that point adds LATE_FEE_PER_DAY of the invoice amount.
+
+    Args:
+        invoice_id: ID of an existing invoice.
+
+    Returns:
+        The fee in dollars, rounded to cents. Zero if the invoice is not late.
+
+    Raises:
+        DomainError: With code E_NOT_FOUND if no invoice has this ID.
+    """
+    invoice = db.invoices.get(invoice_id)
+    if invoice is None:
+        raise DomainError("E_NOT_FOUND", invoice_id)
+    issued_at = invoice.issued_at
+    if issued_at.tzinfo is None:
+        # issue_invoice still stores naive UTC times; treat them as UTC.
+        issued_at = issued_at.replace(tzinfo=timezone.utc)
+    days_old = (clock.now() - issued_at).days
+    days_late = max(0, days_old - LATE_AFTER_DAYS)
+    return round(invoice.amount * LATE_FEE_PER_DAY * days_late, 2)
