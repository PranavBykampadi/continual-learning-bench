@@ -1,9 +1,51 @@
-from parcelo import customers, invoices, shipments
+from datetime import datetime, timedelta, timezone
 
+import pytest
 
+from parcelo import clock, customers, invoices, shipments
+from parcelo.errors import DomainError
+
+
 def test_issue_and_pay():
     c = customers.add_customer("Acme")
     s = shipments.create_shipment(c.id, 2, "local")
     inv = invoices.issue_invoice(s.id)
     assert inv.amount == 7.0
     assert invoices.mark_paid(inv.id).status == "paid"
+
+
+def _invoice_issued_days_ago(days):
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 2, "local")
+    inv = invoices.issue_invoice(s.id)
+    now = datetime(2026, 11, 12, 12, 0, tzinfo=timezone.utc)
+    clock.set_fixed(now)
+    inv.issued_at = now - timedelta(days=days)
+    return inv
+
+
+def test_late_fee_zero_up_to_30_days():
+    inv = _invoice_issued_days_ago(30)
+    assert invoices.late_fee_for(inv.id) == 0.0
+
+
+def test_late_fee_one_day_past_30():
+    inv = _invoice_issued_days_ago(31)
+    assert invoices.late_fee_for(inv.id) == round(7.0 * 0.015, 2)
+
+
+def test_late_fee_scales_per_day():
+    inv = _invoice_issued_days_ago(40)
+    assert invoices.late_fee_for(inv.id) == round(7.0 * 0.015 * 10, 2)
+
+
+def test_late_fee_accepts_naive_issued_at():
+    inv = _invoice_issued_days_ago(33)
+    inv.issued_at = inv.issued_at.replace(tzinfo=None)
+    assert invoices.late_fee_for(inv.id) == round(7.0 * 0.015 * 3, 2)
+
+
+def test_late_fee_unknown_invoice_raises():
+    with pytest.raises(DomainError) as err:
+        invoices.late_fee_for("INV-missing")
+    assert err.value.code == "E_NOT_FOUND"
