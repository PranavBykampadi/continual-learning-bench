 def open_invoices():
     return [i for i in db.invoices.values() if i.status == "open"]
+
+
+def apply_credit(invoice_id, amount):
+    """Reduce the amount of an open invoice by a credit.
+
+    Args:
+        invoice_id: ID of the invoice to credit.
+        amount: Credit to subtract, in dollars (float, int, str or Decimal).
+
+    Returns:
+        The invoice amount remaining after the credit, in dollars.
+
+    Raises:
+        DomainError: E_NOT_FOUND if the invoice does not exist, E_BAD_STATE if
+            it is not open, or E_BAD_INPUT if the credit is not positive or is
+            larger than the invoice amount.
+    """
+    if invoice_id not in db.invoices:
+        raise DomainError("E_NOT_FOUND", invoice_id)
+    invoice = db.invoices[invoice_id]
+    if invoice.status != "open":
+        raise DomainError("E_BAD_STATE", f"{invoice_id} is {invoice.status}")
+    credit = Money.parse(amount)
+    if credit.cents <= 0:
+        raise DomainError("E_BAD_INPUT", f"credit must be positive: {amount}")
+    # Invoice amounts are still stored as float dollars (reports and
+    # outstanding_balance read them that way), so wrap on read and write
+    # back a value that is exactly whole cents.
+    current = Money.parse(invoice.amount)
+    if current < credit:
+        raise DomainError(
+            "E_BAD_INPUT", f"credit {credit} exceeds invoice {invoice_id} amount {current}"
+        )
+    remaining = current - credit
+    invoice.amount = remaining.cents / 100
+    audit.record(
+        "invoice.credit_applied",
+        invoice.id,
+        credit_cents=credit.cents,
+        remaining_cents=remaining.cents,
+    )
+    return invoice.amount
