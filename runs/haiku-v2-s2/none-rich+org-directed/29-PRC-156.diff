 def test_quote_local():
@@ -10,3 +11,26 @@
 def test_unknown_zone():
     with pytest.raises(ValueError):
         rates.base_rate("moon")
+
+
+def test_heavy_quote_at_threshold_is_normal_quote():
+    assert rates.heavy_quote(30, "local") == rates.quote(30, "local") == 42.0
+
+
+def test_heavy_quote_adds_surcharge_above_threshold():
+    # 4.5 + 1.25 * 31 + 0.75 * 1
+    assert rates.heavy_quote(31, "local") == 44.0
+    # 4.5 + 1.25 * 40 + 0.75 * 10
+    assert rates.heavy_quote(40, "local") == 62.0
+
+
+def test_heavy_quote_unknown_zone():
+    with pytest.raises(DomainError) as exc:
+        rates.heavy_quote(40, "moon")
+    assert exc.value.code == "E_BAD_ZONE"
+
+
+def test_heavy_quote_non_positive_weight():
+    with pytest.raises(DomainError) as exc:
+        rates.heavy_quote(0, "local")
+    assert exc.value.code == "E_BAD_WEIGHT"
