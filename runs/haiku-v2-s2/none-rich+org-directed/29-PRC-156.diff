@@ -1,3 +1,6 @@
+from parcelo.errors import DomainError
+from parcelo.settings import HEAVY_SURCHARGE_PER_KG, HEAVY_THRESHOLD_KG
+
 ZONE_BASE = {"local": 4.5, "national": 9.0, "international": 24.0}
 PER_KG = 1.25
 
@@ -12,3 +15,15 @@
     if weight_kg <= 0:
         raise ValueError("weight must be positive")
     return round(base_rate(zone) + PER_KG * weight_kg, 2)
+
+
+def heavy_quote(weight_kg, zone):
+    if zone not in ZONE_BASE:
+        raise DomainError("E_BAD_ZONE", zone)
+    if weight_kg <= 0:
+        raise DomainError("E_BAD_WEIGHT", str(weight_kg))
+    surcharge = 0.0
+    if weight_kg > HEAVY_THRESHOLD_KG:
+        surcharge = HEAVY_SURCHARGE_PER_KG * (weight_kg - HEAVY_THRESHOLD_KG)
+    # Round once, at the end, same as quote().
+    return round(base_rate(zone) + PER_KG * weight_kg + surcharge, 2)
