 def open_invoices():
     return [i for i in db.invoices.values() if i.status == "open"]
+
+
+def invoices_by_status(status: str) -> list[Invoice]:
+    """Return all invoices whose status is `status`.
+
+    Args:
+        status: Either "open" or "paid".
+
+    Returns:
+        The matching invoices, or an empty list if there are none.
+
+    Raises:
+        DomainError: With code E_BAD_INPUT if `status` is not "open" or "paid".
+    """
+    if status not in VALID_STATUSES:
+        raise DomainError("E_BAD_INPUT", f"invalid invoice status: {status!r}")
+    return [i for i in db.invoices.values() if i.status == status]
