+def test_invoices_by_status():
+    c = customers.add_customer("Acme")
+    s1 = shipments.create_shipment(c.id, 2, "local")
+    s2 = shipments.create_shipment(c.id, 3, "local")
+    open_inv = invoices.issue_invoice(s1.id)
+    paid_inv = invoices.issue_invoice(s2.id)
+    invoices.mark_paid(paid_inv.id)
+
+    assert invoices.invoices_by_status("open") == [open_inv]
+    assert invoices.invoices_by_status("paid") == [paid_inv]
+
+
+def test_invoices_by_status_empty():
+    assert invoices.invoices_by_status("paid") == []
+
+
+@pytest.mark.parametrize("status", ["void", "", "OPEN", None])
+def test_invoices_by_status_rejects_unknown(status):
+    with pytest.raises(DomainError) as exc:
+        invoices.invoices_by_status(status)
+    assert exc.value.code == "E_BAD_INPUT"
