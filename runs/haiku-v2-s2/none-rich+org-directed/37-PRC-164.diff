diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/parcelo/vouchers.py b/parcelo/vouchers.py
--- a/parcelo/vouchers.py	1969-12-31 19:00:00
+++ b/parcelo/vouchers.py	2026-11-12 03:16:01
@@ -0,0 +1,42 @@
+from __future__ import annotations
+
+from decimal import Decimal
+
+from parcelo import clock, events, ids
+from parcelo.errors import DomainError
+from parcelo.models import Voucher
+from parcelo.money import Money
+from parcelo.settings import MAX_VOUCHER_AMOUNT
+from parcelo.store import db
+
+
+def issue_voucher(customer_id: str, amount: Money | Decimal | float | int | str) -> Voucher:
+    """Issue a goodwill voucher to an existing customer.
+
+    Args:
+        customer_id: Id of the customer receiving the voucher.
+        amount: Value of the voucher. Floats, strings and Decimals are converted to Money.
+
+    Returns:
+        The stored Voucher.
+
+    Raises:
+        DomainError: E_UNKNOWN_CUSTOMER if the customer does not exist, E_BAD_INPUT if the
+            amount is zero or negative, E_LIMIT if the amount is above MAX_VOUCHER_AMOUNT.
+    """
+    if customer_id not in db.customers:
+        raise DomainError("E_UNKNOWN_CUSTOMER", customer_id)
+    money = Money.parse(amount)
+    if money.cents <= 0:
+        raise DomainError("E_BAD_INPUT", "voucher amount must be positive")
+    if MAX_VOUCHER_AMOUNT < money:
+        raise DomainError("E_LIMIT", f"voucher amount above {MAX_VOUCHER_AMOUNT}")
+    voucher = Voucher(
+        id=ids.new_id("vch"),
+        customer_id=customer_id,
+        amount=money,
+        issued_at=clock.now(),
+    )
+    db.vouchers[voucher.id] = voucher
+    events.emit("voucher.issued", voucher.id, customer_id=customer_id, cents=money.cents)
+    return voucher
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_vouchers.py b/tests/unit/test_vouchers.py
--- a/tests/unit/test_vouchers.py	1969-12-31 19:00:00
+++ b/tests/unit/test_vouchers.py	2026-11-12 03:16:05
@@ -0,0 +1,46 @@
+import pytest
+
+from parcelo import customers, events, vouchers
+from parcelo.errors import DomainError
+from parcelo.money import Money
+from parcelo.store import db
+
+
+def test_issue_voucher_stores_and_returns_it():
+    c = customers.add_customer("Acme")
+    v = vouchers.issue_voucher(c.id, "25.50")
+    assert v.id.startswith("vch_")
+    assert v.customer_id == c.id
+    assert v.amount == Money(2550)
+    assert v.issued_at is not None
+    assert db.vouchers[v.id] is v
+    assert events.OUTBOX[-1]["name"] == "voucher.issued"
+
+
+def test_max_amount_is_allowed():
+    c = customers.add_customer("Acme")
+    assert vouchers.issue_voucher(c.id, "150.00").amount == Money(15000)
+
+
+def test_over_max_fails():
+    c = customers.add_customer("Acme")
+    with pytest.raises(DomainError) as err:
+        vouchers.issue_voucher(c.id, "150.01")
+    assert err.value.code == "E_LIMIT"
+    assert db.vouchers == {}
+
+
+@pytest.mark.parametrize("amount", [0, -5, "0.00", "-1.00"])
+def test_zero_or_negative_fails(amount):
+    c = customers.add_customer("Acme")
+    with pytest.raises(DomainError) as err:
+        vouchers.issue_voucher(c.id, amount)
+    assert err.value.code == "E_BAD_INPUT"
+    assert db.vouchers == {}
+
+
+def test_unknown_customer_fails():
+    with pytest.raises(DomainError) as err:
+        vouchers.issue_voucher("nope", 10)
+    assert err.value.code == "E_UNKNOWN_CUSTOMER"
+    assert db.vouchers == {}
