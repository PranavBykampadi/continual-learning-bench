@@ -0,0 +1,25 @@
+from parcelo import customers, invoices, reports, shipments
+from parcelo.money import Money
+
+
+def test_outstanding_by_customer_counts_only_open_invoices():
+    acme = customers.add_customer("Acme")
+    globex = customers.add_customer("Globex")
+    idle = customers.add_customer("Idle")
+
+    open_small = invoices.issue_invoice(shipments.create_shipment(acme.id, 2, "local").id)  # 7.00
+    paid = invoices.issue_invoice(shipments.create_shipment(acme.id, 2, "local").id)  # 7.00
+    void = invoices.issue_invoice(shipments.create_shipment(globex.id, 2, "local").id)  # 7.00
+    open_big = invoices.issue_invoice(shipments.create_shipment(acme.id, 4, "national").id)  # 14.00
+
+    invoices.mark_paid(paid.id)
+    void.status = "void"
+
+    result = reports.outstanding_by_customer()
+
+    assert result == {acme.id: Money(2100), globex.id: Money(0), idle.id: Money(0)}
+    assert open_small.status == "open" and open_big.status == "open"
+
+
+def test_outstanding_by_customer_empty_store():
+    assert reports.outstanding_by_customer() == {}
