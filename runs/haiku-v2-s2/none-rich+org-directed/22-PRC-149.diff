+import math
+
 from parcelo import clock, events, ids
 from parcelo.errors import DomainError
 from parcelo.models import Shipment
@@ -28,3 +30,50 @@
     if shipment_id not in db.shipments:
         raise DomainError("E_NOT_FOUND", shipment_id)
     return db.shipments[shipment_id]
+
+
+def split_shipment(shipment_id: str, weights: list[float]) -> list[Shipment]:
+    """Replace a created shipment with one new shipment per weight.
+
+    The original shipment is kept with status "split". Each new shipment has the
+    same customer and zone as the original.
+
+    Args:
+        shipment_id: ID of the shipment to split. Must be in status "created".
+        weights: Weights in kg for the new shipments. They must add up to the
+            original shipment's weight.
+
+    Returns:
+        The new shipments, in the same order as ``weights``.
+
+    Raises:
+        DomainError: E_NOT_FOUND if the shipment does not exist, E_BAD_STATE if it
+            is not in status "created", E_BAD_INPUT if no weights are given, and
+            E_BAD_WEIGHT if a weight is not positive or the weights do not add up
+            to the original weight.
+    """
+    original = get_shipment(shipment_id)
+    if original.status != "created":
+        raise DomainError("E_BAD_STATE", f"{shipment_id} is {original.status}")
+    if not weights:
+        raise DomainError("E_BAD_INPUT", "no weights given")
+    for weight in weights:
+        if weight <= 0:
+            raise DomainError("E_BAD_WEIGHT", str(weight))
+    total = sum(weights)
+    if not math.isclose(total, original.weight_kg):
+        raise DomainError(
+            "E_BAD_WEIGHT",
+            f"weights sum to {total}, expected {original.weight_kg}",
+        )
+
+    new_shipments = [
+        create_shipment(original.customer_id, weight, original.zone) for weight in weights
+    ]
+    original.status = "split"
+    events.emit(
+        "shipment.split",
+        shipment_id,
+        new_ids=[shipment.id for shipment in new_shipments],
+    )
+    return new_shipments
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_shipments.py b/tests/unit/test_shipments.py
--- a/tests/unit/test_shipments.py	2026-11-10 12:20:18
+++ b/tests/unit/test_shipments.py	2026-11-12 03:06:22
@@ -15,3 +15,71 @@
     with pytest.raises(DomainError) as err:
         shipments.create_shipment("nope", 1, "local")
     assert err.value.code == "E_UNKNOWN_CUSTOMER"
+
+
+def _created(weight=10.0):
+    c = customers.add_customer("Acme")
+    return shipments.create_shipment(c.id, weight, "national")
+
+
+def test_split_creates_one_shipment_per_weight_in_order():
+    original = _created(10.0)
+    new = shipments.split_shipment(original.id, [6.0, 3.0, 1.0])
+    assert [s.weight_kg for s in new] == [6.0, 3.0, 1.0]
+    assert all(s.customer_id == original.customer_id for s in new)
+    assert all(s.zone == original.zone for s in new)
+    assert all(s.status == "created" for s in new)
+    assert shipments.get_shipment(original.id).status == "split"
+
+
+def test_split_emits_events():
+    original = _created(4.0)
+    new = shipments.split_shipment(original.id, [1.0, 3.0])
+    names = [e["name"] for e in events.OUTBOX]
+    assert names[-3:] == ["shipment.created", "shipment.created", "shipment.split"]
+    assert events.OUTBOX[-1]["payload"]["new_ids"] == [s.id for s in new]
+
+
+def test_split_accepts_float_rounding():
+    original = _created(0.3)
+    new = shipments.split_shipment(original.id, [0.1, 0.2])
+    assert len(new) == 2
+
+
+def test_split_unknown_shipment_fails():
+    with pytest.raises(DomainError) as err:
+        shipments.split_shipment("shp_missing", [1.0])
+    assert err.value.code == "E_NOT_FOUND"
+
+
+def test_split_non_created_shipment_fails():
+    original = _created(5.0)
+    shipments.split_shipment(original.id, [2.0, 3.0])
+    with pytest.raises(DomainError) as err:
+        shipments.split_shipment(original.id, [2.0, 3.0])
+    assert err.value.code == "E_BAD_STATE"
+
+
+def test_split_weights_must_add_up():
+    original = _created(5.0)
+    with pytest.raises(DomainError) as err:
+        shipments.split_shipment(original.id, [2.0, 2.0])
+    assert err.value.code == "E_BAD_WEIGHT"
+    # nothing changed on failure
+    assert shipments.get_shipment(original.id).status == "created"
+    assert len(shipments.db.shipments) == 1
+
+
+def test_split_rejects_non_positive_weight():
+    original = _created(5.0)
+    with pytest.raises(DomainError) as err:
+        shipments.split_shipment(original.id, [5.0, 0.0])
+    assert err.value.code == "E_BAD_WEIGHT"
+    assert shipments.get_shipment(original.id).status == "created"
+
+
+def test_split_requires_weights():
+    original = _created(5.0)
+    with pytest.raises(DomainError) as err:
+        shipments.split_shipment(original.id, [])
+    assert err.value.code == "E_BAD_INPUT"
