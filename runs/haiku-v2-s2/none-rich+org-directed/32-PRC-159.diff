diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/parcelo/shipments.py b/parcelo/shipments.py
--- a/parcelo/shipments.py	2026-11-10 12:20:18
+++ b/parcelo/shipments.py	2026-11-12 03:13:04
@@ -28,3 +28,20 @@
     if shipment_id not in db.shipments:
         raise DomainError("E_NOT_FOUND", shipment_id)
     return db.shipments[shipment_id]
+
+
+def shipments_in_zone(zone):
+    """Return all shipments whose zone is `zone`.
+
+    Args:
+        zone: One of the zones in ZONE_BASE ("local", "national", "international").
+
+    Returns:
+        A list of Shipment objects in that zone, in creation order. Empty if none.
+
+    Raises:
+        DomainError: E_BAD_ZONE if `zone` is not a known zone.
+    """
+    if zone not in ZONE_BASE:
+        raise DomainError("E_BAD_ZONE", zone)
+    return [s for s in db.shipments.values() if s.zone == zone]
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_shipments.py b/tests/unit/test_shipments.py
--- a/tests/unit/test_shipments.py	2026-11-10 12:20:18
+++ b/tests/unit/test_shipments.py	2026-11-12 03:13:05
@@ -15,3 +15,21 @@
     with pytest.raises(DomainError) as err:
         shipments.create_shipment("nope", 1, "local")
     assert err.value.code == "E_UNKNOWN_CUSTOMER"
+
+
+def test_shipments_in_zone_filters_by_zone():
+    c = customers.add_customer("Acme")
+    a = shipments.create_shipment(c.id, 1, "local")
+    shipments.create_shipment(c.id, 2, "national")
+    b = shipments.create_shipment(c.id, 3, "local")
+    assert shipments.shipments_in_zone("local") == [a, b]
+
+
+def test_shipments_in_zone_empty():
+    assert shipments.shipments_in_zone("international") == []
+
+
+def test_shipments_in_zone_bad_zone():
+    with pytest.raises(DomainError) as err:
+        shipments.shipments_in_zone("mars")
+    assert err.value.code == "E_BAD_ZONE"
