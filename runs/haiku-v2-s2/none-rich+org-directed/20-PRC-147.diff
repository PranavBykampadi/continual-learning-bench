+++ b/parcelo/settings.py	2026-11-12 03:04:47
@@ -0,0 +1,7 @@
+"""Business thresholds and rates. Functions import these; don't inline the numbers."""
+
+# Customer volume tiers, by number of shipments. A customer with at least
+# VOLUME_TIER_BULK_MIN shipments is "bulk", at least VOLUME_TIER_REGULAR_MIN
+# is "regular", otherwise "starter". Same thresholds as legacy/billing.py.
+VOLUME_TIER_BULK_MIN = 50
+VOLUME_TIER_REGULAR_MIN = 10
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/test_reports.py b/tests/test_reports.py
--- a/tests/test_reports.py	1969-12-31 19:00:00
+++ b/tests/test_reports.py	2026-11-12 03:04:53
@@ -0,0 +1,27 @@
+from parcelo import customers, reports, shipments
+
+
+def _ship(customer_id, n):
+    for _ in range(n):
+        shipments.create_shipment(customer_id, 1, "local")
+
+
+def test_volume_report_includes_customers_without_shipments():
+    c = customers.add_customer("Acme")
+    assert reports.volume_report() == {c.id: {"shipments": 0, "tier": "starter"}}
+
+
+def test_volume_report_counts_per_customer():
+    a = customers.add_customer("Acme")
+    b = customers.add_customer("Globex")
+    _ship(a.id, 3)
+    _ship(b.id, 1)
+    report = reports.volume_report()
+    assert report[a.id] == {"shipments": 3, "tier": "starter"}
+    assert report[b.id] == {"shipments": 1, "tier": "starter"}
+
+
+def test_volume_tier_boundaries():
+    cases = {9: "starter", 10: "regular", 49: "regular", 50: "bulk"}
+    for count, tier in cases.items():
+        assert reports._volume_tier(count) == tier, count
