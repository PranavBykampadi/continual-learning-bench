@@ -1,6 +1,42 @@
 from datetime import datetime
 
+from parcelo import settings
 from parcelo.store import db
+
+
+def _volume_tier(shipment_count: int) -> str:
+    """Map a shipment count to a volume tier label.
+
+    Args:
+        shipment_count: Number of shipments the customer has.
+
+    Returns:
+        "bulk", "regular", or "starter".
+    """
+    if shipment_count >= settings.VOLUME_TIER_BULK_MIN:
+        return "bulk"
+    if shipment_count >= settings.VOLUME_TIER_REGULAR_MIN:
+        return "regular"
+    return "starter"
+
+
+def volume_report() -> dict[str, dict[str, object]]:
+    """Report shipment volume and tier for every customer.
+
+    Customers with no shipments are included with a count of zero.
+
+    Returns:
+        Dict keyed by customer id, with values like
+        {"shipments": <count>, "tier": <label>}.
+    """
+    counts = {customer_id: 0 for customer_id in db.customers}
+    for shipment in db.shipments.values():
+        if shipment.customer_id in counts:
+            counts[shipment.customer_id] += 1
+    return {
+        customer_id: {"shipments": count, "tier": _volume_tier(count)}
+        for customer_id, count in counts.items()
+    }
 
 
 def revenue_total():
