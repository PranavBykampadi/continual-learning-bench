@@ -1,9 +1,55 @@
-from parcelo import customers, invoices, shipments
+from datetime import datetime, timezone
 
+import pytest
 
+from parcelo import clock, customers, events, invoices, shipments
+from parcelo.errors import DomainError
+
+
 def test_issue_and_pay():
     c = customers.add_customer("Acme")
     s = shipments.create_shipment(c.id, 2, "local")
     inv = invoices.issue_invoice(s.id)
     assert inv.amount == 7.0
     assert invoices.mark_paid(inv.id).status == "paid"
+
+
+def _open_invoice():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 2, "local")
+    return invoices.issue_invoice(s.id)
+
+
+def test_hold_open_invoice():
+    inv = _open_invoice()
+    moment = datetime(2026, 11, 12, 9, 0, tzinfo=timezone.utc)
+    clock.set_fixed(moment)
+    held = invoices.hold_invoice(inv.id)
+    assert held is inv
+    assert held.status == "on_hold"
+    assert held.held_at == moment
+    assert events.OUTBOX[-1]["name"] == "invoice.held"
+    assert events.OUTBOX[-1]["entity_id"] == inv.id
+
+
+def test_hold_missing_invoice_fails():
+    with pytest.raises(DomainError) as exc:
+        invoices.hold_invoice("INV-missing")
+    assert exc.value.code == "E_NOT_FOUND"
+
+
+def test_hold_paid_invoice_fails():
+    inv = _open_invoice()
+    invoices.mark_paid(inv.id)
+    with pytest.raises(DomainError) as exc:
+        invoices.hold_invoice(inv.id)
+    assert exc.value.code == "E_BAD_STATE"
+    assert inv.status == "paid"
+
+
+def test_hold_already_held_invoice_fails():
+    inv = _open_invoice()
+    invoices.hold_invoice(inv.id)
+    with pytest.raises(DomainError) as exc:
+        invoices.hold_invoice(inv.id)
+    assert exc.value.code == "E_BAD_STATE"
