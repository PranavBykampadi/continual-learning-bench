+from parcelo.money import Money
+
+# Business thresholds and limits. Functions import these instead of using bare numbers.
+
+# Smallest unpaid invoice that can be escalated to collections: 500.00 USD.
+ESCALATION_MIN_AMOUNT = Money(50000)
