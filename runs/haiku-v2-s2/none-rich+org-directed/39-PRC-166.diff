-from parcelo import customers, invoices, shipments
+import pytest
 
+from parcelo import customers, events, invoices, shipments, store
+from parcelo.errors import DomainError
+from parcelo.models import Invoice
 
+
 def test_issue_and_pay():
     c = customers.add_customer("Acme")
     s = shipments.create_shipment(c.id, 2, "local")
     inv = invoices.issue_invoice(s.id)
     assert inv.amount == 7.0
     assert invoices.mark_paid(inv.id).status == "paid"
+
+
+def _add_invoice(invoice_id, amount, status="open"):
+    inv = Invoice(id=invoice_id, shipment_id="shp_x", amount=amount, status=status)
+    store.db.invoices[invoice_id] = inv
+    return inv
+
+
+def test_escalate_large_open_invoice():
+    inv = _add_invoice("INV-big", 750.0)
+    result = invoices.escalate_invoice("INV-big")
+    assert result is inv
+    assert inv.status == "escalated"
+    assert events.OUTBOX[-1]["name"] == "invoice.escalated"
+    assert events.OUTBOX[-1]["entity_id"] == "INV-big"
+
+
+def test_escalate_exactly_minimum_amount():
+    _add_invoice("INV-min", 500.0)
+    assert invoices.escalate_invoice("INV-min").status == "escalated"
+
+
+def test_escalate_below_minimum_fails():
+    inv = _add_invoice("INV-small", 499.99)
+    with pytest.raises(DomainError) as exc:
+        invoices.escalate_invoice("INV-small")
+    assert exc.value.code == "E_BAD_STATE"
+    assert inv.status == "open"
+
+
+def test_escalate_missing_invoice_fails():
+    with pytest.raises(DomainError) as exc:
+        invoices.escalate_invoice("INV-nope")
+    assert exc.value.code == "E_NOT_FOUND"
+
+
+@pytest.mark.parametrize("status", ["paid", "escalated"])
+def test_escalate_non_open_invoice_fails(status):
+    inv = _add_invoice("INV-" + status, 900.0, status=status)
+    with pytest.raises(DomainError) as exc:
+        invoices.escalate_invoice(inv.id)
+    assert exc.value.code == "E_BAD_STATE"
+    assert inv.status == status
