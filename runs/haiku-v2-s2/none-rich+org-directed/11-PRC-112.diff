diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_claims.py b/tests/unit/test_claims.py
--- a/tests/unit/test_claims.py	1969-12-31 19:00:00
+++ b/tests/unit/test_claims.py	2026-11-12 02:58:02
@@ -0,0 +1,69 @@
+import pytest
+
+from parcelo import audit, claims, customers, shipments, store
+from parcelo.errors import DomainError
+from parcelo.money import Money
+
+
+def _delivered_shipment():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 2.0, "national")
+    s.status = "delivered"
+    return s
+
+
+def test_file_claim_on_delivered_shipment():
+    s = _delivered_shipment()
+    claim = claims.file_claim(s.id, 12.5, "item arrived broken")
+    assert claim.id.startswith("clm_")
+    assert claim.shipment_id == s.id
+    assert claim.amount == Money.parse(12.5)
+    assert claim.reason == "item arrived broken"
+    assert claim.filed_at is not None
+    assert store.db.claims[claim.id] is claim
+
+
+def test_claim_is_audited():
+    s = _delivered_shipment()
+    claim = claims.file_claim(s.id, "3.10", "late")
+    assert audit.LOG[-1]["action"] == "claim.filed"
+    assert audit.LOG[-1]["entity_id"] == claim.id
+
+
+def test_unknown_shipment_is_not_found():
+    with pytest.raises(DomainError) as err:
+        claims.file_claim("shp_missing", 5, "x")
+    assert err.value.code == "E_NOT_FOUND"
+
+
+def test_undelivered_shipment_is_bad_state():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 1, "local")
+    with pytest.raises(DomainError) as err:
+        claims.file_claim(s.id, 5, "x")
+    assert err.value.code == "E_BAD_STATE"
+    assert store.db.claims == {}
+
+
+@pytest.mark.parametrize("amount", [0, -1, -0.5, 0.001, "0", "-3"])
+def test_non_positive_amount_is_bad_input(amount):
+    s = _delivered_shipment()
+    with pytest.raises(DomainError) as err:
+        claims.file_claim(s.id, amount, "x")
+    assert err.value.code == "E_BAD_INPUT"
+    assert store.db.claims == {}
+
+
+@pytest.mark.parametrize("amount", ["abc", None, float("nan"), float("inf")])
+def test_unparseable_amount_is_bad_input(amount):
+    s = _delivered_shipment()
+    with pytest.raises(DomainError) as err:
+        claims.file_claim(s.id, amount, "x")
+    assert err.value.code == "E_BAD_INPUT"
+
+
+def test_reset_clears_claims():
+    s = _delivered_shipment()
+    claims.file_claim(s.id, 1, "x")
+    store.reset()
+    assert store.db.claims == {}
