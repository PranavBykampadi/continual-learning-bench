diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/parcelo/claims.py b/parcelo/claims.py
--- a/parcelo/claims.py	1969-12-31 19:00:00
+++ b/parcelo/claims.py	2026-11-12 02:57:58
@@ -0,0 +1,48 @@
+from decimal import InvalidOperation
+
+from parcelo import audit, clock, ids
+from parcelo.errors import DomainError
+from parcelo.models import Claim
+from parcelo.money import Money
+from parcelo.shipments import get_shipment
+from parcelo.store import db
+
+DELIVERED = "delivered"
+
+
+def file_claim(shipment_id: str, amount, reason: str) -> Claim:
+    """File a money claim against a delivered shipment.
+
+    Args:
+        shipment_id: Id of the shipment the claim is about. Must be delivered.
+        amount: Amount claimed in dollars. Accepts float, int, str or Decimal.
+        reason: Why the customer is claiming.
+
+    Returns:
+        The stored Claim.
+
+    Raises:
+        DomainError: E_NOT_FOUND if the shipment does not exist, E_BAD_STATE if it
+            has not been delivered, E_BAD_INPUT if the amount is not a positive amount.
+    """
+    shipment = get_shipment(shipment_id)
+    if shipment.status != DELIVERED:
+        raise DomainError(
+            "E_BAD_STATE", f"shipment {shipment_id} is {shipment.status}, not delivered"
+        )
+    try:
+        claimed = Money.parse(amount)
+    except (InvalidOperation, TypeError, ValueError):
+        raise DomainError("E_BAD_INPUT", f"bad amount: {amount!r}") from None
+    if claimed.cents <= 0:
+        raise DomainError("E_BAD_INPUT", f"amount must be positive: {amount!r}")
+    claim = Claim(
+        id=ids.new_id("clm"),
+        shipment_id=shipment_id,
+        amount=claimed,
+        reason=reason,
+        filed_at=clock.now(),
+    )
+    db.claims[claim.id] = claim
+    audit.record("claim.filed", claim.id, shipment_id=shipment_id, amount_cents=claimed.cents)
+    return claim
