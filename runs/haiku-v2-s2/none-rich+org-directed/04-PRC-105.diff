diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/test_refunds.py b/tests/test_refunds.py
--- a/tests/test_refunds.py	1969-12-31 19:00:00
+++ b/tests/test_refunds.py	2026-11-12 02:52:25
@@ -0,0 +1,69 @@
+from datetime import datetime, timezone
+
+import pytest
+
+from parcelo import audit, clock, customers, invoices, refunds, shipments, store
+from parcelo.errors import DomainError
+from parcelo.models import Refund
+from parcelo.money import Money
+
+
+def _paid_invoice():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 2, "local")
+    inv = invoices.issue_invoice(s.id)
+    invoices.mark_paid(inv.id)
+    return inv
+
+
+def test_refund_paid_invoice_is_stored_and_returned():
+    moment = datetime(2026, 11, 12, 9, 30, tzinfo=timezone.utc)
+    clock.set_fixed(moment)
+    inv = _paid_invoice()
+    refund = refunds.create_refund(inv.id, 3.5)
+
+    assert isinstance(refund, Refund)
+    assert refund.invoice_id == inv.id
+    assert refund.amount == Money(350)
+    assert refund.created_at == moment
+    assert store.db.refunds[refund.id] is refund
+    assert audit.LOG[-1]["action"] == "refund.created"
+    assert audit.LOG[-1]["entity_id"] == refund.id
+
+
+def test_amount_accepts_string_and_money():
+    inv = _paid_invoice()
+    assert refunds.create_refund(inv.id, "1.10").amount == Money(110)
+    assert refunds.create_refund(inv.id, Money(250)).amount == Money(250)
+
+
+def test_unknown_invoice_fails():
+    with pytest.raises(DomainError) as exc:
+        refunds.create_refund("INV-missing", 1)
+    assert exc.value.code == "E_NOT_FOUND"
+    assert store.db.refunds == {}
+
+
+def test_unpaid_invoice_fails():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 2, "local")
+    inv = invoices.issue_invoice(s.id)
+    with pytest.raises(DomainError) as exc:
+        refunds.create_refund(inv.id, 1)
+    assert exc.value.code == "E_BAD_STATE"
+    assert store.db.refunds == {}
+
+
+def test_non_positive_amount_fails():
+    inv = _paid_invoice()
+    with pytest.raises(DomainError) as exc:
+        refunds.create_refund(inv.id, 0)
+    assert exc.value.code == "E_BAD_INPUT"
+    assert store.db.refunds == {}
+
+
+def test_reset_clears_refunds():
+    inv = _paid_invoice()
+    refunds.create_refund(inv.id, 1)
+    store.reset()
+    assert store.db.refunds == {}
