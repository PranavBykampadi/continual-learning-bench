diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/parcelo/refunds.py b/parcelo/refunds.py
--- a/parcelo/refunds.py	1969-12-31 19:00:00
+++ b/parcelo/refunds.py	2026-11-12 02:52:12
@@ -0,0 +1,42 @@
+"""Record refunds against invoices that have already been paid."""
+
+from parcelo import audit, clock, ids
+from parcelo.errors import DomainError
+from parcelo.models import Refund
+from parcelo.money import Money
+from parcelo.store import db
+
+
+def create_refund(invoice_id: str, amount: object) -> Refund:
+    """Create and store a refund against a paid invoice.
+
+    Args:
+        invoice_id: Id of the invoice being refunded. Must be paid.
+        amount: Refund amount in dollars. Accepts float, int, str, Decimal or Money.
+
+    Returns:
+        The stored Refund.
+
+    Raises:
+        DomainError: E_NOT_FOUND if the invoice does not exist, E_BAD_STATE if it
+            is not paid, E_BAD_INPUT if the amount is not positive.
+    """
+    if invoice_id not in db.invoices:
+        raise DomainError("E_NOT_FOUND", invoice_id)
+    invoice = db.invoices[invoice_id]
+    if invoice.status != "paid":
+        raise DomainError("E_BAD_STATE", f"invoice {invoice_id} is {invoice.status}")
+
+    value = Money.parse(amount)
+    if value.cents <= 0:
+        raise DomainError("E_BAD_INPUT", str(amount))
+
+    refund = Refund(
+        id=ids.new_id("ref"),
+        invoice_id=invoice_id,
+        amount=value,
+        created_at=clock.now(),
+    )
+    db.refunds[refund.id] = refund
+    audit.record("refund.created", refund.id, invoice_id=invoice_id)
+    return refund
