diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/test_reports.py b/tests/test_reports.py
--- a/tests/test_reports.py	1969-12-31 19:00:00
+++ b/tests/test_reports.py	2026-11-12 03:16:34
@@ -0,0 +1,20 @@
+from parcelo import customers, invoices, reports, shipments
+
+
+def test_shipments_without_invoice():
+    c = customers.add_customer("Acme")
+    billed = shipments.create_shipment(c.id, 2, "local")
+    unbilled = shipments.create_shipment(c.id, 3, "national")
+    invoices.issue_invoice(billed.id)
+
+    result = reports.shipments_without_invoice()
+
+    assert [s.id for s in result] == [unbilled.id]
+
+
+def test_shipments_without_invoice_none_when_all_billed():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 2, "local")
+    invoices.issue_invoice(s.id)
+
+    assert reports.shipments_without_invoice() == []
