+from parcelo import audit, clock, customers, shipments
 from parcelo.errors import DomainError
 
 
@@ -15,3 +17,39 @@
     with pytest.raises(DomainError) as err:
         shipments.create_shipment("nope", 1, "local")
     assert err.value.code == "E_UNKNOWN_CUSTOMER"
+
+
+def _shipment():
+    c = customers.add_customer("Acme")
+    return shipments.create_shipment(c.id, 1.5, "national")
+
+
+def test_add_note_appends_timestamped_note():
+    s = _shipment()
+    moment = datetime(2026, 11, 12, 9, 30, tzinfo=timezone.utc)
+    clock.set_fixed(moment)
+    result = shipments.add_note(s.id, "left at front desk")
+    assert result is s
+    assert s.notes == [{"text": "left at front desk", "at": moment}]
+
+
+def test_add_note_keeps_order():
+    s = _shipment()
+    shipments.add_note(s.id, "first")
+    shipments.add_note(s.id, "second")
+    assert [n["text"] for n in s.notes] == ["first", "second"]
+
+
+def test_add_note_unknown_shipment():
+    with pytest.raises(DomainError) as err:
+        shipments.add_note("shp_missing", "hi")
+    assert err.value.code == "E_NOT_FOUND"
+
+
+@pytest.mark.parametrize("text", ["", "   ", None])
+def test_add_note_rejects_empty_text(text):
+    s = _shipment()
+    with pytest.raises(DomainError) as err:
+        shipments.add_note(s.id, text)
+    assert err.value.code == "E_BAD_INPUT"
+    assert s.notes == []
