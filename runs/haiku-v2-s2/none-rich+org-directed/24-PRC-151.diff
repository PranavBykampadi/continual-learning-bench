diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/parcelo/shipments.py b/parcelo/shipments.py
--- a/parcelo/shipments.py	2026-11-10 12:20:18
+++ b/parcelo/shipments.py	2026-11-12 03:07:35
@@ -28,3 +28,20 @@
     if shipment_id not in db.shipments:
         raise DomainError("E_NOT_FOUND", shipment_id)
     return db.shipments[shipment_id]
+
+
+def list_shipments(customer_id: str) -> list[Shipment]:
+    """Return every shipment belonging to a customer, in creation order.
+
+    Args:
+        customer_id: The id of the customer whose shipments to list.
+
+    Returns:
+        A list of Shipment objects. Empty if the customer has none.
+
+    Raises:
+        DomainError: With code E_UNKNOWN_CUSTOMER if the customer does not exist.
+    """
+    if customer_id not in db.customers:
+        raise DomainError("E_UNKNOWN_CUSTOMER", customer_id)
+    return [s for s in db.shipments.values() if s.customer_id == customer_id]
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_shipments.py b/tests/unit/test_shipments.py
--- a/tests/unit/test_shipments.py	2026-11-10 12:20:18
+++ b/tests/unit/test_shipments.py	2026-11-12 03:07:37
@@ -15,3 +15,23 @@
     with pytest.raises(DomainError) as err:
         shipments.create_shipment("nope", 1, "local")
     assert err.value.code == "E_UNKNOWN_CUSTOMER"
+
+
+def test_list_shipments_returns_only_that_customers():
+    acme = customers.add_customer("Acme")
+    other = customers.add_customer("Other")
+    a1 = shipments.create_shipment(acme.id, 1.5, "national")
+    shipments.create_shipment(other.id, 2.0, "national")
+    a2 = shipments.create_shipment(acme.id, 3.0, "local")
+    assert shipments.list_shipments(acme.id) == [a1, a2]
+
+
+def test_list_shipments_empty_when_none():
+    c = customers.add_customer("Acme")
+    assert shipments.list_shipments(c.id) == []
+
+
+def test_list_shipments_unknown_customer():
+    with pytest.raises(DomainError) as err:
+        shipments.list_shipments("nope")
+    assert err.value.code == "E_UNKNOWN_CUSTOMER"
