diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/parcelo/shipments.py b/parcelo/shipments.py
--- a/parcelo/shipments.py	2026-11-10 12:20:18
+++ b/parcelo/shipments.py	2026-11-12 03:00:21
@@ -28,3 +28,33 @@
     if shipment_id not in db.shipments:
         raise DomainError("E_NOT_FOUND", shipment_id)
     return db.shipments[shipment_id]
+
+
+def reassign_shipment(shipment_id: str, new_customer_id: str) -> Shipment:
+    """Move a shipment to a different customer, e.g. when support booked it under the wrong one.
+
+    Args:
+        shipment_id: ID of the shipment to reassign.
+        new_customer_id: ID of the customer who should own the shipment.
+
+    Returns:
+        The updated shipment.
+
+    Raises:
+        DomainError: E_NOT_FOUND if the shipment does not exist, E_UNKNOWN_CUSTOMER if the
+            new customer does not exist, E_BAD_STATE if the shipment has already been delivered.
+    """
+    shipment = get_shipment(shipment_id)
+    if new_customer_id not in db.customers:
+        raise DomainError("E_UNKNOWN_CUSTOMER", new_customer_id)
+    if shipment.status == "delivered" or shipment.delivered_at is not None:
+        raise DomainError("E_BAD_STATE", shipment_id)
+    old_customer_id = shipment.customer_id
+    shipment.customer_id = new_customer_id
+    events.emit(
+        "shipment.reassigned",
+        shipment.id,
+        from_customer_id=old_customer_id,
+        to_customer_id=new_customer_id,
+    )
+    return shipment
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_shipments.py b/tests/unit/test_shipments.py
--- a/tests/unit/test_shipments.py	2026-11-10 12:20:18
+++ b/tests/unit/test_shipments.py	2026-11-12 03:00:22
@@ -15,3 +15,43 @@
     with pytest.raises(DomainError) as err:
         shipments.create_shipment("nope", 1, "local")
     assert err.value.code == "E_UNKNOWN_CUSTOMER"
+
+
+def test_reassign_shipment_changes_customer_and_emits_event():
+    a = customers.add_customer("Acme")
+    b = customers.add_customer("Globex")
+    s = shipments.create_shipment(a.id, 2, "national")
+    result = shipments.reassign_shipment(s.id, b.id)
+    assert result is s
+    assert s.customer_id == b.id
+    event = events.OUTBOX[-1]
+    assert event["name"] == "shipment.reassigned"
+    assert event["entity_id"] == s.id
+    assert event["payload"] == {"from_customer_id": a.id, "to_customer_id": b.id}
+
+
+def test_reassign_unknown_shipment():
+    b = customers.add_customer("Globex")
+    with pytest.raises(DomainError) as err:
+        shipments.reassign_shipment("shp_missing", b.id)
+    assert err.value.code == "E_NOT_FOUND"
+
+
+def test_reassign_to_unknown_customer():
+    a = customers.add_customer("Acme")
+    s = shipments.create_shipment(a.id, 2, "national")
+    with pytest.raises(DomainError) as err:
+        shipments.reassign_shipment(s.id, "C_nope")
+    assert err.value.code == "E_UNKNOWN_CUSTOMER"
+    assert s.customer_id == a.id
+
+
+def test_reassign_delivered_shipment_fails():
+    a = customers.add_customer("Acme")
+    b = customers.add_customer("Globex")
+    s = shipments.create_shipment(a.id, 2, "national")
+    s.status = "delivered"
+    with pytest.raises(DomainError) as err:
+        shipments.reassign_shipment(s.id, b.id)
+    assert err.value.code == "E_BAD_STATE"
+    assert s.customer_id == a.id
