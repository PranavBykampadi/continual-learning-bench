 import pytest
 
 from parcelo import rates
+from parcelo.errors import DomainError
 
 
 def test_quote_local():
@@ -10,3 +11,42 @@
 def test_unknown_zone():
     with pytest.raises(ValueError):
         rates.base_rate("moon")
+
+
+def test_insurance_fee_local():
+    # 2% + 0% fuel surcharge
+    assert rates.insurance_fee(1000, "local") == 20.0
+
+
+def test_insurance_fee_national():
+    # 2% + 4% fuel surcharge
+    assert rates.insurance_fee(100, "national") == 6.0
+
+
+def test_insurance_fee_international():
+    # 2% + 9.5% fuel surcharge
+    assert rates.insurance_fee(100, "international") == 11.5
+
+
+def test_insurance_fee_minimum():
+    assert rates.insurance_fee(10, "local") == 1.0
+
+
+def test_insurance_fee_rounds_to_cents():
+    # 33.33 * 0.02 = 0.6666 -> minimum applies
+    assert rates.insurance_fee(33.33, "local") == 1.0
+    # 333.33 * 0.06 = 19.9998 -> 20.00
+    assert rates.insurance_fee(333.33, "national") == 20.0
+
+
+def test_insurance_fee_unknown_zone():
+    with pytest.raises(DomainError) as exc:
+        rates.insurance_fee(100, "moon")
+    assert exc.value.code == "E_BAD_ZONE"
+
+
+@pytest.mark.parametrize("value", [0, -5])
+def test_insurance_fee_non_positive_value(value):
