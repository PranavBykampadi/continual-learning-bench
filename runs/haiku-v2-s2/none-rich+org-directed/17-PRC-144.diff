+from parcelo.errors import DomainError
+
 ZONE_BASE = {"local": 4.5, "national": 9.0, "international": 24.0}
 PER_KG = 1.25
 
+# Fuel surcharge percentage by zone. Same values as fuel_surcharge in
+# parcelo/legacy/billing.py; kept here because new code must not import legacy.
+# Finance owns these numbers.
+FUEL_SURCHARGE_PCT = {"local": 0.0, "national": 4.0, "international": 9.5}
+INSURANCE_RATE_PCT = 2.0
+INSURANCE_MIN_FEE = 1.00
 
+
 def base_rate(zone):
     if zone not in ZONE_BASE:
         raise ValueError("unknown zone: %s" % zone)
@@ -12,3 +21,30 @@
     if weight_kg <= 0:
         raise ValueError("weight must be positive")
     return round(base_rate(zone) + PER_KG * weight_kg, 2)
+
+
+def insurance_fee(declared_value: float, zone: str) -> float:
+    """Return the insurance fee for a shipment with a declared value.
+
+    The fee is 2% of the declared value plus the zone's fuel surcharge
+    percentage of the declared value, with a minimum fee of 1.00. It is
+    rounded to cents only at the end.
+
+    Args:
+        declared_value: Declared value of the shipment in dollars. Must be positive.
+        zone: One of the keys in FUEL_SURCHARGE_PCT.
+
+    Returns:
+        The insurance fee in dollars, rounded to cents.
+
+    Raises:
+        DomainError: E_BAD_ZONE if the zone is unknown, or E_BAD_INPUT if the
+            declared value is not positive.
+    """
+    if zone not in FUEL_SURCHARGE_PCT:
+        raise DomainError("E_BAD_ZONE", f"unknown zone: {zone}")
+    if declared_value <= 0:
+        raise DomainError("E_BAD_INPUT", "declared value must be positive")
+    pct = INSURANCE_RATE_PCT + FUEL_SURCHARGE_PCT[zone]
+    fee = declared_value * pct / 100.0
+    return round(max(fee, INSURANCE_MIN_FEE), 2)
