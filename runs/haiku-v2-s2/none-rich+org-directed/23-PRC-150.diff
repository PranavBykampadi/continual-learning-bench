diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/test_customers.py b/tests/test_customers.py
--- a/tests/test_customers.py	1969-12-31 19:00:00
+++ b/tests/test_customers.py	2026-11-12 03:07:04
@@ -0,0 +1,42 @@
+import pytest
+
+from parcelo import customers, events, store
+from parcelo.errors import DomainError
+
+
+@pytest.fixture(autouse=True)
+def clean_state():
+    store.reset()
+    events.OUTBOX.clear()
+    yield
+
+
+def test_set_credit_limit_updates_and_returns_new_limit():
+    c = customers.add_customer("Acme")
+    assert customers.set_credit_limit(c.id, 1200.0) == 1200.0
+    assert customers.get_customer(c.id).credit_limit == 1200.0
+
+
+def test_set_credit_limit_emits_event():
+    c = customers.add_customer("Acme")
+    customers.set_credit_limit(c.id, 750)
+    assert events.OUTBOX[-1]["name"] == "customer.credit_limit_changed"
+    assert events.OUTBOX[-1]["entity_id"] == c.id
+    assert events.OUTBOX[-1]["payload"] == {"limit": 750}
+
+
+def test_set_credit_limit_unknown_customer():
+    with pytest.raises(DomainError) as err:
+        customers.set_credit_limit("nope", 100)
+    assert err.value.code == "E_UNKNOWN_CUSTOMER"
+    assert events.OUTBOX == []
+
+
+def test_set_credit_limit_negative_amount_rejected():
+    c = customers.add_customer("Acme")
+    before = customers.get_customer(c.id).credit_limit
+    with pytest.raises(DomainError) as err:
+        customers.set_credit_limit(c.id, -1)
+    assert err.value.code == "E_BAD_INPUT"
+    assert customers.get_customer(c.id).credit_limit == before
+    assert events.OUTBOX == []
