diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_returns.py b/tests/unit/test_returns.py
--- a/tests/unit/test_returns.py	1969-12-31 19:00:00
+++ b/tests/unit/test_returns.py	2026-11-12 03:02:26
@@ -0,0 +1,64 @@
+import pytest
+
+from parcelo import customers, events, returns, shipments
+from parcelo.errors import DomainError
+from parcelo.settings import MAX_RETURNS_PER_SHIPMENT
+from parcelo.store import db
+
+
+def _delivered_shipment():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 2.0, "national")
+    db.shipments[s.id].status = "delivered"
+    return s
+
+
+def test_request_return_creates_and_stores():
+    s = _delivered_shipment()
+    r = returns.request_return(s.id, "damaged")
+    assert r.id.startswith("ret_")
+    assert r.shipment_id == s.id
+    assert r.reason == "damaged"
+    assert r.requested_at is not None
+    assert returns.returns_for(s.id) == [r]
+
+
+def test_request_return_emits_event():
+    s = _delivered_shipment()
+    r = returns.request_return(s.id, "damaged")
+    assert events.OUTBOX[-1]["name"] == "return.requested"
+    assert events.OUTBOX[-1]["entity_id"] == r.id
+
+
+def test_unknown_shipment_fails():
+    with pytest.raises(DomainError) as err:
+        returns.request_return("shp_missing", "damaged")
+    assert err.value.code == "E_NOT_FOUND"
+
+
+def test_undelivered_shipment_fails():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 2.0, "national")
+    with pytest.raises(DomainError) as err:
+        returns.request_return(s.id, "damaged")
+    assert err.value.code == "E_BAD_STATE"
+    assert returns.returns_for(s.id) == []
+
+
+def test_limit_per_shipment():
+    assert MAX_RETURNS_PER_SHIPMENT == 3
+    s = _delivered_shipment()
+    for i in range(MAX_RETURNS_PER_SHIPMENT):
+        returns.request_return(s.id, f"reason {i}")
+    with pytest.raises(DomainError) as err:
+        returns.request_return(s.id, "one too many")
+    assert err.value.code == "E_LIMIT"
+    assert len(returns.returns_for(s.id)) == MAX_RETURNS_PER_SHIPMENT
+
+
+def test_returns_for_sorted_by_id():
+    s = _delivered_shipment()
+    for i in range(3):
+        returns.request_return(s.id, f"reason {i}")
+    ids_ = [r.id for r in returns.returns_for(s.id)]
+    assert ids_ == sorted(ids_)
