diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/parcelo/returns.py b/parcelo/returns.py
--- a/parcelo/returns.py	1969-12-31 19:00:00
+++ b/parcelo/returns.py	2026-11-12 03:02:20
@@ -0,0 +1,27 @@
+from parcelo import clock, events, ids, settings
+from parcelo.errors import DomainError
+from parcelo.models import ReturnRequest
+from parcelo.shipments import get_shipment
+from parcelo.store import db
+
+
+def request_return(shipment_id, reason):
+    shipment = get_shipment(shipment_id)  # raises E_NOT_FOUND
+    if shipment.status != "delivered":
+        raise DomainError("E_BAD_STATE", f"{shipment_id} is not delivered")
+    if len(returns_for(shipment_id)) >= settings.MAX_RETURNS_PER_SHIPMENT:
+        raise DomainError("E_LIMIT", f"{shipment_id} already has the maximum returns")
+    request = ReturnRequest(
+        id=ids.new_id("ret"),
+        shipment_id=shipment_id,
+        reason=reason,
+        requested_at=clock.now(),
+    )
+    db.returns[request.id] = request
+    events.emit("return.requested", request.id, shipment_id=shipment_id, reason=reason)
+    return request
+
+
+def returns_for(shipment_id):
+    found = [r for r in db.returns.values() if r.shipment_id == shipment_id]
+    return sorted(found, key=lambda r: r.id)
