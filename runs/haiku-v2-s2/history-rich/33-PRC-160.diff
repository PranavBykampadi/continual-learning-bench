diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/parcelo/shipments.py b/parcelo/shipments.py
--- a/parcelo/shipments.py	2026-11-10 12:20:18
+++ b/parcelo/shipments.py	2026-11-12 03:02:58
@@ -28,3 +28,16 @@
     if shipment_id not in db.shipments:
         raise DomainError("E_NOT_FOUND", shipment_id)
     return db.shipments[shipment_id]
+
+
+def mark_returned(shipment_id):
+    shipment = get_shipment(shipment_id)
+    if shipment.status == "returned":
+        # Idempotent: callers retry on timeouts, so a repeat call changes nothing.
+        return shipment
+    if shipment.status == "created":
+        raise DomainError("E_BAD_STATE", shipment_id)
+    shipment.status = "returned"
+    shipment.returned_at = clock.now()
+    events.emit("shipment.returned", shipment.id, returned_at=shipment.returned_at.isoformat())
+    return shipment
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_mark_returned.py b/tests/unit/test_mark_returned.py
--- a/tests/unit/test_mark_returned.py	1969-12-31 19:00:00
+++ b/tests/unit/test_mark_returned.py	2026-11-12 03:03:02
@@ -0,0 +1,63 @@
+from datetime import datetime, timezone
+
+import pytest
+
+from parcelo import clock, customers, events, shipments
+from parcelo.errors import DomainError
+from parcelo.store import db
+
+
+def _shipment(status="created"):
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 1.5, "national")
+    s.status = status
+    return s
+
+
+def test_mark_returned_sets_status_and_time():
+    moment = datetime(2026, 11, 12, 9, 30, tzinfo=timezone.utc)
+    clock.set_fixed(moment)
+    s = _shipment(status="delivered")
+    result = shipments.mark_returned(s.id)
+    assert result is s
+    assert s.status == "returned"
+    assert s.returned_at == moment
+
+
+def test_mark_returned_emits_event_not_audit():
+    s = _shipment(status="delivered")
+    events.OUTBOX.clear()
+    shipments.mark_returned(s.id)
+    assert len(events.OUTBOX) == 1
+    assert events.OUTBOX[-1]["name"] == "shipment.returned"
+    assert events.OUTBOX[-1]["entity_id"] == s.id
+
+
+def test_mark_returned_twice_is_noop():
+    s = _shipment(status="delivered")
+    shipments.mark_returned(s.id)
+    first_time = s.returned_at
+    events.OUTBOX.clear()
+    again = shipments.mark_returned(s.id)
+    assert again is s
+    assert s.status == "returned"
+    assert s.returned_at == first_time
+    assert events.OUTBOX == []
+
+
+def test_created_shipment_cannot_be_returned():
+    s = _shipment(status="created")
+    events.OUTBOX.clear()
+    with pytest.raises(DomainError) as err:
+        shipments.mark_returned(s.id)
+    assert err.value.code == "E_BAD_STATE"
+    assert s.status == "created"
+    assert s.returned_at is None
+    assert events.OUTBOX == []
+
+
+def test_unknown_shipment_fails():
+    with pytest.raises(DomainError) as err:
+        shipments.mark_returned("shp_missing")
+    assert err.value.code == "E_NOT_FOUND"
+    assert "shp_missing" not in db.shipments
