diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_reports.py b/tests/unit/test_reports.py
--- a/tests/unit/test_reports.py	1969-12-31 19:00:00
+++ b/tests/unit/test_reports.py	2026-11-12 02:51:49
@@ -0,0 +1,50 @@
+from parcelo import customers, invoices, reports, shipments
+from parcelo.money import Money
+
+
+def _invoiced(customer_id, weight, zone="local"):
+    s = shipments.create_shipment(customer_id, weight, zone)
+    return invoices.issue_invoice(s.id)
+
+
+def test_outstanding_sums_open_invoices_per_customer():
+    a = customers.add_customer("Acme")
+    b = customers.add_customer("Beta")
+    inv1 = _invoiced(a.id, 1.0)
+    inv2 = _invoiced(a.id, 2.0)
+    inv3 = _invoiced(b.id, 3.0)
+
+    result = reports.outstanding_by_customer()
+
+    expected_a = Money.parse(inv1.amount) + Money.parse(inv2.amount)
+    assert result[a.id] == expected_a
+    assert result[b.id] == Money.parse(inv3.amount)
+    assert all(isinstance(v, Money) for v in result.values())
+
+
+def test_paid_and_void_invoices_are_excluded():
+    a = customers.add_customer("Acme")
+    paid = _invoiced(a.id, 1.0)
+    voided = _invoiced(a.id, 2.0)
+    still_open = _invoiced(a.id, 4.0)
+    invoices.mark_paid(paid.id)
+    voided.status = "void"
+
+    result = reports.outstanding_by_customer()
+
+    assert result[a.id] == Money.parse(still_open.amount)
+
+
+def test_customer_with_nothing_open_maps_to_zero():
+    a = customers.add_customer("Acme")
+    b = customers.add_customer("Beta")
+    _invoiced(a.id, 1.0)
+    invoices.mark_paid(_invoiced(b.id, 1.0).id)
+
+    result = reports.outstanding_by_customer()
+
+    assert result[b.id] == Money.zero()
+
+
+def test_empty_store_returns_empty_dict():
+    assert reports.outstanding_by_customer() == {}
