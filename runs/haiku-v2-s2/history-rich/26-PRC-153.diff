+def needs_review(customer_id):
+    """True when the customer has more than 3 open invoices or their open total is over 250.00."""
+    if customer_id not in db.customers:
+        raise DomainError("E_UNKNOWN_CUSTOMER", customer_id)
+    open_count = 0
+    open_total = Money.zero()
+    for invoice in db.invoices.values():
+        shipment = db.shipments[invoice.shipment_id]
+        if shipment.customer_id == customer_id and invoice.status == "open":
+            open_count += 1
+            open_total = open_total + Money.parse(invoice.amount)
+    return open_count > REVIEW_MAX_OPEN_INVOICES or REVIEW_MAX_OPEN_TOTAL < open_total
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_customers_review.py b/tests/unit/test_customers_review.py
--- a/tests/unit/test_customers_review.py	1969-12-31 19:00:00
+++ b/tests/unit/test_customers_review.py	2026-11-12 03:00:30
@@ -0,0 +1,71 @@
+import pytest
+
+from parcelo import customers, store
+from parcelo.errors import DomainError
+from parcelo.models import Invoice, Shipment
+
+
+def _add_invoice(customer_id, amount, status="open"):
+    n = len(store.db.invoices) + 1
+    shipment_id = f"shp_test_{n}"
+    store.db.shipments[shipment_id] = Shipment(
+        id=shipment_id, customer_id=customer_id, weight_kg=1.0, zone="local"
+    )
+    invoice_id = f"inv_test_{n}"
+    store.db.invoices[invoice_id] = Invoice(
+        id=invoice_id, shipment_id=shipment_id, amount=amount, status=status
+    )
+
+
+def test_no_open_invoices_is_not_flagged():
+    c = customers.add_customer("Acme")
+    assert customers.needs_review(c.id) is False
+
+
+def test_three_open_invoices_small_total_is_not_flagged():
+    c = customers.add_customer("Acme")
+    for _ in range(3):
+        _add_invoice(c.id, 10.0)
+    assert customers.needs_review(c.id) is False
+
+
+def test_more_than_three_open_invoices_is_flagged():
+    c = customers.add_customer("Acme")
+    for _ in range(4):
+        _add_invoice(c.id, 1.0)
+    assert customers.needs_review(c.id) is True
+
+
+def test_total_exactly_250_is_not_flagged():
+    c = customers.add_customer("Acme")
+    _add_invoice(c.id, 150.00)
+    _add_invoice(c.id, 100.00)
+    assert customers.needs_review(c.id) is False
+
+
+def test_total_over_250_is_flagged():
+    c = customers.add_customer("Acme")
+    _add_invoice(c.id, 150.00)
+    _add_invoice(c.id, 100.01)
+    assert customers.needs_review(c.id) is True
+
+
+def test_paid_invoices_are_ignored():
+    c = customers.add_customer("Acme")
+    for _ in range(5):
+        _add_invoice(c.id, 500.0, status="paid")
+    assert customers.needs_review(c.id) is False
+
+
+def test_other_customers_invoices_are_ignored():
+    c = customers.add_customer("Acme")
+    other = customers.add_customer("Other")
+    for _ in range(4):
+        _add_invoice(other.id, 1000.0)
+    assert customers.needs_review(c.id) is False
+
+
+def test_unknown_customer_raises():
+    with pytest.raises(DomainError) as err:
+        customers.needs_review("C_missing")
+    assert err.value.code == "E_UNKNOWN_CUSTOMER"
