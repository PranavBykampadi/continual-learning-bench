diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_reports.py b/tests/unit/test_reports.py
--- a/tests/unit/test_reports.py	1969-12-31 19:00:00
+++ b/tests/unit/test_reports.py	2026-11-12 02:58:19
@@ -0,0 +1,41 @@
+from parcelo import customers, reports, shipments
+from parcelo.store import db
+
+
+def _add_shipments(customer_id, n):
+    for _ in range(n):
+        shipments.create_shipment(customer_id, 1.0, "local")
+
+
+def test_volume_report_includes_customers_without_shipments():
+    c = customers.add_customer("Idle")
+    report = reports.volume_report()
+    assert report == {c.id: {"shipments": 0, "tier": "starter"}}
+
+
+def test_volume_report_counts_per_customer():
+    a = customers.add_customer("Acme")
+    b = customers.add_customer("Bolt")
+    _add_shipments(a.id, 3)
+    _add_shipments(b.id, 1)
+    report = reports.volume_report()
+    assert report[a.id] == {"shipments": 3, "tier": "starter"}
+    assert report[b.id] == {"shipments": 1, "tier": "starter"}
+
+
+def test_volume_report_tier_thresholds():
+    regular = customers.add_customer("Regular")
+    bulk = customers.add_customer("Bulk")
+    _add_shipments(regular.id, 10)
+    _add_shipments(bulk.id, 50)
+    report = reports.volume_report()
+    assert report[regular.id]["tier"] == "regular"
+    assert report[bulk.id]["tier"] == "bulk"
+
+
+def test_volume_report_does_not_mutate_state():
+    c = customers.add_customer("Acme")
+    _add_shipments(c.id, 2)
+    before = len(db.shipments)
+    reports.volume_report()
+    assert len(db.shipments) == before
