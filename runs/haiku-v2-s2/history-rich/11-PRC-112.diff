diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/parcelo/claims.py b/parcelo/claims.py
--- a/parcelo/claims.py	1969-12-31 19:00:00
+++ b/parcelo/claims.py	2026-11-12 02:53:47
@@ -0,0 +1,31 @@
+from parcelo import audit, clock, ids
+from parcelo.errors import DomainError
+from parcelo.models import Claim
+from parcelo.money import Money
+from parcelo.store import db
+
+
+def file_claim(shipment_id, amount, reason):
+    if shipment_id not in db.shipments:
+        raise DomainError("E_NOT_FOUND", str(shipment_id))
+    shipment = db.shipments[shipment_id]
+    if shipment.status != "delivered":
+        raise DomainError("E_BAD_STATE", f"shipment {shipment_id} is {shipment.status}")
+    if not isinstance(reason, str) or not reason.strip():
+        raise DomainError("E_BAD_INPUT", "reason required")
+    try:
+        money = Money.parse(amount)
+    except (ArithmeticError, TypeError, ValueError):
+        raise DomainError("E_BAD_INPUT", f"bad amount: {amount!r}")
+    if money.cents <= 0:
+        raise DomainError("E_BAD_INPUT", f"amount must be positive: {amount!r}")
+    claim = Claim(
+        id=ids.new_id("clm"),
+        shipment_id=shipment_id,
+        amount=money,
+        reason=reason,
+        filed_at=clock.now(),
+    )
+    db.claims[claim.id] = claim
+    audit.record("claim.filed", claim.id, shipment_id=shipment_id, amount_cents=money.cents)
+    return claim
