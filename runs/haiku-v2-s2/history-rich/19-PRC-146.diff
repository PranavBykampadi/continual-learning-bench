diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_invoice_write_off.py b/tests/unit/test_invoice_write_off.py
--- a/tests/unit/test_invoice_write_off.py	1969-12-31 19:00:00
+++ b/tests/unit/test_invoice_write_off.py	2026-11-12 02:58:02
@@ -0,0 +1,66 @@
+import pytest
+
+from parcelo import clock, customers, events, invoices, shipments
+from parcelo.errors import DomainError
+from parcelo.money import Money
+
+
+def _open_invoice():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 2, "local")
+    return invoices.issue_invoice(s.id)
+
+
+def test_write_off_open_invoice():
+    inv = _open_invoice()
+    amount = invoices.write_off(inv.id)
+    assert inv.status == "written_off"
+    assert inv.written_off_at is not None
+    assert isinstance(amount, Money)
+    assert amount == Money.parse(7.0)
+    assert amount.cents == 700
+
+
+def test_write_off_stamps_clock_time():
+    from datetime import datetime, timezone
+
+    moment = datetime(2026, 1, 2, 3, 4, 5, tzinfo=timezone.utc)
+    clock.set_fixed(moment)
+    try:
+        inv = _open_invoice()
+        invoices.write_off(inv.id)
+        assert inv.written_off_at == moment
+    finally:
+        clock.clear_fixed()
+
+
+def test_write_off_emits_event_with_invoice_id():
+    inv = _open_invoice()
+    invoices.write_off(inv.id)
+    assert events.OUTBOX[-1]["name"] == "invoice.written_off"
+    assert events.OUTBOX[-1]["entity_id"] == inv.id
+    assert events.OUTBOX[-1]["payload"] == {"amount_cents": 700}
+
+
+def test_write_off_paid_invoice_rejected():
+    inv = _open_invoice()
+    invoices.mark_paid(inv.id)
+    with pytest.raises(DomainError) as err:
+        invoices.write_off(inv.id)
+    assert err.value.code == "E_BAD_STATE"
+    assert inv.status == "paid"
+    assert inv.written_off_at is None
+
+
+def test_write_off_twice_rejected():
+    inv = _open_invoice()
+    invoices.write_off(inv.id)
+    with pytest.raises(DomainError) as err:
+        invoices.write_off(inv.id)
+    assert err.value.code == "E_BAD_STATE"
+
+
+def test_write_off_unknown_invoice():
+    with pytest.raises(DomainError) as err:
+        invoices.write_off("INV-missing")
+    assert err.value.code == "E_NOT_FOUND"
