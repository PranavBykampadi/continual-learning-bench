-from datetime import datetime
+from datetime import datetime, timezone
 
+from parcelo import clock
+from parcelo.errors import DomainError
+from parcelo.money import Money
 from parcelo.store import db
+
+
+def _as_utc(moment):
+    # invoices.py stores naive UTC datetimes; clock.now() is timezone-aware.
+    if moment.tzinfo is None:
+        return moment.replace(tzinfo=timezone.utc)
+    return moment.astimezone(timezone.utc)
+
+
+def _age_days(issued_at, now):
+    """Whole days between issue and now, never negative."""
+    return max((_as_utc(now) - _as_utc(issued_at)).days, 0)
+
+
+def aging_report():
+    now = clock.now()
+    buckets = {"0-30": Money.zero(), "31-60": Money.zero(), "60+": Money.zero()}
+    for invoice in db.invoices.values():
+        if invoice.status != "open":
+            continue
+        if invoice.issued_at is None:
+            raise DomainError("E_BAD_STATE", f"invoice {invoice.id} has no issue date")
+        age = _age_days(invoice.issued_at, now)
+        if age <= 30:
+            key = "0-30"
+        elif age <= 60:
+            key = "31-60"
+        else:
+            key = "60+"
+        buckets[key] = buckets[key] + Money.parse(invoice.amount)
+    return buckets
 
 
