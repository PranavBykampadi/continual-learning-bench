--- a/tests/unit/test_aging_report.py	1969-12-31 19:00:00
+++ b/tests/unit/test_aging_report.py	2026-11-12 02:55:37
@@ -0,0 +1,79 @@
+from datetime import datetime, timedelta, timezone
+
+import pytest
+
+from parcelo import clock, reports
+from parcelo.errors import DomainError
+from parcelo.models import Invoice
+from parcelo.money import Money
+from parcelo.store import db
+
+NOW = datetime(2026, 11, 12, 12, 0, tzinfo=timezone.utc)
+
+
+@pytest.fixture(autouse=True)
+def fixed_now():
+    clock.set_fixed(NOW)
+    yield
+    clock.clear_fixed()
+
+
+def _add(invoice_id, amount, days_old, status="open"):
+    db.invoices[invoice_id] = Invoice(
+        id=invoice_id,
+        shipment_id="shp_x",
+        amount=amount,
+        status=status,
+        issued_at=NOW - timedelta(days=days_old),
+    )
+
+
+def test_empty_buckets_are_zero():
+    report = reports.aging_report()
+    assert report == {
+        "0-30": Money.zero(),
+        "31-60": Money.zero(),
+        "60+": Money.zero(),
+    }
+
+
+def test_bucket_boundaries():
+    _add("a", 1.0, 0)
+    _add("b", 2.0, 30)
+    _add("c", 4.0, 31)
+    _add("d", 8.0, 60)
+    _add("e", 16.0, 61)
+    report = reports.aging_report()
+    assert report["0-30"] == Money.parse(3.0)
+    assert report["31-60"] == Money.parse(12.0)
+    assert report["60+"] == Money.parse(16.0)
+
+
+def test_paid_invoices_are_left_out():
+    _add("open", 5.0, 10)
+    _add("paid", 100.0, 10, status="paid")
+    assert reports.aging_report()["0-30"] == Money.parse(5.0)
+
+
+def test_totals_are_exact_money():
+    _add("a", 0.1, 1)
+    _add("b", 0.2, 1)
+    assert reports.aging_report()["0-30"].cents == 30
+
+
+def test_naive_issued_at_as_stored_by_invoices_module():
+    # invoices.issue_invoice stores datetime.utcnow(), which is naive UTC.
+    db.invoices["n"] = Invoice(
+        id="n",
+        shipment_id="shp_x",
+        amount=7.0,
+        issued_at=datetime(2026, 9, 1, 12, 0),  # 72 days before NOW
+    )
+    assert reports.aging_report()["60+"] == Money.parse(7.0)
+
+
+def test_open_invoice_without_issue_date_raises_domain_error():
+    db.invoices["x"] = Invoice(id="x", shipment_id="shp_x", amount=1.0, issued_at=None)
+    with pytest.raises(DomainError) as err:
+        reports.aging_report()
+    assert err.value.code == "E_BAD_STATE"
