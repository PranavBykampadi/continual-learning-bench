 def open_invoices():
     return [i for i in db.invoices.values() if i.status == "open"]
+
+
+def apply_credit(invoice_id, amount):
+    """Reduce an open invoice by a credit and return the remaining amount as Money."""
+    if invoice_id not in db.invoices:
+        raise DomainError("E_NOT_FOUND", invoice_id)
+    invoice = db.invoices[invoice_id]
+    if invoice.status != "open":
+        raise DomainError("E_BAD_STATE", f"{invoice_id} is {invoice.status}")
+    credit = Money.parse(amount)
+    if credit.cents <= 0:
+        raise DomainError("E_BAD_INPUT", f"credit must be positive, got {amount}")
+    current = Money.parse(invoice.amount)
+    if current < credit:
+        raise DomainError("E_BAD_INPUT", f"credit {credit} exceeds invoice amount {current}")
+    remaining = current - credit
+    # Reports and customer balances sum invoice.amount as float dollars,
+    # so the stored value stays a float; the arithmetic itself is done in Money.
+    invoice.amount = remaining.cents / 100
+    audit.record(
+        "invoice.credit_applied",
+        invoice.id,
+        credit_cents=credit.cents,
+        remaining_cents=remaining.cents,
+    )
+    return remaining
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_invoice_credit.py b/tests/unit/test_invoice_credit.py
--- a/tests/unit/test_invoice_credit.py	1969-12-31 19:00:00
+++ b/tests/unit/test_invoice_credit.py	2026-11-12 02:54:39
@@ -0,0 +1,86 @@
+import pytest
+
+from parcelo import audit, customers, invoices, reports, shipments
+from parcelo.errors import DomainError
+from parcelo.money import Money
+
+
+def _open_invoice(weight_kg=2, zone="local"):
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, weight_kg, zone)
+    inv = invoices.issue_invoice(s.id)
+    return c, inv
+
+
+def test_apply_credit_reduces_amount_and_returns_remaining():
+    _, inv = _open_invoice()  # local, 2kg -> 7.00
+    remaining = invoices.apply_credit(inv.id, 2)
+    assert isinstance(remaining, Money)
+    assert remaining == Money(500)
+    assert inv.amount == 5.0
+    assert inv.status == "open"
+
+
+def test_apply_credit_accepts_string_and_float_amounts():
+    _, inv = _open_invoice()
+    invoices.apply_credit(inv.id, "1.25")
+    assert inv.amount == 5.75
+
+
+def test_credit_equal_to_amount_leaves_zero():
+    _, inv = _open_invoice()
+    remaining = invoices.apply_credit(inv.id, 7.0)
+    assert remaining == Money.zero()
+    assert inv.amount == 0.0
+
+
+def test_credit_is_audited_against_invoice_id():
+    _, inv = _open_invoice()
+    audit.LOG.clear()
+    invoices.apply_credit(inv.id, 2)
+    entry = audit.LOG[-1]
+    assert entry["action"] == "invoice.credit_applied"
+    assert entry["entity_id"] == inv.id
+    assert entry["details"] == {"credit_cents": 200, "remaining_cents": 500}
+
+
+def test_reports_and_balance_reflect_credit():
+    c, inv = _open_invoice()
+    invoices.apply_credit(inv.id, 2)
+    assert customers.outstanding_balance(c.id) == 5.0
+    invoices.mark_paid(inv.id)
+    assert reports.revenue_total() == 5.0
+
+
+def test_unknown_invoice_fails():
+    with pytest.raises(DomainError) as err:
+        invoices.apply_credit("INV-missing", 1)
+    assert err.value.code == "E_NOT_FOUND"
+
+
+def test_paid_invoice_fails_and_is_unchanged():
+    _, inv = _open_invoice()
+    invoices.mark_paid(inv.id)
+    with pytest.raises(DomainError) as err:
+        invoices.apply_credit(inv.id, 1)
+    assert err.value.code == "E_BAD_STATE"
+    assert inv.amount == 7.0
+
+
+def test_credit_larger_than_amount_fails_and_is_unchanged():
+    _, inv = _open_invoice()
+    audit.LOG.clear()
+    with pytest.raises(DomainError) as err:
+        invoices.apply_credit(inv.id, 7.01)
+    assert err.value.code == "E_BAD_INPUT"
+    assert inv.amount == 7.0
+    assert not any(e["action"] == "invoice.credit_applied" for e in audit.LOG)
+
+
+@pytest.mark.parametrize("bad", [0, -1])
+def test_non_positive_credit_fails(bad):
+    _, inv = _open_invoice()
+    with pytest.raises(DomainError) as err:
+        invoices.apply_credit(inv.id, bad)
+    assert err.value.code == "E_BAD_INPUT"
+    assert inv.amount == 7.0
