diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_reports_shipments_without_invoice.py b/tests/unit/test_reports_shipments_without_invoice.py
--- a/tests/unit/test_reports_shipments_without_invoice.py	1969-12-31 19:00:00
+++ b/tests/unit/test_reports_shipments_without_invoice.py	2026-11-12 03:04:54
@@ -0,0 +1,27 @@
+from parcelo import customers, ids, reports, shipments
+from parcelo.models import Invoice
+from parcelo.store import db
+
+
+def test_returns_only_shipments_without_invoice_sorted_by_id():
+    c = customers.add_customer("Acme")
+    s1 = shipments.create_shipment(c.id, 1.5, "national")
+    s2 = shipments.create_shipment(c.id, 2.0, "local")
+    s3 = shipments.create_shipment(c.id, 3.0, "international")
+    db.invoices["inv_x"] = Invoice(id="inv_x", shipment_id=s2.id, amount=10.0)
+
+    result = reports.shipments_without_invoice()
+
+    assert [s.id for s in result] == sorted([s1.id, s3.id])
+
+
+def test_empty_when_all_shipments_invoiced():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 1.5, "national")
+    db.invoices["inv_y"] = Invoice(id="inv_y", shipment_id=s.id, amount=10.0)
+
+    assert reports.shipments_without_invoice() == []
+
+
+def test_empty_when_no_shipments():
+    assert reports.shipments_without_invoice() == []
