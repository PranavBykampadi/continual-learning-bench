+
+
+LISTABLE_STATUSES = ("open", "paid")
+
+
+def invoices_by_status(status):
+    if status not in LISTABLE_STATUSES:
+        raise DomainError("E_BAD_INPUT", f"invalid invoice status {status!r}")
+    matches = [i for i in db.invoices.values() if i.status == status]
+    return sorted(matches, key=lambda i: i.id)
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_invoices_by_status.py b/tests/unit/test_invoices_by_status.py
--- a/tests/unit/test_invoices_by_status.py	1969-12-31 19:00:00
+++ b/tests/unit/test_invoices_by_status.py	2026-11-12 03:03:54
@@ -0,0 +1,35 @@
+import pytest
+
+from parcelo import invoices
+from parcelo.errors import DomainError
+from parcelo.models import Invoice
+from parcelo.store import db
+
+
+def _add(inv_id, status):
+    db.invoices[inv_id] = Invoice(id=inv_id, shipment_id="shp_x", amount=1.0, status=status)
+
+
+def test_returns_only_matching_status_sorted_by_id():
+    _add("INV-b", "open")
+    _add("INV-a", "open")
+    _add("INV-c", "paid")
+    assert [i.id for i in invoices.invoices_by_status("open")] == ["INV-a", "INV-b"]
+    assert [i.id for i in invoices.invoices_by_status("paid")] == ["INV-c"]
+
+
+def test_empty_when_none_match():
+    _add("INV-a", "open")
+    assert invoices.invoices_by_status("paid") == []
+
+
+def test_empty_when_no_invoices():
+    assert invoices.invoices_by_status("open") == []
+
+
+@pytest.mark.parametrize("bad", ["void", "", "OPEN", None, ["open"]])
+def test_invalid_status_raises(bad):
+    _add("INV-a", "open")
+    with pytest.raises(DomainError) as err:
+        invoices.invoices_by_status(bad)
+    assert err.value.code == "E_BAD_INPUT"
