diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_customer_lock.py b/tests/unit/test_customer_lock.py
--- a/tests/unit/test_customer_lock.py	1969-12-31 19:00:00
+++ b/tests/unit/test_customer_lock.py	2026-11-12 03:04:13
@@ -0,0 +1,38 @@
+import pytest
+
+from parcelo import customers, events
+from parcelo.errors import DomainError
+
+
+def test_new_customer_is_not_locked():
+    c = customers.add_customer("Acme")
+    assert c.locked is False
+
+
+def test_lock_customer_sets_flag_and_returns_customer():
+    c = customers.add_customer("Acme")
+    result = customers.lock_customer(c.id)
+    assert result is c
+    assert c.locked is True
+
+
+def test_lock_customer_emits_event():
+    c = customers.add_customer("Acme")
+    customers.lock_customer(c.id)
+    assert events.OUTBOX[-1]["name"] == "customer.locked"
+    assert events.OUTBOX[-1]["entity_id"] == c.id
+
+
+def test_lock_already_locked_customer_is_noop():
+    c = customers.add_customer("Acme")
+    customers.lock_customer(c.id)
+    events_before = len(events.OUTBOX)
+    result = customers.lock_customer(c.id)
+    assert result.locked is True
+    assert len(events.OUTBOX) == events_before
+
+
+def test_lock_unknown_customer_fails():
+    with pytest.raises(DomainError) as err:
+        customers.lock_customer("nope")
+    assert err.value.code == "E_UNKNOWN_CUSTOMER"
