+
+def add_note(shipment_id, text):
+    if not isinstance(text, str) or not text.strip():
+        raise DomainError("E_BAD_INPUT", "note text must be non-empty")
+    shipment = get_shipment(shipment_id)
+    shipment.notes.append({"text": text, "at": clock.now()})
+    audit.record("shipment.note_added", shipment.id)
+    return shipment
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_shipment_notes.py b/tests/unit/test_shipment_notes.py
--- a/tests/unit/test_shipment_notes.py	1969-12-31 19:00:00
+++ b/tests/unit/test_shipment_notes.py	2026-11-12 02:53:08
@@ -0,0 +1,60 @@
+from datetime import datetime, timezone
+
+import pytest
+
+from parcelo import audit, clock, customers, shipments
+from parcelo.errors import DomainError
+
+
+def _shipment():
+    c = customers.add_customer("Acme")
+    return shipments.create_shipment(c.id, 1.5, "national")
+
+
+def test_add_note_appends_text_and_time():
+    moment = datetime(2026, 1, 2, 3, 4, 5, tzinfo=timezone.utc)
+    clock.set_fixed(moment)
+    s = _shipment()
+
+    result = shipments.add_note(s.id, "left at front desk")
+
+    assert result is s
+    assert s.notes == [{"text": "left at front desk", "at": moment}]
+
+
+def test_add_note_keeps_order_and_separate_times():
+    first = datetime(2026, 1, 2, tzinfo=timezone.utc)
+    second = datetime(2026, 1, 3, tzinfo=timezone.utc)
+    s = _shipment()
+
+    clock.set_fixed(first)
+    shipments.add_note(s.id, "one")
+    clock.set_fixed(second)
+    shipments.add_note(s.id, "two")
+
+    assert [n["text"] for n in s.notes] == ["one", "two"]
+    assert [n["at"] for n in s.notes] == [first, second]
+
+
+def test_add_note_records_audit():
+    s = _shipment()
+    shipments.add_note(s.id, "hello")
+
+    entry = audit.LOG[-1]
+    assert entry["action"] == "shipment.note_added"
+    assert entry["entity_id"] == s.id
+
+
+def test_add_note_unknown_shipment():
+    with pytest.raises(DomainError) as err:
+        shipments.add_note("shp_missing", "hello")
+    assert err.value.code == "E_NOT_FOUND"
+
+
+@pytest.mark.parametrize("text", ["", "   ", None, 42])
+def test_add_note_rejects_empty_or_non_text(text):
+    s = _shipment()
+    with pytest.raises(DomainError) as err:
+        shipments.add_note(s.id, text)
+    assert err.value.code == "E_BAD_INPUT"
+    assert s.notes == []
