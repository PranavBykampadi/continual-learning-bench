+from decimal import Decimal
+
+from parcelo.errors import DomainError
+from parcelo.money import Money
+
 ZONE_BASE = {"local": 4.5, "national": 9.0, "international": 24.0}
 PER_KG = 1.25
 
+INSURANCE_RATE = Decimal("0.02")
+MIN_INSURANCE_FEE_CENTS = 100  # 1.00 USD
 
+# Fuel surcharge percentage per zone. Same values as the legacy billing table,
+# copied here because new code must not depend on parcelo.legacy.
+FUEL_SURCHARGE_PCT = {
+    "local": Decimal("0"),
+    "national": Decimal("4.0"),
+    "international": Decimal("9.5"),
+}
+
+
 def base_rate(zone):
     if zone not in ZONE_BASE:
         raise ValueError("unknown zone: %s" % zone)
@@ -12,3 +28,21 @@
     if weight_kg <= 0:
         raise ValueError("weight must be positive")
     return round(base_rate(zone) + PER_KG * weight_kg, 2)
+
+
+def insurance_fee(declared_value, zone):
+    """Insurance fee for a shipment with a declared value.
+
+    Fee = 2% of the declared value + the zone's fuel surcharge % of the declared
+    value, with a minimum fee of 1.00. Returns Money.
+    """
+    if zone not in FUEL_SURCHARGE_PCT:
+        raise DomainError("E_BAD_ZONE", "unknown zone: %s" % zone)
+    value = Money.parse(declared_value)
+    if value.cents <= 0:
+        raise DomainError("E_BAD_INPUT", "declared value must be positive")
+    factor = INSURANCE_RATE + FUEL_SURCHARGE_PCT[zone] / Decimal("100")
+    fee = value.scale(factor)
+    if fee.cents < MIN_INSURANCE_FEE_CENTS:
+        return Money(MIN_INSURANCE_FEE_CENTS, fee.currency)
+    return fee
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_insurance_fee.py b/tests/unit/test_insurance_fee.py
--- a/tests/unit/test_insurance_fee.py	1969-12-31 19:00:00
+++ b/tests/unit/test_insurance_fee.py	2026-11-12 02:57:22
@@ -0,0 +1,47 @@
+import pytest
+
+from parcelo import rates
+from parcelo.errors import DomainError
+from parcelo.money import Money
+
+
+def test_national_fee_is_two_plus_four_percent():
+    assert rates.insurance_fee(100.00, "national") == Money(600)
+
+
+def test_local_fee_is_two_percent_only():
+    assert rates.insurance_fee(100.00, "local") == Money(200)
+
+
+def test_international_fee_is_two_plus_nine_point_five_percent():
+    assert rates.insurance_fee(100.00, "international") == Money(1150)
+
+
+def test_minimum_fee_applies():
+    # 2% of 10.00 is 0.20, so the 1.00 minimum applies.
+    assert rates.insurance_fee(10.00, "local") == Money(100)
+
+
+def test_minimum_fee_applies_to_small_declared_value():
+    assert rates.insurance_fee(0.50, "international") == Money(100)
+
+
+def test_accepts_money_input():
+    assert rates.insurance_fee(Money(10000), "national") == Money(600)
+
+
+def test_returns_money():
+    assert isinstance(rates.insurance_fee(50.00, "local"), Money)
+
+
+def test_unknown_zone_raises_domain_error():
+    with pytest.raises(DomainError) as err:
+        rates.insurance_fee(100.00, "moon")
+    assert err.value.code == "E_BAD_ZONE"
+
+
+@pytest.mark.parametrize("value", [0, 0.0, -5, -0.01])
+def test_non_positive_declared_value_raises_domain_error(value):
+    with pytest.raises(DomainError) as err:
+        rates.insurance_fee(value, "national")
+    assert err.value.code == "E_BAD_INPUT"
