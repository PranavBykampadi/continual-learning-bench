+def escalate_invoice(invoice_id):
+    """Send a large unpaid invoice to the collections team.
+
+    Only open invoices of at least the escalation threshold can be escalated.
+    Escalating an invoice that is already escalated returns it unchanged
+    (callers retry on timeouts).
+    """
+    if invoice_id not in db.invoices:
+        raise DomainError("E_NOT_FOUND", f"invoice {invoice_id} not found")
+    invoice = db.invoices[invoice_id]
+    if invoice.status == "escalated":
+        return invoice
+    if invoice.status != "open":
+        raise DomainError("E_BAD_STATE", f"invoice {invoice_id} is {invoice.status}, not open")
+    amount = Money.parse(invoice.amount)
+    if amount.cents < ESCALATION_THRESHOLD_CENTS:
+        raise DomainError(
+            "E_LIMIT",
+            f"invoice {invoice_id} amount {amount} is below the escalation threshold",
+        )
+    invoice.status = "escalated"
+    events.emit("invoice.escalated", invoice.id, amount_cents=amount.cents)
+    return invoice
