diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_escalate_invoice.py b/tests/unit/test_escalate_invoice.py
--- a/tests/unit/test_escalate_invoice.py	1969-12-31 19:00:00
+++ b/tests/unit/test_escalate_invoice.py	2026-11-12 03:05:18
@@ -0,0 +1,58 @@
+import pytest
+
+from parcelo import events, invoices
+from parcelo.errors import DomainError
+from parcelo.models import Invoice
+from parcelo.store import db
+
+
+def _add_invoice(invoice_id, amount, status="open"):
+    inv = Invoice(id=invoice_id, shipment_id="shp_000000", amount=amount, status=status)
+    db.invoices[inv.id] = inv
+    return inv
+
+
+def test_escalates_large_open_invoice():
+    _add_invoice("INV-1", 500.0)
+    inv = invoices.escalate_invoice("INV-1")
+    assert inv.status == "escalated"
+    assert events.OUTBOX[-1]["name"] == "invoice.escalated"
+    assert events.OUTBOX[-1]["entity_id"] == "INV-1"
+
+
+def test_threshold_is_inclusive():
+    _add_invoice("INV-2", 500.00)
+    assert invoices.escalate_invoice("INV-2").status == "escalated"
+
+
+def test_small_invoice_rejected():
+    _add_invoice("INV-3", 499.99)
+    with pytest.raises(DomainError) as err:
+        invoices.escalate_invoice("INV-3")
+    assert err.value.code == "E_LIMIT"
+    assert db.invoices["INV-3"].status == "open"
+    assert events.OUTBOX == []
+
+
+def test_paid_invoice_rejected():
+    _add_invoice("INV-4", 900.0, status="paid")
+    with pytest.raises(DomainError) as err:
+        invoices.escalate_invoice("INV-4")
+    assert err.value.code == "E_BAD_STATE"
+    assert db.invoices["INV-4"].status == "paid"
+    assert events.OUTBOX == []
+
+
+def test_unknown_invoice_fails():
+    with pytest.raises(DomainError) as err:
+        invoices.escalate_invoice("INV-missing")
+    assert err.value.code == "E_NOT_FOUND"
+
+
+def test_repeat_escalation_is_noop():
+    _add_invoice("INV-5", 1000.0)
+    invoices.escalate_invoice("INV-5")
+    events_before = len(events.OUTBOX)
+    inv = invoices.escalate_invoice("INV-5")
+    assert inv.status == "escalated"
+    assert len(events.OUTBOX) == events_before
