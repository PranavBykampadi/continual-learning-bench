+def split_shipment(shipment_id, weights):
+    """Replace a "created" shipment with one new shipment per weight.
+
+    The original is marked "split". Returns the new shipments in the order
+    of ``weights``. All validation happens before any state is changed.
+    """
+    original = get_shipment(shipment_id)
+    if original.status != "created":
+        raise DomainError("E_BAD_STATE", f"{shipment_id} is {original.status}")
+
+    weights = list(weights)
+    if not weights:
+        raise DomainError("E_BAD_INPUT", "no weights given")
+    for weight in weights:
+        if weight <= 0:
+            raise DomainError("E_BAD_WEIGHT", str(weight))
+    if not math.isclose(sum(weights), original.weight_kg, rel_tol=1e-9, abs_tol=1e-9):
+        raise DomainError(
+            "E_BAD_INPUT",
+            f"weights sum to {sum(weights)}, expected {original.weight_kg}",
+        )
+
+    now = clock.now()
+    new_shipments = []
+    for weight in weights:
+        shipment = Shipment(
+            id=ids.new_id("shp"),
+            customer_id=original.customer_id,
+            weight_kg=weight,
+            zone=original.zone,
+            created_at=now,
+        )
+        new_shipments.append(shipment)
+
+    original.status = "split"
+    for shipment in new_shipments:
+        db.shipments[shipment.id] = shipment
+        events.emit("shipment.created", shipment.id, zone=shipment.zone)
+    events.emit(
+        "shipment.split",
+        original.id,
+        children=[s.id for s in new_shipments],
+    )
+    return new_shipments
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_split_shipment.py b/tests/unit/test_split_shipment.py
--- a/tests/unit/test_split_shipment.py	1969-12-31 19:00:00
+++ b/tests/unit/test_split_shipment.py	2026-11-12 02:59:05
@@ -0,0 +1,107 @@
+import pytest
+
+from parcelo import customers, events, shipments
+from parcelo.errors import DomainError
+from parcelo.store import db
+
+
+def _created(weight=10.0, zone="national"):
+    c = customers.add_customer("Acme")
+    return shipments.create_shipment(c.id, weight, zone)
+
+
+def test_split_creates_one_shipment_per_weight_in_order():
+    s = _created(10.0, "international")
+    parts = shipments.split_shipment(s.id, [6.0, 3.0, 1.0])
+
+    assert [p.weight_kg for p in parts] == [6.0, 3.0, 1.0]
+    for p in parts:
+        assert p.id.startswith("shp_")
+        assert p.customer_id == s.customer_id
+        assert p.zone == "international"
+        assert p.status == "created"
+        assert db.shipments[p.id] is p
+
+
+def test_split_marks_original_as_split():
+    s = _created(4.0)
+    shipments.split_shipment(s.id, [2.0, 2.0])
+    assert s.status == "split"
+    assert db.shipments[s.id].status == "split"
+
+
+def test_split_emits_events():
+    s = _created(4.0)
+    events.OUTBOX.clear()
+    parts = shipments.split_shipment(s.id, [1.0, 3.0])
+
+    names = [e["name"] for e in events.OUTBOX]
+    assert names == ["shipment.created", "shipment.created", "shipment.split"]
+    assert events.OUTBOX[-1]["entity_id"] == s.id
+    assert events.OUTBOX[-1]["payload"]["children"] == [p.id for p in parts]
+
+
+def test_split_unknown_shipment_fails():
+    with pytest.raises(DomainError) as err:
+        shipments.split_shipment("shp_999999", [1.0])
+    assert err.value.code == "E_NOT_FOUND"
+
+
+def test_split_non_created_shipment_fails():
+    s = _created(4.0)
+    s.status = "delivered"
+    with pytest.raises(DomainError) as err:
+        shipments.split_shipment(s.id, [2.0, 2.0])
+    assert err.value.code == "E_BAD_STATE"
+    assert s.status == "delivered"
+    assert len(db.shipments) == 1
+
+
+def test_split_already_split_fails():
+    s = _created(4.0)
+    shipments.split_shipment(s.id, [2.0, 2.0])
+    with pytest.raises(DomainError) as err:
+        shipments.split_shipment(s.id, [2.0, 2.0])
+    assert err.value.code == "E_BAD_STATE"
+
+
+def test_weights_must_sum_to_original_weight():
+    s = _created(10.0)
+    with pytest.raises(DomainError) as err:
+        shipments.split_shipment(s.id, [4.0, 5.0])
+    assert err.value.code == "E_BAD_INPUT"
+    # Nothing changed on failure.
+    assert s.status == "created"
+    assert len(db.shipments) == 1
+
+
+def test_too_heavy_weights_fail():
+    s = _created(10.0)
+    with pytest.raises(DomainError) as err:
+        shipments.split_shipment(s.id, [6.0, 6.0])
+    assert err.value.code == "E_BAD_INPUT"
+    assert s.status == "created"
+
+
+def test_empty_weights_fail():
+    s = _created(10.0)
+    with pytest.raises(DomainError) as err:
+        shipments.split_shipment(s.id, [])
+    assert err.value.code == "E_BAD_INPUT"
+    assert s.