+
+def heavy_quote(weight_kg, zone):
+    """Normal quote plus a per-kg surcharge for weight above the heavy threshold.
+
+    Returns Money. Raises DomainError (E_BAD_WEIGHT / E_BAD_ZONE) on bad input.
+    """
+    if not weight_kg > 0:
+        raise DomainError("E_BAD_WEIGHT", str(weight_kg))
+    if zone not in ZONE_BASE:
+        raise DomainError("E_BAD_ZONE", str(zone))
+
+    total = Money.parse(quote(weight_kg, zone))
+    excess_kg = Decimal(str(weight_kg)) - Decimal(str(HEAVY_PARCEL_THRESHOLD_KG))
+    if excess_kg > 0:
+        surcharge = Money.parse(HEAVY_PARCEL_SURCHARGE_PER_KG).scale(excess_kg)
+        total = total + surcharge
+    return total
