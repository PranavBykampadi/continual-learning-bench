diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_rates_heavy.py b/tests/unit/test_rates_heavy.py
--- a/tests/unit/test_rates_heavy.py	1969-12-31 19:00:00
+++ b/tests/unit/test_rates_heavy.py	2026-11-12 03:01:34
@@ -0,0 +1,44 @@
+import pytest
+
+from parcelo import rates
+from parcelo.errors import DomainError
+from parcelo.money import Money
+
+
+def test_at_or_below_threshold_is_normal_quote():
+    assert rates.heavy_quote(30, "local") == Money.parse(rates.quote(30, "local"))
+    assert rates.heavy_quote(2, "national") == Money.parse(rates.quote(2, "national"))
+
+
+def test_one_kg_over_threshold_adds_075():
+    # local 31 kg normal quote is 4.5 + 1.25 * 31 = 43.25; plus 0.75 = 44.00
+    assert rates.heavy_quote(31, "local") == Money(4400)
+
+
+def test_surcharge_scales_per_kg():
+    # 35 kg is 5 kg over: 5 * 0.75 = 3.75 on top of normal 35 kg quote
+    expected = Money.parse(rates.quote(35, "international")) + Money(375)
+    assert rates.heavy_quote(35, "international") == expected
+
+
+def test_fractional_excess_rounds_to_cents():
+    # 30.5 kg: 0.5 * 0.75 = 0.375 -> 38 cents (half up)
+    expected = Money.parse(rates.quote(30.5, "local")) + Money(38)
+    assert rates.heavy_quote(30.5, "local") == expected
+
+
+def test_returns_money():
+    assert isinstance(rates.heavy_quote(10, "local"), Money)
+
+
+def test_unknown_zone_raises_domain_error():
+    with pytest.raises(DomainError) as err:
+        rates.heavy_quote(10, "moon")
+    assert err.value.code == "E_BAD_ZONE"
+
+
+@pytest.mark.parametrize("weight", [0, -1, -0.5])
+def test_non_positive_weight_raises_domain_error(weight):
+    with pytest.raises(DomainError) as err:
+        rates.heavy_quote(weight, "local")
+    assert err.value.code == "E_BAD_WEIGHT"
