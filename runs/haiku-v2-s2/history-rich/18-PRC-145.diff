+def upgrade_tier(customer_id):
+    customer = db.customers.get(customer_id)
+    if customer is None:
+        raise DomainError("E_UNKNOWN_CUSTOMER", customer_id)
+    if customer.tier == "gold":
+        raise DomainError("E_BAD_STATE", f"{customer_id} is already gold")
+    customer.tier = "gold"
+    events.emit("customer.tier_upgraded", customer_id, tier="gold")
+    return customer
 
 
