diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/test_reports.py b/tests/test_reports.py
--- a/tests/test_reports.py	1969-12-31 19:00:00
+++ b/tests/test_reports.py	2026-11-12 02:54:15
@@ -0,0 +1,34 @@
+from parcelo import customers, invoices, reports, shipments
+
+
+def test_outstanding_by_customer_counts_only_open_invoices():
+    acme = customers.add_customer("Acme")
+    beta = customers.add_customer("Beta")
+    idle = customers.add_customer("Idle")
+
+    s1 = shipments.create_shipment(acme.id, 2, "local")  # 4.5 + 1.25*2 = 7.0
+    s2 = shipments.create_shipment(acme.id, 4, "local")  # 4.5 + 1.25*4 = 9.5
+    s3 = shipments.create_shipment(acme.id, 2, "local")  # paid, excluded
+    s4 = shipments.create_shipment(beta.id, 2, "local")  # 7.0
+
+    invoices.issue_invoice(s1.id)
+    invoices.issue_invoice(s2.id)
+    invoices.mark_paid(invoices.issue_invoice(s3.id).id)
+    invoices.issue_invoice(s4.id)
+
+    result = reports.outstanding_by_customer()
+
+    assert result == {acme.id: 16.5, beta.id: 7.0, idle.id: 0.0}
+
+
+def test_outstanding_by_customer_empty():
+    assert reports.outstanding_by_customer() == {}
+
+
+def test_outstanding_by_customer_excludes_void():
+    acme = customers.add_customer("Acme")
+    s = shipments.create_shipment(acme.id, 2, "local")
+    inv = invoices.issue_invoice(s.id)
+    inv.status = "void"
+
+    assert reports.outstanding_by_customer() == {acme.id: 0.0}
