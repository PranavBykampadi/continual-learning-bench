+def test_reassign_shipment_changes_customer_and_audits():
+    old = customers.add_customer("Acme")
+    new = customers.add_customer("Globex")
+    s = shipments.create_shipment(old.id, 2, "local")
+    audit.LOG.clear()
+
+    result = shipments.reassign_shipment(s.id, new.id)
+
+    assert result is s
+    assert shipments.get_shipment(s.id).customer_id == new.id
+    assert len(audit.LOG) == 1
+    entry = audit.LOG[-1]
+    assert entry["action"] == "shipment.reassigned"
+    assert entry["entity_id"] == s.id
+    assert entry["details"] == {"from_customer": old.id, "to_customer": new.id}
+
+
+def test_reassign_unknown_shipment():
+    new = customers.add_customer("Globex")
+    with pytest.raises(DomainError) as err:
+        shipments.reassign_shipment("shp_missing", new.id)
+    assert err.value.code == "E_NOT_FOUND"
+    assert audit.LOG == []
+
+
+def test_reassign_to_unknown_customer_leaves_store_unchanged():
+    old = customers.add_customer("Acme")
+    s = shipments.create_shipment(old.id, 2, "local")
+    audit.LOG.clear()
+    before = dict(db.shipments)
+    with pytest.raises(DomainError) as err:
+        shipments.reassign_shipment(s.id, "C_missing")
+    assert err.value.code == "E_UNKNOWN_CUSTOMER"
+    assert db.shipments == before
+    assert shipments.get_shipment(s.id).customer_id == old.id
+    assert audit.LOG == []
+
+
