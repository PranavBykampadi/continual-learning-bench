+
+
+def _issue(customer_id, weight_kg, zone):
+    s = shipments.create_shipment(customer_id, weight_kg, zone)
+    return invoices.issue_invoice(s.id)
+
+
+def test_escalate_open_large_invoice():
+    c = customers.add_customer("Acme")
+    inv = _issue(c.id, 400, "international")  # 524.00
+    out = invoices.escalate_invoice(inv.id)
+    assert out is inv
+    assert out.status == "escalated"
+
+
+def test_escalate_threshold_is_inclusive():
+    c = customers.add_customer("Acme")
+    inv = _issue(c.id, 380.8, "international")  # exactly 500.00
+    assert inv.amount == 500.0
+    assert invoices.escalate_invoice(inv.id).status == "escalated"
+
+
+def test_escalate_missing_invoice_empty_store():
+    with pytest.raises(DomainError) as err:
+        invoices.escalate_invoice("INV-missing")
+    assert err.value.code == "E_NOT_FOUND"
+
+
+def test_escalate_small_invoice_rejected():
+    c = customers.add_customer("Acme")
+    inv = _issue(c.id, 2, "local")  # 7.00
+    with pytest.raises(DomainError) as err:
+        invoices.escalate_invoice(inv.id)
+    assert err.value.code == "E_BAD_STATE"
+    assert inv.status == "open"
+
+
+def test_escalate_paid_invoice_rejected():
+    c = customers.add_customer("Acme")
+    inv = _issue(c.id, 400, "international")
+    invoices.mark_paid(inv.id)
+    with pytest.raises(DomainError) as err:
+        invoices.escalate_invoice(inv.id)
+    assert err.value.code == "E_BAD_STATE"
+    assert inv.status == "paid"
+
+
+def test_escalate_twice_rejected():
+    c = customers.add_customer("Acme")
+    inv = _issue(c.id, 400, "international")
+    invoices.escalate_invoice(inv.id)
+    with pytest.raises(DomainError) as err:
+        invoices.escalate_invoice(inv.id)
+    assert err.value.code == "E_BAD_STATE"
+
+
+def test_escalate_mixed_store_touches_only_target():
+    c = customers.add_customer("Acme")
+    big = _issue(c.id, 400, "international")
+    small = _issue(c.id, 2, "local")
+    edge = _issue(c.id, 380.8, "international")
+    invoices.escalate_invoice(big.id)
+    assert big.status == "escalated"
+    assert small.status == "open"
+    assert edge.status == "open"
