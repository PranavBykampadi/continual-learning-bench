diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/parcelo/vouchers.py b/parcelo/vouchers.py
--- a/parcelo/vouchers.py	1969-12-31 19:00:00
+++ b/parcelo/vouchers.py	2026-11-12 03:19:00
@@ -0,0 +1,29 @@
+from parcelo import clock, ids
+from parcelo.errors import DomainError
+from parcelo.models import Voucher
+from parcelo.store import db
+
+MAX_VOUCHER_AMOUNT = 150.00
+
+
+def issue_voucher(customer_id, amount):
+    if not isinstance(customer_id, str) or isinstance(customer_id, bool):
+        raise DomainError("E_BAD_INPUT", customer_id)
+    if not customer_id or not customer_id.strip():
+        raise DomainError("E_BAD_INPUT", customer_id)
+    if customer_id not in db.customers:
+        raise DomainError("E_UNKNOWN_CUSTOMER", customer_id)
+    if not isinstance(amount, (int, float)) or isinstance(amount, bool):
+        raise DomainError("E_BAD_INPUT", str(amount))
+    if amount <= 0:
+        raise DomainError("E_BAD_INPUT", str(amount))
+    if amount > MAX_VOUCHER_AMOUNT:
+        raise DomainError("E_LIMIT", str(amount))
+    voucher = Voucher(
+        id=ids.new_id("vch"),
+        customer_id=customer_id,
+        amount=amount,
+        issued_at=clock.now(),
+    )
+    db.vouchers[voucher.id] = voucher
+    return voucher
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/test_vouchers.py b/tests/test_vouchers.py
--- a/tests/test_vouchers.py	1969-12-31 19:00:00
+++ b/tests/test_vouchers.py	2026-11-12 03:19:02
@@ -0,0 +1,49 @@
+import pytest
+
+from parcelo import customers, vouchers
+from parcelo.errors import DomainError
+from parcelo.store import db
+
+
+def test_issue_voucher():
+    c = customers.add_customer("Acme")
+    v = vouchers.issue_voucher(c.id, 25.0)
+    assert v.id.startswith("vch_")
+    assert v.customer_id == c.id
+    assert v.amount == 25.0
+    assert v.issued_at is not None
+    assert db.vouchers[v.id] is v
+
+
+def test_issue_voucher_at_limit():
+    c = customers.add_customer("Acme")
+    assert vouchers.issue_voucher(c.id, 150.00).amount == 150.00
+
+
+def test_unknown_customer():
+    with pytest.raises(DomainError) as err:
+        vouchers.issue_voucher("nope", 10)
+    assert err.value.code == "E_UNKNOWN_CUSTOMER"
+
+
+@pytest.mark.parametrize("customer_id", ["", "   ", None, 42, True])
+def test_bad_customer_id(customer_id):
+    with pytest.raises(DomainError) as err:
+        vouchers.issue_voucher(customer_id, 10)
+    assert err.value.code == "E_BAD_INPUT"
+
+
+@pytest.mark.parametrize("amount", [0, -5, 0.0, True, "10", None])
+def test_bad_amount(amount):
+    c = customers.add_customer("Acme")
+    with pytest.raises(DomainError) as err:
+        vouchers.issue_voucher(c.id, amount)
+    assert err.value.code == "E_BAD_INPUT"
+
+
+def test_over_limit():
+    c = customers.add_customer("Acme")
+    with pytest.raises(DomainError) as err:
+        vouchers.issue_voucher(c.id, 150.01)
+    assert err.value.code == "E_LIMIT"
+    assert db.vouchers == {}
