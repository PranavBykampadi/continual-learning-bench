diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/test_reports.py b/tests/test_reports.py
--- a/tests/test_reports.py	1969-12-31 19:00:00
+++ b/tests/test_reports.py	2026-11-12 03:05:08
@@ -0,0 +1,37 @@
+from parcelo import customers, reports, shipments
+
+
+def test_volume_report_includes_customers_without_shipments():
+    c = customers.add_customer("Acme")
+    assert reports.volume_report() == {
+        c.id: {"shipments": 0, "tier": "starter"},
+    }
+
+
+def test_volume_report_counts_shipments_per_customer():
+    a = customers.add_customer("Acme")
+    b = customers.add_customer("Bolt")
+    for _ in range(3):
+        shipments.create_shipment(a.id, 2, "local")
+    shipments.create_shipment(b.id, 5, "national")
+
+    report = reports.volume_report()
+    assert report[a.id] == {"shipments": 3, "tier": "starter"}
+    assert report[b.id] == {"shipments": 1, "tier": "starter"}
+
+
+def test_volume_report_tier_thresholds():
+    regular = customers.add_customer("Regular")
+    bulk = customers.add_customer("Bulk")
+    for _ in range(10):
+        shipments.create_shipment(regular.id, 1, "local")
+    for _ in range(50):
+        shipments.create_shipment(bulk.id, 1, "local")
+
+    report = reports.volume_report()
+    assert report[regular.id] == {"shipments": 10, "tier": "regular"}
+    assert report[bulk.id] == {"shipments": 50, "tier": "bulk"}
+
+
+def test_volume_report_empty_store():
+    assert reports.volume_report() == {}
