+HEAVY_PER_KG = 0.75
 
 
 def base_rate(zone):
@@ -12,3 +16,14 @@
     if weight_kg <= 0:
         raise ValueError("weight must be positive")
     return round(base_rate(zone) + PER_KG * weight_kg, 2)
+
+
+def heavy_quote(weight_kg, zone):
+    if isinstance(weight_kg, bool) or not isinstance(weight_kg, (int, float)):
+        raise ValueError("weight must be a number")
+    if not math.isfinite(weight_kg):
+        raise ValueError("weight must be finite")
+    # quote() validates that the weight is positive and the zone is known.
+    base = quote(weight_kg, zone)
+    excess = max(0, weight_kg - HEAVY_THRESHOLD_KG)
+    return round(base + HEAVY_PER_KG * excess, 2)
