-from parcelo import customers, invoices, shipments
+import pytest
 
+from parcelo import clock, customers, invoices, shipments
+from parcelo.errors import DomainError
 
+SHIPMENT_WEIGHT_KG = 2
+SHIPMENT_ZONE = "local"
+INVOICE_AMOUNT = 7.0
+MISSING_INVOICE_ID = "INV-missing"
+
+
+def _new_invoice():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, SHIPMENT_WEIGHT_KG, SHIPMENT_ZONE)
+    return invoices.issue_invoice(s.id)
+
+
 def test_issue_and_pay():
     c = customers.add_customer("Acme")
-    s = shipments.create_shipment(c.id, 2, "local")
+    s = shipments.create_shipment(c.id, SHIPMENT_WEIGHT_KG, SHIPMENT_ZONE)
     inv = invoices.issue_invoice(s.id)
-    assert inv.amount == 7.0
+    assert inv.amount == INVOICE_AMOUNT
     assert invoices.mark_paid(inv.id).status == "paid"
+
+
+def test_void_open_invoice_sets_status_and_time():
+    inv = _new_invoice()
+    moment = clock.now()
+    clock.set_fixed(moment)
+    try:
+        result = invoices.void_invoice(inv.id)
+    finally:
+        clock.clear_fixed()
+    assert result is inv
+    assert inv.status == "void"
+    assert inv.voided_at == moment
+
+
+def test_void_missing_invoice_fails():
+    with pytest.raises(DomainError) as err:
+        invoices.void_invoice(MISSING_INVOICE_ID)
+    assert err.value.code == "E_NOT_FOUND"
+
+
+def test_void_paid_invoice_fails():
+    inv = _new_invoice()
+    invoices.mark_paid(inv.id)
+    with pytest.raises(DomainError) as err:
+        invoices.void_invoice(inv.id)
+    assert err.value.code == "E_BAD_STATE"
+    assert inv.status == "paid"
+    assert inv.voided_at is None
+
+
+def test_void_already_void_invoice_fails():
+    inv = _new_invoice()
+    invoices.void_invoice(inv.id)
+    with pytest.raises(DomainError) as err:
+        invoices.void_invoice(inv.id)
+    assert err.value.code == "E_BAD_STATE"
