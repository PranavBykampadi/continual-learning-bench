+def void_invoice(invoice_id):
+    if invoice_id not in db.invoices:
+        raise DomainError("E_NOT_FOUND", invoice_id)
+    invoice = db.invoices[invoice_id]
+    if invoice.status == STATUS_PAID:
+        raise DomainError("E_BAD_STATE", "invoice already paid: " + invoice_id)
+    if invoice.status == STATUS_VOID:
+        raise DomainError("E_BAD_STATE", "invoice already void: " + invoice_id)
+    invoice.status = STATUS_VOID
+    invoice.voided_at = clock.now()
+    return invoice
+
