+def rebate_for(customer_id):
+    """Volume rebate earned by a customer: a share of their paid invoices.
+
+    Starter customers (fewer than 10 shipments) earn nothing, regular
+    (10+) earn 3%, and bulk (50+) earn 6%.
+    """
+    if not isinstance(customer_id, str) or isinstance(customer_id, bool):
+        raise DomainError("E_BAD_INPUT", customer_id)
+    if not customer_id or not customer_id.strip():
+        raise DomainError("E_BAD_INPUT", customer_id)
+    if customer_id not in db.customers:
+        raise DomainError("E_NOT_FOUND", customer_id)
+
+    shipment_count = 0
+    for shipment in db.shipments.values():
+        if shipment.customer_id == customer_id:
+            shipment_count += 1
+
+    paid_total = 0.0
+    for invoice in db.invoices.values():
+        if invoice.status != "paid":
+            continue
+        shipment = db.shipments[invoice.shipment_id]
+        if shipment.customer_id == customer_id:
+            paid_total += invoice.amount
+
+    pct = REBATE_PCT[volume_tier(shipment_count)]
+    return round(paid_total * pct / 100.0, 2)
