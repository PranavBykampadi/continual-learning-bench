@@ -0,0 +1,50 @@
+import pytest
+
+from parcelo import customers, invoices, shipments
+from parcelo.errors import DomainError
+
+
+def _customer_with_shipments(n, pay=False):
+    c = customers.add_customer("Acme")
+    for _ in range(n):
+        # 2kg local shipment invoices at 4.5 + 1.25 * 2 = 7.00 exactly
+        s = shipments.create_shipment(c.id, 2, "local")
+        inv = invoices.issue_invoice(s.id)
+        if pay:
+            invoices.mark_paid(inv.id)
+    return c
+
+
+def test_no_rebate_below_ten_shipments():
+    c = _customer_with_shipments(9, pay=True)
+    assert customers.rebate_for(c.id) == 0.0
+
+
+def test_regular_tier_at_ten_shipments():
+    c = _customer_with_shipments(10, pay=True)
+    # 10 paid invoices of 7.00 = 70.00; 3% = 2.10
+    assert customers.rebate_for(c.id) == 2.10
+
+
+def test_bulk_tier_at_fifty_shipments():
+    c = _customer_with_shipments(50, pay=True)
+    # 50 paid invoices of 7.00 = 350.00; 6% = 21.00
+    assert customers.rebate_for(c.id) == 21.00
+
+
+def test_only_paid_invoices_count():
+    c = _customer_with_shipments(10, pay=False)
+    assert customers.rebate_for(c.id) == 0.0
+
+
+def test_unknown_customer_fails():
+    with pytest.raises(DomainError) as err:
+        customers.rebate_for("nope")
+    assert err.value.code == "E_NOT_FOUND"
+
+
+@pytest.mark.parametrize("bad", [None, 3, True, "", "   "])
+def test_bad_customer_id_rejected(bad):
+    with pytest.raises(DomainError) as err:
+        customers.rebate_for(bad)
+    assert err.value.code == "E_BAD_INPUT"
