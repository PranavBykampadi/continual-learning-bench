@@ -15,3 +15,36 @@
     with pytest.raises(DomainError) as err:
         shipments.create_shipment("nope", 1, "local")
     assert err.value.code == "E_UNKNOWN_CUSTOMER"
+
+
+def test_mark_lost_sets_status():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 1.5, "national")
+    result = shipments.mark_lost(s.id)
+    assert result is s
+    assert s.status == "lost"
+    assert audit.LOG[-1]["action"] == "shipment.lost"
+    assert audit.LOG[-1]["entity_id"] == s.id
+
+
+def test_mark_lost_unknown_shipment():
+    with pytest.raises(DomainError) as err:
+        shipments.mark_lost("shp_missing")
+    assert err.value.code == "E_NOT_FOUND"
+
+
+def test_mark_lost_rejects_delivered():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 1.5, "national")
+    s.status = "delivered"
+    with pytest.raises(DomainError) as err:
+        shipments.mark_lost(s.id)
+    assert err.value.code == "E_BAD_STATE"
+    assert s.status == "delivered"
+
+
+@pytest.mark.parametrize("bad", [None, 42, True, "", "   "])
+def test_mark_lost_rejects_bad_id(bad):
+    with pytest.raises(DomainError) as err:
+        shipments.mark_lost(bad)
+    assert err.value.code == "E_BAD_INPUT"
