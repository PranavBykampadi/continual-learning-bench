     if shipment_id not in db.shipments:
         raise DomainError("E_NOT_FOUND", shipment_id)
     return db.shipments[shipment_id]
+
+
+def list_shipments(customer_id):
+    if not isinstance(customer_id, str) or not customer_id.strip():
+        raise DomainError("E_BAD_INPUT", "customer_id")
+    if customer_id not in db.customers:
+        raise DomainError("E_UNKNOWN_CUSTOMER", customer_id)
+    return [s for s in db.shipments.values() if s.customer_id == customer_id]
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/test_shipments.py b/tests/test_shipments.py
--- a/tests/test_shipments.py	1969-12-31 19:00:00
+++ b/tests/test_shipments.py	2026-11-12 03:09:05
@@ -0,0 +1,31 @@
+import pytest
+
+from parcelo import customers, shipments
+from parcelo.errors import DomainError
+
+
+def test_list_shipments_only_returns_customers_own():
+    a = customers.add_customer("Acme")
+    b = customers.add_customer("Other")
+    s1 = shipments.create_shipment(a.id, 2, "local")
+    s2 = shipments.create_shipment(a.id, 3, "national")
+    shipments.create_shipment(b.id, 1, "international")
+    assert [s.id for s in shipments.list_shipments(a.id)] == [s1.id, s2.id]
+
+
+def test_list_shipments_empty_for_customer_without_shipments():
+    c = customers.add_customer("Empty")
+    assert shipments.list_shipments(c.id) == []
+
+
+def test_list_shipments_unknown_customer_fails():
+    with pytest.raises(DomainError) as exc:
+        shipments.list_shipments("C999999")
+    assert exc.value.code == "E_UNKNOWN_CUSTOMER"
+
+
+@pytest.mark.parametrize("bad", ["", "   ", None, 5, True])
+def test_list_shipments_bad_input_fails(bad):
+    with pytest.raises(DomainError) as exc:
+        shipments.list_shipments(bad)
+    assert exc.value.code == "E_BAD_INPUT"
