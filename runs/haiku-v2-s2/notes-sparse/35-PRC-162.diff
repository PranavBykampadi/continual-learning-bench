+
+
+def test_invoices_by_status():
+    c = customers.add_customer("Acme")
+    s1 = shipments.create_shipment(c.id, 2, "local")
+    s2 = shipments.create_shipment(c.id, 3, "local")
+    inv1 = invoices.issue_invoice(s1.id)
+    inv2 = invoices.issue_invoice(s2.id)
+    invoices.mark_paid(inv2.id)
+    assert invoices.invoices_by_status("open") == [inv1]
+    assert invoices.invoices_by_status("paid") == [inv2]
+
+
+def test_invoices_by_status_empty():
+    assert invoices.invoices_by_status("paid") == []
+
+
+@pytest.mark.parametrize("bad", ["void", "", "OPEN", None, 1, True])
+def test_invoices_by_status_rejects_bad_status(bad):
+    with pytest.raises(DomainError) as exc:
+        invoices.invoices_by_status(bad)
+    assert exc.value.code == "E_BAD_INPUT"
