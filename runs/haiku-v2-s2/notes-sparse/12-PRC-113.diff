-from parcelo import customers, invoices, shipments
+import pytest
 
+from parcelo import audit, customers, invoices, reports, shipments
+from parcelo.errors import DomainError
+from parcelo.store import db
 
+
 def test_issue_and_pay():
     c = customers.add_customer("Acme")
     s = shipments.create_shipment(c.id, 2, "local")
     inv = invoices.issue_invoice(s.id)
     assert inv.amount == 7.0
     assert invoices.mark_paid(inv.id).status == "paid"
+
+
+def _open_invoice():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 2, "local")
+    return c, invoices.issue_invoice(s.id)
+
+
+def test_apply_credit_reduces_amount_and_returns_remaining():
+    c, inv = _open_invoice()
+    assert invoices.apply_credit(inv.id, 2.5) == 4.5
+    assert db.invoices[inv.id].amount == 4.5
+    assert db.invoices[inv.id].status == "open"
+
+
+def test_apply_credit_records_audit_entry():
+    _, inv = _open_invoice()
+    audit.LOG.clear()
+    invoices.apply_credit(inv.id, 2.5)
+    assert len(audit.LOG) == 1
+    entry = audit.LOG[0]
+    assert entry["action"] == "invoice.credit_applied"
+    assert entry["entity_id"] == inv.id
+    assert entry["details"] == {"credit": 2.5, "remaining": 4.5}
+
+
+def test_apply_credit_equal_to_amount_leaves_zero():
+    _, inv = _open_invoice()
+    assert invoices.apply_credit(inv.id, 7.0) == 0.0
+    assert db.invoices[inv.id].amount == 0.0
+
+
+def test_credit_flows_into_customer_balance_and_reports():
+    c, inv = _open_invoice()
+    invoices.apply_credit(inv.id, 2.0)
+    assert customers.outstanding_balance(c.id) == 5.0
+    invoices.mark_paid(inv.id)
+    assert reports.revenue_total() == 5.0
+
+
+def test_apply_credit_unknown_invoice_raises_not_found():
+    with pytest.raises(DomainError) as exc:
+        invoices.apply_credit("INV-missing", 1.0)
+    assert exc.value.code == "E_NOT_FOUND"
+
+
+def test_apply_credit_to_paid_invoice_raises_bad_state():
+    _, inv = _open_invoice()
+    invoices.mark_paid(inv.id)
+    with pytest.raises(DomainError) as exc:
+        invoices.apply_credit(inv.id, 1.0)
+    assert exc.value.code == "E_BAD_STATE"
+    assert db.invoices[inv.id].amount == 7.0
+
+
+def test_apply_credit_larger_than_amount_raises_bad_input():
+    _, inv = _open_invoice()
+    audit.LOG.clear()
+    with pytest.raises(DomainError) as exc:
+        invoices.apply_credit(inv.id, 7.01)
+    assert exc.value.code == "E_BAD_INPUT"
+    assert db.invoices[inv.id].amount == 7.0
+    assert audit.LOG == []
+
+
+@pytest.mark.parametrize("bad", [0, 0.0, -1, -0.5, True, False, None, "3", float("nan"), float("inf"), float("-inf")])
+def test_apply_credit_rejects_invalid_amount(bad):
+    _, inv = _open_invoice()
+    audit.LOG.clear()
+    with pytest.raises(DomainError) as exc:
+        invoices.apply_credit(inv.id, bad)
+    assert exc.value.code == "E_BAD_INPUT"
+    assert db.invoices[inv.id].amount == 7.0
+    assert audit.LOG == []
