 def open_invoices():
     return [i for i in db.invoices.values() if i.status == "open"]
+
+
+def apply_credit(invoice_id, amount):
+    """Reduce an open invoice's amount by `amount` and return the remaining amount.
+
+    Validation runs before any mutation, so a failed call leaves the store unchanged.
+    """
+    if invoice_id not in db.invoices:
+        raise DomainError("E_NOT_FOUND", invoice_id)
+    if isinstance(amount, bool) or not isinstance(amount, (int, float)):
+        raise DomainError("E_BAD_INPUT", f"credit must be a number: {amount!r}")
+    if math.isnan(amount) or math.isinf(amount) or amount <= 0:
+        raise DomainError("E_BAD_INPUT", f"credit must be a positive finite number: {amount!r}")
+    invoice = db.invoices[invoice_id]
+    if invoice.status != "open":
+        raise DomainError("E_BAD_STATE", f"invoice {invoice_id} is {invoice.status}")
+    if round(amount, 2) > round(invoice.amount, 2):
+        raise DomainError(
+            "E_BAD_INPUT",
+            f"credit {amount} exceeds invoice amount {invoice.amount}",
+        )
+    remaining = round(invoice.amount - amount, 2)
+    invoice.amount = remaining
+    audit.record("invoice.credit_applied", invoice_id, credit=amount, remaining=remaining)
+    return remaining
