@@ -0,0 +1,68 @@
+import pytest
+
+from parcelo import audit, customers, events, returns, shipments
+from parcelo.errors import DomainError
+from parcelo.models import STATUS_DELIVERED
+
+
+def _delivered_shipment():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 2.0, "local")
+    s.status = STATUS_DELIVERED
+    return s
+
+
+def test_request_return_stores_and_returns_request():
+    s = _delivered_shipment()
+    r = returns.request_return(s.id, "damaged")
+    assert r.id.startswith("ret_")
+    assert r.shipment_id == s.id
+    assert r.reason == "damaged"
+    assert r.requested_at is not None
+    assert returns.returns_for(s.id) == [r]
+
+
+def test_request_return_records_audit_and_event():
+    s = _delivered_shipment()
+    r = returns.request_return(s.id, "damaged")
+    assert audit.LOG[-1]["action"] == "return.requested"
+    assert audit.LOG[-1]["entity_id"] == r.id
+    assert events.OUTBOX[-1]["name"] == "return.requested"
+
+
+def test_unknown_shipment_not_found():
+    with pytest.raises(DomainError) as err:
+        returns.request_return("shp_nope", "damaged")
+    assert err.value.code == "E_NOT_FOUND"
+
+
+def test_blank_shipment_id_is_bad_input():
+    with pytest.raises(DomainError) as err:
+        returns.request_return("   ", "damaged")
+    assert err.value.code == "E_BAD_INPUT"
+
+
+def test_blank_reason_is_bad_input():
+    s = _delivered_shipment()
+    with pytest.raises(DomainError) as err:
+        returns.request_return(s.id, "  ")
+    assert err.value.code == "E_BAD_INPUT"
+    assert returns.returns_for(s.id) == []
+
+
+def test_undelivered_shipment_is_bad_state():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 2.0, "local")
+    with pytest.raises(DomainError) as err:
+        returns.request_return(s.id, "damaged")
+    assert err.value.code == "E_BAD_STATE"
+
+
+def test_fourth_return_is_rejected():
+    s = _delivered_shipment()
+    for _ in range(returns.MAX_RETURNS_PER_SHIPMENT):
