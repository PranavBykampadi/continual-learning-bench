+def late_fee_for(invoice_id):
+    if invoice_id not in db.invoices:
+        raise DomainError("E_NOT_FOUND", invoice_id)
+    invoice = db.invoices[invoice_id]
+    elapsed = _as_utc(clock.now()) - _as_utc(invoice.issued_at)
+    days_late = elapsed.days - LATE_AFTER_DAYS
+    return late_fee(invoice.amount, days_late)
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/test_invoices.py b/tests/test_invoices.py
--- a/tests/test_invoices.py	2026-11-10 12:17:53
+++ b/tests/test_invoices.py	2026-11-12 02:52:46
@@ -1,9 +1,53 @@
-from parcelo import customers, invoices, shipments
+from datetime import datetime, timedelta, timezone
 
+import pytest
 
+from parcelo import clock, customers, invoices, shipments
+from parcelo.errors import DomainError
+
+INVOICE_AMOUNT = 7.0
+ISSUED_AT = datetime(2026, 1, 1, tzinfo=timezone.utc)
+GRACE_DAYS = 30
+LATE_FEE_ONE_DAY = 0.1  # 7.0 * 0.015 * 1 day = 0.105, rounded by legacy late_fee
+LATE_FEE_TEN_DAYS = 1.05  # 7.0 * 0.015 * 10 days
+MISSING_INVOICE_ID = "INV-missing"
+
+
+def _issued_invoice():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 2, "local")
+    inv = invoices.issue_invoice(s.id)
+    inv.issued_at = ISSUED_AT
+    return inv
+
+
 def test_issue_and_pay():
     c = customers.add_customer("Acme")
     s = shipments.create_shipment(c.id, 2, "local")
     inv = invoices.issue_invoice(s.id)
-    assert inv.amount == 7.0
+    assert inv.amount == INVOICE_AMOUNT
     assert invoices.mark_paid(inv.id).status == "paid"
+
+
+def test_late_fee_zero_before_grace_period():
+    inv = _issued_invoice()
+    clock.set_fixed(ISSUED_AT + timedelta(days=GRACE_DAYS))
+    assert invoices.late_fee_for(inv.id) == 0.0
+
+
+def test_late_fee_one_day_past_grace():
+    inv = _issued_invoice()
+    clock.set_fixed(ISSUED_AT + timedelta(days=GRACE_DAYS + 1))
+    assert invoices.late_fee_for(inv.id) == LATE_FEE_ONE_DAY
+
+
+def test_late_fee_ten_days_past_grace():
+    inv = _issued_invoice()
+    clock.set_fixed(ISSUED_AT + timedelta(days=GRACE_DAYS + 10))
+    assert invoices.late_fee_for(inv.id) == LATE_FEE_TEN_DAYS
+
+
+def test_late_fee_unknown_invoice():
+    with pytest.raises(DomainError) as err:
+        invoices.late_fee_for(MISSING_INVOICE_ID)
+    assert err.value.code == "E_NOT_FOUND"
