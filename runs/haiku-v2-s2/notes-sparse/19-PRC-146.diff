-from parcelo import customers, invoices, shipments
+from datetime import datetime, timezone
 
+import pytest
 
+from parcelo import audit, clock, customers, invoices, shipments
+from parcelo.errors import DomainError
+
+
 def test_issue_and_pay():
     c = customers.add_customer("Acme")
     s = shipments.create_shipment(c.id, 2, "local")
     inv = invoices.issue_invoice(s.id)
     assert inv.amount == 7.0
     assert invoices.mark_paid(inv.id).status == "paid"
+
+
+def _open_invoice():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 2, "local")
+    return invoices.issue_invoice(s.id)
+
+
+def test_write_off_open_invoice():
+    clock.set_fixed(datetime(2026, 11, 12, 9, 30, tzinfo=timezone.utc))
+    inv = _open_invoice()
+    audit.LOG.clear()
+
+    assert invoices.write_off(inv.id) == 7.0
+    assert inv.status == "written_off"
+    assert inv.written_off_at == datetime(2026, 11, 12, 9, 30)
+    assert audit.LOG[-1]["action"] == "invoice.written_off"
+    assert audit.LOG[-1]["entity_id"] == inv.id
+    assert audit.LOG[-1]["details"] == {"amount": 7.0}
+
+
+def test_write_off_unknown_invoice():
+    with pytest.raises(DomainError) as err:
+        invoices.write_off("INV-missing")
+    assert err.value.code == "E_NOT_FOUND"
+
+
+def test_write_off_blank_id_is_bad_input():
+    audit.LOG.clear()
+    with pytest.raises(DomainError) as err:
+        invoices.write_off("   ")
+    assert err.value.code == "E_BAD_INPUT"
+    assert audit.LOG == []
+
+
+def test_write_off_paid_invoice_is_bad_state():
+    inv = _open_invoice()
+    invoices.mark_paid(inv.id)
+    audit.LOG.clear()
+
+    with pytest.raises(DomainError) as err:
+        invoices.write_off(inv.id)
+    assert err.value.code == "E_BAD_STATE"
+    assert inv.status == "paid"
+    assert inv.written_off_at is None
+    assert audit.LOG == []
+
+
+def test_write_off_twice_is_bad_state():
+    inv = _open_invoice()
+    invoices.write_off(inv.id)
+    audit.LOG.clear()
+
+    with pytest.raises(DomainError) as err:
+        invoices.write_off(inv.id)
+    assert err.value.code == "E_BAD_STATE"
+    assert inv.status == "written_off"
+    assert audit.LOG == []
