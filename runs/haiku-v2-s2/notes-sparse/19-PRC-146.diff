+def get_invoice(invoice_id):
+    if invoice_id not in db.invoices:
+        raise DomainError("E_NOT_FOUND", invoice_id)
+    return db.invoices[invoice_id]
+
+
+def write_off(invoice_id):
+    if not isinstance(invoice_id, str) or isinstance(invoice_id, bool) or not invoice_id.strip():
+        raise DomainError("E_BAD_INPUT", repr(invoice_id))
+    invoice = get_invoice(invoice_id)
+    if invoice.status != "open":
+        raise DomainError("E_BAD_STATE", invoice_id)
+    # Invoice timestamps are stored as naive UTC (see issue_invoice).
+    invoice.status = "written_off"
+    invoice.written_off_at = clock.now().replace(tzinfo=None)
+    audit.record("invoice.written_off", invoice_id, amount=invoice.amount)
+    return invoice.amount
 
 
