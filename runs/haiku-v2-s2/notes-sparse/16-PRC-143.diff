@@ -0,0 +1,25 @@
+from parcelo import clock, ids
+from parcelo.errors import DomainError
+from parcelo.models import Pickup
+from parcelo.shipments import get_shipment
+from parcelo.store import db
+
+SHIPMENT_CREATED = "created"
+
+
+def schedule_pickup(shipment_id, window_start):
+    if not isinstance(shipment_id, str) or isinstance(shipment_id, bool):
+        raise DomainError("E_BAD_INPUT", repr(shipment_id))
+    if not shipment_id or not shipment_id.strip():
+        raise DomainError("E_BAD_INPUT", repr(shipment_id))
+    shipment = get_shipment(shipment_id)
+    if shipment.status != SHIPMENT_CREATED:
+        raise DomainError("E_BAD_STATE", shipment_id)
+    pickup = Pickup(
+        id=ids.new_id("pkp"),
+        shipment_id=shipment_id,
+        window_start=window_start,
+        scheduled_at=clock.now(),
+    )
+    db.pickups[pickup.id] = pickup
+    return pickup
