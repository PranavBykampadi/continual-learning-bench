diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_pickups.py b/tests/unit/test_pickups.py
--- a/tests/unit/test_pickups.py	1969-12-31 19:00:00
+++ b/tests/unit/test_pickups.py	2026-11-12 03:02:06
@@ -0,0 +1,43 @@
+import pytest
+
+from parcelo import customers, pickups, shipments, store
+from parcelo.errors import DomainError
+
+
+def _shipment(status="created"):
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 1.5, "national")
+    s.status = status
+    return s
+
+
+def test_schedule_pickup_saves_and_returns():
+    s = _shipment()
+    p = pickups.schedule_pickup(s.id, "2026-11-13T09:00")
+    assert p.id.startswith("pkp_")
+    assert p.shipment_id == s.id
+    assert p.window_start == "2026-11-13T09:00"
+    assert p.scheduled_at is not None
+    assert store.db.pickups[p.id] is p
+
+
+def test_unknown_shipment():
+    with pytest.raises(DomainError) as err:
+        pickups.schedule_pickup("shp_missing", "2026-11-13T09:00")
+    assert err.value.code == "E_NOT_FOUND"
+    assert store.db.pickups == {}
+
+
+def test_shipment_not_created():
+    s = _shipment(status="delivered")
+    with pytest.raises(DomainError) as err:
+        pickups.schedule_pickup(s.id, "2026-11-13T09:00")
+    assert err.value.code == "E_BAD_STATE"
+    assert store.db.pickups == {}
+
+
+@pytest.mark.parametrize("bad", [None, 123, True, "", "   "])
+def test_bad_shipment_id(bad):
+    with pytest.raises(DomainError) as err:
+        pickups.schedule_pickup(bad, "2026-11-13T09:00")
+    assert err.value.code == "E_BAD_INPUT"
