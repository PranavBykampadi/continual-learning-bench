diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_customers.py b/tests/unit/test_customers.py
--- a/tests/unit/test_customers.py	1969-12-31 19:00:00
+++ b/tests/unit/test_customers.py	2026-11-12 03:11:22
@@ -0,0 +1,27 @@
+import pytest
+
+from parcelo import audit, customers
+from parcelo.errors import DomainError
+
+
+def test_reactivate_sets_active_and_returns_customer():
+    c = customers.add_customer("Acme")
+    c.active = False
+    result = customers.reactivate_customer(c.id)
+    assert result is c
+    assert c.active is True
+    assert audit.LOG[-1]["action"] == "customer.reactivated"
+    assert audit.LOG[-1]["entity_id"] == c.id
+
+
+def test_reactivate_unknown_customer_fails():
+    with pytest.raises(DomainError) as err:
+        customers.reactivate_customer("C_missing")
+    assert err.value.code == "E_NOT_FOUND"
+
+
+@pytest.mark.parametrize("bad", [None, 123, True, "", "   "])
+def test_reactivate_rejects_bad_id(bad):
+    with pytest.raises(DomainError) as err:
+        customers.reactivate_customer(bad)
+    assert err.value.code == "E_BAD_INPUT"
