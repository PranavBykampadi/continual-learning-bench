+WEIGHT_KG = 2
+ZERO_WEIGHT_KG = 0
+NEGATIVE_WEIGHT_KG = -1
+UNKNOWN_ZONE = "moon"
+
+# quote(2, zone) is 7.00 local, 11.50 national, 26.50 international.
+# Surcharges: local 0%, national 4%, international 9.5%.
+LOCAL_TOTAL = 7.00
+NATIONAL_TOTAL = 11.96  # 11.50 + 0.46
+INTERNATIONAL_TOTAL = 29.02  # 26.50 + 2.52
+
+
 def test_unknown_zone():
     with pytest.raises(ValueError):
-        rates.base_rate("moon")
+        rates.base_rate(UNKNOWN_ZONE)
+
+
+def test_quote_with_surcharge_local_has_no_surcharge():
+    assert rates.quote_with_surcharge(WEIGHT_KG, "local") == LOCAL_TOTAL
+
+
+def test_quote_with_surcharge_national():
+    assert rates.quote_with_surcharge(WEIGHT_KG, "national") == NATIONAL_TOTAL
+
+
+def test_quote_with_surcharge_international():
+    assert rates.quote_with_surcharge(WEIGHT_KG, "international") == INTERNATIONAL_TOTAL
+
+
+def test_quote_with_surcharge_unknown_zone_fails():
+    with pytest.raises(ValueError):
+        rates.quote_with_surcharge(WEIGHT_KG, UNKNOWN_ZONE)
+
+
+def test_quote_with_surcharge_zero_weight_fails():
+    with pytest.raises(ValueError):
+        rates.quote_with_surcharge(ZERO_WEIGHT_KG, "national")
+
+
+def test_quote_with_surcharge_negative_weight_fails():
+    with pytest.raises(ValueError):
+        rates.quote_with_surcharge(NEGATIVE_WEIGHT_KG, "national")
