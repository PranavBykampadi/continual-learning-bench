--- a/parcelo/shipments.py	2026-11-10 12:20:18
+++ b/parcelo/shipments.py	2026-11-12 03:07:22
@@ -1,4 +1,6 @@
-from parcelo import clock, events, ids
+import math
+
+from parcelo import audit, clock, events, ids
 from parcelo.errors import DomainError
 from parcelo.models import Shipment
 from parcelo.rates import ZONE_BASE
@@ -28,3 +30,42 @@
     if shipment_id not in db.shipments:
         raise DomainError("E_NOT_FOUND", shipment_id)
     return db.shipments[shipment_id]
+
+
+def split_shipment(shipment_id, weights):
+    if isinstance(shipment_id, bool) or not isinstance(shipment_id, str) or not shipment_id.strip():
+        raise DomainError("E_BAD_INPUT", "shipment_id")
+    shipment = get_shipment(shipment_id)
+
+    if not isinstance(weights, (list, tuple)) or len(weights) == 0:
+        raise DomainError("E_BAD_INPUT", "weights")
+    for weight in weights:
+        if isinstance(weight, bool) or not isinstance(weight, (int, float)):
+            raise DomainError("E_BAD_WEIGHT", str(weight))
+        if not math.isfinite(weight) or weight <= 0:
+            raise DomainError("E_BAD_WEIGHT", str(weight))
+    total = sum(weights)
+    if not math.isclose(total, shipment.weight_kg, rel_tol=1e-9, abs_tol=1e-9):
+        raise DomainError("E_BAD_WEIGHT", str(total))
+
+    if shipment.status != "created":
+        raise DomainError("E_BAD_STATE", shipment.status)
+
+    # All validation passed; build every new shipment before mutating the store.
+    children = [
+        Shipment(
+            id=ids.new_id("shp"),
+            customer_id=shipment.customer_id,
+            weight_kg=weight,
+            zone=shipment.zone,
+            created_at=clock.now(),
+        )
+        for weight in weights
+    ]
+    for child in children:
+        db.shipments[child.id] = child
+        events.emit("shipment.created", child.id, zone=child.zone)
+
+    shipment.status = "split"
+    audit.record("shipment.split", shipment.id, child_ids=[c.id for c in children])
+    return children
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_shipments.py b/tests/unit/test_shipments.py
--- a/tests/unit/test_shipments.py	2026-11-10 12:20:18
+++ b/tests/unit/test_shipments.py	2026-11-12 03:07:28
@@ -15,3 +15,49 @@
     with pytest.raises(DomainError) as err:
         shipments.create_shipment("nope", 1, "local")
     assert err.value.code == "E_UNKNOWN_CUSTOMER"
+
+
+def test_split_creates_shipments_in_weight_order():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 3.0, "national")
+    parts = shipments.split_shipment(s.id, [1.0, 2.0])
+    assert [p.weight_kg for p in parts] == [1.0, 2.0]
+    assert all(p.customer_id == c.id and p.zone == "national" for p in parts)
+    assert all(p.status == "created" for p in parts)
+    assert shipments.get_shipment(s.id).status == "split"
+
+
+def test_split_unknown_shipment():
+    with pytest.raises(DomainError) as err:
+        shipments.split_shipment("shp_missing", [1.0])
+    assert err.value.code == "E_NOT_FOUND"
+
+
+def test_split_weights_must_sum_to_original():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 3.0, "local")
+    with pytest.raises(DomainError) as err:
+        shipments.split_shipment(s.id, [1.0, 1.0])
+    assert err.value.code == "E_BAD_WEIGHT"
+    assert shipments.get_shipment(s.id).status == "created"
+
+
+def test_split_rejects_bad_weight_values():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 2.0, "local")
+    for bad in ([0, 2.0], [-1.0, 3.0], [float("nan"), 2.0], [True, 1.0]):
+        with pytest.raises(DomainError) as err:
+            shipments.split_shipment(s.id, bad)
+        assert err.value.code == "E_BAD_WEIGHT"
+    with pytest.raises(DomainError) as err:
+        shipments.split_shipment(s.id, [])
+    assert err.value.code == "E_BAD_INPUT"
+
+
+def test_split_requires_created_status():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 2.0, "local")
+    shipments.split_shipment(s.id, [1.0, 1.0])
+    with pytest.raises(DomainError) as err:
+        shipments.split_shipment(s.id, [1.0, 1.0])
+    assert err.value.code == "E_BAD_STATE"
