diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_customers.py b/tests/unit/test_customers.py
--- a/tests/unit/test_customers.py	1969-12-31 19:00:00
+++ b/tests/unit/test_customers.py	2026-11-12 03:10:36
@@ -0,0 +1,63 @@
+import pytest
+
+from parcelo import customers, invoices, shipments
+from parcelo.errors import DomainError
+
+
+def _open_invoice(customer_id, amount):
+    s = shipments.create_shipment(customer_id, 1, "local")
+    inv = invoices.issue_invoice(s.id)
+    inv.amount = amount
+    return inv
+
+
+def test_no_open_invoices_is_not_flagged():
+    c = customers.add_customer("Acme")
+    assert customers.needs_review(c.id) is False
+
+
+def test_four_open_invoices_is_flagged():
+    c = customers.add_customer("Acme")
+    for _ in range(4):
+        _open_invoice(c.id, 1.0)
+    assert customers.needs_review(c.id) is True
+
+
+def test_three_open_invoices_small_total_is_not_flagged():
+    c = customers.add_customer("Acme")
+    for _ in range(3):
+        _open_invoice(c.id, 10.0)
+    assert customers.needs_review(c.id) is False
+
+
+def test_outstanding_over_limit_is_flagged():
+    c = customers.add_customer("Acme")
+    _open_invoice(c.id, 250.01)
+    assert customers.needs_review(c.id) is True
+
+
+def test_outstanding_exactly_at_limit_is_not_flagged():
+    c = customers.add_customer("Acme")
+    _open_invoice(c.id, 250.00)
+    assert customers.needs_review(c.id) is False
+
+
+def test_paid_invoices_do_not_count():
+    c = customers.add_customer("Acme")
+    for _ in range(4):
+        inv = _open_invoice(c.id, 1.0)
+        invoices.mark_paid(inv.id)
+    assert customers.needs_review(c.id) is False
+
+
+def test_unknown_customer_fails():
+    with pytest.raises(DomainError) as exc:
+        customers.needs_review("C-missing")
+    assert exc.value.code == "E_NOT_FOUND"
+
+
+@pytest.mark.parametrize("bad", [None, 5, True, "", "   "])
+def test_bad_customer_id_fails(bad):
+    with pytest.raises(DomainError) as exc:
+        customers.needs_review(bad)
+    assert exc.value.code == "E_BAD_INPUT"
