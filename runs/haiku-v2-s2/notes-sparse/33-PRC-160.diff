diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/parcelo/shipments.py b/parcelo/shipments.py
--- a/parcelo/shipments.py	2026-11-10 12:20:18
+++ b/parcelo/shipments.py	2026-11-12 03:15:55
@@ -28,3 +28,16 @@
     if shipment_id not in db.shipments:
         raise DomainError("E_NOT_FOUND", shipment_id)
     return db.shipments[shipment_id]
+
+
+def mark_returned(shipment_id):
+    if not isinstance(shipment_id, str) or isinstance(shipment_id, bool):
+        raise DomainError("E_BAD_INPUT", shipment_id)
+    if not shipment_id or not shipment_id.strip():
+        raise DomainError("E_BAD_INPUT", shipment_id)
+    shipment = get_shipment(shipment_id)
+    if shipment.status == "created":
+        raise DomainError("E_BAD_STATE", shipment_id)
+    shipment.status = "returned"
+    shipment.returned_at = clock.now()
+    return shipment
