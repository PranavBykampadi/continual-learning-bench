@@ -0,0 +1,22 @@
+from parcelo import audit, clock, ids
+from parcelo.errors import DomainError
+from parcelo.invoices import get_invoice
+from parcelo.models import Dispute
+from parcelo.store import db
+
+
+def open_dispute(invoice_id, reason):
+    if not isinstance(invoice_id, str) or not invoice_id.strip():
+        raise DomainError("E_BAD_INPUT", invoice_id)
+    get_invoice(invoice_id)
+    if not isinstance(reason, str) or not reason.strip():
+        raise DomainError("E_BAD_INPUT", "reason")
+    dispute = Dispute(
+        id=ids.new_id("dsp"),
+        invoice_id=invoice_id,
+        reason=reason,
+        opened_at=clock.now(),
+    )
+    db.disputes[dispute.id] = dispute
+    audit.record("dispute.opened", dispute.id, invoice_id=invoice_id)
+    return dispute
