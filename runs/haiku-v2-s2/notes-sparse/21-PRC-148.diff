diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/test_disputes.py b/tests/test_disputes.py
--- a/tests/test_disputes.py	1969-12-31 19:00:00
+++ b/tests/test_disputes.py	2026-11-12 03:06:18
@@ -0,0 +1,53 @@
+import pytest
+
+from parcelo import audit, customers, disputes, invoices, shipments, store
+from parcelo.errors import DomainError
+
+
+def _make_invoice():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 2, "local")
+    return invoices.issue_invoice(s.id)
+
+
+def test_open_dispute_stores_and_returns_dispute():
+    inv = _make_invoice()
+    d = disputes.open_dispute(inv.id, "wrong weight")
+    assert d.id.startswith("dsp_")
+    assert d.invoice_id == inv.id
+    assert d.reason == "wrong weight"
+    assert d.opened_at is not None
+    assert store.db.disputes[d.id] is d
+
+
+def test_open_dispute_audits():
+    inv = _make_invoice()
+    d = disputes.open_dispute(inv.id, "wrong weight")
+    entry = audit.LOG[-1]
+    assert entry["action"] == "dispute.opened"
+    assert entry["entity_id"] == d.id
+    assert entry["details"] == {"invoice_id": inv.id}
+
+
+def test_unknown_invoice_fails():
+    with pytest.raises(DomainError) as err:
+        disputes.open_dispute("INV-missing", "wrong weight")
+    assert err.value.code == "E_NOT_FOUND"
+    assert store.db.disputes == {}
+
+
+@pytest.mark.parametrize("reason", ["", "   ", None, 42])
+def test_bad_reason_fails(reason):
+    inv = _make_invoice()
+    with pytest.raises(DomainError) as err:
+        disputes.open_dispute(inv.id, reason)
+    assert err.value.code == "E_BAD_INPUT"
+    assert store.db.disputes == {}
+
+
+@pytest.mark.parametrize("invoice_id", ["", "  ", None, 7])
+def test_bad_invoice_id_fails(invoice_id):
+    with pytest.raises(DomainError) as err:
+        disputes.open_dispute(invoice_id, "wrong weight")
+    assert err.value.code == "E_BAD_INPUT"
+    assert store.db.disputes == {}
