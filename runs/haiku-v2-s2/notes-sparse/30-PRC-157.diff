+
+def get_invoice(invoice_id):
+    if invoice_id not in db.invoices:
+        raise DomainError("E_NOT_FOUND", invoice_id)
+    return db.invoices[invoice_id]
+
+
+def hold_invoice(invoice_id):
+    if not isinstance(invoice_id, str) or not invoice_id.strip():
+        raise DomainError("E_BAD_INPUT", invoice_id)
+    invoice = get_invoice(invoice_id)
+    if invoice.status != STATUS_OPEN:
+        raise DomainError("E_BAD_STATE", invoice_id)
+    invoice.status = STATUS_ON_HOLD
+    invoice.held_at = clock.now()
+    audit.record("invoice.held", invoice.id)
+    events.emit("invoice.held", invoice.id)
+    return invoice
