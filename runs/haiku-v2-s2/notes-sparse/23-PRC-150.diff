diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_customers.py b/tests/unit/test_customers.py
--- a/tests/unit/test_customers.py	1969-12-31 19:00:00
+++ b/tests/unit/test_customers.py	2026-11-12 03:08:23
@@ -0,0 +1,26 @@
+import pytest
+
+from parcelo import customers
+from parcelo.errors import DomainError
+
+
+def test_set_credit_limit_updates_and_returns_new_limit():
+    c = customers.add_customer("Acme")
+    assert customers.set_credit_limit(c.id, 1200) == 1200
+    assert customers.get_customer(c.id).credit_limit == 1200
+
+
+def test_set_credit_limit_unknown_customer():
+    with pytest.raises(DomainError) as err:
+        customers.set_credit_limit("nope", 100)
+    assert err.value.code == "E_UNKNOWN_CUSTOMER"
+
+
+@pytest.mark.parametrize("amount", [-1, -0.01, float("nan"), float("inf"), "100", None, True])
+def test_set_credit_limit_rejects_bad_amount(amount):
+    c = customers.add_customer("Acme")
+    before = customers.get_customer(c.id).credit_limit
+    with pytest.raises(DomainError) as err:
+        customers.set_credit_limit(c.id, amount)
+    assert err.value.code == "E_BAD_INPUT"
+    assert customers.get_customer(c.id).credit_limit == before
