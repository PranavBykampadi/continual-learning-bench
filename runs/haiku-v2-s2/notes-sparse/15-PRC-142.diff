+def reopen_invoice(invoice_id):
+    if not invoice_id or not invoice_id.strip():
+        raise DomainError("E_BAD_INPUT", repr(invoice_id))
+    if invoice_id not in db.invoices:
+        raise DomainError("E_NOT_FOUND", invoice_id)
+    invoice = db.invoices[invoice_id]
+    if invoice.status != STATUS_PAID:
+        raise DomainError("E_BAD_STATE", invoice_id)
+    invoice.status = STATUS_OPEN
+    invoice.paid_at = None
+    # Invoice timestamps are naive UTC; clock.now() is aware.
+    invoice.reopened_at = clock.now().replace(tzinfo=None)
+    audit.record("invoice.reopened", invoice_id)
+    return invoice
+
