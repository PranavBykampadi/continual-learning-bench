@@ -1,9 +1,88 @@
-from parcelo import customers, invoices, shipments
+from datetime import datetime, timezone
 
+import pytest
 
+from parcelo import audit, clock, customers, invoices, shipments, store
+from parcelo.errors import DomainError
+
+
 def test_issue_and_pay():
     c = customers.add_customer("Acme")
     s = shipments.create_shipment(c.id, 2, "local")
     inv = invoices.issue_invoice(s.id)
     assert inv.amount == 7.0
     assert invoices.mark_paid(inv.id).status == "paid"
+
+
+def _paid_invoice():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 2, "local")
+    inv = invoices.issue_invoice(s.id)
+    invoices.mark_paid(inv.id)
+    return inv
+
+
+def test_reopen_paid_invoice():
+    inv = _paid_invoice()
+    clock.set_fixed(datetime(2026, 11, 12, 9, 30, tzinfo=timezone.utc))
+    audit.LOG.clear()
+
+    result = invoices.reopen_invoice(inv.id)
+
+    assert result is inv
+    assert inv.status == "open"
+    assert inv.paid_at is None
+    assert inv.reopened_at == datetime(2026, 11, 12, 9, 30)
+    assert inv.reopened_at.tzinfo is None
+    assert [e["action"] for e in audit.LOG] == ["invoice.reopened"]
+    assert audit.LOG[0]["entity_id"] == inv.id
+    assert invoices.open_invoices() == [inv]
+
+
+def test_reopen_then_pay_again():
+    inv = _paid_invoice()
+    invoices.reopen_invoice(inv.id)
+    assert invoices.mark_paid(inv.id).status == "paid"
+
+
+@pytest.mark.parametrize("bad_id", ["", "   ", None])
+def test_reopen_blank_id_rejected(bad_id):
+    _paid_invoice()
+    before = {k: (v.status, v.paid_at, v.reopened_at) for k, v in store.db.invoices.items()}
+    audit.LOG.clear()
+
+    with pytest.raises(DomainError) as exc:
+        invoices.reopen_invoice(bad_id)
+
+    assert exc.value.code == "E_BAD_INPUT"
+    assert {k: (v.status, v.paid_at, v.reopened_at) for k, v in store.db.invoices.items()} == before
+    assert audit.LOG == []
+
+
+def test_reopen_missing_invoice_rejected():
+    _paid_invoice()
+    before = {k: (v.status, v.paid_at, v.reopened_at) for k, v in store.db.invoices.items()}
+    audit.LOG.clear()
+
+    with pytest.raises(DomainError) as exc:
+        invoices.reopen_invoice("INV-does-not-exist")
+
+    assert exc.value.code == "E_NOT_FOUND"
+    assert {k: (v.status, v.paid_at, v.reopened_at) for k, v in store.db.invoices.items()} == before
+    assert audit.LOG == []
+
+
+def test_reopen_unpaid_invoice_rejected():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 2, "local")
+    inv = invoices.issue_invoice(s.id)
+    audit.LOG.clear()
+
+    with pytest.raises(DomainError) as exc:
+        invoices.reopen_invoice(inv.id)
+
+    assert exc.value.code == "E_BAD_STATE"
+    assert inv.status == "open"
+    assert inv.paid_at is None
+    assert inv.reopened_at is None
+    assert audit.LOG == []
