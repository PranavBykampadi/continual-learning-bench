diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/test_refunds.py b/tests/test_refunds.py
--- a/tests/test_refunds.py	1969-12-31 19:00:00
+++ b/tests/test_refunds.py	2026-11-12 02:51:42
@@ -0,0 +1,51 @@
+from datetime import datetime
+
+import pytest
+
+from parcelo import clock, customers, invoices, refunds, shipments, store
+from parcelo.errors import DomainError
+
+FIXED_TIME = datetime(2026, 1, 15, 10, 0, 0)
+PAID_AMOUNT = 7.0
+REFUND_AMOUNT = 3.5
+MISSING_INVOICE_ID = "INV-missing"
+
+
+def _paid_invoice():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 2, "local")
+    inv = invoices.issue_invoice(s.id)
+    invoices.mark_paid(inv.id)
+    return inv
+
+
+def test_create_refund_for_paid_invoice():
+    clock.set_fixed(FIXED_TIME)
+    inv = _paid_invoice()
+    assert inv.amount == PAID_AMOUNT
+
+    refund = refunds.create_refund(inv.id, REFUND_AMOUNT)
+
+    assert refund.id.startswith("ref_")
+    assert refund.invoice_id == inv.id
+    assert refund.amount == REFUND_AMOUNT
+    assert refund.created_at == FIXED_TIME
+    assert store.db.refunds[refund.id] is refund
+
+
+def test_unknown_invoice_fails():
+    with pytest.raises(DomainError) as err:
+        refunds.create_refund(MISSING_INVOICE_ID, REFUND_AMOUNT)
+    assert err.value.code == "E_NOT_FOUND"
+    assert store.db.refunds == {}
+
+
+def test_unpaid_invoice_fails():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 2, "local")
+    inv = invoices.issue_invoice(s.id)
+
+    with pytest.raises(DomainError) as err:
+        refunds.create_refund(inv.id, REFUND_AMOUNT)
+    assert err.value.code == "E_BAD_STATE"
+    assert store.db.refunds == {}
