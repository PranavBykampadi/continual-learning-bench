--- a/tests/unit/test_customers.py	1969-12-31 19:00:00
+++ b/tests/unit/test_customers.py	2026-11-12 03:18:10
@@ -0,0 +1,29 @@
+import pytest
+
+from parcelo import customers
+from parcelo.errors import DomainError
+
+
+def test_new_customer_is_not_locked():
+    c = customers.add_customer("Acme")
+    assert c.locked is False
+
+
+def test_lock_customer_sets_flag_and_returns_customer():
+    c = customers.add_customer("Acme")
+    locked = customers.lock_customer(c.id)
+    assert locked is c
+    assert c.locked is True
+
+
+def test_lock_unknown_customer_fails():
+    with pytest.raises(DomainError) as err:
+        customers.lock_customer("nope")
+    assert err.value.code == "E_NOT_FOUND"
+
+
+@pytest.mark.parametrize("bad", ["", "   ", None, 7, True])
+def test_lock_rejects_bad_input(bad):
+    with pytest.raises(DomainError) as err:
+        customers.lock_customer(bad)
+    assert err.value.code == "E_BAD_INPUT"
