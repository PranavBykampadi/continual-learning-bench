+++ b/tests/test_rates.py	2026-11-12 03:02:51
@@ -10,3 +10,45 @@
 def test_unknown_zone():
     with pytest.raises(ValueError):
         rates.base_rate("moon")
+
+
+def test_insurance_fee_local_no_surcharge():
+    assert rates.insurance_fee(100, "local") == 2.00
+
+
+def test_insurance_fee_national_adds_surcharge():
+    # 2% of 100 = 2.00, plus 4% fuel surcharge of 100 = 4.00
+    assert rates.insurance_fee(100, "national") == 6.00
+
+
+def test_insurance_fee_international_adds_surcharge():
+    # 2% of 100 = 2.00, plus 9.5% fuel surcharge of 100 = 9.50
+    assert rates.insurance_fee(100, "international") == 11.50
+
+
+def test_insurance_fee_minimum():
+    # 2% of 10 = 0.20, below the 1.00 minimum
+    assert rates.insurance_fee(10, "local") == 1.00
+    assert rates.insurance_fee(10, "national") == 1.00
+
+
+def test_insurance_fee_float_value():
+    # 2% of 250.50 = 5.01, fuel 4% = 10.02; total 15.03
+    assert rates.insurance_fee(250.50, "national") == 15.03
+
+
+def test_insurance_fee_unknown_zone():
+    with pytest.raises(ValueError):
+        rates.insurance_fee(100, "moon")
+
+
+@pytest.mark.parametrize("value", [0, -5, -0.01])
+def test_insurance_fee_rejects_non_positive(value):
+    with pytest.raises(ValueError):
+        rates.insurance_fee(value, "local")
+
+
+@pytest.mark.parametrize("value", [float("nan"), float("inf"), float("-inf"), True, "100", None])
+def test_insurance_fee_rejects_non_numeric_or_non_finite(value):
+    with pytest.raises(ValueError):
+        rates.insurance_fee(value, "local")
