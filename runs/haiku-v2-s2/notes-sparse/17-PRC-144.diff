--- a/parcelo/rates.py	2026-11-10 12:17:53
+++ b/parcelo/rates.py	2026-11-12 03:02:48
@@ -1,5 +1,11 @@
+import math
+
+from parcelo.legacy.billing import fuel_surcharge
+
 ZONE_BASE = {"local": 4.5, "national": 9.0, "international": 24.0}
 PER_KG = 1.25
+INSURANCE_RATE = 0.02
+INSURANCE_MIN_FEE = 1.00
 
 
 def base_rate(zone):
@@ -12,3 +18,21 @@
     if weight_kg <= 0:
         raise ValueError("weight must be positive")
     return round(base_rate(zone) + PER_KG * weight_kg, 2)
+
+
+def insurance_fee(declared_value, zone):
+    """2% of the declared value plus the zone's fuel surcharge on that value.
+
+    The fuel surcharge percentages come from parcelo.legacy.billing.fuel_surcharge,
+    so they are not duplicated here. The fee never drops below INSURANCE_MIN_FEE.
+    """
+    if isinstance(declared_value, bool) or not isinstance(declared_value, (int, float)):
+        raise ValueError("declared value must be a number")
+    if not math.isfinite(declared_value):
+        raise ValueError("declared value must be finite")
+    if declared_value <= 0:
+        raise ValueError("declared value must be positive")
+    if zone not in ZONE_BASE:
+        raise ValueError("unknown zone: %s" % zone)
+    raw = INSURANCE_RATE * declared_value + fuel_surcharge(declared_value, zone)
+    return round(max(INSURANCE_MIN_FEE, raw), 2)
