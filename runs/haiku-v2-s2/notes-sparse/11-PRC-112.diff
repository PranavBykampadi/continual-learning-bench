@@ -0,0 +1,35 @@
+import math
+
+from parcelo import audit, clock, ids
+from parcelo.errors import DomainError
+from parcelo.models import Claim
+from parcelo.shipments import get_shipment
+from parcelo.store import db
+
+DELIVERED = "delivered"
+
+
+def _is_blank(value):
+    return not value or not value.strip()
+
+
+def file_claim(shipment_id, amount, reason):
+    shipment = get_shipment(shipment_id)
+    if isinstance(amount, bool) or not isinstance(amount, (int, float)):
+        raise DomainError("E_BAD_INPUT", "amount must be a number")
+    if not math.isfinite(amount) or amount <= 0:
+        raise DomainError("E_BAD_INPUT", "amount must be positive")
+    if not isinstance(reason, str) or _is_blank(reason):
+        raise DomainError("E_BAD_INPUT", "reason required")
+    if shipment.status != DELIVERED:
+        raise DomainError("E_BAD_STATE", shipment_id)
+    claim = Claim(
+        id=ids.new_id("clm"),
+        shipment_id=shipment_id,
+        amount=amount,
+        reason=reason,
+        filed_at=clock.now(),
+    )
+    db.claims[claim.id] = claim
+    audit.record("claim.created", claim.id, shipment_id=shipment_id, amount=amount)
+    return claim
