diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_claims.py b/tests/unit/test_claims.py
--- a/tests/unit/test_claims.py	1969-12-31 19:00:00
+++ b/tests/unit/test_claims.py	2026-11-12 02:57:47
@@ -0,0 +1,79 @@
+import pytest
+
+from parcelo import audit, claims, customers, shipments
+from parcelo.errors import DomainError
+from parcelo.store import db
+
+
+def _delivered_shipment():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 2, "local")
+    s.status = "delivered"
+    return s
+
+
+def test_file_claim_stores_and_returns_claim():
+    s = _delivered_shipment()
+    claim = claims.file_claim(s.id, 12.5, "box crushed")
+    assert claim.id.startswith("clm_")
+    assert claim.shipment_id == s.id
+    assert claim.amount == 12.5
+    assert claim.reason == "box crushed"
+    assert claim.filed_at is not None
+    assert db.claims[claim.id] is claim
+
+
+def test_file_claim_records_audit():
+    s = _delivered_shipment()
+    claim = claims.file_claim(s.id, 5, "late")
+    assert audit.LOG[-1]["action"] == "claim.created"
+    assert audit.LOG[-1]["entity_id"] == claim.id
+
+
+def test_unknown_shipment():
+    with pytest.raises(DomainError) as err:
+        claims.file_claim("nope", 5, "late")
+    assert err.value.code == "E_NOT_FOUND"
+    assert db.claims == {}
+
+
+def test_undelivered_shipment_rejected():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 2, "local")
+    with pytest.raises(DomainError) as err:
+        claims.file_claim(s.id, 5, "late")
+    assert err.value.code == "E_BAD_STATE"
+    assert db.claims == {}
+
+
+@pytest.mark.parametrize("amount", [0, -1, -0.01, float("nan"), float("inf")])
+def test_non_positive_or_non_finite_amount_rejected(amount):
+    s = _delivered_shipment()
+    with pytest.raises(DomainError) as err:
+        claims.file_claim(s.id, amount, "late")
+    assert err.value.code == "E_BAD_INPUT"
+    assert db.claims == {}
+
+
+@pytest.mark.parametrize("amount", [None, "5", True])
+def test_non_numeric_amount_rejected(amount):
+    s = _delivered_shipment()
+    with pytest.raises(DomainError) as err:
+        claims.file_claim(s.id, amount, "late")
+    assert err.value.code == "E_BAD_INPUT"
+    assert db.claims == {}
+
+
+@pytest.mark.parametrize("reason", ["", "   ", None])
+def test_blank_reason_rejected(reason):
+    s = _delivered_shipment()
+    with pytest.raises(DomainError) as err:
+        claims.file_claim(s.id, 5, reason)
+    assert err.value.code == "E_BAD_INPUT"
+    assert db.claims == {}
+
+
+def test_missing_shipment_checked_before_amount():
+    with pytest.raises(DomainError) as err:
+        claims.file_claim("nope", -1, "late")
+    assert err.value.code == "E_NOT_FOUND"
