+def upgrade_tier(customer_id):
+    if not isinstance(customer_id, str) or isinstance(customer_id, bool):
+        raise ValueError("bad customer id")
+    if not customer_id.strip():
+        raise ValueError("customer id required")
+    if customer_id not in db.customers:
+        raise ValueError("customer not found")
+    customer = db.customers[customer_id]
+    if customer.tier != TIER_STANDARD:
+        raise ValueError("customer is not standard")
+    customer.tier = TIER_GOLD
+    audit.record(
+        "customer.upgraded",
+        customer.id,
+        from_tier=TIER_STANDARD,
+        to_tier=TIER_GOLD,
+    )
