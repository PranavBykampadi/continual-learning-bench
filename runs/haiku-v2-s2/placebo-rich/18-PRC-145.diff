diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_customers.py b/tests/unit/test_customers.py
--- a/tests/unit/test_customers.py	1969-12-31 19:00:00
+++ b/tests/unit/test_customers.py	2026-11-12 02:56:17
@@ -0,0 +1,23 @@
+import pytest
+
+from parcelo import customers
+from parcelo.store import db
+
+
+def test_upgrade_standard_to_gold():
+    created = customers.add_customer("Acme")
+    upgraded = customers.upgrade_tier(created.id)
+    assert upgraded is created
+    assert upgraded.tier == "gold"
+    assert db.customers[created.id].tier == "gold"
+
+
+def test_upgrade_missing_customer_fails():
+    with pytest.raises(KeyError):
+        customers.upgrade_tier("C000000")
+
+
+def test_upgrade_already_gold_fails():
+    created = customers.add_customer("Acme", tier="gold")
+    with pytest.raises(ValueError):
+        customers.upgrade_tier(created.id)
