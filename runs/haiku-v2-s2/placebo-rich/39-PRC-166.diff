+ESCALATION_THRESHOLD = Money.parse("500.00")
+
+
+def escalate_invoice(invoice_id):
+    if invoice_id not in db.invoices:
+        raise DomainError("E_NOT_FOUND", invoice_id)
+    invoice = db.invoices[invoice_id]
+    if invoice.status != "open":
+        raise DomainError("E_BAD_STATE", f"{invoice_id} is {invoice.status}")
+    if Money.parse(invoice.amount) < ESCALATION_THRESHOLD:
+        raise DomainError("E_BAD_STATE", f"{invoice_id} is below 500.00")
+    invoice.status = "escalated"
     return invoice
 
 
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/test_invoices.py b/tests/test_invoices.py
--- a/tests/test_invoices.py	2026-11-10 12:17:53
+++ b/tests/test_invoices.py	2026-11-12 03:01:43
@@ -1,9 +1,37 @@
-from parcelo import customers, invoices, shipments
+import pytest
 
+from parcelo import customers, invoices, shipments, store
+from parcelo.errors import DomainError
+from parcelo.models import Invoice
 
+
 def test_issue_and_pay():
     c = customers.add_customer("Acme")
     s = shipments.create_shipment(c.id, 2, "local")
     inv = invoices.issue_invoice(s.id)
     assert inv.amount == 7.0
     assert invoices.mark_paid(inv.id).status == "paid"
+
+
+def test_escalate_large_open_invoice():
+    store.db.invoices["INV-1"] = Invoice("INV-1", "S-1", 500.0)
+    assert invoices.escalate_invoice("INV-1").status == "escalated"
+
+
+def test_escalate_rejects_small_invoice():
+    store.db.invoices["INV-2"] = Invoice("INV-2", "S-2", 499.99)
+    with pytest.raises(DomainError):
+        invoices.escalate_invoice("INV-2")
+    assert store.db.invoices["INV-2"].status == "open"
+
+
+def test_escalate_rejects_paid_invoice():
+    store.db.invoices["INV-3"] = Invoice("INV-3", "S-3", 900.0, status="paid")
+    with pytest.raises(DomainError):
+        invoices.escalate_invoice("INV-3")
+
+
+def test_escalate_missing_invoice_fails():
+    with pytest.raises(DomainError) as err:
+        invoices.escalate_invoice("INV-404")
+    assert err.value.code == "E_NOT_FOUND"
