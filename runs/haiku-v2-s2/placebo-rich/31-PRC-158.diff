diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_returns.py b/tests/unit/test_returns.py
--- a/tests/unit/test_returns.py	1969-12-31 19:00:00
+++ b/tests/unit/test_returns.py	2026-11-12 02:59:38
@@ -0,0 +1,57 @@
+import pytest
+
+from parcelo import customers, returns, shipments, store
+from parcelo.errors import DomainError
+from parcelo.models import ReturnRequest
+from parcelo.store import db
+
+
+def _delivered_shipment():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 1.0, "local")
+    s.status = "delivered"
+    return s
+
+
+def test_request_return_creates_and_stores_request():
+    s = _delivered_shipment()
+    r = returns.request_return(s.id, "damaged")
+    assert isinstance(r, ReturnRequest)
+    assert r.id.startswith("ret_")
+    assert r.shipment_id == s.id
+    assert r.reason == "damaged"
+    assert r.requested_at is not None
+    assert db.returns[r.id] is r
+    assert returns.returns_for(s.id) == [r]
+
+
+def test_at_most_three_returns_per_shipment():
+    s = _delivered_shipment()
+    for reason in ("a", "b", "c"):
+        returns.request_return(s.id, reason)
+    with pytest.raises(DomainError) as err:
+        returns.request_return(s.id, "d")
+    assert err.value.code == "E_LIMIT"
+    assert len(returns.returns_for(s.id)) == 3
+
+
+def test_unknown_shipment_fails():
+    with pytest.raises(DomainError) as err:
+        returns.request_return("shp_missing", "x")
+    assert err.value.code == "E_NOT_FOUND"
+
+
+def test_only_delivered_shipments_can_be_returned():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 1.0, "local")
+    with pytest.raises(DomainError) as err:
+        returns.request_return(s.id, "x")
+    assert err.value.code == "E_BAD_STATE"
+    assert returns.returns_for(s.id) == []
+
+
+def test_reset_clears_returns():
+    s = _delivered_shipment()
+    returns.request_return(s.id, "x")
+    store.reset()
+    assert db.returns == {}
