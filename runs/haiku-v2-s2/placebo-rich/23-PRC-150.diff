diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/unit/test_customers.py b/tests/unit/test_customers.py
--- a/tests/unit/test_customers.py	1969-12-31 19:00:00
+++ b/tests/unit/test_customers.py	2026-11-12 02:57:46
@@ -0,0 +1,35 @@
+import pytest
+
+from parcelo import customers, store
+from parcelo.errors import DomainError
+from parcelo.models import Customer
+
+
+def _add(customer_id="C1"):
+    store.db.customers[customer_id] = Customer(id=customer_id, name="Acme")
+    return customer_id
+
+
+def test_set_credit_limit_updates_and_returns_new_limit():
+    cid = _add()
+    assert customers.set_credit_limit(cid, 1200.0) == 1200.0
+    assert store.db.customers[cid].credit_limit == 1200.0
+
+
+def test_set_credit_limit_allows_zero():
+    cid = _add()
+    assert customers.set_credit_limit(cid, 0) == 0
+
+
+def test_set_credit_limit_unknown_customer_fails():
+    with pytest.raises(DomainError) as err:
+        customers.set_credit_limit("missing", 100.0)
+    assert err.value.code == "E_UNKNOWN_CUSTOMER"
+
+
+def test_set_credit_limit_negative_amount_fails():
+    cid = _add()
+    with pytest.raises(DomainError) as err:
+        customers.set_credit_limit(cid, -1)
+    assert err.value.code == "E_BAD_INPUT"
+    assert store.db.customers[cid].credit_limit == 500.0
