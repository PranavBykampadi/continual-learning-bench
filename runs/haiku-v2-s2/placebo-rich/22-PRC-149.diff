     with pytest.raises(DomainError) as err:
         shipments.create_shipment("nope", 1, "local")
     assert err.value.code == "E_UNKNOWN_CUSTOMER"
+
+
+def test_split_replaces_with_parts_in_order():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 10, "international")
+    parts = shipments.split_shipment(s.id, [3, 7])
+    assert [p.weight_kg for p in parts] == [3, 7]
+    assert all(p.customer_id == c.id and p.zone == "international" for p in parts)
+    assert all(p.status == "created" for p in parts)
+    assert shipments.get_shipment(s.id).status == "split"
+
+
+def test_split_unknown_shipment_fails():
+    with pytest.raises(DomainError) as err:
+        shipments.split_shipment("shp_missing", [1])
+    assert err.value.code == "E_NOT_FOUND"
+
+
+def test_split_non_created_shipment_fails():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 4, "local")
+    shipments.split_shipment(s.id, [2, 2])
+    with pytest.raises(DomainError) as err:
+        shipments.split_shipment(s.id, [2, 2])
+    assert err.value.code == "E_BAD_STATE"
+
+
+def test_split_weights_must_sum_to_original():
+    c = customers.add_customer("Acme")
+    s = shipments.create_shipment(c.id, 5, "local")
+    with pytest.raises(DomainError) as err:
+        shipments.split_shipment(s.id, [1, 2])
+    assert err.value.code == "E_BAD_INPUT"
+    # Failed split must leave the original untouched.
+    assert shipments.get_shipment(s.id).status == "created"
