diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/test_disputes.py b/tests/test_disputes.py
--- a/tests/test_disputes.py	1969-12-31 19:00:00
+++ b/tests/test_disputes.py	2026-11-12 02:57:08
@@ -0,0 +1,36 @@
+import pytest
+
+from parcelo.disputes import open_dispute
+from parcelo.errors import DomainError
+from parcelo.models import Invoice
+from parcelo.store import db
+
+
+def _add_invoice():
+    invoice = Invoice(id="INV-test0001", shipment_id="S1", amount=10.0)
+    db.invoices[invoice.id] = invoice
+    return invoice
+
+
+def test_open_dispute_saves_and_returns_dispute():
+    invoice = _add_invoice()
+    dispute = open_dispute(invoice.id, "wrong weight")
+    assert dispute.invoice_id == invoice.id
+    assert dispute.reason == "wrong weight"
+    assert dispute.opened_at is not None
+    assert db.disputes[dispute.id] is dispute
+
+
+def test_open_dispute_unknown_invoice_fails():
+    with pytest.raises(DomainError) as exc:
+        open_dispute("INV-missing", "wrong weight")
+    assert exc.value.code == "E_NOT_FOUND"
+    assert db.disputes == {}
+
+
+def test_open_dispute_empty_reason_fails():
+    invoice = _add_invoice()
+    with pytest.raises(DomainError) as exc:
+        open_dispute(invoice.id, "")
+    assert exc.value.code == "E_BAD_INPUT"
+    assert db.disputes == {}
