+
+
+def insurance_fee(declared_value, zone):
+    if zone not in FUEL_SURCHARGE_PCT:
+        raise ValueError("unknown zone: %s" % zone)
+    if declared_value <= 0:
+        raise ValueError("declared value must be positive")
+    pct = INSURANCE_PCT + FUEL_SURCHARGE_PCT[zone]
+    fee = declared_value * pct / 100.0
+    return round(max(INSURANCE_MIN_FEE, fee), 2)
