--- a/parcelo/rates.py	2026-11-10 12:17:53
+++ b/parcelo/rates.py	2026-11-12 02:48:59
@@ -1,3 +1,5 @@
+from parcelo.legacy.billing import fuel_surcharge
+
 ZONE_BASE = {"local": 4.5, "national": 9.0, "international": 24.0}
 PER_KG = 1.25
 
@@ -12,3 +14,14 @@
     if weight_kg <= 0:
         raise ValueError("weight must be positive")
     return round(base_rate(zone) + PER_KG * weight_kg, 2)
+
+
+def quote_with_surcharge(weight_kg, zone):
+    """Return (quote, fuel_surcharge) for the weight and zone.
+
+    The surcharge uses the same percentages as the legacy billing helper.
+    Unknown zones and non-positive weights raise ValueError (via quote).
+    """
+    amount = quote(weight_kg, zone)
+    surcharge = fuel_surcharge(amount, zone)
+    return amount, surcharge
diff -ruN -x __pycache__ -x .pytest_cache -x _hidden a/tests/test_rates.py b/tests/test_rates.py
--- a/tests/test_rates.py	2026-11-10 12:17:53
+++ b/tests/test_rates.py	2026-11-12 02:49:04
@@ -10,3 +10,28 @@
 def test_unknown_zone():
     with pytest.raises(ValueError):
         rates.base_rate("moon")
+
+
+def test_quote_with_surcharge_local():
+    assert rates.quote_with_surcharge(2, "local") == (7.0, 0.0)
+
+
+def test_quote_with_surcharge_national():
+    # quote 9.0 + 1.25 * 2 = 11.5; 4% surcharge = 0.46
+    assert rates.quote_with_surcharge(2, "national") == (11.5, 0.46)
+
+
+def test_quote_with_surcharge_international():
+    # quote 24.0 + 1.25 * 2 = 26.5; 9.5% surcharge = 2.52 (rounded)
+    assert rates.quote_with_surcharge(2, "international") == (26.5, 2.52)
+
+
+def test_quote_with_surcharge_unknown_zone():
+    with pytest.raises(ValueError):
+        rates.quote_with_surcharge(2, "moon")
+
+
+@pytest.mark.parametrize("weight", [0, -1])
+def test_quote_with_surcharge_non_positive_weight(weight):
+    with pytest.raises(ValueError):
+        rates.quote_with_surcharge(weight, "local")
